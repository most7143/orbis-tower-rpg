---@sealed
---@description "Determines how the color will be calculated when multiple light sources for OverlayLightComponent overlap."
@Enum
script OverlayLightOverlapOperation
	---@description "Colors are added together."
	member Additive = 0
	---@description "Blends colors by using standard blending."
	member AlphaBlend = 1

	---@description "Converts numbers to the applicable type."
	static method OverlayLightOverlapOperation CastFrom(number value) end

	---@description "Converts strings to the applicable type."
	static method OverlayLightOverlapOperation CastFrom(string value) end
end