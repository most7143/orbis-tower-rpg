---@sealed
---@description "This event occurs in UserService when a user exits a game."
@Event
script UserLeaveEvent extends EventType

	---@description "The reason the user left. Warp, MatchMaking, and Migrate do not occur in the Maker."
	---@sealed
	property UserLeaveReason LeaveReason

	---@description "This player's profile code."
	---@sealed
	property string ProfileCode

	---@description "The user's unique identifier."
	---@sealed
	property string UserId

	constructor UserLeaveEvent(IUser user) end

	constructor UserLeaveEvent(string userId = nil, string profileCode = nil, UserLeaveReason leaveReason = UserLeaveReason.Normal) end

end