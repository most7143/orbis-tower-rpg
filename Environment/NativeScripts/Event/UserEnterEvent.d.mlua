---@sealed
---@description "This event occurs in UserService when a user enters a game."
@Event
script UserEnterEvent extends EventType

	---@description "How the user entered: Normal, Warp, MatchMaking, or Migrate. Always Normal in Maker play."
	---@sealed
	property UserEnterType EnterType

	---@description "This player's profile code."
	---@sealed
	property string ProfileCode

	---@description "The user's unique identifier."
	---@sealed
	property string UserId

	constructor UserEnterEvent(IUser user) end

	constructor UserEnterEvent(string userId = nil, string profileCode = nil, UserEnterType enterType = UserEnterType.Normal) end

end