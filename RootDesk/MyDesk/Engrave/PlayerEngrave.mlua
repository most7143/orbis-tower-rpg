@Component
script PlayerEngrave extends Component

    -- 계정 레벨·꾸미기: 누적 EXP에서 레벨/보너스를 재산출한다.
    property string AccountKey = "OrbisAccountV1"
    @Sync
    property boolean AccountLoaded = false
    @Sync
    property integer AccountTotal = 0
    @Sync
    property integer AccountLevel = 1
    @Sync
    property integer AccountExp = 0
    @Sync
    property integer AccountNeed = 62
    @Sync
    property string AccountProfile = "hero"
    @Sync
    property string AccountFrame = "gold"
    @Sync
    property string AccountTitle = "none"
    @Sync
    property integer AccountSeq = 0
    @Sync
    property string AccountMsg = ""
    property number AccountRetryTimer = 10

	-- 각인: 아웃게임 영구 성장. 클리어한 최고 층 수 = 총 포인트 (절대 줄지 않음)
	property string StorageKey = "OrbisEngrave"
	-- 각인 이전 저장 데이터(최고 도달 층). 처음 한 번만 읽어 클리어 층으로 옮긴다.
	property string LegacyKey = "OrbisTower"
	property string TableName = "EngraveTable"
	property string LobbyMapName = "Lobby"
	property number LoadRetryDelay = 10

	@Sync
	property boolean Loaded = false
	@Sync
	property integer ClearedFloor = 0
	-- 로비 층 선택에서 고른 스테이지 (탑 입장 시 TowerRunManager가 읽음, 저장하지 않음)
	@Sync
	property integer SelectedStage = 1
	@Sync
	property integer Spent = 0
	@Sync
	property SyncTable<string, integer> Lv
	@Sync
	property string Msg = ""
	@Sync
	property integer MsgSeq = 0

	-- 심볼: 층마다 1~3단계, 보스 처치 시 확률 획득 (SymbolTierTable / SymbolPermTable). 같은 플레이어 저장 컴포넌트에서 따로 저장
	property string SymbolKey = "OrbisSymbol"
	property string SymbolTierTableName = "SymbolTierTable"
	property string SymbolPermTableName = "SymbolPermTable"
	@Sync
	property boolean SymbolLoaded = false
	-- 층 번호(문자열) → 단계(1~3)
	@Sync
	property SyncTable<string, integer> SymbolLv
	@Sync
	property integer SymbolCount = 0

	-- 미네르바의 은총: 여신의 깃털로 옵션 5줄 돌리기 (잠금 최대 4줄, 프리셋 3개). 키 OrbisGrace
	property string GraceKey = "OrbisGrace"
	property integer GraceSlots = 5
	property integer GracePresetCount = 3
	property integer GraceMaxLocks = 4
	property integer GraceBaseCost = 10
	property integer GraceLockCost = 10
	@Sync
	property boolean GraceLoaded = false
	@Sync
	property integer Feathers = 0
	@Sync
	property integer GracePreset = 1
	-- "프리셋_줄" → "옵션Id|등급|단계|잠금(0/1)" (빈 줄은 "")
	@Sync
	property SyncTable<string, string> GraceLines
	@Sync
	property integer GraceSeq = 0

	-- 슬롯 강화: 장비 부위별 영구 단계와 주문서. 키 OrbisSlot (SlotRateTable / SlotScrollTable / SlotMilestoneTable)
	property string SlotKey = "OrbisSlot"
	property integer SlotMaxLevel = 30
	property integer SlotMaxScrolls = 3
	-- 실패할 때마다 그 시도 성공 확률의 10%를 슬롯에 쌓는다
	property number SlotFailRatio = 0.1
	@Sync
	property boolean SlotLoaded = false
	@Sync
	property SyncTable<string, integer> SlotLv
	-- 실패로 쌓인 추가 확률(%)
	@Sync
	property SyncTable<string, number> SlotBonus
	-- "부위_단계" → 보유 수
	@Sync
	property SyncTable<string, integer> Scrolls
	@Sync
	property integer SlotSeq = 0
	@Sync
	property boolean SlotOk = false

	-- 히어로 스킬: 뽑기(스킬북)로 얻고, 같은 스킬을 모아 레벨업(최대 11), 같은 스킬 3개 합성으로 상위 등급 도전, 5칸 장착. 키 OrbisSkill
	property string SkillKey = "OrbisSkill"
	property string SkillTableName = "HeroSkillTable"
	property string SkillGradeTableName = "SkillGradeTable"
	property integer SkillEquipSlots = 5
	-- 처음부터 가진 스킬 (표 순서 1~5)
	property integer SkillStartCount = 5
	@Sync
	property boolean SkillLoaded = false
	@Sync
	property integer SkillBooks = 0
	-- 스킬 Id → 레벨 (0이면 미보유)
	@Sync
	property SyncTable<string, integer> SkillOwnLv
	-- 스킬 Id → 레벨업·합성 재료로 모은 개수
	@Sync
	property SyncTable<string, integer> SkillCnt
	-- 장착 칸 → 스킬 Id (빈 칸은 ""). 히어로는 "1"~"5", 다른 직업은 "Bishop:1"~"Bishop:5"
	@Sync
	property SyncTable<string, string> SkillEquip
	-- 마지막 뽑기·합성 결과 "Id:신규(1/0),..."
	@Sync
	property string SkillResult = ""
	@Sync
	property integer SkillSeq = 0
	@Sync
	property string SkillMsg = ""
	-- 고유 패시브 '콤보 어택' 레벨 (0이면 잠김: 인게임 콤보가 쌓이지 않음). 스킬북으로 올린다.
	@Sync
	property integer ComboAttackLv = 0
	property integer ComboAttackMaxLv = 11
	-- 레벨업 스킬북 비용 = 기본 + 현재 레벨 × 증가 (Lv.0→1 해금 20권, 이후 30·40…)
	property integer ComboAttackBaseCost = 20
	property integer ComboAttackStepCost = 10
	-- 비숍 고유 패시브 '성수' 레벨 (1부터). 성수 1개당 공격력 보너스가 오른다. 스킬북으로 올린다.
	@Sync
	property integer HolyWaterLv = 1
	property integer HolyWaterMaxLv = 11
	property integer HolyWaterBaseCost = 20
	property integer HolyWaterStepCost = 10
	-- 나이트로드·보우마스터·바이퍼 고유 패시브 레벨 (직업 → 레벨, 0이면 잠김). 저장 키 jp
	@Sync
	property SyncTable<string, integer> JobPassiveLv
	property integer JobPassiveMaxLv = 11
	property integer JobPassiveBaseCost = 20
	property integer JobPassiveStepCost = 10
	-- 2인 편성: 메인·동료 직업 (저장 키 mj·cj)
	@Sync
	property string MainJob = "Hero"
	@Sync
	property string CompJob = "Bishop"

	-- 입장 에너지: 서버 UTC로 충전. 충전은 마지막 차감 시각에서 계산하므로 매초 저장하지 않는다.
	-- 별 미션 (층마다 3개: 1=클리어, 2=제한 시간 안 클리어, 4=체력 50% 이상 클리어, 영구 누적)
	-- 구간 보상 (SectionSize층마다 별 합계가 기준을 넘으면 상자 직접 수령, 서버가 판정·지급·저장)
	property string StarKey = "OrbisStar"
	property integer SectionSize = 10
	property string SectionThresholds = "10|20|30"
	property string SectionBooks = "20|40|80"
	property string SectionFeathers = "5|10|20"
	@Sync
	property boolean StarLoaded = false
	-- "층:비트,층:비트" (클라이언트 표시용)
	@Sync
	property string StarData = ""
	-- "구간:수령비트,..." (1·2·4 = 첫째·둘째·셋째 상자)
	@Sync
	property string SectionData = ""
	@Sync
	property integer StarSeq = 0
	@Sync
	property string ClaimMsg = ""
	@Sync
	property integer ClaimSeq = 0
	@HideFromInspector
	property boolean StarDirty = false
	@HideFromInspector
	property number StarRetryTimer = 0

	property string EnergyKey = "OrbisEnergy"
	property integer EnergyMax = 30
	property integer EnergyCost = 3
	property integer EnergyInterval = 600
	@Sync
	property boolean EnergyLoaded = false
	@Sync
	property integer Energy = 0
	@Sync
	property integer EnergyRemaining = 0
	property number EnergyNextAt = 0
	property number EnergyRetryTimer = 0
	property number EnergyTick = 0

	@HideFromInspector
	property boolean SkillDirty = false
	@HideFromInspector
	property number SkillRetryTimer = 0
	@HideFromInspector
	property boolean SlotDirty = false
	@HideFromInspector
	property number SlotRetryTimer = 0
	@HideFromInspector
	property boolean GraceDirty = false
	@HideFromInspector
	property number GraceRetryTimer = 0
	@HideFromInspector
	property boolean SymbolDirty = false
	@HideFromInspector
	property number SymbolRetryTimer = 0
	@HideFromInspector
	property boolean Dirty = false
	@HideFromInspector
	property integer SaveGen = 0
	@HideFromInspector
	property number RetryTimer = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 각인 테이블을 읽고 저장된 각인을 불러온다.
		self:LoadTable()
		self:LoadData()
		self:LoadSymbolTables()
		self:LoadSymbols()
		self:LoadGraceTables()
		self:LoadGrace()
		self:LoadSlotTables()
		self:LoadSlots()
		self:LoadSkillTables()
		self:LoadSkills()
		self:LoadEnergy()
		self:LoadStars()
		self:LoadAccount()
		log("[VRF] PlayerEngrave begin nodes=" .. tostring(#self._T.nodes) .. " cleared=" .. tostring(self.ClearedFloor) .. " spent=" .. tostring(self.Spent))
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 불러오기에 실패했으면 잠시 뒤 다시 시도한다 (실패 상태에서는 저장하지 않음).
        if not self.AccountLoaded then
            self.AccountRetryTimer = self.AccountRetryTimer - delta
            if self.AccountRetryTimer <= 0 then self:LoadAccount() end
        end
		self.EnergyTick = self.EnergyTick - delta
		if self.EnergyTick <= 0 then
			self.EnergyTick = 1
			if self.EnergyLoaded then self:RechargeEnergyAt(self:EnergyNow()) end
		end
		if not self.EnergyLoaded then
			self.EnergyRetryTimer = self.EnergyRetryTimer - delta
			if self.EnergyRetryTimer <= 0 then self:LoadEnergy() end
		end
		if not self.SkillLoaded then
			self.SkillRetryTimer = self.SkillRetryTimer - delta
			if self.SkillRetryTimer <= 0 then self:LoadSkills() end
		end
		if not self.SlotLoaded then
			self.SlotRetryTimer = self.SlotRetryTimer - delta
			if self.SlotRetryTimer <= 0 then self:LoadSlots() end
		end
		if not self.GraceLoaded then
			self.GraceRetryTimer = self.GraceRetryTimer - delta
			if self.GraceRetryTimer <= 0 then self:LoadGrace() end
		end
		if not self.StarLoaded then
			self.StarRetryTimer = self.StarRetryTimer - delta
			if self.StarRetryTimer <= 0 then self:LoadStars() end
		end
		if not self.SymbolLoaded then
			self.SymbolRetryTimer = self.SymbolRetryTimer - delta
			if self.SymbolRetryTimer <= 0 then self:LoadSymbols() end
		end
		if self.Loaded then return end
		self.RetryTimer = self.RetryTimer - delta
		if self.RetryTimer <= 0 then self:LoadData() end
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 플레이어가 나갈 때 저장되지 않은 변경을 마지막으로 저장한다.
        if self._T.accountPending ~= nil then
            if not self:CommitAccount(self._T.accountPending) then log_warning("[VRF] account final settlement save failed") end
        end
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		if self.GraceLoaded and self.GraceDirty then
			local code = ds:SetAndWait(self.GraceKey, self:EncodeGrace())
			if code ~= 0 then log_warning("[VRF] grace final save failed code=" .. tostring(code)) end
		end
		if self.SkillLoaded and self.SkillDirty then
			local code = ds:SetAndWait(self.SkillKey, self:EncodeSkills())
			if code ~= 0 then log_warning("[VRF] skill final save failed code=" .. tostring(code)) end
		end
		if self.SlotLoaded and self.SlotDirty then
			local code = ds:SetAndWait(self.SlotKey, self:EncodeSlots())
			if code ~= 0 then log_warning("[VRF] slot final save failed code=" .. tostring(code)) end
		end
		if self.StarLoaded and self.StarDirty then
			local code = ds:SetAndWait(self.StarKey, self:EncodeStars())
			if code ~= 0 then log_warning("[VRF] star final save failed code=" .. tostring(code)) end
		end
		if self.SymbolLoaded and self.SymbolDirty then
			local code = ds:SetAndWait(self.SymbolKey, self:EncodeSymbols())
			if code ~= 0 then log_warning("[VRF] symbol final save failed code=" .. tostring(code)) end
		end
		if not self.Loaded or not self.Dirty then return end
		local errorCode = ds:SetAndWait(self.StorageKey, self:Encode())
		if errorCode ~= 0 then log_warning("[VRF] engrave final save failed code=" .. tostring(errorCode)) end
	end

	@ExecSpace("ServerOnly")
	method number EnergyNow()
		-- 클라이언트 기기 시간 대신 서버 UTC 초를 사용한다.
		return math.floor(DateTime.UtcNow.Elapsed / 1000)
	end

	@ExecSpace("ServerOnly")
	method void LoadEnergy()
		-- 최초에는 30개. 기존 계정은 저장된 수량과 다음 충전 시각에서 미접속 충전도 복원한다.
		if self._T.energyBusy then return end
		self.EnergyRetryTimer = self.LoadRetryDelay
		self._T.energyBusy = true
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		local code, raw = ds:GetAndWait(self.EnergyKey)
		self._T.energyBusy = false
		if code ~= 0 and code ~= 1000002 then
			log_warning("[VRF] energy load failed code=" .. tostring(code))
			return
		end
		local data = {}
		if code == 0 and raw ~= nil and raw ~= "" then
			local ok, decoded = pcall(function() return _HttpService:JSONDecode(raw) end)
			if not ok or type(decoded) ~= "table" or type(decoded["amount"]) ~= "number" or type(decoded["next"]) ~= "number" then
				log_warning("[VRF] energy invalid saved data; entry blocked")
				return
			end
			data = decoded
		end
		self.Energy = math.max(0, math.min(self.EnergyMax, math.floor(data["amount"] or self.EnergyMax)))
		self.EnergyNextAt = math.max(0, data["next"] or 0)
		self.EnergyLoaded = true
		self:RechargeEnergyAt(self:EnergyNow())
		log("[VRF] energy loaded amount=" .. tostring(self.Energy) .. " remaining=" .. tostring(self.EnergyRemaining))
	end

	@ExecSpace("ServerOnly")
	method void RechargeEnergyAt(number now)
		-- 누락된 충전 횟수를 한 번에 반영하고 잔여 시간을 보존한다. 가득 찬 뒤의 시간은 비축하지 않는다.
		if not self.EnergyLoaded or self._T.energyBusy then return end
		if self.Energy >= self.EnergyMax then
			self.Energy = self.EnergyMax
			self.EnergyNextAt = 0
			self.EnergyRemaining = 0
			return
		end
		if self.EnergyNextAt <= 0 then self.EnergyNextAt = now + self.EnergyInterval end
		if now >= self.EnergyNextAt then
			local gained = math.floor((now - self.EnergyNextAt) / self.EnergyInterval) + 1
			self.Energy = math.min(self.EnergyMax, self.Energy + gained)
			self.EnergyNextAt = self.EnergyNextAt + gained * self.EnergyInterval
			if self.Energy >= self.EnergyMax then self.EnergyNextAt = 0 end
			log("[VRF] energy recharge amount=" .. tostring(self.Energy))
		end
		self.EnergyRemaining = self.EnergyNextAt > 0 and math.max(0, math.ceil(self.EnergyNextAt - now)) or 0
	end

	@ExecSpace("ServerOnly")
	method boolean ConsumeEntryEnergy()
		-- 입장 직전 3개 차감을 저장한 뒤에만 허용한다. 저장 중 중복 요청 및 저장 실패는 입장하지 않는다.
        if not self.AccountLoaded then
            self:EntryEnergyNotice("계정 정보를 불러오는 중입니다", self.Entity.PlayerComponent.UserId)
            return false
        end
		if not self.EnergyLoaded then
			self:EntryEnergyNotice("입장 에너지를 불러오는 중입니다", self.Entity.PlayerComponent.UserId)
			return false
		end
		if self._T.energyBusy then return false end
		local now = self:EnergyNow()
		self:RechargeEnergyAt(now)
		if self.Energy < self.EnergyCost then
			self:EntryEnergyNotice("입장 에너지가 부족합니다 (" .. tostring(self.Energy) .. "/" .. tostring(self.EnergyCost) .. ")", self.Entity.PlayerComponent.UserId)
			log("[VRF] energy entry denied amount=" .. tostring(self.Energy))
			return false
		end
		local amount = self.Energy - self.EnergyCost
		local nextAt = self.EnergyNextAt
		if self.Energy >= self.EnergyMax then nextAt = now + self.EnergyInterval end
		self._T.energyBusy = true
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		local code = ds:SetAndWait(self.EnergyKey, _HttpService:JSONEncode({ amount = amount, next = nextAt }))
		self._T.energyBusy = false
		if code ~= 0 then
			self:EntryEnergyNotice("입장 정보를 저장하지 못했습니다. 잠시 후 다시 시도해 주세요", self.Entity.PlayerComponent.UserId)
			log_warning("[VRF] energy entry save failed code=" .. tostring(code))
			return false
		end
		self.Energy = amount
		self.EnergyNextAt = nextAt
		self:RechargeEnergyAt(self:EnergyNow())
		log("[VRF] energy spent cost=" .. tostring(self.EnergyCost) .. " amount=" .. tostring(self.Energy))
		return true
	end

	@ExecSpace("Client")
	method void EntryEnergyNotice(string msg)
		-- 요청한 사용자에게 로비 또는 결과창의 입장 실패 이유를 알린다.
		local map = self.Entity.CurrentMap
		if isvalid(map) and map.Name == self.LobbyMapName then
			_LobbyUILogic:ShowNotice(msg)
		else
			_ResultPopupLogic:ShowEntryNotice(msg)
		end
	end

	@ExecSpace("ServerOnly")
	method void LoadTable()
		-- EngraveTable: 계열(Atk/Def/Util) × 단계(1~4) × 칸(1~2), 노드마다 효과 종류·레벨당 수치·최대 레벨.
		self._T.nodes = {}
		self._T.nodeById = {}
		local ds = _DataService:GetTable(self.TableName)
		if ds == nil then
			log_error("[VRF] EngraveTable not found")
			return
		end
		for i = 1, ds:GetRowCount() do
			local n = {
				id = ds:GetCell(i, "Id"), branch = ds:GetCell(i, "Branch"),
				tier = tonumber(ds:GetCell(i, "Tier")) or 1, col = tonumber(ds:GetCell(i, "Col")) or 1, type = ds:GetCell(i, "Type"),
				per = tonumber(ds:GetCell(i, "PerLv")) or 0, max = tonumber(ds:GetCell(i, "MaxLv")) or 3,
			}
			table.insert(self._T.nodes, n)
			self._T.nodeById[n.id] = n
		end
	end

	@ExecSpace("ServerOnly")
	method void LoadData()
		-- 저장된 각인을 읽는다. 처음이면 예전 최고 도달 층에서 클리어 층(도달 층 - 1)을 옮겨 온다.
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		local errorCode, raw = ds:GetAndWait(self.StorageKey)
		local cleared = 0
		local lv = {}
		if errorCode == 0 and raw ~= nil and raw ~= "" then
			local t = _HttpService:JSONDecode(raw)
			if t ~= nil then
				cleared = math.floor(t["c"] or 0)
				if t["lv"] ~= nil then lv = t["lv"] end
			end
		elseif errorCode == 0 or errorCode == 1000002 then
			-- 아직 각인 저장이 없음 (빈 값 또는 NotFound)
			local code2, raw2 = ds:GetAndWait(self.LegacyKey)
			if code2 == 0 and raw2 ~= nil and raw2 ~= "" then
				local t = _HttpService:JSONDecode(raw2)
				if t ~= nil and t["best"] ~= nil then cleared = math.max(0, math.floor(t["best"]) - 1) end
			end
			if cleared > 0 then self:MarkDirty() end
		else
			log_warning("[VRF] engrave load failed code=" .. tostring(errorCode))
			self.RetryTimer = self.LoadRetryDelay
			return
		end
		self.ClearedFloor = cleared
		-- 테이블에 없는 노드는 버리고 최대 레벨을 넘지 않게 정리한다.
		local spent = 0
		for _, n in ipairs(self._T.nodes) do
			local v = math.max(0, math.min(n.max, math.floor(lv[n.id] or 0)))
			self.Lv[n.id] = v
			spent = spent + v
		end
		-- 해금 조건(같은 줄 바로 위 노드 만렙)이 안 맞는 노드는 포인트를 돌려준다 (테이블은 단계 순서라 위에서부터 확인)
		for _, n in ipairs(self._T.nodes) do
			if (self.Lv[n.id] or 0) > 0 and not self:IsNodeOpen(n.id) then
				spent = spent - self.Lv[n.id]
				self.Lv[n.id] = 0
				self:MarkDirty()
				log("[VRF] engrave refund locked node " .. n.id)
			end
		end
		self.Spent = spent
		if spent > cleared then
			for _, n in ipairs(self._T.nodes) do self.Lv[n.id] = 0 end
			self.Spent = 0
			self:MarkDirty()
		end
		self.Loaded = true
		log("[VRF] engrave loaded cleared=" .. tostring(self.ClearedFloor) .. " spent=" .. tostring(self.Spent))
	end

	@ExecSpace("ServerOnly")
	method string Encode()
		-- 저장 문자열: {"c":클리어 층,"lv":{노드:레벨}} (0레벨 노드는 생략).
		local lv = {}
		local any = false
		for _, n in ipairs(self._T.nodes) do
			local v = self.Lv[n.id] or 0
			if v > 0 then
				lv[n.id] = v
				any = true
			end
		end
		-- 빈 테이블은 JSONEncode가 지원하지 않으므로 찍은 각인이 없으면 lv를 뺀다
		if not any then return _HttpService:JSONEncode({ c = self.ClearedFloor }) end
		return _HttpService:JSONEncode({ c = self.ClearedFloor, lv = lv })
	end

	@ExecSpace("ServerOnly")
	method void MarkDirty()
		-- 변경 표시 (저장할 때 세대 번호로 그 사이 변경 여부를 확인).
		self.Dirty = true
		self.SaveGen = self.SaveGen + 1
	end

	@ExecSpace("ServerOnly")
	method void Flush()
		-- 바뀐 것이 있을 때만 저장한다. 저장 중 또 바뀌면 Dirty를 유지해 다음에 다시 저장.
		if not self.Loaded or not self.Dirty then return end
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		local gen = self.SaveGen
		ds:SetAsync(self.StorageKey, self:Encode(), function(errorCode, key)
			if errorCode == 0 then
				if self.SaveGen == gen then self.Dirty = false end
				log("[VRF] engrave saved cleared=" .. tostring(self.ClearedFloor) .. " spent=" .. tostring(self.Spent))
			else
				log_warning("[VRF] engrave save failed code=" .. tostring(errorCode))
			end
		end)
	end

	@ExecSpace("ServerOnly")
	method boolean ReportCleared(integer floor)
		-- 층 클리어 보고: 최고 클리어 층을 넘었을 때만 포인트가 늘고 바로 저장한다.
		if not self.Loaded or floor <= self.ClearedFloor then return false end
		self.ClearedFloor = floor
		self:MarkDirty()
		self:Flush()
		log("[VRF] engrave cleared floor=" .. tostring(floor) .. " points=" .. tostring(self.ClearedFloor))
		return true
	end

	@ExecSpace("ServerOnly")
	method table BuildValues()
		-- 판 시작 시 적용할 각인 효과 합계 {효과 종류 = 수치}.
		local values = {}
		for _, n in ipairs(self._T.nodes) do
			local v = self.Lv[n.id] or 0
			if v > 0 then values[n.type] = (values[n.type] or 0) + n.per * v end
		end
		return values
	end

	@ExecSpace("ServerOnly")
	method boolean IsNodeOpen(string nodeId)
		-- 1단계는 항상 열림. 그 외에는 같은 계열·같은 줄(칸)의 바로 앞 단계 노드를 최대 레벨까지 찍어야 열린다.
		local n = self._T.nodeById[nodeId]
		if n == nil then return false end
		if n.tier <= 1 then return true end
		for _, p in ipairs(self._T.nodes) do
			if p.branch == n.branch and p.col == n.col and p.tier == n.tier - 1 then return (self.Lv[p.id] or 0) >= p.max end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method void LoadSymbolTables()
		-- 심볼 단계표(확률·층 효과)와 3단계 영구 능력치 순환표.
		self._T.symbolTiers = {}
		local ts = _DataService:GetTable(self.SymbolTierTableName)
		if ts ~= nil then
			for i = 1, ts:GetRowCount() do
				local t = tonumber(ts:GetCell(i, "Tier")) or i
				self._T.symbolTiers[t] = {
					chance = tonumber(ts:GetCell(i, "Chance")) or 0, dmg = tonumber(ts:GetCell(i, "DmgPct")) or 0,
					cut = tonumber(ts:GetCell(i, "DmgCut")) or 0, gain = tonumber(ts:GetCell(i, "GainPct")) or 0,
				}
			end
		end
		self._T.symbolPerm = {}
		local ps = _DataService:GetTable(self.SymbolPermTableName)
		if ps ~= nil then
			for i = 1, ps:GetRowCount() do
				table.insert(self._T.symbolPerm, { type = ps:GetCell(i, "Type"), value = tonumber(ps:GetCell(i, "Value")) or 0 })
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void LoadSymbols()
		-- 저장된 심볼을 읽는다. {"s":{"층":단계}}
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		local errorCode, raw = ds:GetAndWait(self.SymbolKey)
		local s = {}
		if errorCode == 0 and raw ~= nil and raw ~= "" then
			local t = _HttpService:JSONDecode(raw)
			if t ~= nil and t["s"] ~= nil then s = t["s"] end
		elseif errorCode ~= 0 and errorCode ~= 1000002 then
			log_warning("[VRF] symbol load failed code=" .. tostring(errorCode))
			self.SymbolRetryTimer = self.LoadRetryDelay
			return
		end
		-- 서버 계산용 일반 테이블(_T.sym)과 클라이언트 표시용 SyncTable(SymbolLv)을 함께 채운다
		self._T.sym = {}
		local count = 0
		for floor, tier in pairs(s) do
			local v = math.max(0, math.min(3, math.floor(tonumber(tier) or 0)))
			if v > 0 then
				self._T.sym[tostring(floor)] = v
				self.SymbolLv[tostring(floor)] = v
				count = count + 1
			end
		end
		self.SymbolCount = count
		self.SymbolLoaded = true
		log("[VRF] symbols loaded count=" .. tostring(count))
	end

	@ExecSpace("ServerOnly")
	method string EncodeSymbols()
		-- 저장 문자열 (가진 심볼이 없으면 빈 객체 대신 s를 생략).
		local s = {}
		local any = false
		for floor, tier in pairs(self._T.sym or {}) do
			if tier > 0 then
				s[floor] = tier
				any = true
			end
		end
		if not any then return _HttpService:JSONEncode({ v = 1 }) end
		return _HttpService:JSONEncode({ v = 1, s = s })
	end

	@ExecSpace("ServerOnly")
	method void SaveSymbols()
		-- 심볼은 얻을 때마다 바로 저장한다.
		if not self.SymbolLoaded then return end
		self.SymbolDirty = true
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		ds:SetAsync(self.SymbolKey, self:EncodeSymbols(), function(errorCode, key)
			if errorCode == 0 then
				self.SymbolDirty = false
			else
				log_warning("[VRF] symbol save failed code=" .. tostring(errorCode))
			end
		end)
	end

	@ExecSpace("ServerOnly")
	method integer SymbolTier(integer floor)
		-- 그 층 심볼 단계 (없으면 0).
		return (self._T.sym or {})[tostring(floor)] or 0
	end

	@ExecSpace("ServerOnly")
	method table SymbolTierInfo(integer tier)
		-- 단계별 층 효과 {dmg, cut, gain} (없으면 nil).
		return self._T.symbolTiers[tier]
	end

	@ExecSpace("ServerOnly")
	method integer RollSymbol(integer floor)
		-- 그 층 보스 처치: 3단계(1%) → 2단계(10%) → 1단계(50%) 순서로 판정, 지금보다 높은 단계만 (건너뛰기 가능). 얻은 단계 반환(없으면 0).
		if not self.SymbolLoaded then return 0 end
		local cur = self:SymbolTier(floor)
		for tier = 3, 1, -1 do
			local info = self._T.symbolTiers[tier]
			if tier > cur and info ~= nil and _UtilLogic:RandomDouble() * 100 < info.chance then
				if cur == 0 then self.SymbolCount = self.SymbolCount + 1 end
				self._T.sym[tostring(floor)] = tier
				self.SymbolLv[tostring(floor)] = tier
				self:SaveSymbols()
				log("[VRF] symbol get floor=" .. tostring(floor) .. " tier=" .. tostring(tier) .. " (was " .. tostring(cur) .. ")")
				return tier
			end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method table SymbolPermValues()
		-- 3단계 심볼의 모든 층 영구 능력치 합계 {효과 종류 = 수치}. 층 번호에 따라 능력치 종류가 순환.
		local values = {}
		local n = #self._T.symbolPerm
		if n == 0 then return values end
		for floor, tier in pairs(self._T.sym or {}) do
			if tier >= 3 then
				local p = self._T.symbolPerm[((math.floor(tonumber(floor) or 1) - 1) % n) + 1]
				values[p.type] = (values[p.type] or 0) + p.value
			end
		end
		return values
	end

	@ExecSpace("ServerOnly")
	method void LoadGraceTables()
		-- 은총 옵션표(등급별 최소~최대), 등급 확률, 수치 단계 확률.
		self._T.graceOpts = {}
		self._T.graceOptById = {}
		local optDs = _DataService:GetTable("GraceOptionTable")
		if optDs ~= nil then
			for i = 1, optDs:GetRowCount() do
				local o = { id = optDs:GetCell(i, "Id"), type = optDs:GetCell(i, "Type"), ranges = {} }
				for g = 1, 5 do
					o.ranges[g] = { min = tonumber(optDs:GetCell(i, "G" .. tostring(g) .. "Min")) or 0, max = tonumber(optDs:GetCell(i, "G" .. tostring(g) .. "Max")) or 0 }
				end
				table.insert(self._T.graceOpts, o)
				self._T.graceOptById[o.id] = o
			end
		end
		self._T.graceGrades = {}
		local gs = _DataService:GetTable("GraceGradeTable")
		if gs ~= nil then
			for i = 1, gs:GetRowCount() do table.insert(self._T.graceGrades, { grade = tonumber(gs:GetCell(i, "Grade")) or i, chance = tonumber(gs:GetCell(i, "Chance")) or 0 }) end
		end
		self._T.graceSteps = {}
		local ss = _DataService:GetTable("GraceStepTable")
		if ss ~= nil then
			for i = 1, ss:GetRowCount() do table.insert(self._T.graceSteps, { step = tonumber(ss:GetCell(i, "Step")) or i, chance = tonumber(ss:GetCell(i, "Chance")) or 0 }) end
		end
	end

	@ExecSpace("ServerOnly")
	method void LoadGrace()
		-- 저장된 은총을 읽는다. {"f":깃털,"p":프리셋,"l":{"프리셋_줄":"옵션|등급|단계|잠금"}}
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		local errorCode, raw = ds:GetAndWait(self.GraceKey)
		local t = {}
		if errorCode == 0 and raw ~= nil and raw ~= "" then
			t = _HttpService:JSONDecode(raw) or {}
		elseif errorCode ~= 0 and errorCode ~= 1000002 then
			log_warning("[VRF] grace load failed code=" .. tostring(errorCode))
			self.GraceRetryTimer = self.LoadRetryDelay
			return
		end
		self.Feathers = math.max(0, math.floor(t["f"] or 0))
		self.GracePreset = math.max(1, math.min(self.GracePresetCount, math.floor(t["p"] or 1)))
		local lines = t["l"] or {}
		for p = 1, self.GracePresetCount do
			for i = 1, self.GraceSlots do
				local key = tostring(p) .. "_" .. tostring(i)
				local v = lines[key] or ""
				-- 옵션표에 없는 옵션은 빈 줄로
				if v ~= "" and self._T.graceOptById[self:GraceField(v, 1)] == nil then v = "" end
				self.GraceLines[key] = v
			end
		end
		self.GraceLoaded = true
		log("[VRF] grace loaded feathers=" .. tostring(self.Feathers) .. " preset=" .. tostring(self.GracePreset))
	end

	@ExecSpace("ServerOnly")
	method string GraceField(string line, integer idx)
		-- "옵션|등급|단계|잠금"에서 idx번째 값.
		local n = 0
		for part in string.gmatch(line, "[^|]+") do
			n = n + 1
			if n == idx then return part end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method string EncodeGrace()
		-- 저장 문자열 (빈 줄은 생략, 하나도 없으면 l 생략).
		local lines = {}
		local any = false
		for p = 1, self.GracePresetCount do
			for i = 1, self.GraceSlots do
				local key = tostring(p) .. "_" .. tostring(i)
				local v = self.GraceLines[key] or ""
				if v ~= "" then
					lines[key] = v
					any = true
				end
			end
		end
		if not any then return _HttpService:JSONEncode({ f = self.Feathers, p = self.GracePreset }) end
		return _HttpService:JSONEncode({ f = self.Feathers, p = self.GracePreset, l = lines })
	end

	@ExecSpace("ServerOnly")
	method void SaveGrace()
		-- 은총 저장 (비동기).
		if not self.GraceLoaded then return end
		self.GraceDirty = true
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		ds:SetAsync(self.GraceKey, self:EncodeGrace(), function(errorCode, key)
			if errorCode == 0 then
				self.GraceDirty = false
			else
				log_warning("[VRF] grace save failed code=" .. tostring(errorCode))
			end
		end)
	end

	@ExecSpace("ServerOnly")
	method void AddFeathers(integer n)
		-- 전투 중 깃털 획득: 바로 저장하지 않고 표시만 (판이 끝날 때·나갈 때 저장).
		if not self.GraceLoaded or n <= 0 then return end
		self.Feathers = self.Feathers + n
		self.GraceDirty = true
	end

	@ExecSpace("ServerOnly")
	method void FlushGrace()
		-- 바뀐 은총(깃털 포함)이 있으면 저장.
		if self.GraceLoaded and self.GraceDirty then self:SaveGrace() end
	end

	@ExecSpace("ServerOnly")
	method number GraceValue(string optId, integer grade, integer step)
		-- 수치 = 그 등급 최소 + (최대 - 최소) × (단계 - 1) / 4, 소수 첫째 자리.
		local o = self._T.graceOptById[optId]
		if o == nil or o.ranges[grade] == nil then return 0 end
		local r = o.ranges[grade]
		local v = r.min + (r.max - r.min) * (step - 1) / 4
		return math.floor(v * 10 + 0.5) / 10
	end

	@ExecSpace("ServerOnly")
	method table GraceValues()
		-- 판 시작 시 적용할 지금 프리셋의 은총 합계 {효과 종류 = 수치}.
		local values = {}
		if not self.GraceLoaded then return values end
		for i = 1, self.GraceSlots do
			local v = self.GraceLines[tostring(self.GracePreset) .. "_" .. tostring(i)] or ""
			if v ~= "" then
				local o = self._T.graceOptById[self:GraceField(v, 1)]
				if o ~= nil then
					local val = self:GraceValue(o.id, math.floor(tonumber(self:GraceField(v, 2)) or 1), math.floor(tonumber(self:GraceField(v, 3)) or 1))
					values[o.type] = (values[o.type] or 0) + val
				end
			end
		end
		return values
	end

	@ExecSpace("ServerOnly")
	method integer PickWeighted(table list)
		-- {chance} 목록에서 가중치 추첨 → 인덱스.
		local sum = 0
		for _, e in ipairs(list) do sum = sum + e.chance end
		local r = _UtilLogic:RandomDouble() * sum
		for i, e in ipairs(list) do
			r = r - e.chance
			if r < 0 then return i end
		end
		return #list
	end

	@ExecSpace("ServerOnly")
	method boolean CanEditGrace(string fromUserId)
		-- 본인 + 불러오기 완료 + 로비에서만.
		if fromUserId ~= self.Entity.PlayerComponent.UserId or not self.GraceLoaded then return false end
		local map = self.Entity.CurrentMap
		return isvalid(map) and map.Name == self.LobbyMapName
	end

	@ExecSpace("Server")
	method void RequestGraceRoll()
		-- 은총 받기: 지금 프리셋에서 잠기지 않은 줄을 전부 새로 뽑는다 (같은 옵션은 한 프리셋에 한 번만). 비용 = 기본 + 잠금 수 × 추가.
		if not self:CanEditGrace(senderUserId) then return end
		local p = tostring(self.GracePreset)
		local used = {}
		local locks = 0
		for i = 1, self.GraceSlots do
			local v = self.GraceLines[p .. "_" .. tostring(i)] or ""
			if v ~= "" and self:GraceField(v, 4) == "1" then
				locks = locks + 1
				used[self:GraceField(v, 1)] = true
			end
		end
		local cost = self.GraceBaseCost + self.GraceLockCost * locks
		if self.Feathers < cost then return end
		self.Feathers = self.Feathers - cost
		for i = 1, self.GraceSlots do
			local key = p .. "_" .. tostring(i)
			local v = self.GraceLines[key] or ""
			if v == "" or self:GraceField(v, 4) ~= "1" then
				local pool = {}
				for _, o in ipairs(self._T.graceOpts) do
					if not used[o.id] then table.insert(pool, o) end
				end
				if #pool > 0 then
					local o = pool[_UtilLogic:RandomIntegerRange(1, #pool)]
					used[o.id] = true
					local g = self._T.graceGrades[self:PickWeighted(self._T.graceGrades)].grade
					local st = self._T.graceSteps[self:PickWeighted(self._T.graceSteps)].step
					self.GraceLines[key] = o.id .. "|" .. tostring(g) .. "|" .. tostring(st) .. "|0"
				end
			end
		end
		self.GraceSeq = self.GraceSeq + 1
		self:SaveGrace()
		log("[VRF] grace roll preset=" .. p .. " locks=" .. tostring(locks) .. " cost=" .. tostring(cost) .. " feathers=" .. tostring(self.Feathers))
	end

	@ExecSpace("Server")
	method void RequestGraceLock(integer slot)
		-- 줄 잠금/해제 (빈 줄은 잠글 수 없음, 최대 4줄).
		if not self:CanEditGrace(senderUserId) then return end
		local p = tostring(self.GracePreset)
		local key = p .. "_" .. tostring(slot)
		local v = self.GraceLines[key] or ""
		if v == "" then return end
		local locked = self:GraceField(v, 4) == "1"
		if not locked then
			local locks = 0
			for i = 1, self.GraceSlots do
				local w = self.GraceLines[p .. "_" .. tostring(i)] or ""
				if w ~= "" and self:GraceField(w, 4) == "1" then locks = locks + 1 end
			end
			if locks >= self.GraceMaxLocks then return end
		end
		local newLock = "1"
		if locked then newLock = "0" end
		self.GraceLines[key] = self:GraceField(v, 1) .. "|" .. self:GraceField(v, 2) .. "|" .. self:GraceField(v, 3) .. "|" .. newLock
		self:SaveGrace()
	end

	@ExecSpace("Server")
	method void RequestGracePreset(integer preset)
		-- 프리셋 전환 (무료).
		if not self:CanEditGrace(senderUserId) then return end
		self.GracePreset = math.max(1, math.min(self.GracePresetCount, preset))
		self:SaveGrace()
	end

	@ExecSpace("ServerOnly")
	method void LoadSlotTables()
		-- 단계 구간별 기본 확률, 주문서 효율, 단계 보너스.
		self._T.slotIds = {}
		self._T.scrollPower = {}
		local ss = _DataService:GetTable("SlotScrollTable")
		if ss ~= nil then
			for i = 1, ss:GetRowCount() do
				local slot = ss:GetCell(i, "Slot")
				local tier = math.floor(tonumber(ss:GetCell(i, "Tier")) or 1)
				if self._T.scrollPower[slot] == nil then
					self._T.scrollPower[slot] = {}
					table.insert(self._T.slotIds, slot)
				end
				self._T.scrollPower[slot][tier] = tonumber(ss:GetCell(i, "Power")) or 1
			end
		end
		self._T.slotRates = {}
		local rs = _DataService:GetTable("SlotRateTable")
		if rs ~= nil then
			for i = 1, rs:GetRowCount() do table.insert(self._T.slotRates, { min = tonumber(rs:GetCell(i, "MinLevel")) or 0, rate = tonumber(rs:GetCell(i, "Rate")) or 0 }) end
		end
		self._T.slotMiles = {}
		local ms = _DataService:GetTable("SlotMilestoneTable")
		if ms ~= nil then
			for i = 1, ms:GetRowCount() do
				table.insert(self._T.slotMiles, { slot = ms:GetCell(i, "Slot"), level = tonumber(ms:GetCell(i, "Level")) or 0, type = ms:GetCell(i, "Type"), value = tonumber(ms:GetCell(i, "Value")) or 0 })
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void LoadSlots()
		-- 저장된 슬롯을 읽는다. {"lv":{부위:단계},"b":{부위:추가 확률},"s":{"부위_단계":보유}}
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		local errorCode, raw = ds:GetAndWait(self.SlotKey)
		local t = {}
		if errorCode == 0 and raw ~= nil and raw ~= "" then
			t = _HttpService:JSONDecode(raw) or {}
		elseif errorCode ~= 0 and errorCode ~= 1000002 then
			log_warning("[VRF] slot load failed code=" .. tostring(errorCode))
			self.SlotRetryTimer = self.LoadRetryDelay
			return
		end
		local lv = t["lv"] or {}
		local bonus = t["b"] or {}
		local scrolls = t["s"] or {}
		for _, slot in ipairs(self._T.slotIds) do
			self.SlotLv[slot] = math.max(0, math.min(self.SlotMaxLevel, math.floor(lv[slot] or 0)))
			self.SlotBonus[slot] = math.max(0, tonumber(bonus[slot]) or 0)
			for tier, _ in pairs(self._T.scrollPower[slot]) do
				local key = slot .. "_" .. tostring(tier)
				self.Scrolls[key] = math.max(0, math.floor(scrolls[key] or 0))
			end
		end
		self.SlotLoaded = true
		log("[VRF] slots loaded " .. self:EncodeSlots())
	end

	@ExecSpace("ServerOnly")
	method string EncodeSlots()
		-- 저장 문자열 (0인 값은 생략, 빈 테이블은 JSONEncode가 지원하지 않으므로 키째 뺀다).
		local data = { v = 1 }
		local lv = {}
		local bonus = {}
		local scrolls = {}
		for _, slot in ipairs(self._T.slotIds) do
			if (self.SlotLv[slot] or 0) > 0 then
				lv[slot] = self.SlotLv[slot]
				data["lv"] = lv
			end
			if (self.SlotBonus[slot] or 0) > 0 then
				bonus[slot] = self.SlotBonus[slot]
				data["b"] = bonus
			end
			for tier, _ in pairs(self._T.scrollPower[slot]) do
				local key = slot .. "_" .. tostring(tier)
				if (self.Scrolls[key] or 0) > 0 then
					scrolls[key] = self.Scrolls[key]
					data["s"] = scrolls
				end
			end
		end
		return _HttpService:JSONEncode(data)
	end

	@ExecSpace("ServerOnly")
	method void SaveSlots()
		-- 슬롯 저장 (비동기).
		if not self.SlotLoaded then return end
		self.SlotDirty = true
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		ds:SetAsync(self.SlotKey, self:EncodeSlots(), function(errorCode, key)
			if errorCode == 0 then
				self.SlotDirty = false
			else
				log_warning("[VRF] slot save failed code=" .. tostring(errorCode))
			end
		end)
	end

	@ExecSpace("ServerOnly")
	method void AddScrolls(string slot, integer tier, integer n)
		-- 전투 중 주문서 획득: 바로 저장하지 않고 표시만 (판이 끝날 때·나갈 때 저장).
		if not self.SlotLoaded or n <= 0 then return end
		local key = slot .. "_" .. tostring(tier)
		self.Scrolls[key] = (self.Scrolls[key] or 0) + n
		self.SlotDirty = true
	end

	@ExecSpace("ServerOnly")
	method void FlushSlots()
		-- 바뀐 슬롯(주문서 포함)이 있으면 저장.
		if self.SlotLoaded and self.SlotDirty then self:SaveSlots() end
	end

	@ExecSpace("ServerOnly")
	method number SlotBaseRate(integer level)
		-- 그 단계에서 효율 1배 주문서 1장의 성공 확률.
		local rate = 0
		for _, r in ipairs(self._T.slotRates) do
			if level >= r.min then rate = r.rate end
		end
		return rate
	end

	@ExecSpace("ServerOnly")
	method table SlotRunData()
		-- 판 시작 시 적용할 슬롯 효과. 부위별 {단계, 강화 확률, 비용 감소, 시작 강화, 이중 강화} + 능력치 보너스 합계.
		local data = { slots = {}, bonus = {} }
		if not self.SlotLoaded then return data end
		for _, slot in ipairs(self._T.slotIds) do data.slots[slot] = { lv = self.SlotLv[slot] or 0, enhRate = 0, costDown = 0, startEnh = 0, doubleEnh = 0 } end
		for _, m in ipairs(self._T.slotMiles) do
			local s = data.slots[m.slot]
			if s ~= nil and s.lv >= m.level then
				if m.type == "SlotEnhRate" then s.enhRate = s.enhRate + m.value
				elseif m.type == "SlotCostDown" then s.costDown = s.costDown + m.value
				elseif m.type == "SlotStartEnh" then s.startEnh = s.startEnh + m.value
				elseif m.type == "SlotDoubleEnh" then s.doubleEnh = s.doubleEnh + m.value
				else data.bonus[m.type] = (data.bonus[m.type] or 0) + m.value
				end
			end
		end
		return data
	end

	@ExecSpace("Server")
	method void RequestSlotUpgrade(string slot, integer tier, integer count)
		-- 슬롯 강화: 같은 주문서 1~3장 사용. 성공 확률 = 기본 × 효율 × 장수 + 추가 확률. 실패하면 시도 확률의 10%가 쌓이고 성공하면 초기화.
		if senderUserId ~= self.Entity.PlayerComponent.UserId or not self.SlotLoaded then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) or map.Name ~= self.LobbyMapName then return end
		local powers = self._T.scrollPower[slot]
		if powers == nil or powers[tier] == nil or count < 1 or count > self.SlotMaxScrolls then return end
		local lv = self.SlotLv[slot] or 0
		local key = slot .. "_" .. tostring(tier)
		if lv >= self.SlotMaxLevel or (self.Scrolls[key] or 0) < count then return end
		self.Scrolls[key] = self.Scrolls[key] - count
		local rate = math.min(100, self:SlotBaseRate(lv) * powers[tier] * count + (self.SlotBonus[slot] or 0))
		local ok = _UtilLogic:RandomDouble() * 100 < rate
		if ok then
			self.SlotLv[slot] = lv + 1
			self.SlotBonus[slot] = 0
		else
			self.SlotBonus[slot] = (self.SlotBonus[slot] or 0) + math.floor(rate * self.SlotFailRatio * 100 + 0.5) / 100
		end
		self.SlotOk = ok
		self.SlotSeq = self.SlotSeq + 1
		self:SaveSlots()
		log("[VRF] slot upgrade " .. slot .. " tier=" .. tostring(tier) .. " x" .. tostring(count) .. " rate=" .. tostring(rate) .. " ok=" .. tostring(ok) .. " lv=" .. tostring(self.SlotLv[slot]) .. " bonus=" .. tostring(self.SlotBonus[slot]))
	end

	@ExecSpace("ServerOnly")
	method void LoadSkillTables()
		-- 스킬표(순서·등급)·등급표(뽑기·합성 확률)와 RunConfig의 뽑기·레벨업 수치.
		self._T.skills = {}
		self._T.skillById = {}
		self._T.gradeSkills = {}
		self._T.jobGradeSkills = {}
		self._T.jobs = {}
		self._T.grades = {}
		local ds = _DataService:GetTable(self.SkillTableName)
		if ds ~= nil then
			for i = 1, ds:GetRowCount() do
				local job = ds:GetCell(i, "JobId")
				if job == nil or job == "" then job = "Hero" end
				local sk = { id = ds:GetCell(i, "SkillId"), order = tonumber(ds:GetCell(i, "Order")) or i, grade = tonumber(ds:GetCell(i, "Grade")) or 1, job = job }
				table.insert(self._T.skills, sk)
				self._T.skillById[sk.id] = sk
				if self._T.gradeSkills[sk.grade] == nil then self._T.gradeSkills[sk.grade] = {} end
				table.insert(self._T.gradeSkills[sk.grade], sk.id)
				if self._T.jobGradeSkills[job] == nil then
					self._T.jobGradeSkills[job] = {}
					table.insert(self._T.jobs, job)
				end
				if self._T.jobGradeSkills[job][sk.grade] == nil then self._T.jobGradeSkills[job][sk.grade] = {} end
				table.insert(self._T.jobGradeSkills[job][sk.grade], sk.id)
			end
		end
		local gs = _DataService:GetTable(self.SkillGradeTableName)
		if gs ~= nil then
			for i = 1, gs:GetRowCount() do
				self._T.grades[tonumber(gs:GetCell(i, "Grade")) or i] = { name = gs:GetCell(i, "Name"), rate = tonumber(gs:GetCell(i, "GachaRate")) or 0, synth = tonumber(gs:GetCell(i, "SynthRate")) or 0 }
			end
		end
		local cfg = { GachaCost = 10, GachaTenCost = 100, SkillUpBase = 5, SkillMaxLv = 11, SkillSynthCount = 3 }
		local rc = _DataService:GetTable("RunConfig")
		if rc ~= nil then
			for i = 1, rc:GetRowCount() do
				local k = rc:GetCell(i, "Key")
				if cfg[k] ~= nil then cfg[k] = tonumber(rc:GetCell(i, "Value")) or cfg[k] end
			end
		end
		self._T.skillCfg = cfg
	end

	@ExecSpace("ServerOnly")
	method void LoadSkills()
		-- 저장된 스킬을 읽는다. {"b":스킬북,"o":{Id:레벨},"c":{Id:개수},"e":{"칸":Id}}. 처음이면 1~5번 보유·장착.
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		local errorCode, raw = ds:GetAndWait(self.SkillKey)
		local t = nil
		if errorCode == 0 and raw ~= nil and raw ~= "" then
			t = _HttpService:JSONDecode(raw)
		elseif errorCode ~= 0 and errorCode ~= 1000002 then
			log_warning("[VRF] skill load failed code=" .. tostring(errorCode))
			self.SkillRetryTimer = self.LoadRetryDelay
			return
		end
		local maxLv = self._T.skillCfg.SkillMaxLv
		if t == nil then t = { b = 0, o = {}, c = {}, e = {} } end
		local own = t["o"] or {}
		local cnt = t["c"] or {}
		local equip = t["e"] or {}
		self.SkillBooks = math.max(0, math.floor(t["b"] or 0))
		self.ComboAttackLv = math.max(0, math.min(self.ComboAttackMaxLv, math.floor(t["p"] or 0)))
		self.HolyWaterLv = math.max(1, math.min(self.HolyWaterMaxLv, math.floor(t["hw"] or 1)))
		local jp = t["jp"] or {}
		for _, job in ipairs(self._T.jobs) do
			if job ~= "Hero" and job ~= "Bishop" then self.JobPassiveLv[job] = math.max(0, math.min(self.JobPassiveMaxLv, math.floor(jp[job] or 0))) end
		end
		self.MainJob = "Hero"
		self.CompJob = "Bishop"
		if self._T.jobGradeSkills[t["mj"] or ""] ~= nil then self.MainJob = t["mj"] end
		if self._T.jobGradeSkills[t["cj"] or ""] ~= nil and t["cj"] ~= self.MainJob then self.CompJob = t["cj"] end
		if self.CompJob == self.MainJob then
			if self.MainJob == "Bishop" then self.CompJob = "Hero" else self.CompJob = "Bishop" end
		end
		for _, sk in ipairs(self._T.skills) do
			self.SkillOwnLv[sk.id] = math.max(0, math.min(maxLv, math.floor(own[sk.id] or 0)))
			self.SkillCnt[sk.id] = math.max(0, math.floor(cnt[sk.id] or 0))
		end
		-- 직업마다: 그 직업 스킬이 하나도 없으면 (처음·새 직업 추가) 표 순서 1~5를 지급
		for _, job in ipairs(self._T.jobs) do
			local any = false
			for _, sk in ipairs(self._T.skills) do
				if sk.job == job and self.SkillOwnLv[sk.id] > 0 then any = true break end
			end
			if not any then
				for _, sk in ipairs(self._T.skills) do
					if sk.job == job and sk.order <= self.SkillStartCount then self.SkillOwnLv[sk.id] = 1 end
				end
			end
		end
		for _, job in ipairs(self._T.jobs) do
			local used = {}
			for i = 1, self.SkillEquipSlots do
				local key = self:EquipKey(job, i)
				local id = equip[key] or ""
				local sk = self._T.skillById[id]
				if sk == nil or sk.job ~= job or (self.SkillOwnLv[id] or 0) <= 0 or used[id] then id = "" end
				if id ~= "" then used[id] = true end
				self.SkillEquip[key] = id
			end
			-- 장착 칸은 항상 5칸 모두 채운다 (빈 칸은 장착하지 않은 그 직업 보유 스킬을 표 순서대로)
			for i = 1, self.SkillEquipSlots do
				local key = self:EquipKey(job, i)
				if self.SkillEquip[key] == "" then
					for _, sk in ipairs(self._T.skills) do
						if sk.job == job and (self.SkillOwnLv[sk.id] or 0) > 0 and not used[sk.id] then
							self.SkillEquip[key] = sk.id
							used[sk.id] = true
							break
						end
					end
				end
			end
		end
		self.SkillLoaded = true
		log("[VRF] skills loaded " .. self:EncodeSkills())
	end

	method string EquipKey(string job, integer slot)
		-- 장착 칸 키: 히어로는 "1"~"5" (예전 저장과 호환), 다른 직업은 "직업:칸".
		if job == "Hero" then return tostring(slot) end
		return job .. ":" .. tostring(slot)
	end

	@ExecSpace("ServerOnly")
	method string EncodeSkills()
		-- 저장 문자열 (0·빈 값은 생략).
		local data = { b = self.SkillBooks }
		if self.ComboAttackLv > 0 then data["p"] = self.ComboAttackLv end
		if self.HolyWaterLv > 1 then data["hw"] = self.HolyWaterLv end
		local jp = {}
		local anyJp = false
		for _, job in ipairs(self._T.jobs) do
			local lv = self.JobPassiveLv[job] or 0
			if lv > 0 then
				jp[job] = lv
				anyJp = true
			end
		end
		if anyJp then data["jp"] = jp end
		if self.MainJob ~= "Hero" then data["mj"] = self.MainJob end
		if self.CompJob ~= "Bishop" then data["cj"] = self.CompJob end
		local own = {}
		local cnt = {}
		local equip = {}
		for _, sk in ipairs(self._T.skills) do
			if (self.SkillOwnLv[sk.id] or 0) > 0 then
				own[sk.id] = self.SkillOwnLv[sk.id]
				data["o"] = own
			end
			if (self.SkillCnt[sk.id] or 0) > 0 then
				cnt[sk.id] = self.SkillCnt[sk.id]
				data["c"] = cnt
			end
		end
		for _, job in ipairs(self._T.jobs) do
			for i = 1, self.SkillEquipSlots do
				local key = self:EquipKey(job, i)
				local id = self.SkillEquip[key] or ""
				if id ~= "" then
					equip[key] = id
					data["e"] = equip
				end
			end
		end
		return _HttpService:JSONEncode(data)
	end

	@ExecSpace("ServerOnly")
	method void SaveSkills()
		-- 스킬 저장 (비동기).
		if not self.SkillLoaded then return end
		self.SkillDirty = true
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		ds:SetAsync(self.SkillKey, self:EncodeSkills(), function(errorCode, key)
			if errorCode == 0 then
				self.SkillDirty = false
			else
				log_warning("[VRF] skill save failed code=" .. tostring(errorCode))
			end
		end)
	end

	@ExecSpace("ServerOnly")
	method void AddSkillBooks(integer n)
		-- 전투 중 스킬북 획득: 표시만 바꾸고 판이 끝날 때 저장.
		if not self.SkillLoaded or n <= 0 then return end
		self.SkillBooks = self.SkillBooks + n
		self.SkillDirty = true
	end

	@ExecSpace("ServerOnly")
	method void FlushSkills()
		-- 바뀐 스킬 정보(스킬북 포함)가 있으면 저장.
		if self.SkillLoaded and self.SkillDirty then self:SaveSkills() end
	end

	@ExecSpace("ServerOnly")
	method boolean CanEditSkill(string fromUserId)
		-- 본인 요청 + 불러오기 완료 + 로비에 있을 때만 스킬을 바꿀 수 있다.
		if fromUserId ~= self.Entity.PlayerComponent.UserId or not self.SkillLoaded then return false end
		local map = self.Entity.CurrentMap
		return isvalid(map) and map.Name == self.LobbyMapName
	end

	@ExecSpace("ServerOnly")
	method boolean GainSkill(string id)
		-- 스킬 1개 획득: 처음이면 Lv.1로 해금, 이미 있으면 재료 +1. 신규 여부를 돌려준다.
		if (self.SkillOwnLv[id] or 0) <= 0 then
			self.SkillOwnLv[id] = 1
			return true
		end
		self.SkillCnt[id] = (self.SkillCnt[id] or 0) + 1
		return false
	end

	@ExecSpace("ServerOnly")
	method string RandomSkillOfGrade(integer grade)
		-- 그 등급 스킬 중 하나 (균등).
		local list = self._T.gradeSkills[grade] or {}
		if #list == 0 then return "" end
		return list[_UtilLogic:RandomIntegerRange(1, #list)]
	end

	@ExecSpace("ServerOnly")
	method string RollGachaSkill()
		-- 뽑기 1회: 등급표 확률로 등급을 고르고 그 등급에서 균등하게 스킬 하나.
		local sum = 0
		for g, info in pairs(self._T.grades) do
			if #(self._T.gradeSkills[g] or {}) > 0 then sum = sum + info.rate end
		end
		local r = _UtilLogic:RandomDouble() * sum
		local pick = 1
		for g = 1, #self._T.grades do
			local info = self._T.grades[g]
			if info ~= nil and #(self._T.gradeSkills[g] or {}) > 0 then
				pick = g
				r = r - info.rate
				if r <= 0 then break end
			end
		end
		return self:RandomSkillOfGrade(pick)
	end

	@ExecSpace("Server")
	method void RequestGacha(integer count)
		-- 스킬 뽑기 1회·10회 (스킬북 소모). 결과는 SkillResult로 알린다.
		if not self:CanEditSkill(senderUserId) then return end
		local cfg = self._T.skillCfg
		local cost = cfg.GachaCost
		if count == 10 then cost = cfg.GachaTenCost elseif count ~= 1 then return end
		if self.SkillBooks < cost then return end
		self.SkillBooks = self.SkillBooks - cost
		local parts = {}
		for i = 1, count do
			local id = self:RollGachaSkill()
			if id ~= "" then
				local isNew = self:GainSkill(id)
				local flag = "0"
				if isNew then flag = "1" end
				table.insert(parts, id .. ":" .. flag)
			end
		end
		self.SkillResult = table.concat(parts, ",")
		self.SkillMsg = "gacha"
		self.SkillSeq = self.SkillSeq + 1
		self:SaveSkills()
		log("[VRF] gacha x" .. tostring(count) .. " books=" .. tostring(self.SkillBooks) .. " " .. self.SkillResult)
	end

	@ExecSpace("Server")
	method void RequestSkillUpgrade(string id)
		-- 스킬 레벨업: 재료 (레벨 × 5)개 소모, 최대 11레벨.
		if not self:CanEditSkill(senderUserId) then return end
		local lv = self.SkillOwnLv[id] or 0
		local cfg = self._T.skillCfg
		if lv <= 0 or lv >= cfg.SkillMaxLv then return end
		local need = lv * cfg.SkillUpBase
		if (self.SkillCnt[id] or 0) < need then return end
		self.SkillCnt[id] = self.SkillCnt[id] - need
		self.SkillOwnLv[id] = lv + 1
		self.SkillResult = id .. ":0"
		self.SkillMsg = "upgrade"
		self.SkillSeq = self.SkillSeq + 1
		self:SaveSkills()
		log("[VRF] skill upgrade " .. id .. " lv=" .. tostring(lv + 1))
	end

	@ExecSpace("ServerOnly")
	method integer ComboAttackCost()
		-- 콤보 어택 다음 레벨 스킬북 비용.
		return self.ComboAttackBaseCost + self.ComboAttackLv * self.ComboAttackStepCost
	end

	@ExecSpace("Server")
	method void RequestComboAttackUpgrade()
		-- 고유 패시브 콤보 어택 레벨업 (Lv.0→1 해금). 스킬북 소모.
		if not self:CanEditSkill(senderUserId) then return end
		if self.ComboAttackLv >= self.ComboAttackMaxLv then return end
		local cost = self:ComboAttackCost()
		if self.SkillBooks < cost then return end
		self.SkillBooks = self.SkillBooks - cost
		self.ComboAttackLv = self.ComboAttackLv + 1
		self.SkillResult = "ComboAttack:0"
		self.SkillMsg = "passive"
		self.SkillSeq = self.SkillSeq + 1
		self:SaveSkills()
		log("[VRF] combo attack lv=" .. tostring(self.ComboAttackLv) .. " books=" .. tostring(self.SkillBooks))
	end

	@ExecSpace("ServerOnly")
	method integer HolyWaterCost()
		-- 성수 다음 레벨 스킬북 비용.
		return self.HolyWaterBaseCost + (self.HolyWaterLv - 1) * self.HolyWaterStepCost
	end

	@ExecSpace("Server")
	method void RequestHolyWaterUpgrade()
		-- 비숍 고유 패시브 성수 레벨업. 스킬북 소모.
		if not self:CanEditSkill(senderUserId) then return end
		if self.HolyWaterLv >= self.HolyWaterMaxLv then return end
		local cost = self:HolyWaterCost()
		if self.SkillBooks < cost then return end
		self.SkillBooks = self.SkillBooks - cost
		self.HolyWaterLv = self.HolyWaterLv + 1
		self.SkillResult = "HolyWater:0"
		self.SkillMsg = "passive"
		self.SkillSeq = self.SkillSeq + 1
		self:SaveSkills()
		log("[VRF] holy water lv=" .. tostring(self.HolyWaterLv) .. " books=" .. tostring(self.SkillBooks))
	end

	@ExecSpace("Server")
	method void RequestJobPassiveUpgrade(string job)
		-- 나이트로드·보우마스터·바이퍼 고유 패시브 레벨업 (Lv.0→1 해금). 스킬북 소모.
		if not self:CanEditSkill(senderUserId) then return end
		if job == "Hero" or job == "Bishop" or self._T.jobGradeSkills[job] == nil then return end
		local lv = self.JobPassiveLv[job] or 0
		if lv >= self.JobPassiveMaxLv then return end
		local cost = self.JobPassiveBaseCost + lv * self.JobPassiveStepCost
		if self.SkillBooks < cost then return end
		self.SkillBooks = self.SkillBooks - cost
		self.JobPassiveLv[job] = lv + 1
		self.SkillResult = "JobPassive:" .. job
		self.SkillMsg = "passive"
		self.SkillSeq = self.SkillSeq + 1
		self:SaveSkills()
		log("[VRF] job passive " .. job .. " lv=" .. tostring(lv + 1) .. " books=" .. tostring(self.SkillBooks))
	end

	@ExecSpace("Server")
	method void RequestSetFormation(string mainJob, string compJob)
		-- 편성 저장: 메인·동료 직업 (같은 직업 2명은 안 된다).
		if not self:CanEditSkill(senderUserId) then return end
		if self._T.jobGradeSkills[mainJob] == nil or self._T.jobGradeSkills[compJob] == nil or mainJob == compJob then return end
		self.MainJob = mainJob
		self.CompJob = compJob
		self.SkillMsg = "formation"
		self.SkillSeq = self.SkillSeq + 1
		self:SaveSkills()
		log("[VRF] formation main=" .. mainJob .. " comp=" .. compJob)
	end

	@ExecSpace("Server")
	method void RequestSkillSynth(string id)
		-- 합성: 같은 스킬 재료 3개로 등급표 확률에 따라 한 등급 위 스킬, 실패하면 같은 등급 스킬 하나.
		if not self:CanEditSkill(senderUserId) then return end
		local sk = self._T.skillById[id]
		local need = self._T.skillCfg.SkillSynthCount
		if sk == nil or (self.SkillCnt[id] or 0) < need then return end
		local info = self._T.grades[sk.grade]
		local jg = self._T.jobGradeSkills[sk.job] or {}
		if info == nil or info.synth <= 0 or #(jg[sk.grade + 1] or {}) == 0 then return end
		self.SkillCnt[id] = self.SkillCnt[id] - need
		local ok = _UtilLogic:RandomDouble() * 100 < info.synth
		local grade = sk.grade
		if ok then grade = grade + 1 end
		local pool = jg[grade] or {}
		local got = id
		if #pool > 0 then got = pool[_UtilLogic:RandomIntegerRange(1, #pool)] end
		local flag = "0"
		if self:GainSkill(got) then flag = "1" end
		self.SkillResult = got .. ":" .. flag
		self.SkillMsg = "synth_fail"
		if ok then self.SkillMsg = "synth_ok" end
		self.SkillSeq = self.SkillSeq + 1
		self:SaveSkills()
		log("[VRF] skill synth " .. id .. " ok=" .. tostring(ok) .. " got=" .. got)
	end

	@ExecSpace("Server")
	method void RequestSkillEquip(integer slot, string id)
		-- 장착 칸 교체 (해제는 없다). 다른 칸에 있던 같은 스킬은 자리를 바꾼다.
		if not self:CanEditSkill(senderUserId) then return end
		if slot < 1 or slot > self.SkillEquipSlots then return end
		local sk = self._T.skillById[id]
		if sk == nil or (self.SkillOwnLv[id] or 0) <= 0 then return end
		local key = self:EquipKey(sk.job, slot)
		local prev = self.SkillEquip[key] or ""
		for i = 1, self.SkillEquipSlots do
			local k = self:EquipKey(sk.job, i)
			if k ~= key and self.SkillEquip[k] == id then self.SkillEquip[k] = prev end
		end
		self.SkillEquip[key] = id
		self.SkillMsg = "equip"
		self.SkillSeq = self.SkillSeq + 1
		self:SaveSkills()
		log("[VRF] skill equip slot=" .. key .. " id=" .. id)
	end

	@ExecSpace("ServerOnly")
	method table SkillRunData()
		-- 히어로 판 시작 데이터 (예전 호출 호환).
		return self:SkillRunDataFor("Hero")
	end

	@ExecSpace("ServerOnly")
	method table SkillRunDataFor(string job)
		-- 판 시작 시 쓸 그 직업의 장착 스킬과 레벨 { equip = {Id...}, lv = {Id: 레벨}, comboLv, holyLv }.
		local data = { equip = {}, lv = {}, comboLv = 0, holyLv = 1, passiveLv = 0, loaded = false }
		if not self.SkillLoaded then return data end
		data.loaded = true
		data.comboLv = self.ComboAttackLv
		data.holyLv = self.HolyWaterLv
		data.passiveLv = self.JobPassiveLv[job] or 0
		for i = 1, self.SkillEquipSlots do
			local id = self.SkillEquip[self:EquipKey(job, i)] or ""
			if id ~= "" then
				table.insert(data.equip, id)
				data.lv[id] = self.SkillOwnLv[id] or 1
			end
		end
		return data
	end

	@ExecSpace("ServerOnly")
	method void SetMsg(string msg)
		-- 각인 창 안내 문구.
		self.Msg = msg
		self.MsgSeq = self.MsgSeq + 1
	end

	@ExecSpace("ServerOnly")
	method boolean CanEdit(string fromUserId)
		-- 본인 요청 + 불러오기 완료 + 로비에 있을 때만 각인을 바꿀 수 있다.
		if fromUserId ~= self.Entity.PlayerComponent.UserId or not self.Loaded then return false end
		local map = self.Entity.CurrentMap
		return isvalid(map) and map.Name == self.LobbyMapName
	end

	@ExecSpace("Server")
	method void RequestInvest(string nodeId)
		-- 노드에 포인트 1 투자.
		if not self:CanEdit(senderUserId) then return end
		local n = self._T.nodeById[nodeId]
		if n == nil then return end
		local lv = self.Lv[nodeId] or 0
		if lv >= n.max then return end
		if not self:IsNodeOpen(nodeId) then
			self:SetMsg("바로 위 각인을 " .. tostring(n.max) .. "레벨까지 찍어야 합니다")
			return
		end
		if self.ClearedFloor - self.Spent <= 0 then
			self:SetMsg("남은 포인트가 없습니다")
			return
		end
		self.Lv[nodeId] = lv + 1
		self.Spent = self.Spent + 1
		self:MarkDirty()
		log("[VRF] engrave invest " .. nodeId .. " lv=" .. tostring(lv + 1) .. " spent=" .. tostring(self.Spent) .. "/" .. tostring(self.ClearedFloor))
	end

	@ExecSpace("Server")
	method void RequestReset()
		-- 포인트 리셋 (무료): 모든 노드 0레벨, 포인트 전부 돌려받음.
		if not self:CanEdit(senderUserId) then return end
		if self.Spent <= 0 then return end
		for _, n in ipairs(self._T.nodes) do self.Lv[n.id] = 0 end
		self.Spent = 0
		self:MarkDirty()
		self:SetMsg("포인트를 모두 돌려받았습니다")
		log("[VRF] engrave reset")
	end

	@ExecSpace("Server")
	method void RequestSave()
		-- 각인 창을 닫을 때 바뀐 내용을 저장한다.
		if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
		self:Flush()
	end


	@ExecSpace("ServerOnly")
	method void LoadStars()
		-- 별·구간 수령 기록을 불러온다. 저장 형식 {"s":{"층":비트},"c":{"구간":비트}}.
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		local errorCode, raw = ds:GetAndWait(self.StarKey)
		self._T.stars = {}
		self._T.claims = {}
		if errorCode == 0 and raw ~= nil and raw ~= "" then
			local t = _HttpService:JSONDecode(raw)
			if t ~= nil then
				for k, v in pairs(t["s"] or {}) do self._T.stars[math.floor(tonumber(k) or 0)] = math.floor(v) end
				for k, v in pairs(t["c"] or {}) do self._T.claims[math.floor(tonumber(k) or 0)] = math.floor(v) end
			end
		elseif errorCode ~= 0 and errorCode ~= 1000002 then
			log_warning("[VRF] star load failed code=" .. tostring(errorCode))
			self.StarRetryTimer = self.LoadRetryDelay
			return
		end
		-- 별 기능 이전에 깬 층은 '클리어' 별 1개를 채워 준다 (한 번만, 저장)
		local migrated = 0
		for f = 1, self.ClearedFloor do
			if (self._T.stars[f] or 0) & 1 == 0 then
				self._T.stars[f] = (self._T.stars[f] or 0) | 1
				migrated = migrated + 1
			end
		end
		self.StarLoaded = true
		self:SyncStars()
		if migrated > 0 then
			self:SaveStars()
			log("[VRF] stars migrated cleared floors=" .. tostring(migrated))
		end
		log("[VRF] stars loaded floors=" .. tostring(self:CountKeys(self._T.stars)) .. " claims=" .. tostring(self:CountKeys(self._T.claims)))
	end

	@ExecSpace("ServerOnly")
	method integer CountKeys(table t)
		-- 표의 항목 수.
		local n = 0
		for _ in pairs(t or {}) do n = n + 1 end
		return n
	end

	@ExecSpace("ServerOnly")
	method string EncodeStars()
		-- 별·수령 기록 저장 문자열 (빈 표는 JSONEncode가 못 다뤄 0 항목으로 채운다).
		local s = {}
		local c = {}
		for k, v in pairs(self._T.stars or {}) do if v > 0 then s[tostring(k)] = v end end
		for k, v in pairs(self._T.claims or {}) do if v > 0 then c[tostring(k)] = v end end
		if self:CountKeys(s) == 0 then s["0"] = 0 end
		if self:CountKeys(c) == 0 then c["0"] = 0 end
		return _HttpService:JSONEncode({ s = s, c = c })
	end

	@ExecSpace("ServerOnly")
	method void SyncStars()
		-- 클라이언트 표시용 문자열 갱신.
		local a = {}
		for k, v in pairs(self._T.stars or {}) do if k > 0 and v > 0 then table.insert(a, tostring(k) .. ":" .. tostring(v)) end end
		local b = {}
		for k, v in pairs(self._T.claims or {}) do if k > 0 and v > 0 then table.insert(b, tostring(k) .. ":" .. tostring(v)) end end
		self.StarData = table.concat(a, ",")
		self.SectionData = table.concat(b, ",")
		self.StarSeq = self.StarSeq + 1
	end

	@ExecSpace("ServerOnly")
	method void SaveStars()
		-- 별·수령 기록 저장 (비동기). 실패하면 Dirty를 남겨 나갈 때 다시 저장.
		if not self.StarLoaded then return end
		self.StarDirty = true
		local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
		ds:SetAsync(self.StarKey, self:EncodeStars(), function(errorCode, key)
			if errorCode == 0 then
				self.StarDirty = false
			else
				log_warning("[VRF] star save failed code=" .. tostring(errorCode))
			end
		end)
	end

	@ExecSpace("ServerOnly")
	method integer GetStars(integer floor)
		-- 층의 별 비트 (1·2·4).
		return (self._T.stars or {})[floor] or 0
	end

	@ExecSpace("ServerOnly")
	method integer RecordStars(integer floor, integer bits)
		-- 이번 판에서 달성한 별을 누적하고 새로 얻은 비트를 돌려준다 (기존 별은 사라지지 않음).
		if not self.StarLoaded or floor <= 0 then return 0 end
		local prev = self:GetStars(floor)
		local now = prev | bits
		local gained = now & (~prev)
		if gained ~= 0 then
			self._T.stars[floor] = now
			self:SyncStars()
			self:SaveStars()
		end
		log("[VRF] stars floor=" .. tostring(floor) .. " prev=" .. tostring(prev) .. " now=" .. tostring(now) .. " gained=" .. tostring(gained))
		return gained
	end

	@ExecSpace("ServerOnly")
	method integer SectionStars(integer section)
		-- 구간(SectionSize층 묶음)의 별 합계.
		local total = 0
		local first = (section - 1) * self.SectionSize + 1
		for f = first, first + self.SectionSize - 1 do
			local b = self:GetStars(f)
			if b & 1 ~= 0 then total = total + 1 end
			if b & 2 ~= 0 then total = total + 1 end
			if b & 4 ~= 0 then total = total + 1 end
		end
		return total
	end

	@ExecSpace("ServerOnly")
	method integer ListValue(string list, integer idx)
		-- "10|20|30" 형식에서 idx번째 정수.
		local i = 0
		for v in string.gmatch(list, "[^|]+") do
			i = i + 1
			if i == idx then return math.floor(tonumber(v) or 0) end
		end
		return 0
	end

	@ExecSpace("Server")
	method void RequestClaimSection(integer section, integer tier)
		-- 구간 상자 수령: 본인·로드 완료·별 기준 달성·미수령일 때만 지급하고 바로 저장한다 (중복 수령 차단).
		if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
		local function reply(msg)
			self.ClaimMsg = msg
			self.ClaimSeq = self.ClaimSeq + 1
			log("[VRF] section claim " .. tostring(section) .. "-" .. tostring(tier) .. ": " .. msg)
		end
		if not self.StarLoaded or not self.SkillLoaded or not self.GraceLoaded then reply("보상 정보를 불러오는 중입니다") return end
		if section < 1 or tier < 1 or tier > 3 then reply("잘못된 요청입니다") return end
		local need = self:ListValue(self.SectionThresholds, tier)
		if self:SectionStars(section) < need then reply("별이 부족합니다") return end
		local bit = 1 << (tier - 1)
		local claimed = (self._T.claims or {})[section] or 0
		if claimed & bit ~= 0 then reply("이미 받은 보상입니다") return end
		self._T.claims[section] = claimed | bit
		local books = self:ListValue(self.SectionBooks, tier)
		local feathers = self:ListValue(self.SectionFeathers, tier)
		if books > 0 then self:AddSkillBooks(books) end
		if feathers > 0 then self:AddFeathers(feathers) end
		self:SyncStars()
		self:SaveStars()
		self:FlushSkills()
		self:FlushGrace()
		reply("보상 획득! 스킬북 +" .. tostring(books) .. " · 여신의 깃털 +" .. tostring(feathers))
	end


    @ExecSpace("ServerOnly")
    method void LoadAccount()
        -- 로드 실패는 Lv1 신규 계정으로 덮어쓰지 않는다.
        if self._T.accountBusy then return end
        self.AccountRetryTimer = 10
        self._T.accountBusy = true
        local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
        local code, raw = ds:GetAndWait(self.AccountKey)
        self._T.accountBusy = false
        if code ~= 0 and code ~= 1000002 then log_warning("[VRF] account load failed=" .. tostring(code)) return end
        local data = { version=1, total=0, profile="hero", frame="gold", title="none", last="" }
        if code == 0 and raw ~= nil and raw ~= "" then
            local ok, decoded = pcall(function() return _HttpService:JSONDecode(raw) end)
            if not ok or type(decoded) ~= "table" or type(decoded.total) ~= "number" then log_warning("[VRF] account invalid save") return end
            data.total = math.max(0, math.min(_AccountRules.TotalRequired, math.floor(decoded.total)))
            data.profile = decoded.profile or "hero"
            data.frame = decoded.frame or "gold"
            data.title = decoded.title or "none"
            data.last = decoded.last or ""
        end
        local progress = _AccountRules:Progress(data.total)
        for _, kind in ipairs({"profile", "frame", "title"}) do
            local item = _AccountRules:Cosmetic(kind, data[kind])
            if item == nil or item.level > progress.level then
                if kind == "profile" then data[kind] = "hero" elseif kind == "frame" then data[kind] = "gold" else data[kind] = "none" end
            end
        end
        self._T.accountDoc = data
        self.AccountLoaded = true
        self:SyncAccount()
        log("[VRF] account loaded lv=" .. tostring(self.AccountLevel) .. " total=" .. tostring(self.AccountTotal))
    end

    @ExecSpace("ServerOnly")
    method void SyncAccount()
        -- 서버 문서를 동기화 필드에 투영한다.
        local d = self._T.accountDoc
        local p = _AccountRules:Progress(d.total)
        self.AccountTotal = d.total
        self.AccountLevel = p.level
        self.AccountExp = p.exp
        self.AccountNeed = p.need
        self.AccountProfile = d.profile
        self.AccountFrame = d.frame
        self.AccountTitle = d.title
        self.AccountSeq = self.AccountSeq + 1
    end

    @ExecSpace("ServerOnly")
    method boolean CommitAccount(table data)
        -- 이벤트 단위 저장 성공 뒤에만 메모리와 화면에 반영한다. 실패 시 기존 값을 유지한다.
        if not self.AccountLoaded or self._T.accountBusy then return false end
        self._T.accountBusy = true
        local ds = _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
        local code = ds:SetAndWait(self.AccountKey, _HttpService:JSONEncode(data))
        self._T.accountBusy = false
        if code ~= 0 then log_warning("[VRF] account save failed=" .. tostring(code)) return false end
        self._T.accountDoc = data
        self:SyncAccount()
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean AwardAccount(string runId, integer amount)
        -- 판 고유 ID로 반복 정산을 차단한다. 저장 실패는 호출자가 같은 판으로 재시도한다.
        if not self.AccountLoaded or runId == "" then return false end
        local d = self._T.accountDoc
        if d.last == runId then return true end
        local nextTotal = math.min(_AccountRules.TotalRequired, d.total + math.max(0, amount))
        local nextData = {version=1,total=nextTotal,profile=d.profile,frame=d.frame,title=d.title,last=runId}
        local ok = self:CommitAccount(nextData)
        if ok then self._T.accountPending = nil else self._T.accountPending = nextData end
        if ok then log("[VRF] account awarded run=" .. runId .. " exp=" .. tostring(amount) .. " lv=" .. tostring(self.AccountLevel)) end
        return ok
    end

    @ExecSpace("ServerOnly")
    method table AccountBonuses()
        -- 판 시작 시점의 보너스 스냅샷을 반환한다.
        if not self.AccountLoaded then return {} end
        return _AccountRules:Bonuses(self.AccountLevel)
    end

    @ExecSpace("Server")
    method void RequestAccountCosmetic(string kind, string id)
        -- 본인·로비·해금 레벨을 검증하고 선택한 항목만 변경한다.
        if senderUserId ~= self.Entity.PlayerComponent.UserId or not self.AccountLoaded then return end
        local map = self.Entity.CurrentMap
        if not isvalid(map) or map.Name ~= self.LobbyMapName then return end
        local item = _AccountRules:Cosmetic(kind, id)
        if item == nil or item.level > self.AccountLevel then return end
        if self._T.accountBusy then return end
        local d = self._T.accountDoc
        if d[kind] == id then self.AccountMsg = "이미 장착 중입니다" self.AccountSeq = self.AccountSeq + 1 return end
        local n = {version=1,total=d.total,profile=d.profile,frame=d.frame,title=d.title,last=d.last}
        n[kind] = id
        local ok = self:CommitAccount(n)
        self.AccountMsg = ok and "변경했습니다" or "저장하지 못했습니다. 다시 시도해 주세요"
        self.AccountSeq = self.AccountSeq + 1
        log("[VRF] account cosmetic " .. kind .. "=" .. id .. " saved=" .. tostring(ok))
    end

end
