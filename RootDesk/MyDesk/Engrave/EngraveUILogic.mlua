@Logic
script EngraveUILogic extends Logic

	-- 각인 화면 (EngraveUI.ui, 성장 2번 탭). 데이터는 로컬 플레이어의 PlayerEngrave(서버 동기화)에서 읽는다.
	property Entity dimEntity = "954a27e4-a328-4e13-95dd-aa5e0e9e3f10"
	property Entity panelEntity = "2e8961bf-f27f-49f7-81d5-c0aaf797a55c"
	property ButtonComponent btnClose = "0485624f-fd41-4988-8c75-d9011ee912fd"
	property string TableName = "EngraveTable"
	property string PanelPath = "/ui/EngraveUI/Panel/"
	property string TreePath = "/ui/EngraveUI/Panel/Tree/"
	property string LobbyMapName = "Lobby"
	property number MsgDuration = 2.0
	-- 단계별 게이지 이미지 (0 미투자, 1 빨강, 2 주황, 3 초록)
	property string Gauge0RUID = "c491e54a55b942a2bbb9db0fa50ae238"
	property string Gauge1RUID = "fd4a96d5299c4041a67162b6ad07e31b"
	property string Gauge2RUID = "2b4439074f7f4929bbeecd98d751005d"
	property string Gauge3RUID = "47e277f9813e4051a684f0c5223595ee"
	property string LinkLockedRUID = "ec3c953864424b5aa44f78395ec29786"
	property string LinkDoneRUID = "261d00bc4a0d4d11bb546c7e71d8d66a"
	property string StepOffRUID = "bea05f1ee4ea484eb10471a620c69046"
	property string StepOnRUID = "1e130afe90a842028aed70edadbfb9f1"
	property Color BranchAtkColor = Color(0.85, 0.54, 0.48, 1)
	property Color BranchDefColor = Color(0.5, 0.69, 0.86, 1)
	property Color BranchUtilColor = Color(0.79, 0.64, 0.42, 1)
	property Color StepOnColor = Color(0.12, 0.34, 0.52, 1)
	property Color StepOffColor = Color(0.36, 0.40, 0.46, 1)
	property Color LockedIconColor = Color(0.35, 0.35, 0.38, 1)

	@HideFromInspector
	property table clickHandlers = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 테이블을 읽고 노드·버튼을 연결한 뒤 닫힌 상태로 시작한다.
		self:LoadTable()
		self.clickHandlers = {}
		self:Bind(self:Get("BtnReset"), function() self:OnReset() end)
		self:Bind(self:Get("BtnUpgrade"), function() self:OnUpgrade() end)
		self:Bind(self.btnClose.Entity, function() self:Close() _GrowthUILogic:Close() end)
		_GrowthUILogic:StyleButton(self:Get("BtnReset"))
		_GrowthUILogic:StyleButton(self:Get("BtnUpgrade"))
		for _, n in ipairs(self._T.nodes) do
			local id = n.id
			n.btn = _EntityService:GetEntityByPath(self.TreePath .. id)
			n.icon = _EntityService:GetEntityByPath(self.TreePath .. id .. "/Icon")
			n.gauge = _EntityService:GetEntityByPath(self.TreePath .. id .. "/Gauge")
			n.link = _EntityService:GetEntityByPath(self.TreePath .. "Link_" .. id)
			if isvalid(n.btn) then self:Bind(n.btn, function() self:OnNodeClick(id) end) end
		end
		self._T.selected = ""
		self._T.msgSeq = -1
		self._T.msgTimer = 0
		self._T.open = true
		self:SetOpen(false)
		log("[VRF] EngraveUILogic begin nodes=" .. tostring(#self._T.nodes))
	end

	@ExecSpace("ClientOnly")
	method void Bind(Entity entity, any fn)
		-- 버튼 클릭 연결 + 해제 기록.
		if not isvalid(entity) then return end
		local h = entity:ConnectEvent(ButtonClickEvent, function(e) if not entity.EnabledInHierarchy or not entity.ButtonComponent.Enable then return end _UISoundLogic:PlayClick() fn(e) end)
		table.insert(self.clickHandlers, { entity = entity, eventHandler = h })
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 버튼 이벤트 해제.
		for _, rec in ipairs(self.clickHandlers) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
		end
		self.clickHandlers = {}
	end

	@ExecSpace("ClientOnly")
	method void LoadTable()
		-- EngraveTable: 이름·설명({v} 자리에 수치)·레벨당 수치·최대 레벨·계열·단계.
		self._T.nodes = {}
		self._T.nodeById = {}
		local ds = _DataService:GetTable(self.TableName)
		if ds == nil then
			log_error("[VRF] EngraveTable not found (client)")
			return
		end
		for i = 1, ds:GetRowCount() do
			local n = {
				id = ds:GetCell(i, "Id"), branch = ds:GetCell(i, "Branch"), tier = tonumber(ds:GetCell(i, "Tier")) or 1, col = tonumber(ds:GetCell(i, "Col")) or 1,
				name = ds:GetCell(i, "Name"), desc = ds:GetCell(i, "Desc"), iconRuid = ds:GetCell(i, "IconRUID"),
				per = tonumber(ds:GetCell(i, "PerLv")) or 0, max = tonumber(ds:GetCell(i, "MaxLv")) or 3,
			}
			table.insert(self._T.nodes, n)
			self._T.nodeById[n.id] = n
		end
	end

	@ExecSpace("ClientOnly")
	method Entity Get(string name)
		-- 패널 안 엔티티.
		return _EntityService:GetEntityByPath(self.PanelPath .. name)
	end

	@ExecSpace("ClientOnly")
	method Component GetEngrave()
		-- 로컬 플레이어의 각인 컴포넌트.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return nil end
		return player:GetComponent("script.PlayerEngrave")
	end

	@ExecSpace("ClientOnly")
	method void Open()
		-- 성장 화면 각인 탭: 첫 각인을 고른 상태로 연다.
		local eng = self:GetEngrave()
		if eng == nil or not eng.Loaded then return end
		if self._T.selected == "" and #self._T.nodes > 0 then self._T.selected = self._T.nodes[1].id end
		self._T.msgSeq = eng.MsgSeq
		self:SetOpen(true)
		self:Refresh()
		log("[VRF] engrave open points=" .. tostring(eng.ClearedFloor - eng.Spent) .. "/" .. tostring(eng.ClearedFloor))
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 닫기: 화면을 숨기고 바뀐 각인을 저장 요청한다.
		if not self._T.open then return end
		self:SetOpen(false)
		local eng = self:GetEngrave()
		if eng ~= nil then eng:RequestSave() end
		log("[VRF] engrave close")
	end

	@ExecSpace("ClientOnly")
	method boolean IsOpen()
		-- 각인 화면이 열려 있는지.
		return self._T.open == true
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		-- 배경·패널 표시 전환.
		if self._T.open == open then return end
		self._T.open = open
		if isvalid(self.dimEntity) then self.dimEntity:SetEnable(open) end
		if isvalid(self.panelEntity) then self.panelEntity:SetEnable(open) end
	end

	@ExecSpace("ClientOnly")
	method boolean IsNodeOpen(Component eng, table n)
		-- 1단계는 항상 열림, 그 외에는 같은 계열·같은 줄의 바로 위 노드가 최대 레벨이어야 열림 (서버와 같은 규칙).
		if n.tier <= 1 then return true end
		for _, p in ipairs(self._T.nodes) do
			if p.branch == n.branch and p.col == n.col and p.tier == n.tier - 1 then return (eng.Lv[p.id] or 0) >= p.max end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method string EffectText(table n, integer lv)
		-- 효과 문구 (설명의 {v}를 레벨 × 레벨당 수치로 바꾼다).
		local v = n.per * lv
		local vs = tostring(math.floor(v))
		if math.abs(v - math.floor(v)) > 0.001 then vs = string.format("%.1f", v) end
		return (string.gsub(n.desc, "{v}", vs))
	end

	@ExecSpace("ClientOnly")
	method void OnNodeClick(string id)
		-- 아이콘을 누르면 상세 패널에 표시한다. 투자는 [각인 강화] 버튼으로.
		self._T.selected = id
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void OnUpgrade()
		-- 각인 강화: 선택한 각인에 포인트 1 투자.
		local eng = self:GetEngrave()
		local n = self._T.nodeById[self._T.selected or ""]
		if eng == nil or n == nil then return end
		if (eng.Lv[n.id] or 0) < n.max and self:IsNodeOpen(eng, n) and eng.ClearedFloor - eng.Spent > 0 then
			eng:RequestInvest(n.id)
			log("[VRF] engrave invest request " .. n.id)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnReset()
		-- 포인트 리셋 요청 (무료).
		local eng = self:GetEngrave()
		if eng ~= nil then eng:RequestReset() end
	end

	@ExecSpace("ClientOnly")
	method void SetText(string name, string s)
		-- 바뀐 경우에만 글자를 바꾼다.
		local e = self:Get(name)
		if not isvalid(e) then return end
		local t = e.TextGUIRendererComponent
		if t.Text ~= s then t.Text = s end
	end

	@ExecSpace("ClientOnly")
	method void SetImage(Entity e, string ruid, string key)
		-- 바뀐 경우에만 이미지를 바꾼다.
		if not isvalid(e) or self._T.shown[key] == ruid then return end
		self._T.shown[key] = ruid
		e.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		-- 포인트·게이지·연결선·선택 표시·상세 패널을 갱신한다.
		local eng = self:GetEngrave()
		if eng == nil then return end
		if self._T.shown == nil then self._T.shown = {} end
		local avail = eng.ClearedFloor - eng.Spent
		self:SetText("Points", tostring(avail))
		self:SetText("PointsTotal", "/ 총 포인트 " .. tostring(eng.ClearedFloor))
		_UIButtonLogic:SetDisabled(self:Get("BtnReset"), eng.Spent <= 0)
		local gauges = { self.Gauge1RUID, self.Gauge2RUID, self.Gauge3RUID }
		local spent = { Atk = 0, Def = 0, Util = 0 }
		local total = { Atk = 0, Def = 0, Util = 0 }
		for _, n in ipairs(self._T.nodes) do
			local lv = eng.Lv[n.id] or 0
			spent[n.branch] = (spent[n.branch] or 0) + lv
			total[n.branch] = (total[n.branch] or 0) + n.max
			local gauge = self.Gauge0RUID
			if lv > 0 then gauge = gauges[math.min(3, lv)] end
			self:SetImage(n.gauge, gauge, "g" .. n.id)
			local open = self:IsNodeOpen(eng, n)
			if isvalid(n.icon) then
				local c = self.LockedIconColor
				if open then c = Color(1, 1, 1, 1) end
				n.icon.SpriteGUIRendererComponent.Color = c
			end
			-- 위 노드를 끝까지 찍었으면 아래로 이어지는 연결선을 초록색으로
			local link = self.LinkLockedRUID
			if open then link = self.LinkDoneRUID end
			self:SetImage(n.link, link, "l" .. n.id)
		end
		for branch, v in pairs(spent) do self:SetText("Count_" .. branch, tostring(v) .. " / " .. tostring(total[branch])) end
		self:RefreshDetail(eng, avail)
	end

	@ExecSpace("ClientOnly")
	method void RefreshDetail(Component eng, integer avail)
		-- 선택 표시와 오른쪽 상세 패널.
		local n = self._T.nodeById[self._T.selected or ""]
		local sel = self:Get("Select")
		if n == nil then
			if isvalid(sel) then sel:SetEnable(false) end
			return
		end
		if isvalid(sel) and isvalid(n.btn) then
			sel.UITransformComponent.anchoredPosition = n.btn.UITransformComponent.anchoredPosition
			if not sel.Enable then sel:SetEnable(true) end
		end
		local lv = eng.Lv[n.id] or 0
		local open = self:IsNodeOpen(eng, n)
		self:SetImage(self:Get("IconFrame/Icon"), n.iconRuid, "detailIcon")
		local names = { Atk = "공격 계열", Def = "방어 계열", Util = "특수 계열" }
		local colors = { Atk = self.BranchAtkColor, Def = self.BranchDefColor, Util = self.BranchUtilColor }
		self:SetText("Branch", names[n.branch] or "")
		local branch = self:Get("Branch")
		if isvalid(branch) then branch.TextGUIRendererComponent.FontColor = colors[n.branch] end
		self:SetText("Name", n.name)
		self:SetText("Level", "현재 단계   " .. tostring(lv) .. " / " .. tostring(n.max))
		local effect = ""
		if lv >= n.max then
			effect = self:EffectText(n, lv)
		elseif lv > 0 then
			effect = self:EffectText(n, lv) .. "\n<color=#347F24>다음 단계: " .. self:EffectText(n, lv + 1) .. "</color>"
		else
			effect = "<color=#347F24>다음 단계: " .. self:EffectText(n, 1) .. "</color>"
		end
		self:SetText("Effect", effect)
		for i = 1, 3 do
			local step = self:Get("Step" .. tostring(i))
			local label = self:Get("Step" .. tostring(i) .. "/Label")
			local on = i <= lv
			local ruid = self.StepOffRUID
			local color = self.StepOffColor
			if on then
				ruid = self.StepOnRUID
				color = self.StepOnColor
			end
			self:SetImage(step, ruid, "s" .. tostring(i))
			if isvalid(label) then label.TextGUIRendererComponent.FontColor = color end
		end
		-- 서버 안내가 있으면 잠깐 보여 주고, 그 외에는 강화할 수 없는 이유를 표시
		local hint = ""
		if lv >= n.max then
			hint = "최대 단계입니다"
		elseif not open then
			hint = "바로 위 각인을 " .. tostring(n.max) .. "단계까지 올려야 합니다"
		elseif avail <= 0 then
			hint = "남은 포인트가 없습니다"
		end
		if self._T.msgTimer > 0 then hint = self._T.msgShown or "" end
		self:SetText("Msg", hint)
		if lv >= n.max then self:SetText("Cost", "-") else self:SetText("Cost", "1") end
		_UIButtonLogic:SetDisabled(self:Get("BtnUpgrade"), lv >= n.max or not open or avail <= 0)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 열려 있는 동안 동기화된 각인 상태를 반영하고, 서버 안내 문구를 잠깐 띄운다. 로비를 벗어나면 닫는다.
		if not self._T.open then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) or player.CurrentMap.Name ~= self.LobbyMapName then
			self:Close()
			return
		end
		local eng = self:GetEngrave()
		if eng == nil then return end
		if eng.MsgSeq ~= self._T.msgSeq then
			self._T.msgSeq = eng.MsgSeq
			self._T.msgTimer = self.MsgDuration
			self._T.msgShown = eng.Msg
		end
		if self._T.msgTimer > 0 then self._T.msgTimer = self._T.msgTimer - delta end
		self:Refresh()
	end

end
