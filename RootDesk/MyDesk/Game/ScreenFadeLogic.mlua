@Logic
script ScreenFadeLogic extends Logic

	-- ScreenFade.ui 바인딩 (UIBuilder injectBindings로 주입)
	property SpriteGUIRendererComponent overlay = "06675e84-0aa0-41fd-b687-e325216ae421"

	property number FadeOutTime = 1.0
	property number FadeInTime = 1.0
	-- 검은 화면 대기 최대 시간 (준비가 늦어도 이 시간이 지나면 밝힌다)
	property number MaxHoldTime = 4.0
	-- 탑: 구성원 1이 발판에 선 채 이 시간 동안 움직이지 않아야 화면을 밝힌다
	property number GroundStableTime = 0.25

	-- IDLE / OUT(어두워지는 중) / HOLD(검은 화면 유지, 맵 로드 대기) / IN(밝아지는 중)
	@HideFromInspector
	property string Phase = "HOLD"
	@HideFromInspector
	property number Alpha = 1
	@HideFromInspector
	property number HoldTimer = 0
	@HideFromInspector
	property string LastMapName = ""

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 첫 입장은 검은 화면에서 시작해 맵이 준비되면 밝아진다.
		self._T.onFadedOut = nil
		self.Phase = "HOLD"
		self.Alpha = 1
		self.HoldTimer = 0
		self:ResetHold()
		self:ApplyAlpha()
		log("[VRF] ScreenFadeLogic begin")
	end

	@ExecSpace("ClientOnly")
	method void ApplyAlpha()
		-- 오버레이 투명도 반영. 완전히 투명하면 꺼서 클릭을 막지 않게 한다.
		if not isvalid(self.overlay) then return end
		self.overlay.Color = Color(0, 0, 0, self.Alpha)
		local visible = self.Alpha > 0.001
		if self.overlay.Entity.Enable ~= visible then self.overlay.Entity:SetEnable(visible) end
	end

	@ExecSpace("ClientOnly")
	method void FadeOut(any onFadedOut)
		-- 화면을 검게 덮은 뒤 콜백(맵 이동 요청 등)을 실행한다.
		if self.Phase == "OUT" or self.Phase == "HOLD" then return end
		self._T.onFadedOut = onFadedOut
		self.Phase = "OUT"
		log("[VRF] fade out start")
	end

	@ExecSpace("ClientOnly")
	method void ResetHold()
		-- 검은 화면 대기(HOLD) 판정값 초기화.
		self._T.startSent = false
		self._T.stable = 0
		self._T.lastY = nil
	end

	@ExecSpace("ClientOnly")
	method void HoldForScene()
		-- 탑 스테이지 이동: 검은 화면을 유지한 채 구성원이 발판에 선 것을 확인하고 밝힌다.
		self.Phase = "HOLD"
		self.Alpha = 1
		self.HoldTimer = 0
		self:ResetHold()
		self:ApplyAlpha()
	end

	@ExecSpace("ClientOnly")
	method boolean SceneReady(Component mgr, Entity player, number delta)
		-- 탑: 판이 시작되어(HUD 표시 상태) 구성원 1이 발판에 선 채 멈춰 있으면 준비 완료. 탑이 아니면 바로 준비 완료.
		if mgr == nil then return true end
		local st = mgr.RunState
		if st == "WAIT" or st == "READY" or st == "FADE" or not isvalid(player) then
			self._T.stable = 0
			return false
		end
		local wp = player.TransformComponent.WorldPosition
		-- 입장 출발점으로 옮겨지는 중이면(순간 이동이 아직 반영 전) 기다린다
		if mgr.EntryHold and math.abs(wp.x - mgr.EntryLeadStartX) > 0.15 then
			self._T.stable = 0
			return false
		end
		local body = player.RigidbodyComponent
		local grounded = not isvalid(body) or body:IsOnGround()
		local lastY = self._T.lastY
		self._T.lastY = wp.y
		if not grounded or lastY == nil or math.abs(wp.y - lastY) > 0.002 then
			self._T.stable = 0
			return false
		end
		self._T.stable = (self._T.stable or 0) + delta
		return self._T.stable >= self.GroundStableTime
	end

	@ExecSpace("ClientOnly")
	method void BeginFadeIn(Entity map)
		-- 검은 화면을 걷어내기 시작. 탑 맵이면 입장 출발점에서 기다리던 파티를 걷게 한다 (아직 판 시작 전이면 시작 요청).
		self.Phase = "IN"
		local mgr = map:GetComponent("script.TowerRunManager")
		if mgr ~= nil then
			if mgr.RunState == "READY" and not self._T.startSent then
				self._T.startSent = true
				mgr:RequestStart()
			end
			if mgr.EntryHold then mgr:RequestEntryGo() end
		end
		local st = mgr ~= nil and mgr.RunState or "-"
		log("[VRF] fade in start map=" .. map.Name .. " state=" .. st .. " hold=" .. tostring(self.HoldTimer))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 페이드 단계 진행 + 맵 변경 감지.
		local player = _UserService.LocalPlayer
		local map = nil
		if isvalid(player) then map = player.CurrentMap end
		local mapName = ""
		if isvalid(map) then mapName = map.Name end

		if mapName ~= "" and mapName ~= self.LastMapName then
			-- 새 맵에 도착: 검은 화면으로 고정하고 준비를 기다린다.
			self.LastMapName = mapName
			self.Phase = "HOLD"
			self.Alpha = 1
			self.HoldTimer = 0
			self:ResetHold()
		end

		if self.Phase == "OUT" then
			self.Alpha = math.min(1, self.Alpha + delta / self.FadeOutTime)
			if self.Alpha >= 1 then
				self.Phase = "WAIT_MAP"
				self.HoldTimer = 0
				local cb = self._T.onFadedOut
				self._T.onFadedOut = nil
				if cb ~= nil then cb() end
			end
		elseif self.Phase == "HOLD" then
			self.Alpha = 1
			self.HoldTimer = self.HoldTimer + delta
			if isvalid(map) then
				local mgr = map:GetComponent("script.TowerRunManager")
				-- 탑: 검은 화면인 동안 판 시작을 요청해 HUD·구성원 배치를 먼저 끝낸다
				if mgr ~= nil and mgr.RunState == "READY" and self.HoldTimer >= 0.15 and not self._T.startSent then
					self._T.startSent = true
					mgr:RequestStart()
				end
				local ready = self:SceneReady(mgr, player, delta)
				if (ready and self.HoldTimer >= 0.15) or self.HoldTimer >= self.MaxHoldTime then
					if not ready then log_warning("[VRF] fade hold timeout") end
					self:BeginFadeIn(map)
				end
			end
		elseif self.Phase == "WAIT_MAP" then
			-- 맵 이동이 일어나지 않으면(실패 등) 일정 시간 뒤 화면을 되살린다.
			self.HoldTimer = self.HoldTimer + delta
			if self.HoldTimer >= 5 and isvalid(map) then self:BeginFadeIn(map) end
		elseif self.Phase == "IN" then
			self.Alpha = math.max(0, self.Alpha - delta / self.FadeInTime)
			if self.Alpha <= 0 then self.Phase = "IDLE" end
		end
		self:ApplyAlpha()
	end

end
