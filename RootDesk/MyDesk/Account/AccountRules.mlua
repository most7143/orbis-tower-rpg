    method string RewardText(integer level)
        -- 해당 레벨에서 추가되는 효과만 표시한다.
        local labels = {}
        for _, r in ipairs(self:Rewards(level)) do table.insert(labels, r.label) end
        return table.concat(labels, " / ")
    end

    method integer Need(integer level)
        -- 105층 성장 경로·하루20판·성공80% 기준 총량. 99단계에서 반올림 오차 보정.
        if level >= 100 then return 0 end
        if self._T.needs == nil then
            self._T.needs = {}
            local sum = 0
            for i = 1, 99 do
                local v = math.floor(self.TotalRequired / 328350 * i * i + 0.5)
                self._T.needs[i] = v
                sum = sum + v
            end
            self._T.needs[99] = self._T.needs[99] + self.TotalRequired - sum
        end
        return self._T.needs[math.max(1, level)]
    end

    method table Progress(integer total)
        -- 총 누적 경험치에서 계정 레벨과 레벨 내 경험치를 복원한다.
        local rest = math.max(0, math.min(self.TotalRequired, total))
        local lv = 1
        while lv < 100 and rest >= self:Need(lv) do rest = rest - self:Need(lv) lv = lv + 1 end
        if lv >= 100 then rest = 0 end
        return { level = lv, exp = rest, need = self:Need(lv) }
    end

    method table Bonuses(integer level)
        -- 현재 레벨까지 재산출해 로그인·판 시작마다 중복 적용되지 않게 한다.
        local result = {}
        for i = 1, math.max(1, math.min(100, level)) do
            for _, r in ipairs(self:Rewards(i)) do result[r.key] = (result[r.key] or 0) + r.value end
        end
        return result
    end

    method integer ClearExp(integer floor)
        -- 실제 마지막105층에서 1층의20배. 테이블 확장 시에도 현재 상한을 유지한다.
        local f = math.max(1, math.min(self.ExpFloorCap, floor))
        return math.floor(100 * 20 ^ ((f - 1) / (self.ExpFloorCap - 1)) + 0.5)
    end

    method integer RunExp(integer floor, boolean clear, integer completed, integer total)
        -- 실패·포기는 완료 스테이지 비례, 클리어는 확정 전량.
        local base = self:ClearExp(floor)
        if clear then return base end
        return math.floor(base * 0.5 * math.max(0, math.min(total, completed)) / math.max(1, total))
    end

    method table Cosmetics(string kind)
        -- 기본 초상3종은 무료 제공. 프레임·칭호는 계정 레벨로 해금하는 초기 카탈로그.
        if kind == "profile" then return { {id="hero",name="히어로",level=1}, {id="paladin",name="팔라딘",level=1}, {id="darkknight",name="다크나이트",level=1} } end
        if kind == "frame" then return {
            {id="gold",name="따뜻한 금빛",level=1}, {id="silver",name="은빛 프레임",level=10}, {id="green",name="숲빛 프레임",level=20},
            {id="blue",name="하늘빛 프레임",level=25}, {id="rose",name="장밋빛 프레임",level=35}, {id="purple",name="신비한 프레임",level=50},
            {id="orange",name="노을빛 프레임",level=65}, {id="red",name="붉은 별 프레임",level=80}, {id="prism",name="무지개 프레임",level=100}
        } end
        if kind == "title" then return {
            {id="none",name="칭호 해제",level=1,ruid=""},
            {id="beginner",name="첫걸음",level=5,ruid="9bf18287398c44699c20fc5123d1a1ae"},
            {id="challenger",name="탑의 도전자",level=10,ruid="ac88638649c3479bbb754e4b34bb3eac"},
            {id="brave",name="굳건한 도전자",level=20,ruid="9bf18287398c44699c20fc5123d1a1ae"},
            {id="explorer",name="탑의 탐험가",level=30,ruid="ac88638649c3479bbb754e4b34bb3eac"},
            {id="guardian",name="탑의 수호자",level=40,ruid="9bf18287398c44699c20fc5123d1a1ae"},
            {id="cloud",name="구름 위의 모험가",level=60,ruid="ac88638649c3479bbb754e4b34bb3eac"},
            {id="hero",name="오르비스의 영웅",level=70,ruid="9bf18287398c44699c20fc5123d1a1ae"},
            {id="master",name="탑의 지배자",level=80,ruid="ac88638649c3479bbb754e4b34bb3eac"},
            {id="star",name="별의 계승자",level=90,ruid="9bf18287398c44699c20fc5123d1a1ae"},
            {id="legend",name="탑의 전설",level=100,ruid="ac88638649c3479bbb754e4b34bb3eac"}
        } end
        return {}
    end

    method table Cosmetic(string kind, string id)
        -- 유효 ID와 해금 조건을 공통 조회한다.
        for _, item in ipairs(self:Cosmetics(kind)) do if item.id == id then return item end end
        return nil
    end
end
