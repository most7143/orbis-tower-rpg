@Logic
script SkillTestUILogic extends Logic

	-- SkillTestUI.ui 바인딩 (UIBuilder bind로 주입)
	property Entity rootEntity = "9d42e8fb-998b-49eb-bc90-a35733fdc9bc"
	property Entity listEntity = "d517b102-05c6-4d3a-9685-60a2b0b39eb7"
	property TextGUIRendererComponent infoTitle = "ed41a176-b6f0-472b-b296-1e896a973053"
	property TextGUIRendererComponent infoDesc = "ad43412b-6517-4828-bde9-f7f62aa865a5"
	property TextGUIRendererComponent monsterText = "e2c2b083-28d5-4133-9a88-9f7e81eac446"
	property ButtonComponent btnReplay = "c824316f-dc7c-41f0-b603-c2b3fc64eb32"
	property ButtonComponent btnMonster = "fd6f1e7a-0ce1-4bd5-9e27-50e4978207ee"
	property ButtonComponent btnLobby = "9803e95c-b985-4dcd-a55e-679f64a91a9c"

	property string TestMapName = "SkillTest"
	property string TraitTableName = "TraitTable"
	property Color NoFxColor = Color(0.2, 0.2, 0.22, 1)
	property Color SelectedColor = Color(1, 0.85, 0.3, 1)

	@HideFromInspector
	property table clickHandlers = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 특성 21줄에 직업 이름을 채우고 버튼을 연결한다. 이펙트 스킬이 없는 직업 버튼은 어둡게.
		self.clickHandlers = {}
		self._T.rows = {}
		self._T.selected = nil
		self._T.last = nil
		local fx = {}
		local js = _DataService:GetTable("JobSkillTable")
		if js ~= nil then
			for i = 1, js:GetRowCount() do
				if (js:GetCell(i, "EffectRUID") or "") ~= "" and (js:GetCell(i, "ProcType") or "") ~= "" then
					fx[js:GetCell(i, "TraitId") .. "_" .. js:GetCell(i, "Tier")] = (fx[js:GetCell(i, "TraitId") .. "_" .. js:GetCell(i, "Tier")] or 0) + 1
				end
			end
		end
		local ds = _DataService:GetTable(self.TraitTableName)
		local count = 0
		if ds ~= nil and isvalid(self.listEntity) then
			for i = 1, ds:GetRowCount() do
				local row = self.listEntity:GetChildByName("Row_" .. tostring(i))
				if isvalid(row) then
					count = count + 1
					local id = ds:GetCell(i, "Id")
					local name = row:GetChildByName("Name")
					if isvalid(name) then
						name.TextGUIRendererComponent.Text = ds:GetCell(i, "Trait")
						name.TextGUIRendererComponent.FontColor = Color.FromHexCode(ds:GetCell(i, "FamilyColor"))
					end
					for tier = 1, 3 do
						local btn = row:GetChildByName("Btn" .. tostring(tier))
						if isvalid(btn) then
							local job = ds:GetCell(i, "Job" .. tostring(tier)) or ""
							local n = fx[id .. "_" .. tostring(tier)] or 0
							local label = job
							if n > 1 then label = job .. " (" .. tostring(n) .. ")" end
							btn.TextGUIRendererComponent.Text = label
							local base = Color(0.18, 0.34, 0.5, 1)
							if n == 0 then
								base = self.NoFxColor
								btn.TextGUIRendererComponent.FontColor = Color(0.55, 0.55, 0.55, 1)
							end
							btn.SpriteGUIRendererComponent.Color = base
							local rec = { id = id, tier = tier, job = job, btn = btn, base = base }
							table.insert(self._T.rows, rec)
							self:Bind(btn.ButtonComponent, function() self:OnJob(rec) end)
						end
					end
				end
			end
		end
		self:Bind(self.btnReplay, function() if self._T.last ~= nil then self:OnJob(self._T.last) end end)
		self:Bind(self.btnMonster, function()
			local mgr = self:GetManager()
			if mgr ~= nil then mgr:RequestNextMonster() end
		end)
		self:Bind(self.btnLobby, function()
			local mgr = self:GetManager()
			if mgr ~= nil then _ScreenFadeLogic:FadeOut(function() mgr:RequestLobby() end) end
		end)
		log("[VRF] SkillTestUILogic begin rows=" .. tostring(count) .. " jobs=" .. tostring(#self._T.rows))
	end

	@ExecSpace("ClientOnly")
	method void Bind(ButtonComponent button, any fn)
		-- 버튼 클릭 이벤트 연결 + 해제용 기록.
		if not isvalid(button) then return end
		local h = button.Entity:ConnectEvent(ButtonClickEvent, fn)
		table.insert(self.clickHandlers, { entity = button.Entity, eventHandler = h })
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 버튼 이벤트 해제.
		for _, rec in ipairs(self.clickHandlers) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
		end
		self.clickHandlers = {}
	end

	@ExecSpace("ClientOnly")
	method Component GetManager()
		-- 테스트 맵 서버 매니저 (다른 맵이면 nil).
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) then return nil end
		return player.CurrentMap:GetComponent("script.SkillTestManager")
	end

	@ExecSpace("ClientOnly")
	method void OnJob(table rec)
		-- 직업 버튼: 선택 표시 후 서버에 재생 요청.
		local mgr = self:GetManager()
		if mgr == nil then return end
		local prev = self._T.selected
		if prev ~= nil and isvalid(prev.btn) then prev.btn.SpriteGUIRendererComponent.Color = prev.base end
		self._T.selected = rec
		self._T.last = rec
		rec.btn.SpriteGUIRendererComponent.Color = self.SelectedColor
		mgr:RequestPlayJob(rec.id, rec.tier, rec.job)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 테스트 맵에서만 보이고, 서버가 보내는 재생 정보를 표시한다.
		local mgr = self:GetManager()
		local show = mgr ~= nil
		if isvalid(self.rootEntity) and self.rootEntity.Enable ~= show then self.rootEntity:SetEnable(show) end
		if not show then return end
		if isvalid(self.infoTitle) and self.infoTitle.Text ~= mgr.InfoTitle then self.infoTitle.Text = mgr.InfoTitle end
		if isvalid(self.infoDesc) and self.infoDesc.Text ~= mgr.InfoDesc then self.infoDesc.Text = mgr.InfoDesc end
		local m = "몬스터: " .. mgr.MonsterLabel
		if isvalid(self.monsterText) and self.monsterText.Text ~= m then self.monsterText.Text = m end
	end

end
