@Component
script SkillTestManager extends Component

	-- 스킬 이펙트 테스트 맵: 탑과 같은 자리에 캐릭터·몬스터를 세워 두고,
	-- 클라이언트가 고른 직업의 발동 스킬 이펙트를 실제 게임과 같은 방식(위치·크기·연타 간격)으로 재생한다.
	property string MonsterModelId = "towerstarpixie"
	property Vector3 PlayerPos = Vector3(-1.0, 0.2, 0)
	property Vector3 MonsterPos = Vector3(1.0, -0.04, 0)
	property string LobbyMapName = "Lobby"
	property Vector3 LobbyPos = Vector3(0, 0.2, 0)
	property string JobSkillTableName = "JobSkillTable"
	property string MonsterTableName = "MonsterTable"
	property string FloorTableName = "FloorTable"
	-- 스킬 하나 재생 후 다음 스킬까지 간격(초), 연타 간격(TowerRunManager.ProcHitInterval과 같게)
	property number SkillGap = 1.6
	property number ProcHitInterval = 0.12
	-- 공격 동작 시작 후 이펙트가 나올 때까지 (TowerPlayer.HitSyncDelay와 같게)
	property number HitDelay = 0.3
	-- 히어로 스킬을 볼 때 드는 양손검 (장비 표 히어로 무기 1단계)
	property string HeroWeaponRUID = "43ad7bfeb9184252b24e6d60f76c17e5"

	-- 화면 표시용 (클라이언트 SkillTestUILogic이 읽음)
	@Sync
	property string InfoTitle = ""
	@Sync
	property string InfoDesc = ""
	@Sync
	property string MonsterLabel = ""
	@Sync
	property integer PlaySeq = 0

	-- 히어로 스킬은 실제 전투 로직(_HeroCombatLogic)으로 실행한다. 이 컴포넌트가 TowerRunManager 대신 전투 정보를 넘겨준다.
	-- 허수아비 몬스터 체력 (0이 되면 다시 가득), 피해 기준 공격력 100 → 피해 숫자 = 스킬 계수%
	property string RunState = "FIGHT"
	property number MonsterMaxHp = 3000
	property number MonsterHp = 3000
	property number PlayerAtk = 100
	property number CritRate = 0
	property number CritDmg = 150
	property number PlayerAttackTimer = 0
	-- 회복·보호막 확인용 플레이어 체력 (히어로 스킬 시전마다 60%로 맞춘다)
	property number PlayerMaxHp = 1000
	property number PlayerHp = 600
	@HideFromInspector
	property table SkillLv = {}

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 직업 스킬(이펙트 있는 발동 스킬)과 층 몬스터 목록을 읽는다.
		self._T.player = nil
		self._T.monster = nil
		self._T.timers = {}
		self._T.monsterIndex = 1
		self:LoadTables()
		log("[VRF] SkillTestManager begin fxSkills=" .. tostring(self._T.fxCount) .. " monsters=" .. tostring(#self._T.floorMonsters))
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 재생 중인 타이머와 몬스터 정리.
		self:ClearTimers()
		self:DestroyMonster()
	end

	@ExecSpace("ServerOnly")
	method void LoadTables()
		-- skills[직업 Id] = { {name, desc, type, pct, hits, fx, fxScale, actionFrames, ...}, ... } (연출이 있는 액티브만, 기본 수치)
		self._T.skills = {}
		self._T.fxCount = 0
		local actions = {}
		local at = _DataService:GetTable("SkillActionTable")
		if at ~= nil then
			for i = 1, at:GetRowCount() do
				actions[at:GetCell(i, "SkillId")] = { name = at:GetCell(i, "Action") or "", frames = at:GetCell(i, "ActionFrames") or "", time = tonumber(at:GetCell(i, "ActionTime")) or 0.8, caster = at:GetCell(i, "CasterFx") or "", hit = at:GetCell(i, "HitFx") or "", scale = tonumber(at:GetCell(i, "FxScale")) or 1,
					mob = at:GetCell(i, "MobFx") or "", policy = at:GetCell(i, "HitPolicy") or "", useSound = at:GetCell(i, "UseSound") or "", hitSound = at:GetCell(i, "HitSound") or "",
					gap = tonumber(at:GetCell(i, "HitGap")) or 0, hitY = tonumber(at:GetCell(i, "HitY")) or 0.45 }
			end
		end
		-- 돌파 목록 (히어로 스킬 테스트에서 켠 돌파 이름 표시)
		self._T.breakRows = {}
		local bs = _DataService:GetTable("SkillBreakTable")
		if bs ~= nil then
			for i = 1, bs:GetRowCount() do
				table.insert(self._T.breakRows, { skill = bs:GetCell(i, "SkillId"), id = bs:GetCell(i, "OptionId"), name = bs:GetCell(i, "Name") })
			end
		end
		local js = _DataService:GetTable(self.JobSkillTableName)
		if js ~= nil then
			for i = 1, js:GetRowCount() do
				local a = actions[js:GetCell(i, "SkillId")]
				local pt = js:GetCell(i, "ProcType") or ""
				if a ~= nil and pt ~= "" then
					local id = js:GetCell(i, "JobId")
					local hits = tonumber(js:GetCell(i, "ProcHits")) or 0
					if hits <= 0 then
						hits = 1
						if pt == "Double" then hits = 2 end
					end
					local desc = js:GetCell(i, "Desc") or ""
					local keys = { v1 = "V1", v2 = "V2", c = "Chance", p = "Pct", h = "ProcHits", cd = "Cooldown", bt = "BuffTime", dp = "DotPct", dt = "DotTime" }
					for key, col in pairs(keys) do desc = (string.gsub(desc, "{" .. key .. "}", tostring(math.floor(tonumber(js:GetCell(i, col)) or 0)))) end
					if self._T.skills[id] == nil then self._T.skills[id] = {} end
					table.insert(self._T.skills[id], { id = js:GetCell(i, "SkillId"), name = js:GetCell(i, "Name"), desc = desc, type = pt,
						pct = tonumber(js:GetCell(i, "Pct")) or 0, hits = hits, fx = a.hit, fxScale = a.scale,
						actionName = a.name, actionFrames = a.frames, actionTime = a.time, casterFx = a.caster,
						mobFx = a.mob, policy = a.policy, useSound = a.useSound, hitSound = a.hitSound, gap = a.gap, hitY = a.hitY,
						kind = js:GetCell(i, "SkillType") or "" })
					self._T.fxCount = self._T.fxCount + 1
				end
			end
		end
		-- 층 순서대로 몬스터 외형 (몬스터 변경 버튼으로 돌려 본다)
		local looks = {}
		local ms = _DataService:GetTable(self.MonsterTableName)
		if ms ~= nil then
			for i = 1, ms:GetRowCount() do
				local stand = ms:GetCell(i, "StandRUID")
				if stand ~= nil and stand ~= "" then
					looks[ms:GetCell(i, "id")] = { name = ms:GetCell(i, "Name"), stand = stand, attack = ms:GetCell(i, "AttackRUID"), hit = ms:GetCell(i, "HitRUID"),
						die = ms:GetCell(i, "DieRUID"), hitSound = ms:GetCell(i, "HitSoundRUID"), dieSound = ms:GetCell(i, "DieSoundRUID") }
				end
			end
		end
		self._T.floorMonsters = {}
		local fs = _DataService:GetTable(self.FloorTableName)
		if fs ~= nil then
			for i = 1, fs:GetRowCount() do
				local look = looks[fs:GetCell(i, "MonsterId")]
				if look ~= nil then table.insert(self._T.floorMonsters, look) end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method Entity FindPlayer()
		-- 이 맵에 있는 첫 번째 플레이어 (솔로 테스트).
		local users = _UserService:GetUsersByMapComponent(self.Entity.MapComponent)
		if users == nil then return nil end
		for _, user in ipairs(users) do
			if isvalid(user) then return user end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method void SetupPlayer(Entity player)
		-- 탑과 같은 자리에 고정하고 이동·점프를 막는다.
		self._T.player = player
		if isvalid(player.MovementComponent) then
			player.MovementComponent.InputSpeed = 0
			player.MovementComponent.JumpForce = 0
		end
		if isvalid(player.PlayerControllerComponent) then player.PlayerControllerComponent.LookDirectionX = 1 end
		player.PlayerComponent:SetWorldPosition(self.PlayerPos)
		-- 원래 무기 기억 (히어로가 아닌 직업을 볼 때 되돌림)
		local cm = player.CostumeManagerComponent
		if isvalid(cm) then
			self._T.origOne = cm:GetEquip(MapleAvatarItemCategory.OneHandedWeapon)
			self._T.origTwo = cm:GetEquip(MapleAvatarItemCategory.TwoHandedWeapon)
		end
		self.InfoTitle = "스킬을 고르세요"
		self.InfoDesc = "히어로는 스킬 버튼을 누르면 그 스킬만 실행되고, 다른 직업은 이펙트 스킬이 차례로 재생됩니다"
		self:SpawnMonster()
		log("[VRF] skill test player setup user=" .. tostring(player.PlayerComponent.UserId))
	end

	@ExecSpace("ServerOnly")
	method void SpawnMonster()
		-- 지금 고른 층 몬스터를 오른쪽에 세운다 (공격하지 않는 허수아비).
		self:DestroyMonster()
		local list = self._T.floorMonsters
		if #list == 0 then return end
		local look = list[math.min(self._T.monsterIndex, #list)]
		local monster = _SpawnService:SpawnByModelId(self.MonsterModelId, "TestMonster", self.MonsterPos, self.Entity)
		if monster == nil then
			log_error("[VRF] skill test monster spawn failed id=" .. self.MonsterModelId)
			return
		end
		self._T.monster = monster
		self.MonsterHp = self.MonsterMaxHp
		local mc = monster:GetComponent("script.TowerMonster")
		if mc ~= nil then mc:ApplyLook(look.stand, look.attack, look.hit, look.die, look.hitSound, look.dieSound) end
		self.MonsterLabel = tostring(self._T.monsterIndex) .. "층 " .. look.name
		log("[VRF] skill test monster " .. self.MonsterLabel)
	end

	@ExecSpace("ServerOnly")
	method void DestroyMonster()
		-- 허수아비 몬스터 제거.
		if isvalid(self._T.monster) then self._T.monster:Destroy() end
		self._T.monster = nil
	end

	@ExecSpace("ServerOnly")
	method void ClearTimers()
		-- 재생 대기 중인 스킬 타이머를 모두 취소한다.
		for _, id in ipairs(self._T.timers or {}) do _TimerService:ClearTimer(id) end
		self._T.timers = {}
	end

	@ExecSpace("ServerOnly")
	method void Later(any fn, number delay)
		-- 취소할 수 있게 기록해 두는 1회 타이머.
		table.insert(self._T.timers, _TimerService:SetTimerOnce(fn, math.max(0.01, delay)))
	end

	@ExecSpace("ServerOnly")
	method void EquipForJob(string jobId)
		-- 히어로 스킬은 양손검을 들고(스킬 동작도 양손검 계열 프레임), 다른 직업은 원래 무기로.
		local player = self._T.player
		if not isvalid(player) then return end
		local cm = player.CostumeManagerComponent
		local tp = player:GetComponent("script.TowerPlayer")
		if not isvalid(cm) then return end
		if jobId == "Hero" then
			cm:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, "")
			cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, self.HeroWeaponRUID)
			if tp ~= nil then tp.WeaponFamily = "T" end
		else
			cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, self._T.origTwo or "")
			cm:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, self._T.origOne or "")
			if tp ~= nil then tp.WeaponFamily = "O" end
		end
	end

	@ExecSpace("Server")
	method void RequestPlayJob(string jobId, string jobName)
		-- 직업 버튼: 그 직업의 이펙트 스킬을 하나씩 재생한다. 재생 중이면 끊고 새로 시작.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		self:ClearTimers()
		self:EquipForJob(jobId)
		self.PlaySeq = self.PlaySeq + 1
		local list = self._T.skills[jobId] or {}
		log("[VRF] skill test play " .. jobId .. " skills=" .. tostring(#list))
		if #list == 0 then
			self.InfoTitle = jobName
			self.InfoDesc = "이펙트가 있는 스킬이 없습니다 (능력치 스킬만 있음)"
			return
		end
		for i, sk in ipairs(list) do
			local idx = i
			local skill = sk
			self:Later(function() self:PlaySkill(skill, jobName, idx, #list) end, (i - 1) * self.SkillGap)
		end
	end

	@ExecSpace("Server")
	method void RequestPlaySkill(string jobId, string jobName, string skillId)
		-- 스킬 버튼(히어로): 그 스킬 하나만 실제 전투와 같은 연출로 실행한다. 재생 중이면 끊고 새로 시작.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		self:ClearTimers()
		self:EquipForJob(jobId)
		self.PlaySeq = self.PlaySeq + 1
		local list = self._T.skills[jobId] or {}
		if jobId == "Hero" and self:HC() ~= nil and self:HC()._T.skills ~= nil and self:HC()._T.skills[skillId] ~= nil then
			self:PlayHeroSkill(skillId)
			return
		end
		for i, sk in ipairs(list) do
			if sk.id == skillId then
				log("[VRF] skill test single " .. skillId)
				self:PlaySkill(sk, jobName, i, #list)
				return
			end
		end
		log_warning("[VRF] skill test single not found " .. tostring(skillId))
	end

	@ExecSpace("ServerOnly")
	method void PlaySkill(table sk, string jobName, integer idx, integer total)
		-- 스킬 하나: 공격 동작 → (HitDelay 뒤) 연타 수만큼 이펙트 + 피해 숫자 (회복 스킬은 캐릭터 위).
		local player = self._T.player
		local monster = self._T.monster
		if not isvalid(player) or not isvalid(monster) then return end
		self.InfoTitle = jobName .. " - " .. sk.name .. "  (" .. tostring(idx) .. "/" .. tostring(total) .. ")"
		-- 자기 동작이 없는 스킬(콤보 인스팅트처럼 다른 공격 적중 때 같이 발동)은 일반 공격 모션으로 보여 준다
		local action = sk.actionName
		if (sk.actionFrames or "") == "" then action = "일반 공격 (적중 시 동반 발동)" end
		self.InfoDesc = sk.desc .. "\n" .. sk.type .. " · " .. tostring(sk.hits) .. "타 · 이펙트 크기 " .. tostring(sk.fxScale) .. " · 액션 " .. action
		local tp = player:GetComponent("script.TowerPlayer")
		-- HitPolicy "random": 변형 묶음 중 하나를 골라 같은 번호의 이펙트·소리를 쓴다 (콤보 인스팅트 3종)
		if sk.policy == "random" then
			local fxs = {}
			for ruid in string.gmatch(sk.fx or "", "[^|]+") do table.insert(fxs, ruid) end
			local k = _UtilLogic:RandomIntegerRange(1, math.max(1, #fxs))
			local function at(list)
				local n = 0
				local last = ""
				for v in string.gmatch(list or "", "[^|]+") do
					n = n + 1
					last = v
					if n == k then return v end
				end
				return last
			end
			local copy = {}
			for key, v in pairs(sk) do copy[key] = v end
			copy.fx = at(sk.fx)
			copy.casterFx = at(sk.casterFx)
			copy.useSound = at(sk.useSound)
			copy.hitSound = at(sk.hitSound)
			copy.policy = "per_hit"
			sk = copy
			self.InfoTitle = self.InfoTitle .. "  [변형 " .. tostring(k) .. "]"
		end
		-- 캐릭터 이펙트도 FxScale 크기로 ("ruid@크기")
		local caster = sk.casterFx or ""
		if caster ~= "" and (sk.fxScale or 1) ~= 1 then
			local parts = {}
			for ruid in string.gmatch(caster, "[^|]+") do table.insert(parts, ruid .. "@" .. tostring(sk.fxScale)) end
			caster = table.concat(parts, "|")
		end
		if tp ~= nil then tp:PlayAttackMotion(0, sk.actionFrames, sk.actionTime, caster, sk.useSound or "", player.PlayerComponent.UserId) end
		-- 타격 시점: 동작 데이터의 음수→양수 전환 순간 (TowerPlayer와 같은 규칙, 없으면 HitDelay)
		local hitDelay = self.HitDelay
		if tp ~= nil then
			local ht = tp:HitTimeOf(sk.actionFrames or "")
			if ht > 0 then hitDelay = ht end
		end
		-- 버프·소환은 피격 없음 (시전 동작·이펙트만)
		local hits = sk.hits
		if sk.kind == "버프" or sk.kind == "소환" or sk.kind == "충전" then hits = 0 end
		if sk.id == "H15" then hits = 1 end
		local gap = self.ProcHitInterval
		if (sk.gap or 0) > 0 then gap = sk.gap end
		-- 발사체 스킬 (오라 블레이드): 몸 중심에서 몬스터 쪽으로 발사체를 날리고, 닿는 순간부터 타격
		local travel = 0
		local shot = self:HC() ~= nil and self:HC():ShotRUID(sk.id or "") or ""
		if shot ~= "" and hits > 0 then
			local hc = self:HC()
			local pp = player.TransformComponent.WorldPosition
			local mp = monster.TransformComponent.WorldPosition
			local start = Vector3(pp.x + hc.ShotOrigin.x, pp.y + hc.ShotOrigin.y, pp.z)
			local dx = mp.x - start.x
			local dy = (mp.y + (sk.hitY or 0.45)) - start.y
			local len = math.max(0.001, math.sqrt(dx * dx + dy * dy))
			local dir = Vector3(dx / len, dy / len, 0)
			local reach = math.max(0, math.abs(dx) - hc.ShotReach) / math.max(0.001, math.abs(dir.x))
			travel = reach / hc.ShotSpeed
			self._T.shotSeq = (self._T.shotSeq or 0) + 1
			local sid = 100000 + self._T.shotSeq
			local uid = player.PlayerComponent.UserId
			-- 관통형은 몬스터를 지나 화면 밖까지, 아니면 닿는 순간 사라짐
			local pierce = hc:ShotType(sk.id) == "pierce"
			local range = reach + 0.05
			if pierce then range = hc.ShotRange end
			self:Later(function() hc:ShowShot(sid, shot, start, dir, hc.ShotSpeed, range, sk.fxScale or 1, uid) end, hitDelay)
			if not pierce then self:Later(function() hc:EndShot(sid, uid) end, hitDelay + travel) end
			log("[VRF] skill test shot " .. sk.id .. " travel=" .. string.format("%.2f", travel))
		end
		for h = 1, hits do
			local hit = h
			self:Later(function() self:PlayHit(sk, hit) end, hitDelay + travel + (h - 1) * gap)
		end
		-- 상태이상 그림 (코마 기절 별 등): 몬스터 머리 위 2초
		if (sk.mobFx or "") ~= "" then
			self:Later(function()
				local mon = self._T.monster
				if not isvalid(mon) then return end
				local wp = mon.TransformComponent.WorldPosition
				local serial = _EffectService:PlayEffect(sk.mobFx, mon, Vector3(wp.x, wp.y + 0.75, wp.z), 0, Vector3(1, 1, 1), true)
				self:Later(function() _EffectService:RemoveEffect(serial) end, 2)
			end, hitDelay + 0.05)
		end
		log("[VRF] skill test fx " .. sk.name .. " type=" .. sk.type .. " hits=" .. tostring(sk.hits) .. " scale=" .. tostring(sk.fxScale))
	end

	@ExecSpace("ServerOnly")
	method void PlayHit(table sk, integer h)
		-- 연타 한 대: TowerRunManager.ApplyProcHit과 같은 위치 규칙으로 이펙트를 그린다.
		local player = self._T.player
		local monster = self._T.monster
		if not isvalid(player) or not isvalid(monster) then return end
		local onPlayer = sk.type == "Heal"
		local who = monster
		if onPlayer then who = player end
		local wp = who.TransformComponent.WorldPosition
		-- 연타 이펙트는 조금씩 다른 자리에 (좌우·위아래로 번갈아)
		local ox = ((h - 1) % 3 - 1) * 0.12
		local oy = (math.floor((h - 1) / 3) % 2) * 0.12
		if h == 1 then ox = 0 end
		local fxList = {}
		for ruid in string.gmatch(sk.fx, "[^|]+") do table.insert(fxList, ruid) end
		-- 히트 이펙트: 긴 이펙트(once)는 첫 타에만, 짧은 이펙트(per_hit)는 타마다
		local showFx = sk.policy ~= "once" or h == 1
		if sk.policy == "once" then
			ox = 0
			oy = 0
		end
		local hy = sk.hitY or 0.45
		if #fxList > 0 and showFx then _EffectService:PlayEffect(fxList[(h - 1) % #fxList + 1], who, Vector3(wp.x + ox, wp.y + hy + oy, wp.z), 0, Vector3(sk.fxScale, sk.fxScale, 1), false, { FlipX = true }) end
		-- 피격음은 히트 이펙트와 같은 순간 (긴 이펙트는 첫 타에만, 짧은 이펙트는 타마다)
		if showFx and (sk.hitSound or "") ~= "" then _SoundService:PlaySound(sk.hitSound, 0.7) end
		local tp = player:GetComponent("script.TowerPlayer")
		if tp == nil then return end
		-- 피해 숫자는 예시 값 (스킬 계수 %), 주사위는 무작위
		if onPlayer then
			tp:ShowHeal(math.max(1, math.floor(sk.pct)))
		else
			local amount = math.floor(sk.pct)
			if sk.type == "Dice" then amount = _UtilLogic:RandomIntegerRange(50, 300) end
			if amount > 0 then tp:ShowProcDamage(monster, amount, sk.type == "CritStrike") end
			local mc = monster:GetComponent("script.TowerMonster")
			if mc ~= nil then mc:SetClip(mc.HitRUID, mc.HitAnimTime) end
		end
	end

	-- ========== 히어로: 실제 전투 로직 + 돌파 토글 ==========

	@ExecSpace("Server")
	method void RequestSetBreak(string breakId, boolean on)
		-- 돌파 토글 (스킬 테스트 전용): 켠 돌파는 다음 시전부터 적용된다.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		if self._T.breaks == nil then self._T.breaks = {} end
		if on then self._T.breaks[breakId] = true else self._T.breaks[breakId] = nil end
		log("[VRF] skill test break " .. breakId .. "=" .. tostring(on))
	end

	@ExecSpace("ServerOnly")
	method void SetupHero()
		-- 히어로 전투 로직을 테스트용으로 준비: 모든 히어로 스킬을 배운 상태, 이 컴포넌트를 전투 매니저로.
		local hc = self:HC()
		hc:ClearState()
		hc._T.mgr = self
		-- 스킬 테스트에서는 인레이지가 저절로 발동하지 않게 (버튼으로만)
		hc._T.noAutoBuff = true
		for id, _ in pairs(hc._T.skills) do
			table.insert(hc._T.equip, id)
			hc._T.ownLv[id] = 1
			self.SkillLv[id] = 1
		end
		hc.Active = true
		hc.Mana = hc.ManaMax
		self._T.heroReady = true
		self.MonsterHp = self.MonsterMaxHp
		log("[VRF] skill test hero ready skills=" .. tostring(#hc._T.equip))
	end

	@ExecSpace("ServerOnly")
	method void PlayHeroSkill(string skillId)
		-- 히어로 스킬 하나를 실제 전투와 같은 계산·연출로: 시전 동작 → 타격 순간(동작의 음수→양수 전환)에 적용.
		-- 시전마다 콤보·마나 가득, 쿨타임 무시. 켠 돌파가 그대로 반영된다.
		local hc = self:HC()
		if not self._T.heroReady then self:SetupHero() end
		hc._T.mgr = self
		local player = self._T.player
		local monster = self._T.monster
		if not isvalid(player) or not isvalid(monster) then return end
		local sk = hc._T.skills[skillId]
		-- 인레이지: 동작 없이 자동 발동 버프 → 시전 그림 후 버프 (쿨타임 무시하고 바로)
		if skillId == "H05" then
			hc._T.cd.H05 = 0
			hc:StartInrage()
			self.InfoTitle = "히어로 - " .. sk.name
			self.InfoDesc = "시전 그림이 끝나면 버프 + 지속 동안 캐릭터 이펙트"
			return
		end
		hc.Combo = hc:ComboCap()
		hc.Mana = hc.ManaMax
		self.PlayerHp = self.PlayerMaxHp * 0.6
		hc._T.cd[skillId] = 0
		hc._T.till[skillId] = 0
		local r = hc:MakeCast(sk)
		local on = {}
		for _, row in ipairs(self._T.breakRows or {}) do
			if row.skill == skillId and self._T.breaks ~= nil and self._T.breaks[row.id] then table.insert(on, row.name) end
		end
		self.InfoTitle = "히어로 - " .. sk.name
		local brk = "돌파 없음"
		if #on > 0 then brk = "돌파: " .. table.concat(on, ", ") end
		local hitN = #(r.hitDmg or {})
		self.InfoDesc = brk .. "\n" .. tostring(hitN) .. "타 · 콤보·마나 가득에서 시전 (실제 전투 계산)"
		local tp = player:GetComponent("script.TowerPlayer")
		local delay = self.HitDelay
		if tp ~= nil then
			tp:PlayAttackMotion(0, r.actionFrames or "", r.actionTime or 0.8, r.casterFx or "", r.useSound or "", player.PlayerComponent.UserId)
			local ht = tp:HitTimeOf(r.actionFrames or "")
			if ht > 0 then delay = ht end
		end
		self:Later(function()
			if isvalid(self._T.monster) then hc:ApplyCast(self, r, self._T.monster) end
		end, delay)
		log("[VRF] skill test hero " .. skillId .. " hits=" .. tostring(hitN) .. " breaks=" .. tostring(#on))
		-- 발할라: 충전만 하는 스킬이라, 이어서 일반 공격을 반복해 추가타를 보여 준다
		if skillId == "H10" then
			self.InfoDesc = brk .. "\n충전 " .. tostring(hc._T.valCharge or 0) .. "회 · 이어서 일반 공격으로 추가타 확인 (테스트 전용: 일반 공격도 직접 공격 스킬처럼 충전을 씀)"
			self:Later(function() self:ValhallaDemoHit(1) end, delay + 0.6)
		end
	end

	@ExecSpace("ServerOnly")
	method void ValhallaDemoHit(integer n)
		-- 발할라 테스트: 일반 공격 1회 + 남은 충전으로 추가타. 충전이 다 떨어진 뒤 한 번 더 치고 끝 (최대 15회).
		local hc = self:HC()
		local player = self._T.player
		local monster = self._T.monster
		if not isvalid(player) or not isvalid(monster) then return end
		local left = hc._T.valCharge or 0
		local tp = player:GetComponent("script.TowerPlayer")
		if tp ~= nil then tp:PlayAttackMotion(0, "", 0.6, "", "", player.PlayerComponent.UserId) end
		self:Later(function()
			if not isvalid(self._T.monster) then return end
			local target = self._T.monster
			local dmg = math.floor(self.PlayerAtk)
			self:ApplyMonsterDamage(dmg)
			if tp ~= nil then tp:ShowProcDamage(target, dmg, false) end
			local r = {}
			hc:UseValhalla(r)
			if r.valhalla ~= nil then hc:PlayValhalla(target, r.valhalla.dmg, r.valhalla.crit, 0, r.valhalla.combo == true, r.valhalla.bleed == true) end
			log("[VRF] valhalla demo hit " .. tostring(n) .. " charge " .. tostring(left) .. " -> " .. tostring(hc._T.valCharge or 0))
		end, self.HitDelay)
		if left > 0 and n < 15 then self:Later(function() self:ValhallaDemoHit(n + 1) end, 0.9) end
	end

	-- TowerRunManager 대신 히어로 전투 로직에 넘겨주는 정보 (이름을 맞춘다)
	@ExecSpace("ServerOnly")
	method boolean HeroBreak(string skillId, string breakId)
		-- 켠 돌파인지.
		return self._T.breaks ~= nil and self._T.breaks[breakId] == true
	end

	@ExecSpace("ServerOnly")
	method number HeroStarVal(string skillId, string key)
		-- 별 강화는 테스트에서 0.
		return 0
	end

	@ExecSpace("ServerOnly")
	method void HealPlayer(number amount)
		-- 회복: 체력을 채우고 회복 숫자 표시.
		local heal = math.floor(amount + 0.5)
		if heal <= 0 then return end
		self.PlayerHp = math.min(self.PlayerMaxHp, self.PlayerHp + heal)
		local pc = self:GetPlayerAttack()
		if pc ~= nil then pc:ShowHeal(heal) end
	end

	@ExecSpace("ServerOnly")
	method Component HC()
		-- 플레이어에 붙은 히어로 전투 컴포넌트 (히어로 전투가 캐릭터별 컴포넌트로 바뀜).
		local player = self._T.player
		if not isvalid(player) then return nil end
		local hc = player:GetComponent("script.HeroCombat")
		self._T.hc = hc
		self._T.hcEntity = player
		return hc
	end

	@ExecSpace("ServerOnly")
	method number ActorMaxHp(Entity e)
		-- 히어로 전투용 캐릭터 최대 체력 (테스트는 플레이어 하나).
		return self.PlayerMaxHp
	end

	@ExecSpace("ServerOnly")
	method number ActorHp(Entity e)
		-- 히어로 전투용 캐릭터 현재 체력.
		return self.PlayerHp
	end

	@ExecSpace("ServerOnly")
	method void HealActor(Entity e, number amount)
		-- 히어로 전투용 캐릭터 회복.
		self:HealPlayer(amount)
	end

	@ExecSpace("ServerOnly")
	method number ShieldOf(Entity e)
		-- 히어로 전투용 보호막.
		return self._T.shield or 0
	end

	@ExecSpace("ServerOnly")
	method void AddShield(Entity e, number amount)
		-- 히어로 전투용 보호막 더하기.
		self._T.shield = math.max(0, (self._T.shield or 0) + amount)
	end

	@ExecSpace("ServerOnly")
	method number PlayerHitDamage()
		-- 피해 기준 공격력.
		return self.PlayerAtk
	end

	@ExecSpace("ServerOnly")
	method Entity HeroMonster()
		-- 허수아비 몬스터.
		return self._T.monster
	end

	@ExecSpace("ServerOnly")
	method Entity HeroPlayer()
		-- 플레이어.
		return self._T.player
	end

	@ExecSpace("ServerOnly")
	method Component GetPlayerAttack()
		-- 피해 숫자 표시용 TowerPlayer.
		local player = self._T.player
		if not isvalid(player) then return nil end
		return player:GetComponent("script.TowerPlayer")
	end

	@ExecSpace("ServerOnly")
	method void ApplyMonsterDamage(number dmg)
		-- 허수아비 체력 감소 (0이 되면 다시 가득) + 피격 모션. 체력은 몬스터 이름 옆에 표시.
		self.MonsterHp = self.MonsterHp - dmg
		if self.MonsterHp <= 0 then
			self.MonsterHp = self.MonsterMaxHp
			log("[VRF] skill test dummy refilled")
		end
		local mon = self._T.monster
		if isvalid(mon) then
			local mc = mon:GetComponent("script.TowerMonster")
			if mc ~= nil then mc:SetClip(mc.HitRUID, mc.HitAnimTime) end
		end
		self:UpdateMonsterLabel()
	end

	@ExecSpace("ServerOnly")
	method void UpdateMonsterLabel()
		-- 몬스터 이름 + 허수아비 체력.
		local list = self._T.floorMonsters
		local look = list[math.min(self._T.monsterIndex, #list)]
		if look == nil then return end
		self.MonsterLabel = tostring(self._T.monsterIndex) .. "층 " .. look.name .. "  (체력 " .. tostring(math.max(0, math.floor(self.MonsterHp))) .. "/" .. tostring(math.floor(self.MonsterMaxHp)) .. ")"
	end

	@ExecSpace("ServerOnly")
	method void OnPlayerCrit()
		-- 테스트에서는 없음.
	end

	@ExecSpace("ServerOnly")
	method void HeroSetStun(number sec)
		-- 테스트 허수아비는 공격하지 않아 기절 지연 없음.
	end

	@ExecSpace("ServerOnly")
	method void HeroSetVuln(number pct, number sec)
		-- 테스트에서는 없음.
	end

	@ExecSpace("ServerOnly")
	method void AddBuff(string tag, string key, number value, number duration, number burst)
		-- 테스트에서는 버프 수치 없음 (연출만).
	end

	@ExecSpace("ServerOnly")
	method number Bonus(string effType)
		-- 각인·직업 보너스 없음.
		return 0
	end

	@ExecSpace("ServerOnly")
	method Component GetEngrave()
		-- 아웃게임 각인 없음.
		return nil
	end

	@ExecSpace("Server")
	method void RequestNextMonster()
		-- 몬스터 변경 버튼: 다음 층 몬스터로 바꾼다 (몬스터 크기에 따라 이펙트가 어떻게 보이는지 확인).
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		local n = #self._T.floorMonsters
		if n == 0 then return end
		self._T.monsterIndex = self._T.monsterIndex % n + 1
		self:SpawnMonster()
	end

	@ExecSpace("Server")
	method void RequestLobby()
		-- 로비로 버튼.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		self:ClearTimers()
		self:DestroyMonster()
		self._T.player = nil
		_TeleportService:TeleportToMapPosition(player, self.LobbyPos, self.LobbyMapName)
		log("[VRF] skill test -> lobby")
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 플레이어가 들어오면 자리 잡기, 나가면 정리.
		local player = self._T.player
		if isvalid(player) and player.CurrentMap ~= self.Entity then
			self:ClearTimers()
			self:DestroyMonster()
			self._T.player = nil
			player = nil
		end
		if self._T.heroReady then
			local hc = self:HC()
			if isvalid(player) and hc ~= nil then
				hc:Tick(self, delta)
			else
				self._T.heroReady = false
				if self._T.hc ~= nil and isvalid(self._T.hcEntity) then self._T.hc:ClearState() end
			end
		end
		if not isvalid(player) then
			local found = self:FindPlayer()
			if found ~= nil then self:SetupPlayer(found) end
		end
	end

end
