@Logic
script CharacterUILogic extends Logic

	-- 로비 캐릭터 화면 (CharacterUI.ui): 왼쪽 위 편성 칸 3개(차수 외형 아바타), 왼쪽 아래 직업 목록, 오른쪽 상세(능력치·경험의 서·레벨업·스킬 칸 6개·전직), 위쪽 재화.
	-- 스킬 칸: 현재 차수 기준 고유 패시브·주력기·보조기·기술·하이퍼·궁극기. 누르면 스킬 상세 툴팁(_TooltipLogic:ShowSkill), 미해금 칸은 어둡게 + "n차 해금".
	-- 편성 변경: 편성 칸을 누르면 그 칸이 선택되고 나머지 두 칸 오른쪽 위에 누르기 표시가 깜박인다 → 그 칸을 누르면 두 칸이 자리를 바꾼다.
	-- 목록에서 편성 밖(해금된) 직업을 누르면 세 칸 모두에 같은 표시 → 누른 칸의 직업과 교체. 칸끼리 자리 바꾸기는 칸 안에서만 한다.
	-- 계산은 PlayerRoster의 실행 공간 지정 없는 함수(CharStat·PlanBooksFor·CapLevel 등)를 그대로 쓰고, 변경은 Request* 서버 요청으로만 한다.
	property string RootPath = "/ui/CharacterUI/Root"
	property string LobbyMapName = "Lobby"
	property integer MaxJobCards = 5
	property number BusyTimeout = 3
	property number MsgDuration = 2.5
	property Color TextColor = Color(0.14, 0.17, 0.21, 1)
	property Color SubColor = Color(0.36, 0.40, 0.46, 1)
	property Color GoodColor = Color(0.20, 0.48, 0.12, 1)
	property Color BadColor = Color(0.78, 0.20, 0.20, 1)
	-- 미리보기에서 두손 무기 대기 자세(stand2)를 쓰는 직업 (쉼표 구분)
	property string PreviewStand2Jobs = "Hero"
	property string HintIdle = ""
	-- 누르기 표시: 두 이미지(눌림·안 눌림)를 HintFlipTime초마다 번갈아 보여 준다
	property string HintPressedRUID = "79819392249746f88952f3b2321f2f17"
	property string HintIdleRUID = "3930c5d2e85b4bff8467aada64fda7f5"
	property number HintFlipTime = 0.5
	-- 스킬 칸 배경: 해금 = 밝은 카드, 미해금 = 비활성 카드
	property string SkillCellRUID = "a88cfe62e8e64c39bf14d682a77ef4a0"
	property string SkillCellLockedRUID = "d262f8e8502e4b7b88f381a9b7a4e4fb"
	-- 스킬 아이콘 등급 테두리 0~3 (원본 UISkill icon/Force 0~3 2배): 칸 1 패시브=0, 칸 2~4 주력기=1, 칸 5 하이퍼=2, 칸 6~8 5차=1, 칸 9 궁극기=3
	property string SkillGradeRUIDs = "b0aea354214c40c8a71269d940ad6868,b9c549ddcb2a44c0b28961b2274db165,cc8d408b6a55452f9494bc144940c0c9,b83e437513e848dc88dbd862bb340925"
	-- 차수 표시 아이콘 1~5차 (원본 스킬창 차수 책, 5차는 H 책을 V로 고친 그림) — output/ui/tier_icons
	property string TierIconRUIDs = "3d7d4fdc889d4938994304396e833adb,87e41576fc1347efa3ba9d492863cfe4,51a5ceb7fc26402c9002cc21d3d2c9bd,d59a0eaf90e54978828f2607c12e2281,7e1f0979bcb14e76a8c99d8216a2457b"
	-- 차수 탭 상태 이미지 (기본·하이라이트·눌림·잠김·선택), 숫자는 글자로 표시
	property string TierTabNormalRUID = "58baa5f5aa614003b021eb110f98770f"
	property string TierTabHoverRUID = "228665eefc6f4635b9c23367df918746"
	property string TierTabPressedRUID = "4be3ea370ced4ecc99eb21ece0688b7d"
	property string TierTabDisabledRUID = "5977e74633d14e62b021c6e4a09acf82"
	property string TierTabSelectedRUID = "17a47e7564b64a8c96efd60c6de3d926"
	-- 경험의 서 이름 (툴팁용). 아이콘은 CharacterUI.ui의 Book1~3/Icon에 지정 (부서진 경험치 조각·빛나는 경험치 조각·쓸만한 경험치 주머니)
	property string BookNames = "경험의 서 (소),경험의 서 (중),경험의 서 (대)"

	@HideFromInspector
	property table clickHandlers = {}

	-- ───────────────────────── 생명주기 ─────────────────────────

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결·상태 테마 지정. 처음에는 닫힌 상태.
		self.clickHandlers = {}
		self._T.open = false
		self._T.clock = 0
		self._T.sel = ""
		self._T.lastSeq = -1
		self._T.sig = ""
		self._T.pendingAt = nil
		self._T.msgUntil = nil
		self._T.ents = {}
		self:LoadJobs()
		for n = 1, self.MaxJobCards do
			local index = n
			local card = self:E("List/Job" .. tostring(n))
			_UIButtonLogic:UseTheme(card, "card")
			self:Bind(card, function() self:OnJobCard(index) end)
		end
		self._T.partySel = 0
		self._T.placeJob = ""
		self._T.lockedSel = false
		self._T.hintOn = { false, false, false }
		self._T.hintPhase = false
		self._T.hintClock = 0
		self._T.slotKey = {}
		for k = 1, 3 do
			local slot = k
			local b = self:E("Party/Slot" .. tostring(k))
			_UIButtonLogic:UseTheme(b, "card")
			self:Bind(b, function() self:OnPartySlot(slot) end)
		end
		local roles = { BtnLv1 = "button", BtnLvMax = "action", BtnPromote = "action", BtnPromoteCommon = "button", BtnUnlock = "action" }
		for name, role in pairs(roles) do _UIButtonLogic:UseTheme(self:E("Detail/" .. name), role) end
		_UIButtonLogic:UseTheme(self:E("Close"), "close")
		self:Bind(self:E("Detail/BtnLv1"), function() self:OnLevel(false) end)
		self:Bind(self:E("Detail/BtnLvMax"), function() self:OnLevel(true) end)
		self:Bind(self:E("Detail/BtnPromote"), function() self:OnPromote(false) end)
		self:Bind(self:E("Detail/BtnPromoteCommon"), function() self:OnPromote(true) end)
		self:Bind(self:E("Detail/BtnUnlock"), function() self:OnUnlock() end)
		self:Bind(self:E("Close"), function() self:Close() end)
		-- 스킬 칸 9개(고유 패시브·주력기·보조기·기술·하이퍼·5차 칸 3개·궁극기)·경험의 서 3칸: 누르면 툴팁 (정보 칸이라 상태 이미지 없음)
		self._T.tipTargets = {}
		self._T.skillCells = {}
		-- 스킬 V2: 8칸 (패시브1~3 · 액티브1~3 · 하이퍼 · 궁극기)
		for i = 1, 8 do
			local idx = i
			local cell = self:E("Detail/Skills/Skill" .. tostring(i))
			self:Bind(cell, function() self:ShowSkillTip(idx) end)
			if isvalid(cell) then
				_TooltipLogic:Register(cell, function() self:ShowSkillTip(idx) end)
				table.insert(self._T.tipTargets, cell)
			end
		end
		for k = 1, 3 do
			local idx = k
			local book = self:E("Detail/Book" .. tostring(k))
			self:Bind(book, function() self:ShowBookTip(idx) end)
			if isvalid(book) then
				_TooltipLogic:Register(book, function() self:ShowBookTip(idx) end)
				table.insert(self._T.tipTargets, book)
			end
		end
		-- 차수 탭 1~5: 누르면 그 차수 기준 스킬 칸을 본다 (현재 차수보다 높은 탭은 잠김)
		self._T.viewTier = 0
		self._T.viewJob = ""
		self._T.gradeFrames = {}
		for id in string.gmatch(self.SkillGradeRUIDs, "[^,]+") do table.insert(self._T.gradeFrames, id) end
		self._T.tierIcons = {}
		for id in string.gmatch(self.TierIconRUIDs, "[^,]+") do table.insert(self._T.tierIcons, id) end
		local tabSkin = { normal = self.TierTabNormalRUID, hover = self.TierTabHoverRUID, pressed = self.TierTabPressedRUID,
			disabled = self.TierTabDisabledRUID, selected = self.TierTabSelectedRUID, selectedHover = self.TierTabSelectedRUID, selectedPressed = self.TierTabSelectedRUID,
			textNormal = Color(0.86, 0.89, 0.93, 1), textHover = Color(1, 1, 1, 1), textSelected = Color(1, 1, 1, 1), textDisabled = Color(0.55, 0.58, 0.62, 1) }
		for t = 1, 5 do
			local tt = t
			local tab = self:E("Detail/TierTab" .. tostring(t))
			_UIButtonLogic:SetSkin(tab, tabSkin)
			self:Bind(tab, function() self:OnTierTab(tt) end)
		end
		self:LoadSkillData()
		local root =_EntityService:GetEntityByPath(self.RootPath)
		if isvalid(root) then root:SetEnable(false) end
		log("[VRF] CharacterUILogic begin jobs=" .. tostring(#self._T.jobs))
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 버튼 이벤트 해제.
		for _, rec in ipairs(self.clickHandlers) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
		end
		self.clickHandlers = {}
		for _, t in ipairs(self._T.tipTargets or {}) do
			if isvalid(t) then _TooltipLogic:Unregister(t) end
		end
		self._T.tipTargets = {}
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 열려 있을 때만: 로비 이탈 시 닫기, 결과(RosterSeq) 처리, 값 변화 반영, 연타 방지 해제, 문구 숨김.
		if not self._T.open then return end
		self._T.clock = self._T.clock + delta
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) or player.CurrentMap.Name ~= self.LobbyMapName then
			self:Close()
			return
		end
		self:TickHints(delta)
		if self._T.msgUntil ~= nil and self._T.clock >= self._T.msgUntil then
			self._T.msgUntil = nil
			self:SetText("Detail/Msg", "", nil)
		end
		local roster = self:Roster()
		if roster == nil then return end
		if roster.RosterSeq ~= self._T.lastSeq then
			local first = self._T.lastSeq < 0
			self._T.lastSeq = roster.RosterSeq
			self._T.pendingAt = nil
			if not first then self:HandleResult(roster) end
			self:Refresh()
			return
		end
		if self._T.pendingAt ~= nil and self._T.clock - self._T.pendingAt >= self.BusyTimeout then
			self._T.pendingAt = nil
			self:Refresh()
			return
		end
		if self:Signature(roster) ~= self._T.sig then self:Refresh() end
	end

	-- ───────────────────────── 열기·닫기 ─────────────────────────

	@ExecSpace("ClientOnly")
	method void Open()
		-- 로비 [캐릭터] 버튼: 화면을 열고 1번 편성 직업(또는 마지막 선택)을 보여 준다.
		local root = _EntityService:GetEntityByPath(self.RootPath)
		if not isvalid(root) then return end
		root:SetEnable(true)
		self._T.open = true
		self._T.pendingAt = nil
		self._T.viewJob = ""
		self._T.msgUntil = nil
		self._T.partySel = 0
		self._T.placeJob = ""
		self._T.lockedSel = false
		self:SetText("Detail/Msg", "", nil)
		local roster = self:Roster()
		if roster ~= nil then self._T.lastSeq = roster.RosterSeq else self._T.lastSeq = -1 end
		if self._T.sel == "" or self:JobById(self._T.sel) == nil then
			local eng = self:Engrave()
			if eng ~= nil and self:JobById(eng.MainJob) ~= nil then self._T.sel = eng.MainJob
			elseif #self._T.jobs > 0 then self._T.sel = self._T.jobs[1].id end
		end
		self:Refresh()
		log("[VRF] charui open sel=" .. tostring(self._T.sel))
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 닫기.
		local wasOpen = self._T.open
		self._T.open = false
		self._T.pendingAt = nil
		self._T.partySel = 0
		self._T.placeJob = ""
		local root = _EntityService:GetEntityByPath(self.RootPath)
		if isvalid(root) then root:SetEnable(false) end
		if wasOpen then log("[VRF] charui close") end
	end

	-- ───────────────────────── 도우미 ─────────────────────────

	@ExecSpace("ClientOnly")
	method Entity E(string rel)
		-- Root 기준 경로의 엔티티 (캐시).
		local e = self._T.ents[rel]
		if e ~= nil and isvalid(e) then return e end
		e = _EntityService:GetEntityByPath(self.RootPath .. "/" .. rel)
		self._T.ents[rel] = e
		return e
	end

	@ExecSpace("ClientOnly")
	method void Bind(Entity entity, any fn)
		-- 버튼 클릭 연결: 숨김·비활성 버튼은 입력을 무시한다.
		if not isvalid(entity) then return end
		local h = entity:ConnectEvent(ButtonClickEvent, function(e)
			if not entity.EnabledInHierarchy or not entity.ButtonComponent.Enable then return end
			_UISoundLogic:PlayClick()
			fn(e)
		end)
		table.insert(self.clickHandlers, { entity = entity, eventHandler = h })
	end

	@ExecSpace("ClientOnly")
	method any Roster()
		-- 로컬 플레이어의 PlayerRoster (없으면 nil).
		local p = _UserService.LocalPlayer
		if not isvalid(p) then return nil end
		return p:GetComponent("script.PlayerRoster")
	end

	@ExecSpace("ClientOnly")
	method any Engrave()
		-- 로컬 플레이어의 PlayerEngrave (편성 원본, 읽기 전용).
		local p = _UserService.LocalPlayer
		if not isvalid(p) then return nil end
		return p:GetComponent("script.PlayerEngrave")
	end

	@ExecSpace("ClientOnly")
	method void LoadJobs()
		-- 직업 목록(CharJobTable 순서)과 직업 아이콘(CharJobTable.IconRUID 직업 초상)을 읽는다.
		self._T.jobs = {}
		local jt = _DataService:GetTable("CharJobTable")
		if jt == nil then return end
		for i = 1, jt:GetRowCount() do
			local id = jt:GetCell(i, "JobId")
			if id ~= nil and id ~= "" then
				table.insert(self._T.jobs, {
					id = id, order = tonumber(jt:GetCell(i, "Order")) or i, group = jt:GetCell(i, "JobGroup") or "",
					name4 = jt:GetCell(i, "Name4") or id, icon = jt:GetCell(i, "IconRUID") or "",
					-- 전투 개편: 직업 기본 공격 타입(P/M)·기본 속성
					atkType = jt:GetCell(i, "AtkType") or "", element = jt:GetCell(i, "Element") or "",
				})
			end
		end
		table.sort(self._T.jobs, function(a, b) return a.order < b.order end)
		log("[VRF] charui job icons " .. tostring(#self._T.jobs) .. " first=" .. tostring(self._T.jobs[1] and self._T.jobs[1].icon or ""))
		if #self._T.jobs > self.MaxJobCards then log_warning("[VRF] charui jobs over " .. tostring(self.MaxJobCards) .. " — 앞 " .. tostring(self.MaxJobCards) .. "개만 표시") end
	end

	@ExecSpace("ClientOnly")
	method any JobById(string id)
		-- 직업 정보.
		for _, j in ipairs(self._T.jobs or {}) do
			if j.id == id then return j end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method string Comma(integer n)
		-- 천 단위 쉼표.
		local s = tostring(math.floor(n))
		local neg = ""
		if string.sub(s, 1, 1) == "-" then
			neg = "-"
			s = string.sub(s, 2)
		end
		local out = ""
		while string.len(s) > 3 do
			out = "," .. string.sub(s, -3) .. out
			s = string.sub(s, 1, string.len(s) - 3)
		end
		return neg .. s .. out
	end

	@ExecSpace("ClientOnly")
	method string Euro(string word)
		-- 받침에 따라 "으로"/"로" (마지막 한글 글자 기준, ㄹ 받침은 "로").
		local last = -1
		local i = 1
		local len = string.len(word)
		while i <= len do
			local c = string.byte(word, i)
			if c >= 0xE0 and c < 0xF0 and i + 2 <= len then
				local cp = (c - 0xE0) * 4096 + (string.byte(word, i + 1) - 0x80) * 64 + (string.byte(word, i + 2) - 0x80)
				if cp >= 0xAC00 and cp <= 0xD7A3 then last = cp end
				i = i + 3
			elseif c >= 0xC0 and c < 0xE0 then
				i = i + 2
			elseif c >= 0xF0 then
				i = i + 4
			else
				i = i + 1
			end
		end
		if last < 0 then return "로" end
		local jong = (last - 0xAC00) % 28
		if jong == 0 or jong == 8 then return "로" end
		return "으로"
	end

	@ExecSpace("ClientOnly")
	method void SetText(string rel, string s, any color)
		-- 글자 (색이 주어지면 색도).
		local e = self:E(rel)
		if not isvalid(e) or not isvalid(e.TextGUIRendererComponent) then return end
		e.TextGUIRendererComponent.Text = s
		if color ~= nil then e.TextGUIRendererComponent.FontColor = color end
	end

	@ExecSpace("ClientOnly")
	method void SetShown(string rel, boolean shown)
		-- 엔티티 표시.
		local e = self:E(rel)
		if isvalid(e) and e.Enable ~= shown then e:SetEnable(shown) end
	end

	@ExecSpace("ClientOnly")
	method void SetButton(string rel, boolean enabled)
		-- 버튼 활성/비활성 (비활성은 상태 이미지 + 입력 차단).
		local e = self:E(rel)
		if isvalid(e) then _UIButtonLogic:SetDisabled(e, not enabled) end
	end

	@ExecSpace("ClientOnly")
	method void ShowMsg(string s, Color color)
		-- 결과 문구 (2.5초 뒤 숨김).
		self:SetText("Detail/Msg", s, color)
		self._T.msgUntil = self._T.clock + self.MsgDuration
	end

	@ExecSpace("ClientOnly")
	method string Signature(any roster)
		-- 화면에 영향을 주는 값을 이어 붙인 문자열 (다른 경로의 변경 감지).
		local eng = self:Engrave()
		local party = ""
		if eng ~= nil then party = eng.MainJob .. "," .. eng.CompJob .. "," .. eng.Comp2Job .. "," .. tostring(eng.SkillLoaded) end
		return tostring(roster.RosterLoaded) .. "|" .. roster.CharData .. "|" .. roster.JobCards .. "|" .. tostring(roster.BookS) .. "," .. tostring(roster.BookM) .. "," .. tostring(roster.BookL)
			.. "|" .. tostring(roster.CommonCards) .. "|" .. tostring(roster.Diamonds) .. "|" .. party
	end

	@ExecSpace("ClientOnly")
	method table CharOf(table chars, string jobId)
		-- 캐릭터 상태 (없으면 잠긴 Lv1 1차).
		local c = chars[jobId]
		if c == nil then return { unlocked = false, level = 1, exp = 0, tier = 1, awkLv = 0, awkExp = 0 } end
		if not c.unlocked then return { unlocked = false, level = 1, exp = 0, tier = 1, awkLv = 0, awkExp = 0 } end
		return c
	end

	@ExecSpace("ClientOnly")
	method table Party()
		-- 현재 편성 {1번, 2번, 3번}.
		local eng = self:Engrave()
		if eng == nil then return { "", "", "" } end
		return { eng.MainJob, eng.CompJob, eng.Comp2Job }
	end

	-- ───────────────────────── 그리기 ─────────────────────────

	@ExecSpace("ClientOnly")
	method void Refresh()
		-- 목록·편성·재화·상세를 Sync 값으로 다시 그린다.
		local roster = self:Roster()
		if roster == nil then return end
		self._T.sig = self:Signature(roster)
		local loaded = roster.RosterLoaded
		local chars = roster:ParseCharData(roster.CharData)
		local cards = roster:ParseJobCards(roster.JobCards)
		local party = self:Party()
		local busy = self._T.pendingAt ~= nil or not loaded
		-- 위쪽 띠: 재화
		self:SetText("Currency", "다이아 " .. self:Comma(roster.Diamonds) .. " · 공용 카드 " .. tostring(roster.CommonCards), nil)
		-- 직업 카드
		for n = 1, self.MaxJobCards do
			local j = self._T.jobs[n]
			local cardRel = "List/Job" .. tostring(n)
			self:SetShown(cardRel, j ~= nil)
			if j ~= nil then
				local c = self:CharOf(chars, j.id)
				local tier = c.tier
				self:SetText(cardRel .. "/Name", roster:TierName(j.id, tier), nil)
				if c.unlocked then
					self:SetText(cardRel .. "/Sub", "Lv." .. tostring(c.level) .. " · " .. tostring(tier) .. "차", nil)
				else
					self:SetText(cardRel .. "/Sub", "잠김", nil)
				end
				self:SetText(cardRel .. "/Cards", "카드 " .. tostring(cards[j.id] or 0), nil)
				local icon = self:E(cardRel .. "/Icon")
				if isvalid(icon) then
					icon.SpriteGUIRendererComponent.ImageRUID = DataRef(j.icon)
					-- 직업 초상: 칸 안에서 비율 유지·가운데 (늘어나거나 잘리지 않게)
					icon.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.AspectOnly
					if c.unlocked then icon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1) else icon.SpriteGUIRendererComponent.Color = Color(0.70, 0.70, 0.70, 1) end
				end
				self:SetShown(cardRel .. "/Lock", not c.unlocked)
				local slot = 0
				for k = 1, 3 do
					if party[k] == j.id then slot = k end
				end
				self:SetShown(cardRel .. "/PartyMark", slot > 0)
				if slot > 0 then self:SetText(cardRel .. "/PartyMark/Num", tostring(slot), nil) end
				_UIButtonLogic:SetSelected(self:E(cardRel), j.id == self._T.sel)
			end
		end
		-- 편성 칸: 차수 외형 아바타·직업 이름·Lv, 선택된 칸은 파란 테두리(Selected)
		for k = 1, 3 do
			self:RefreshPartySlot(roster, chars, k, party[k], busy)
		end
		if self._T.partySel > 0 then
			self:SetText("List/Hint", "바꿀 칸을 누르세요", self.TextColor)
		elseif self._T.placeJob ~= "" then
			self:SetText("List/Hint", "넣을 칸을 누르세요", self.TextColor)
		elseif self._T.lockedSel then
			self:SetText("List/Hint", "잠긴 직업", self.BadColor)
		else
			self:SetText("List/Hint", self.HintIdle, self.SubColor)
		end
		self:RefreshDetail(roster, chars, cards, busy)
	end

	@ExecSpace("ClientOnly")
	method void RefreshDetail(any roster, table chars, table cards, boolean busy)
		-- 오른쪽 상세: 이름·레벨·경험치·능력치·경험의 서·미리보기·전직.
		local job = self._T.sel
		local j = self:JobById(job)
		if j == nil then return end
		local c = self:CharOf(chars, job)
		local level = c.level
		local tier = c.tier
		local cap = roster:CapLevel(tier)
		local maxTier = roster:MaxTier()
		local tierName = roster:TierName(job, tier)
		local tierLabel = tierName .. " (" .. tostring(tier) .. "차)"
		if tier >= maxTier then tierLabel = tierName end
		self:SetText("Detail/Group", "", nil)
		self:SetText("Detail/TierName", tierLabel, nil)
		local tierIcon = self:E("Detail/TierIcon")
		local tierRuid = self._T.tierIcons[math.max(1, math.min(#self._T.tierIcons, tier))] or ""
		if isvalid(tierIcon) and tierIcon.SpriteGUIRendererComponent.ImageRUID.DataId ~= tierRuid then tierIcon.SpriteGUIRendererComponent.ImageRUID = DataRef(tierRuid) end
		local atMax = tier >= maxTier and level >= roster:MaxLevel()
		if atMax then
			self:SetText("Detail/LevelText", "Lv." .. tostring(level) .. " (최고)", nil)
		else
			self:SetText("Detail/LevelText", "Lv." .. tostring(level) .. "  /  관문 Lv." .. tostring(cap), nil)
		end
		-- 경험치 막대 (폭 < 24면 숨김: 슬라이스 경계 보호)
		local need = roster:NeedExp(level)
		local width = 884
		if level < cap and need > 0 then width = math.floor(884 * c.exp / need) end
		local fill = self:E("Detail/ExpFill")
		if isvalid(fill) then
			fill.UITransformComponent.RectSize = Vector2(math.max(24, width), 28)
			if fill.Enable ~= (width >= 24) then fill:SetEnable(width >= 24) end
		end
		if atMax then
			self:SetText("Detail/ExpText", "최고 레벨", nil)
		elseif level >= cap then
			self:SetText("Detail/ExpText", "관문 도달 — 전직 필요", nil)
		else
			self:SetText("Detail/ExpText", "경험치 " .. self:Comma(c.exp) .. " / " .. self:Comma(need), nil)
		end
		-- 능력치
		local st = roster:CharStat(job, level, tier)
		self:SetText("Detail/StatAtk", "공격력  " .. tostring(st.atk), nil)
		self:SetText("Detail/StatHp", "체력  " .. tostring(st.hp), nil)
		self:SetText("Detail/StatDef", "방어력  " .. tostring(st.def), nil)
		local pctNow = math.floor(roster:StatPct(tier) + 0.5)
		if tier >= maxTier then
			self:SetText("Detail/StatNote", "", nil)
		else
			local pctNext = math.floor(roster:StatPct(tier + 1) + 0.5)
			self:SetText("Detail/StatNote", "", nil)
		end
		-- 경험의 서
		local have = { roster.BookS, roster.BookM, roster.BookL }
		local per = { math.floor(roster:Cfg("BookExpS", 100)), math.floor(roster:Cfg("BookExpM", 500)), math.floor(roster:Cfg("BookExpL", 2000)) }
		self._T.bookHave = have
		self._T.bookPer = per
		for k = 1, 3 do
			local color = self.TextColor
			if have[k] <= 0 then color = self.BadColor end
			self:SetText("Detail/Book" .. tostring(k) .. "/Count", self:Comma(have[k]) .. "권", color)
			self:SetText("Detail/Book" .. tostring(k) .. "/Per", "+" .. self:Comma(per[k]), self.SubColor)
		end
		-- 스킬 칸 (현재 차수 기준)
		self:RefreshSkills(job, tier, maxTier)
		-- 레벨업 미리보기·버튼
		local canOne = false
		local canMax = false
		local maxLabel = "최대 레벨업"
		if not c.unlocked then
			self:SetText("Detail/PreviewOne", "", nil)
			self:SetText("Detail/PreviewMax", "", nil)
		elseif atMax then
			self:SetText("Detail/PreviewOne", "", nil)
			self:SetText("Detail/PreviewMax", "", nil)
		elseif level >= cap then
			self:SetText("Detail/PreviewOne", "", nil)
			self:SetText("Detail/PreviewMax", "", nil)
		else
			local one = roster:PlanBooksFor(level, c.exp, tier, have[1], have[2], have[3], level + 1)
			local mx = roster:PlanBooksFor(level, c.exp, tier, have[1], have[2], have[3], cap)
			canOne = one.s + one.m + one.l > 0
			canMax = mx.s + mx.m + mx.l > 0
			self:SetText("Detail/PreviewOne", "", nil)
			self:SetText("Detail/PreviewMax", "", nil)
			if canMax then maxLabel = "최대 → Lv." .. tostring(mx.newLevel) end
		end
		self:SetText("Detail/BtnLvMax", maxLabel, nil)
		self:SetButton("Detail/BtnLv1", canOne and not busy)
		self:SetButton("Detail/BtnLvMax", canMax and not busy)
		-- 전직·해금
		local jobCards = cards[job] or 0
		local cc = roster.CommonCards
		if not c.unlocked then
			self:SetText("Detail/PromoteTitle", "잠긴 직업", nil)
			self:SetText("Detail/PromoteInfo", "공용 카드 " .. tostring(cc) .. "장", self.TextColor)
			self:SetText("Detail/PromoteNote", "", nil)
			self:SetShown("Detail/BtnPromote", false)
			self:SetShown("Detail/BtnPromoteCommon", false)
			self:SetShown("Detail/BtnUnlock", true)
			self:SetButton("Detail/BtnUnlock", cc >= 1 and not busy)
		elseif tier >= maxTier then
			if atMax then
				self:SetText("Detail/PromoteTitle", "최고 차수 달성", nil)
			else
				self:SetText("Detail/PromoteTitle", "최고 차수 (" .. tostring(maxTier) .. "차)", nil)
			end
			self:SetText("Detail/PromoteInfo", "", nil)
			self:SetText("Detail/PromoteNote", "", nil)
			self:SetShown("Detail/BtnPromote", false)
			self:SetShown("Detail/BtnPromoteCommon", false)
			self:SetShown("Detail/BtnUnlock", false)
		else
			local nextTier = tier + 1
			local needCards = roster:PromoteCards(nextTier)
			local nextName = roster:TierName(job, nextTier)
			local nextLabel = nextName .. " (" .. tostring(nextTier) .. "차)"
			if nextTier >= maxTier then nextLabel = nextName end
			self:SetText("Detail/PromoteTitle", "다음 차수: " .. nextLabel, nil)
			local atCap = level >= cap
			local ok = atCap and jobCards + cc >= needCards
			local infoColor = self.BadColor
			if ok then infoColor = self.GoodColor end
			self:SetText("Detail/PromoteInfo", "Lv." .. tostring(cap) .. " 필요 · 전용 카드 " .. tostring(jobCards) .. "/" .. tostring(needCards) .. " · 공용 " .. tostring(cc), infoColor)
			self:SetText("Detail/PromoteNote", "", nil)
			self:SetShown("Detail/BtnUnlock", false)
			self:SetShown("Detail/BtnPromote", true)
			self:SetShown("Detail/BtnPromoteCommon", true)
			local canJob = atCap and jobCards >= needCards
			local canCommon = atCap and jobCards < needCards and jobCards + cc >= needCards
			if canCommon then
				self:SetText("Detail/BtnPromoteCommon", "공용 카드로 전직 (" .. tostring(needCards - jobCards) .. "장)", nil)
			else
				self:SetText("Detail/BtnPromoteCommon", "공용 카드로 전직", nil)
			end
			self:SetButton("Detail/BtnPromote", canJob and not busy)
			self:SetButton("Detail/BtnPromoteCommon", canCommon and not busy)
		end
	end

	@ExecSpace("ClientOnly")
	method string PlanLine(string label, integer level, integer target, table plan, table per)
		-- 레벨업 미리보기 한 줄. 책이 없으면 안내, 모자라면 (책 부족), 관문을 넘는 경험치는 사라진다고 표시.
		if plan.s + plan.m + plan.l == 0 then return "경험의 서가 없습니다" end
		local reach = "Lv." .. tostring(level) .. " → " .. tostring(plan.newLevel)
		if plan.newLevel < target then reach = "Lv." .. tostring(level) .. " → Lv." .. tostring(plan.newLevel) .. " (책 부족)" end
		local line = label .. "  " .. reach .. "  ·  소 " .. tostring(plan.s) .. " · 중 " .. tostring(plan.m) .. " · 대 " .. tostring(plan.l)
		local over = plan.s * per[1] + plan.m * per[2] + plan.l * per[3] - plan.gain
		if over > 0 then line = line .. "  (사라지는 경험치: " .. self:Comma(over) .. ")" end
		return line
	end

	@ExecSpace("ClientOnly")
	method void RefreshPartySlot(any roster, table chars, integer k, string job, boolean busy)
		-- 편성 칸 k: 직업(차수) 이름·Lv·차수, 실제 차수 외형 아바타. 빈 칸이면 아바타를 숨긴다.
		local rel = "Party/Slot" .. tostring(k)
		local slot = self:E(rel)
		if not isvalid(slot) then return end
		local j = self:JobById(job)
		local av = self:E(rel .. "/Avatar")
		if j == nil then
			self:SetText(rel .. "/Name", "비어 있음", self.SubColor)
			self:SetText(rel .. "/Sub", "", nil)
			if isvalid(av) and av.Enable then av:SetEnable(false) end
		else
			local c = self:CharOf(chars, job)
			local tier = c.tier
			self:SetText(rel .. "/Name", roster:TierName(job, tier), self.TextColor)
			self:SetText(rel .. "/Sub", "Lv." .. tostring(c.level) .. " · " .. tostring(tier) .. "차", self.SubColor)
			if isvalid(av) then
				if not av.Enable then av:SetEnable(true) end
				self:ShowSlotAvatar(roster, av, k, job, tier)
			end
		end
		_UIButtonLogic:SetSelected(slot, self._T.partySel == k)
		self:SetButton(rel, not busy)
		local hint = (self._T.partySel > 0 and self._T.partySel ~= k) or self._T.placeJob ~= ""
		self:SetHint(k, hint and not busy)
	end

	@ExecSpace("ClientOnly")
	method void SetHint(integer k, boolean on)
		-- k번 칸 오른쪽 위 누르기 표시 켜기/끄기. 켤 때는 지금 깜박임 단계의 이미지로 맞춘다.
		local e = self:E("Party/Slot" .. tostring(k) .. "/SwapHint")
		if not isvalid(e) then return end
		self._T.hintOn[k] = on
		if on then self:ApplyHintImage(e) end
		if e.Enable ~= on then e:SetEnable(on) end
	end

	@ExecSpace("ClientOnly")
	method void ApplyHintImage(Entity e)
		-- 깜박임 단계에 맞는 이미지 (true = 눌림).
		local ruid = self.HintIdleRUID
		if self._T.hintPhase then ruid = self.HintPressedRUID end
		e.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
	end

	@ExecSpace("ClientOnly")
	method void TickHints(number delta)
		-- HintFlipTime초마다 눌림/안 눌림 이미지를 번갈아 바꾼다 (켜진 표시만).
		self._T.hintClock = self._T.hintClock + delta
		if self._T.hintClock < self.HintFlipTime then return end
		self._T.hintClock = self._T.hintClock - self.HintFlipTime
		if self._T.hintClock >= self.HintFlipTime then self._T.hintClock = 0 end
		self._T.hintPhase = not self._T.hintPhase
		for k = 1, 3 do
			if self._T.hintOn[k] then
				local e = self:E("Party/Slot" .. tostring(k) .. "/SwapHint")
				if isvalid(e) then self:ApplyHintImage(e) end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowSlotAvatar(any roster, Entity av, integer k, string job, integer tier)
		-- 편성 칸 아바타: 그 직업·차수 외형 세트(머리·얼굴 포함)를 입히고 대기 자세를 정한다. 같은 세트면 다시 입히지 않는다.
		local cm = av.CostumeManagerComponent
		if not isvalid(cm) then return end
		local key = job .. ":" .. tostring(tier)
		if self._T.slotKey[k] == key then return end
		self._T.slotKey[k] = key
		local set = roster:OutfitFor(job, tier)
		for _, slotName in ipairs(roster:OutfitSlots()) do
			cm:SetEquip(roster:OutfitCategory(slotName), set[slotName] or "")
		end
		cm:SetEquip(MapleAvatarItemCategory.SubWeapon, "")
		local stand = "stand1"
		for _, sj in ipairs(roster:Split(self.PreviewStand2Jobs, ",")) do
			if sj == job then stand = "stand2" end
		end
		av:SendEvent(BodyActionTypeChangeEvent(true, stand))
		log("[VRF] charui slot" .. tostring(k) .. " avatar job=" .. job .. " tier=" .. tostring(tier) .. " stand=" .. stand)
	end

	-- ───────────────────────── 스킬 칸 ─────────────────────────

	@ExecSpace("ClientOnly")
	method void LoadSkillData()
		-- 스킬 이름·아이콘·설명(자리표시자 치환)·쿨타임, 직업·칸·차수별 스킬(CharSkillSlotTable), 고유 패시브 차수별 효과(CharPassiveTable).
		self._T.skills = {}
		self._T.slotRows = {}
		self._T.passiveRows = {}
		local js = _DataService:GetTable("JobSkillTable")
		if js ~= nil then
			for i = 1, js:GetRowCount() do
				local function num(col) return tonumber(js:GetCell(i, col)) or 0 end
				local text = js:GetCell(i, "Desc") or ""
				local vals = { c = num("Chance"), p = num("Pct"), h = num("ProcHits"), cd = num("Cooldown"), bt = num("BuffTime"), v1 = num("V1"), v2 = num("V2"), dp = num("DotPct"), dt = num("DotTime") }
				for key, v in pairs(vals) do text = (string.gsub(text, "{" .. key .. "}", tostring(math.floor(v)))) end
				local id = js:GetCell(i, "SkillId")
				if id ~= nil and id ~= "" and self._T.skills[id] == nil then
					-- 전투 개편: 스킬 속성(Element)·공격 타입(DmgType) — 빈칸이면 직업 기본값 (툴팁 종류 줄에 표시)
					self._T.skills[id] = { name = js:GetCell(i, "Name") or id, icon = js:GetCell(i, "IconRUID") or "", desc = text, cd = num("Cooldown"),
						elem = js:GetCell(i, "Element") or "", dmgType = js:GetCell(i, "DmgType") or "", kind = js:GetCell(i, "Kind") or "", pct = num("Pct") }
				end
			end
		end
		local hs = _DataService:GetTable("HeroSkillTable")
		if hs ~= nil then
			for i = 1, hs:GetRowCount() do
				local id = hs:GetCell(i, "SkillId")
				if id ~= nil and id ~= "" and self._T.skills[id] == nil then
					self._T.skills[id] = { name = hs:GetCell(i, "Name") or id, icon = hs:GetCell(i, "IconRUID") or "", desc = hs:GetCell(i, "Desc") or "", cd = tonumber(hs:GetCell(i, "Cooldown")) or 0 }
				end
			end
		end
		local ss = _DataService:GetTable("CharSkillSlotTable")
		if ss ~= nil then
			for i = 1, ss:GetRowCount() do
				local job = ss:GetCell(i, "JobId") or ""
				local key = ss:GetCell(i, "SlotKey") or ""
				local tier = math.floor(tonumber(ss:GetCell(i, "Tier")) or 0)
				local id = ss:GetCell(i, "SkillId") or ""
				if job ~= "" and key ~= "" and tier > 0 and id ~= "" then
					self._T.slotRows[job] = self._T.slotRows[job] or {}
					self._T.slotRows[job][key] = self._T.slotRows[job][key] or {}
					self._T.slotRows[job][key][tier] = { id = id, cd = tonumber(ss:GetCell(i, "CdSec")) or 0 }
				end
			end
		end
		-- 스킬 개편: 각성(6차) 칸 스킬 awkRows[직업][칸] = { id, stage } (CharSlotTable Awk·AwkStage)
		self._T.awkRows = {}
		local cs = _DataService:GetTable("CharSlotTable")
		if cs ~= nil then
			for i = 1, cs:GetRowCount() do
				local job = cs:GetCell(i, "JobId") or ""
				local key = cs:GetCell(i, "SlotKey") or ""
				local aid = cs:GetCell(i, "Awk") or ""
				local st = math.floor(tonumber(cs:GetCell(i, "AwkStage")) or 0)
				if job ~= "" and aid ~= "" and st > 0 then
					self._T.awkRows[job] = self._T.awkRows[job] or {}
					self._T.awkRows[job][key] = { id = aid, stage = st }
				end
			end
		end
		local ps = _DataService:GetTable("CharPassiveTable")
		if ps ~= nil then
			for i = 1, ps:GetRowCount() do
				local job = ps:GetCell(i, "JobId") or ""
				local tier = math.floor(tonumber(ps:GetCell(i, "Tier")) or 0)
				if job ~= "" and tier > 0 then
					self._T.passiveRows[job] = self._T.passiveRows[job] or {}
					self._T.passiveRows[job][tier] = { lv = math.floor(tonumber(ps:GetCell(i, "PassiveLv")) or 0), grant = ps:GetCell(i, "Grant") or "", extra = ps:GetCell(i, "Extra") or "" }
				end
			end
		end
		log("[VRF] charui skill data skills=" .. tostring(self:CountKeys(self._T.skills)) .. " jobs=" .. tostring(self:CountKeys(self._T.slotRows)) .. " passive=" .. tostring(self:CountKeys(self._T.passiveRows)))
	end

	@ExecSpace("ClientOnly")
	method integer CountKeys(table t)
		-- 표의 키 개수.
		local n = 0
		for _, _ in pairs(t or {}) do n = n + 1 end
		return n
	end

	@ExecSpace("ClientOnly")
	method table PassiveDef(string job)
		-- 직업 고유 패시브 이름·아이콘·설명 (스킬 화면 HeroSkillUILogic과 같은 아이콘).
		if job == "Hero" then return { name = "콤보 어택", icon = "7328c199a3494a2ab0c12335f637c762", desc = "콤보를 소비하지 않는 직접 공격이 맞으면 확률로 콤보 1 획득 (자연 감소 없음). 콤보당 기본 공격력 증가" } end
		if job == "Bishop" then return { name = "성수", icon = "7bb47f821c4541e2aea1359865193fe2", desc = "직접 공격이 맞을 때 확률로 성수 1개 획득. 성수 1개당 기본 공격력 증가. 샤이닝 레이·빅뱅·디바인 퍼니시먼트가 성수를 써서 강해진다" } end
		if job == "NightLord" then return { name = "마크 오브 나이트로드", icon = "cdbd9959dee2488b923d01636d71327c", desc = "직접 공격 타수마다 확률로 맞은 몬스터에게 표식 1. 표식 1개당 그 몬스터가 나이트로드에게 받는 피해 증가. 가득 차면 약점 노출: 파티 치명타 증가, 표창 추가" } end
		if job == "Bowmaster" then return { name = "퀴버 카트리지", icon = "b98c590c48bc4456be86af5f5ec25777", desc = "직접 공격 타수마다 확률로 강화 화살 1개. 화살 1개당 기본 공격력 증가. 가득 차면 다음 공격에 화살 폭풍" } end
		if job == "Viper" then return { name = "에너지 차지", icon = "06ea89f3087349e39587db13f7f82a49", desc = "직접 공격 타수마다 에너지 획득 (최대 100). 50 이상이면 받는 피해 감소, 100이면 기본 공격력 증가와 충전 완료(직접 공격마다 체력 회복)" } end
		return { name = "고유 패시브", icon = "", desc = "" }
	end

	@ExecSpace("ClientOnly")
	method string PassiveLine(table row)
		-- 패시브 한 차수 효과 문구: "Lv.5 · 콤보 인스팅트 · 콤보 최대 10".
		if row == nil then return "" end
		local extraNames = { ComboCap10 = "콤보 최대 10", ComboGain50 = "콤보 획득 확률 +50%", HolyMax10 = "성수 최대 10", ResMax8 = "표식 최대 8", ResMax15 = "강화 화살 최대 15", EnergyPlus3 = "타격당 에너지 +3" }
		local parts = { "Lv." .. tostring(row.lv) }
		for gid in string.gmatch(row.grant or "", "[^|]+") do
			local sk = self._T.skills[gid]
			if sk ~= nil then table.insert(parts, sk.name) else table.insert(parts, gid) end
		end
		for ex in string.gmatch(row.extra or "", "[^|]+") do table.insert(parts, extraNames[ex] or ex) end
		return table.concat(parts, " · ")
	end

	@ExecSpace("ClientOnly")
	method table SkillCellInfo(string job, integer tier, integer maxTier, integer i)
		-- i번째 칸(1 고유 패시브, 2 주력기, 3 보조기, 4 기술, 5 하이퍼, 6~8 5차 칸, 9 궁극기) 정보: 해금·스킬·해금 차수·다음 차수 진화.
		-- 5차 화면에서 각성 단계가 있으면 그 단계까지의 칸(주력기→보조기→기술→하이퍼→궁극기)은 각성(6차) 스킬로 보인다.
		-- 스킬 V2: 8칸 = 패시브1~3 → 액티브1~3 → 하이퍼 → 궁극기 (패시브1은 고유 패시브)
		local keys = { "Passive", "P2", "P3", "Main", "Sub", "Tech", "Hyper", "Ult" }
		local kinds = { "패시브", "패시브", "패시브", "액티브", "액티브", "액티브", "하이퍼", "궁극기" }
		local info = { key = keys[i], kind = kinds[i], unlocked = false, unlockTier = 0, id = "", cd = 0, nextId = "", nextTier = 0 }
		if i == 1 then
			local rows = self._T.passiveRows[job] or {}
			local p = self:PassiveDef(job)
			info.unlocked = true
			info.unlockTier = 1
			info.name = p.name
			info.icon = p.icon
			info.desc = p.desc
			info.row = rows[tier]
			if tier < maxTier then
				info.nextRow = rows[tier + 1]
				info.nextTier = tier + 1
			end
			return info
		end
		local rows = (self._T.slotRows[job] or {})[keys[i]] or {}
		local cur = rows[tier]
		if cur ~= nil then
			info.unlocked = true
			info.id = cur.id
			info.cd = cur.cd
		else
			for t = tier + 1, maxTier do
				if rows[t] ~= nil then
					info.unlockTier = t
					info.id = rows[t].id
					info.cd = rows[t].cd
					break
				end
			end
		end
		if info.unlocked and tier < maxTier and rows[tier + 1] ~= nil and rows[tier + 1].id ~= cur.id then
			info.nextId = rows[tier + 1].id
			info.nextTier = tier + 1
		end
		local awk = ((self._T.awkRows or {})[job] or {})[keys[i]]
		if awk ~= nil and info.unlocked and tier >= 5 then
			if (self._T.skillAwk or 0) >= awk.stage then
				info.id = awk.id
				info.awakened = true
			else
				info.nextAwkId = awk.id
				info.nextAwkStage = awk.stage
			end
		end
		local sk = self._T.skills[info.id] or { name = info.id, icon = "", desc = "", cd = 0 }
		info.name = sk.name
		info.icon = sk.icon
		info.desc = sk.desc
		if info.cd <= 0 then info.cd = sk.cd end
		return info
	end

	@ExecSpace("ClientOnly")
	method void RefreshSkills(string job, integer tier, integer maxTier)
		-- 스킬 칸 6개: 아이콘(칸 가운데)·칸 이름·스킬 이름. 미해금 칸은 어둡게 + "n차 해금".
		-- 차수 탭으로 고른 차수(viewTier, 현재 차수 이하) 기준으로 보여 준다. 직업이 바뀌면 현재 차수로 돌아간다.
		local curTier = tier
		if self._T.viewJob ~= job or self._T.viewTier < 1 or self._T.viewTier > curTier then
			self._T.viewJob = job
			self._T.viewTier = curTier
		end
		tier = self._T.viewTier
		for t = 1, 5 do
			local rel = "Detail/TierTab" .. tostring(t)
			self:SetShown(rel, t <= maxTier)
			local tab = self:E(rel)
			if isvalid(tab) then
				_UIButtonLogic:SetSelected(tab, t == tier)
				_UIButtonLogic:SetDisabled(tab, t > curTier)
			end
		end
		self._T.skillJob = job
		self._T.skillTier = tier
		self._T.skillMaxTier = maxTier
		self:SetText("Detail/SkillTitle", "스킬", nil)
		local names = {}
		-- 각성 단계 (5차에서만 의미): 저장된 각성 레벨을 단계 0~5로
		self._T.skillAwk = 0
		local roster = self:Roster()
		if roster ~= nil then
			local c = self:CharOf(roster:ParseCharData(roster.CharData), job)
			self._T.skillAwk = roster:AwakenStage(c.awkLv or 0)
		end
		-- 스킬 V2: 칸 테두리 = 패시브(0) · 액티브(1) · 하이퍼(2) · 궁극기(3)
		local gradeOfCell = { 0, 0, 0, 1, 1, 1, 2, 3 }
		for i = 1, 8 do
			local info = self:SkillCellInfo(job, tier, maxTier, i)
			local rel = "Detail/Skills/Skill" .. tostring(i)
			-- 아직 배우지 않은 스킬 칸은 통째로 숨긴다 (칸 이름 글자 없이 등급 테두리로 구분)
			self:SetShown(rel, info.unlocked)
			local frame = self:E(rel .. "/Frame")
			if isvalid(frame) then
				local fid = self._T.gradeFrames[gradeOfCell[i] + 1] or ""
				if frame.SpriteGUIRendererComponent.ImageRUID.DataId ~= fid then frame.SpriteGUIRendererComponent.ImageRUID = DataRef(fid) end
			end
			local icon = self:E(rel .. "/Icon")
			if isvalid(icon) then
				local spr = icon.SpriteGUIRendererComponent
				if spr.PreserveSprite ~= PreserveSpriteType.None then spr.PreserveSprite = PreserveSpriteType.None end
				spr.ImageRUID = DataRef(info.icon or "")
				if info.unlocked then spr.Color = Color(1, 1, 1, 1) else spr.Color = Color(0.35, 0.35, 0.38, 0.75) end
				if icon.Enable ~= ((info.icon or "") ~= "") then icon:SetEnable((info.icon or "") ~= "") end
			end
			if info.unlocked then
				self:SetText(rel .. "/Name", self:SkillLabel(info.name or ""), self.TextColor)
				table.insert(names, info.name or "")
			elseif info.unlockTier > 0 then
				self:SetText(rel .. "/Name", tostring(info.unlockTier) .. "차 해금", self.SubColor)
				table.insert(names, "(" .. tostring(info.unlockTier) .. "차)")
			else
				self:SetText(rel .. "/Name", "없음", self.SubColor)
				table.insert(names, "-")
			end
		end
		local key = job .. ":" .. tostring(tier)
		if self._T.skillLogKey ~= key then
			self._T.skillLogKey = key
			log("[VRF] charui skills job=" .. job .. " tier=" .. tostring(tier) .. " " .. table.concat(names, ","))
		end
	end

	@ExecSpace("ClientOnly")
	method string SkillLabel(string name)
		-- 칸 이름: 6글자 넘는 이름은 가운데에 가장 가까운 띄어쓰기에서 두 줄로 나눈다 (단어 중간 줄바꿈 방지). 띄어쓰기가 없으면 그대로(글자 크기 자동 축소).
		local total = utf8.len(name) or #name
		if total <= 6 then return name end
		local best = nil
		local bestScore = 999
		local pos = 1
		while true do
			local a = string.find(name, " ", pos, true)
			if a == nil then break end
			local left = utf8.len(string.sub(name, 1, a - 1)) or (a - 1)
			local right = total - left - 1
			local score = math.max(left, right)
			if score < bestScore then
				bestScore = score
				best = a
			end
			pos = a + 1
		end
		if best == nil then return name end
		return string.sub(name, 1, best - 1) .. "\n" .. string.sub(name, best + 1)
	end

	@ExecSpace("ClientOnly")
	method void OnTierTab(integer t)
		-- 차수 탭: 그 차수 기준 스킬 칸으로 다시 그린다 (잠긴 탭은 입력이 막혀 있다).
		if self._T.viewTier == t then return end
		self._T.viewTier = t
		log("[VRF] charui tier tab=" .. tostring(t))
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void ShowSkillTip(integer i)
		-- 스킬 칸 툴팁: 이름·칸 종류·쿨타임·설명, 다음 차수 진화·해금 차수.
		local cell = self:E("Detail/Skills/Skill" .. tostring(i))
		local job = self._T.skillJob
		if not isvalid(cell) or job == nil or job == "" then return end
		local info = self:SkillCellInfo(job, self._T.skillTier or 1, self._T.skillMaxTier or 5, i)
		local data = { icon = info.icon or "", name = info.name or "", kind = info.kind, desc = info.desc or "" }
		-- 전투 개편: 공격 타입·속성 (스킬 값, 빈칸이면 직업 기본값)
		local jobRow = nil
		for _, j in ipairs(self._T.jobs or {}) do if j.id == job then jobRow = j end end
		local sk = (info.id or "") ~= "" and self._T.skills[info.id] or nil
		data.atk = (sk ~= nil and (sk.dmgType or "") ~= "") and sk.dmgType or (jobRow ~= nil and jobRow.atkType or "")
		data.elem = (sk ~= nil and (sk.elem or "") ~= "") and sk.elem or (jobRow ~= nil and jobRow.element or "")
		-- 공격하지 않는 스킬(회복·보호, 또는 계수 0인 버프)과 고유 패시브는 공격 타입·속성을 표시하지 않는다
		if i == 1 or sk == nil or sk.kind == "회복" or sk.kind == "보호" or (sk.pct or 0) <= 0 then
			data.atk = ""
			data.elem = ""
		end
		local notes = {}
		if i == 1 then
			data.cooldownText = "장착 칸 없음"
			if info.row ~= nil then table.insert(notes, "<b><color=#8FBFFF>현재</color></b>  " .. self:PassiveLine(info.row)) end
			if info.nextRow ~= nil then table.insert(notes, "<b><color=#8FBFFF>다음 차수 (" .. tostring(info.nextTier) .. "차)</color></b>  " .. self:PassiveLine(info.nextRow)) end
		else
			if info.awakened then data.kind = info.kind .. " · 각성" end
			if info.key == "Ult" then
				data.cooldownText = "궁극기 게이지"
			elseif info.cd > 0 then
				data.cooldown = info.cd
			end
			if not info.unlocked and info.unlockTier > 0 then
				data.kind = info.kind .. " (" .. tostring(info.unlockTier) .. "차 해금)"
				table.insert(notes, "<b><color=#8FBFFF>" .. tostring(info.unlockTier) .. "차 전직 시 해금</color></b>")
			end
			if info.nextId ~= "" then
				local nx = self._T.skills[info.nextId]
				local nname = info.nextId
				if nx ~= nil then nname = nx.name end
				table.insert(notes, "<b><color=#8FBFFF>다음 차수 (" .. tostring(info.nextTier) .. "차)</color></b>  " .. nname .. self:Euro(nname) .. " 진화")
			end
			if (info.nextAwkId or "") ~= "" then
				local ax = self._T.skills[info.nextAwkId]
				local aname = ax ~= nil and ax.name or info.nextAwkId
				table.insert(notes, "<b><color=#8FBFFF>각성 " .. tostring(info.nextAwkStage) .. "단계</color></b>  " .. aname .. self:Euro(aname) .. " 강화")
			end
		end
		if #notes > 0 then
			if data.desc ~= "" then data.desc = data.desc .. "\n\n" end
			data.desc = data.desc .. table.concat(notes, "\n")
		end
		_TooltipLogic:ShowSkill(cell, data)
		log("[VRF] charui skill tip " .. tostring(i) .. " " .. (info.name or "") .. " next=" .. info.nextId)
	end

	@ExecSpace("ClientOnly")
	method void ShowBookTip(integer k)
		-- 경험의 서 툴팁: 이름·권당 경험치·보유 수.
		local book = self:E("Detail/Book" .. tostring(k))
		if not isvalid(book) then return end
		local roster = self:Roster()
		local names = {}
		if roster ~= nil then names = roster:Split(self.BookNames, ",") end
		local have = (self._T.bookHave or {})[k] or 0
		local per = (self._T.bookPer or {})[k] or 0
		_TooltipLogic:ShowText(book, names[k] or "경험의 서", "캐릭터 경험치 +" .. self:Comma(per) .. " (권당)\n보유 " .. self:Comma(have) .. "권")
	end

	-- ───────────────────────── 입력 ─────────────────────────

	@ExecSpace("ClientOnly")
	method void OnJobCard(integer n)
		-- 직업 선택: 상세를 바꾼다. 편성 밖의 해금된 직업이면 세 칸에 누르기 표시(같은 직업을 다시 누르면 취소). 편성 중·잠긴 직업은 표시 없음.
		local j = self._T.jobs[n]
		if j == nil then return end
		self._T.sel = j.id
		self._T.partySel = 0
		self._T.lockedSel = false
		local roster = self:Roster()
		local place = ""
		if roster ~= nil then
			local c = self:CharOf(roster:ParseCharData(roster.CharData), j.id)
			local inParty = false
			for _, pj in ipairs(self:Party()) do
				if pj == j.id then inParty = true end
			end
			if not c.unlocked then
				self._T.lockedSel = true
			elseif not inParty and self._T.placeJob ~= j.id then
				place = j.id
			end
		end
		self._T.placeJob = place
		log("[VRF] charui select " .. j.id .. " place=" .. place)
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void OnPartySlot(integer k)
		-- 편성 칸: 목록에서 고른 직업이 있으면 그 칸에 넣는다. 아니면 칸 선택 → 다른 칸 누름 = 자리 교환, 같은 칸 = 취소.
		self._T.lockedSel = false
		if self._T.placeJob ~= "" then
			local job = self._T.placeJob
			self._T.placeJob = ""
			self:SetParty(k, job)
			return
		end
		local sel = self._T.partySel
		if sel == k then
			self._T.partySel = 0
		elseif sel > 0 then
			self._T.partySel = 0
			self:SwapParty(sel, k)
			return
		else
			self._T.partySel = k
			local job = self:Party()[k]
			if self:JobById(job) ~= nil then self._T.sel = job end
		end
		log("[VRF] charui party slot sel=" .. tostring(self._T.partySel))
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void MarkPending(string action, string args)
		-- 요청 전송 기록: 결과가 오거나 3초가 지날 때까지 실행 버튼 비활성.
		local roster = self:Roster()
		if roster ~= nil then self._T.lastSeq = roster.RosterSeq end
		self._T.pendingAt = self._T.clock
		log("[VRF] charui request " .. action .. " " .. args)
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void OnLevel(boolean toMax)
		-- 1레벨업 / 최대 레벨업(관문까지).
		local roster = self:Roster()
		if roster == nil or self._T.pendingAt ~= nil then return end
		local c = self:CharOf(roster:ParseCharData(roster.CharData), self._T.sel)
		if not c.unlocked then return end
		local target = c.level + 1
		if toMax then target = roster:CapLevel(c.tier) end
		roster:RequestLevelTo(self._T.sel, target)
		self:MarkPending("level", self._T.sel .. " " .. tostring(target))
	end

	@ExecSpace("ClientOnly")
	method void OnPromote(boolean useCommon)
		-- 전직 (useCommon: 부족한 전용 카드를 공용 카드로).
		local roster = self:Roster()
		if roster == nil or self._T.pendingAt ~= nil then return end
		roster:RequestPromote(self._T.sel, useCommon)
		self:MarkPending("promote", self._T.sel .. " " .. tostring(useCommon))
	end

	@ExecSpace("ClientOnly")
	method void OnUnlock()
		-- 공용 카드 1장으로 해금.
		local roster = self:Roster()
		if roster == nil or self._T.pendingAt ~= nil then return end
		roster:RequestUnlockWithCommon(self._T.sel)
		self:MarkPending("unlock", self._T.sel)
	end

	@ExecSpace("ClientOnly")
	method void SwapParty(integer a, integer b)
		-- 두 편성 칸의 직업 자리 교환. 서버 편성 저장은 PlayerRoster.RequestSetParty.
		local roster = self:Roster()
		if roster == nil or self._T.pendingAt ~= nil then
			self:Refresh()
			return
		end
		local party = self:Party()
		party[a], party[b] = party[b], party[a]
		roster:RequestSetParty(party[1], party[2], party[3])
		self:MarkPending("party swap " .. tostring(a) .. "<->" .. tostring(b), party[1] .. "," .. party[2] .. "," .. party[3])
	end

	@ExecSpace("ClientOnly")
	method void SetParty(integer k, string job)
		-- 편성 밖 직업을 k번 칸에 넣는다 (원래 그 칸의 직업은 편성에서 빠짐).
		local roster = self:Roster()
		if roster == nil or self._T.pendingAt ~= nil then
			self:Refresh()
			return
		end
		local c = self:CharOf(roster:ParseCharData(roster.CharData), job)
		local party = self:Party()
		local inParty = false
		for _, pj in ipairs(party) do
			if pj == job then inParty = true end
		end
		if not c.unlocked or inParty then
			self:Refresh()
			return
		end
		party[k] = job
		self._T.sel = job
		roster:RequestSetParty(party[1], party[2], party[3])
		self:MarkPending("party place " .. tostring(k), party[1] .. "," .. party[2] .. "," .. party[3])
	end

	-- ───────────────────────── 결과 문구 ─────────────────────────

	@ExecSpace("ClientOnly")
	method void HandleResult(any roster)
		-- RosterMsg·RosterResult → 한국어 결과 문구. (전직 등 결과 뒤에는 스킬 탭을 현재 차수로 되돌린다)
		self._T.viewJob = ""
		local code = roster.RosterMsg
		local result = roster.RosterResult
		local f = roster:Split(result, ":")
		local action = f[1] or ""
		local job = f[2] or ""
		local msg = ""
		local good = string.sub(code, 1, 3) == "ok_"
		if code == "ok_level" then
			local a = f[3] or "?"
			local b = f[4] or "?"
			msg = "Lv." .. a .. " → Lv." .. b .. " 달성!"
			if f[5] ~= nil and f[5] ~= "" and (tonumber(f[4]) or 0) < (tonumber(f[5]) or 0) then msg = "경험의 서가 부족해 Lv." .. b .. "까지 올렸습니다" end
		elseif code == "ok_promote" then
			local name = roster:TierName(job, math.floor(tonumber(f[3]) or 1))
			msg = name .. self:Euro(name) .. " 전직했습니다!"
			local used = math.floor(tonumber(f[5]) or 0)
			if used > 0 then msg = msg .. " (공용 카드 " .. tostring(used) .. "장 사용)" end
		elseif code == "ok_unlock" then
			msg = roster:TierName(job, 4) .. " 해금!"
		elseif code == "ok_party" then
			msg = "편성을 저장했습니다"
		elseif code == "err_notready" then
			msg = "캐릭터 정보를 불러오는 중입니다"
		elseif code == "err_lobby" then
			msg = "로비에서만 할 수 있습니다"
		elseif code == "err_job" then
			msg = "알 수 없는 직업입니다"
		elseif code == "err_locked" then
			msg = "잠긴 직업입니다"
		elseif code == "err_unlocked" then
			msg = "이미 해금된 직업입니다"
		elseif code == "err_cap" then
			msg = "관문 레벨입니다. 전직하면 계속 성장합니다"
		elseif code == "err_max" then
			msg = "최고 레벨"
		elseif code == "err_books" then
			msg = "경험의 서가 부족합니다"
		elseif code == "err_level" then
			if action == "promote" then
				local c = self:CharOf(roster:ParseCharData(roster.CharData), job)
				msg = "전직 레벨(Lv." .. tostring(roster:CapLevel(c.tier)) .. ")에 도달해야 합니다"
			else
				msg = "이미 목표 레벨입니다"
			end
		elseif code == "err_cards" then
			if action == "unlock" then msg = "공용 전직 카드가 부족합니다" else msg = "전직 카드가 부족합니다" end
		elseif code == "err_party" then
			msg = "편성할 수 없습니다 (중복 또는 잠긴 직업)"
		end
		if msg ~= "" then
			local color = self.BadColor
			if good then color = self.GoodColor end
			self:ShowMsg(msg, color)
		end
		log("[VRF] charui result " .. code .. " " .. result)
	end

end
