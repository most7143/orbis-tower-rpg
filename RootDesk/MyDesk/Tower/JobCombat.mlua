			N12_B1 = { set = { extraStars = 3 } }, N12_B2 = { flag = "rapidCd" }, N12_B3 = { dur = 12 }, N12_B4 = { flag = "rapidMark" }, N12_B5 = { set = { speed = 70, extraStars = 0 } },
			N13_B1 = { proc = 16 }, N13_B2 = { dur = 15 }, N13_B3 = { flag = "bigSpear" }, N13_B4 = { set = { venom = 1 } }, N13_B5 = { flag = "spearEndMark" },
