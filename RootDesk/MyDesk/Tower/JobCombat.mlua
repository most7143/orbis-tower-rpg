		if self._T.brk ~= nil then return self._T.brk end
		self._T.brk = {
			N01_B1 = { cd = 3 }, N01_B2 = { echo = 60 }, N01_B3 = { set = { mark = 2 } }, N01_B4 = { set = { venom = 1 } }, N01_B5 = { flag = "jackpot" },
			N02_B1 = { set = { life = 10, lifeCap = 5 } }, N02_B2 = { cd = 3 }, N02_B3 = { dmg = 60 }, N02_B4 = { set = { bleed = 2 } }, N02_B5 = { flag = "thirst" },
			N03_B1 = { dmg = 60 }, N03_B2 = { mana = 9 }, N03_B3 = { hits = 4 }, N03_B4 = { recast = 55 }, N03_B5 = { set = { venom = 1 } },
