@Component
script JobCombat extends Component

	-- 직업 공용 전투 (나이트로드·보우마스터·바이퍼). TowerRunManager가 HeroCombat·BishopCombat과 같은 방식으로 부른다.
	-- 스킬 15종과 돌파 75종은 Spec()·Breaks() 데이터로 정의하고, 데이터로 못 쓰는 돌파만 ID별 코드로 처리한다.
	-- 고유 패시브 자원: 나이트로드 표식(몬스터마다), 보우마스터 강화 화살, 바이퍼 에너지.
	-- 메인 캐릭터에 붙으면 판 시작 때 JobId를 편성 직업으로 바꾼 뒤 BeginRun을 부른다.
	property string JobId = "NightLord"
	property number ManaStart = 30
	property number ManaRegen = 5
	property number ManaPerHit = 2
	property number HitNumGap = 0.18
	property number SoundVolume = 0.7
	-- 자원 획득 확률(%) (표식·강화 화살). 에너지는 타수마다 고정량.
	property number ResChance = 30
	property integer EnergyPerHit = 5
	-- 둔화 기본값: 공격 간격 +%, 지속(초) / 넉백 거리 / 넉백 면역(초)
	property number SlowPct = 30
	property number SlowTime = 4
	property number KnockDist = 0.6
	property number KnockImmune = 2
	-- 맹독: 중첩당 1초마다 공격력 %, 지속(초), 최대 중첩
	property number VenomPct = 8
	property number VenomTime = 6
	property integer VenomMax = 5
	-- 연출: 소환물이 없을 때 쓰는 기본 이펙트
	property string HealAffectedRUID = "ab42514ac987474289817c576332f67a"

	@Sync
	property boolean Active = false
	@Sync
	property number Mana = 0
	@Sync
	property number ManaMax = 100
	-- 고유 자원 (보우마스터 화살·바이퍼 에너지. 나이트로드는 맨 앞 몬스터 표식)
	@Sync
	property integer Res = 0
	@Sync
	property integer ResMax = 10
	@Sync
	property integer PassiveLv = 0
	@Sync
	property number SummonLeft = 0
	@Sync
	property string StatusText = ""
	@Sync
	property string SlotInfo = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 스킬표를 읽고 상태를 비운다 (JobId가 바뀌면 BeginRun에서 다시 읽는다).
		self:LoadSkills()
		self:ClearState()
		log("[VRF] JobCombat begin job=" .. self.JobId .. " skills=" .. tostring(self._T.skillCount or 0))
	end

	@ExecSpace("ServerOnly")
	method void LoadSkills()
		-- JobSkillTable(JobId) + SkillActionTable(연출)을 읽는다.
		self._T.skills = {}
		self._T.skillCount = 0
		self._T.loadedJob = self.JobId
		local acts = {}
		local at = _DataService:GetTable("SkillActionTable")
		if at ~= nil then
			for i = 1, at:GetRowCount() do
				acts[at:GetCell(i, "SkillId")] = { actionFrames = at:GetCell(i, "ActionFrames") or "", actionTime = tonumber(at:GetCell(i, "ActionTime")) or 0.6,
					casterFx = at:GetCell(i, "CasterFx") or "", fx = at:GetCell(i, "HitFx") or "", fxScale = tonumber(at:GetCell(i, "FxScale")) or 1, mobFx = at:GetCell(i, "MobFx") or "",
					policy = at:GetCell(i, "HitPolicy") or "per_hit", useSound = at:GetCell(i, "UseSound") or "", hitSound = at:GetCell(i, "HitSound") or "",
					gap = tonumber(at:GetCell(i, "HitGap")) or 0.12, targets = math.max(1, math.floor(tonumber(at:GetCell(i, "Targets")) or 1)) }
			end
		end
		local js = _DataService:GetTable("JobSkillTable")
		if js == nil then return end
		for i = 1, js:GetRowCount() do
			if js:GetCell(i, "JobId") == self.JobId then
				local id = js:GetCell(i, "SkillId")
				local function num(col) return tonumber(js:GetCell(i, col)) or 0 end
				local a = acts[id] or { actionFrames = "", actionTime = 0.6, casterFx = "", fx = "", fxScale = 1, mobFx = "", policy = "per_hit", useSound = "", hitSound = "", gap = 0.12, targets = 1 }
				self._T.skills[id] = { id = id, name = js:GetCell(i, "Name"), trigger = js:GetCell(i, "Trigger") or "Skill", cooldown = num("Cooldown"), buffTime = num("BuffTime"),
					mana = num("Mana"), chance = num("Chance"), pct = num("Pct"), hits = math.max(1, math.floor(num("ProcHits"))), a = a }
				self._T.skillCount = self._T.skillCount + 1
			end
		end
	end

	@ExecSpace("ServerOnly")
	method table Spec()
		-- 스킬 기본 효과. kind: strike(기본)/summon/buff/auto/guard/instinct. 타격 효과 필드는 맞은 몬스터마다 적용.
		-- slow·knock·stun{확률,초}·burn(확률)·venom(중첩)·mark(중첩)·bleed·dark(확률)·pull(마리)·atkDown{%,초}·life(흡혈%)·res(자원 추가)
		if self._T.spec ~= nil then return self._T.spec end
		self._T.spec = {
			N01 = { mark = 1 },
			N02 = { life = 5, lifeCap = 3 },
			N03 = { recast = 30 },
			N04 = { kind = "auto", partner = 30 },
			N05 = { kind = "summon", interval = 3, targets = 3 },
			N06 = { recast = 15, markLast = 1 },
			N07 = { venom = 2 },
			N08 = { atkDown = { 20, 6 } },
			N09 = { kind = "guard", hpLine = 40, stealth = 2 },
			N10 = { useMarks = 20 },
			N11 = { kind = "buff", toxin = true },
			N12 = { kind = "buff", speed = 40, extraStars = 2, extraPct = 25 },
			N13 = { kind = "instinct", procTargets = 1 },
			N14 = { linger = 6, lingerPct = 80, lingerGap = 0.5 },
			N15 = { channel = true, finisher = 180, reduce = 50 },
			A01 = { slow = true },
			A02 = { stun = { 30, 1 } },
			A03 = { burn = 100, burnBonus = 20 },
			A04 = { kind = "summon", interval = 3, targets = 3, burn = 30 },
			A05 = { kind = "summon", interval = 1.5, targets = 2, knockEvery = 5 },
			A06 = { channel = true, reduce = 20 },
			A07 = { knock = true },
			A08 = { kind = "auto", crit = 15, critDmg = 10 },
			A09 = { kind = "guard", hpLine = 40, evade = 60 },
			A10 = { kind = "buff", rain = true, interval = 1, targets = 6, slow = true },
			A11 = { kind = "buff", atk = 20, extraTargets = 1 },
			A12 = { useArrows = true },
			A13 = { kind = "instinct", procTargets = 2 },
			A14 = { echoHits = 3, echoPct = 80, slow = true },
			A15 = { channel = true, finisher = 300 },
			V01 = { res = 5 },
			V02 = { stun = { 30, 1 } },
			V03 = { pullLast = 1 },
			V04 = { useEnergy = 20, stunAt = 50, stunSec = 1.5 },
			V05 = { kind = "buff", reduce = 20, atk = 15, transform = true },
			V06 = { pull = 2 },
			V07 = { stunLast = 1 },
			V08 = { kind = "buff", timeLeap = 50 },
			V09 = { kind = "guard", hpLine = 40, healPct = 20, reduce = 30 },
			V10 = { kind = "auto", energyTick = 8 },
			V11 = { atkDown = { 20, 6 } },
			V12 = { stunAll = 1 },
			V13 = { kind = "instinct", procTargets = 2, reduce = 10 },
			V14 = { kind = "buff", dash = 150, dashTargets = 3, reduce = 15 },
			V15 = { channel = true, finisher = 400, useEnergyN = 50, partyReduce = 20 },
		}
		return self._T.spec
	end

