			N06_B1 = { hits = 6 }, N06_B2 = { recast = 35 }, N06_B3 = { actionMul = 0.67 }, N06_B4 = { flag = "exposeCrit" }, N06_B5 = { mana = 12, cd = 6 },
			N07_B1 = { dmg = 60 }, N07_B2 = { set = { venom = 4 } }, N07_B3 = { mana = 7, cd = 3 }, N07_B4 = { set = { venomMaxAdd = 5 } }, N07_B5 = { flag = "fatalVenom" },
			N08_B1 = { dmg = 60 }, N08_B2 = { set = { markFull = true } }, N08_B3 = { set = { dark = 100 } }, N08_B4 = { set = { expBuff = 50 } }, N08_B5 = { set = { duelVuln = 20 } },
			N09_B1 = { set = { stealth = 4 } }, N09_B2 = { flag = "ambush" }, N09_B3 = { set = { stealthHeal = 5 } }, N09_B4 = { cd = 15 }, N09_B5 = { set = { hpLine = 60 } },
			N10_B1 = { flag = "seasons" }, N10_B2 = { set = { execute = 0.15 } }, N10_B3 = { set = { useMarks = 35 } }, N10_B4 = { mana = 15, cd = 4 }, N10_B5 = { set = { bleed = 3 } },
