@Component
script TowerProjectile extends Component

	-- 원거리 기본 공격 발사체 (나이트로드 표창·비숍 에너지 볼트). 서버에서 몬스터를 향해 날아가 닿으면 주인(TowerPlayer)에게 타격을 넘기고 사라진다.
	-- 몸체가 없는 엔티티라 위치를 직접 옮긴다 (매 프레임, 속도 × delta).
	property number Speed = 11
	-- 초당 회전(도). 표창은 돌고, 에너지 볼트는 0
	property number SpinPerSec = 0
	-- 닿았다고 볼 거리
	property number HitDist = 0.25
	-- 최대 비행 시간(초): 대상이 없어지면 이 시간 뒤 사라진다
	property number MaxLife = 2.5

	@ExecSpace("ServerOnly")
	method void Launch(Component owner, integer seq, Entity target, string ruid, number spin)
		-- 발사: 주인·타격 번호·대상·그림을 정한다.
		self._T.owner = owner
		self._T.seq = seq
		self._T.target = target
		self._T.life = 0
		self._T.done = false
		self.SpinPerSec = spin
		local sprite = self.Entity.SpriteRendererComponent
		if isvalid(sprite) then sprite.SpriteRUID = ruid end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 대상(몬스터 몸 가운데)을 향해 날아가고, 닿거나 시간이 다 되면 타격을 넘기고 사라진다.
		if self._T.done or self._T.owner == nil then return end
		self._T.life = (self._T.life or 0) + delta
		local tf = self.Entity.TransformComponent
		local target = self._T.target
		local tm = isvalid(target) and target:GetComponent("script.TowerMonster") or nil
		if tm == nil or self._T.life >= self.MaxLife then
			self:Finish()
			return
		end
		local tp = target.TransformComponent.WorldPosition
		local goal = Vector3(tp.x, tp.y + 0.4 * target.TransformComponent.Scale.y, tf.WorldPosition.z)
		local cur = tf.WorldPosition
		local dx = goal.x - cur.x
		local dy = goal.y - cur.y
		local dist = math.sqrt(dx * dx + dy * dy)
		local step = self.Speed * delta
		if dist <= math.max(self.HitDist, step) then
			self:Finish()
			return
		end
		tf.WorldPosition = Vector3(cur.x + dx / dist * step, cur.y + dy / dist * step, cur.z)
		if self.SpinPerSec ~= 0 then tf.ZRotation = tf.ZRotation - self.SpinPerSec * delta end
	end

	@ExecSpace("ServerOnly")
	method void Finish()
		-- 닿음: 주인에게 타격 적용을 맡기고 엔티티 제거.
		if self._T.done then return end
		self._T.done = true
		local owner = self._T.owner
		if owner ~= nil and isvalid(owner.Entity) then owner:ApplyProjectileHit(self._T.seq) end
		self.Entity:Destroy()
	end

end
