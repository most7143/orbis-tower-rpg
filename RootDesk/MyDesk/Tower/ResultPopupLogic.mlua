@Logic
script ResultPopupLogic extends Logic

	-- 결과 화면 (ResultPopup Root/Result2): 누적 별·신규 별, 전투 시간·남은 체력, 별 미션 결과, 전투 보상, 구간 보상 직접 수령, 지역 선택으로·다시 도전.
	-- 별 판정·저장·보상 지급은 서버(TowerRunManager·PlayerEngrave)가 하고, 여기서는 표시와 요청만 한다.
	property Entity popupRoot = "77c3b0ad-3691-4ce2-80f2-b1794fa3dd26"
	property string Base = "/ui/ResultPopup/Root/Result2"
	property string OldPanel = "/ui/ResultPopup/Root/Panel"
	property integer SectionSize = 10
	property string SectionThresholds = "10|20|30"
	property string StarFilled = "eb887abdd8834b78a419c3735cf43463"
	property string StarEmpty = "1388fa0aaf29410dbd0cf148eed14d9d"
	property string StarNew = "9367768f9ece4d88a133cf9145710988"
	property string ChestClaimed = "88bbe8bb3d9e4116868796ba3b2e34d8"
	property string ChestLocked = "1cc85aefbfdb4f07b2b9d4da3e3a4fd2"
	property string ChestReward = "7269636979ec41ebaf1828601e572c30"
	property string TileNormal = "a88cfe62e8e64c39bf14d682a77ef4a0"
	property string TileDisabled = "d262f8e8502e4b7b88f381a9b7a4e4fb"
	property string IconBook = "d0bb7509b8a54712ac2647d7ede2ad5f"
	property string IconFeather = "804a3c5f7abe4ad48f6e428e112da0a5"
	property string IconScroll = "d7d18132057f491181288c2b6038d32c"
	property string IconDiamond = "81462aeb825b4660991cef05651271cf"
	property string IconGoldMeso = "02a489cccff24a139a6c3582a5871f58"
	property integer LootSlots = 7

	@HideFromInspector
	property table handlers = {}

	@ExecSpace("ClientOnly")
	method Entity E(string sub)
		-- 결과 화면 안 엔티티.
		return _EntityService:GetEntityByPath(self.Base .. "/" .. sub)
	end

	@ExecSpace("ClientOnly")
	method void OnClick(string sub, any fn)
		-- 버튼 클릭 연결 (클릭음 포함).
		local e = self:E(sub)
		if not isvalid(e) then return end
		local h = e:ConnectEvent(ButtonClickEvent, function() _UISoundLogic:PlayClick() fn() end)
		table.insert(self.handlers, { e = e, h = h })
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결. 처음엔 숨긴다.
		self.handlers = {}
		self:OnClick("resultBack", function() self:OnBackToSelect() end)
		self:OnClick("retry", function() self:OnRetry() end)
		for i = 0, 2 do
			local tier = i + 1
			self:OnClick("resultChestTile" .. tostring(i), function() self:Claim(tier) end)
		end
		if isvalid(self.popupRoot) then self.popupRoot:SetEnable(false) end
		local old = _EntityService:GetEntityByPath(self.OldPanel)
		if isvalid(old) then old:SetEnable(false) end
		log("[VRF] ResultPopupLogic begin handlers=" .. tostring(#self.handlers))
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 버튼 이벤트 해제.
		for _, r in ipairs(self.handlers) do
			if isvalid(r.e) then r.e:DisconnectEvent(ButtonClickEvent, r.h) end
		end
		self.handlers = {}
	end

	@ExecSpace("ClientOnly")
	method Component GetManager()
		-- 현재 맵의 탑 진행 매니저.
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) then return nil end
		return player.CurrentMap:GetComponent("script.TowerRunManager")
	end

	@ExecSpace("ClientOnly")
	method Component Engrave()
		-- 로컬 플레이어 저장 정보.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return nil end
		return player:GetComponent("script.PlayerEngrave")
	end

	@ExecSpace("ClientOnly")
	method void SetText(string sub, string text, Color color)
		-- 글자 바꾸기 (색 nil이면 그대로).
		local e = self:E(sub)
		if not isvalid(e) then return end
		local t = e.TextGUIRendererComponent
		if t.Text ~= text then t.Text = text end
		if color ~= nil then t.FontColor = color end
	end

	@ExecSpace("ClientOnly")
	method void SetImage(string sub, string ruid)
		-- 그림 바꾸기 (빈 값이면 숨김).
		local e = self:E(sub)
		if not isvalid(e) then return end
		if ruid == "" then
			if e.Enable then e:SetEnable(false) end
			return
		end
		if not e.Enable then e:SetEnable(true) end
		if e.SpriteGUIRendererComponent.ImageRUID.DataId ~= ruid then e.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid) end
	end

	@ExecSpace("ClientOnly")
	method void Show(string sub, boolean on)
		-- 켜고 끄기.
		local e = self:E(sub)
		if isvalid(e) and e.Enable ~= on then e:SetEnable(on) end
	end

	@ExecSpace("ClientOnly")
	method integer StarCount(integer bits)
		-- 비트 안 별 개수.
		local n = 0
		if bits & 1 ~= 0 then n = n + 1 end
		if bits & 2 ~= 0 then n = n + 1 end
		if bits & 4 ~= 0 then n = n + 1 end
		return n
	end

	@ExecSpace("ClientOnly")
	method integer Threshold(integer tier)
		-- 구간 상자 기준 별.
		local i = 0
		for v in string.gmatch(self.SectionThresholds, "[^|]+") do
			i = i + 1
			if i == tier then return math.floor(tonumber(v) or 0) end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method string FloorName(integer floor)
		-- 층(지역) 이름.
		local ft = _DataService:GetTable("FloorTable")
		if ft ~= nil and floor >= 1 and floor <= ft:GetRowCount() then return ft:GetCell(floor, "FloorName") or "" end
		return tostring(floor) .. "층"
	end

	@ExecSpace("ClientOnly")
	method void Fill(Component mgr)
		-- 결과 한 번 채우기 (보이기 시작할 때).
		local floor = mgr.ResultFloor
		local prev = mgr.ResultStarsPrev
		local now = mgr.ResultStarsNow
		local gained = now & (~prev)
		local clear = mgr.IsStageClear
		self._T.floor = floor
		self._T.gained = gained
		self:SetText("resultTitle", self:FloorName(floor) .. (clear and " 클리어!" or " 도전 실패"), nil)
		-- 보스 개편 B5: 보스전 결과는 보스 이름·단계, 별·미션·구간 보상 칸은 숨긴다
		local bossRun = mgr.RunMode == "boss"
		self._T.bossRun = bossRun
		if bossRun then self:SetText("resultTitle", self:BossName(mgr.BossRunId) .. " " .. tostring(mgr.BossRunStep) .. "단계" .. (clear and " 처치!" or " 실패"), nil) end
		for _, k in ipairs({ "largeStar0", "largeStar1", "largeStar2", "resultMissions", "resultSectionPanel", "resultSectionPlaque", "resultSectionCount", "resultSectionGauge", "resultChestTile0", "resultChestTile1", "resultChestTile2" }) do
			self:Show(k, not bossRun)
		end
		self:BossLayout(bossRun, mgr.BossRunId)
		-- 큰 별: 누적 달성, 이번에 새로 얻은 별은 반짝이는 그림
		for j = 0, 2 do
			local b = 1 << j
			local ruid = self.StarEmpty
			if gained & b ~= 0 then ruid = self.StarNew elseif now & b ~= 0 then ruid = self.StarFilled end
			self:SetImage("largeStar" .. tostring(j), ruid)
		end
		local newCount = self:StarCount(gained)
		self:Show("newStarBadge", newCount > 0 and not bossRun)
		if bossRun then
			for j = 0, 2 do self:Show("largeStar" .. tostring(j), false) end
		end
		self:SetText("newStarBadge/newStarCount", "신규 별 +" .. tostring(newCount), nil)
		local t = math.floor(mgr.ResultTime)
		self:SetText("combatTimePill/combatTime", string.format("전투 시간  %02d:%02d", math.floor(t / 60), t % 60), nil)
		self:SetText("remainingHpPill/remainingHp", "남은 체력  " .. tostring(mgr.ResultHpPct) .. "%", nil)
		-- 미션 결과: 기존 달성 / 새로 달성 / 미달성
		local names = { "스테이지 클리어", "제한 시간 내 클리어", "체력 50% 이상으로 클리어" }
		for j = 0, 2 do
			local b = 1 << j
			local state = "미달성"
			local color = Color(0.42, 0.46, 0.51, 1)
			if gained & b ~= 0 then
				state = "새로 달성"
				color = Color(0.20, 0.48, 0.12, 1)
			elseif prev & b ~= 0 then
				state = "기존 달성"
			end
			local p = "resultMissions/resultMission"
			self:SetText(p .. "Text" .. tostring(j), names[j + 1], nil)
			self:SetText(p .. "State" .. tostring(j), state, color)
			self:SetImage(p .. "Star" .. tostring(j), now & b ~= 0 and self.StarFilled or self.StarEmpty)
		end
		-- 전투 보상: 실제로 받은 것만
		self:SetText("battleRewardsPlaque/battleRewardsTitle", "전투 보상", nil)
		local items = {}
		-- 금색 메소(아웃게임 재화)를 맨 앞에. 스킬북은 보상에서 제거되어 표시하지 않는다.
		if mgr.RunGoldMeso > 0 then table.insert(items, { icon = self.IconGoldMeso, name = "금색 메소", n = mgr.RunGoldMeso, center = true }) end
		if mgr.RunDiamonds > 0 then table.insert(items, { icon = self.IconDiamond, name = "다이아", n = mgr.RunDiamonds }) end
		if mgr.RunFeathers > 0 then table.insert(items, { icon = self.IconFeather, name = "깃털", n = mgr.RunFeathers }) end
		if mgr.RunScrolls > 0 then table.insert(items, { icon = self.IconScroll, name = "주문서", n = mgr.RunScrolls }) end
		-- 보스전 경험의 서 (BossResult "id:step:gold:s:m:l:...")
		if bossRun and mgr.BossResult ~= "" then
			local v = {}
			for x in string.gmatch(mgr.BossResult, "[^:]+") do table.insert(v, x) end
			local books = { { 4, "36ba7694f9444257837ff68207fff885", "경험의 서(소)" }, { 5, "452037cbd8f04bdf810657263aff002b", "경험의 서(중)" }, { 6, "67933b35ef074d58893c1710edeed7f6", "경험의 서(대)" } }
			for _, bk in ipairs(books) do
				local cnt = math.floor(tonumber(v[bk[1]] or "0") or 0)
				if cnt > 0 then table.insert(items, { icon = bk[2], name = bk[3], n = cnt, center = true }) end
			end
		end
		-- 5-F: 이번 판 큐브 (레드 / 무료). 아이콘·이름은 GearCubeTable (PlayerGear.CubeInfo)
		if mgr.RunCubes > 0 then table.insert(items, self:CubeItem("R", "레드 큐브", mgr.RunCubes)) end
		if mgr.RunFreeCubes > 0 then table.insert(items, self:CubeItem("F", "무료 큐브", mgr.RunFreeCubes)) end
		-- 보상 칸은 최대 7개(Loot0~6, 계정 경험치 영역 왼쪽 112 간격). Loot7은 쓰지 않는다.
		for k = 0, 7 do
			local it = items[k + 1]
			if k >= self.LootSlots then it = nil end
			local p = "LootView/Loot" .. tostring(k)
			self:Show(p, it ~= nil)
			if it ~= nil then
				self:SetImage(p .. "/Loot" .. tostring(k) .. "Icon", it.icon)
				-- 다이아 스프라이트는 피벗이 가운데가 아니라 AspectOnly에서 위로 밀린다 → 다이아만 None (칸 재사용이라 매번 되돌림)
				local iconEnt = self:E(p .. "/Loot" .. tostring(k) .. "Icon")
				if isvalid(iconEnt) then
					local spr = iconEnt.SpriteGUIRendererComponent
					local want = PreserveSpriteType.AspectOnly
					if it.icon == self.IconDiamond or it.cube == true or it.center == true then want = PreserveSpriteType.None end
					if spr.PreserveSprite ~= want then spr.PreserveSprite = want end
				end
				self:SetText(p .. "/Loot" .. tostring(k) .. "Count", "x" .. tostring(it.n), nil)
				self:SetText(p .. "/Loot" .. tostring(k) .. "Name", it.name, nil)
			end
		end
		self._T.lootCount = #items
		self:FillSection()
		self:SetText("resultBack/resultBackText", "지역 선택으로", nil)
		self:SetText("retry/retryText", "다시 도전", nil)
		self._T.accountBar = nil
		self._T.revealT = 0
		-- 늦게 도착한 Sync 값 반영용: 마지막으로 채운 키
		self._T.fillKey = tostring(floor) .. ":" .. tostring(prev) .. ":" .. tostring(now) .. ":" .. tostring(clear)
		log("[VRF] result fill floor=" .. tostring(floor) .. " clear=" .. tostring(clear) .. " prev=" .. tostring(prev) .. " now=" .. tostring(now) .. " loot=" .. tostring(#items))
	end

	@ExecSpace("ClientOnly")
	method void BossLayout(boolean bossRun, string bossId)
		-- 보스전 결과: 별 자리에 보스 그림, 보상 묶음을 위로 당겨 빈 공간을 줄인다 (일반 결과는 원래 자리). 다시 도전 비용 아이콘 = 도전권.
		if self._T.basePos == nil then
			self._T.basePos = {}
			for _, k in ipairs({ "battleRewardsPlaque", "battleRewardsPanel", "LootView", "AccountExp" }) do
				local e = self:E(k)
				if isvalid(e) then self._T.basePos[k] = e.UITransformComponent.anchoredPosition end
			end
		end
		for k, p in pairs(self._T.basePos) do
			local e = self:E(k)
			if isvalid(e) then e.UITransformComponent.anchoredPosition = bossRun and Vector2(p.x, p.y + 100) or p end
		end
		local art = self:E("BossArt")
		if isvalid(art) then
			local stand = ""
			if bossRun then
				local t = _DataService:GetTable("BossTable")
				if t ~= nil then
					for i = 1, t:GetRowCount() do
						if t:GetCell(i, "BossId") == bossId then stand = t:GetCell(i, "StandRUID") or "" end
					end
				end
			end
			art:SetEnable(stand ~= "")
			if stand ~= "" then art.SpriteGUIRendererComponent.ImageRUID = "thumbnail://" .. stand end
		end
		local icon = self:E("retry/retryCostIcon")
		if isvalid(icon) then
			local want = bossRun and "7e932b7340f74fba8372c5b217f93000" or "3d5c35546d4944598ed6e1be129ff12b"
			if icon.SpriteGUIRendererComponent.ImageRUID.DataId ~= want then icon.SpriteGUIRendererComponent.ImageRUID = DataRef(want) end
		end
	end

	@ExecSpace("ClientOnly")
	method string BossName(string bossId)
		-- 보스 표 이름.
		local t = _DataService:GetTable("BossTable")
		if t ~= nil then
			for i = 1, t:GetRowCount() do
				if t:GetCell(i, "BossId") == bossId then return t:GetCell(i, "Name") or bossId end
			end
		end
		return bossId
	end

	@ExecSpace("ClientOnly")
	method table CubeItem(string kind, string fallbackName, integer n)
		-- 5-F: 결과 보상 줄 하나 (큐브). 표 행이 없으면 주문서 아이콘·기본 이름.
		local icon = self.IconScroll
		local name = fallbackName
		local p = _UserService.LocalPlayer
		local gear = isvalid(p) and p:GetComponent("script.PlayerGear") or nil
		if gear ~= nil then
			local info = gear:CubeInfo(kind)
			if info ~= nil then
				if info.icon ~= nil and info.icon ~= "" then icon = info.icon end
				if info.name ~= nil and info.name ~= "" then name = info.name end
			end
		end
		return { icon = icon, name = name, n = n, cube = true }
	end

	@ExecSpace("ClientOnly")
	method void FillSection()
		-- 구간 보상: 누적 별(이번 판 전 → 지금), 게이지, 상자 3개 상태.
		local eng = self:Engrave()
		local floor = self._T.floor or 1
		local section = math.floor((floor - 1) / self.SectionSize) + 1
		local total = 0
		local claimed = 0
		if eng ~= nil then
			for f, b in string.gmatch(eng.StarData, "(%d+):(%d+)") do
				local fl = math.floor(tonumber(f))
				if math.floor((fl - 1) / self.SectionSize) + 1 == section then total = total + self:StarCount(math.floor(tonumber(b))) end
			end
			for s, b in string.gmatch(eng.SectionData, "(%d+):(%d+)") do
				if math.floor(tonumber(s)) == section then claimed = math.floor(tonumber(b)) end
			end
		end
		local before = total - self:StarCount(self._T.gained or 0)
		local maxStars = self:Threshold(3)
		self:SetText("resultSectionPlaque/resultSectionTitle", "구간별 보상", nil)
		if (self._T.msgTime or 0) <= 0 then
			if before ~= total then
				self:SetText("resultSectionCount", "누적 별  " .. tostring(before) .. " → " .. tostring(total) .. " / " .. tostring(maxStars), nil)
			else
				self:SetText("resultSectionCount", "누적 별  " .. tostring(total) .. " / " .. tostring(maxStars), nil)
			end
		end
		local fill = self:E("resultSectionGauge/resultSectionFill")
		if isvalid(fill) then fill.SpriteGUIRendererComponent.FillAmount = math.max(0, math.min(1, total / math.max(1, maxStars))) end
		for i = 0, 2 do
			local need = self:Threshold(i + 1)
			local got = (claimed & (1 << i)) ~= 0
			local ready = not got and total >= need
			local p = "resultChestTile" .. tostring(i)
			local tile = self:E(p)
			if isvalid(tile) then
				tile.ButtonComponent.Enable = ready and not self._T.claiming
				tile.SpriteGUIRendererComponent.ImageRUID = DataRef(ready and self.TileNormal or self.TileDisabled)
			end
			self:SetImage(p .. "/resultChestIcon" .. tostring(i), got and self.ChestClaimed or (ready and self.ChestReward or self.ChestLocked))
			self:SetText(p .. "/resultThreshold" .. tostring(i), tostring(need), nil)
			self:Show(p .. "/Ready" .. tostring(i), ready)
			self:Show(p .. "/ClaimBody" .. tostring(i), ready)
			local label = ready and "보상 받기" or (got and "수령 완료" or "잠김")
			self:SetText(p .. "/resultClaimLabel" .. tostring(i), label, ready and Color(0.282, 0.157, 0.075, 1) or Color(0.42, 0.46, 0.51, 1))
		end
		self._T.section = section
	end

	@ExecSpace("ClientOnly")
	method string ClaimText(string msg)
		-- 3번째 별 상자 수령 성공이면 다이아 안내를 덧붙인다 (실제 지급은 PlayerRoster가 1초 안에 함).
		if self._T.claimTier ~= 3 or string.sub(msg, 1, string.len("보상 획득")) ~= "보상 획득" then return msg end
		local dia = 300
		local p = _UserService.LocalPlayer
		if isvalid(p) then
			local roster = p:GetComponent("script.PlayerRoster")
			if roster ~= nil then dia = math.floor(roster:Cfg("SectionLastDia", 300)) end
		end
		return msg .. " · 다이아 +" .. tostring(dia)
	end

	@ExecSpace("ClientOnly")
	method void Claim(integer tier)
		-- 상자 수령 요청 (서버 판정·지급, 응답 전 중복 요청 막음).
		if self._T.claiming then return end
		local eng = self:Engrave()
		if eng == nil or self._T.section == nil then return end
		self._T.claiming = true
		self._T.claimSeq = eng.ClaimSeq
		self._T.claimTier = tier
		self._T.claimTimeout = 5
		eng:RequestClaimSection(self._T.section, tier)
		self:FillSection()
	end

	@ExecSpace("ClientOnly")
	method void Message(string msg)
		-- 구간 보상 줄에 잠깐 안내.
		self:SetText("resultSectionCount", msg, nil)
		self._T.msgTime = 2.5
	end

	@ExecSpace("ClientOnly")
	method void OnRetry()
		-- 다시 도전 (에너지 3, 서버가 차감).
		local mgr0 = self:GetManager()
		-- 보스전: 에너지 대신 도전권(서버가 검사)
		if mgr0 ~= nil and mgr0.RunMode == "boss" then
			if mgr0.ResultAccountSaved then mgr0:RequestRetry() end
			log("[VRF] boss retry clicked")
			return
		end
		local eng = self:Engrave()
		if eng == nil or not eng.EnergyLoaded then self:Message("입장 에너지를 불러오는 중입니다") return end
		if eng.Energy < eng.EnergyCost then self:Message("입장 에너지가 부족합니다") return end
		local mgr = self:GetManager()
		if mgr ~= nil and mgr.ResultAccountSaved then mgr:RequestRetry() end
		log("[VRF] retry clicked")
	end

	@ExecSpace("ClientOnly")
	method void OnBackToSelect()
		-- 지역 선택으로: 로비로 돌아간 뒤 방금 지역을 고른 채 지역 선택 화면을 연다.
		local mgr = self:GetManager()
		if mgr == nil then return end
		if _RegionSelectLogic ~= nil then _RegionSelectLogic.PendingOpenFloor = math.max(1, self._T.floor or mgr.ResultFloor) end
		-- 보스전이면 지역 선택을 보스 탭으로 연다
		if _RegionSelectLogic ~= nil then _RegionSelectLogic.PendingBossTab = mgr.RunMode == "boss" end
		_ScreenFadeLogic:FadeOut(function() mgr:RequestLobby() end)
		log("[VRF] back to region select floor=" .. tostring(self._T.floor))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 판 상태가 RESULT일 때만 결과 화면을 띄운다. 등장 연출·수령 응답·에너지 표시.
		if not isvalid(self.popupRoot) then return end
		local mgr = self:GetManager()
		local show = mgr ~= nil and mgr.RunState == "RESULT"
		if self.popupRoot.Enable ~= show then
			self.popupRoot:SetEnable(show)
			local old = _EntityService:GetEntityByPath(self.OldPanel)
			if isvalid(old) then old:SetEnable(false) end
			local root = _EntityService:GetEntityByPath(self.Base)
			if isvalid(root) then root:SetEnable(show) end
			if show then
				self._T.claiming = false
				self:Fill(mgr)
				log("[VRF] result screen shown floor=" .. tostring(mgr.ResultFloor))
			end
		end
		if not show then return end
		-- 결과 값(층·별·클리어)이 채운 뒤 바뀌었으면(늦은 Sync) 다시 채운다
		local key = tostring(mgr.ResultFloor) .. ":" .. tostring(mgr.ResultStarsPrev) .. ":" .. tostring(mgr.ResultStarsNow) .. ":" .. tostring(mgr.IsStageClear)
		if key ~= self._T.fillKey then
			log("[VRF] result refill key=" .. key)
			self:Fill(mgr)
		end
		-- 다시 도전 비용
		local eng = self:Engrave()
		local cost = eng ~= nil and eng.EnergyCost or 3
        local accountLine = "계정 경험치 저장 재시도 중"
        if mgr.ResultAccountSaved and eng ~= nil then
            accountLine = "계정 EXP +" .. tostring(mgr.ResultAccountExp) .. "   Lv." .. tostring(mgr.ResultAccountBeforeLevel)
            if mgr.ResultAccountAfterLevel > mgr.ResultAccountBeforeLevel then accountLine = accountLine .. " → " .. tostring(mgr.ResultAccountAfterLevel) end
            if eng.AccountLevel >= 100 then accountLine = accountLine .. "  MAX" end
        end
        -- 4-G 보완: 디버그 판은 계정 경험치·판 보상을 저장하지 않으므로 그 사실만 알린다
        if mgr.ResultDebugRun then accountLine = "테스트 판: 저장 안 됨" end
        self:SetText("AccountExp/Value",accountLine,nil)
        if mgr.ResultDebugRun then
            self:SetText("AccountExp/Effect","계정 경험치·보상·기록을 저장하지 않았습니다",nil)
        elseif eng ~= nil and mgr.ResultAccountSaved then
            local gainedLevels = mgr.ResultAccountAfterLevel - mgr.ResultAccountBeforeLevel
            local effectLine=eng.AccountLevel>=100 and "최고 레벨 달성" or (tostring(eng.AccountExp) .. " / " .. tostring(eng.AccountNeed) .. " EXP")
            if gainedLevels==1 then effectLine=_AccountRules:RewardText(mgr.ResultAccountAfterLevel)
            elseif gainedLevels>1 then
                local count=0
                for lv=mgr.ResultAccountBeforeLevel+1,mgr.ResultAccountAfterLevel do count=count+#_AccountRules:Rewards(lv) end
                effectLine="레벨 +" .. tostring(gainedLevels) .. " · 효과 " .. tostring(count) .. "개 획득"
            end
            self:SetText("AccountExp/Effect",effectLine,nil)
            local target = eng.AccountLevel >= 100 and 1 or eng.AccountExp / math.max(1,eng.AccountNeed)
            if self._T.accountBar == nil then self._T.accountBar = gainedLevels > 0 and 0 or mgr.ResultAccountBeforeExp / math.max(1,mgr.ResultAccountBeforeNeed) end
            self._T.accountBar = self._T.accountBar + (target - self._T.accountBar) * math.min(1,delta*5)
            local af = self:E("AccountExp/Bar/Fill")
            -- 채움 최대 폭 = 막대 폭 - 12 (결과 보상 7칸 배치로 막대를 340으로 줄임)
            local barEnt = self:E("AccountExp/Bar")
            local inner = 460
            if isvalid(barEnt) then inner = math.max(1, barEnt.UITransformComponent.RectSize.x - 12) end
            if isvalid(af) then af.UITransformComponent.RectSize = Vector2(math.max(1,inner*self._T.accountBar),14) end
        end
        local retry = self:E("retry")
        if isvalid(retry) then retry.ButtonComponent.Enable = mgr.ResultAccountSaved and eng ~= nil and eng.EnergyLoaded and eng.Energy >= cost end
        -- 보스전: 다시 도전은 도전권이 남았을 때만 (차감은 클리어 때)
        local pbr = nil
        if mgr.RunMode == "boss" then
            local lp = _UserService.LocalPlayer
            pbr = isvalid(lp) and lp:GetComponent("script.PlayerBoss") or nil
            if isvalid(retry) then retry.ButtonComponent.Enable = mgr.ResultAccountSaved and pbr ~= nil and (pbr.TicketsLeft > 0 or mgr.ResultDebugRun) end
        end
        local back = self:E("resultBack")
        if isvalid(back) then back.ButtonComponent.Enable = mgr.ResultAccountSaved end
		if pbr ~= nil then
			self:SetText("retry/retryCost", tostring(pbr.TicketsLeft) .. "/" .. tostring(pbr.TicketMax), nil)
		else
			self:SetText("retry/retryCost", "에너지 " .. tostring(cost), nil)
		end
		-- 등장: 큰 별이 차례로 커지며 나타남, 새 별은 더 크게 튀어나옴
		if self._T.revealT ~= nil then
			self._T.revealT = self._T.revealT + delta
			local t = self._T.revealT
			for j = 0, 2 do
				local e = self:E("largeStar" .. tostring(j))
				if isvalid(e) then
					local u = math.max(0, math.min(1, (t - 0.15 - j * 0.18) / 0.3))
					local isNew = ((self._T.gained or 0) & (1 << j)) ~= 0
					local over = isNew and 0.35 or 0.12
					local sc = u <= 0 and 0 or (u < 0.7 and (u / 0.7) * (1 + over) or (1 + over) - over * ((u - 0.7) / 0.3))
					e.UITransformComponent.UIScale = Vector3(sc, sc, 1)
				end
			end
			if t > 1.2 then self._T.revealT = nil end
		end
		if self._T.claiming then
			self._T.claimTimeout = (self._T.claimTimeout or 0) - delta
			if eng ~= nil and eng.ClaimSeq ~= self._T.claimSeq then
				self._T.claiming = false
				self:Message(self:ClaimText(eng.ClaimMsg))
				self:FillSection()
			elseif self._T.claimTimeout <= 0 then
				self._T.claiming = false
				self:Message("응답이 없습니다. 다시 시도해 주세요")
				self:FillSection()
			end
		end
		if (self._T.msgTime or 0) > 0 then
			self._T.msgTime = self._T.msgTime - delta
			if self._T.msgTime <= 0 then self:FillSection() end
		end
	end

end
