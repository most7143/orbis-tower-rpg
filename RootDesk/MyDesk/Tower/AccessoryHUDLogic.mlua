@Logic
script AccessoryHUDLogic extends Logic

	-- 하단 구성원 패널의 장신구 칸 3개(반지·펜던트·귀고리) 아이콘과 툴팁.
	-- PC는 마우스를 올리면 툴팁, 누르면 고정/해제. 장착 정보는 매니저의 AccessoryJson (WorkshopUILogic과 같은 형식).
	property string MembersPath = "/ui/BattleHUD/Members"
	property string TipPath = "/ui/BattleHUD/AccTip"

	@HideFromInspector
	property table handlers = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 칸 이벤트 연결.
		self._T.slots = { "Ring", "Pendant", "Earring" }
		self._T.slotNames = { Ring = "반지", Pendant = "펜던트", Earring = "귀고리" }
		self._T.hover = nil
		self._T.pin = nil
		self._T.key = nil
		self.handlers = {}
		for k = 1, 3 do
			for a = 1, 3 do
				local kk, aa = k, a
				local e = _EntityService:GetEntityByPath(self.MembersPath .. "/P" .. k .. "/A" .. a)
				if isvalid(e) then
					local h1 = e:ConnectEvent(UITouchEnterEvent, function() self._T.hover = { kk, aa } self:UpdateTip() end)
					local h2 = e:ConnectEvent(UITouchExitEvent, function()
						if self._T.hover ~= nil and self._T.hover[1] == kk and self._T.hover[2] == aa then self._T.hover = nil end
						self:UpdateTip()
					end)
					local h3 = e:ConnectEvent(ButtonClickEvent, function()
						if self._T.pin ~= nil and self._T.pin[1] == kk and self._T.pin[2] == aa then self._T.pin = nil else self._T.pin = { kk, aa } end
						self:UpdateTip()
					end)
					table.insert(self.handlers, { e = e, ev = UITouchEnterEvent, h = h1 })
					table.insert(self.handlers, { e = e, ev = UITouchExitEvent, h = h2 })
					table.insert(self.handlers, { e = e, ev = ButtonClickEvent, h = h3 })
				end
			end
		end
		log("[VRF] AccessoryHUDLogic begin handlers=" .. tostring(#self.handlers))
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 이벤트 해제.
		for _, r in ipairs(self.handlers) do
			if isvalid(r.e) then r.e:DisconnectEvent(r.ev, r.h) end
		end
		self.handlers = {}
	end

	@ExecSpace("ClientOnly")
	method Component GetManager()
		-- 현재 맵의 판 진행 매니저.
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) then return nil end
		return player.CurrentMap:GetComponent("script.TowerRunManager")
	end

	@ExecSpace("ClientOnly")
	method void UpdateTip()
		-- 툴팁: 고정한 칸 우선, 없으면 마우스가 올라간 칸. 빈 칸이면 종류만.
		local tip = _EntityService:GetEntityByPath(self.TipPath)
		if not isvalid(tip) then return end
		local target = self._T.pin or self._T.hover
		local mgr = self:GetManager()
		-- 하단 구성원 HUD가 숨겨져 있으면(전투 외 화면) 툴팁도 닫는다
		local members = _EntityService:GetEntityByPath(self.MembersPath)
		if not isvalid(members) or not members.Enable then
			self._T.pin = nil
			self._T.hover = nil
			target = nil
		end
		if target == nil or mgr == nil or _WorkshopUILogic._T.defs == nil then
			if tip.Enable then tip:SetEnable(false) end
			return
		end
		local slot = self._T.slots[target[2]]
		local own = (self._T.own or {})[target[1]] or {}
		local it = own[slot]
		local text = self._T.slotNames[slot] .. " — 비어 있음\n정비소에서 끼울 수 있습니다"
		if it ~= nil then text = _WorkshopUILogic:ItemTitle(it) .. "\n" .. _WorkshopUILogic:ItemLines(it) end
		local te = _EntityService:GetEntityByPath(self.TipPath .. "/Text")
		if isvalid(te) then te.TextGUIRendererComponent.Text = text end
		-- 칸 바로 위에 띄운다 (화면 왼쪽 아래 기준): 패널 x = -630·0·630, 장신구 칸 x = 33·110·187, 칸 위 끝 y ≈ 154
		local px = { -630, 0, 630 }
		local ax = { 33, 110, 187 }
		tip.UITransformComponent.anchoredPosition = Vector2(960 + px[target[1]] + ax[target[2]], 162)
		if not tip.Enable then tip:SetEnable(true) end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 장착 정보가 바뀌면 아이콘 다시 그리기.
		local mgr = self:GetManager()
		if mgr == nil or _WorkshopUILogic._T.defs == nil then return end
		local tip = _EntityService:GetEntityByPath(self.TipPath)
		if isvalid(tip) and tip.Enable then self:UpdateTip() end
		if self._T.key == mgr.AccessoryJson then return end
		self._T.key = mgr.AccessoryJson
		_WorkshopUILogic:Parse(mgr)
		self._T.own = _WorkshopUILogic._T.own
		for k = 1, 3 do
			for a = 1, 3 do
				local it = self._T.own[k][self._T.slots[a]]
				_WorkshopUILogic:SetIcon(_EntityService:GetEntityByPath(self.MembersPath .. "/P" .. k .. "/A" .. a .. "/Icon"), it)
			end
		end
		self:UpdateTip()
	end

end
