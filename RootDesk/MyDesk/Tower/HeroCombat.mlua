	property number DeathfaultComboPct = 20
	property integer DeathfaultHitsUp = 4
	-- 소드 일루전: 자상을 1중첩 걸 때마다 환영 스택 +1 (최대 IllusionMaxStack). 시전 시 스택당 이 스킬 피해 +IllusionStackPct%, 스택 초기화
	property integer IllusionMaxStack = 20
	property number IllusionStackPct = 10
	property integer IllusionMaxStackUp = 40
	-- 돌파 4: 체력 DeathfaultFreshHpPct% 이상인 적에게 피해 DeathfaultFreshMul배
	property number DeathfaultFreshHpPct = 90
	property number DeathfaultFreshMul = 1.5
	-- 에픽 어드벤쳐: 시전 시 최대 체력 EpicHealPct% 회복 + BuffTime초간 최대 체력 EpicShieldPct% 보호막. 지속 동안 EpicAuraRUID 반복
	property number EpicHealPct = 20
	property number EpicShieldPct = 30
	property string EpicAuraRUID = "887cb0eadfb74929ba8e90e95d924e0a"
	-- 돌파 1 보호막 50%, 돌파 2 직접 공격 1타마다 쿨타임 -0.5초, 돌파 3 회복 35% + 초당 2%, 돌파 4 지속 +5초 + 초당 보호막 2%,
	-- 돌파 5 보호막 대신 보호막 양(최대 체력 대비 %)만큼 공격력 % 증가
