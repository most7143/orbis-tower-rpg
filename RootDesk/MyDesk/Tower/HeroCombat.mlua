	-- 발할라 추가 검격: skill/112.img/skill/1121055 summon/attack1~6
	property string ValhallaSlashRUIDs = "e14608f966224da2b03c7e52d4b76d0e|4c21454522464bb8945d764ba30aaba5|698b0dadc46340c9a251136d8a702b07|1d85b5a2c02647e3b49042f95dc0355b|28f0803db0504c889ca8b44d15184f85|a3b351e2b8144f188d78187b0c7bf8cd"
	-- 콤보 인스팅트 균열 (400011074 hit) / 콤보 어택 구슬 (110.img 1101013 state)
	property string RiftHitRUID = "0fb7f5fdf27648ca9e85a0cfd754f9c2"
	property string RiftSound = "a2d7ecbf05a945cd88f07132cc63146c"
	property string ComboOrbRUID = "33fcc4a5124a41abbac728f221074be8"
	-- 캐릭터 주위 콤보 표시 (클라이언트 전용 엔티티, 모델 comboorb)
	-- 콤보 어택 skill/1111.img/skill/11111001 state: 0프레임=배경, 1~5프레임=아이콘
	-- 어드밴스드 콤보 skill/112.img/skill/1120003 state: 6스택부터 아이콘을 순서대로 교체, 배경도 교체(회전 없음)
	property string ComboBgRUID = "9cfc22d7db1842608b648d9d7b5d216e"
	property string ComboIconRUIDs = "594f34c4103145a28951780047e71e42|eefe86c8b370407aa16c9fe34f12c98d|dfb6702ddc994b8b8b24acf3c695020b|18b94fa75cc54db0a806f522564ba449|1c603235dffd468f8b28b36aa8cb3df2"
	property string AdvComboBgRUID = "7f96f8f404b043729f2522cf4a0daf0e"
	property string AdvComboIconRUIDs = "83c2c729437c4af5a21f821445b8db38|4b689eb14af04207bf54a027002f23c8|5e34b194750e4926ab2ce3d164b96292|8fbf37a673c44ac9a54918df1af509c9|3bdc2213433f483bb37ce7a657417546"
	property integer ComboIconSlots = 5
	property Vector3 ComboCenter = Vector3(0, 0.38, 0)
	property number ComboRadius = 0.42
	property number ComboBgSpin = 108
	property number ComboOrbitSpin = 132
	property number ComboIconScale = 0.96
	property number ComboPopScale = 1.7
	property number ComboPopTime = 0.28

	-- HUD 표시용 (BattleHUD가 읽음)
	@Sync
	property boolean Active = false
	@Sync
	property integer Combo = 0
	@Sync
	property integer ComboLv = 0
	@Sync
	property number Mana = 0
	@Sync
	property integer Bleed = 0
	@Sync
	property integer SwordCharge = 0
	@Sync
	property number SummonLeft = 0
	@Sync
	property number InstinctLeft = 0
	@Sync
	property string StatusText = ""
	-- 오른쪽 아래 스킬 슬롯 표시용: 장착 순서대로 "스킬id:남은쿨타임:쿨타임|..." (0.2초마다)
	@Sync
	property string SlotInfo = ""
	-- 4-C: 이번 판 캐릭터 레벨·차수 이름 (HUD 구성원 줄)
	@Sync
	property integer RunLevel = 0
	@Sync
	property string RunLabel = ""
	-- 4-D: 궁극기 게이지 (5차 궁극기 칸이 있을 때만 충전)
	@Sync
	property number UltGauge = 0
	@Sync
	property number UltMax = 100

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 클라이언트: 발사체 이동 + 히어로 판에서 캐릭터 주위 콤보 표시(배경 시계 방향 회전, 아이콘 반시계 공전, 생성·강화 때 커졌다 줄어듦).
		self:UpdateShots(delta)
		local player = self.Entity
		local want = self.Active and self.ComboLv > 0 and isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap.Name == "OrbisTower"
		local v = self._T.comboFx
		if not want then
			if v ~= nil then self:ClearComboFx() end
			return
		end
		if v == nil or not isvalid(v.bg) or v.owner ~= player then
			if v ~= nil then self:ClearComboFx() end
			v = self:MakeComboFx(player)
			if v == nil then return end
		end
		local combo = math.max(0, math.min(self.ComboSuperMax, self.Combo))
		local slots = self.ComboIconSlots
		local count = math.min(combo, slots)
		local adv = math.max(0, math.min(combo, slots * 2) - slots)
		-- 3단계(11스택~): 콤보 데스폴트 돌파 5. 주황 배경·아이콘
		local sup = math.max(0, combo - slots * 2)
		v.t = v.t + delta
		-- 배경: 콤보가 있을 때만. 어드밴스드(6스택~)면 그림 교체 + 회전 정지
		v.bg.Visible = combo > 0
		local bgRuid = self.ComboBgRUID
		if sup > 0 then bgRuid = self.SuperComboBgRUID elseif adv > 0 then bgRuid = self.AdvComboBgRUID end
		if v.bgRuid ~= bgRuid then
			v.bg.SpriteRendererComponent.SpriteRUID = bgRuid
			v.bgRuid = bgRuid
			v.bgAngle = 0
			v.bgPop = self.ComboPopTime
		end
		if adv == 0 then v.bgAngle = (v.bgAngle - self.ComboBgSpin * delta) % 360 end
		v.bg.TransformComponent.ZRotation = adv > 0 and 0 or v.bgAngle
		local bs = 1
		if v.bgPop > 0 then
			v.bgPop = math.max(0, v.bgPop - delta)
			bs = 1 + 0.35 * math.sin(math.pi * (1 - v.bgPop / self.ComboPopTime))
		end
		v.bg.TransformComponent.Scale = Vector3(bs, bs, 1)
		-- 아이콘: count개를 원 위에 고르게, 앞에서부터 adv개는 어드밴스드 아이콘
		v.orbit = (v.orbit + self.ComboOrbitSpin * delta) % 360
		for i = 1, slots do
			local icon = v.icons[i]
			local on = i <= count
			local kind = 1
			if i <= sup then kind = 3 elseif i <= adv then kind = 2 end
			if on and (v.kind[i] ~= kind) then
				local list = v.ruids
				if kind == 3 then list = v.supRuids elseif kind == 2 then list = v.advRuids end
				icon.SpriteRendererComponent.SpriteRUID = list[((i - 1) % #list) + 1]
				v.pop[i] = self.ComboPopTime
			end
			v.kind[i] = on and kind or 0
			icon.Visible = on
			if on then
				local ang = math.rad(v.orbit + (i - 1) * 360 / math.max(1, count) + 90)
				icon.TransformComponent.Position = self.ComboCenter + Vector3(math.cos(ang) * self.ComboRadius, math.sin(ang) * self.ComboRadius, 0)
				local sc = self.ComboIconScale
				if v.pop[i] > 0 then
					v.pop[i] = math.max(0, v.pop[i] - delta)
					local k = 1 - v.pop[i] / self.ComboPopTime
					-- 0→0.4: 크게 튀어나옴, 0.4→1: 원래 크기로
					if k < 0.4 then sc = sc * (1 + (self.ComboPopScale - 1) * (k / 0.4)) else sc = sc * (self.ComboPopScale - (self.ComboPopScale - 1) * ((k - 0.4) / 0.6)) end
				end
				icon.TransformComponent.Scale = Vector3(sc, sc, 1)
			end
		end
	end

	@ExecSpace("Client")
	method void ShowShot(integer sid, string ruid, Vector3 start, Vector3 dir, number speed, number range, number scale)
		-- 클라이언트: 풀에서 발사체 하나를 꺼내(없으면 새로 만들어) 그림만 바꾸고 dir 방향으로 날린다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) then return end
		local pool = self._T.shotPool
		if pool == nil then
			pool = {}
			self._T.shotPool = pool
		end
		local e = nil
		while #pool > 0 and e == nil do
			local c = table.remove(pool)
			if isvalid(c) then e = c end
		end
		if e == nil then
			e = _SpawnService:SpawnByModelId("heroshot", "HeroShot", start, player.CurrentMap)
			if not isvalid(e) then return end
			self._T.shotMade = (self._T.shotMade or 0) + 1
			log("[VRF] hero shot new entity n=" .. tostring(self._T.shotMade))
		else
			log("[VRF] hero shot reuse")
		end
		local tf = e.TransformComponent
		tf.WorldPosition = start
		local sr = e.SpriteRendererComponent
		if sr.SpriteRUID ~= ruid then sr.SpriteRUID = ruid end
		-- 메이플 발사체 그림은 왼쪽을 본다: 오른쪽으로 날면 뒤집고, 날아가는 각도만큼 기울인다
		sr.FlipX = dir.x > 0
		local ang = math.deg(math.atan(dir.y, dir.x))
		if dir.x < 0 then ang = ang - 180 end
		tf.ZRotation = ang
		tf.Scale = Vector3(scale, scale, 1)
		e.Visible = true
		if self._T.shots == nil then self._T.shots = {} end
		table.insert(self._T.shots, { sid = sid, e = e, dir = dir, speed = speed, range = range, moved = 0 })
	end

	@ExecSpace("Client")
	method void EndShot(integer sid)
		-- 클라이언트: 서버가 충돌을 확인한 발사체를 바로 숨긴다.
		local list = self._T.shots or {}
		for i = #list, 1, -1 do
			if list[i].sid == sid then
				self:HideShot(list[i])
				table.remove(list, i)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void HideShot(table s)
		-- 클라이언트: 발사체를 지우지 않고 숨겨서 풀에 돌려놓는다.
		if not isvalid(s.e) then return end
		s.e.Visible = false
		if self._T.shotPool == nil then self._T.shotPool = {} end
		table.insert(self._T.shotPool, s.e)
	end

	@ExecSpace("ClientOnly")
	method void UpdateShots(number delta)
		-- 클라이언트: 날아가는 발사체를 매 프레임 속도×시간만큼 옮긴다. 사거리 끝이면 숨긴다.
		local list = self._T.shots
		if list == nil or #list == 0 then return end
		for i = #list, 1, -1 do
			local s = list[i]
			if not isvalid(s.e) then
				table.remove(list, i)
			else
				local step = s.speed * delta
				s.moved = s.moved + step
				if s.moved >= s.range then
					self:HideShot(s)
					table.remove(list, i)
				else
					s.e.TransformComponent:Translate(s.dir.x * step, s.dir.y * step)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method table MakeComboFx(Entity player)
		-- 클라이언트: 캐릭터 자식으로 배경 1개 + 아이콘 슬롯을 만든다 (이 클라이언트에만 존재).
		local bg = _SpawnService:SpawnByModelId("comboorb", "ComboBg", player.TransformComponent.WorldPosition, player)
		if not isvalid(bg) then return nil end
		bg.TransformComponent.Position = self.ComboCenter
		bg.SpriteRendererComponent.OrderInLayer = 400
		local v = { owner = player, bg = bg, bgRuid = "", bgAngle = 0, bgPop = 0, orbit = 0, t = 0, icons = {}, kind = {}, pop = {}, ruids = {}, advRuids = {}, supRuids = {} }
		for r in string.gmatch(self.SuperComboIconRUIDs, "[^|]+") do table.insert(v.supRuids, r) end
		for r in string.gmatch(self.ComboIconRUIDs, "[^|]+") do table.insert(v.ruids, r) end
		for r in string.gmatch(self.AdvComboIconRUIDs, "[^|]+") do table.insert(v.advRuids, r) end
		for i = 1, self.ComboIconSlots do
			local icon = _SpawnService:SpawnByModelId("comboorb", "ComboIcon" .. tostring(i), player.TransformComponent.WorldPosition, player)
			icon.TransformComponent.Position = self.ComboCenter
			icon.SpriteRendererComponent.OrderInLayer = 410 + i
			icon.Visible = false
			v.icons[i] = icon
			v.kind[i] = 0
			v.pop[i] = 0
		end
		self._T.comboFx = v
		log("[VRF] combo fx created")
		return v
	end

	@ExecSpace("ClientOnly")
	method void ClearComboFx()
		-- 클라이언트: 콤보 표시 엔티티 제거.
		local v = self._T.comboFx
		self._T.comboFx = nil
		if v == nil then return end
		if isvalid(v.bg) then v.bg:Destroy() end
		for _, icon in ipairs(v.icons) do
			if isvalid(icon) then icon:Destroy() end
		end
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 서버 상태 초기화 + 히어로 스킬표(JobSkillTable + SkillActionTable) 읽기.
		self:LoadSkills()
		self:ClearState()
		log("[VRF] HeroCombatLogic begin")
	end

	@ExecSpace("ServerOnly")
	method void LoadSkills()
		-- skills[Id] = { id, name, trigger, kind, cooldown, buffTime, mana, comboUse, comboBonus, bleed, proc = { chance, pct, hits, 연출 } }
		self._T.skills = {}
		-- 디버프 표: debuffDefs[Id] = { name, effect, value, duration, fx }
		self._T.debuffDefs = {}
		local dt = _DataService:GetTable(self.DebuffTableName)
		if dt ~= nil then
			for i = 1, dt:GetRowCount() do
				self._T.debuffDefs[dt:GetCell(i, "Id")] = { name = dt:GetCell(i, "Name") or "", effect = dt:GetCell(i, "Effect") or "",
					chance = tonumber(dt:GetCell(i, "Chance")) or 100,
					value = tonumber(dt:GetCell(i, "Value")) or 0, duration = tonumber(dt:GetCell(i, "Duration")) or 0, fx = dt:GetCell(i, "MobFxRUID") or "",
					maxStack = math.floor(tonumber(dt:GetCell(i, "MaxStack")) or 1) }
			end
		end
		local acts = {}
		local at = _DataService:GetTable("SkillActionTable")
		if at ~= nil then
			for i = 1, at:GetRowCount() do
				acts[at:GetCell(i, "SkillId")] = { actionFrames = at:GetCell(i, "ActionFrames") or "", actionTime = tonumber(at:GetCell(i, "ActionTime")) or 0.8,
					casterFx = at:GetCell(i, "CasterFx") or "", fx = at:GetCell(i, "HitFx") or "", fxScale = tonumber(at:GetCell(i, "FxScale")) or 1, mobFx = at:GetCell(i, "MobFx") or "",
					policy = at:GetCell(i, "HitPolicy") or "per_hit", useSound = at:GetCell(i, "UseSound") or "", hitSound = at:GetCell(i, "HitSound") or "",
					hitGap = tonumber(at:GetCell(i, "HitGap")) or 0.12, hitY = tonumber(at:GetCell(i, "HitY")) or 0.45,
					targets = math.max(1, math.floor(tonumber(at:GetCell(i, "Targets")) or 1)) }
			end
		end
		local js = _DataService:GetTable("JobSkillTable")
		if js == nil then return end
		for i = 1, js:GetRowCount() do
			if js:GetCell(i, "JobId") == "Hero" then
				local id = js:GetCell(i, "SkillId")
				local function num(col) return tonumber(js:GetCell(i, col)) or 0 end
				local p = acts[id] or { actionFrames = "", actionTime = 0.8, casterFx = "", fx = "", fxScale = 1, mobFx = "", policy = "per_hit", useSound = "", hitSound = "", hitGap = 0.12, hitY = 0.45, targets = 1 }
				p.chance = num("Chance")
				p.pct = num("Pct")
				p.hits = math.max(1, math.floor(num("ProcHits")))
				self._T.skills[id] = { id = id, name = js:GetCell(i, "Name"), trigger = js:GetCell(i, "Trigger") or "Proc", kind = js:GetCell(i, "SkillType") or "",
					cooldown = num("Cooldown"), buffTime = num("BuffTime"), mana = num("Mana"), comboUse = math.floor(num("ComboUse")), comboBonus = num("ComboBonus"), bleed = math.floor(num("Bleed")), proc = p }
			end
		end
	end

	@ExecSpace("ServerOnly")
	method Component MS()
		-- 몬스터 상태(자상·디버프·기절 표시·줄 선 몬스터 상태)를 들고 있는 히어로. 2인 편성에서는 메인이 담당해 두 캐릭터가 같은 상태를 공유한다.
		local o = self._T.statusOwner
		if o ~= nil and isvalid(o) and o ~= self then return o end
		return self
	end

	@ExecSpace("ServerOnly")
	method void ClearState()
		-- 판 상태 전부 비우기 (붙어 있는 이펙트도 제거).
		local t = self._T
		t.carry = {}
		t.shotList = {}
		t.debuff = {}
		t.qstat = {}
		t.icons = {}
		t.iconTarget = nil
		if t.serials ~= nil then
			for _, s in pairs(t.serials) do
				if s ~= nil and s ~= 0 then _EffectService:RemoveEffect(s) end
			end
		end
		t.serials = {}
		t.comaField = nil
		t.inragePending = false
		self.SlotInfo = ""
		t.noAutoBuff = false
		t.equip = {}
		t.ownLv = {}
		t.slotOf = {}
		t.pctMul = {}
		t.tier = 0
		t.ultId = nil
		-- 4-E: 고유 패시브 숨은 장착(확률·위기 스킬)과 차수 강화
		t.hidden = {}
		t.pExtra = {}
		self.RunLevel = 0
		self.RunLabel = ""
		self.UltGauge = 0
		t.cd = {}
		t.till = {}
		t.bleed = {}
		t.bleedTick = 1
		t.lastBasic = 0
		t.decayTick = 1
		t.lastSword = ""
		t.nextSword = nil
		t.swordSet = {}
		t.summon = nil
		t.valCharge = 0
		t.deathfaultEcho = nil
		t.illusionStack = 0
		t.comboRefund = 0
		t.summonBoost = 0
		t.lastActionTime = 0
		t.monTop = 1.0
		t.monMid = 0.45
		self.Active = false
		self.Combo = 0
		self.Mana = 0
		self.Bleed = 0
		self.SwordCharge = 0
		self.SummonLeft = 0
		self.InstinctLeft = 0
		self.StatusText = ""
	end

	@ExecSpace("ServerOnly")
	method void BeginRun(Component mgr)
		-- 4-C: 판 시작 — 캐릭터 차수의 칸 스킬(주력·보조·기술·하이퍼·궁극기)을 장착한다. 로비 장착·스킬 레벨은 읽지 않는다.
		-- 칸 수치 덮어쓰기(쿨·마나·발동 방식)가 판마다 쌓이지 않게 스킬표를 다시 읽어 원래 값으로 되돌린다.
		self:LoadSkills()
		self:ClearState()
		self._T.mgr = mgr
		local d = mgr:RunDataFor(self.JobId)
		if d == nil then
			-- 안전장치: 로스터 값이 없을 때만 예전 로비 장착 경로 (정상 판에서는 나오면 안 됨)
			log_warning("[VRF] Hero run data missing, legacy equip")
			local eng = mgr:GetEngrave()
			local data = { equip = {}, lv = {}, comboLv = 0 }
			if eng ~= nil then data = eng:SkillRunData() end
			self.ComboLv = data.comboLv or 0
			for _, id in ipairs(data.equip) do
				if self._T.skills[id] ~= nil then
					table.insert(self._T.equip, id)
					self._T.ownLv[id] = data.lv[id] or 1
					mgr.SkillLv[id] = 1
				end
			end
		else
			self:ApplySlots(mgr, d)
		end
		-- 4-F: 돌파 저장 키(직업.칸) 등록
		mgr:RegisterSlots(self.JobId, self._T.slotOf)
		self.Active = true
        self.ManaMax = 100 * (1 + mgr:Bonus("AccountMana") / 100)
		self.Mana = self.ManaStart
		-- 장착 스킬 연출 리소스를 클라이언트에 미리 불러 둔다 (첫 시전 때 이펙트가 늦게 뜨지 않게)
		local list = {}
		for _, id in ipairs(self._T.equip) do
			local p = self._T.skills[id].proc
			for _, field in ipairs({ p.casterFx, p.fx, p.mobFx, p.useSound, p.hitSound }) do
				for ruid in string.gmatch(field or "", "[^|]+") do table.insert(list, ruid) end
			end
		end
		for _, ruid in ipairs({ self.StunFxRUID, self.BleedFxRUID, self.ComboBgRUID, self.AdvComboBgRUID, self.SuperComboBgRUID, self.RiftHitRUID }) do table.insert(list, ruid) end
		for ruid in string.gmatch(self.ComboIconRUIDs .. "|" .. self.AdvComboIconRUIDs .. "|" .. self.SuperComboIconRUIDs, "[^|]+") do table.insert(list, ruid) end
		if self:Equipped("H12") then
			for _, ruid in ipairs({ self.SwordSummonedRUID, self.SwordStandRUID, self.SwordAttackRUID, self.SwordAttack2RUID, self.SwordHitRUID, self.SwordHit2RUID, self.SwordDieRUID }) do table.insert(list, ruid) end
		end
		for _, id in ipairs(self._T.equip) do
			local shot = self:ShotRUID(id)
			if shot ~= "" then table.insert(list, shot) end
		end
		if self:Equipped("H03") then
			for ruid in string.gmatch(self.PanicRedCasterFx .. "|" .. self.PanicRedHitFx, "[^|]+") do table.insert(list, ruid) end
		end
		if self:Equipped("H06") then
			for ruid in string.gmatch(self.IncisingEnhCasterFx, "[^|]+") do table.insert(list, ruid) end
		end
		if self:Equipped("H07") then
			table.insert(list, self.AuraEnhCastRUID)
			table.insert(list, self.AuraEnhShotRUID)
		end
		if self:Equipped("H02") then
			for ruid in string.gmatch(self.BrandishRecastCasterFx .. "|" .. self.BrandishRecastHitFx, "[^|]+") do table.insert(list, ruid) end
		end
		if self:Equipped("H04") then
			for ruid in string.gmatch(self.ComaFinishRUIDs, "[^|]+") do table.insert(list, ruid) end
			table.insert(list, self.ComaFieldRUID)
		end
		if self:Equipped("H10") then
			for ruid in string.gmatch(self.ValhallaSlashRUIDs, "[^|]+") do table.insert(list, ruid) end
		end
		self:PreloadFx(table.concat(list, "|"))
		self._T.lastBasic = _UtilLogic.ElapsedSeconds
		log("[VRF] hero run equip=" .. table.concat(self._T.equip, ","))
	end

	@ExecSpace("ServerOnly")
	method void ApplySlots(Component mgr, table d)
		-- 4-C: 칸 순서(주력·보조·기술·하이퍼·궁극기 = HUD S1~S5)대로 현재 차수 칸 스킬을 장착하고 칸 수치(배율·쿨·마나·발동 방식)를 덮어쓴다.
		local tier = math.max(1, math.floor(d.tier or 1))
		self._T.tier = tier
		self.RunLevel = math.floor(d.level or 0)
		self.RunLabel = d.tierName or ""
		-- 4-E: 고유 패시브(콤보 어택) 레벨·흡수 스킬·차수 강화 = CharPassiveTable
		local p = mgr:PassiveOf(self.JobId, tier)
		self.ComboLv = p.lv
		self._T.pExtra = p.extra or {}
		self.UltMax = mgr.UltGaugeMax
		local pcts = {}
		for _, key in ipairs({ "Main", "Sub", "Tech", "Hyper", "Ult" }) do
			local id = (d.slots or {})[key] or ""
			if id ~= "" and self._T.skills[id] ~= nil then
				table.insert(self._T.equip, id)
				self._T.slotOf[id] = key
				local t = mgr:SlotTune(self.JobId, key, tier)
				self._T.pctMul[id] = t.pctMul
				local sk = self._T.skills[id]
				if t.cdSec > 0 then sk.cooldown = t.cdSec end
				if t.mana >= 0 then sk.mana = t.mana end
				-- 하이퍼: 쿨타임마다 자동 시전
				if t.triggerAs == "Cooldown" then sk.trigger = "Cooldown" end
				-- 궁극기: 게이지가 차면 시전 (일반 시전 분기에서 빠짐, 마나 0)
				if t.triggerAs == "Ult" then
					sk.trigger = "Ult"
					sk.mana = 0
					self._T.ultId = id
				end
				-- 하이퍼·궁극기·패시브도 SkillLv 1이어야 Learned()가 true
				mgr.SkillLv[id] = 1
				table.insert(pcts, tostring(t.pctMul))
			end
		end
		log("[VRF] slots run job=" .. self.JobId .. " tier=" .. tostring(tier) .. " lv=" .. tostring(self.RunLevel) .. " equip=" .. table.concat(self._T.equip, ",") .. " pct=" .. table.concat(pcts, ",") .. " ult=" .. tostring(self._T.ultId or ""))
		-- 4-E: 패시브가 흡수한 확률·위기 스킬을 숨은 장착으로 (HUD 칸에는 안 보임, 돌파 카드·마법의 서 대상)
		local hidden = {}
		for _, gid in ipairs(p.grants or {}) do
			if self._T.skills[gid] ~= nil and not self:Equipped(gid) then
				table.insert(self._T.equip, gid)
				self._T.hidden[gid] = true
				self._T.slotOf[gid] = "Passive"
				mgr.SkillLv[gid] = 1
				table.insert(hidden, gid)
			end
		end
		local ex = {}
		for k, v in pairs(self._T.pExtra) do if v then table.insert(ex, k) end end
		log("[VRF] passive run job=" .. self.JobId .. " tier=" .. tostring(tier) .. " passiveLv=" .. tostring(self.ComboLv) .. " hidden=" .. table.concat(hidden, ",") .. " extra=" .. table.concat(ex, ","))
	end

	@ExecSpace("ServerOnly")
	method string SwapSlot(Component mgr, string slot, string newId)
		-- 4-F 테스트(DebugSwapSlot): 판 중 진화 흉내 — 그 칸의 스킬을 newId로 바꾸고 칸 수치를 다시 덮어쓴다. 돌려주는 값: 이전 스킬 Id(없으면 "").
		local sk = self._T.skills[newId]
		if sk == nil then return "" end
		local old = ""
		for id, s in pairs(self._T.slotOf) do
			if s == slot then old = id end
		end
		if old == "" or old == newId then return old end
		for i, id in ipairs(self._T.equip) do
			if id == old then self._T.equip[i] = newId end
		end
		self._T.slotOf[old] = nil
		self._T.slotOf[newId] = slot
		local t = mgr:SlotTune(self.JobId, slot, self._T.tier)
		self._T.pctMul[newId] = t.pctMul
		if t.cdSec > 0 then sk.cooldown = t.cdSec end
		if t.mana >= 0 then sk.mana = t.mana end
		if t.triggerAs == "Cooldown" then sk.trigger = "Cooldown" end
		if self._T.ultId == old then
			sk.trigger = "Ult"
			sk.mana = 0
			self._T.ultId = newId
		end
		mgr.SkillLv[newId] = 1
		return old
	end

	@ExecSpace("ServerOnly")
	method void AddUlt(number n)
		-- 4-D: 궁극기 게이지 충전 (궁극기 칸이 있고 아직 가득이 아닐 때만).
		if self._T.ultId == nil or n <= 0 or self.UltGauge >= self.UltMax then return end
		self.UltGauge = math.min(self.UltMax, self.UltGauge + n)
	end

	@ExecSpace("Client")
	method void PreloadFx(string ruids)
		-- 클라이언트: 히어로 스킬 이펙트·사운드 미리 불러오기.
		local list = {}
		for ruid in string.gmatch(ruids, "[^|]+") do table.insert(list, ruid) end
		if #list == 0 then return end
		_ResourceService:PreloadAsync(list, function(result) log("[VRF] hero fx preloaded n=" .. tostring(#list)) end)
	end

	@ExecSpace("ServerOnly")
	method table RunSkills(Component mgr)
		-- 이번 판에 배운 히어로 스킬 (장착 순서, 이 로직이 읽은 표). 레벨업으로 습득하기 전(Lv.0)은 발동하지 않는다.
		local list = {}
		for _, id in ipairs(self._T.equip or {}) do
			local sk = self._T.skills[id]
			if sk ~= nil and self:Learned(id) then table.insert(list, sk) end
		end
		return list
	end

	@ExecSpace("ServerOnly")
	method boolean Equipped(string id)
		-- 이번 판에 장착한 스킬인지.
		for _, e in ipairs(self._T.equip or {}) do
			if e == id then return true end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method boolean Learned(string id)
		-- 이번 판 레벨업으로 배운 스킬인지 (장착 + Lv.1 이상).
		local mgr = self._T.mgr
		if mgr == nil or not self:Equipped(id) then return false end
		return (mgr.SkillLv[id] or 0) > 0
	end

	@ExecSpace("ServerOnly")
	method boolean Has(string id, integer n)
		-- 돌파 id_Bn을 이번 판에 얻었는지.
		local mgr = self._T.mgr
		if mgr == nil then return false end
		return mgr:HeroBreak(id, id .. "_B" .. tostring(n))
	end

	@ExecSpace("ServerOnly")
	method number Star(string id, string key)
		-- 별 강화 합계 (StarPower %, StarTempo %, StarCrit %p).
		local mgr = self._T.mgr
		if mgr == nil then return 0 end
		return mgr:HeroStarVal(id, key)
	end

	@ExecSpace("ServerOnly")
	method boolean BreakAllowed(string breakId)
		-- 돌파 카드 등장 조건: 소환검·자상 소비·다른 검술 연계 옵션은 그 조건을 갖췄을 때만.
		local summonOpts = { H05_B5 = true, H07_B5 = true }
		if summonOpts[breakId] then return self:Learned("H12") end
		local bleedUse = { H03_B5 = true, H08_B4 = true, H14_B3 = true }
		if bleedUse[breakId] then
			return self:Has("H06", 2) or self:Has("H01", 4) or self:Has("H03", 5) or self:Has("H04", 5) or self:Has("H05", 4) or self:Has("H10", 4) or self:Has("H14", 4)
		end
		if breakId == "H09_B4" then return self:Learned("H02") or self:Learned("H07") or self:Learned("H08") or self:Has("H01", 5) end
		return true
	end

	@ExecSpace("ServerOnly")
	method number Now()
		-- 서버 시간(초).
		return _UtilLogic.ElapsedSeconds
	end

	@ExecSpace("ServerOnly")
	method boolean On(string tag)
		-- 시간제 상태가 지속 중인지 (버프·창 효과).
		return self:Now() < (self._T.till[tag] or 0)
	end

	@ExecSpace("ServerOnly")
	method number LvMul(string id)
		-- 4-C: 칸 표 위력 배율(CharSkillSlotTable PctMul). 아웃게임 스킬 레벨 배율은 쓰지 않는다.
		return (self._T.pctMul or {})[id] or 1
	end

	@ExecSpace("ServerOnly")
	method number BuffPower(string id)
		-- 버프 위력 강화: 기본값의 30%씩 추가.
		return 1 + self:Star(id, "StarPower") / 100
	end

	@ExecSpace("ServerOnly")
	method number TempoMul(string id)
		-- 속도·지속 강화 횟수 (StarTempo 20%씩).
		return self:Star(id, "StarTempo") / 20
	end

	-- ========== 콤보·마나 ==========

	@ExecSpace("ServerOnly")
	method void AddCombo(integer n)
		-- 콤보 획득 (최대 ComboCap: 기본 5, 코마 돌파 3이면 10). 콤보 어택을 해금하지 않았으면 쌓이지 않는다.
		if n <= 0 or self.ComboLv <= 0 then return end
		self.Combo = math.min(self:ComboCap(), self.Combo + n)
		self:UpdateOrb()
	end

	@ExecSpace("ServerOnly")
	method integer ComboCap()
		-- 지금 판의 콤보 최대치: 기본 5, 코마 돌파 3 '어드밴스드 콤보'면 10.
		local cap = self.ComboBaseMax
		if self:Has("H13", 5) then cap = self.ComboSuperMax
		elseif self:Has("H04", 3) then cap = self.ComboMax end
		-- 4-E: 콤보 어택 4차 강화 '콤보 최대 10' (데스폴트 돌파 15가 더 크면 그쪽)
		if (self._T.pExtra or {}).ComboCap10 then cap = math.max(cap, self.ComboMax) end
		return cap
	end

	@ExecSpace("ServerOnly")
	method boolean RollComboGain()
		-- 콤보 획득 판정 (콤보 어택 해금 시 ComboGainChance%).
		if self.ComboLv <= 0 then return false end
		local chance = self.ComboGainChance
		-- 인레이지 돌파 3 '투지의 격류': 지속 중 콤보 획득 확률 +50% (30% → 45%)
		if self:On("H05") and self:Has("H05", 3) then chance = chance * (1 + self.InrageComboChancePct / 100) end
		-- 4-E: 콤보 어택 5차 강화 '콤보 획득 확률 +50%' (30 → 45%)
		if (self._T.pExtra or {}).ComboGain50 then chance = chance * 1.5 end
		return _UtilLogic:RandomDouble() * 100 < chance
	end

	@ExecSpace("ServerOnly")
	method number ComboAtkPerStack()
		-- 콤보 1당 기본 공격력 % (콤보 어택 레벨).
		if self.ComboLv <= 0 then return 0 end
		return self.ComboAtkBase + (self.ComboLv - 1) * self.ComboAtkPerLv
	end

	@ExecSpace("ServerOnly")
	method boolean UseCombo(integer n)
		-- 콤보 n 소비 (부족하면 소비하지 않고 false). 인스팅트 '본능의 순환'은 40% 누적 환급.
		if n <= 0 or self.Combo < n then return false end
		self.Combo = self.Combo - n
		if self:On("H15") and self:Has("H15", 5) then
			self._T.comboRefund = self._T.comboRefund + n * 0.4
			local back = math.floor(self._T.comboRefund)
			if back > 0 then
				self._T.comboRefund = self._T.comboRefund - back
				self.Combo = math.min(self:ComboCap(), self.Combo + back)
			end
		end
		self:UpdateOrb()
		return true
	end

	@ExecSpace("ServerOnly")
	method void AddMana(number n)
		-- 마나 획득 (최대 100).
		-- 유물 '마나 획득량': 얻는 마나만 늘린다
		local mgr = self._T.mgr
		if n > 0 and mgr ~= nil then n = n * (1 + mgr:Bonus("RelicMana") / 100) end
		self.Mana = math.min(self.ManaMax, self.Mana + n)
	end

	@ExecSpace("ServerOnly")
	method void UpdateOrb()
		-- 서버: 예전 최대 콤보 구슬 이펙트 정리 (캐릭터 주위 콤보 표시는 클라이언트 OnUpdate가 그린다).
		if self._T.serials == nil then return end
		local s = self._T.serials.orb
		-- 콤보 표시는 클라이언트 OnUpdate(배경·아이콘 회전)로 옮김. 예전 최대 콤보 구슬 이펙트가 남아 있으면 지운다.
		if s ~= nil and s ~= 0 then
			_EffectService:RemoveEffect(s)
			self._T.serials.orb = 0
		end
	end

	-- ========== 피해 계산 ==========

	@ExecSpace("ServerOnly")
	method number ComboDirectPct()
		-- 콤보당 직접 공격 피해 (기본 2%, 인스팅트 중 5% + 별 위력 30% + '한계를 넘은 투지' 3%).
		local per = self:ComboAtkPerStack()
		if self:On("H15") then
			per = 5 * (1 + self:Star("H15", "StarPower") / 100)
			if self:Has("H15", 3) then per = per + 3 end
		end
		local pct = self.Combo * per
		return pct
	end

	@ExecSpace("ServerOnly")
	method number AllDmgPct()
		-- 에픽 어드벤쳐: 모든 피해 증가.
		local mgr = self._T.mgr
        return mgr ~= nil and (mgr:Bonus("SkillDmg") + mgr:AccessoryBonus(self.Entity, "SkillDmg")) or 0
	end

	@ExecSpace("ServerOnly")
	method number DirectMul()
		-- 기본 공격·직접 타격 배율 (콤보 + 모든 피해).
		return (1 + self:ComboDirectPct() / 100) * (1 + self:AllDmgPct() / 100) * (1 + self:DefDownPct() / 100)
	end

	@ExecSpace("ServerOnly")
	method table Strike(string id, number pct, number bonusPct, boolean direct, boolean forceCrit)
		-- 스킬 한 타: 공격력 × 계수 × 레벨 × (1+스킬 피해%) × 콤보·모든 피해 → 치명타. { dmg, crit }
		local mgr = self._T.mgr
		local base = mgr:ActorHitDamage(self.Entity) * pct / 100 * self:LvMul(id)
		local mul = (1 + (self:Star(id, "StarPower") + bonusPct) / 100) * (1 + self:AllDmgPct() / 100)
		-- 콤보는 기본 공격력 증가라 모든 타격에 적용 (direct 인자는 호환용)
		mul = mul * (1 + self:ComboDirectPct() / 100)
		-- 자상 방어력 감소
		mul = mul * (1 + self:DefDownPct() / 100)
		local rate = mgr:ActorCrit(self.Entity) + self:Star(id, "StarCrit")
		local critDmg = mgr:ActorCritDmg(self.Entity) + self:Star(id, "StarCrit") * 2
		local crit = forceCrit or _UtilLogic:RandomDouble() * 100 < rate
		if crit then mul = mul * critDmg / 100 end
		return { dmg = math.max(1, math.floor(base * mul + 0.5)), crit = crit }
	end

	@ExecSpace("ServerOnly")
	method number CastCost(table sk)
		-- 마나 비용 (돌파 감소 반영, 올림).
		local cost = sk.mana or 0
		local cut = { H07 = 9, H14 = 30 }
		if cut[sk.id] ~= nil and self:Has(sk.id, 2) then cost = cut[sk.id] end
		-- 패닉 '날렵함': 마나 10
		if sk.id == "H03" and self:Has("H03", 4) then cost = 10 end
		-- 레이지 업라이징 '맨손의 분노': 마나 절반
		if sk.id == "H09" and self:Has("H09", 3) then cost = cost / 2 end
		-- 레이징 블로우 '날렵함': 마나 20 → 12
		if sk.id == "H08" and self:Has("H08", 5) then cost = 12 end
		-- 인사이징 '날렵함': 마나 12 → 7
		if sk.id == "H06" and self:Has("H06", 3) then cost = 7 end
		-- 코마 '완전한 제압': 마나 소모 없음
		if sk.id == "H04" and self:Has("H04", 4) then cost = 0 end
		return math.ceil(cost)
	end

	@ExecSpace("ServerOnly")
	method number Cooldown(table sk)
		-- 쿨타임 (돌파 단축 반영).
		local cd = sk.cooldown or 0
		local cut = { H02 = 3 }
		-- 소드 일루전 '날렵함': 쿨타임 8초
		if sk.id == "H14" and self:Has("H14", 2) then cd = 8 end
		-- 콤보 데스폴트 돌파 2: 쿨타임 없음 (최대 콤보에서 우선 시전)
		if sk.id == "H13" and self:Has("H13", 2) then cd = 0 end
		-- 발할라 돌파 5 '1회 발동': 쿨타임 3초
		if sk.id == "H10" and self:Has("H10", 5) then cd = self.ValhallaOneShotCd end
		-- 인사이징 '날렵함': 쿨타임 3초
		if sk.id == "H06" and self:Has("H06", 3) then cd = 3 end
		if cut[sk.id] ~= nil and self:Has(sk.id, 2) then cd = cut[sk.id] end
		-- 슬래시 블러스트는 1번 돌파가 쿨타임 감소
		if sk.id == "H01" and self:Has("H01", 1) then cd = 3 end
		-- 패닉 '날렵함': 쿨타임 4초
		if sk.id == "H03" and self:Has("H03", 4) then cd = 4 end
		-- 레이징 블로우 '날렵함': 쿨타임 6초
		if sk.id == "H08" and self:Has("H08", 5) then cd = math.min(cd, 6) end
		-- 장신구 '미스틱 이어링' 등: 재사용 대기시간 감소
		local mgr = self._T.mgr
		if mgr ~= nil then cd = cd * math.max(0.2, 1 - (mgr:AccessoryBonus(self.Entity, "CdReduce") + mgr:Bonus("RelicCd")) / 100) end
		return cd
	end

	@ExecSpace("ServerOnly")
	method number ProcChance(table sk)
		-- 확률형 발동 확률 (돌파·은총 반영).
		local mgr = self._T.mgr
		local c = sk.proc.chance
		local up = { H01 = 48, H02 = 40, H08 = 29 }
		local n = { H01 = 1, H02 = 2, H08 = 2 }
		if up[sk.id] ~= nil and self:Has(sk.id, n[sk.id]) then c = up[sk.id] end
		return c + mgr:Bonus("ProcChance")
	end

	-- ========== 발동 ==========

	@ExecSpace("ServerOnly")
	method table RollCasts(Component mgr)
		-- 기본 공격 1회(명중): 콤보·마나 획득 후 이번 공격에 함께 시전할 히어로 스킬을 정한다.
		-- 순서: 확률형 → 마나형 1개 → 쿨타임형 1개 (마지막 스킬의 동작으로 공격 모션을 바꾼다).
		self._T.mgr = mgr
		local now = self:Now()
		self._T.lastBasic = now
		-- 기본 공격(직접 공격, 콤보 소비 없음) 적중: ComboGainChance% 확률로 콤보 (인레이지 중 2·돌파 3)
		local gain = 1
		if self:RollComboGain() then self:AddCombo(gain) end
		-- 인레이지 돌파 4 '흉터': 지속 중 기본 공격 적중 시 25% 확률로 자상 1중첩
		if self:On("H05") and self:Has("H05", 4) and _UtilLogic:RandomDouble() * 100 < self.InrageBleedChance then
			local mon = mgr:HeroMonster()
			if isvalid(mon) then self:AddBleed(1, "H05", mon) end
		end
		self:EpicCdCut(1)
		-- 4-D: 기본 공격 적중 → 궁극기 게이지
		self:AddUlt(mgr.UltGaugeBasic)
		local mana = self.ManaPerHit
		if self:On("H13w") then mana = 5 end
		self:AddMana(mana)
		local list = {}
		local skills = self:RunSkills(mgr)
		-- 인스팅트 (최대 콤보에서 확률, 지속 중 재발동 없음) + 지속 중 균열
		for _, sk in ipairs(skills) do
			-- 기본 공격 적중 시 발동 (확률 100%, 콤보 조건 없음). 재발동 대기시간: 발동 순간부터 Cooldown초 (지속시간 포함)
			if sk.trigger == "Instinct" and not self:On("H15") and (self._T.cd[sk.id] or 0) <= 0 then
				self._T.cd[sk.id] = self:Cooldown(sk)
				table.insert(list, self:MakeCast(sk))
				if (self._T.hidden or {})[sk.id] then log("[VRF] passive proc job=" .. self.JobId .. " id=" .. sk.id) end
			end
		end
		if self:On("H15") then table.insert(list, self:MakeRift()) end
		-- 동작(액션)이 있는 스킬은 공격 1회에 하나만: 쿨타임형 → 마나형 → 확률형 순으로 먼저 걸린 하나.
		-- 못 나간 쿨타임·마나 스킬은 자원을 쓰지 않고 다음 공격에 다시 노린다. (동작 없는 인스팅트·균열은 항상 동반)
		self:PickActed(mgr, self:RunSkills(mgr), list)
		return self:FinishCasts(list)
	end

	@ExecSpace("ServerOnly")
	method table RollSkillCasts(Component mgr)
		-- 기본 공격과 별개로 시전할 스킬 (마나·쿨타임·사거리가 되면 계속 시전). 시전할 게 없으면 빈 목록.
		self._T.mgr = mgr
		local list = {}
		self:PickActed(mgr, self:RunSkills(mgr), list)
		if #list == 0 then return list end
		return self:FinishCasts(list)
	end

	@ExecSpace("ServerOnly")
	method void PickActed(Component mgr, table skills, table list)
		-- 동작(액션)이 있는 스킬 1개를 골라 list에 넣는다: 궁극기(게이지 가득) → 우선 시전 → 쿨타임형 → 마나형(비용 큰 것).
		-- 4-D: 궁극기 게이지가 가득이면 이번 차례 동작 스킬은 궁극기 1개 (마나 소모·쿨타임 기록 없음)
		if self:TryUltCast(list, false) then return end
		local uid = self._T.ultId
		local n0 = #list
		self:PickActedInner(mgr, skills, list)
		-- 4-D: 궁극기가 아닌 스킬을 시전할 때마다 게이지
		for i = n0 + 1, #list do
			local r = list[i]
			if r ~= nil and r.sk ~= nil and r.sk.id ~= uid then self:AddUlt(mgr.UltGaugeSkill) end
		end
	end

	@ExecSpace("ServerOnly")
	method boolean TryUltCast(table list, boolean free)
		-- 4-D: 궁극기 게이지가 가득이면 궁극기를 list에 넣고 게이지 0 (마나 소모·쿨타임 기록 없음). 넣었으면 true.
		local uid = self._T.ultId
		if uid == nil or self.UltGauge < self.UltMax then return false end
		local usk = self._T.skills[uid]
		if usk == nil then return false end
		self.UltGauge = 0
		table.insert(list, self:MakeCast(usk))
		log("[VRF] ult cast job=" .. self.JobId .. " id=" .. uid .. " free=" .. tostring(free))
		return true
	end

	@ExecSpace("ServerOnly")
	method table RollFreeCasts(Component mgr)
		-- 4-D 보완(C안): 사거리에 닿지 않을 때도 시전하는 스킬 — 가득 찬 궁극기, 아니면 쿨타임형(자기 버프·하이퍼) 1개. 없으면 빈 목록.
		self._T.mgr = mgr
		local list = {}
		if not self:TryUltCast(list, true) then
			self:PickCooldownCast(mgr, self:RunSkills(mgr), list)
			for _, r in ipairs(list) do
				if r.sk ~= nil and r.sk.id ~= self._T.ultId then self:AddUlt(mgr.UltGaugeSkill) end
			end
		end
		if #list == 0 then return list end
		return self:FinishCasts(list)
	end

	@ExecSpace("ServerOnly")
	method boolean PickCooldownCast(Component mgr, table skills, table list)
		-- 쿨타임형 스킬 1개 시전 (인레이지는 따로 자동). 돌려주는 값: 동작이 있는 시전이었는지.
		-- 4-G 보완: 발할라는 충전이 남아 있어도 쿨타임이 끝나면 다시 시전해 충전을 최대치로 채운다 (돌파 5 '1회 발동'만 예전처럼 충전을 쓴 뒤).
		for _, sk in ipairs(skills) do
			if sk.trigger == "Cooldown" and sk.id ~= "H05" and (self._T.cd[sk.id] or 0) <= 0 and not (sk.id == "H10" and self._T.valCharge > 0 and self:Has("H10", 5)) then
				self._T.cd[sk.id] = self:Cooldown(sk)
				table.insert(list, self:MakeCast(sk))
				if self._T.slotOf[sk.id] == "Hyper" then log("[VRF] hyper cast job=" .. self.JobId .. " id=" .. sk.id) end
				return self:HasAction(sk) and not (sk.id == "H10" and self:Has("H10", 5))
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method void PickActedInner(Component mgr, table skills, table list)
		-- PickActed 본체: 우선 시전 → 쿨타임형 → 마나형(비용 큰 것) 중 1개.
		local acted = false
		-- 콤보 데스폴트 돌파 2: 최대 콤보이고 마나가 되면 다른 동작 스킬보다 먼저 시전 (쿨타임 없음)
		if self:Has("H13", 2) and self.Combo >= self:ComboCap() then
			for _, sk in ipairs(skills) do
				if sk.id == "H13" and self.Mana >= self:CastCost(sk) then
					self.Mana = self.Mana - self:CastCost(sk)
					self._T.cd[sk.id] = self:Cooldown(sk)
					table.insert(list, self:MakeCast(sk))
					acted = true
					log("[VRF] deathfault priority cast combo=" .. tostring(self.Combo))
					break
				end
			end
		end
		-- 코마 돌파 4 '완전한 제압': 최대 콤보에서 쿨타임이 끝났으면 다른 동작 스킬보다 먼저 시전 (마나 소모 없음)
		if not acted and self:Has("H04", 4) and self.Combo >= self:ComboCap() and (self._T.cd.H04 or 0) <= 0 then
			for _, sk in ipairs(skills) do
				if sk.id == "H04" then
					self.Mana = self.Mana - self:CastCost(sk)
					self._T.cd[sk.id] = self:Cooldown(sk)
					table.insert(list, self:MakeCast(sk))
					acted = true
					log("[VRF] coma priority cast combo=" .. tostring(self.Combo))
					break
				end
			end
		end
		if not acted then acted = self:PickCooldownCast(mgr, skills, list) end
		-- 공격 스킬(Skill): 마나 + 쿨타임. 쿨타임이 끝났고 마나가 되는 스킬 중 마나 비용이 큰(강한) 것부터 하나.
		if not acted then
			local best = nil
			for _, sk in ipairs(skills) do
				-- 콤보 데스폴트: 콤보 5 이상일 때만 시전
				local comboOk = sk.id ~= "H13" or (not self:Has("H13", 2) and self.Combo >= (sk.comboUse or 5))
				if sk.trigger == "Skill" and comboOk and (self._T.cd[sk.id] or 0) <= 0 and self.Mana >= self:CastCost(sk) then
					if best == nil or self:CastCost(sk) > self:CastCost(best) then best = sk end
				end
			end
			if best ~= nil then
				self.Mana = self.Mana - self:CastCost(best)
				self._T.cd[best.id] = self:Cooldown(best)
				table.insert(list, self:MakeCast(best))
			end
		end
	end

	@ExecSpace("ServerOnly")
	method table FinishCasts(table list)
		-- 시전 목록 마무리 (동작 시간 기록 등).
		-- 콤보를 소비하지 않는 직접 공격 스킬(균열 포함)도 적중마다 확률로 콤보 +1
		for _, r in ipairs(list) do
			local direct = #(r.hitDmg or {}) > 0 and ((r.sk ~= nil and (r.sk.comboUse or 0) <= 0) or r.rift)
			if direct then
				local hits = #r.hitDmg
				r.comboGain = r.comboGain or 0
				for h = 1, hits do
					if self:RollComboGain() then r.comboGain = r.comboGain + 1 end
				end
				if r.comboGain <= 0 then r.comboGain = nil end
			end
		end
		self._T.lastActionTime = 0
		for _, r in ipairs(list) do
			if (r.actionTime or 0) > self._T.lastActionTime and (r.actionFrames or "") ~= "" then self._T.lastActionTime = r.actionTime end
		end
		return list
	end

	@ExecSpace("ServerOnly")
	method boolean HasAction(table sk)
		-- 자기 동작(액션 프레임)이 있는 스킬인지.
		return (sk.proc.actionFrames or "") ~= ""
	end

	@ExecSpace("ServerOnly")
	method number LastActionTime()
		-- 이번 공격 스킬 동작 시간 (다음 기본 공격이 동작을 끊지 않게).
		return self._T.lastActionTime or 0
	end

	@ExecSpace("ServerOnly")
	method string ScaleFrames(string frames, number speedPct)
		-- 동작 프레임 시간을 공격 동작 속도만큼 줄인다 ("액션:프레임:ms|...").
		if speedPct <= 0 or frames == "" then return frames end
		local parts = {}
		for action, frame, ms in string.gmatch(frames, "([^:|]+):(%d+):(-?%d+)") do
			-- 음수(타격 전 프레임) 표시는 그대로 두고 크기만 줄인다
			local v = tonumber(ms)
			local sign = v < 0 and -1 or 1
			local scaled = math.floor(math.abs(v) / (1 + speedPct / 100) + 0.5)
			if v ~= 0 then scaled = math.max(20, scaled) end
			table.insert(parts, action .. ":" .. frame .. ":" .. tostring(sign * scaled))
		end
		return table.concat(parts, "|")
	end

	@ExecSpace("ServerOnly")
	method string PickAt(string list, integer k)
		-- "a|b|c" 목록의 k번째 (목록이 짧으면 마지막, 비었으면 "").
		local last = ""
		local n = 0
		for v in string.gmatch(list, "[^|]+") do
			n = n + 1
			last = v
			if n == k then return v end
		end
		return last
	end

	@ExecSpace("ServerOnly")
	method string TagScale(string list, number sc)
		-- 캐릭터 이펙트 목록에 크기를 붙인다 ("ruid@0.7|..."). FxScale이 1이면 그대로. TowerPlayer.PlayAttackMotion이 읽는다.
		if list == "" or sc == 1 then return list end
		local parts = {}
		for ruid in string.gmatch(list, "[^|]+") do table.insert(parts, ruid .. "@" .. tostring(sc)) end
		return table.concat(parts, "|")
	end

	@ExecSpace("ServerOnly")
	method table NewCast(table sk)
		-- 시전 1회의 공통 틀 (연출 값 포함). TowerRunManager.ApplyJobProcs와 TowerPlayer가 쓰는 필드 이름을 맞춘다.
		local p = sk.proc
		local speed = self:Star(sk.id, "StarTempo")
		local r = { hero = true, id = sk.id, name = sk.name, sk = sk, m = {}, dmg = 0, hits = 0, heal = 0, freeze = 0, meso = 0, crit = false,
			hitDmg = {}, hitCrit = {}, after = {},
			fx = p.fx or "", fxScale = p.fxScale or 1, policy = p.policy or "per_hit", hitSound = p.hitSound or "", useSound = p.useSound or "",
			gap = (p.hitGap or 0.12) / (1 + speed / 100), hitY = p.hitY or 0.45, mobFx = p.mobFx or "", targets = p.targets or 1,
			actionFrames = self:ScaleFrames(p.actionFrames or "", speed), actionTime = (p.actionTime or 0.8) / (1 + speed / 100), casterFx = self:TagScale(p.casterFx or "", p.fxScale or 1) }
		-- HitPolicy "random": 시전·히트 이펙트와 소리 목록이 같은 순서로 변형 묶음 (예: 콤보 인스팅트 400011074/075/076).
		-- 시전마다 하나를 골라 그 번호의 이펙트·소리를 함께 쓴다.
		if p.policy == "random" then
			local fxs = {}
			for ruid in string.gmatch(p.fx or "", "[^|]+") do table.insert(fxs, ruid) end
			if #fxs > 0 then
				local k = _UtilLogic:RandomIntegerRange(1, #fxs)
				r.variant = k
				r.fx = fxs[k]
				r.casterFx = self:TagScale(self:PickAt(p.casterFx or "", k), p.fxScale or 1)
				r.useSound = self:PickAt(p.useSound or "", k)
				r.hitSound = self:PickAt(p.hitSound or "", k)
			end
			r.policy = "per_hit"
		end
		if sk.kind == "버프" or sk.kind == "소환" or sk.kind == "충전" then
			r.actionFrames = p.actionFrames or ""
			r.actionTime = p.actionTime or 0.8
		end
		-- 발사체 스킬: 바로 때리지 않고 발사체가 몬스터에 닿을 때 타격
		r.shotRuid = self:ShotRUID(sk.id)
		return r
	end

	@ExecSpace("ServerOnly")
	method string ShotRUID(string id)
		-- 이 스킬의 발사체 그림 (발사체 스킬이 아니면 "").
		for pair in string.gmatch(self.ShotRUIDs, "[^;]+") do
			local k, v = string.match(pair, "^%s*([^:]+):(%x+)")
			if k == id then return v end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method string ShotType(string id)
		-- 이 스킬의 발사체 타입: "pierce"(관통형) 또는 "stop".
		for pair in string.gmatch(self.ShotRUIDs, "[^;]+") do
			local k, t = string.match(pair, "^%s*([^:]+):%x+:?(%a*)")
			if k == id then
				if t == "pierce" then return "pierce" end
				return "stop"
			end
		end
		return "stop"
	end

	@ExecSpace("ServerOnly")
	method void LaunchShot(Component mgr, table r, Entity target)
		-- 발사: 캐릭터 몸 중심에서 몬스터 몸 가운데 쪽으로. 서버도 같은 속도로 위치를 따라가다가 몬스터에 닿으면 타격한다.
		local player = self.Entity
		if not isvalid(player) then return end
		local p = player.TransformComponent.WorldPosition
		local start = Vector3(p.x + self.ShotOrigin.x, p.y + self.ShotOrigin.y, p.z)
		local aim = Vector3(start.x + 1, start.y, start.z)
		if isvalid(target) then aim = self:HitPos(target, 0, 0) end
		local dx = aim.x - start.x
		local dy = aim.y - start.y
		local len = math.sqrt(dx * dx + dy * dy)
		if len < 0.001 then
			dx = 1
			dy = 0
			len = 1
		end
		local dir = Vector3(dx / len, dy / len, 0)
		self._T.shotSeq = (self._T.shotSeq or 0) + 1
		local sid = self._T.shotSeq
		table.insert(self._T.shotList, { sid = sid, r = r, x = start.x, dir = dir, moved = 0, pierce = self:ShotType(r.id) == "pierce", hitSet = {} })
		if isvalid(player.PlayerComponent) then
			self:ShowShot(sid, r.shotRuid, start, dir, self.ShotSpeed, self.ShotRange, r.shotScale or r.fxScale or 1, player.PlayerComponent.UserId)
		end
		log("[VRF] hero shot launch " .. tostring(r.id) .. " sid=" .. tostring(sid) .. " dist=" .. string.format("%.2f", len))
	end

	@ExecSpace("ServerOnly")
	method void TickShots(number delta)
		-- 발사체 이동·충돌 (몬스터 교체 중에도 계속 난다): 지금 몬스터 몸 앞에 닿으면 그 몬스터에 타격.
		-- 관통형은 몬스터마다 한 번씩 피해를 주고 화면 밖(사거리 끝)까지 날아가고, 아니면 첫 몬스터에서 사라진다.
		local list = self._T.shotList
		if list == nil or #list == 0 then return end
		local mgr = self._T.mgr
		local mon = nil
		if mgr ~= nil then mon = mgr:HeroMonster() end
		local alive = self:Alive(mon)
		local step = self.ShotSpeed * delta
		for i = #list, 1, -1 do
			local s = list[i]
			s.x = s.x + s.dir.x * step
			s.moved = s.moved + step
			local hit = false
			if alive and not s.hitSet[mon] then
				local mx = mon.TransformComponent.WorldPosition.x
				if s.dir.x >= 0 then hit = s.x >= mx - self.ShotReach else hit = s.x <= mx + self.ShotReach end
			end
			if hit then
				s.hitSet[mon] = true
				s.hits = (s.hits or 0) + 1
				log("[VRF] hero shot hit " .. tostring(s.r.id) .. " sid=" .. tostring(s.sid) .. " moved=" .. string.format("%.2f", s.moved) .. " pierce=" .. tostring(s.pierce))
				local r = s.r
				-- 관통해서 두 번째 몬스터부터는 타격만 (재발동·추가 공격은 첫 적중 1회)
				if s.hits > 1 then
					r = {}
					for k, v in pairs(s.r) do r[k] = v end
					r.hitsOnly = true
					r.carryFxHit = nil
				end
				if not s.pierce then
					table.remove(list, i)
					self:EndShotFor(s.sid)
				end
				self:ApplyStrikes(mgr, r, mon)
			elseif s.moved >= self.ShotRange then
				table.remove(list, i)
				log("[VRF] hero shot end sid=" .. tostring(s.sid) .. " hits=" .. tostring(s.hits or 0))
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void EndShotFor(integer sid)
		-- 충돌한 발사체를 플레이어 화면에서 숨긴다.
		local mgr = self._T.mgr
		local player = self.Entity
		if isvalid(player) and isvalid(player.PlayerComponent) then self:EndShot(sid, player.PlayerComponent.UserId) end
	end

	@ExecSpace("ServerOnly")
	method void AddHits(table r, integer n, number pct, number bonusPct, boolean forceCrit)
		-- 같은 계수 타격 n회를 결과에 쌓는다.
		for i = 1, n do
			local s = self:Strike(r.id, pct, bonusPct, true, forceCrit)
			table.insert(r.hitDmg, s.dmg)
			table.insert(r.hitCrit, s.crit)
		end
	end

	@ExecSpace("ServerOnly")
	method number SumHits(table r)
		-- 타격 묶음 총 피해.
		local sum = 0
		for _, d in ipairs(r.hitDmg) do sum = sum + d end
		return sum
	end

	@ExecSpace("ServerOnly")
	method number ConsumeBonus(table sk, number base, number upgraded, integer breakN, boolean consumed)
		-- 콤보 소모 보너스 (+기본 / 돌파 시 대체) + 인레이지 '콤보 폭주'·에픽 '불굴의 도전자'.
		if not consumed then return 0 end
		local v = base
		if self:Has(sk.id, breakN) then v = upgraded end
		local extra = 0
		return v + extra
	end

	@ExecSpace("ServerOnly")
	method number BleedBurst(integer maxStacks, number pctPer, string id)
		-- 자상을 오래된 순서로 최대 maxStacks 소비하고, 중첩당 공격력 pctPer% 추가 피해(치명 가능)를 돌려준다.
		local n = self:MS():ConsumeBleed(maxStacks)
		if n <= 0 then return 0 end
		local mgr = self._T.mgr
		if mgr ~= nil then self:UpdateBleedMark(mgr:HeroMonster()) end
		local bonus = 0
		local s = self:Strike(id, pctPer * n, bonus, true, false)
		log("[VRF] hero bleed burst " .. id .. " stacks=" .. tostring(n) .. " dmg=" .. tostring(s.dmg))
		return s.dmg
	end

	@ExecSpace("ServerOnly")
	method integer ConsumeBleed(integer maxStacks)
		-- (몬스터 상태 담당이 호출됨) 자상을 오래된 순서로 최대 maxStacks 지우고 지운 수를 돌려준다. maxStacks가 0 이하면 전부.
		local list = self._T.bleed
		local n = #list
		if maxStacks > 0 then n = math.min(maxStacks, n) end
		for i = 1, n do table.remove(list, 1) end
		self._T.bleed = list
		self.Bleed = #list
		return n
	end

	@ExecSpace("ServerOnly")
	method table MakeRift()
		-- 콤보 인스팅트 지속 중 기본 공격에 동반하는 균열 (동작 없음).
		-- 연출: NewCast가 고른 변형(400011074/075/076 중 하나)의 캐릭터 이펙트 + 몬스터 히트 이펙트 + 시전음·피격음.
		local sk = self._T.skills["H15"]
		local r = self:NewCast(sk)
		r.actionFrames = ""
		r.rift = true
		local bonus = self:Star("H15", "StarPower")
		if self:Has("H15", 4) then bonus = bonus + 60 end
		local s = self:Strike("H15", sk.proc.pct, bonus - self:Star("H15", "StarPower"), true, false)
		table.insert(r.hitDmg, s.dmg)
		table.insert(r.hitCrit, s.crit)
		return r
	end

	@ExecSpace("ServerOnly")
	method table MakeCast(table sk)
		-- 스킬 시전 결과를 미리 계산한다 (판정은 시전 순간, 연출은 공격 동작 타격 순간).
		local mgr = self._T.mgr
		local id = sk.id
		local p = sk.proc
		local r = self:NewCast(sk)
		local hpLow = mgr.MonsterHp <= mgr.MonsterMaxHp * 0.5
		if id == "H01" then
			self:AddHits(r, p.hits, p.pct, 0, false)
			r.comboGain = 1
			if self:Has(id, 3) then r.comboGain = 3 end
			if self:Has(id, 4) then r.bleedAdd = 2 end
			if self:Has(id, 2) then table.insert(r.after, { delay = p.hits * r.gap + 0.15, dmg = math.floor(self:SumHits(r) * 0.6 + 0.5), fx = p.fx }) end
		elseif id == "H02" then
			local hits = p.hits
			if self:Has(id, 1) then hits = hits + 1 end
			local bonus = 0
			if self:Has(id, 3) and self.Combo >= 8 then bonus = bonus + 80 end
			self:AddHits(r, hits, p.pct, bonus, false)
			if self:Has(id, 5) then
				r.comboGain = 2
				r.manaGain = 4
			end
		elseif id == "H03" then
			-- 패닉: 가진 콤보를 최대 3(돌파 '과열' 6)까지 소비, 소비한 콤보 1당 피해 +20%(과열 +30%). 1·2만 있어도 그만큼 소비
			local maxUse = sk.comboUse or 3
			local per = sk.comboBonus or 20
			if self:Has(id, 3) then
				maxUse = 6
				per = 30
			end
			local n = math.min(maxUse, self.Combo)
			local used = n > 0 and self:UseCombo(n)
			local cb = 0
			if used then
				cb = n * per
				-- 인레이지 '콤보 폭주'·에픽 '불굴의 도전자' 추가 보너스 (콤보 소비 시)
				cb = cb + self:ConsumeBonus(sk, 0, 0, 0, true)
			end
			local s = self:Strike(id, p.pct, 0, true, false)
			s.dmg = math.floor(s.dmg * (1 + cb / 100) + 0.5)
			table.insert(r.hitDmg, s.dmg)
			table.insert(r.hitCrit, s.crit)
			r.consumed = used
			r.comboSpent = used and n or 0
			-- 공포의 일격: 100% 확률로 암흑 / 처형자: 체력 15% 이하 즉시 처치 / 흉터: 자상 3중첩
			if self:Has(id, 1) then r.debuff = "Darkness" end
			if self:Has(id, 2) then r.execute = self.PanicExecuteRatio end
			if self:Has(id, 5) then
				r.bleedAdd = 2
				r.bleedSrc = id
				-- 흉터: 붉은 패닉 이펙트 (시전·히트)
				local sc = (p.fxScale or 1) * self.PanicRedScale
				r.casterFx = self:TagScale(self.PanicRedCasterFx, sc)
				r.fx = self.PanicRedHitFx
				r.fxScale = sc
			end
			log("[VRF] panic combo used=" .. tostring(r.comboSpent) .. " bonus=" .. tostring(cb) .. "%")
		elseif id == "H04" then
			local bonus = 0
			if self:Has(id, 1) then r.comaField = true end
			local before = self.Combo
			local used = self:UseCombo(sk.comboUse or 2)
			local cb = self:ConsumeBonus(sk, sk.comboBonus or 50, sk.comboBonus or 50, 0, used)
			local s = self:Strike(id, p.pct, bonus, true, false)
			s.dmg = math.floor(s.dmg * (1 + cb / 100) + 0.5)
			table.insert(r.hitDmg, s.dmg)
			table.insert(r.hitCrit, s.crit)
			r.stun = 2
			r.consumed = used
			-- 돌파 5 '흉터': 적중 시 자상 3중첩 (방어력 감소)
			if self:Has(id, 5) then
				r.bleedAdd = 3
				r.bleedSrc = id
			end
			-- 돌파 2 '투지 회수': 소비한 콤보의 절반(내림)을 시전 후 돌려받는다
			if used and self:Has(id, 2) then
				local back = math.floor((sk.comboUse or 2) / 2)
				if back > 0 then r.comboGain = (r.comboGain or 0) + back end
			end
			-- 코마 시전 그림: 쓰기 직전 콤보 수에 맞는 finish 단계 (콤보가 높을수록 큰 그림)
			local stage = math.max(1, math.min(10, math.floor(before)))
			local n = 0
			for ruid in string.gmatch(self.ComaFinishRUIDs, "[^|]+") do
				n = n + 1
				if n == stage then r.casterFx = ruid end
			end
			log("[VRF] coma stage=" .. tostring(stage) .. " used=" .. tostring(used))
		elseif id == "H10" then
			-- 발할라: 충전을 최대치로 새로 채움. 4-G 보완: 쿨타임은 시전 순간부터 (돌파 5 '1회 발동'만 충전을 다 쓴 뒤부터)
			local n = self.ValhallaCharges
			if self:Has(id, 2) then n = self.ValhallaChargesUp end
			self._T.cd.H10 = self:Has(id, 5) and 0 or self:Cooldown(sk)
			if self:Has(id, 5) then
				-- 돌파 5: 동작 없이 1회 충전, 피해 = 충전량 배수
				self._T.valCharge = 1
				self._T.valMul = n * self.ValhallaOneShotMulPct / 100
				r.actionFrames = ""
				r.actionTime = 0
			else
				self._T.valCharge = n
				self._T.valMul = 1
			end
			log("[VRF] valhalla charge=" .. tostring(self._T.valCharge) .. " mul=" .. tostring(self._T.valMul))
		elseif id == "H05" or id == "H11" then
			r.buff = true
		elseif id == "H06" then
			local bonus = 0
			-- 돌파 1 '영혼 절개': 피해 +60%, 자상 1중첩당 +6%, 강화 시전 그림
			if self:Has(id, 1) then
				bonus = bonus + 60 + #self:MS()._T.bleed * self.IncisingBleedPct
				r.casterFx = self:TagScale(self.IncisingEnhCasterFx, p.fxScale or 1)
			end
			self:AddHits(r, p.hits, p.pct, bonus, false)
			-- 기본: 화상 (인사이징 전용 IncisingBurn)
			r.debuff = "IncisingBurn"
			-- 돌파 2 '흉터': 자상 3중첩
			if self:Has(id, 2) then
				r.bleedAdd = self.IncisingBleedAdd
				r.bleedSrc = id
			end
		elseif id == "H07" then
			local bonus = 0
			if self:Has(id, 1) then
				bonus = bonus + 60
				-- 거대한 검기: 강화 시전 이펙트 + 강화 발사체 (재발동도 같은 그림)
				r.casterFx = self:TagScale(self.AuraEnhCastRUID, (p.fxScale or 1) * self.AuraEnhCastScale)
				r.shotRuid = self.AuraEnhShotRUID
				r.shotScale = (p.fxScale or 1) * self.AuraEnhScale
			end
			self:AddHits(r, p.hits, p.pct, bonus, false)
			if self:Has(id, 3) then table.insert(r.after, { delay = 0.6, dmg = math.floor(self:SumHits(r) * 0.6 + 0.5), fx = p.fx }) end
			if self:Has(id, 5) then
				r.chargeGain = 2
				r.summonBoost = 30
			end
		elseif id == "H08" then
			local hits = p.hits
			-- 돌파 1 '폭풍의 검격': 6연타 + 원래 쓰던 레이징 블로우 리소스(1120017)
			if self:Has(id, 1) then
				hits = hits + 3
				r.casterFx = self:TagScale(self.RagingStormCasterFx, p.fxScale or 1)
				r.fx = self.RagingStormHitFx
				r.hitSound = self.RagingStormHitSound
				r.policy = "once"
			end
			-- 돌파 3 '광속의 검': 이 스킬 공격(동작) 속도 +50%
			if self:Has(id, 3) then
				local speed = self:Star(id, "StarTempo") + self.RagingSpeedPct
				r.actionFrames = self:ScaleFrames(p.actionFrames or "", speed)
				r.actionTime = (p.actionTime or 0.8) / (1 + speed / 100)
				r.gap = (p.hitGap or 0.12) / (1 + speed / 100)
			end
			self:AddHits(r, hits, p.pct, 0, false)
			-- 돌파 4 '자상 폭발': 마지막 타격 뒤 쌓인 자상 전부 폭발 (ApplyStrikes)
			if self:Has(id, 4) then r.rageBurst = true end
		elseif id == "H09" then
			local bonus = 0
			-- 돌파 1 '고대의 격노': 피해 +60%, 시전 그림이 effect 대신 effect0 + effect1
			if self:Has(id, 1) then
				bonus = bonus + 60
				r.casterFx = self:TagScale(self.UprisingEnhCasterFx, p.fxScale or 1)
			end
			-- 돌파 3: 캐릭터 동작 없이 시전 (마나 절반은 CastCost)
			if self:Has(id, 3) then
				r.actionFrames = ""
				r.actionTime = 0
			end
			local s = self:Strike(id, p.pct, bonus, true, false)
			if self:Has(id, 2) then
				-- 돌파 2 '연쇄 분출': 같은 총 피해를 5타로 나눠 0.5초마다
				local n = self.UprisingSplitHits
				local each = math.max(1, math.floor(s.dmg / n + 0.5))
				for i = 1, n do
					table.insert(r.hitDmg, each)
					table.insert(r.hitCrit, s.crit)
				end
				r.gap = self.UprisingSplitGap
				r.policy = "per_hit"
			else
				table.insert(r.hitDmg, s.dmg)
				table.insert(r.hitCrit, s.crit)
			end
			-- 돌파 5 '화염의 분노': 화상 (디버프 표 Burn)
			if self:Has(id, 5) then r.debuff = "Burn" end
		elseif id == "H12" then
			r.summon = true
		elseif id == "H13" then
			-- 기본: 가진 콤보를 전부 소비 (시전 조건 콤보 5 이상)
			local n = self.Combo
			local used = self:UseCombo(n)
			if not used then n = 0 end
			-- 돌파 1: 소비한 콤보 1당 피해 +20%
			local bonus = 0
			if self:Has(id, 1) then bonus = bonus + n * self.DeathfaultComboPct end
			-- 돌파 3: 타수 +4
			local hits = math.max(1, p.hits or 1)
			if self:Has(id, 3) then hits = hits + self.DeathfaultHitsUp end
			-- 돌파 4: 시전 순간 몬스터 체력이 최대 체력의 90% 이상이면 피해 2배
			local mgr = self._T.mgr
			local fresh = false
			if self:Has(id, 4) and mgr ~= nil then
				local maxHp = tonumber(mgr.MonsterMaxHp) or 0
				fresh = maxHp > 0 and (tonumber(mgr.MonsterHp) or 0) >= maxHp * self.DeathfaultFreshHpPct / 100
			end
			for h = 1, hits do
				local st = self:Strike(id, p.pct, bonus, true, false)
				if fresh then st.dmg = math.floor(st.dmg * self.DeathfaultFreshMul + 0.5) end
				table.insert(r.hitDmg, st.dmg)
				table.insert(r.hitCrit, st.crit)
			end
			log("[VRF] deathfault combo=" .. tostring(n) .. " bonus=" .. tostring(bonus) .. " hits=" .. tostring(hits) .. " fresh=" .. tostring(fresh))
			-- 공간 가르기 그림만 크게 (첫 그림은 원래 크기)
			r.casterFx = self.DeathfaultCastRUID .. "|" .. self.DeathfaultSlashRUID .. "@" .. tostring(self.DeathfaultSlashScale) .. "@" .. tostring(self.DeathfaultSlashX) .. "," .. tostring(self.DeathfaultSlashY)
			-- 무적: 첫 타부터 마지막 타가 끝날 때까지
			r.invuln = hits * r.gap + 0.5
			r.consumed = used
		elseif id == "H14" then
			local bonus = 0
			if self:Has(id, 1) then bonus = bonus + 60 end
			-- 기본: 환영 스택당 피해 +10%, 사용하면 스택 초기화
			local st = self._T.illusionStack or 0
			bonus = bonus + st * self.IllusionStackPct
			self._T.illusionStack = 0
			log("[VRF] illusion stack=" .. tostring(st) .. " bonus=" .. tostring(bonus))
			self:AddHits(r, p.hits, p.pct, bonus, false)
			-- 자상 파열 (돌파 3 '상흔 붕괴': 상한 10, 중첩당 150%)
			local maxStack = 5
			local per = 80
			if self:Has(id, 3) then
				maxStack = 10
				per = 150
			end
			local burst = self:BleedBurst(maxStack, per, id)
			if burst > 0 then table.insert(r.after, { delay = p.hits * r.gap + 0.1, dmg = burst, fx = self.BleedFxRUID }) end
			-- 돌파 4 '깊은 상처': 참격 1타마다 자상 1중첩 (파열 뒤에 남아 다음 시전의 환영 스택이 됨)
			if self:Has(id, 4) then
				r.bleedAdd = p.hits
				r.bleedSrc = id
			end
		elseif id == "H15" then
			r.instinct = true
		end
		-- 재발동: 같은 스킬이 한 번 더 (브랜디쉬·오라 블레이드 기본, 슬래시 블러스트는 돌파 '연쇄 베기')
		local rc = self:RecastChanceOf(id)
		if rc > 0 and #r.hitDmg > 0 and _UtilLogic:RandomDouble() * 100 < rc then
			local mul = 1
			if id == "H07" and self:Has("H07", 4) then mul = 1.6 end
			if id == "H02" and self:Has("H02", 6) then mul = 1.6 end
			local rec = { dmg = {}, crit = {} }
			for i, d in ipairs(r.hitDmg) do
				table.insert(rec.dmg, math.floor(d * mul + 0.5))
				table.insert(rec.crit, r.hitCrit[i] == true)
			end
			r.recast = rec
			-- 업라이징 돌파 '재발동의 탄력': 재발동마다 업라이징 쿨타임 -2초
			if self:Learned("H09") and self:Has("H09", 4) then self._T.cd["H09"] = math.max(0, (self._T.cd["H09"] or 0) - 2) end
			log("[VRF] hero recast " .. id)
		end
		-- 발할라: 직접 공격 스킬 적중마다 충전 1회로 추가타
		if id ~= "H10" and #r.hitDmg > 0 then self:UseValhalla(r) end
		-- 에픽 어드벤쳐 돌파 2: 직접 공격 1타마다 쿨타임 감소
		if #r.hitDmg > 0 then self:EpicCdCut(#r.hitDmg) end
		-- 검술 공통: 소환검 충전, 피로 물든 검, 파멸의 잔흔
		if sk.kind == "검술" then self:OnSwordCast(r) end
		log("[VRF] hero cast " .. id .. " hits=" .. tostring(#r.hitDmg) .. " sum=" .. tostring(self:SumHits(r)) .. " combo=" .. tostring(self.Combo) .. " mana=" .. tostring(math.floor(self.Mana)))
		return r
	end

	@ExecSpace("ServerOnly")
	method number RecastChanceOf(string id)
		-- 재발동 확률 %: 브랜디쉬·오라 블레이드 기본 RecastChance (브랜디쉬 돌파 '연속 재발동' 55%), 슬래시 블러스트 돌파 '연쇄 베기' 25%.
		if id == "H02" then
			if self:Has("H02", 4) then return 55 end
			return self.RecastChance
		elseif id == "H07" then
			return self.RecastChance
		elseif id == "H08" then
			-- 레이징 블로우: 낮은 확률, 돌파 2 '연속 재발동'이면 증가
			if self:Has("H08", 2) then return self.RagingRecastChanceUp end
			return self.RagingRecastChance
		elseif id == "H01" and self:Has("H01", 5) then
			return 25
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void PlayRecast(Component mgr, table r, Entity target)
		-- 재발동: 같은 스킬의 캐릭터 이펙트·시전음을 다시 내고, 같은 타수를 다시 넣는다 (대상이 죽으면 다음 몬스터로).
		local rec = r.recast
		if rec == nil then return end
		local player = self.Entity
		local casterFx = r.casterFx or ""
		local hitFx = r.fx or ""
		if r.id == "H02" then
			casterFx = self:TagScale(self.BrandishRecastCasterFx, r.fxScale or 1)
			hitFx = self.BrandishRecastHitFx
		end
		if isvalid(player) then
			for entry in string.gmatch(casterFx, "[^|]+") do
				local ruid, sc = string.match(entry, "^([^@]+)@?(.*)$")
				local s = tonumber(sc) or 1
				_EffectService:PlayEffectAttached(ruid, player, Vector3(0, 0, 0), 0, Vector3(s, s, 1), false, { FlipX = player.TransformComponent.Scale.x > 0 })
			end
		end
		self:PlaySound(r.useSound)
		local r2 = {}
		for k, v in pairs(r) do r2[k] = v end
		r2.hitDmg = rec.dmg
		r2.hitCrit = rec.crit
		r2.fx = hitFx
		r2.recast = nil
		r2.carryFxHit = nil
		local live = target
		if not self:Alive(live) then live = mgr:HeroMonster() end
		if (r2.shotRuid or "") ~= "" then
			r2.hitsOnly = true
			self:LaunchShot(mgr, r2, live)
		else
			for h = 1, #rec.dmg do
				local hit = h
				_TimerService:SetTimerOnce(function() self:ApplyHit(r2, live, hit) end, math.max(0.01, (h - 1) * (r.gap or 0.06)))
			end
		end
		-- 재발동도 검술 1회로 소환검 충전
		local s = self._T.summon
		if s ~= nil then
			s.charge = s.charge + 1
			self.SwordCharge = s.charge
		end
	end

	@ExecSpace("ServerOnly")
	method void UseValhalla(table r)
		-- 발할라 충전 1회로 추가타 예약. 돌파 3은 50% 확률로 충전을 쓰지 않음. (돌파 5는 다 쓰면 쿨타임 시작, 그 밖은 시전 순간부터 쿨타임)
		if (self._T.valCharge or 0) <= 0 then return end
		local sk = self._T.skills["H10"]
		if sk == nil then return end
		local hit = self:Strike("H10", sk.proc.pct * (self._T.valMul or 1), 0, true, false)
		r.valhalla = { dmg = hit.dmg, crit = hit.crit,
			combo = self:Has("H10", 1) and _UtilLogic:RandomDouble() * 100 < self.ValhallaComboChance,
			bleed = self:Has("H10", 4) }
		local refund = self:Has("H10", 3) and _UtilLogic:RandomDouble() * 100 < self.ValhallaRefundChance
		if not refund then self._T.valCharge = self._T.valCharge - 1 end
		if self._T.valCharge <= 0 and self:Has("H10", 5) then self._T.cd.H10 = self:Cooldown(sk) end
		log("[VRF] valhalla use dmg=" .. tostring(hit.dmg) .. " left=" .. tostring(self._T.valCharge) .. " refund=" .. tostring(refund) .. " combo=" .. tostring(r.valhalla.combo) .. " bleed=" .. tostring(r.valhalla.bleed))
	end

	@ExecSpace("ServerOnly")
	method void OnSwordCast(table r)
		-- 검술 1회(스킬 사용 단위): 연계 보너스·충전·발할라·자상·잔흔.
		local id = r.id
		local prev = self._T.lastSword
		self._T.lastSword = id
		-- 소환검 충전
		local s = self._T.summon
		if s ~= nil then
			local c = 1
			s.charge = s.charge + c + (r.chargeGain or 0)
			self.SwordCharge = s.charge
		end
		-- 데스폴트 '파멸의 잔흔'
		local echo = self._T.deathfaultEcho
		if echo ~= nil and echo.left > 0 and id ~= "H13" then
			echo.left = echo.left - 1
			table.insert(r.after, { delay = 0.35, dmg = echo.dmg, fx = "2ef064f22b8542a093e4d95becd2349a" })
			if echo.left <= 0 then self._T.deathfaultEcho = nil end
		end
	end

	-- ========== 적용 (공격 동작의 타격 순간) ==========

	@ExecSpace("ServerOnly")
	method void PlaySound(string ruid)
		-- 플레이어에게 효과음.
		if ruid == nil or ruid == "" then return end
		local mgr = self._T.mgr
		local player = self.Entity
		if isvalid(player) and isvalid(player.PlayerComponent) then _SoundService:PlaySound(ruid, self.SoundVolume, player.PlayerComponent.UserId) end
	end

	@ExecSpace("ServerOnly")
	method boolean Alive(Entity target)
		-- 대상이 아직 지금 싸우는 몬스터인지.
		local mgr = self._T.mgr
		return mgr ~= nil and mgr.RunState == "FIGHT" and isvalid(target) and target == mgr:HeroMonster()
	end

	@ExecSpace("ServerOnly")
	method Vector3 HitPos(Entity target, number ox, number oy)
		-- 몬스터 몸 가운데 기준 위치 (스폰 때 잰 높이, 강화 몬스터는 크기 반영).
		local wp = target.TransformComponent.WorldPosition
		local sc = target.TransformComponent.Scale.y
		return Vector3(wp.x + ox, wp.y + self._T.monMid * sc + oy, wp.z)
	end

	@ExecSpace("ServerOnly")
	method void ApplyCast(Component mgr, table r, Entity target)
		-- 시전 결과 적용: 버프·소환·기절·자상, 타격(이펙트·사운드·숫자), 추가 공격.
		self._T.mgr = mgr
		if r.comboGain ~= nil then self:AddCombo(r.comboGain) end
		if r.manaGain ~= nil then self:AddMana(r.manaGain) end
		if r.buff then self:ApplyBuff(r) end
		if r.summon then self:StartSummon(r) end
		if r.instinct then self:StartInstinct(r) end
		if r.invuln ~= nil then self._T.till.inv = self:Now() + r.invuln end
		if r.id == "H13" and self:Has("H13", 4) then self._T.till.H13w = self:Now() + 4 end
		if r.summonBoost ~= nil then self._T.summonBoost = r.summonBoost end
		if r.swordCommand then self:SwordCommand() end
		if r.rift and self:Has("H15", 4) then self:AddMana(1) end
		-- 발사체 스킬은 발사만 하고, 타격은 발사체가 몬스터에 닿을 때 (TickShots → ApplyStrikes)
		if (r.shotRuid or "") ~= "" and #r.hitDmg > 0 then
			self:LaunchShot(mgr, r, target)
			return
		end
		self:ApplyStrikes(mgr, r, target)
	end

	@ExecSpace("ServerOnly")
	method void ApplyStrikes(Component mgr, table r, Entity target)
		-- 타격: 연타(간격 r.gap), 추가 공격, 재발동 예약, 발할라 추가 검격, 기절·자상.
		local n = #r.hitDmg
		local gap = r.gap
		for h = 1, n do
			local hit = h
			if h == 1 then
				self:ApplyHit(r, target, 1)
			else
				_TimerService:SetTimerOnce(function() self:ApplyHit(r, target, hit) end, (h - 1) * gap)
			end
		end
		-- 재발동으로 다시 쏜 발사체는 타격만
		if r.hitsOnly then return end
		for _, a in ipairs(r.after) do
			local info = a
			_TimerService:SetTimerOnce(function() self:ApplyExtra(target, info.dmg, info.fx, false, r.hitSound, r.targets or 1) end, info.delay)
		end
		-- 재발동: 이번 타수가 끝난 뒤 같은 스킬 한 번 더
		if r.recast ~= nil then
			local info = r
			_TimerService:SetTimerOnce(function() self:PlayRecast(mgr, info, target) end, n * (r.gap or 0.06) + self.RecastDelay)
		end
		if r.valhalla ~= nil then
			local v = r.valhalla
			self:PlayValhalla(target, v.dmg, v.crit, 0, v.combo == true, v.bleed == true)
		end
		-- 기절·자상은 첫 타가 실제로 들어간 뒤 (그사이 쓰러졌으면 걸지 않음)
		if r.stun ~= nil and n > 0 and self:Alive(target) then self:ApplyStun(mgr, r, target) end
		-- 범위로 맞은 줄 선 몬스터도 기절 (그동안 공격하지 않음)
		if r.stun ~= nil and n > 0 then
			for _, e in ipairs(r.splashHit or {}) do
				if isvalid(e) and e ~= target then self:StunQueued(e, r.stun) end
			end
		end
		if r.comaField and n > 0 then
			_TimerService:SetTimerOnce(function() self:StartComaField(target) end, self.ComaFieldDelay)
		end
		-- 디버프·자상: 첫 타에 실제로 맞은 몬스터(맨 앞 + 범위 안 대기열)마다 확률로 (DebuffTable Chance)
		if n > 0 and (r.debuff ~= nil or (r.bleedAdd or 0) > 0) then
			local list = {}
			if self:Alive(target) then table.insert(list, target) end
			for _, e in ipairs(r.splashHit or {}) do
				if isvalid(e) and e ~= target then table.insert(list, e) end
			end
			self:ApplyStatusTo(r, list)
		end
		if r.rageBurst and n > 0 then
			local info = r
			_TimerService:SetTimerOnce(function() self:RageBurst(info, target) end, n * (r.gap or 0.06) + 0.1)
		end
	end

	@ExecSpace("ServerOnly")
	method void RageBurst(table r, Entity target)
		-- 레이징 블로우 돌파 4: 쌓인 자상을 전부 소비해 중첩마다 폭발(공격력 RagingBurstPct%, 치명 가능).
		-- 폭발은 RagingBurstTime초 안에 나눠 터지고 위치는 조금씩 랜덤. 중간에 몬스터가 쓰러지면 남은 폭발은 다음 몬스터에게 (ApplyHit 넘김 규칙).
		local n = #(self:MS()._T.bleed or {})
		if n <= 0 then return end
		local burst = { hero = true, id = "H08burst", sk = r.sk, hitDmg = {}, hitCrit = {}, after = {}, fx = self.RagingBurstFxRUID, fxScale = 1,
			policy = "per_hit", hitSound = r.hitSound or "", mobFx = "", fxJitter = self.RagingBurstJitter }
		for i = 1, n do
			local s = self:Strike("H08", self.RagingBurstPct, 0, true, false)
			table.insert(burst.hitDmg, s.dmg)
			table.insert(burst.hitCrit, s.crit)
		end
		self:MS():ConsumeBleed(0)
		self:UpdateBleedMark(target)
		local gap = 0
		if n > 1 then gap = self.RagingBurstTime / (n - 1) end
		for h = 1, n do
			local hit = h
			if h == 1 then
				self:ApplyHit(burst, target, 1)
			else
				_TimerService:SetTimerOnce(function() self:ApplyHit(burst, target, hit) end, (h - 1) * gap)
			end
		end
		log("[VRF] raging burst stacks=" .. tostring(n))
	end

	@ExecSpace("ServerOnly")
	method void ApplyHit(table r, Entity target, integer h)
		-- 타격 h: 피격 이펙트(긴 이펙트는 1회만, 짧으면 타마다 번갈아)·피격음·데미지 숫자·HP 감소.
		-- 연타 중 대상이 죽으면 남은 타격은 다음 몬스터로 넘어간다 (이미 나와 있으면 바로, 아니면 등장할 때).
		if not self:Alive(target) then
			local mgr0 = self._T.mgr
			local cur = nil
			if mgr0 ~= nil and mgr0.RunState == "FIGHT" then cur = mgr0:HeroMonster() end
			if isvalid(cur) and cur ~= target and self:Alive(cur) then
				if r.carryFxHit == nil then r.carryFxHit = h end
				target = cur
			else
				if (r.hitDmg[h] or 0) > 0 then table.insert(self._T.carry, { r = r, h = h }) end
				return
			end
		end
		local mgr = self._T.mgr
		local show = r.policy == "per_hit" or h == 1 or r.carryFxHit == h
		if show and r.fx ~= "" then
			local list = {}
			for ruid in string.gmatch(r.fx, "[^|]+") do table.insert(list, ruid) end
			if #list > 0 then
				local ruid = list[(h - 1) % #list + 1]
				local ox = 0
				local oy = 0
				if (r.fxJitter or 0) > 0 then
					ox = (_UtilLogic:RandomDouble() * 2 - 1) * r.fxJitter
					oy = (_UtilLogic:RandomDouble() * 2 - 1) * r.fxJitter
				elseif r.policy == "per_hit" and h > 1 then
					ox = ((h - 1) % 3 - 1) * 0.1
					oy = (math.floor((h - 1) / 3) % 2) * 0.1
				end
				_EffectService:PlayEffect(ruid, target, self:HitPos(target, ox, oy), 0, Vector3(r.fxScale, r.fxScale, 1), false, { FlipX = true })
			end
		end
		if h == 1 and r.mobFx ~= "" and r.id ~= "H04" and r.id ~= "H06" and r.id ~= "H03" then
			_EffectService:PlayEffectAttached(r.mobFx, target, Vector3(0, self._T.monTop, 0), 0, Vector3(1, 1, 1), false)
		end
		if r.policy == "per_hit" or h == 1 then self:PlaySound(r.hitSound) end
		local dmg = r.hitDmg[h] or 0
		if dmg <= 0 then return end
		local crit = r.hitCrit[h] == true
		local pc = self.Entity:GetComponent("script.TowerPlayer")
		if pc ~= nil then pc:ShowProcDamageAt(target, dmg, crit, (h - 1) * self.HitNumGap) end
		-- 범위 스킬: 맨 앞 뒤로 줄 선 몬스터도 (최대 타격 수 - 1)마리까지 같은 피해 (앞 몬스터가 이 타격에 쓰러져도 맞음)
		local splash = {}
		if (r.targets or 1) > 1 then splash = mgr:SplashTargets(r.targets - 1) end
		if h == 1 then r.splashHit = splash end
		mgr:ApplyMonsterDamage(dmg)
		if crit then mgr:OnPlayerCrit() end
		for _, e in ipairs(splash) do
			if not isvalid(e) or e.TransformComponent == nil then continue end
			if show and r.fx ~= "" then
				local list = {}
				for ruid in string.gmatch(r.fx, "[^|]+") do table.insert(list, ruid) end
				local ruid = list[(h - 1) % #list + 1]
				local wp = e.TransformComponent.WorldPosition
				_EffectService:PlayEffect(ruid, e, Vector3(wp.x, wp.y + self._T.monMid, wp.z), 0, Vector3(r.fxScale, r.fxScale, 1), false, { FlipX = true })
			end
			mgr:ApplySplashDamage(e, dmg, crit, (h - 1) * self.HitNumGap)
		end
		if r.execute ~= nil and h == #r.hitDmg and self:Alive(target) and mgr.MonsterHp > 0 and mgr.MonsterHp <= mgr.MonsterMaxHp * r.execute then
			local rest = math.ceil(mgr.MonsterHp)
			if pc ~= nil then pc:ShowProcDamage(target, rest, true) end
			mgr:ApplyMonsterDamage(rest)
			log("[VRF] panic execute dmg=" .. tostring(rest))
		end
	end

	@ExecSpace("ServerOnly")
	method table ApplyExtra(Entity target, integer dmg, string fx, boolean crit, string sound, integer targets)
		-- 추가 피해 (잔상·귀환·여진·파열·발할라·작은 검): 원본 스킬의 피격 그림 + 숫자.
		-- 범위: 맨 앞 몬스터 + 줄 선 몬스터 (targets-1)마리까지 같은 피해. 실제로 맞은 몬스터 목록을 돌려준다.
		local hit = {}
		if not self:Alive(target) or dmg <= 0 then return hit end
		local mgr = self._T.mgr
		local list = { target }
		if (targets or 1) > 1 then
			for _, e in ipairs(mgr:SplashTargets(targets - 1)) do table.insert(list, e) end
		end
		local first = ""
		if fx ~= nil and fx ~= "" then first = string.match(fx, "^([^|]+)") or fx end
		self:PlaySound(sound)
		local pc = self.Entity:GetComponent("script.TowerPlayer")
		for i, e in ipairs(list) do
			if not isvalid(e) or e.TransformComponent == nil then continue end
			if first ~= "" then
				local pos = nil
				if i == 1 then pos = self:HitPos(e, 0.08, 0.06)
				else
					local wp = e.TransformComponent.WorldPosition
					pos = Vector3(wp.x + 0.08, wp.y + self._T.monMid + 0.06, wp.z)
				end
				_EffectService:PlayEffect(first, e, pos, 0, Vector3(1, 1, 1), false, { FlipX = true })
			end
			if i == 1 then
				if pc ~= nil then pc:ShowProcDamage(e, dmg, crit) end
				mgr:ApplyMonsterDamage(dmg)
			else
				mgr:ApplySplashDamage(e, dmg, crit, 0)
			end
			table.insert(hit, e)
		end
		return hit
	end

	@ExecSpace("ServerOnly")
	method void PlayValhalla(Entity target, integer dmg, boolean crit, number delay, boolean combo, boolean bleed)
		-- 발할라 추가타: 영웅 혼령 베기 그림(1121055 summon/attack1~6 중 하나)을 몬스터 앞에 그리고 0.3초 뒤 피해 (돌파 1 콤보, 돌파 4 자상).
		local list = {}
		for ruid in string.gmatch(self.ValhallaSlashRUIDs, "[^|]+") do table.insert(list, ruid) end
		_TimerService:SetTimerOnce(function()
			if not self:Alive(target) then return end
			local ruid = list[_UtilLogic:RandomIntegerRange(1, #list)]
			local wp = target.TransformComponent.WorldPosition
			_EffectService:PlayEffect(ruid, target, Vector3(wp.x - 0.35, wp.y, wp.z), 0, Vector3(1, 1, 1), false, { FlipX = true })
			_TimerService:SetTimerOnce(function()
				if not self:Alive(target) then return end
				local vt = 1
				local vsk = self._T.skills["H10"]
				if vsk ~= nil then vt = vsk.proc.targets or 1 end
				local hit = self:ApplyExtra(target, dmg, "", crit, "d6b71bed8f0d450fb1fe81ba80a05362", vt)
				if combo then self:AddCombo(1) end
				-- 돌파 4: 맞은 몬스터마다 확률로 자상 1중첩
				if bleed then
					for _, e in ipairs(hit) do
						if _UtilLogic:RandomDouble() * 100 < self.ValhallaBleedChance then self:AddBleedTo(1, "H10", e) end
					end
				end
			end, 0.3)
		end, delay)
	end

	@ExecSpace("ServerOnly")
	method void ApplyBuff(table r)
		-- 인레이지·발할라·에픽 어드벤쳐: 지속시간(별 지속 +25%), 위력(별 +30%), 치명 강화는 캐릭터에게.
		local mgr = self._T.mgr
		local sk = r.sk
		local id = sk.id
		local dur = sk.buffTime * (1 + 0.25 * self:TempoMul(id))
		if id == "H15" then return end
		-- 인레이지 돌파 2: 지속시간 +50%
		if id == "H05" and self:Has(id, 2) then dur = dur * (1 + self.InrageDurBonusPct / 100) end
		-- 에픽 어드벤쳐 돌파 4: 지속 +5초
		if id == "H11" and self:Has(id, 4) then dur = dur + self.EpicDurUp end
		self._T.till[id] = self:Now() + dur
		local power = self:BuffPower(id)
		if id == "H05" then
			local v = 25 * power
			mgr:AddBuff("heroH05", "AtkPct", v, dur, 0)
			-- 돌파 1 '광분': 지속 중 공격속도 +20%
			if self:Has(id, 1) then mgr:AddBuff("heroH05spd", "Speed", self.InrageSpeedPct, dur, 0) end
			-- 돌파 5 '강철 의지': 지속 중 받는 피해 -20%
			if self:Has(id, 5) then mgr:AddBuff("heroH05def", "DmgReduce", self.InrageReducePct, dur, 0) end
			-- 지속 동안 캐릭터에 반복 이펙트
			self:RemoveSerial("H05aura")
			local player = self.Entity
			if isvalid(player) then self._T.serials.H05aura = _EffectService:PlayEffectAttached(self.InrageAuraRUID, player, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), true) end
		elseif id == "H11" then
			-- 기본: 체력 회복 + 지속 동안 보호막 (위력 별은 회복·보호막 양에 반영)
			local maxHp = mgr:ActorMaxHp(self.Entity)
			local healPct = self.EpicHealPct
			if self:Has(id, 3) then healPct = self.EpicHealUpPct end
			mgr:HealActor(self.Entity, maxHp * healPct * power / 100)
			local shieldPct = self.EpicShieldPct
			if self:Has(id, 1) then shieldPct = self.EpicShieldUpPct end
			shieldPct = shieldPct * power
			self:EndEpicShield()
			self._T.epicTick = 0
			self._T.epicLast = 0
			self._T.epicAtk = 0
			if self:Has(id, 5) then
				-- 돌파 5: 보호막 대신 공격력 (최대 체력 대비 보호막 % = 공격력 %)
				self._T.epicAtk = shieldPct
				mgr:AddBuff("heroH11", "AtkPct", self._T.epicAtk, dur, 0)
			else
				mgr:AddBuff("heroH11", "", 0, dur, 0)
				local amount = math.floor(maxHp * shieldPct / 100 + 0.5)
				mgr:AddShield(self.Entity, amount)
				self._T.epicShield = amount
			end
			local amount = self._T.epicShield
			-- 시전 그림(동작 연출)과 함께 보호막 그림을 지속 동안 반복
			self:RemoveSerial("H11aura")
			local player = self.Entity
			if isvalid(player) then self._T.serials.H11aura = _EffectService:PlayEffectAttached(self.EpicAuraRUID, player, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), true) end
			log("[VRF] epic heal+shield maxHp=" .. tostring(maxHp) .. " heal%=" .. tostring(healPct) .. " shield=" .. tostring(amount) .. " atk%=" .. tostring(self._T.epicAtk) .. " dur=" .. tostring(dur) .. " hp=" .. tostring(mgr:ActorHp(self.Entity)))
		end
		local crit = self:Star(id, "StarCrit")
		if crit > 0 then
			mgr:AddBuff("heroCrit" .. id, "Crit", crit, dur, 0)
			mgr:AddBuff("heroCritDmg" .. id, "CritDmg", crit * 2, dur, 0)
		end
		log("[VRF] hero buff " .. id .. " dur=" .. string.format("%.1f", dur))
	end

	@ExecSpace("ServerOnly")
	method void StartInstinct(table r)
		-- 콤보 인스팅트: 지속 중 콤보당 피해 5%, 콤보 감소 정지, 기본 공격에 균열 (재발동·갱신 없음).
		local id = "H15"
		local dur = r.sk.buffTime
		if self:Has(id, 2) then dur = dur * 1.5 end
		dur = dur * (1 + 0.25 * self:TempoMul(id))
		self._T.till.H15 = self:Now() + dur
		local mgr = self._T.mgr
		local crit = self:Star(id, "StarCrit")
		if crit > 0 then
			mgr:AddBuff("heroCritH15", "Crit", crit, dur, 0)
			mgr:AddBuff("heroCritDmgH15", "CritDmg", crit * 2, dur, 0)
		end
		log("[VRF] hero instinct on dur=" .. string.format("%.1f", dur))
	end

	@ExecSpace("ServerOnly")
	method void ApplyStun(Component mgr, table r, Entity target)
		-- 코마 기절: 몬스터 다음 공격 지연 + 머리 위 기절 별(지속 동안 반복).
		local sec = r.stun
		self:StunTarget(mgr, sec, target)
		log("[VRF] hero stun " .. tostring(sec) .. "s")
	end

	@ExecSpace("ServerOnly")
	method void EpicCdCut(integer hits)
		-- 에픽 어드벤쳐 돌파 2 '끝나지 않는 모험': 직접 공격 1타마다 남은 쿨타임 -0.5초.
		if hits <= 0 or not self:Has("H11", 2) then return end
		local cd = self._T.cd.H11 or 0
		if cd <= 0 then return end
		self._T.cd.H11 = math.max(0, cd - self.EpicCdPerHit * hits)
	end

	@ExecSpace("ServerOnly")
	method void EndEpicShield()
		-- 에픽 어드벤쳐 보호막 중 남은 몫을 걷어낸다 (층 보호막 등 다른 보호막은 그대로).
		local amount = self._T.epicShield or 0
		self._T.epicShield = 0
		local mgr = self._T.mgr
		if amount <= 0 or mgr == nil then return end
		local cur = mgr:ShieldOf(self.Entity)
		mgr:AddShield(self.Entity, -math.min(cur, amount))
	end

	@ExecSpace("ServerOnly")
	method void TickEpic()
		-- 에픽 어드벤쳐: 지속 중 1초마다 돌파 3 회복·돌파 4 보호막(돌파 5면 공격력). 끝나면 보호막 그림과 남은 보호막 제거.
		if self:On("H11") then
			local mgr = self._T.mgr
			if mgr == nil then return end
			if self:Now() - (self._T.epicLast or 0) < 1 then return end
			self._T.epicLast = self:Now()
			self._T.epicTick = (self._T.epicTick or 0) + 1
			if self._T.epicTick <= 1 then return end
			local maxHp = mgr:ActorMaxHp(self.Entity)
			if self:Has("H11", 3) then mgr:HealActor(self.Entity, maxHp * self.EpicRegenPct / 100) end
			if self:Has("H11", 4) then
				if self:Has("H11", 5) then
					self._T.epicAtk = (self._T.epicAtk or 0) + self.EpicShieldRegenPct
					mgr:AddBuff("heroH11", "AtkPct", self._T.epicAtk, (self._T.till.H11 or 0) - self:Now(), 0)
				else
					local add = math.floor(maxHp * self.EpicShieldRegenPct / 100 + 0.5)
					mgr:AddShield(self.Entity, add)
					self._T.epicShield = (self._T.epicShield or 0) + add
				end
			end
			log("[VRF] epic tick " .. tostring(self._T.epicTick) .. " hp=" .. tostring(mgr:ActorHp(self.Entity)) .. " shield=" .. tostring(mgr:ShieldOf(self.Entity)) .. " atk%=" .. tostring(self._T.epicAtk or 0))
			return
		end
		if (self._T.serials.H11aura or 0) ~= 0 then self:RemoveSerial("H11aura") end
		if (self._T.epicShield or 0) > 0 then
			self:EndEpicShield()
			log("[VRF] epic shield expired")
		end
	end

	@ExecSpace("ServerOnly")
	method void TickInrage()
		-- 인레이지: 장착했고 쿨타임이 끝났으면 자동 발동, 지속이 끝나면 캐릭터 이펙트 제거.
		if (self._T.serials.H05aura or 0) ~= 0 and not self:On("H05") then self:RemoveSerial("H05aura") end
		-- 레벨업 카드로 배우기 전(Lv.0)에는 발동하지 않는다
		if not self:Learned("H05") or self._T.inragePending or self._T.noAutoBuff then return end
		local mgr = self._T.mgr
		if mgr == nil or mgr.RunState ~= "FIGHT" or (self._T.cd.H05 or 0) > 0 then return end
		self:StartInrage()
	end

	@ExecSpace("ServerOnly")
	method void StartInrage()
		-- 인레이지 발동: 쿨타임 시작 → 시전 그림 재생 → 그림이 끝나면 버프.
		local sk = self._T.skills.H05
		local mgr = self._T.mgr
		if sk == nil or mgr == nil then return end
		self._T.cd.H05 = self:Cooldown(sk)
		self._T.inragePending = true
		local p = sk.proc
		local cast = ""
		if p ~= nil then cast = string.match(p.casterFx or "", "^([^|:]+)") or "" end
		local wait = 0
		local player = self.Entity
		if cast ~= "" and isvalid(player) then
			_EffectService:PlayEffectAttached(cast, player, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false)
			wait = self:ClipLen(cast)
		end
		if p ~= nil then self:PlaySound(p.useSound or "") end
		local r = { sk = sk, id = "H05" }
		_TimerService:SetTimerOnce(function()
			self._T.inragePending = false
			if self._T.mgr == nil then return end
			self:ApplyBuff(r)
		end, math.max(0.05, wait))
		log("[VRF] inrage start cast=" .. cast .. " wait=" .. string.format("%.2f", wait))
	end

	@ExecSpace("ServerOnly")
	method void StunTarget(Component mgr, number sec, Entity target)
		-- 기절만 걸기 (몬스터 다음 공격 지연 + 머리 위 기절 별). 이미 더 길게 남아 있으면 그대로.
		if self:MS() ~= self then
			self:MS():StunTarget(mgr, sec, target)
			return
		end
		mgr:HeroSetStun(sec)
		self:SetIcon("stun", self.StunFxRUID, 0.05, self.IconWidth, target)
		self._T.till.stunFx = math.max(self._T.till.stunFx or 0, self:Now() + sec)
	end

	@ExecSpace("ServerOnly")
	method void StartComaField(Entity target)
		-- 코마 충격파 장판: 몬스터 발밑에 ComaFieldTime초 동안 남고, 생기자마자부터 ComaFieldTick초마다 기절. 다시 쓰면 새로 깔린다.
		if not self:Alive(target) then return end
		self:EndComaField()
		local wp = target.TransformComponent.WorldPosition
		local sc = self.ComaFieldScale
		self._T.serials.comaField = _EffectService:PlayEffect(self.ComaFieldRUID, target, Vector3(wp.x + self.ComaFieldOffsetX * sc, wp.y, wp.z), 0, Vector3(sc, sc, 1), true)
		self._T.comaField = { target = target, endAt = self:Now() + self.ComaFieldTime, nextAt = self:Now() }
		log("[VRF] coma field start " .. tostring(self.ComaFieldTime) .. "s")
	end

	@ExecSpace("ServerOnly")
	method void TickComaField()
		-- 충격파 장판: 틱마다 기절, 시간이 끝나거나 몬스터가 쓰러지면 정리.
		local cf = self._T.comaField
		if cf == nil then return end
		local now = self:Now()
		if now >= cf.endAt or not self:Alive(cf.target) then
			self:EndComaField()
			return
		end
		if now >= cf.nextAt then
			cf.nextAt = cf.nextAt + self.ComaFieldTick
			local mgr = self._T.mgr
			if mgr ~= nil then self:StunTarget(mgr, self.ComaFieldStun, cf.target) end
			log("[VRF] coma field stun " .. tostring(self.ComaFieldStun) .. "s")
		end
	end

	@ExecSpace("ServerOnly")
	method void EndComaField()
		-- 충격파 장판 제거.
		self._T.comaField = nil
		self:RemoveSerial("comaField")
	end

	@ExecSpace("ServerOnly")
	method void RemoveSerial(string key)
		-- 붙여 둔 반복 이펙트 제거.
		local s = self._T.serials[key]
		if s ~= nil and s ~= 0 then _EffectService:RemoveEffect(s) end
		self._T.serials[key] = 0
	end

	-- ========== 디버프 (DebuffTable) ==========

	@ExecSpace("ServerOnly")
	method void ApplyDebuff(string id, Entity target)
		-- 지금 몬스터에 디버프를 건다 (다시 걸면 시간 갱신). 몬스터 머리 위 그림 반복. 지속 피해는 1초 뒤 첫 틱.
		if self:MS() ~= self then
			self:MS():ApplyDebuff(id, target)
			return
		end
		local def = self._T.debuffDefs[id]
		if def == nil or not isvalid(target) then return end
		local dur = def.duration
		if id == "IncisingBurn" and self:Has("H06", 4) then dur = self.IncisingBurnUpTime end
		self._T.debuff[id] = self:Now() + dur
		if def.effect == "DoT" then
			-- 지속시간 5초면 1~5초에 5번 들어가도록 끝을 살짝 늦춘다
			self._T.debuff[id] = self._T.debuff[id] + 0.1
			if self._T.dotNext == nil then self._T.dotNext = {} end
			self._T.dotNext[id] = self:Now() + 1
		end
		if def.fx ~= "" then self:SetIcon("debuff_" .. id, def.fx, 0, self.IconWidth, target) end
		log("[VRF] debuff " .. id .. " " .. tostring(dur) .. "s")
	end

	@ExecSpace("ServerOnly")
	method void TickDebuffs()
		-- 시간이 다 된 디버프와 그 그림 제거. 지속 피해(DoT) 디버프는 1초마다 공격력 Value% 피해.
		-- 2인 편성: 몬스터 상태는 상태 담당(메인) 하나만 갱신한다
		if self:MS() ~= self then return end
		if self._T.dotNext == nil then self._T.dotNext = {} end
		for id, till in pairs(self._T.debuff or {}) do
			local def = self._T.debuffDefs[id]
			if def ~= nil and def.effect == "DoT" and self:Now() >= (self._T.dotNext[id] or 0) and self:Now() < till then
				self._T.dotNext[id] = self:Now() + 1
				self:DotDamage(def, id)
			end
			if self:Now() >= till then
				self._T.debuff[id] = nil
				self._T.dotNext[id] = nil
				self:ClearIcon("debuff_" .. id)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void DotDamage(table def, string id)
		-- 지속 피해 1회: 공격력 × Value% × (모든 피해 증가) × (자상 방어력 감소).
		-- 인사이징 화상: 별 위력·돌파 4 '타오르는 칼날'(+100%) 반영, 돌파 5 '업화'면 몬스터 현재 체력 3% 추가 (최대 공격력 300%).
		local mgr = self._T.mgr
		if mgr == nil or mgr.RunState ~= "FIGHT" then return end
		local target = mgr:HeroMonster()
		if not self:Alive(target) then return end
		local dmg = self:DotValue(def, id, tonumber(mgr.MonsterHp) or 0, self:DefDownPct())
		local pc = self.Entity:GetComponent("script.TowerPlayer")
		if pc ~= nil then pc:ShowProcDamage(target, dmg, false) end
		mgr:ApplyMonsterDamage(dmg)
		log("[VRF] dot " .. def.name .. " dmg=" .. tostring(dmg))
	end

	@ExecSpace("ServerOnly")
	method integer DotValue(table def, string id, number hp, number defDown)
		-- 지속 피해 1회 값: 공격력 × Value% × (모든 피해 증가) × (자상 방어력 감소). 인사이징 화상은 별 위력·돌파 4·5 반영.
		local mgr = self._T.mgr
		local pct = def.value
		local extra = 0
		if id == "IncisingBurn" then
			local up = self:Star("H06", "StarPower")
			if self:Has("H06", 4) then up = up + self.IncisingBurnUpPct end
			pct = pct * self:LvMul("H06") * (1 + up / 100)
			if self:Has("H06", 5) then
				extra = math.min(hp * self.IncisingHpPct / 100, mgr:ActorAtk(self.Entity) * self.IncisingHpCapPct / 100)
			end
		end
		return math.max(1, math.floor((mgr:ActorAtk(self.Entity) * pct / 100 + extra) * (1 + self:AllDmgPct() / 100) * (1 + defDown / 100) + 0.5))
	end

	@ExecSpace("ServerOnly")
	method boolean RollStatus(string id)
		-- 디버프 적용 확률 (DebuffTable Chance %, 없으면 100%).
		local def = self._T.debuffDefs[id]
		local c = 100
		if def ~= nil then c = def.chance or 100 end
		return _UtilLogic:RandomDouble() * 100 < c
	end

	@ExecSpace("ServerOnly")
	method table QStat(Entity e)
		-- 줄 서 있는 몬스터의 자상·디버프 상태 (맨 앞으로 나오면 OnMonsterSpawn에서 넘겨받음).
		if self._T.qstat == nil then self._T.qstat = {} end
		local s = self._T.qstat[e]
		if s == nil then
			s = { bleed = {}, bleedUntil = 0, debuff = {}, dotNext = {} }
			self._T.qstat[e] = s
		end
		return s
	end

	@ExecSpace("ServerOnly")
	method void ApplyStatusTo(table r, table list)
		-- 스킬 디버프·자상을 맞은 몬스터마다 확률로.
		for _, e in ipairs(list) do
			if r.debuff ~= nil and self:RollStatus(r.debuff) then self:ApplyDebuffTo(r.debuff, e) end
			if (r.bleedAdd or 0) > 0 and self:RollStatus("Bleed") then self:AddBleedTo(r.bleedAdd, r.bleedSrc or r.id, e) end
		end
	end

	@ExecSpace("ServerOnly")
	method void AddBleedTo(integer n, string src, Entity e)
		-- 자상 n중첩: 맨 앞 몬스터면 기존 자상, 줄 선 몬스터면 그 몬스터 상태에 쌓는다 (소드 일루전 스택도 실제로 늘어난 만큼).
		local mgr = self._T.mgr
		if mgr ~= nil and e == mgr:HeroMonster() then
			self:AddBleed(n, src, e)
			return
		end
		-- 줄 선 몬스터 상태도 담당(메인)이 쌓는다
		self:GainIllusion(self:MS():AddQueuedBleed(n, src, e, self:LvMul(src)))
	end

	@ExecSpace("ServerOnly")
	method integer AddQueuedBleed(integer n, string src, Entity e, number lvMul)
		-- (몬스터 상태 담당이 호출됨) 줄 선 몬스터에 자상 n중첩. 늘어난 중첩 수를 돌려준다.
		if not isvalid(e) then return 0 end
		local def = self._T.debuffDefs.Bleed
		local maxStack = self.BleedMax
		local dur = self.BleedTime
		if def ~= nil then
			maxStack = def.maxStack
			dur = def.duration
		end
		local s = self:QStat(e)
		local coef = self.BleedPct * lvMul
		local before = #s.bleed
		local cnt = before
		for i = 1, n do
			cnt = cnt + 1
			s.bleed[cnt] = { coef = coef, src = src }
		end
		while cnt > maxStack do
			table.remove(s.bleed, 1)
			cnt = cnt - 1
		end
		self._T.qstat[e] = s
		local gained = #s.bleed - before
		s.bleedUntil = self:Now() + dur
		self:QRefreshIcons(e, s)
		log("[VRF] queued bleed stacks=" .. tostring(#s.bleed) .. " src=" .. tostring(src))
		return gained
	end

	@ExecSpace("ServerOnly")
	method void ApplyDebuffTo(string id, Entity e)
		-- 디버프: 맨 앞 몬스터면 기존 디버프, 줄 선 몬스터면 그 몬스터 상태에 (지속 피해는 1초 뒤 첫 틱).
		if self:MS() ~= self then
			self:MS():ApplyDebuffTo(id, e)
			return
		end
		local mgr = self._T.mgr
		if mgr ~= nil and e == mgr:HeroMonster() then
			self:ApplyDebuff(id, e)
			return
		end
		local def = self._T.debuffDefs[id]
		if def == nil or not isvalid(e) then return end
		local dur = def.duration
		if id == "IncisingBurn" and self:Has("H06", 4) then dur = self.IncisingBurnUpTime end
		local s = self:QStat(e)
		s.debuff[id] = self:Now() + dur
		if def.effect == "DoT" then
			s.debuff[id] = s.debuff[id] + 0.1
			s.dotNext[id] = self:Now() + 1
		end
		self:QRefreshIcons(e, s)
		log("[VRF] queued debuff " .. id .. " " .. tostring(dur) .. "s")
	end

	@ExecSpace("ServerOnly")
	method number QueuedMissChance(Entity e)
		-- 줄 선 몬스터가 암흑에 걸려 있으면 그 빗나감 확률.
		local s = nil
		if self:MS()._T.qstat ~= nil then s = self:MS()._T.qstat[e] end
		if s == nil then return 0 end
		local till = s.debuff.Darkness
		if till == nil or self:Now() >= till then return 0 end
		local def = self._T.debuffDefs.Darkness
		if def == nil then return 0 end
		return def.value
	end

	@ExecSpace("ServerOnly")
	method void TickQueuedStatus()
		-- 줄 선 몬스터의 자상 만료·지속 피해 틱 (피해는 대기열 체력으로). 죽은 몬스터 상태는 버린다.
		-- 2인 편성: 몬스터 상태는 상태 담당(메인) 하나만 갱신한다
		if self:MS() ~= self then return end
		local mgr = self._T.mgr
		if mgr == nil or self._T.qstat == nil then return end
		for e, s in pairs(self._T.qstat) do
			local mc = isvalid(e) and e:GetComponent("script.TowerMonster") or nil
			if mc == nil or mc.IsDead then
				self._T.qstat[e] = nil
				continue
			end
			if not mc.IsQueued then continue end
			local changed = false
			if #s.bleed > 0 and self:Now() >= s.bleedUntil then
				s.bleed = {}
				changed = true
			end
			if (s.stunFx or false) and self:Now() >= mc.StunUntil then
				s.stunFx = false
				changed = true
			end
			local defDown = 0
			local bdef = self._T.debuffDefs.Bleed
			if bdef ~= nil then defDown = #s.bleed * bdef.value end
			for id, till in pairs(s.debuff) do
				local def = self._T.debuffDefs[id]
				if def ~= nil and def.effect == "DoT" and self:Now() >= (s.dotNext[id] or 0) and self:Now() < till then
					s.dotNext[id] = self:Now() + 1
					mgr:ApplySplashDamage(e, self:DotValue(def, id, mc.Hp, defDown), false, 0)
				end
				if self:Now() >= till then
					s.debuff[id] = nil
					s.dotNext[id] = nil
					changed = true
				end
			end
			if changed and isvalid(e) then self:QRefreshIcons(e, s) end
		end
	end

	@ExecSpace("ServerOnly")
	method void StunQueued(Entity e, number sec)
		-- 줄 선 몬스터 기절: 그동안 공격하지 않고 머리 위에 기절 별. 이미 더 길게 남아 있으면 그대로.
		if self:MS() ~= self then
			self:MS():StunQueued(e, sec)
			return
		end
		local mc = isvalid(e) and e:GetComponent("script.TowerMonster") or nil
		if mc == nil or mc.IsDead then return end
		mc.StunUntil = math.max(mc.StunUntil, self:Now() + sec)
		local s = self:QStat(e)
		s.stunFx = true
		self:QRefreshIcons(e, s)
	end

	@ExecSpace("ServerOnly")
	method void QRefreshIcons(Entity e, table s)
		-- 줄 선 몬스터 머리 위 상태 표시 (기절 → 디버프 → 자상 숫자)를 다시 그린다. 맨 앞 몬스터 표시와 같은 배치.
		if self:MS() ~= self then
			self:MS():QRefreshIcons(e, s)
			return
		end
		if s.serials == nil then s.serials = {} end
		for _, serial in ipairs(s.serials) do
			if serial ~= nil and serial ~= 0 then _EffectService:RemoveEffect(serial) end
		end
		s.serials = {}
		if not isvalid(e) then return end
		local icons = {}
		if s.stunFx then table.insert(icons, { ruid = self.StunFxRUID, y = 0.05, w = self.IconWidth, sc = 1 }) end
		local ids = {}
		for id, till in pairs(s.debuff) do
			if till > self:Now() then table.insert(ids, id) end
		end
		table.sort(ids)
		for _, id in ipairs(ids) do
			local def = self._T.debuffDefs[id]
			if def ~= nil and def.fx ~= "" then table.insert(icons, { ruid = def.fx, y = 0, w = self.IconWidth, sc = 1 }) end
		end
		local n = #s.bleed
		if n > 0 then
			local list = {}
			for ruid in string.gmatch(self.BleedMarkRUIDs, "[^|]+") do table.insert(list, ruid) end
			local ruid = list[math.min(n, #list)]
			if ruid ~= nil then table.insert(icons, { ruid = ruid, y = self.BleedMarkY, w = self.BleedIconWidth, sc = self.BleedIconScale }) end
		end
		local total = 0
		for i, ic in ipairs(icons) do
			total = total + ic.w
			if i > 1 then total = total + self.IconGap end
		end
		local x = -total / 2
		local top = self._T.monTop or 1.0
		for _, ic in ipairs(icons) do
			table.insert(s.serials, _EffectService:PlayEffectAttached(ic.ruid, e, Vector3(x + ic.w / 2, top + ic.y, 0), 0, Vector3(ic.sc, ic.sc, 1), true))
			x = x + ic.w + self.IconGap
		end
	end

	@ExecSpace("ServerOnly")
	method void LoadQStat(Entity monster, table s)
		-- 맨 앞으로 나온 몬스터: 줄 서 있을 때 걸린 자상·디버프를 이어받는다 (머리 위 그림 포함).
		-- 줄 서 있을 때 붙인 머리 위 표시는 지우고 맨 앞 몬스터 표시로 다시 그린다
		for _, serial in ipairs(s.serials or {}) do
			if serial ~= nil and serial ~= 0 then _EffectService:RemoveEffect(serial) end
		end
		s.serials = {}
		if not self:Alive(monster) then return end
		local mc = monster:GetComponent("script.TowerMonster")
		if mc ~= nil and mc.StunUntil > self:Now() then
			local mgr = self._T.mgr
			if mgr ~= nil then self:StunTarget(mgr, mc.StunUntil - self:Now(), monster) end
		end
		if #s.bleed > 0 and self:Now() < s.bleedUntil then
			self._T.bleed = s.bleed
			self._T.bleedUntil = s.bleedUntil
			self.Bleed = #s.bleed
			self._T.bleedMarkN = 0
			self:UpdateBleedMark(monster)
		end
		if self._T.dotNext == nil then self._T.dotNext = {} end
		for id, till in pairs(s.debuff) do
			if till > self:Now() then
				self._T.debuff[id] = till
				if s.dotNext[id] ~= nil then self._T.dotNext[id] = s.dotNext[id] end
				local def = self._T.debuffDefs[id]
				if def ~= nil and def.fx ~= "" then self:SetIcon("debuff_" .. id, def.fx, 0, self.IconWidth, monster) end
			end
		end
		log("[VRF] queued status carried bleed=" .. tostring(#self._T.bleed))
	end

	@ExecSpace("ServerOnly")
	method void ClearDebuffs()
		-- 몬스터 교체·판 종료: 디버프 전부 제거.
		if self:MS() ~= self then
			self:MS():ClearDebuffs()
			return
		end
		for id, _ in pairs(self._T.debuff or {}) do self:ClearIcon("debuff_" .. id) end
		self._T.debuff = {}
	end

	@ExecSpace("ServerOnly")
	method number MissChance()
		-- 몬스터 공격이 빗나갈 확률(%): 걸려 있는 MissChance 디버프(암흑 등) 합, 최대 100. TowerRunManager가 몬스터 공격 때 읽는다.
		if not self.Active then return 0 end
		local sum = 0
		for id, till in pairs(self:MS()._T.debuff or {}) do
			local def = self._T.debuffDefs[id]
			if def ~= nil and def.effect == "MissChance" and self:Now() < till then sum = sum + def.value end
		end
		return math.min(100, sum)
	end

	-- ========== 자상 ==========

	@ExecSpace("ServerOnly")
	method void UpdateBleedMark(Entity target)
		-- 자상 중첩 수 그림 ("x1"~"x20")을 몬스터 머리 위에. 중첩이 바뀔 때만 그림을 바꾼다.
		if self:MS() ~= self then
			self:MS():UpdateBleedMark(target)
			return
		end
		local n = #self._T.bleed
		if n == (self._T.bleedMarkN or 0) then return end
		self._T.bleedMarkN = n
		if n <= 0 then
			self:ClearIcon("bleed")
			return
		end
		local list = {}
		for ruid in string.gmatch(self.BleedMarkRUIDs, "[^|]+") do table.insert(list, ruid) end
		local ruid = list[math.min(n, #list)]
		if ruid == nil then return end
		self:SetIcon("bleed", ruid, self.BleedMarkY, self.BleedIconWidth, target)
	end

	-- ========== 머리 위 상태 표시 (가로 가운데 정렬) ==========

	@ExecSpace("ServerOnly")
	method void SetIcon(string key, string ruid, number yOff, number width, Entity target)
		-- 상태 표시 하나를 켜거나 그림을 바꾼다. 바뀌었을 때만 전체를 다시 배치한다.
		if self:MS() ~= self then
			self:MS():SetIcon(key, ruid, yOff, width, target)
			return
		end
		if self._T.icons == nil then self._T.icons = {} end
		if isvalid(target) then self._T.iconTarget = target end
		local cur = self._T.icons[key]
		if cur ~= nil and cur.ruid == ruid then return end
		self._T.icons[key] = { ruid = ruid, y = yOff, w = width }
		self:LayoutIcons()
	end

	@ExecSpace("ServerOnly")
	method void ClearIcon(string key)
		-- 상태 표시 하나를 끄고, 남은 표시를 다시 가운데 정렬한다.
		if self:MS() ~= self then
			self:MS():ClearIcon(key)
			return
		end
		if self._T.icons == nil or self._T.icons[key] == nil then return end
		self._T.icons[key] = nil
		self:LayoutIcons()
	end

	@ExecSpace("ServerOnly")
	method void LayoutIcons()
		-- 머리 위 상태 표시를 기절 → 디버프(이름순) → 자상 순으로 가로로 놓고 전체를 몬스터 가운데에 맞춘다.
		if self:MS() ~= self then
			self:MS():LayoutIcons()
			return
		end
		-- 붙인 이펙트는 위치를 옮길 수 없어 지우고 새 위치에 다시 붙인다.
		for key, _ in pairs(self._T.serials) do
			if string.sub(key, 1, 5) == "icon_" then self:RemoveSerial(key) end
		end
		local target = self._T.iconTarget
		if not isvalid(target) then return end
		local keys = {}
		for key, _ in pairs(self._T.icons) do table.insert(keys, key) end
		local function rank(k)
			if k == "stun" then return 0 end
			if k == "bleed" then return 2 end
			return 1
		end
		table.sort(keys, function(a, b)
			if rank(a) ~= rank(b) then return rank(a) < rank(b) end
			return a < b
		end)
		local total = 0
		for i, key in ipairs(keys) do
			total = total + self._T.icons[key].w
			if i > 1 then total = total + self.IconGap end
		end
		local x = -total / 2
		for _, key in ipairs(keys) do
			local ic = self._T.icons[key]
			local cx = x + ic.w / 2
			local sc = 1
			if key == "bleed" then sc = self.BleedIconScale end
			self._T.serials["icon_" .. key] = _EffectService:PlayEffectAttached(ic.ruid, target, Vector3(cx, self._T.monTop + ic.y, 0), 0, Vector3(sc, sc, 1), true)
			x = x + ic.w + self.IconGap
		end
		log("[VRF] icons layout n=" .. tostring(#keys) .. " " .. table.concat(keys, ","))
	end

	@ExecSpace("ServerOnly")
	method void AddBleed(integer n, string src, Entity target)
		-- 자상 n중첩. 실제 중첩은 몬스터 상태 담당(메인)이 쌓고, 늘어난 만큼 이 캐릭터의 소드 일루전 환영 스택이 오른다.
		local gained = self:MS():AddBleedStacks(n, src, target, self:LvMul(src))
		self:GainIllusion(gained)
	end

	@ExecSpace("ServerOnly")
	method void GainIllusion(integer gained)
		-- 소드 일루전 환영 스택: 실제로 늘어난 자상 중첩만큼 +1 (최대 중첩에서 갱신만 된 경우는 제외).
		if not self:Learned("H14") or gained <= 0 then return end
		-- 돌파 5 '환영의 극한': 최대 40스택
		local cap = self.IllusionMaxStack
		if self:Has("H14", 5) then cap = self.IllusionMaxStackUp end
		self._T.illusionStack = math.min(cap, (self._T.illusionStack or 0) + gained)
	end

	@ExecSpace("ServerOnly")
	method integer AddBleedStacks(integer n, string src, Entity target, number lvMul)
		-- (몬스터 상태 담당이 호출됨) 자상 n중첩 (중첩별 출처·계수 보관, 전체 지속시간 갱신, 최대 10/15). 몬스터에 출혈 그림 반복. 늘어난 중첩 수를 돌려준다.
		local def = self._T.debuffDefs.Bleed
		local maxStack = self.BleedMax
		local dur = self.BleedTime
		if def ~= nil then
			maxStack = def.maxStack
			dur = def.duration
		end
		local coef = self.BleedPct * lvMul
		-- 새로 만든 표에서 # 길이가 바로 갱신되지 않는 경우가 있어 개수를 따로 세어 넣는다
		local list = self._T.bleed
		local before = #list
		local cnt = before
		for i = 1, n do
			cnt = cnt + 1
			list[cnt] = { coef = coef, src = src }
		end
		while cnt > maxStack do
			table.remove(list, 1)
			cnt = cnt - 1
		end
		self._T.bleed = list
		self._T.bleedUntil = self:Now() + dur
		self.Bleed = #self._T.bleed
		self:UpdateBleedMark(target)
		log("[VRF] bleed stacks=" .. tostring(#self._T.bleed) .. " add=" .. tostring(n) .. " max=" .. tostring(maxStack) .. " src=" .. tostring(src))
		return #self._T.bleed - before
	end

	@ExecSpace("ServerOnly")
	method void ClearBleed()
		-- 자상 전부 제거.
		if self:MS() ~= self then
			self:MS():ClearBleed()
			return
		end
		self._T.bleed = {}
		self.Bleed = 0
		self._T.bleedMarkN = 0
		self:ClearIcon("bleed")
	end

	@ExecSpace("ServerOnly")
	method void TickBleed(number delta)
		-- 자상: 1초마다 중첩 계수 합 × 공격력 피해 (비치명), 시간이 다 되면 사라진다.
		-- 2인 편성: 몬스터 상태는 상태 담당(메인) 하나만 갱신한다
		if self:MS() ~= self then return end
		if #self._T.bleed == 0 then return end
		local mgr = self._T.mgr
		if self:Now() >= (self._T.bleedUntil or 0) then
			self:ClearBleed()
			return
		end
		-- 자상은 지속 피해가 아니라 방어력 감소 디버프 (DefDownPct) — 여기서는 시간 만료만 처리
	end

	@ExecSpace("ServerOnly")
	method number DefDownPct()
		-- 자상 방어력 감소(%): 중첩 × 중첩당 수치(디버프 표 Bleed, 기본 5%). 몬스터가 받는 모든 피해가 그만큼 늘어난다.
		local n = #(self:MS()._T.bleed or {})
		if n <= 0 then return 0 end
		local per = 5
		local def = self._T.debuffDefs ~= nil and self._T.debuffDefs.Bleed or nil
		if def ~= nil then per = def.value end
		return n * per
	end

	-- ========== 소환검 ==========

	@ExecSpace("ServerOnly")
	method number ClipLen(string ruid)
		-- 애니메이션 클립 1회 길이(초) (캐시).
		if self._T.clipLen == nil then self._T.clipLen = {} end
		if self._T.clipLen[ruid] ~= nil then return self._T.clipLen[ruid] end
		local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
		local total = 0
		if clip ~= nil then
			for _, f in ipairs(clip.Frames:ToTable()) do total = total + f.Delay end
			if total > 20 then total = total / 1000 end
			local rate = clip.PlayRate
			if rate ~= nil and rate > 0 then total = total / rate end
		end
		self._T.clipLen[ruid] = total
		return total
	end

	@ExecSpace("ServerOnly")
	method table SwordFxOpts()
		-- 소환검 그림 옵션: 좌우 뒤집기 + 캐릭터(아바타)와 같은 레이어에서 한 칸 뒤.
		local opts = { FlipX = true }
		local mgr = self._T.mgr
		local player = self.Entity
		if isvalid(player) and isvalid(player.AvatarRendererComponent) then
			opts.SortingLayer = player.AvatarRendererComponent.SortingLayer
			opts.OrderInLayer = player.AvatarRendererComponent.OrderInLayer - 1
		end
		return opts
	end

	@ExecSpace("ServerOnly")
	method void StartSummon(table r)
		-- 소드 오브 버닝 소울: 캐릭터 뒤에 불타는 검 소환 (재발동은 시간 갱신). 등장 그림 → 대기 그림 반복.
		local mgr = self._T.mgr
		local dur = r.sk.buffTime
		if self:Has("H12", 1) then dur = self.SwordDurUp end
		-- 돌파 3: 소환할 때 콤보를 모두 소모, 콤보 1당 소환검 피해 +SwordComboPct%
		local comboBonus = 0
		if self:Has("H12", 3) and self.Combo > 0 then
			local n = self.Combo
			if self:UseCombo(n) then comboBonus = n * self.SwordComboPct end
		end
		local s = self._T.summon
		if s ~= nil then
			s.left = dur
			s.ext = 0
			s.comboBonus = comboBonus
			self.SummonLeft = s.left
			log("[VRF] hero summon refresh dur=" .. tostring(dur) .. " comboBonus=" .. tostring(comboBonus))
			return
		end
		s = { left = dur, timer = 0.6, charge = 0, auto = 2, ext = 0, count = 0, comboBonus = comboBonus }
		self._T.summon = s
		self.SummonLeft = dur
		self.SwordCharge = 0
		local player = self.Entity
		if not isvalid(player) then return end
		_EffectService:PlayEffectAttached(self.SwordSummonedRUID, player, self.SwordOffset, 0, Vector3(1, 1, 1), false, self:SwordFxOpts())
		local wait = self:ClipLen(self.SwordSummonedRUID)
		_TimerService:SetTimerOnce(function() self:ShowSwordStand() end, math.max(0.1, wait - 0.02))
		log("[VRF] hero summon sword dur=" .. tostring(dur) .. " comboBonus=" .. tostring(comboBonus))
	end

	@ExecSpace("ServerOnly")
	method void ShowSwordStand()
		-- 소환검 대기 그림 (반복). 쌍영검이면 두 번째 검도.
		local mgr = self._T.mgr
		if self._T.summon == nil or mgr == nil then return end
		local player = self.Entity
		if not isvalid(player) then return end
		self:RemoveSerial("sword")
		self._T.serials.sword = _EffectService:PlayEffectAttached(self.SwordStandRUID, player, self.SwordOffset, 0, Vector3(1, 1, 1), true, self:SwordFxOpts())
		-- 돌파 4: 작은 검 2개
		if self:Has("H12", 4) and self:Now() >= (self._T.miniBusyUntil or 0) - 0.05 then
			local sc = Vector3(self.SwordMiniScale, self.SwordMiniScale, 1)
			if (self._T.serials.mini1 or 0) == 0 then self._T.serials.mini1 = _EffectService:PlayEffectAttached(self.SwordStandRUID, player, self.MiniOffset1, 0, sc, true, self:SwordFxOpts()) end
			if (self._T.serials.mini2 or 0) == 0 then self._T.serials.mini2 = _EffectService:PlayEffectAttached(self.SwordStandRUID, player, self.MiniOffset2, 0, sc, true, self:SwordFxOpts()) end
		end
	end

	@ExecSpace("ServerOnly")
	method void EndSummon()
		-- 소환 종료: 사라지는 그림.
		local mgr = self._T.mgr
		self._T.summon = nil
		self.SummonLeft = 0
		self.SwordCharge = 0
		self:RemoveSerial("sword")
		self:RemoveSerial("mini1")
		self:RemoveSerial("mini2")
		local player = self.Entity
		if isvalid(player) then
			_EffectService:PlayEffectAttached(self.SwordDieRUID, player, self.SwordOffset, 0, Vector3(1, 1, 1), false, self:SwordFxOpts())
			if self:Has("H12", 4) then
				local sc = Vector3(self.SwordMiniScale, self.SwordMiniScale, 1)
				_EffectService:PlayEffectAttached(self.SwordDieRUID, player, self.MiniOffset1, 0, sc, false, self:SwordFxOpts())
				_EffectService:PlayEffectAttached(self.SwordDieRUID, player, self.MiniOffset2, 0, sc, false, self:SwordFxOpts())
			end
			self:PlaySound(self.SwordDieSound)
		end
		log("[VRF] hero summon end")
	end

	@ExecSpace("ServerOnly")
	method number SwordDmgPct(boolean enhanced)
		-- 소환검 공격 피해 보너스 합 (별 위력, 돌파 3 콤보 소모, 다음 공격 강화).
		local v = self:Star("H12", "StarPower")
		local s = self._T.summon
		if s ~= nil then v = v + (s.comboBonus or 0) end
		v = v + (self._T.summonBoost or 0)
		self._T.summonBoost = 0
		return v
	end

	@ExecSpace("ServerOnly")
	method void SwordAttack(boolean enhanced, boolean command)
		-- 소환검 1회 공격: 대기 그림을 잠시 숨기고 공격 그림 → 몬스터 피격 그림·숫자. 강화 공격은 1.5배·다른 그림.
		local mgr = self._T.mgr
		local target = mgr:HeroMonster()
		local player = self.Entity
		if not self:Alive(target) or not isvalid(player) then return end
		local sk = self._T.skills["H12"]
		local pct = sk.proc.pct
		if enhanced then pct = pct * 1.5 end
		local bonus = self:SwordDmgPct(enhanced)
		local base = mgr:ActorHitDamage(self.Entity) * pct / 100 * self:LvMul("H12") * (1 + bonus / 100) * (1 + self:AllDmgPct() / 100)
		local rate = mgr:ActorCrit(self.Entity) + self:Star("H12", "StarCrit")
		local crit = _UtilLogic:RandomDouble() * 100 < rate
		if crit then base = base * (mgr:ActorCritDmg(self.Entity) + self:Star("H12", "StarCrit") * 2) / 100 end
		local dmg = math.max(1, math.floor(base + 0.5))
		local clip = self.SwordAttackRUID
		local hitFx = self.SwordHitRUID
		local snd = self.SwordAttackSound
		if enhanced then
			clip = self.SwordAttack2RUID
			hitFx = self.SwordHit2RUID
			snd = self.SwordAttack2Sound
		end
		self:RemoveSerial("sword")
		_EffectService:PlayEffectAttached(clip, player, self.SwordOffset, 0, Vector3(1, 1, 1), false, self:SwordFxOpts())
		-- 돌파 4: 작은 검 2개가 같은 공격을 작게 따라 한다
		local mini = self:Has("H12", 4)
		local len = self:ClipLen(clip)
		if mini then
			-- 작은 검은 원본보다 조금씩 늦게 공격 (끝날 때까지 대기 그림을 다시 켜지 않음)
			local sc = Vector3(self.SwordMiniScale, self.SwordMiniScale, 1)
			self._T.miniBusyUntil = self:Now() + self.MiniDelay2 + len
			_TimerService:SetTimerOnce(function()
				if self._T.summon == nil then return end
				self:RemoveSerial("mini1")
				_EffectService:PlayEffectAttached(clip, player, self.MiniOffset1, 0, sc, false, self:SwordFxOpts())
			end, self.MiniDelay1)
			_TimerService:SetTimerOnce(function()
				if self._T.summon == nil then return end
				self:RemoveSerial("mini2")
				_EffectService:PlayEffectAttached(clip, player, self.MiniOffset2, 0, sc, false, self:SwordFxOpts())
			end, self.MiniDelay2)
			_TimerService:SetTimerOnce(function() self:ShowSwordStand() end, self.MiniDelay2 + math.max(0.2, len - 0.02) + 0.03)
		end
		self:PlaySound(snd)
		_TimerService:SetTimerOnce(function() self:ShowSwordStand() end, math.max(0.2, len - 0.02))
		_TimerService:SetTimerOnce(function()
			if not self:Alive(target) then return end
			_EffectService:PlayEffect(hitFx, target, self:HitPos(target, 0, 0), 0, Vector3(1, 1, 1), false, { FlipX = true })
			self:PlaySound(self.SwordHitSound)
			local pc = self.Entity:GetComponent("script.TowerPlayer")
			if pc ~= nil then pc:ShowProcDamage(target, dmg, crit) end
			local splash = mgr:SplashTargets((sk.proc.targets or 1) - 1)
			mgr:ApplyMonsterDamage(dmg)
			for _, e in ipairs(splash) do
				if not isvalid(e) or e.TransformComponent == nil then continue end
				local wp = e.TransformComponent.WorldPosition
				_EffectService:PlayEffect(hitFx, e, Vector3(wp.x, wp.y + self._T.monMid, wp.z), 0, Vector3(1, 1, 1), false, { FlipX = true })
				mgr:ApplySplashDamage(e, dmg, crit, 0)
			end
			-- 돌파 4: 작은 검 2개가 원본 피해의 30%로 따라 침
			if mini then
				local small = math.max(1, math.floor(dmg * self.SwordMiniPct / 100 + 0.5))
				local mt = sk.proc.targets or 1
				_TimerService:SetTimerOnce(function() self:ApplyExtra(target, small, hitFx, false, "", mt) end, self.MiniDelay1)
				_TimerService:SetTimerOnce(function() self:ApplyExtra(target, small, hitFx, false, "", mt) end, self.MiniDelay2)
			end
		end, math.min(0.45, math.max(0.15, len * 0.45)))
		log("[VRF] hero sword attack enhanced=" .. tostring(enhanced) .. " command=" .. tostring(command) .. " dmg=" .. tostring(dmg) .. " bonus=" .. tostring(bonus) .. " mini=" .. tostring(mini))
	end

	@ExecSpace("ServerOnly")
	method void SwordCommand()
		-- 소드 일루전 '검의 지휘자': 소환 시간 +2초(소환당 최대 6초), 강화 공격 1회 명령(충전 소비 없음).
		local s = self._T.summon
		if s == nil then return end
		if s.ext < 6 then
			local add = math.min(2, 6 - s.ext)
			s.ext = s.ext + add
			s.left = s.left + add
		end
		_TimerService:SetTimerOnce(function() self:SwordAttack(true, true) end, 0.4)
	end

	@ExecSpace("ServerOnly")
	method void TickSummon(number delta)
		-- 소환검 주기 공격·자동 충전·종료.
		local s = self._T.summon
		if s == nil then return end
		s.left = s.left - delta
		self.SummonLeft = math.max(0, s.left)
		if s.left <= 0 then
			self:EndSummon()
			return
		end
		s.timer = s.timer - delta
		if s.timer > 0 then return end
		local speed = self:Star("H12", "StarTempo")
		s.timer = self.SummonPeriod / (1 + speed / 100)
		-- 돌파 5: 공격 간격 -30%
		if self:Has("H12", 5) then s.timer = s.timer * (1 - self.SwordSpeedCutPct / 100) end
		-- 기본은 일반 공격만, 돌파 2면 공격 3회마다 강화 공격
		s.count = (s.count or 0) + 1
		local enhanced = self:Has("H12", 2) and s.count % self.SwordEnhEvery == 0
		self:SwordAttack(enhanced, false)
	end

	-- ========== 매 프레임 ==========

	@ExecSpace("ServerOnly")
	method void Tick(Component mgr, number delta)
		-- 전투 중: 쿨타임, 마나 회복, 콤보 감소, 자상, 소환검, 기절 그림, 인스팅트 표시.
		self._T.mgr = mgr
		for id, t in pairs(self._T.cd) do self._T.cd[id] = math.max(0, t - delta) end
		local regen = self.ManaRegen
		local pct = 0
		if self:On("H15") and self:Has("H15", 5) then pct = pct + 30 end
		self:AddMana(regen * (1 + pct / 100) * delta)
		-- 콤보 자연 감소 없음 (콤보 어택 개편)
		self:TickShots(delta)
		self:TickDebuffs()
		self:TickQueuedStatus()
		self:TickBleed(delta)
		self:TickSummon(delta)
		self:TickComaField()
		self:TickInrage()
		self:TickEpic()
		if self:MS() == self and self._T.icons ~= nil and self._T.icons.stun ~= nil and self:Now() >= (self._T.till.stunFx or 0) then self:ClearIcon("stun") end
		self.InstinctLeft = math.max(0, (self._T.till.H15 or 0) - self:Now())
		self._T.statusTick = (self._T.statusTick or 0) - delta
		if self._T.statusTick <= 0 then
			self._T.statusTick = 0.2
			self:UpdateStatus()
		end
	end

	@ExecSpace("ServerOnly")
	method void TickStatusOnly(Component mgr, number delta)
		-- 편성에 히어로가 없을 때 (메인이 다른 직업): 몬스터 상태(디버프·줄 선 몬스터 상태·자상·기절 그림)만 돌린다.
		self._T.mgr = mgr
		self:TickDebuffs()
		self:TickQueuedStatus()
		self:TickBleed(delta)
		if self._T.icons ~= nil and self._T.icons.stun ~= nil and self:Now() >= (self._T.till.stunFx or 0) then self:ClearIcon("stun") end
	end

	@ExecSpace("ServerOnly")
	method void UpdateStatus()
		-- HUD 상태 줄: 버프 남은 시간, 소환검 충전·시간, 몬스터 자상 중첩, 기절.
		local parts = {}
		local names = { H05 = "인레이지", H11 = "에픽 어드벤쳐", H15 = "콤보 인스팅트" }
		for _, id in ipairs({ "H05", "H11", "H15" }) do
			local left = (self._T.till[id] or 0) - self:Now()
			if left > 0 then table.insert(parts, names[id] .. " " .. tostring(math.ceil(left)) .. "초") end
		end
		if (self._T.valCharge or 0) > 0 then table.insert(parts, "<color=#FFD36A>발할라 충전 " .. tostring(self._T.valCharge) .. "</color>") end
		local mgr = self._T.mgr
		if self:On("H11") and mgr ~= nil and mgr:ShieldOf(self.Entity) > 0 then table.insert(parts, "<color=#9FE3FF>보호막 " .. tostring(math.floor(mgr:ShieldOf(self.Entity))) .. "</color>") end
		if self:On("H11") and (self._T.epicAtk or 0) > 0 then table.insert(parts, "<color=#FFB36A>공격력 +" .. tostring(math.floor(self._T.epicAtk)) .. "%</color>") end
		local s = self._T.summon
		if s ~= nil then
			local txt = "버닝 소울 " .. tostring(math.ceil(s.left)) .. "초"
			if (s.comboBonus or 0) > 0 then txt = txt .. " · 피해 +" .. tostring(math.floor(s.comboBonus)) .. "%" end
			table.insert(parts, "<color=#FF8A4C>" .. txt .. "</color>")
		end
		if (self._T.illusionStack or 0) > 0 then table.insert(parts, "<color=#FFB0C0>환영 " .. tostring(self._T.illusionStack) .. "/" .. tostring(self.IllusionMaxStack) .. "</color>") end
		if #self:MS()._T.bleed > 0 then table.insert(parts, "<color=#FF5A6A>자상 " .. tostring(#self:MS()._T.bleed) .. "중첩 (방어력 -" .. tostring(math.floor(self:DefDownPct())) .. "%)</color>") end
		if (self:MS()._T.till.stunFx or 0) > self:Now() then table.insert(parts, "<color=#FFE36A>기절</color>") end
		for id, till in pairs(self:MS()._T.debuff or {}) do
			local def = self._T.debuffDefs[id]
			local left = till - self:Now()
			if def ~= nil and left > 0 then table.insert(parts, "<color=#B18CFF>" .. def.name .. " " .. tostring(math.ceil(left)) .. "초</color>") end
		end
		local instCd = self._T.cd.H15 or 0
		if instCd > 0 and not self:On("H15") and self:Learned("H15") then table.insert(parts, "<color=#8A8AA0>인스팅트 대기 " .. tostring(math.ceil(instCd)) .. "초</color>") end
		self.StatusText = table.concat(parts, "   ")
		local slots = {}
		-- 스킬 칸: 칸 순서 (id:남은 쿨:최대 쿨:0). 4-C부터 스킬 레벨 없음(넷째 값 0).
		-- 4-D: 궁극기 칸은 id:(최대−게이지):최대:U → HUD가 쿨 덮개를 게이지로 쓴다
		for _, id in ipairs(self._T.equip or {}) do
			local sk = self._T.skills[id]
			if sk ~= nil and self:Learned(id) and not (self._T.hidden or {})[id] then
				if id == self._T.ultId then
					table.insert(slots, id .. ":" .. string.format("%.1f", math.max(0, self.UltMax - self.UltGauge)) .. ":" .. string.format("%.1f", self.UltMax) .. ":U")
				else
					table.insert(slots, id .. ":" .. string.format("%.1f", math.max(0, self._T.cd[id] or 0)) .. ":" .. string.format("%.1f", self:Cooldown(sk)) .. ":0")
				end
			end
		end
		self.SlotInfo = table.concat(slots, "|")
	end

	@ExecSpace("ServerOnly")
	method void PauseClock(number delta)
		-- 카드 선택·몬스터 교체 중에는 콤보 감소 기준 시간을 밀어 둔다 (감소·회복 정지).
		self._T.lastBasic = self._T.lastBasic + delta
		-- 발사체는 몬스터 교체 중에도 계속 날아간다 (다음 몬스터에 닿을 수 있음)
		self:TickShots(delta)
	end

	@ExecSpace("ServerOnly")
	method boolean IsInvuln()
		-- 콤보 데스폴트 무적 중인지.
		return self:On("inv")
	end

	@ExecSpace("ServerOnly")
	method void OnMonsterSpawn(Component mgr, Entity monster, string standRUID)
		-- 새 몬스터: 자상·기절 그림 정리, 몸 높이(이펙트 위치 기준) 측정. 앞 몬스터에서 남은 연타가 있으면 이어서 넣는다.
		self._T.mgr = mgr
		local carry = self._T.carry or {}
		self._T.carry = {}
		if #carry > 0 then
			log("[VRF] hero carry hits=" .. tostring(#carry))
			for i, c in ipairs(carry) do
				local item = c
				if item.r.carryFxHit == nil or item.r.carryTarget ~= monster then
					item.r.carryFxHit = item.h
					item.r.carryTarget = monster
				end
				_TimerService:SetTimerOnce(function() self:ApplyHit(item.r, monster, item.h) end, self.CarryDelay + (i - 1) * (item.r.gap or 0.06))
			end
		end
		self:EndComaField()
		-- 몬스터 상태 정리·이어받기는 상태 담당(메인)만 한다 (2인 편성에서 두 번 처리하지 않게)
		if self:MS() == self then
			self:ClearBleed()
			self:ClearDebuffs()
			self:ClearIcon("stun")
			self._T.iconTarget = nil
			-- 줄 서 있을 때 걸린 자상·디버프 이어받기
			local qs = nil
			if self._T.qstat ~= nil then qs = self._T.qstat[monster] end
			if qs ~= nil then
				self._T.qstat[monster] = nil
				local m0 = monster
				_TimerService:SetTimerOnce(function() self:LoadQStat(m0, qs) end, 0.05)
			end
		end
		self._T.monTop = 1.0
		self._T.monMid = 0.45
		if standRUID == nil or standRUID == "" then return end
		-- 리소스 로딩을 기다리는 동안 몬스터 등장 처리가 멈추지 않게 다음 프레임에 잰다
		_TimerService:SetTimerOnce(function() self:MeasureMonster(standRUID) end, 0.01)
	end

	@ExecSpace("ServerOnly")
	method void MeasureMonster(string standRUID)
		-- 몬스터 대기 그림 첫 프레임으로 몸 높이를 잰다 (이펙트·기절 별 위치 기준).
		local clip = _ResourceService:LoadAnimationClipAndWait(standRUID)
		if clip == nil then return end
		local frames = clip.Frames:ToTable()
		if #frames == 0 or frames[1].FrameSprite == nil then return end
		local sp = frames[1].FrameSprite
		local h = sp.Height / 100
		local above = h - sp.PivotPixel.y / 100
		if above <= 0.05 or above > h then above = h * (1 - sp.Pivot.y) end
		if above <= 0.05 then above = h end
		self._T.monTop = above
		self._T.monMid = above * 0.5
		log("[VRF] hero mon size h=" .. string.format("%.2f", h) .. " pivotPx=" .. tostring(sp.PivotPixel.y) .. " pivot=" .. string.format("%.2f", sp.Pivot.y) .. " top=" .. string.format("%.2f", above))
	end

	@ExecSpace("ServerOnly")
	method void TestLoop(Component mgr, string id, integer count, number gap)
		-- 테스트용: 몬스터를 버티게 하고 스킬 id를 count번 gap초 간격으로 강제 시전 (마나·콤보 가득, 쿨타임 무시).
		local sk = self._T.skills[id]
		if sk == nil then return end
		mgr.MonsterMaxHp = 99999999
		mgr.MonsterHp = 99999999
		for i = 1, count do
			mgr.PlayerAttackTimer = 99
			self.Mana = self.ManaMax
			self.Combo = self:ComboCap()
			local m = mgr:HeroMonster()
			local player = self.Entity
			if isvalid(m) and isvalid(player) and mgr.RunState == "FIGHT" then
				self._T.cd[id] = 0
				self._T.till[id] = 0
				if id == "H10" then self._T.valCharge = 0 end
				local r = self:MakeCast(sk)
				local pc = player:GetComponent("script.TowerPlayer")
				if pc ~= nil then pc:DoAttack(m, 5, 0, 150, { r }) end
			end
			wait(gap)
		end
		mgr.PlayerAttackTimer = 0.5
		log("[T] test " .. id .. " done")
	end

end
