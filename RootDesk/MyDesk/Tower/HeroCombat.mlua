@Component
script HeroCombat extends Component

	-- 히어로 전투(2단계): 장착한 히어로 스킬 5종의 발동·콤보·마나·자상·소환검·버프·별 강화·돌파를 처리한다.
	-- TowerRunManager가 히어로 판일 때 이 로직을 부른다 (판정은 서버, HUD용 수치만 동기화).
	-- 2인 편성: 전투 캐릭터(플레이어·동료)마다 이 컴포넌트가 하나씩 붙어 자기 마나·콤보·쿨타임·스킬 상태를 따로 가진다.
	-- 콤보 최대치: 기본 ComboBaseMax(5), 코마 돌파 3 '어드밴스드 콤보'를 얻으면 ComboMax(10). 5를 넘는 콤보는 어드밴스드 그림으로 바뀐다.
	property string JobId = "Hero"
	property integer ComboMax = 10
	property integer ComboBaseMax = 5
	-- 콤보 데스폴트 돌파 5 '콤보 어택 강화': 최대 15스택 (11스택~ 3단계 주황 그림: 메이플월드_리소스/스킬/어드밴스드_콤보)
	property integer ComboSuperMax = 15
	property string SuperComboBgRUID = "b57194c231d84534a6b800c88443dad1"
	property string SuperComboIconRUIDs = "06805948b68d44528a0c770910427cb8|a9b6a540da4448f6bf901a17864645c9|b61750ccc0a24e3d925819bb5d28c559|d5304ad7e300428c9f8e6baa6a18fb1d|b94cf514af9e4da9a0bb2b9802c7fc6e"
	-- 콤보 어택 (아웃게임 고유 패시브, Lv.0이면 잠김): 콤보를 소비하지 않는 직접 공격 적중 시 ComboGainChance% 확률로 콤보 +1.
	-- 콤보당 기본 공격력 +(ComboAtkBase + (레벨-1)×ComboAtkPerLv)%. 자연 감소 없음.
	property number ComboGainChance = 30
	-- 인레이지: 쿨타임이 되면 자동 발동 (캐릭터 동작 없음). 시전 그림(동작 표 CasterFx)이 끝난 뒤 버프 + 지속 동안 InrageAuraRUID가 캐릭터에 붙어 반복
	property string InrageAuraRUID = "09eb97c9202547c6ae13638f47d63968"
	property number InrageSpeedPct = 20
	property number InrageDurBonusPct = 50
	property number InrageComboChancePct = 50
	property number InrageBleedChance = 25
	property number InrageReducePct = 20
	-- 연타 중 몬스터가 죽어 넘어간 남은 타격: 다음 몬스터 등장 후 이 시간 뒤부터 이어서 들어감
	property number CarryDelay = 0.35
	-- 재발동: 브랜디쉬·오라 블레이드 기본 RecastChance% 확률로 같은 스킬이 한 번 더 (동작 끝난 뒤 RecastDelay초)
	property number RecastChance = 30
	property number RecastDelay = 0.3
	-- 연타 피해 숫자 간격: 같은 스킬 안의 타격 순서마다 숫자를 이만큼 위로 띄운다 (월드 단위)
	property number HitNumGap = 0.32
	-- 레이지 업라이징: 기본 시전 그림은 effect만, 돌파 1 '고대의 격노'면 effect0 + effect1 (1121052)
	property string UprisingEnhCasterFx = "70f46ad083cb43dd985a5004a816608b|9202efa66e9644f5b24aebed27f7e7b3"
	property integer UprisingSplitHits = 5
	-- 인사이징: 기본 화상(디버프 표 IncisingBurn, 레이지 업라이징 화상과 따로 걸림)
	-- 돌파 1 '영혼 절개': 기본 시전 이펙트(effect) 없이 effect0 전체 22프레임(베기 + 붉은 폭발)만, 자상 1중첩당 이 스킬 피해 +IncisingBleedPct%
	property string IncisingEnhCasterFx = "f5388463164b4a998a3e31ba7353a430"
	property number IncisingBleedPct = 6
	property integer IncisingBleedAdd = 3
	-- 돌파 4 '타오르는 칼날': 인사이징 화상 피해 +100%, 지속 7초. 돌파 5 '업화': 화상 1초마다 몬스터 현재 체력 3% (한 번에 최대 공격력 300%)
	property number IncisingBurnUpPct = 100
	property number IncisingBurnUpTime = 7
	property number IncisingHpPct = 3
	property number IncisingHpCapPct = 300
	property number UprisingSplitGap = 0.5
	-- 레이징 블로우: 기본 3타는 1121008 리소스(동작 표), 돌파 1 '폭풍의 검격'이면 6연타 + 1120017 리소스
	property string RagingStormCasterFx = "5308ef85369c4f31843d6e8cde4b1012"
	property string RagingStormHitFx = "b79cbdf6d06b487382f03d625a1fc464"
	property string RagingStormHitSound = "aa92fddf0e404d35bf6406cef6bc7ad5"
	property number RagingRecastChance = 15
	property number RagingRecastChanceUp = 35
	property number RagingSpeedPct = 50
	-- 돌파 4 '자상 폭발': 마지막 타격 뒤 쌓인 자상을 전부 터트림 (중첩마다 폭발 1번, 전체 RagingBurstTime초 안에, 위치는 조금씩 랜덤)
	property string RagingBurstFxRUID = "16dee8f1c8d5442ab93ae28b1e448e2b"
	property number RagingBurstPct = 150
	property number RagingBurstTime = 0.3
	property number RagingBurstJitter = 0.25
	-- 발사체 스킬 (스킬id:발사체 그림:타입;...). 발사체 전용 모델 heroshot 하나에 그림만 바꿔 쓰고, 끝나면 숨겨 두었다 다시 쓴다(풀링).
	-- 타입: pierce = 관통형 (닿은 몬스터에 피해를 주고 그대로 화면 밖까지 날아감), stop = 첫 몬스터에 닿으면 사라짐
	property string ShotRUIDs = "H07:2a128f46b0c54f4d8bfafdd2fb29f568:pierce"
	-- 오라 블레이드 돌파 1 '거대한 검기' 강화 연출 (스킬 폴더 리소스): 붉은 시전 이펙트, 교차 초승달 검기 발사체
	property string AuraEnhCastRUID = "3d6240f494cc4c53adf2a2b12db01aa8"
	property string AuraEnhShotRUID = "a07ce3d193b14caa9cb41a80580e4cb1"
	-- 강화 연출 크기 배율 (직접 올린 스프라이트가 메이플 리소스보다 약 2배 크게 그려져 0.5로 원본과 맞춤, 메이커에서 나란히 띄워 확인)
	property number AuraEnhScale = 0.5
	-- 강화 시전 이펙트는 원본 시전 이펙트와 프레임 크기가 같아 1 (피벗 보정판, 메이커에서 원본과 나란히 확인)
	property number AuraEnhCastScale = 1
	-- 초당 20 = 2000px
	property number ShotSpeed = 20
	-- 화면(가로 12.8) 밖까지 충분히
	property number ShotRange = 16
	-- 발사체 중심이 몬스터 중심 앞 이 거리까지 오면 닿은 것으로 본다
	property number ShotReach = 0.5
	-- 캐릭터 몸 중심 (발사 위치)
	property Vector3 ShotOrigin = Vector3(0.1, 0.4, 0)
	-- 재발동 전용 이펙트 (더 강한 그림): 브랜디쉬는 기본이 새 팩(80003319), 재발동은 기존 브랜디쉬(1121008) 이펙트
