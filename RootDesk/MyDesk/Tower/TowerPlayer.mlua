@Component
script TowerPlayer extends AttackComponent

	@HideFromInspector
	property integer CurrentDamage = 1
	@HideFromInspector
	property number CurrentCritRate = 0
	@HideFromInspector
	property number CurrentCritDmg = 150
	property string HitSkinRUID = "3271c3e79bf04ecba9a107d55495970d"
	property string HealSkinRUID = "d58b67cf0f3a4eaf9fe1ad87c0ffac8a"
	-- 타격 동기화: 서버는 타격을 '대기'로만 두고, 클라이언트에서 공격 동작(=엔진 무기 공격 소리)이 시작될 때 요청을 받아 적용한다
	-- HitSyncDelay: 공격 동작 시작 후 몇 초 뒤에 요청할지(소리와 미세 조정용), HitTimeout: 요청이 안 오면 서버가 직접 적용하는 시간
	property number HitSyncDelay = 0.3
	property number HitTimeout = 0.8
	@HideFromInspector
	property integer HitSeq = 0
	-- 든 무기의 동작 계열: O 한손(swingO) / T 두손(swingT) / P 창·폴암(swingP). 무기마다 그림이 있는 동작이 달라 스킬 프레임을 이 계열로 바꿔 재생한다
	@Sync
	property string WeaponFamily = "O"
	-- 스킬 동작 재생 순번 (클라이언트 전용: 상태 머신 복구 타이머가 다음 동작을 끊지 않게)
	@HideFromInspector
	property integer ActionSeq = 0
	-- 2인 편성 동료(플레이어가 아닌 아바타)일 때: 연출·타격 요청을 주고받을 주인 플레이어 UserId
	@Sync
	property string OwnerUserId = ""
	-- 원거리 기본 공격 발사체: 모델 Id, 직업별 그림(직업:RUID:초당 회전), 출발 위치(캐릭터 기준)
	property string ProjectileModelId = "towerprojectile"
	-- 직업:그림:회전(도/초):크기:원점보정X:원점보정Y (보정은 월드 단위, 그림 원점이 가운데가 아닐 때 눈에 보이는 중심을 발사 위치에 맞춘다)
	-- 표창 그림은 원점이 모서리(-3,-3)라 그림이 위·앞으로 치우쳐 그려진다 → 아래·뒤로 보정
	property string ProjectileLooks = "NightLord:598f25c8b05f4542a36f0ba339191246:0:1:-0.17:-0.17,Bishop:d393500fd23f4537a2dd1f65089fc4a1:0:0.5:0:0"
	property Vector3 ProjectileOffset = Vector3(0, 0.35, 0)
	-- 스킬 V2 쉐도우 파트너(나이트로드 패시브2): 켜지면 캐릭터 뒤에 분신이 붙어 공격을 PartnerDelay초 늦게 같은 동작으로 따라한다
	@Sync
	property boolean PartnerOn = false
	property number PartnerDelay = 0.09
	property Vector3 PartnerOffset = Vector3(-0.22, 0.05, 0)
	property number PartnerFxAlpha = 0.6
	-- 원본 4111002 special/<몸 동작> 클립 (MSW 원본 팩 skill/411.img/skill/4111002)
	property string PartnerClips = "alert:07002b4e493048e9a5f857b02e3ba51c,dead:55b24d5e74074e638770aa5266190028,shoot1:f72d242125aa40f09bce04b9881b1423,shoot2:05969cc0bb60409ebb4c1b4ef059eb0a,shootF:1760108d7e904933a91168b568f91a9d,stabO1:8736f22509854a2a873a12da0bdea57a,stabO2:087ddd3b2038432d8477a9ce1d2a4977,stabOF:087d665af45a4c7994fe652eb0ad16a1,stabT1:df7c1492de864fea852ce8f4aa45de58,stabT2:2fdbfcd7056d45fb80009e1f79d3f404,stabTF:86a6af2b709245e7a6da1ec30ce67ff3,stand1:f4aba8c33f204125a231595006d84b4a,swingO1:edfb3dd0204f49e1a5dfac95520439b8,swingO2:07531c9679d44f7992d7c66871b5f551,swingO3:fc164d4b226e4a22bab992992cdfdd4c,swingOF:1e8698fd912644f28458031b25a62827,swingP1:115a328173d840c2ab3757c6816eae78,swingP2:e2d1a0a592ec485c8af9cf82e8bdf9ca,swingPF:8d3c203a44b4486aae2b19133ca794ab,swingT1:04fec532f4f74ffb9741ebafe2526201,swingT2:af61463a604f437bb9e5c782992622fb,swingT3:15a76a6ee450459a97fe44e3ad9283d0,swingTF:9212c14c063e4d4ca27dc1cb1dfc5edf,walk1:74c3a6b4f33e481ebdd241d1cd92370e"

	method string Uid()
		-- 이 캐릭터의 클라이언트 통신 대상: 플레이어면 자기 UserId, 동료면 주인 플레이어 UserId.
		local pc = self.Entity.PlayerComponent
		if isvalid(pc) then return pc.UserId end
		return self.OwnerUserId
	end

	@ExecSpace("ServerOnly")
	method void DoAttack(Entity target, integer damage, number critRate, number critDmg, table procs)
		-- 우측 몬스터를 향해 자동 공격 1회. 데미지·크리티컬(확률 %, 데미지 %)·발동한 직업 스킬은 TowerRunManager가 정하고,
		-- 실제 적용은 클라이언트 공격 동작 시점에 (직업 스킬도 기본 타격과 같은 순간).
		if not isvalid(target) then return end
		-- 발동한 직업 스킬 중 아바타 액션이 있는 마지막 스킬의 메이플 동작으로 이번 공격 모션을 바꾼다
		local frames, dur, caster = "", 0, ""
		-- 스킬 V2: 시전 연출 시간표(SkillFxTable FxId)와 서버 기준 타격 시각(HitMs, 초)
		local fxId, hitMs, fxRate = "", 0, 1
		local sounds = {}
		local extra = {}
		for _, r in ipairs(procs) do
			if r.actionFrames ~= nil and r.actionFrames ~= "" then
				frames = r.actionFrames
				dur = r.actionTime or 0.8
				caster = r.casterFx or ""
				fxId = r.fxId or ""
				hitMs = r.hitMs or 0
				fxRate = r.fxRate or 1
			elseif r.casterFx ~= nil and r.casterFx ~= "" then
				-- 동작 없이 기본 공격에 동반하는 스킬(콤보 인스팅트 균열 등)의 캐릭터 이펙트도 함께
				table.insert(extra, r.casterFx)
			end
			-- 히어로 스킬 시전음 (메이플 리소스 팩 _audio/Use)은 동작 시작과 함께
			if r.useSound ~= nil and r.useSound ~= "" then table.insert(sounds, r.useSound) end
		end
		self._T.castSounds = table.concat(sounds, "|")
		if #extra > 0 then
			if caster ~= "" then table.insert(extra, 1, caster) end
			caster = table.concat(extra, "|")
		end
		self._T.v2fx = { fxId = fxId, hitMs = hitMs, rate = fxRate }
		self:QueueHit(target, false, damage, critRate, critDmg, frames, dur, caster)
		self._T.pending[self.HitSeq].procs = procs
	end

	@ExecSpace("ServerOnly")
	method void DoCast(Entity target, table procs)
		-- 스킬 단독 시전 (기본 공격 쿨타임과 별개): 기본 타격 없이 스킬 동작·효과만 적용한다.
		self:DoAttack(target, 0, 0, 0, procs)
		local p = self._T.pending[self.HitSeq]
		if p ~= nil then p.skillOnly = true end
	end

	@ExecSpace("ServerOnly")
	method void DoMiss(Entity target)
		-- 명중 실패: 공격 모션만 하고, 공격 동작 시점에 몬스터 위에 MISS 표시.
		if not isvalid(target) then return end
		self:QueueHit(target, true, 0, 0, 0, "", 0, "")
	end

	@ExecSpace("ServerOnly")
	method void QueueHit(Entity target, boolean miss, integer damage, number critRate, number critDmg, string actionFrames, number actionTime, string casterFx)
		-- 타격을 대기열에 두고 클라이언트에 공격 모션을 지시한다 (연속 공격처럼 여러 타격이 동시에 대기할 수 있음).
		if self._T.pending == nil then self._T.pending = {} end
		self.HitSeq = self.HitSeq + 1
		-- 실제 타격 시점이 늦은 동작(앞쪽 음수 프레임이 긴 스킬)은 서버 대기 시간도 그만큼 늘린다
		local timeout = math.max(self.HitTimeout, self:HitTimeOf(actionFrames) + 0.5)
		-- 스킬 V2: HitMs가 있으면 서버가 시전 순간부터 그 시각에 직접 타격한다 (클라이언트 왕복 없이 → 시전 연출과 hit가 같은 지연)
		local v2 = self._T.v2fx or {}
		self._T.v2fx = nil
		local serverHit = (v2.hitMs or 0) > 0
		if serverHit then timeout = v2.hitMs / 1000 end
		self._T.pending[self.HitSeq] = { seq = self.HitSeq, target = target, miss = miss, damage = damage, critRate = critRate, critDmg = critDmg, t = _UtilLogic.ElapsedSeconds, timer = timeout }
		local controller = self.Entity.PlayerControllerComponent
		if isvalid(controller) then controller.LookDirectionX = 1 end
		if not isvalid(self.Entity.PlayerComponent) and (actionFrames == nil or actionFrames == "") then self:MemberAttackState() end
		self:PlayAttackMotion(self.HitSeq, actionFrames, actionTime, casterFx, self._T.castSounds or "", v2.fxId or "", serverHit, v2.rate or 1, self:Uid())
		self._T.castSounds = ""
	end

	@ExecSpace("Multicast")
	method void SetWalkPose(boolean walk)
		-- 포탈로 걸어가는 동안 걷기 자세 (조작 컴포넌트가 없는 구성원용, 끝나면 서기).
		self.ActionSeq = self.ActionSeq + 1
		self:SetBodySelector(true)
		local ev = BodyActionStateChangeEvent()
		ev.ActionState = MapleAvatarBodyActionState.Stand
		if walk then ev.ActionState = MapleAvatarBodyActionState.Walk end
		ev.needResetAction = true
		self.Entity:SendEvent(ev)
	end

	@ExecSpace("Client")
	method void ClientWalkTo(number targetX, number speed)
		-- 조작 캐릭터(구성원 1)를 포탈까지 걷게 한다: 위치는 조작 클라이언트가 옮겨야 서버에 반영된다.
		-- 방향 이동 명령은 조작 컴포넌트가 막으므로, 매 프레임 조금씩 위치를 옮기고 이동(MOVE) 상태로 걷기 동작을 낸다.
		local movement = self.Entity.MovementComponent
		if not isvalid(movement) then return end
		if self._T.walkTimer ~= nil then _TimerService:ClearTimer(self._T.walkTimer) end
		local sc = self.Entity.StateComponent
		if isvalid(sc) then sc:ChangeState("MOVE") end
		-- 상태 머신 MOVE만으로는 제자리 위치 이동이라 조작 컴포넌트가 서기 동작으로 되돌린다: 몸통 동작을 직접 걷기로 (구성원과 같은 방식)
		self.ActionSeq = self.ActionSeq + 1
		self:SetBodySelector(true)
		self:SendBodyAction(MapleAvatarBodyActionState.Walk, true)
		local last = _UtilLogic.ElapsedSeconds
		local startAt = last
		self._T.walkTimer = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			local dt = math.min(0.1, now - last)
			last = now
			local wp = self.Entity.TransformComponent.WorldPosition
			if wp.x >= targetX or now - startAt > 6 then
				_TimerService:ClearTimer(self._T.walkTimer)
				self._T.walkTimer = nil
				if isvalid(sc) then sc:ChangeState("IDLE") end
				self:SendBodyAction(MapleAvatarBodyActionState.Stand, true)
				return
			end
			movement:SetWorldPosition(Vector2(math.min(targetX, wp.x + speed * dt), wp.y))
			if isvalid(sc) and sc.CurrentStateName ~= "MOVE" then sc:ChangeState("MOVE") end
			self:SendBodyAction(MapleAvatarBodyActionState.Walk, false)
		end, 1 / 60)
		log("[VRF] client walk to " .. string.format("%.2f", targetX))
	end

	@ExecSpace("ClientOnly")
	method void SendBodyAction(MapleAvatarBodyActionState state, boolean reset)
		-- 몸통 동작 지정 (reset=false면 같은 동작일 때 처음부터 다시 재생하지 않는다).
		local ev = BodyActionStateChangeEvent()
		ev.ActionState = state
		ev.needResetAction = reset
		self.Entity:SendEvent(ev)
	end

	@ExecSpace("ServerOnly")
	method void MemberAttackState()
		-- 구성원(2·3번) 기본 공격: 상태 머신에 ATTACK 상태를 두고 전환한다 (아바타 공격 동작 + 무기 잔상). 잠시 뒤 IDLE로.
		local sc = self.Entity.StateComponent
		if not isvalid(sc) then return end
		if not self._T.attackState then
			sc:AddState("ATTACK")
			self._T.attackState = true
		end
		sc:ChangeState("ATTACK")
		self._T.atkSeq = (self._T.atkSeq or 0) + 1
		local mySeq = self._T.atkSeq
		_TimerService:SetTimerOnce(function()
			if self._T.atkSeq == mySeq and isvalid(sc) and sc.CurrentStateName == "ATTACK" then sc:ChangeState("IDLE") end
		end, 0.6)
	end

	@ExecSpace("Server")
	method void RequestHit(integer seq)
		-- 클라이언트 공격 동작 시작 신호: 대기 중인 같은 번호의 타격만 적용 (값은 서버가 정한 그대로).
		if senderUserId ~= self:Uid() then return end
		if self._T.pending == nil or self._T.pending[seq] == nil then return end
		self:ApplyPendingHit(seq, "client")
	end

	@ExecSpace("ServerOnly")
	method void ApplyPendingHit(integer seq, string reason)
		-- 대기 중인 타격 적용: 명중이면 공격 판정(피격음·데미지), 빗나감이면 MISS.
		if self._T.pending == nil then return end
		local p = self._T.pending[seq]
		self._T.pending[seq] = nil
		if p == nil or not isvalid(p.target) then return end
		-- 그사이 이미 쓰러진 몬스터면 타격을 버린다 (같은 자리의 다음 몬스터나 시체에 맞지 않게)
		local tm = p.target:GetComponent("script.TowerMonster")
		if tm ~= nil and tm.IsDead then
			-- 기본 타격은 버리되, 같이 나간 히어로 스킬 타격은 다음 몬스터로 넘긴다
			local hero = nil
			for _, n in ipairs({ "script.HeroCombat", "script.BishopCombat", "script.JobCombat" }) do
				local c = self.Entity:GetComponent(n)
				if c ~= nil and c.Active then hero = c end
			end
			if p.procs ~= nil and #p.procs > 0 and hero ~= nil and hero.Active then
				local map = self.Entity.CurrentMap
				local mgr = isvalid(map) and map:GetComponent("script.TowerRunManager") or nil
				if mgr ~= nil then mgr:ApplyJobProcs(p.procs, p.target, self.Entity) end
			end
			return
		end
		self._T.lastHitLog = (self._T.lastHitLog or 0) + 1
		if self._T.lastHitLog <= 6 then
			log("[VRF] hit apply reason=" .. reason .. " seq=" .. tostring(p.seq) .. " wait=" .. string.format("%.3f", _UtilLogic.ElapsedSeconds - p.t))
		end
		if p.miss then
			self:ShowMiss(p.target, self:Uid())
			return
		end
		-- 원거리 직업(나이트로드·비숍): 발사체가 날아가 닿는 순간 타격 (스킬 단독 시전은 발사체 없이 스킬만)
		local look = self:ProjectileLook()
		if p.skillOnly then look = nil end
		if look ~= nil and self:LaunchProjectile(p, look) then return end
		self:ResolveHit(p)
	end

	@ExecSpace("ServerOnly")
	method table ProjectileLook()
		-- 이 캐릭터의 원거리 기본 공격 그림 {ruid, spin, scale, ox, oy} (근거리 직업이면 nil).
		local job = ""
		for _, n in ipairs({ "script.HeroCombat", "script.BishopCombat", "script.JobCombat" }) do
			local c = self.Entity:GetComponent(n)
			if c ~= nil and c.Active then job = c.JobId end
		end
		if job == "" then return nil end
		for entry in string.gmatch(self.ProjectileLooks, "[^,]+") do
			local f = {}
			for v in string.gmatch(entry, "[^:]+") do table.insert(f, v) end
			if f[1] == job then
				return { ruid = f[2], spin = tonumber(f[3] or "") or 0, scale = tonumber(f[4] or "") or 1, ox = tonumber(f[5] or "") or 0, oy = tonumber(f[6] or "") or 0 }
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method boolean LaunchProjectile(table p, table look)
		-- 발사체 생성: 캐릭터 앞에서 몬스터를 향해 날린다. 실패하면 false (바로 타격).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return false end
		local wp = self.Entity.TransformComponent.WorldPosition
		local pos = Vector3(wp.x + self.ProjectileOffset.x + (look.ox or 0), wp.y + self.ProjectileOffset.y + (look.oy or 0), wp.z)
		local proj = _SpawnService:SpawnByModelId(self.ProjectileModelId, "Proj", pos, map)
		if not isvalid(proj) then return false end
		local pc = proj:GetComponent("script.TowerProjectile")
		if pc == nil then
			proj:Destroy()
			return false
		end
		local flying = self._T.flying or {}
		flying[p.seq] = p
		self._T.flying = flying
		local sc = look.scale or 1
		proj.TransformComponent.Scale = Vector3(sc, sc, 1)
		pc:Launch(self, p.seq, p.target, look.ruid, look.spin)
		self._T.projLog = (self._T.projLog or 0) + 1
		if self._T.projLog <= 4 then log("[VRF] projectile launch " .. self.Entity.Name .. " seq=" .. tostring(p.seq)) end
		return true
	end

	@ExecSpace("ServerOnly")
	method void ApplyProjectileHit(integer seq)
		-- 발사체가 닿았을 때: 그사이 대상이 쓰러졌으면 기본 타격은 버리고 스킬 타격만 다음 몬스터로 넘긴다.
		local flying = self._T.flying or {}
		local p = flying[seq]
		flying[seq] = nil
		self._T.flying = flying
		if p == nil then return end
		self._T.projHitLog = (self._T.projHitLog or 0) + 1
		if self._T.projHitLog <= 4 then log("[VRF] projectile hit " .. self.Entity.Name .. " seq=" .. tostring(seq)) end
		local tm = isvalid(p.target) and p.target:GetComponent("script.TowerMonster") or nil
		if tm == nil or tm.IsDead then
			if p.procs ~= nil and #p.procs > 0 then
				local map = self.Entity.CurrentMap
				local mgr = isvalid(map) and map:GetComponent("script.TowerRunManager") or nil
				if mgr ~= nil and isvalid(mgr:HeroMonster()) then mgr:ApplyJobProcs(p.procs, mgr:HeroMonster(), self.Entity) end
			end
			return
		end
		self:ResolveHit(p)
	end

	@ExecSpace("ServerOnly")
	method void ResolveHit(table p)
		-- 타격 판정 (피격음·데미지) + 같이 나간 직업 스킬 적용.
		self.CurrentDamage = p.damage
		self.CurrentCritRate = p.critRate
		self.CurrentCritDmg = p.critDmg
		local pos = p.target.TransformComponent.WorldPosition
		if not p.skillOnly then self:AttackFast(BoxShape(Vector2(pos.x, pos.y + 0.4), Vector2(1.2, 1.2), 0), "tower.player", nil) end
		if p.procs ~= nil and #p.procs > 0 then
			local map = self.Entity.CurrentMap
			local mgr = isvalid(map) and map:GetComponent("script.TowerRunManager") or nil
			if mgr ~= nil then mgr:ApplyJobProcs(p.procs, p.target, self.Entity) end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 구성원(2·3번)은 조작 컴포넌트가 없어 기본으로 왼쪽을 본다: 아바타가 준비될 때쯤 오른쪽 보기 신호를 보낸다.
		if isvalid(self.Entity.PlayerComponent) then return end
		self:FaceRight()
		_TimerService:SetTimerOnce(function() if isvalid(self.Entity) then self:FaceRight() end end, 0.3)
		_TimerService:SetTimerOnce(function() if isvalid(self.Entity) then self:FaceRight() end end, 1.0)
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 스킬 V2: 쉐도우 파트너 분신 붙이기/떼기.
		if name == "PartnerOn" then self:PartnerStand(value == true) end
	end

	@ExecSpace("ClientOnly")
	method string PartnerClip(string action)
		-- 분신 몸 동작 클립 (없으면 stand1).
		if self._T.partnerMap == nil then
			self._T.partnerMap = {}
			for entry in string.gmatch(self.PartnerClips, "[^,]+") do
				local k, v = string.match(entry, "^([^:]+):(.+)$")
				if k ~= nil then self._T.partnerMap[k] = v end
			end
		end
		return self._T.partnerMap[action] or self._T.partnerMap.stand1 or ""
	end

	@ExecSpace("ClientOnly")
	method void PartnerStand(boolean on)
		-- 분신 대기 그림(special/stand1 반복)을 캐릭터 뒤에 붙이거나 뗀다.
		if (self._T.partnerSerial or 0) ~= 0 then
			_EffectService:RemoveEffect(self._T.partnerSerial)
			self._T.partnerSerial = 0
		end
		if not on or not self.PartnerOn then return end
		local face = self.Entity.TransformComponent.Scale.x >= 0 and 1 or -1
		-- 분신은 반투명(PartnerFxAlpha). 순서는 아바타와 같은 OrderInLayer + 로컬 Z +0.001(같은 순서에서는 Z가 큰 쪽이 뒤) → 본인 아바타 뒤가 보장된다.
		-- Z 없이 같은 순서로 두면 분신이 본인 위에 그려지는 프레임이 있었다(2026-11-25 메이커 확인)
		local opts = { FlipX = face > 0, Alpha = self.PartnerFxAlpha }
		local ar = self.Entity.AvatarRendererComponent
		if isvalid(ar) then
			opts.SortingLayer = ar.SortingLayer
			opts.OrderInLayer = ar.OrderInLayer
		end
		self._T.partnerSerial = _EffectService:PlayEffectAttached(self:PartnerClip("stand1"), self.Entity, Vector3(self.PartnerOffset.x * face, self.PartnerOffset.y, 0.001), 0, Vector3(1, 1, 1), true, opts)
	end

	@ExecSpace("ClientOnly")
	method void PartnerFollow(string actionFrames, number actionTime, string casterFx, string fxId, number fxRate)
		-- 분신이 같은 공격을 따라한다: 몸 동작(첫 프레임 동작 이름의 special 클립) + 시전 이펙트·시간표를 뒤쪽 위치·반투명으로.
		if not self.PartnerOn or not isvalid(self.Entity) then return end
		local face = self.Entity.TransformComponent.Scale.x >= 0 and 1 or -1
		local action = string.match(actionFrames or "", "^([^:|]+)") or "swingO1"
		local ar = self.Entity.AvatarRendererComponent
		local opts = { FlipX = face > 0, Alpha = self.PartnerFxAlpha }
		if isvalid(ar) then
			opts.SortingLayer = ar.SortingLayer
			opts.OrderInLayer = ar.OrderInLayer
		end
		local off = Vector3(self.PartnerOffset.x * face, self.PartnerOffset.y, 0.001)
		if (self._T.partnerSerial or 0) ~= 0 then
			_EffectService:RemoveEffect(self._T.partnerSerial)
			self._T.partnerSerial = 0
		end
		_EffectService:PlayEffectAttached(self:PartnerClip(action), self.Entity, off, 0, Vector3(1, 1, 1), false, opts)
		self._T.partnerSeq = (self._T.partnerSeq or 0) + 1
		local mySeq = self._T.partnerSeq
		_TimerService:SetTimerOnce(function() if self._T.partnerSeq == mySeq then self:PartnerStand(true) end end, math.max(0.3, actionTime or 0.4))
		for entry in string.gmatch(casterFx or "", "[^|]+") do
			local ruid = string.match(entry, "^([^@]+)")
			_EffectService:PlayEffectAttached(ruid, self.Entity, off, 0, Vector3(1, 1, 1), false, { FlipX = face > 0, Alpha = self.PartnerFxAlpha })
		end
		if fxId ~= nil and fxId ~= "" then self:PlaySkillFx(fxId, fxRate or 1, { dx = self.PartnerOffset.x, dy = self.PartnerOffset.y, alpha = self.PartnerFxAlpha }) end
		self._T.pfLog = (self._T.pfLog or 0) + 1
		if self._T.pfLog <= 4 then log("[VRF] v2 partner follow action=" .. action .. " fx=" .. tostring(fxId)) end
	end

	@ExecSpace("ClientOnly")
	method void FaceRight()
		-- 아바타 방향을 오른쪽으로 (엔티티 반전 대신 사용해야 무기 잔상·이펙트 방향이 함께 맞는다).
		if isvalid(self.Entity.PlayerComponent) then return end
		self.Entity:SendEvent(ChangedLookAtEvent(1))
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 클라이언트 신호가 오지 않으면(렉·창 비활성 등) 시간이 지난 뒤 서버가 직접 적용해 전투가 멈추지 않게 한다.
		if self._T.pending == nil then return end
		local expired = {}
		for seq, p in pairs(self._T.pending) do
			p.timer = p.timer - delta
			if p.timer <= 0 then table.insert(expired, seq) end
		end
		for _, seq in ipairs(expired) do self:ApplyPendingHit(seq, "timeout") end
	end

	@ExecSpace("Client")
	method void ShowMiss(Entity target)
		-- MISS 텍스트 데미지 스킨.
		if not isvalid(target) then return end
		_DamageSkinService:PlayTextDamage(target, self.HitSkinRUID, DamageSkinTextType.Miss, DamageSkinTweenType.Default)
	end

	@ExecSpace("Client")
	method void ShowElemMark(Entity target, string res, string elem)
		-- 전투 개편: 속성 약점/반감/무효 표시 (글자 없이 빛으로). 약점 = 속성색 큰 빛, 반감 = 회색 작은 빛, 무효 = 더 작은 회색 빛.
		if not isvalid(target) then return end
		-- 속성색은 ElementTable.Color 기준 (한 번 읽어 둔다)
		if self._T.elemCol == nil then
			self._T.elemCol = { Fire = Color(0.95, 0.42, 0.16, 1), Ice = Color(0.31, 0.71, 0.91, 1), Lightning = Color(0.13, 0.76, 0.65, 1),
				Poison = Color(0.6, 0.36, 0.82, 1), Holy = Color(0.95, 0.76, 0.19, 1), Dark = Color(0.29, 0.25, 0.4, 1) }
			local ds = _DataService:GetTable("ElementTable")
			if ds ~= nil then
				for i = 1, ds:GetRowCount() do
					local id = ds:GetCell(i, "Id") or ""
					local c = ds:GetCell(i, "Color") or ""
					if self._T.elemCol[id] ~= nil and c ~= "" then
						if string.sub(c, 1, 1) ~= "#" then c = "#" .. c end
						self._T.elemCol[id] = Color.FromHexCode(c)
					end
				end
			end
		end
		local colors = self._T.elemCol
		local col = Color(0.54, 0.56, 0.6, 0.8)
		local sc = 0.35
		if res == "W" then
			col = colors[elem] or Color(1, 1, 1, 1)
			sc = 0.6
		elseif res == "N" then
			sc = 0.25
		end
		local wp = target.TransformComponent.WorldPosition
		_ParticleService:PlayBasicParticle(BasicParticleType.CircleBurst, target, Vector3(wp.x, wp.y + 0.55, wp.z), 0, Vector3(sc, sc, 1), false, { Color = col })
	end

	@ExecSpace("Client")
	method void ShowProcDamage(Entity target, integer amount, boolean crit)
		-- 직업 스킬 추가 피해 숫자 (몬스터 위, 기본 타격 숫자보다 조금 위).
		if not isvalid(target) then return end
		_DamageSkinService:Play(target, self.HitSkinRUID, 0, { amount }, DamageSkinTweenType.Default, crit, Vector2(0, 0.8), Vector2(1, 1), 1.0, 1.0, LitMode.Default)
	end

	@ExecSpace("Client")
	method void ShowProcDamageAt(Entity target, integer amount, boolean crit, number yOff)
		-- 연타 피해 숫자: 같은 스킬의 타격 순서마다 위로 yOff만큼 띄워 겹치지 않게 한다.
		if not isvalid(target) then return end
		_DamageSkinService:Play(target, self.HitSkinRUID, 0, { amount }, DamageSkinTweenType.Default, crit, Vector2(0, 0.8 + yOff), Vector2(1, 1), 1.0, 1.0, LitMode.Default)
	end

	@ExecSpace("Client")
	method void ShowHeal(integer amount)
		-- 흡혈 회복량을 회복 데미지 스킨으로 표시.
		_DamageSkinService:Play(self.Entity, self.HealSkinRUID, 0, { amount }, DamageSkinTweenType.Default, false, Vector2(0, 0.5), Vector2(1, 1), 1.0, 1.0, LitMode.Default)
	end

	@ExecSpace("Client")
	method void PlayAttackMotion(integer seq, string actionFrames, number actionTime, string casterFx, string castSounds, string fxId, boolean serverHit, number fxRate)
		-- 아바타 공격 모션은 플레이어 소유 클라이언트에서 상태를 바꿔 재생한다 (이때 엔진 무기 공격 소리도 재생).
		-- 직업 스킬이 발동하면 기본 공격 대신 그 스킬의 메이플 동작 프레임 순서를 한 번 재생한다.
		-- 바로 그 순간(또는 HitSyncDelay 뒤)에 서버에 타격 적용을 요청한다.
		local sc = self.Entity.StateComponent
		for ruid in string.gmatch(castSounds or "", "[^|]+") do _SoundService:PlaySound(ruid, 0.7) end
		-- 캐릭터에 붙는 스킬 이펙트 (메이플 그림은 왼쪽 기준이라 뒤집는다). 동작 없는 동반 스킬 이펙트도 여기서.
		-- 항목 형식: "ruid", "ruid@크기", "ruid@크기@x,y" (x: 캐릭터 앞(오른쪽)으로, y: 위로 옮길 월드 단위)
		for entry in string.gmatch(casterFx or "", "[^|]+") do
			local ruid, sc, off = string.match(entry, "^([^@]+)@?([^@]*)@?(.*)$")
			local s = tonumber(sc) or 1
			local ox, oy = string.match(off or "", "^([^,]*),?(.*)$")
			local x = tonumber(ox) or 0
			local y = tonumber(oy) or 0
			_EffectService:PlayEffectAttached(ruid, self.Entity, Vector3(x * self.Entity.TransformComponent.Scale.x, y, 0), 0, Vector3(s, s, 1), false, { FlipX = self.Entity.TransformComponent.Scale.x > 0 })
		end
		if actionFrames ~= nil and actionFrames ~= "" then
			self:PlayAction(actionFrames, actionTime)
		elseif not isvalid(self.Entity.PlayerComponent) then
			-- 구성원(2·3번): 서버가 상태 머신 ATTACK으로 동작을 재생한다 (무기 잔상 포함). 스킬 동작이 끝난 뒤 선택기만 되살린다.
			self.ActionSeq = self.ActionSeq + 1
			self:SetBodySelector(true)
		elseif isvalid(sc) then
			-- 스킬 동작 중이었으면 동작 선택기를 먼저 되살린다 (이전 스킬의 복구 타이머는 순번으로 무효화)
			self.ActionSeq = self.ActionSeq + 1
			self:SetBodySelector(true)
			sc:ChangeState("ATTACK")
		end
		-- 스킬 V2: 시전 연출 시간표 재생 (받은 순간 = 0ms)
		if fxId ~= nil and fxId ~= "" then self:PlaySkillFx(fxId, fxRate or 1, nil) end
		-- 스킬 V2 쉐도우 파트너: PartnerDelay초 뒤 같은 동작
		if self.PartnerOn then
			local af, at, cf, fi, fr = actionFrames, actionTime, casterFx, fxId, fxRate
			_TimerService:SetTimerOnce(function() self:PartnerFollow(af, at, cf, fi, fr) end, self.PartnerDelay)
		end
		-- 서버가 HitMs에 직접 타격하는 스킬은 요청을 보내지 않는다
		if serverHit then return end
		-- 타격 시점: 메이플 동작 데이터에서 음수 프레임이 끝나고 양수로 바뀌는 순간 (없으면 HitSyncDelay)
		local delay = self.HitSyncDelay
		local ht = self:HitTimeOf(actionFrames)
		if ht > 0 then delay = ht end
		if delay > 0 then
			_TimerService:SetTimerOnce(function() self:RequestHit(seq) end, delay)
		else
			self:RequestHit(seq)
		end
	end

	@ExecSpace("ClientOnly")
	method table SkillFxRows(string fxId)
		-- 스킬 V2: SkillFxTable에서 이 FxId의 시간표 행 목록 (처음 한 번 읽어 둔다).
		if self._T.fxRows == nil then
			self._T.fxRows = {}
			local t = _DataService:GetTable("SkillFxTable")
			if t ~= nil then
				for i = 1, t:GetRowCount() do
					local id = t:GetCell(i, "FxId") or ""
					if id ~= "" then
						local ox, oy = string.match(t:GetCell(i, "Offset") or "", "^%s*(-?[%d%.]*)%s*,%s*(-?[%d%.]*)")
						local row = { at = (tonumber(t:GetCell(i, "AtMs")) or 0) / 1000, kind = t:GetCell(i, "Kind") or "cast", clip = t:GetCell(i, "Clip") or "",
							layer = t:GetCell(i, "Layer") or "front", flip = t:GetCell(i, "Flip") or "face", ox = (tonumber(ox) or 0) / 100, oy = (tonumber(oy) or 0) / 100,
							scale = tonumber(t:GetCell(i, "Scale")) or 1, dur = (tonumber(t:GetCell(i, "DurMs")) or 0) / 1000, loop = t:GetCell(i, "LoopClip") or "" }
						if self._T.fxRows[id] == nil then self._T.fxRows[id] = {} end
						table.insert(self._T.fxRows[id], row)
					end
				end
			end
		end
		return self._T.fxRows[fxId] or {}
	end

	@ExecSpace("ClientOnly")
	method void PlaySkillFx(string fxId, number rate, table shift)
		-- 스킬 V2: 시전 연출 시간표 재생. 받은 순간 = 0ms, rate(공격 속도 배율)만큼 시각을 줄인다.
		-- Kind: cast(캐릭터에 붙음) · castFix(시전 위치 고정) · attachLoop(붙는 반복, DurMs 뒤 제거) · shake(카메라 흔들기, Scale=세기)
		local rows = self:SkillFxRows(fxId)
		if #rows == 0 then return end
		local r0 = math.max(0.1, rate or 1)
		for _, row in ipairs(rows) do
			local ev = row
			if ev.at <= 0 then
				self:PlayFxRow(ev, r0, shift)
			else
				_TimerService:SetTimerOnce(function() if isvalid(self.Entity) then self:PlayFxRow(ev, r0, shift) end end, ev.at / r0)
			end
		end
		self._T.fxLog = (self._T.fxLog or 0) + 1
		if self._T.fxLog <= 12 then log("[VRF] skill fx " .. fxId .. " rows=" .. tostring(#rows) .. " rate=" .. string.format("%.2f", r0)) end
	end

	@ExecSpace("ClientOnly")
	method void PlayFxRow(table ev, number rate, table shift)
		-- 시간표 한 줄 재생 (원본 그림은 왼쪽 기준 → 오른쪽을 보면 FlipX). shift = 분신용 추가 위치·투명도 {dx, dy, alpha} (없으면 nil).
		local face = self.Entity.TransformComponent.Scale.x
		if face == 0 then face = 1 end
		local flipX = face > 0
		if ev.flip == "none" then flipX = false end
		local opts = { FlipX = flipX, PlayRate = rate }
		local ar = self.Entity.AvatarRendererComponent
		if isvalid(ar) then
			opts.SortingLayer = ar.SortingLayer
			if ev.layer == "back" then opts.OrderInLayer = ar.OrderInLayer - 2 else opts.OrderInLayer = ar.OrderInLayer + 2 end
		end
		local sc = Vector3(ev.scale, ev.scale, 1)
		local dx = ev.ox
		local dy = ev.oy
		if shift ~= nil then
			dx = dx + (shift.dx or 0)
			dy = dy + (shift.dy or 0)
			opts.Alpha = shift.alpha or 1
			if isvalid(ar) then opts.OrderInLayer = ar.OrderInLayer - 1 end
			if ev.kind == "shake" then return end
		end
		if face < 0 then dx = -dx end
		if ev.kind == "dash" then
			-- 스킬 V2 돌진(바이퍼): 아바타 몸만 앞으로 Offset x만큼 DurMs 동안 나갔다가 0.3초 안에 원위치 (편성 위치는 그대로)
			self:DashVisual(dx, math.max(0.05, ev.dur / rate), 0.3)
			return
		end
		if ev.kind == "shake" then
			local cam = _CameraService:GetCurrentCameraComponent()
			if isvalid(cam) then cam:ShakeCamera(ev.scale, math.max(0.1, ev.dur)) end
		elseif ev.kind == "castFix" then
			local wp = self.Entity.TransformComponent.WorldPosition
			_EffectService:PlayEffect(ev.clip, self.Entity, Vector3(wp.x + dx, wp.y + dy, wp.z), 0, sc, false, opts)
		elseif ev.kind == "attachLoop" then
			local serial = _EffectService:PlayEffectAttached(ev.clip, self.Entity, Vector3(dx, dy, 0), 0, sc, true, opts)
			if ev.dur > 0 then _TimerService:SetTimerOnce(function() _EffectService:RemoveEffect(serial) end, ev.dur) end
		else
			_EffectService:PlayEffectAttached(ev.clip, self.Entity, Vector3(dx, dy, 0), 0, sc, false, opts)
		end
	end

	@ExecSpace("ClientOnly")
	method void DashVisual(number dist, number outSec, number backSec)
		-- 아바타 몸 엔티티의 로컬 위치를 dist(월드 단위)까지 outSec 동안 밀었다가 backSec 동안 0으로 되돌린다 (보이는 것만, 판정·위치 영향 없음).
		local ar = self.Entity.AvatarRendererComponent
		if not isvalid(ar) then return end
		local body = ar:GetBodyEntity()
		if not isvalid(body) then return end
		-- 오른쪽을 보면 아바타 루트(몸의 부모)가 Scale.x = -1로 뒤집혀 몸의 로컬 +x가 화면 왼쪽이 된다 → 부모 방향을 곱해 화면상 앞(dist 부호)으로 나가게 한다
		local par = body.Parent
		if isvalid(par) and par.TransformComponent ~= nil and par.TransformComponent.Scale.x < 0 then dist = -dist end
		if self._T.dashTimer ~= nil then _TimerService:ClearTimer(self._T.dashTimer) end
		local base = self._T.dashBase or body.TransformComponent.Position
		self._T.dashBase = base
		local t0 = _UtilLogic.ElapsedSeconds
		self._T.dashTimer = _TimerService:SetTimerRepeat(function()
			if not isvalid(body) then return end
			local t = _UtilLogic.ElapsedSeconds - t0
			local x = 0
			if t < outSec then
				x = dist * (t / outSec)
			elseif t < outSec + backSec then
				x = dist * (1 - (t - outSec) / backSec)
			else
				body.TransformComponent.Position = base
				_TimerService:ClearTimer(self._T.dashTimer)
				self._T.dashTimer = nil
				return
			end
			body.TransformComponent.Position = Vector3(base.x + x, base.y, base.z)
		end, 1 / 60)
		log("[VRF] v2 dash visual dist=" .. string.format("%.2f", dist) .. " out=" .. string.format("%.2f", outSec))
	end

	method number HitTimeOf(string frames)
		-- 동작 프레임("액션:프레임:ms|...")에서 실제 타격 시점(초). 메이플 동작 데이터처럼 타격 전 프레임은 음수 ms로 적고,
		-- 처음 양수 프레임이 시작되는 순간이 타격 시점이다. 음수 프레임이 없으면 0.
		if frames == nil or frames == "" then return 0 end
		local t = 0
		local neg = false
		for action, frame, ms in string.gmatch(frames, "([^:|]+):(%d+):(-?%d+)") do
			local v = tonumber(ms)
			if v < 0 then
				neg = true
				t = t - v
			elseif v > 0 then
				break
			end
		end
		if not neg then return 0 end
		return t / 1000
	end

	@ExecSpace("ClientOnly")
	method void PlayAction(string frames, number duration)
		-- 스킬 동작 재생. MSW 아바타에는 스킬 전용 액션이 없어, 메이플 XML의 프레임 순서("액션:프레임:ms|...")대로 기본 동작 프레임을 이어서 보여 준다.
		self.ActionSeq = self.ActionSeq + 1
		local mySeq = self.ActionSeq
		local t = 0
		for action, frame, ms in string.gmatch(frames, "([^:|]+):(%d+):(-?%d+)") do
			local a = action
			local f = math.floor(tonumber(frame))
			if t <= 0 then
				self:ShowActionFrame(a, f)
			else
				_TimerService:SetTimerOnce(function()
					if self.ActionSeq == mySeq then self:ShowActionFrame(a, f) end
				end, t)
			end
			-- 음수(타격 전 프레임)도 재생 시간은 절댓값
			t = t + math.abs(tonumber(ms)) / 1000
		end
		_TimerService:SetTimerOnce(function()
			if self.ActionSeq ~= mySeq then return end
			self:SetBodySelector(true)
			-- 선택기를 켠 뒤 대기 동작을 다시 적용
			local reset = BodyActionStateChangeEvent()
			reset.ActionState = MapleAvatarBodyActionState.Stand
			reset.needResetAction = true
			self.Entity:SendEvent(reset)
		end, math.max(0.1, duration))
		log("[VRF] skill action frames=" .. frames .. " dur=" .. tostring(duration))
	end

	@ExecSpace("ClientOnly")
	method void ShowActionFrame(string action, integer frame)
		-- 기본 동작의 한 프레임을 표시. 선택기가 대기 동작으로 되돌리지 않게 끈 직후 같은 프레임에 이벤트를 보낸다 (메이커 실측).
		local renderer = self.Entity.AvatarRendererComponent
		if not isvalid(renderer) then return end
		local body = renderer:GetBodyEntity()
		if not isvalid(body) then return end
		self:SetBodySelector(true)
		self:SetBodySelector(false)
		local name = self:FamilyAction(action)
		-- stabO1·stabO2는 프레임이 2장뿐
		if (name == "stabO1" or name == "stabO2") and frame > 1 then frame = 1 end
		body:SendEvent(ActionStateChangedEvent(name, name, 1, SpriteAnimClipPlayType.Loop, frame, frame))
	end

	@ExecSpace("ClientOnly")
	method string FamilyAction(string action)
		-- 메이플 스킬 프레임의 기본 동작을 지금 든 무기 계열의 같은 자리 동작으로 바꾼다 (없는 동작을 쓰면 무기가 사라짐).
		if self._T.familyMap == nil then
			self._T.familyMap = {
				O = { swingT1 = "swingO1", swingT2 = "swingO2", swingT3 = "swingO3", swingTF = "swingOF", swingP1 = "swingO1", swingP2 = "swingO2", swingPF = "swingOF", stabT1 = "stabO1", stabT2 = "stabO2", stabTF = "stabOF" },
				T = { swingO1 = "swingT1", swingO2 = "swingT2", swingO3 = "swingT3", swingOF = "swingTF", swingP1 = "swingT1", swingP2 = "swingT2", swingPF = "swingTF", stabT1 = "stabO1", stabT2 = "stabO2", stabTF = "stabOF" },
				P = { swingO1 = "swingP1", swingO2 = "swingP2", swingO3 = "swingP1", swingOF = "swingPF", swingT1 = "swingP1", swingT3 = "swingP2", swingTF = "swingPF", stabO1 = "stabT1", stabO2 = "stabT2", stabOF = "stabTF" },
			}
		end
		local map = self._T.familyMap[self.WeaponFamily]
		if map == nil or map[action] == nil then return action end
		return map[action]
	end

	@ExecSpace("Multicast")
	method void ResetPose()
		-- 판 시작·로비 복귀 때 자세를 완전히 되돌린다: 진행 중이던 스킬 동작 타이머 무효화, 몸통 동작 선택기 켜기, 대기 동작 다시 적용.
		self.ActionSeq = self.ActionSeq + 1
		self:SetBodySelector(true)
		local reset = BodyActionStateChangeEvent()
		reset.ActionState = MapleAvatarBodyActionState.Stand
		reset.needResetAction = true
		self.Entity:SendEvent(reset)
		self:FaceRight()
	end

	@ExecSpace("Multicast")
	method void SetDownPose(boolean down)
		-- 동료 쓰러짐·일어남 자세 (플레이어 컨트롤러가 없어 상태 머신 대신 몸통 동작을 직접 바꾼다).
		self.ActionSeq = self.ActionSeq + 1
		self:SetBodySelector(true)
		local ev = BodyActionStateChangeEvent()
		ev.ActionState = MapleAvatarBodyActionState.Stand
		if down then ev.ActionState = MapleAvatarBodyActionState.Dead end
		ev.needResetAction = true
		self.Entity:SendEvent(ev)
		self:FaceRight()
	end

	@ExecSpace("ClientOnly")
	method void SetBodySelector(boolean on)
		-- 몸통 동작 선택기 켜기/끄기 (스킬 동작이 대기 동작에 덮이지 않게 잠시 끈다).
		local renderer = self.Entity.AvatarRendererComponent
		if not isvalid(renderer) then return end
		local body = renderer:GetBodyEntity()
		if not isvalid(body) then return end
		local sel = body:GetComponent("AvatarBodyActionSelectorComponent")
		if isvalid(sel) and sel.Enable ~= on then sel.Enable = on end
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- 판 진행 매니저가 넘겨준 공격력 그대로. 각인 '섬멸'은 여기서 판정해 엔진이 띄우는 숫자도 2배가 되게 한다.
		local dmg = self.CurrentDamage
		local map = self.Entity.CurrentMap
		local mgr = isvalid(map) and map:GetComponent("script.TowerRunManager") or nil
		if mgr ~= nil and dmg > 0 then
			-- 전투 개편: 기본 공격 = 이 구성원의 기본 공격 타입·속성 (비숍 = 마법·성)
			-- 기본 공격은 지속 피해·스킬 피해 종류(dmgCtx)를 물려받지 않는다 (끝나면 원래 값 복구)
			local prevSrc = mgr:SetHitSrc(self.Entity, "", false)
			local prevCtx = mgr:SwapDmgCtx(nil)
			dmg = mgr:FinalDouble(dmg)
			mgr:SwapDmgCtx(prevCtx)
			mgr:ClearHitSrc(prevSrc)
		end
		return dmg
	end

	method boolean CalcCritical(Entity attacker, Entity defender, string attackInfo)
		-- 장갑 크리티컬 확률(%).
		return _UtilLogic:RandomDouble() * 100 < self.CurrentCritRate
	end

	method float GetCriticalDamageRate()
		-- 신발 크리티컬 데미지(%) → 배율.
		return self.CurrentCritDmg / 100
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		-- 탑 몬스터만 공격 대상.
		if not isvalid(defender) then return false end
		local tm = defender:GetComponent("script.TowerMonster")
		-- 쓰러진 몬스터(사망 애니메이션 중인 시체)는 대상에서 제외
		-- 웨이브 대기열에 서 있는 몬스터도 제외 (맨 앞 몬스터만 맞는다)
		if tm == nil or tm.IsDead or tm.IsQueued then return false end
		return __base:IsAttackTarget(defender, attackInfo)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		-- 몬스터에게 맞은 데미지를 판 HP에 반영하고, 엔진 HP는 가득 유지(엔진 사망 방지).
		local map = self.Entity.CurrentMap
		if isvalid(map) then
			local mgr = map:GetComponent("script.TowerRunManager")
			if mgr ~= nil then mgr:ApplyPlayerDamage(event.TotalDamage) end
		end
		local pc = self.Entity.PlayerComponent
		if isvalid(pc) then pc.Hp = pc.MaxHp end
		log("[VRF] player hit dmg=" .. tostring(event.TotalDamage))
	end

end
