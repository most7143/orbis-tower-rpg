	-- 판은 어느 스테이지든 레벨 1부터라, 스테이지 안 성장(경험치·메소)은 1~5층과 같고 스테이지마다 몬스터만 조금씩 강해진다
	property number StageLevelStep = 0.5
	-- 스테이지 클리어 임시 보상: 스킬북 = 기본 + 스테이지 × 증가, 여신의 깃털 = 기본 + 스테이지 × 증가
	property number StageBookBase = 10
	property number StageBookPerStage = 2
	property number StageFeatherBase = 3
	property number StageFeatherPerStage = 1
