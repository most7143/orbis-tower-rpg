	property number StageClearHealPct = 30
	-- 4-D: 궁극기 게이지 (RunConfig로 덮어씀). 최대 / 기본 공격 적중 1회당 / 스킬 시전 1회당
	property number UltGaugeMax = 100
	property number UltGaugeBasic = 4
