	property integer FloorsPerStage = 1
	-- 층 안 구조: 15스테이지 = 3구간 × 5 (구간마다 일반 웨이브 4 + 강화 몬스터 1). 스테이지 = 몬스터 여러 마리 웨이브
	property integer SectionsPerFloor = 3
