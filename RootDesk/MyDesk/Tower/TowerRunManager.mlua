	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 서버에서 판 진행을 시작한다. 플레이어가 들어오면 OnUpdate에서 판을 연다.
		self._T.player = nil
		self._T.monster = nil
		self.RunState = "WAIT"
		self:LoadRunConfig()
		self:LoadMonsterTables()
		self:LoadEquipTable()
		self:LoadDealTable()
		self:LoadJobTables()
		self:LoadCombatJobs()
		self:LoadBossTables()
		log("[VRF] TowerRunManager begin map=" .. self.Entity.Name .. " monsters=" .. tostring(#self._T.monsters) .. " floors=" .. tostring(#self._T.floors) .. " prefixes=" .. tostring(#self._T.prefixes))
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 남아 있는 몬스터·따라오는 펫을 정리한다.
		self:DestroyMonster()
		self:ClearPets()
	end

	@ExecSpace("ServerOnly")
	method Entity HeroMonster()
		-- 히어로 전투 로직용: 지금 싸우는 몬스터.
		return self._T.monster
	end

	@ExecSpace("ServerOnly")
	method Entity HeroPlayer()
		-- 히어로 전투 로직용: 플레이어.
		return self._T.player
	end

	@ExecSpace("ServerOnly")
	method Component HeroOf(Entity e)
		-- 전투 캐릭터(플레이어·동료)의 히어로 전투 컴포넌트.
		-- 편성 직업이 있으면 그 직업 컴포넌트 (메인은 HeroCombat·BishopCombat·JobCombat을 모두 가진다).
		if not isvalid(e) then return nil end
		local job = nil
		if e == self._T.player then
			job = self._T.mainJob
		else
			local i = self:MateIndex(e)
			if i > 0 then job = (self._T.mateJobs or {})[i] end
		end
		if job == nil or job == "" then
			local h = e:GetComponent("script.HeroCombat")
			if h ~= nil then return h end
			local b = e:GetComponent("script.BishopCombat")
			if b ~= nil then return b end
			return e:GetComponent("script.JobCombat")
		end
		if job == "Hero" then return e:GetComponent("script.HeroCombat") end
		if job == "Bishop" then return e:GetComponent("script.BishopCombat") end
		local j = e:GetComponent("script.JobCombat")
		if j ~= nil and j.JobId ~= job then j.JobId = job end
		return j
	end

	@ExecSpace("ServerOnly")
	method boolean IsSkillJob(string job)
		-- 장착 스킬 5종 + 돌파로 싸우는 직업인지.
		return job == "Hero" or job == "Bishop" or job == "NightLord" or job == "Bowmaster" or job == "Viper"
	end

	@ExecSpace("ServerOnly")
	method Component StatusHero()
		-- 몬스터 상태(자상·암흑·기절·화상)를 들고 있는 히어로 전투 컴포넌트: 편성에 히어로가 있으면 그쪽(메인 우선), 없으면 메인 캐릭터에 붙은 HeroCombat.
		for _, h in ipairs(self:Heroes()) do
			if h.JobId == "Hero" then return h end
		end
		if isvalid(self._T.player) then return self._T.player:GetComponent("script.HeroCombat") end
		return nil
	end

	@ExecSpace("ServerOnly")
	method Component ExtraStatusHero()
		-- 상태 담당 히어로가 편성 밖(메인이 다른 직업)이면 그 컴포넌트, 아니면 nil. 따로 상태 시계를 돌려야 한다.
		local sh = self:StatusHero()
		if sh == nil then return nil end
		for _, h in ipairs(self:Heroes()) do
			if h == sh then return nil end
		end
		return sh
	end

	@ExecSpace("ServerOnly")
	method void LoadFormation()
		-- 저장된 편성(메인·동료 직업)을 읽는다. 없으면 히어로 + 비숍.
		-- 3인 파티: 구성원 1(직접 조작) · 2 · 3. 같은 직업은 한 번만.
		local want = { "Hero", "Bishop", "NightLord" }
		local rp = self._T.runParty
		if rp ~= nil and #rp >= 3 then
			-- 4단계: 판 시작 때 로스터가 보정한 편성(RunPartyData)을 그대로 쓴다 (PlayerEngrave 읽지 않음)
			want = { rp[1].jobId, rp[2].jobId, rp[3].jobId }
		else
			local eng = self:GetEngrave()
			if eng ~= nil and eng.SkillLoaded then want = { eng.MainJob, eng.CompJob, eng.Comp2Job } end
		end
		local used = {}
		local jobs = {}
		for k = 1, 3 do
			local j = want[k]
			if not self:IsSkillJob(j or "") or used[j] then j = nil end
			if j ~= nil then used[j] = true end
			jobs[k] = j
		end
		for k = 1, 3 do
			if jobs[k] == nil then
				for _, cand in ipairs({ "Hero", "Bishop", "NightLord", "Bowmaster", "Viper" }) do
					if not used[cand] then
						jobs[k] = cand
						used[cand] = true
						break
					end
				end
			end
		end
		self._T.mainJob = jobs[1]
		self._T.mateJobs = { jobs[2], jobs[3] }
		self._T.compJob = jobs[2]
		self.CompJobId = jobs[2]
		self.Comp2JobId = jobs[3]
		-- 4-B 보완: HUD 구성원 레벨 (로스터 값이 없으면 0 → HUD가 메인 레벨로 대신 표시)
		local lvs = {}
		for k = 1, 3 do
			local d = self:RunDataFor(jobs[k] or "")
			table.insert(lvs, tostring((d ~= nil and d.level ~= nil) and math.floor(d.level) or 0))
		end
		self.PartyLevels = table.concat(lvs, ",")
	end

	@ExecSpace("ServerOnly")
	method void LoadRunParty()
		-- 판 시작 편성: 로스터의 RunPartyData(잠김·중복 보정, 저장 없음)를 읽는다. 로스터가 없거나 불러오기 전이면 예전 편성 경로.
		self._T.runParty = nil
		self._T.runData = {}
		local player = self._T.player
		local roster = isvalid(player) and player:GetComponent("script.PlayerRoster") or nil
		if roster == nil or not roster.RosterLoaded then
			log_warning("[VRF] run party roster not ready, legacy formation")
			return
		end
		local rp = roster:RunPartyData()
		if rp == nil then
			log_warning("[VRF] run party roster not ready, legacy formation")
			return
		end
		self._T.runParty = rp.list
		local lvs = {}
		local tiers = {}
		for _, d in ipairs(rp.list) do
			self._T.runData[d.jobId] = d
			table.insert(lvs, tostring(d.level))
			table.insert(tiers, tostring(d.tier))
		end
		if rp.fixed then log("[VRF] run party fixed " .. rp.jobs) end
		log("[VRF] run party " .. rp.jobs .. " lv=" .. table.concat(lvs, ",") .. " tier=" .. table.concat(tiers, ","))
	end

	@ExecSpace("ServerOnly")
	method any RunDataFor(string job)
		-- 그 직업의 이번 판 캐릭터 값(CharRunData) 또는 nil.
		return (self._T.runData or {})[job]
	end

	@ExecSpace("ServerOnly")
	method string ListValue(string list, string key)
		-- "키:값,키:값" 목록에서 키의 값 (없으면 "").
		for entry in string.gmatch(list, "[^,]+") do
			local k, v = string.match(entry, "^([^:]+):(.*)$")
			if k == key then return v end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void PullQueued(integer n)
		-- 끌어당김 (바이퍼): 가장 먼 줄 선 몬스터 n마리를 대기열 앞쪽으로 옮겨 가까운 자리로 걸어오게 한다.
		local q = self._T.queue or {}
		if #q <= 1 or n <= 0 then return end
		local moved = 0
		for k = 1, n do
			if #q <= 1 then break end
			local last = table.remove(q, #q)
			table.insert(q, 1, last)
			moved = moved + 1
		end
		self._T.queue = q
		self:LayoutWave()
		log("[VRF] pull queued n=" .. tostring(moved))
	end

	@ExecSpace("ServerOnly")
	method void CleanupStrays(number delta)
		-- 안전장치 (1초마다): 굳어 남는 몬스터 정리. 오래 남은 시체 제거, 앞줄·대기열 어디에도 없는 살아 있는 몬스터 제거, 체력 0인데 안 죽은 맨 앞 몬스터 처치.
		self._T.strayTick = (self._T.strayTick or 0) - delta
		if self._T.strayTick > 0 then return end
		self._T.strayTick = 1
		local now = _UtilLogic.ElapsedSeconds
		local seen = self._T.straySeen or {}
		local inQ = {}
		for _, q in ipairs(self._T.queue or {}) do inQ[q] = true end
		local front = self._T.monster
		local alive = {}
		for _, c in ipairs(self.Entity.Children) do
			local tm = c:GetComponent("script.TowerMonster")
			if tm ~= nil then
				local key = c.Id
				alive[key] = true
				local bad = false
				local limit = 2
				if tm.IsDead then
					bad = true
					limit = 3
				elseif c ~= front and not inQ[c] then
					bad = true
				end
				if bad then
					seen[key] = seen[key] or now
					if now - seen[key] >= limit then
						log_warning("[VRF] stray monster removed " .. c.Name .. " dead=" .. tostring(tm.IsDead))
						seen[key] = nil
						c:Destroy()
					end
				else
					seen[key] = nil
				end
			end
		end
		for key, _ in pairs(seen) do
			if not alive[key] then seen[key] = nil end
		end
		self._T.straySeen = seen
		-- 맨 앞 몬스터 체력이 0인데 아직 싸우는 중이면 처치 처리
		if isvalid(front) and self.MonsterHp <= 0 and self.RunState == "FIGHT" then
			log_warning("[VRF] front monster hp 0 but alive -> kill")
			self.MonsterHp = 1
			self:ApplyMonsterDamage(1)
		end
	end

	@ExecSpace("ServerOnly")
	method void DelayFrontAttack(number sec)
		-- 넉백 (보우마스터): 맨 앞 몬스터의 다음 공격을 sec초 늦춘다.
		self.MonsterAttackTimer = self.MonsterAttackTimer + sec
	end

	@ExecSpace("ServerOnly")
	method Entity LowestAlly()
		-- 쓰러지지 않은 파티원 중 체력 비율이 가장 낮은 캐릭터 (비숍 회복 대상).
		local best = nil
		local bestR = 2
		for _, e in ipairs(self:Actors()) do
			if not self:IsDown(e) then
				local mx = self:ActorMaxHp(e)
				local r = 1
				if mx > 0 then r = self:ActorHp(e) / mx end
				if r < bestR then
					best = e
					bestR = r
				end
			end
		end
		return best
	end

	@ExecSpace("ServerOnly")
	method void SetDeathWard(number dur)
		-- 비숍 헤븐즈 도어: dur초 동안 파티원이 한 번씩 쓰러짐을 무시하고 체력 1로 버틴다.
		self._T.wardUntil = _UtilLogic.ElapsedSeconds + dur
		self._T.wardUsed = {}
		log("[VRF] duo death ward " .. tostring(dur) .. "s")
	end

	@ExecSpace("ServerOnly")
	method boolean UseDeathWard(Entity e)
		-- 쓰러짐 무시가 남아 있으면 쓰고 true.
		if _UtilLogic.ElapsedSeconds > (self._T.wardUntil or 0) or not isvalid(e) then return false end
		local used = self._T.wardUsed or {}
		local key = e.Name
		if used[key] then return false end
		used[key] = true
		self._T.wardUsed = used
		log("[VRF] duo death ward used by " .. key)
		return true
	end

	@ExecSpace("ServerOnly")
	method void AddBlock(Entity e, integer n, number dur, string fx)
		-- 피해 n회 막기 (알림 받을 컴포넌트 없음).
		self:AddBlockFor(e, n, dur, fx, nil)
	end

	@ExecSpace("ServerOnly")
	method void DebugClearBreaks()
		-- 검증용: 이번 판에 얻은 돌파를 모두 지운다.
		self._T.breakTaken = {}
	end

	@ExecSpace("ServerOnly")
	method void DebugGiveBreaks(string ids)
		-- 검증용: 돌파 id 목록(쉼표)을 이번 판에 얻은 것으로 표시. (값만 바꾸고 판 흐름을 건드리지 않아 바로 실행)
		-- 4-F: 칸 키("직업.칸") + 번호로 저장
		local keys = {}
		for id in string.gmatch(ids, "[^,]+") do
			local b = self._T.breakById[id]
			if b ~= nil then
				self:MarkBreakTaken(b.skill, id)
				table.insert(keys, self:BreakKey(b.skill) .. "#" .. tostring(self:BreakNo(id)))
			end
		end
		log("[VRF] debug breaks " .. ids .. " keys=" .. table.concat(keys, ","))
	end

	@ExecSpace("ServerOnly")
	method boolean IsVuln()
		-- 지금 몬스터가 약점(받는 피해 증가, 비숍 신성 낙인 등) 상태인지.
		return _UtilLogic.ElapsedSeconds < (self._T.vulnUntil or 0)
	end

	@ExecSpace("ServerOnly")
	method void ReviveDownedPct(number pct)
		-- 쓰러진 파티원을 지금 바로 체력 pct%로 일으킨다 (비숍 리저렉션).
		if self.PlayerDown then
			self.PlayerDown = false
			self:RevivePlayer(self._T.player)
			self.PlayerHp = math.max(1, math.floor(self.PlayerMaxHp * pct / 100 + 0.5))
			log("[VRF] duo resurrect main hp=" .. tostring(self.PlayerHp))
		end
		if self:AnyMateDownAlive() then
			self:ReviveCompanion(pct)
			log("[VRF] party resurrect members")
		end
	end

	@ExecSpace("ServerOnly")
	method void AddBlockFor(Entity e, integer n, number dur, string fx, Component owner)
		-- 피해 n회 막기 (비숍 홀리 매직쉘). 지속 동안 보호막 그림을 캐릭터에 반복. 다 깨지면 owner:OnShellBroken() 호출.
		if not isvalid(e) then return end
		if self._T.blocks == nil then self._T.blocks = {} end
		local old = self._T.blocks[e]
		if old ~= nil and (old.serial or 0) ~= 0 then _EffectService:RemoveEffect(old.serial) end
		local serial = 0
		if fx ~= nil and fx ~= "" then serial = _EffectService:PlayEffectAttached(fx, e, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), true) end
		local blocks = self._T.blocks
		blocks[e] = { n = n, till = _UtilLogic.ElapsedSeconds + dur, serial = serial, owner = owner }
		self._T.blocks = blocks
	end

	@ExecSpace("ServerOnly")
	method boolean TryBlock(Entity e)
		-- 막기가 남아 있으면 한 번 쓰고 true (MISS 표시). 다 쓰거나 시간이 지나면 그림 제거.
		if self._T.blocks == nil or not isvalid(e) then return false end
		local b = self._T.blocks[e]
		if b == nil then return false end
		if _UtilLogic.ElapsedSeconds > b.till or b.n <= 0 then
			if (b.serial or 0) ~= 0 then _EffectService:RemoveEffect(b.serial) end
			self._T.blocks[e] = nil
			return false
		end
		b.n = b.n - 1
		self._T.blocks[e] = b
		local tp = e:GetComponent("script.TowerPlayer")
		if tp ~= nil then tp:ShowMiss(e, tp:Uid()) end
		log("[VRF] duo block used left=" .. tostring(b.n))
		if b.n <= 0 then
			if (b.serial or 0) ~= 0 then _EffectService:RemoveEffect(b.serial) end
			self._T.blocks[e] = nil
			if b.owner ~= nil and isvalid(b.owner) then b.owner:OnShellBroken() end
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method Component CombatForSkill(string skillId)
		-- 그 스킬을 장착한 전투 캐릭터의 전투 컴포넌트.
		for _, h in ipairs(self:Heroes()) do
			if h:Equipped(skillId) then return h end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method Component MainHero()
		-- 메인 캐릭터(플레이어)의 히어로 전투 컴포넌트.
		return self:HeroOf(self._T.player)
	end

	@ExecSpace("ServerOnly")
	method table Actors()
		-- 이번 판 전투 캐릭터 목록: 구성원 1(직접 조작) → 2 → 3. 쓰러진 캐릭터도 포함.
		local list = {}
		if isvalid(self._T.player) then table.insert(list, self._T.player) end
		for i = 1, 2 do
			local e = self:Mate(i)
			if isvalid(e) then table.insert(list, e) end
		end
		return list
	end

	@ExecSpace("ServerOnly")
	method Entity Mate(integer i)
		-- 생성된 구성원 (i=1 → 구성원 2번, i=2 → 구성원 3번).
		local m = self._T.mates or {}
		local e = m[i]
		if isvalid(e) then return e end
		return nil
	end

	@ExecSpace("ServerOnly")
	method integer MateIndex(Entity e)
		-- 생성된 구성원 번호 (아니면 0).
		if not isvalid(e) then return 0 end
		for i = 1, 2 do
			if self:Mate(i) == e then return i end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method number MateHp(integer i)
		-- 구성원 체력.
		if i == 2 then return self.Companion2Hp end
		return self.CompanionHp
	end

	@ExecSpace("ServerOnly")
	method void SetMateHp(integer i, number v)
		-- 구성원 체력 쓰기.
		if i == 2 then self.Companion2Hp = v else self.CompanionHp = v end
	end

	@ExecSpace("ServerOnly")
	method number MateMax(integer i)
		-- 구성원 최대 체력.
		if i == 2 then return self.Companion2MaxHp end
		return self.CompanionMaxHp
	end

	@ExecSpace("ServerOnly")
	method void SetMateMax(integer i, number v)
		-- 구성원 최대 체력 쓰기.
		if i == 2 then self.Companion2MaxHp = v else self.CompanionMaxHp = v end
	end

	@ExecSpace("ServerOnly")
	method boolean MateDown(integer i)
		-- 구성원이 쓰러졌는지 (없는 구성원도 true).
		if not isvalid(self:Mate(i)) then return true end
		if i == 2 then return self.Companion2Down end
		return self.CompanionDown
	end

	@ExecSpace("ServerOnly")
	method void SetMateDown(integer i, boolean v)
		-- 구성원 쓰러짐 쓰기.
		if i == 2 then self.Companion2Down = v else self.CompanionDown = v end
	end

	@ExecSpace("ServerOnly")
	method boolean AnyMateDownAlive()
		-- 생성돼 있는데 쓰러진 구성원이 있는지.
		for i = 1, 2 do
			if isvalid(self:Mate(i)) and self:MateDown(i) then return true end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method boolean AnyMateUp()
		-- 생성된 구성원 중 쓰러지지 않은 사람이 있는지.
		for i = 1, 2 do
			if not self:MateDown(i) then return true end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method table Heroes()
		-- 전투 캐릭터들의 히어로 전투 컴포넌트 목록.
		local list = {}
		for _, e in ipairs(self:Actors()) do
			local h = self:HeroOf(e)
			if h ~= nil then table.insert(list, h) end
		end
		return list
	end

	@ExecSpace("ServerOnly")
	method boolean IsCompanion(Entity e)
		-- 생성된 구성원(2·3번)인지.
		return self:MateIndex(e) > 0
	end

	@ExecSpace("ServerOnly")
	method boolean IsDown(Entity e)
		-- 쓰러진 캐릭터인지 (공격도 받지도 않는다).
		local i = self:MateIndex(e)
		if i > 0 then return self:MateDown(i) end
		return self.PlayerDown
	end

	@ExecSpace("ServerOnly")
	method number ActorMaxHp(Entity e)
		-- 캐릭터별 최대 체력 (구성원 모두 같은 능력치를 쓴다).
		local i = self:MateIndex(e)
		if i > 0 then return self:MateMax(i) end
		return self.PlayerMaxHp
	end

	@ExecSpace("ServerOnly")
	method number ActorHp(Entity e)
		-- 캐릭터별 현재 체력.
		local i = self:MateIndex(e)
		if i > 0 then return self:MateHp(i) end
		return self.PlayerHp
	end

	@ExecSpace("ServerOnly")
	method void HealActor(Entity e, number amount)
		-- 캐릭터별 회복. 메인은 기존 회복(회복 숫자 표시 포함), 동료는 동료 체력에.
		local i = self:MateIndex(e)
		if i == 0 then
			self:HealPlayer(amount)
			return
		end
		if self:MateDown(i) then return end
		local heal = math.floor(amount * (1 + self:Bonus("HealRecv") / 100) + 0.5)
		if heal <= 0 or self:MateHp(i) >= self:MateMax(i) then return end
		self:SetMateHp(i, math.min(self:MateMax(i), self:MateHp(i) + heal))
		local tp = e:GetComponent("script.TowerPlayer")
		if tp ~= nil then tp:ShowHeal(heal, tp:Uid()) end
	end

	@ExecSpace("ServerOnly")
	method number ShieldOf(Entity e)
		-- 캐릭터별 보호막.
		local i = self:MateIndex(e)
		if i > 0 then return (self._T.mateShield or {})[i] or 0 end
		return self._T.shield or 0
	end

	@ExecSpace("ServerOnly")
	method void AddShield(Entity e, number amount)
		-- 캐릭터별 보호막 더하기(음수면 빼기, 0 아래로 내려가지 않음).
		local i = self:MateIndex(e)
		if i > 0 then
			local sh = self._T.mateShield or {}
			sh[i] = math.max(0, (sh[i] or 0) + amount)
			self._T.mateShield = sh
		else
			self._T.shield = math.max(0, (self._T.shield or 0) + amount)
		end
	end

	@ExecSpace("ServerOnly")
	method void FullHealParty()
		-- 판 시작·레벨업: 쓰러지지 않은 캐릭터 체력을 가득 채운다.
		if not self.PlayerDown then self.PlayerHp = self.PlayerMaxHp end
		for i = 1, 2 do
			if isvalid(self:Mate(i)) and not self:MateDown(i) then self:SetMateHp(i, self:MateMax(i)) end
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnCompanion()
		-- 동료 캐릭터를 메인 뒤에 세운다 (이미 있으면 자리만 맞춘다). 2인 편성 테스트 동안은 히어로 2명.
		if not self.DuoTest then return end
		local player = self._T.player
		if not isvalid(player) then return end
		self:LoadFormation()
		local mates = self._T.mates or {}
		local models = self._T.mateModels or {}
		for i = 1, 2 do
			local modelId = self:ListValue(self.CompanionModels, self._T.mateJobs[i] or "")
			if modelId == "" then modelId = self.CompanionModelId end
			local pos = self.PlayerPos + Vector3(-self.CompanionGap * i, 0, 0)
			local comp = mates[i]
			-- 편성이 바뀌어 그 자리 직업이 달라졌으면 새로 만든다
			if isvalid(comp) and models[i] ~= modelId then
				comp:Destroy()
				comp = nil
			end
			if not isvalid(comp) then
				local name = "Companion"
				if i == 2 then name = "Companion2" end
				comp = _SpawnService:SpawnByModelId(modelId, name, pos, self.Entity)
				if not isvalid(comp) then log_warning("[VRF] party member spawn failed model=" .. modelId) end
				models[i] = modelId
			end
			mates[i] = comp
			if isvalid(comp) then
				comp.TransformComponent.Position = pos
				-- 구성원 방향은 엔티티를 뒤집지 않고 아바타에 오른쪽 보기 신호를 보내 맞춘다 (TowerPlayer.FaceRight). 뒤집으면 무기 잔상이 반대로 나온다
				comp.TransformComponent.Scale = Vector3(1, 1, 1)
				-- 무기 기본 잔상은 조작 컴포넌트의 바라보는 방향을 따른다: 구성원에게도 붙이고 오른쪽으로 둔다 (없으면 잔상이 왼쪽으로 나옴)
				local pc = comp.PlayerControllerComponent
				if not isvalid(pc) then pc = comp:AddComponent("PlayerControllerComponent") end
				-- 켜 두면 상태 머신이 낙하(FALL) 자세로 바꾸므로 끄고, 방향값만 남긴다 (꺼져 있어도 잔상은 이 방향을 따름: 메이커 실측)
				if isvalid(pc) then
					pc.LookDirectionX = 1
					pc.Enable = false
				end
				local tp = comp:GetComponent("script.TowerPlayer")
				if tp ~= nil then tp.OwnerUserId = player.PlayerComponent.UserId end
			end
		end
		self._T.mates = mates
		self._T.mateModels = models
		self._T.comp = mates[1]
		for i = 1, 2 do self:ReviveMate(i, 100) end
		self:CopyCostumeToCompanion()
		log("[VRF] party ready jobs=" .. tostring(self._T.mainJob) .. "," .. tostring(self._T.mateJobs[1]) .. "," .. tostring(self._T.mateJobs[2]))
	end

	@ExecSpace("ServerOnly")
	method void LinkStatusOwner()
		-- 2인 편성: 몬스터 상태(자상·디버프·기절)는 메인 히어로가 들고, 동료 히어로는 그것을 함께 쓴다.
		local main = self:StatusHero()
		for _, h in ipairs(self:Heroes()) do
			if h.JobId == "Hero" then
				if h == main then h._T.statusOwner = nil else h._T.statusOwner = main end
			end
		end
		log("[VRF] duo status owner linked heroes=" .. tostring(#self:Heroes()))
	end

	@ExecSpace("ServerOnly")
	method void DestroyCompanion()
		-- 동료 캐릭터 제거 (로비로 갈 때·플레이어가 맵을 떠날 때).
		for i = 1, 2 do
			local comp = self:Mate(i)
			if isvalid(comp) then comp:Destroy() end
		end
		self._T.mates = {}
		self._T.mateModels = {}
		self._T.comp = nil
		-- 펫 P-C: 따라오는 펫도 함께 정리
		self:ClearPets()
		self.CompanionDown = false
		self.Companion2Down = false
	end

	@ExecSpace("ServerOnly")
	method void ReviveCompanion(number hpPct)
		-- 쓰러진 구성원(2·3번)을 모두 체력 hpPct%로 일으킨다.
		for i = 1, 2 do
			if isvalid(self:Mate(i)) and self:MateDown(i) then self:ReviveMate(i, hpPct) end
		end
	end

	@ExecSpace("ServerOnly")
	method void ReviveMate(integer i, number hpPct)
		-- 구성원 i 일으키기: 체력 hpPct%, 대기 자세.
		local comp = self:Mate(i)
		if not isvalid(comp) then return end
		self:SetMateDown(i, false)
		local sh = self._T.mateShield or {}
		sh[i] = 0
		self._T.mateShield = sh
		-- 4단계: 구성원마다 자기 최대 체력 (RecalcStats가 계산한 값, 없으면 메인 값)
		local maxHp = (self._T.mateMaxCalc or {})[i] or self.PlayerMaxHp
		self:SetMateMax(i, maxHp)
		self:SetMateHp(i, math.max(1, math.floor(maxHp * hpPct / 100 + 0.5)))
		local tp = comp:GetComponent("script.TowerPlayer")
		if tp ~= nil then tp:SetDownPose(false) end
	end

	@ExecSpace("ServerOnly")
	method void ReviveDowned()
		-- 웨이브(스테이지)를 끝내면 쓰러진 캐릭터가 체력 ReviveHpPct%로 일어난다.
		if self.PlayerDown then
			self.PlayerDown = false
			local player = self._T.player
			self:RevivePlayer(player)
			self.PlayerHp = math.max(1, math.floor(self.PlayerMaxHp * self.ReviveHpPct / 100 + 0.5))
			log("[VRF] duo revive main hp=" .. tostring(self.PlayerHp))
		end
		if self:AnyMateDownAlive() then
			self:ReviveCompanion(self.ReviveHpPct)
			log("[VRF] party revive members")
		end
	end

	@ExecSpace("ServerOnly")
	method Entity PickTarget(integer range)
		-- 몬스터 공격 대상: 살아 있는 구성원을 앞(1번)부터 세어 사거리(1·2·3)만큼 안에서 위치별 확률로 고른다.
		-- 위치 확률 1번 50% · 2번 35% · 3번 15% (사거리 안의 구성원끼리 다시 비율을 맞춘다).
		local alive = {}
		for _, e in ipairs(self:Actors()) do
			if not self:IsDown(e) then table.insert(alive, e) end
		end
		if #alive == 0 then return nil end
		local weights = { self.TargetWeight1, self.TargetWeight2, self.TargetWeight3 }
		local n = math.min(math.max(1, range), #alive, 3)
		local total = 0
		for k = 1, n do total = total + weights[k] end
		local r = _UtilLogic:RandomDouble() * total
		for k = 1, n do
			r = r - weights[k]
			if r <= 0 then return alive[k] end
		end
		return alive[n]
	end

	@ExecSpace("ServerOnly")
	method void ApplyCompanionDamage(integer damage)
		-- 검증용 호환: 구성원 2번에게 피해.
		self:ApplyMateDamage(self:Mate(1), damage)
	end

	@ExecSpace("ServerOnly")
	method void ApplyMateDamage(Entity comp, integer damage)
		-- 몬스터 공격이 구성원(2·3번)에게 맞았을 때: 무적·보호막 후 체력을 깎고, 0이면 쓰러짐. 셋 다 쓰러지면 패배.
		if self._T.debugGod then return end
		local i = self:MateIndex(comp)
		if i == 0 or self.RunState ~= "FIGHT" or self:MateDown(i) then return end
		local hero = self:HeroOf(comp)
		if self:TryBlock(comp) then return end
		if self:IsHeroRun() and hero ~= nil and hero:IsInvuln() then return end
		local sh = self._T.mateShield or {}
		local shield = sh[i] or 0
		if shield > 0 then
			local absorbed = math.min(shield, damage)
			sh[i] = shield - absorbed
			self._T.mateShield = sh
			damage = damage - absorbed
		end
		if self._T.probe ~= nil then self._T.probe.taken = self._T.probe.taken + math.min(self:MateHp(i), damage) end
		self:SetMateHp(i, math.max(0, self:MateHp(i) - damage))
		local tp = comp:GetComponent("script.TowerPlayer")
		if tp ~= nil and damage > 0 then tp:ShowProcDamage(comp, damage, false, tp:Uid()) end
		if self:MateHp(i) > 0 then
			-- 각인 핵심 '수호막'
			if damage > 0 then self:TalentHitShield(comp) end
			return
		end
		local accRevive = self:AccessoryBonus(comp, "Undying")
		if accRevive > 0 and not (self._T.accUndying or {})[i + 1] then
			self._T.accUndying[i + 1] = true
			self:SetMateHp(i, math.max(1, math.floor(self:MateMax(i) * accRevive / 100)))
			log("[VRF] accessory undying mate=" .. tostring(i))
			return
		end
		if self:UseDeathWard(comp) then
			self:SetMateHp(i, 1)
			return
		end
		self:SetMateDown(i, true)
		if tp ~= nil then tp:SetDownPose(true) end
		log("[VRF] party member " .. tostring(i + 1) .. " down")
		if self.PlayerDown and not self:AnyMateUp() then
			-- 펫 P-C: 쁘띠 데스 — 판마다 1회 전멸 대신 부활
			if self:TryPetRevive() then
				if tp ~= nil then tp:SetDownPose(false) end
				return
			end
			self:Defeat()
		end
	end

	@ExecSpace("ServerOnly")
	method boolean HeroBreak(string skillId, string breakId)
		-- 히어로 전투 로직용: 이번 판에 그 돌파를 얻었는지. 4-F: 그 스킬이 든 칸에 같은 번호 돌파가 붙어 있으면 켜진 것.
		return self:BreakTakenFor(skillId, breakId)
	end

	@ExecSpace("ServerOnly")
	method number HeroStarVal(string skillId, string key)
		-- 히어로 전투 로직용: 별 강화 합계 (StarPower / StarTempo / StarCrit).
		local m = self._T.skillMods[skillId]
		if m == nil then return 0 end
		return m[key] or 0
	end

	@ExecSpace("ServerOnly")
	method void HeroSetStun(number sec)
		-- 히어로 전투 로직용: 몬스터 기절 (다음 공격 지연 + 기절 중 판정).
		self.MonsterAttackTimer = math.max(self.MonsterAttackTimer, sec)
		self._T.stunUntil = _UtilLogic.ElapsedSeconds + sec
	end

	@ExecSpace("ServerOnly")
	method void HeroSetVuln(number pct, number sec)
		-- 히어로 전투 로직용: 몬스터가 받는 피해 증가 (약점).
		self._T.vulnUntil = _UtilLogic.ElapsedSeconds + sec
		self._T.vulnPct = pct
	end

	@ExecSpace("ServerOnly")
	method boolean IsHeroRun()
		-- 이번 판이 히어로 2단계 전투(장착 스킬 5종)인지.
		local hero = self:MainHero()
		return self:IsSkillJob(self.JobId) and hero ~= nil and hero.Active
	end

	@ExecSpace("ServerOnly")
	method void LoadRunConfig()
		-- 밸런스 수치를 RunConfig(Key, Value) 데이터셋에서 읽는다. 표에 없거나 숫자가 아니면 아래 속성 기본값을 유지.
		local ds = _DataService:GetTable(self.RunConfigTableName)
		if ds == nil then
			log_warning("[VRF] RunConfig table missing, using defaults")
			return
		end
		local cfg = {}
		for i = 1, ds:GetRowCount() do
			local k = ds:GetCell(i, "Key")
			local v = tonumber(ds:GetCell(i, "Value"))
			if k ~= nil and k ~= "" and v ~= nil then cfg[k] = v end
		end
		local function n(key, cur)
			local v = cfg[key]
			if v == nil then return cur end
			return v
		end
		local function i(key, cur)
			local v = cfg[key]
			if v == nil then return cur end
			return math.floor(v)
		end
		self.MonsterHpBase = n("MonsterHpBase", self.MonsterHpBase)
		self.SkillBookBossBase = n("SkillBookBossBase", self.SkillBookBossBase)
		self.SkillBookBossPerFloor = n("SkillBookBossPerFloor", self.SkillBookBossPerFloor)
		self.GoldMesoStageBase = n("GoldMesoStageBase", self.GoldMesoStageBase)
		self.GoldMesoPerFloor = n("GoldMesoPerFloor", self.GoldMesoPerFloor)
		self.GoldMesoEliteMul = n("GoldMesoEliteMul", self.GoldMesoEliteMul)
		self.GoldMesoBossMul = n("GoldMesoBossMul", self.GoldMesoBossMul)
		self.MonsterHpPerLevel = n("MonsterHpPerLevel", self.MonsterHpPerLevel)
		self.MonsterAtkBase = n("MonsterAtkBase", self.MonsterAtkBase)
		self.MonsterAtkPerLevel = n("MonsterAtkPerLevel", self.MonsterAtkPerLevel)
		self.MonsterAttackInterval = n("MonsterAttackInterval", self.MonsterAttackInterval)
		self.StagesPerFloor = i("StagesPerFloor", self.StagesPerFloor)
		self.LastStageStatMul = n("LastStageStatMul", self.LastStageStatMul)
		self.StageLevelStep = n("StageLevelStep", self.StageLevelStep)
		self.FloorsPerStage = math.max(1, i("FloorsPerStage", self.FloorsPerStage))
		self.SectionsPerFloor = math.max(1, i("SectionsPerFloor", self.SectionsPerFloor))
		self.WaveSizeBase = math.max(1, i("WaveSizeBase", self.WaveSizeBase))
		self.WaveSizePerSection = n("WaveSizePerSection", self.WaveSizePerSection)
		self.MeleeGap = n("MeleeGap", self.MeleeGap)
		self.SpawnSpacing = n("SpawnSpacing", self.SpawnSpacing)
		self.SpawnSpacingRand = n("SpawnSpacingRand", self.SpawnSpacingRand)
		self.WalkSpeedRand = n("WalkSpeedRand", self.WalkSpeedRand)
		self.SlotJitter = n("SlotJitter", self.SlotJitter)
		self.RangedOffset = n("RangedOffset", self.RangedOffset)
		self.RangedGap = n("RangedGap", self.RangedGap)
		self.RangedRatio = n("RangedRatio", self.RangedRatio)
		self.SplashReach = n("SplashReach", self.SplashReach)
		self.SpawnOffsetX = n("SpawnOffsetX", self.SpawnOffsetX)
		self.MonsterWalkSpeed = n("MonsterWalkSpeed", self.MonsterWalkSpeed)
		self.QueueShowMax = i("QueueShowMax", self.QueueShowMax)
		self.WaveGroupInterval = n("WaveGroupInterval", self.WaveGroupInterval)
		for gi = 1, ds:GetRowCount() do
			if ds:GetCell(gi, "Key") == "WaveGroups" then self.WaveGroups = ds:GetCell(gi, "Value") or self.WaveGroups end
		end
		self.StageLevelUp = n("StageLevelUp", self.StageLevelUp and 1 or 0) > 0
		self.EliteExtraPicks = i("EliteExtraPicks", self.EliteExtraPicks)
		self.WavesPerStage = i("WavesPerStage", self.WavesPerStage)
		self.EliteScale = n("EliteScale", self.EliteScale)
		self.StarTimeLimit = n("StarTimeLimit", self.StarTimeLimit)
		self.StarHpRatio = n("StarHpRatio", self.StarHpRatio)
		self.StageClearHealPct = n("StageClearHealPct", self.StageClearHealPct)
		self.UltGaugeMax = n("UltGaugeMax", self.UltGaugeMax)
		self.UltGaugeBasic = n("UltGaugeBasic", self.UltGaugeBasic)
		self.UltGaugeSkill = n("UltGaugeSkill", self.UltGaugeSkill)
		self.UltGaugePerSec = n("UltGaugePerSec", self.UltGaugePerSec)
		self.StageBookBase = n("StageBookBase", self.StageBookBase)
		self.StageBookPerStage = n("StageBookPerStage", self.StageBookPerStage)
		self.StageFeatherBase = n("StageFeatherBase", self.StageFeatherBase)
		self.StageFeatherPerStage = n("StageFeatherPerStage", self.StageFeatherPerStage)
		self.EliteRewardMul = n("EliteRewardMul", self.EliteRewardMul)
		self.MonsterCritDmg = n("MonsterCritDmg", self.MonsterCritDmg)
		self.BasePlayerAtk = n("BasePlayerAtk", self.BasePlayerAtk)
		self.BasePlayerMaxHp = n("BasePlayerMaxHp", self.BasePlayerMaxHp)
		self.LevelAtkBonus = n("LevelAtkBonus", self.LevelAtkBonus)
		self.LevelDefBonus = n("LevelDefBonus", self.LevelDefBonus)
		self.LevelHpBonus = n("LevelHpBonus", self.LevelHpBonus)
		self.BaseCritDmg = n("BaseCritDmg", self.BaseCritDmg)
		self.BaseMastery = n("BaseMastery", self.BaseMastery)
		self.MesoMinRate = n("MesoMinRate", self.MesoMinRate)
		self.MesoMaxRate = n("MesoMaxRate", self.MesoMaxRate)
		self.DefConstant = n("DefConstant", self.DefConstant)
		self.EnhanceBaseRate = n("EnhanceBaseRate", self.EnhanceBaseRate)
		self.EnhanceRateStep = n("EnhanceRateStep", self.EnhanceRateStep)
		self.MaxEnhance = i("MaxEnhance", self.MaxEnhance)
		self.EnhanceStatStep = n("EnhanceStatStep", self.EnhanceStatStep)
		self.EnhanceCostStep = n("EnhanceCostStep", self.EnhanceCostStep)
		self.UpgradeCostMul = n("UpgradeCostMul", self.UpgradeCostMul)
		self.BaseMesoReward = n("BaseMesoReward", self.BaseMesoReward)
		self.MesoGrowth = n("MesoGrowth", self.MesoGrowth)
		self.BaseExpReward = n("BaseExpReward", self.BaseExpReward)
		self.ExpGrowth = n("ExpGrowth", self.ExpGrowth)
		self.BaseExpToNext = n("BaseExpToNext", self.BaseExpToNext)
		self.ExpToNextGrowth = n("ExpToNextGrowth", self.ExpToNextGrowth)
		self.MesoProcRatio = n("MesoProcRatio", self.MesoProcRatio)
		self.FeatherChance = n("FeatherChance", self.FeatherChance)
		self.BossFeatherMin = i("BossFeatherMin", self.BossFeatherMin)
		self.BossFeatherMax = i("BossFeatherMax", self.BossFeatherMax)
		self.ScrollChance = n("ScrollChance", self.ScrollChance)
		self.ScrollChancePerFloor = n("ScrollChancePerFloor", self.ScrollChancePerFloor)
		self.ScrollChancePerStage = n("ScrollChancePerStage", self.ScrollChancePerStage)
		self.ScrollBossMin = i("ScrollBossMin", self.ScrollBossMin)
		self.ScrollBossMax = i("ScrollBossMax", self.ScrollBossMax)
		self.ScrollStageShift = n("ScrollStageShift", self.ScrollStageShift)
		self.SlotStatStep = n("SlotStatStep", self.SlotStatStep)
		-- 전투 능력치 개편: 속성 배율·마법 방어 비율·빗나감 상한 (속성 선언 없이 _T.cm에 보관)
		self._T.cm = { weak = n("ElemWeakMul", 1.5), resist = n("ElemResistMul", 0.5), immune = n("ElemImmuneMul", 0.1), magicDef = n("MagicDefRatio", 0.5),
			missCap = n("MissCap", 60), evadeCap = n("PlayerEvadeCap", 50), missTotalCap = n("PlayerMissTotalCap", 75), magicNeverMiss = n("MagicNeverMiss", 1) == 1 }
		local count = 0
		for _ in pairs(cfg) do count = count + 1 end
		log("[VRF] RunConfig loaded keys=" .. tostring(count) .. " baseMeso=" .. tostring(self.BaseMesoReward) .. " expToNext=" .. tostring(self.BaseExpToNext) .. " enhanceRate=" .. tostring(self.EnhanceBaseRate) .. " stages=" .. tostring(self.StagesPerFloor))
	end

	@ExecSpace("ServerOnly")
	method void LoadMonsterTables()
		-- 몬스터 테이블에서 RUID가 있는 몬스터만 레벨 순으로 모으고, 타입별 배율 / 층 / 접두사 테이블을 읽는다.
		self._T.monsters = {}
		self._T.monsterById = {}
		self._T.typeMul = {}
		self._T.floors = {}
		self._T.prefixes = {}
		local floorDs = _DataService:GetTable(self.FloorTableName)
		if floorDs ~= nil then
			for i = 1, floorDs:GetRowCount() do
				-- MonsterIds = 이 층에 나오는 몬스터 목록 ("1|3|2"), 비어 있으면 대표 몬스터 하나
				local pool = {}
				for id in string.gmatch(floorDs:GetCell(i, "MonsterIds") or "", "[^|]+") do table.insert(pool, id) end
				if #pool == 0 then table.insert(pool, floorDs:GetCell(i, "MonsterId")) end
				-- 보스 개편 B2: 층 마지막 보스 = FieldBossId (MonsterTable id), 보스 스테이지 동안 BossBgRUID 배경 (빈칸 = 층 배경), BossTileSetRUID (빈칸 = 층 타일셋)
				table.insert(self._T.floors, { name = floorDs:GetCell(i, "FloorName"), monsterId = floorDs:GetCell(i, "MonsterId"), pool = pool,
					bg = floorDs:GetCell(i, "BgRUID") or "", ts = floorDs:GetCell(i, "TileSetRUID") or "",
					fieldBoss = floorDs:GetCell(i, "FieldBossId") or "", bossBg = floorDs:GetCell(i, "BossBgRUID") or "", bossTs = floorDs:GetCell(i, "BossTileSetRUID") or "" })
			end
		end
		local prefixDs = _DataService:GetTable(self.PrefixTableName)
		if prefixDs ~= nil then
			for i = 1, prefixDs:GetRowCount() do
				table.insert(self._T.prefixes, { name = prefixDs:GetCell(i, "Prefix"), stat = prefixDs:GetCell(i, "Stat"), value = tonumber(prefixDs:GetCell(i, "Value")) or 0 })
			end
		end
		local types = _DataService:GetTable(self.MonsterTypeTableName)
		if types ~= nil then
			for i = 1, types:GetRowCount() do
				local t = types:GetCell(i, "Type")
				self._T.typeMul[t] = { hp = tonumber(types:GetCell(i, "HpMul")) or 1, atk = tonumber(types:GetCell(i, "AtkMul")) or 1, evade = tonumber(types:GetCell(i, "EvadeRate")) or 0,
					defP = tonumber(types:GetCell(i, "DefP") or "") or 0, defM = tonumber(types:GetCell(i, "DefM") or "") or 0 }
			end
		end
		local ds = _DataService:GetTable(self.MonsterTableName)
		if ds == nil then
			log_error("[VRF] MonsterTable not found")
			return
		end
		for i = 1, ds:GetRowCount() do
			local stand = ds:GetCell(i, "StandRUID")
			if stand ~= nil and stand ~= "" then
				local entry = {
					name = ds:GetCell(i, "Name"),
					level = tonumber(ds:GetCell(i, "Level")) or 1,
					type = ds:GetCell(i, "Type"),
					stand = stand,
					attack = ds:GetCell(i, "AttackRUID"),
					hit = ds:GetCell(i, "HitRUID"),
					die = ds:GetCell(i, "DieRUID"),
					hitSound = ds:GetCell(i, "HitSoundRUID"),
					dieSound = ds:GetCell(i, "DieSoundRUID"),
					move = ds:GetCell(i, "MoveRUID") or "",
					range = math.max(1, math.min(3, math.floor(tonumber(ds:GetCell(i, "AttackRange") or "1") or 1))),
					-- MonsterTable Ranged = 1 이면 이 몬스터는 웨이브에서 항상 원거리
					ranged = tonumber(ds:GetCell(i, "Ranged") or "0") == 1,
					-- 전투 능력치 개편: 몬스터 공격 타입(P/M), 물리·마법 방어(빈칸 = 타입 기본), 속성 상성("Fire:W|Ice:R|Poison:N")
					atkType = self:DmgTypeOf(ds:GetCell(i, "AtkType") or ""),
					defP = tonumber(ds:GetCell(i, "DefP") or ""),
					defM = tonumber(ds:GetCell(i, "DefM") or ""),
					elem = self:ParseElemTable(ds:GetCell(i, "Elem") or ""),
				}
				table.insert(self._T.monsters, entry)
				self._T.monsterById[ds:GetCell(i, "id")] = entry
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void LoadEquipTable()
		-- 장비 테이블을 부위·단계별로 읽는다.
		-- 5-C: 신발 제거 (신발이 주던 치명타 데미지는 장갑 두 번째 능력치 Stat2)
		self._T.slots = { "Weapon", "Cap", "Coat", "Glove", "Cape" }
		self._T.equip = {}
		self._T.jobEquip = {}
		for _, slot in ipairs(self._T.slots) do self._T.equip[slot] = {} end
		-- 부위 해금 조건 (최고 기록 층)
		self._T.unlockFloor = {}
		self:LoadScrollDrop()
		self._T.costMul = {}
		local slotDs = _DataService:GetTable(self.EquipSlotTableName)
		if slotDs ~= nil then
			for i = 1, slotDs:GetRowCount() do
				self._T.unlockFloor[slotDs:GetCell(i, "Slot")] = tonumber(slotDs:GetCell(i, "UnlockBestFloor")) or 0
				-- 부위별 강화 비용 배율 (공격력·방어력·체력 부위 1배, 나머지는 더 비쌈)
				self._T.costMul[slotDs:GetCell(i, "Slot")] = tonumber(slotDs:GetCell(i, "CostMul")) or 1
			end
		end
		local ds = _DataService:GetTable(self.EquipTableName)
		if ds == nil then
			log_error("[VRF] EquipTable not found")
			return
		end
		for i = 1, ds:GetRowCount() do
			local slot = ds:GetCell(i, "Slot")
			local tier = tonumber(ds:GetCell(i, "Tier")) or 1
			-- Job 열이 있는 줄 = 그 직업 전용 이름·외형 (수치는 공용 줄과 같게 둠)
			local job = ds:GetCell(i, "Job") or ""
			if job ~= "" then
				if self._T.jobEquip[job] == nil then self._T.jobEquip[job] = {} end
				if self._T.jobEquip[job][slot] == nil then self._T.jobEquip[job][slot] = {} end
				self._T.jobEquip[job][slot][tier] = { name = ds:GetCell(i, "Name"), ruid = ds:GetCell(i, "ItemRUID") or "" }
			elseif self._T.equip[slot] ~= nil then
				self._T.equip[slot][tier] = {
					name = ds:GetCell(i, "Name"),
					ruid = ds:GetCell(i, "ItemRUID"),
					value = tonumber(ds:GetCell(i, "StatValue")) or 0,
					value2 = tonumber(ds:GetCell(i, "Stat2Value")) or 0,
					cost = tonumber(ds:GetCell(i, "EnhCostBase")) or 10,
				}
			end
		end
	end

	@ExecSpace("ServerOnly")
	method number SkillValue(string skillType)
		-- 배운 패시브의 기본 효과 + 이번 판에 얻은 별·돌파 옵션 + 지금 지속 중인 버프 합계.
		local total = (self._T.runBonus or {})[skillType] or 0
		for _, sk in ipairs(self:JobSkills()) do
			if sk.trigger == "Passive" and (self.SkillLv[sk.id] or 0) > 0 then
				for _, e in ipairs(sk.effects) do
					if e.type == skillType then total = total + e.base end
				end
			end
		end
		for _, b in ipairs(self._T.buffs or {}) do
			if b.key == skillType then total = total + b.value end
		end
		return total
	end

	@ExecSpace("ServerOnly")
	method void LoadJobTables()
		-- 직업(고를 수 있는 직업만 선택지)과 직업 스킬 테이블을 읽는다.
		self._T.jobById = {}
		self._T.jobOrder = {}
		self._T.playableJobs = {}
		local ds = _DataService:GetTable(self.TraitTableName)
		if ds ~= nil then
			for i = 1, ds:GetRowCount() do
				local j = { id = ds:GetCell(i, "Id"), name = ds:GetCell(i, "Name"), weapon = ds:GetCell(i, "Weapon") or "",
					weaponCat = ds:GetCell(i, "WeaponCat") or "OneHanded", weaponFamily = ds:GetCell(i, "WeaponFamily") or "O", family = ds:GetCell(i, "Family") or "", playable = (tonumber(ds:GetCell(i, "Playable")) or 0) == 1 }
				self._T.jobById[j.id] = j
				table.insert(self._T.jobOrder, j.id)
				if j.playable then table.insert(self._T.playableJobs, j.id) end
			end
		end
		-- 스킬 표: 기본(JobSkillTable) + 연출(SkillActionTable) + 돌파(SkillBreakTable) + 별 옵션(SkillStarOptionTable)
		self._T.jobSkills = {}
		self._T.skillById = {}
		local actions = {}
		local at = _DataService:GetTable("SkillActionTable")
		if at ~= nil then
			for i = 1, at:GetRowCount() do
				actions[at:GetCell(i, "SkillId")] = { frames = at:GetCell(i, "ActionFrames") or "", time = tonumber(at:GetCell(i, "ActionTime")) or 0.8, caster = at:GetCell(i, "CasterFx") or "", hit = at:GetCell(i, "HitFx") or "", scale = tonumber(at:GetCell(i, "FxScale")) or 1, mob = at:GetCell(i, "MobFx") or "",
					policy = at:GetCell(i, "HitPolicy") or "", useSound = at:GetCell(i, "UseSound") or "", hitSound = at:GetCell(i, "HitSound") or "", gap = tonumber(at:GetCell(i, "HitGap")) or 0.12, hitY = tonumber(at:GetCell(i, "HitY")) or 0.45 }
			end
		end
		local js = _DataService:GetTable(self.JobSkillTableName)
		if js ~= nil then
			for i = 1, js:GetRowCount() do
				local job = js:GetCell(i, "JobId")
				local id = js:GetCell(i, "SkillId")
				local effects = {}
				for k = 1, 2 do
					local ty = js:GetCell(i, "Type" .. tostring(k))
					if ty ~= nil and ty ~= "" then table.insert(effects, { type = ty, base = tonumber(js:GetCell(i, "V" .. tostring(k))) or 0 }) end
				end
				-- 액티브: ProcType(Strike/CritStrike/Pierce/Double/Freeze/Heal/MesoStrike/Dice/Buff), 확률 %, 계수 %, 타수
				local proc = nil
				local pt = js:GetCell(i, "ProcType")
				if pt ~= nil and pt ~= "" then
					local hits = tonumber(js:GetCell(i, "ProcHits")) or 0
					if hits <= 0 then
						hits = 1
						if pt == "Double" then hits = 2 end
					end
					local a = actions[id] or { frames = "", time = 0.8, caster = "", hit = "", scale = 1, mob = "" }
					proc = { type = pt, chance = tonumber(js:GetCell(i, "Chance")) or 0, pct = tonumber(js:GetCell(i, "Pct")) or 0, hits = hits,
						fx = a.hit, fxScale = a.scale, actionFrames = a.frames, actionTime = a.time, casterFx = a.caster, mobFx = a.mob,
						dotPct = tonumber(js:GetCell(i, "DotPct")) or 0, dotTime = tonumber(js:GetCell(i, "DotTime")) or 0,
						policy = a.policy or "", useSound = a.useSound or "", hitSound = a.hitSound or "", hitGap = a.gap or 0.12, hitY = a.hitY or 0.45 }
				end
				local sk = { id = id, job = job, name = js:GetCell(i, "Name"), trigger = js:GetCell(i, "Trigger") or "Proc", pool = js:GetCell(i, "StarPool") or "", cooldown = tonumber(js:GetCell(i, "Cooldown")) or 0,
					buffTime = tonumber(js:GetCell(i, "BuffTime")) or 0, effects = effects, proc = proc, breaks = {}, max = 30,
					kind = js:GetCell(i, "SkillType") or "", mana = tonumber(js:GetCell(i, "Mana")) or 0, comboUse = tonumber(js:GetCell(i, "ComboUse")) or 0,
					comboBonus = tonumber(js:GetCell(i, "ComboBonus")) or 0, bleed = tonumber(js:GetCell(i, "Bleed")) or 0, element = js:GetCell(i, "Element") or "",
					-- 전투 능력치 개편: 스킬 공격 타입(DmgType P/M, 빈칸 = 직업 값)·속성 Id(Element 빈칸 = 직업 기본 속성)
					dmgType = self:DmgTypeOf(js:GetCell(i, "DmgType") or ""), elemId = "" }
				if (sk.element or "") ~= "" then sk.elemId = self:ElemIdOf(sk.element) end
				if self._T.jobSkills[job] == nil then self._T.jobSkills[job] = {} end
				table.insert(self._T.jobSkills[job], sk)
				self._T.skillById[id] = sk
			end
		end
		self._T.breakById = {}
		local bt = _DataService:GetTable("SkillBreakTable")
		if bt ~= nil then
			for i = 1, bt:GetRowCount() do
				local b = { id = bt:GetCell(i, "OptionId"), skill = bt:GetCell(i, "SkillId"), name = bt:GetCell(i, "Name"), effect = bt:GetCell(i, "Effect"), value = tonumber(bt:GetCell(i, "Value")) or 0 }
				self._T.breakById[b.id] = b
				local sk = self._T.skillById[b.skill]
				if sk ~= nil then
					table.insert(sk.breaks, b)
					sk.max = #sk.breaks * 3
					-- 히어로: Lv.1(장착)에서 시작, 별 강화 사이사이 돌파 최대 3개 → Lv.9
					if sk.pool == "HeroStar" then sk.max = 9 end
				end
			end
		end
		-- 히어로식 성장(HeroStar) 스킬은 돌파가 아직 없어도 최대 Lv.9 (비숍 1차 구현 등)
		for _, sk in pairs(self._T.skillById) do
			if sk.pool == "HeroStar" then sk.max = 9 end
		end
		self._T.starOpts = {}
		self._T.starById = {}
		local st = _DataService:GetTable("SkillStarOptionTable")
		if st ~= nil then
			for i = 1, st:GetRowCount() do
				local o = { id = st:GetCell(i, "OptionId"), pool = st:GetCell(i, "Pool"), name = st:GetCell(i, "Name"), effect = st:GetCell(i, "Effect"), value = tonumber(st:GetCell(i, "Value")) or 0, weight = tonumber(st:GetCell(i, "Weight")) or 1 }
				if self._T.starOpts[o.pool] == nil then self._T.starOpts[o.pool] = {} end
				table.insert(self._T.starOpts[o.pool], o)
				self._T.starById[o.id] = o
			end
		end
		-- 스킬 자신에게만 적용되는 옵션 (나머지는 Bonus로 합산되는 전역 효과)
		self._T.localFx = {}
		for _, k in ipairs({ "Pct", "Chance", "CooldownPct", "CooldownSec", "Hits", "CritChance", "SkillCritDmg", "HealCast", "SkillDefIgnore", "Repeat", "SkillLowHp", "SkillElite", "PostSpeed", "PostSpeedShort", "PostAtk", "SkillDrain", "ResetOnKill", "Vuln", "MonDelay", "AlwaysCrit", "StunSec", "StunVuln", "StunCrit", "EndBurst", "EliteStun", "CdOnCast", "Follow", "KillHealSkill", "BuffTime", "BuffAtk", "BuffCritDmg", "BuffSpeed", "BuffReduce", "BuffDrain", "BuffCrit", "BuffBurst", "DotPct", "DotTime", "BurnBurst", "BurnVuln", "BurnHeal", "StarPower", "StarTempo", "StarCrit", "HeroBreak" }) do
			self._T.localFx[k] = true
		end
		log("[VRF] jobs playable=" .. tostring(#self._T.playableJobs))
		self:LoadSlotTune()
		self:LoadPassive()
	end

	@ExecSpace("ServerOnly")
	method void LoadSlotTune()
		-- 4-C: 칸·차수별 전투 수치(CharSkillSlotTable). 칸에 들어가는 스킬의 원본은 CharSlotTable이며, 두 표가 다르면 경고 후 CharSlotTable 값을 쓴다.
		self._T.slotTune = {}
		local slotIds = {}
		local cs = _DataService:GetTable("CharSlotTable")
		if cs ~= nil then
			for i = 1, cs:GetRowCount() do
				local job = cs:GetCell(i, "JobId") or ""
				local key = cs:GetCell(i, "SlotKey") or ""
				for t = 1, 5 do slotIds[job .. "." .. key .. "." .. tostring(t)] = cs:GetCell(i, "T" .. tostring(t)) or "" end
			end
		end
		local ds = _DataService:GetTable("CharSkillSlotTable")
		local rows = 0
		if ds ~= nil then
			for i = 1, ds:GetRowCount() do
				local job = ds:GetCell(i, "JobId") or ""
				local slot = ds:GetCell(i, "SlotKey") or ""
				local tier = math.floor(tonumber(ds:GetCell(i, "Tier")) or 0)
				local k = job .. "." .. slot .. "." .. tostring(tier)
				local id = ds:GetCell(i, "SkillId") or ""
				local real = slotIds[k]
				if real ~= nil and real ~= id then
					log_warning("[VRF] slot tune mismatch " .. k .. " tune=" .. id .. " slot=" .. real)
					id = real
				end
				local function num(col, def)
					local v = tonumber(ds:GetCell(i, col))
					if v == nil then return def end
					return v
				end
				self._T.slotTune[k] = { id = id, pctMul = num("PctMul", 1), cdSec = num("CdSec", 0), mana = num("Mana", -1), triggerAs = ds:GetCell(i, "TriggerAs") or "" }
				rows = rows + 1
			end
		else
			log_warning("[VRF] CharSkillSlotTable missing")
		end
		log("[VRF] slot tune rows=" .. tostring(rows))
	end

	@ExecSpace("ServerOnly")
	method table SlotTune(string job, string slot, integer tier)
		-- 그 직업·칸·차수의 전투 수치. 없으면 기본값(배율 1, 표 쿨·마나 그대로, 발동 방식 그대로).
		local t = (self._T.slotTune or {})[job .. "." .. slot .. "." .. tostring(tier)]
		if t == nil then return { id = "", pctMul = 1, cdSec = 0, mana = -1, triggerAs = "" } end
		return t
	end

	@ExecSpace("ServerOnly")
	method void LoadPassive()
		-- 4-E: 고유 패시브 차수별 효과(CharPassiveTable). passive["직업.차수"] = { lv, grants = {스킬Id…}, extra = { 키 = true } }
		self._T.passive = {}
		local ds = _DataService:GetTable("CharPassiveTable")
		local rows = 0
		if ds == nil then
			log_warning("[VRF] CharPassiveTable missing")
			return
		end
		for i = 1, ds:GetRowCount() do
			local job = ds:GetCell(i, "JobId") or ""
			local tier = math.floor(tonumber(ds:GetCell(i, "Tier")) or 0)
			local p = { lv = math.floor(tonumber(ds:GetCell(i, "PassiveLv")) or 0), grants = {}, extra = {} }
			for id in string.gmatch(ds:GetCell(i, "Grant") or "", "[^|]+") do table.insert(p.grants, id) end
			for k in string.gmatch(ds:GetCell(i, "Extra") or "", "[^|]+") do p.extra[k] = true end
			self._T.passive[job .. "." .. tostring(tier)] = p
			rows = rows + 1
		end
		log("[VRF] passive rows=" .. tostring(rows))
	end

	@ExecSpace("ServerOnly")
	method table PassiveOf(string job, integer tier)
		-- 4-E: 그 직업·차수의 고유 패시브 (표에 없으면 레벨 2×차수−1, 흡수·강화 없음).
		if self._T.passive == nil then self:LoadPassive() end
		local p = self._T.passive[job .. "." .. tostring(tier)]
		if p == nil then return { lv = math.max(1, 2 * tier - 1), grants = {}, extra = {} } end
		return p
	end

	@ExecSpace("ServerOnly")
	method void RegisterSlots(string job, table slotOf)
		-- 4-F: 전투 컴포넌트가 장착한 칸 등록. 돌파 저장 키 slotKeyOf[스킬Id] = "직업.칸" (패시브 숨은 스킬은 스킬Id 그대로).
		if self._T.slotKeyOf == nil then self._T.slotKeyOf = {} end
		for id, slot in pairs(slotOf or {}) do
			if slot ~= "" and slot ~= "Passive" then self._T.slotKeyOf[id] = job .. "." .. slot else self._T.slotKeyOf[id] = id end
		end
	end

	@ExecSpace("ServerOnly")
	method void ResetSkillAlias()
		-- 스킬 개편: 지난 판에 입힌 새 스킬 이름·속성을 원래 표 값으로 되돌린다.
		for beh, orig in pairs(self._T.aliasOrig or {}) do
			local sk = (self._T.skillById or {})[beh]
			if sk ~= nil then
				sk.name = orig.name
				sk.element = orig.element
				sk.elemId = orig.elemId
				sk.dmgType = orig.dmgType
			end
		end
		self._T.aliasOrig = {}
		self._T.aliasOf = {}
		self.SkillAlias = ""
	end

	@ExecSpace("ServerOnly")
	method void RegisterSkillAlias(string job, table alias)
		-- 스킬 개편: 전투 컴포넌트가 동작 기준 스킬(beh)에 입힌 새 스킬(alias[beh] = 새 Id)의 이름·속성·공격 타입을 판 스킬 정보에도 입힌다.
		-- 타격 속성(HitProfile)·돌파 카드 이름·마법의 서가 이 값을 쓴다. 같은 직업의 이전 입힘은 먼저 되돌린다.
		if self._T.aliasOrig == nil then self._T.aliasOrig = {} end
		if self._T.aliasOf == nil then self._T.aliasOf = {} end
		for beh, orig in pairs(self._T.aliasOrig) do
			local sk = (self._T.skillById or {})[beh]
			if sk ~= nil and sk.job == job then
				sk.name = orig.name
				sk.element = orig.element
				sk.elemId = orig.elemId
				sk.dmgType = orig.dmgType
				self._T.aliasOrig[beh] = nil
				self._T.aliasOf[beh] = nil
			end
		end
		local n = 0
		for beh, did in pairs(alias or {}) do
			local sk = (self._T.skillById or {})[beh]
			local src = (self._T.skillById or {})[did]
			if sk ~= nil and src ~= nil and beh ~= did then
				self._T.aliasOrig[beh] = { name = sk.name, element = sk.element, elemId = sk.elemId, dmgType = sk.dmgType }
				sk.name = src.name
				sk.element = src.element
				sk.elemId = src.elemId
				sk.dmgType = src.dmgType
				self._T.aliasOf[beh] = did
				n = n + 1
			end
		end
		local parts = {}
		for beh, did in pairs(self._T.aliasOf) do table.insert(parts, beh .. "=" .. did) end
		table.sort(parts)
		self.SkillAlias = table.concat(parts, ",")
		log("[VRF] skill alias registered job=" .. job .. " n=" .. tostring(n) .. " all=" .. self.SkillAlias)
	end

	@ExecSpace("ServerOnly")
	method string BreakKey(string skillId)
		-- 4-F: 돌파 저장 키. 칸 스킬이면 "직업.칸", 아니면(패시브 숨은 스킬·칸 밖) 스킬Id.
		-- 규칙: 칸에 n번 돌파가 붙어 있으면, 그 칸에 지금 들어 있는 스킬의 n번 돌파가 켜진 것으로 본다.
		-- 새 스킬에 n번 돌파가 없으면(예: B6) 효과 없이 기록만 남는다. 히어로식 스킬당 최대 3개 제한도 칸 기준으로 센다.
		return (self._T.slotKeyOf or {})[skillId] or skillId
	end

	@ExecSpace("ServerOnly")
	method integer BreakNo(string breakId)
		-- 4-F: 돌파 Id("H02_B1")의 번호(1). gsub 대신 find + sub.
		local s = string.find(breakId, "_B", 1, true)
		if s == nil then return 0 end
		return math.floor(tonumber(string.sub(breakId, s + 2)) or 0)
	end

	@ExecSpace("ServerOnly")
	method boolean BreakTakenFor(string skillId, string breakId)
		-- 4-F: 그 스킬의 칸에 그 번호 돌파가 붙어 있는지.
		local t = (self._T.breakTaken or {})[self:BreakKey(skillId)]
		return t ~= nil and t[self:BreakNo(breakId)] == true
	end

	@ExecSpace("ServerOnly")
	method void MarkBreakTaken(string skillId, string breakId)
		-- 4-F: 그 스킬의 칸에 그 번호 돌파를 붙인다.
		if self._T.breakTaken == nil then self._T.breakTaken = {} end
		local key = self:BreakKey(skillId)
		if self._T.breakTaken[key] == nil then self._T.breakTaken[key] = {} end
		self._T.breakTaken[key][self:BreakNo(breakId)] = true
	end

	@ExecSpace("ServerOnly")
	method integer BreakCountFor(string skillId)
		-- 4-F: 그 스킬의 칸에 붙은 돌파 수 (히어로식 최대 3개 판정).
		local n = 0
		for _, v in pairs((self._T.breakTaken or {})[self:BreakKey(skillId)] or {}) do
			if v then n = n + 1 end
		end
		return n
	end

	@ExecSpace("ServerOnly")
	method table JobSkills()
		-- 이번 판에 쓸 스킬: 직업 액티브 + 계열 공용 패시브 (직업 선택 전이면 빈 목록).
		if self.JobId == "" or self._T.jobSkills == nil then return {} end
		-- 히어로: 아웃게임에서 장착한 5종만 (계열 공용 패시브 없음, 콤보 어택은 고유 패시브)
		if self:IsSkillJob(self.JobId) then
			-- 2인 편성: 메인(히어로)과 동료(비숍 등)가 각자 장착한 스킬을 모두 카드 후보로 (판 안 레벨은 공유)
			local list = {}
			local seen = {}
			for _, h in ipairs(self:Heroes()) do
				for _, sk in ipairs(self._T.jobSkills[h.JobId] or {}) do
					if not seen[sk.id] and h:Equipped(sk.id) then
						seen[sk.id] = true
						table.insert(list, sk)
					end
				end
			end
			return list
		end
		if self._T.runSkillsJob ~= self.JobId then
			local list = {}
			for _, sk in ipairs(self._T.jobSkills[self.JobId] or {}) do table.insert(list, sk) end
			local job = self._T.jobById[self.JobId]
			if job ~= nil then
				for _, sk in ipairs(self._T.jobSkills[job.family] or {}) do table.insert(list, sk) end
			end
			self._T.runSkills = list
			self._T.runSkillsJob = self.JobId
		end
		return self._T.runSkills
	end

	@ExecSpace("ServerOnly")
	method number Bonus(string effType)
		-- 효과 합계 = 직업 스킬 수치 + 각인 + 은총 + 심볼 + 슬롯 + 거래 효과.
		local total = self:SkillValue(effType)
        total = total + ((self._T.accountBonus or {})[effType] or 0)
		-- 각인 (PlayerTalent)
		local talent = self._T.talent
		if talent ~= nil and talent[effType] ~= nil then total = total + talent[effType] end
		-- 미네르바의 은총
		local grace = self._T.grace
		if grace ~= nil and grace[effType] ~= nil then total = total + grace[effType] end
		-- 유물 효과
		local relic = self._T.relic
		if relic ~= nil and relic[effType] ~= nil then total = total + relic[effType] end
		-- 슬롯 강화 고유 효과
		local slotBonus = self._T.slotBonus
		if slotBonus ~= nil and slotBonus[effType] ~= nil then total = total + slotBonus[effType] end
		-- 보스 거래로 얻은 이번 판 효과 + 진행 중인 대가(받는 피해 증가 등)
		local deal = self._T.deal
		if deal ~= nil and deal[effType] ~= nil then total = total + deal[effType] end
		for _, c in ipairs(self._T.curses or {}) do
			if c.type == effType then total = total + c.value end
		end
		if effType == "MesoPct" then total = total + self:GoddessBonus(nil, effType) end
		-- 펫 P-C: 회피율(디노 걸)·판 안 메소 획득(눈냥냥)은 파티 공용 Bonus 경로로
		if effType == "Evade" then total = total + self:PetEffect("Evade") end
		if effType == "MesoPct" then total = total + self:PetEffect("MesoGainPct") end
		-- 테스트: DebugSetBonus 값 (판 시작에도 지우지 않음)
		total = total + ((self._T.debugBonus or {})[effType] or 0)
		return total
	end



	@ExecSpace("ServerOnly")
	method void RollJobChoices()
		-- 판 시작 직업 선택: 첫 고를 수 있는 직업과 같은 계열 직업 3개를 보여 준다 (고를 수 없는 직업은 화면에서 잠금).
		-- 편성이 있으면 직업 선택 없이 메인 직업으로 바로 시작
		if self._T.mainJob ~= nil and self:IsSkillJob(self._T.mainJob) and self._T.jobById[self._T.mainJob] ~= nil then
			self.ChoiceIds["1"] = self._T.mainJob
			self.ChoiceIds["2"] = ""
			self.ChoiceIds["3"] = ""
			self.ChoiceSeq = self.ChoiceSeq + 1
			self.RunState = "JOBSELECT"
			log("[VRF] formation start main=" .. self._T.mainJob .. " comp=" .. tostring(self._T.compJob))
			self:PickJob(self._T.mainJob)
			return
		end
		local first = self._T.jobById[self._T.playableJobs[1] or ""]
		local list = {}
		for _, id in ipairs(self._T.jobOrder) do
			local j = self._T.jobById[id]
			if first ~= nil and j.family == first.family and #list < 3 then table.insert(list, id) end
		end
		for slot = 1, 3 do
			self.ChoiceIds[tostring(slot)] = list[slot] or ""
		end
		self.ChoiceSeq = self.ChoiceSeq + 1
		self.RunState = "JOBSELECT"
		log("[VRF] job select " .. tostring(self.ChoiceIds["1"]) .. " " .. tostring(self.ChoiceIds["2"]) .. " " .. tostring(self.ChoiceIds["3"]))
	end

	@ExecSpace("ServerOnly")
	method void RollChoices()
		-- 레벨업 카드: 최고 레벨이 아닌 스킬 중 서로 다른 최대 3개. 카드 내용(신규/별 옵션/돌파)은 이때 정해 보여 준다.
		-- 스킬 직업 판(3인 파티): 카드 없이 자동 성장, 돌파만 고른다.
		if self:IsHeroRun() then
			self:RollPartyBreaks()
			return
		end
		local pool = {}
		for _, sk in ipairs(self:JobSkills()) do
			if (self.SkillLv[sk.id] or 0) < sk.max then table.insert(pool, sk.id) end
		end
		if #pool == 0 then
			self.PendingPicks = 0
			self:AfterRewards()
			return
		end
		for slot = 1, 3 do
			local key = tostring(slot)
			local id = ""
			if #pool > 0 then id = table.remove(pool, _UtilLogic:RandomIntegerRange(1, #pool)) end
			self.ChoiceIds[key] = id
			self.ChoiceOpts[key] = ""
			if id ~= "" then self.ChoiceOpts[key] = self:RollCardOption(self._T.skillById[id]) end
		end
		self.BreakSkill = ""
		self.ChoiceSeq = self.ChoiceSeq + 1
		self.RunState = "CHOICE"
		log("[VRF] skill choices " .. tostring(self.ChoiceIds["1"]) .. "(" .. tostring(self.ChoiceOpts["1"]) .. ") " .. tostring(self.ChoiceIds["2"]) .. "(" .. tostring(self.ChoiceOpts["2"]) .. ") " .. tostring(self.ChoiceIds["3"]) .. "(" .. tostring(self.ChoiceOpts["3"]) .. ") pending=" .. tostring(self.PendingPicks))
	end

	@ExecSpace("ServerOnly")
	method void AutoGrowRound()
		-- 레벨업 1회 (3인 파티): 구성원마다 자기 장착 스킬 중 최고 레벨이 아닌 것 하나를 완전 랜덤으로 +1.
		-- 습득·별 강화는 자동 (별 종류도 랜덤). 다음 레벨이 돌파 레벨(3·6·9)이면 그 스킬은 돌파 선택 대기열에 넣는다.
		if self.PendingPicks <= 0 then
			self:ContinueGrowth()
			return
		end
		self.PendingPicks = self.PendingPicks - 1
		local queue = self._T.breakQueue or {}
		local msgs = {}
		local grew = false
		for _, h in ipairs(self:Heroes()) do
			local cands = {}
			for _, sk in ipairs(self._T.jobSkills[h.JobId] or {}) do
				if h:Equipped(sk.id) and (self.SkillLv[sk.id] or 0) < sk.max then table.insert(cands, sk) end
			end
			if #cands > 0 then
				grew = true
				local sk = cands[_UtilLogic:RandomIntegerRange(1, #cands)]
				local mode = self:RollCardOption(sk)
				if mode == "break" then
					table.insert(queue, sk.id)
				elseif mode == "learn" then
					self.SkillLv[sk.id] = (self.SkillLv[sk.id] or 0) + 1
					self:UpdateSkillInfo(sk)
					table.insert(msgs, sk.name .. " 습득")
				else
					local o = self._T.starById[mode]
					if o ~= nil then
						self:ApplySkillOption(sk, o.effect, o.value)
						if self._T.starCount[sk.id] == nil then self._T.starCount[sk.id] = {} end
						self._T.starCount[sk.id][o.id] = (self._T.starCount[sk.id][o.id] or 0) + 1
						table.insert(msgs, sk.name .. " Lv." .. tostring((self.SkillLv[sk.id] or 0) + 1) .. " " .. o.name)
					end
					self.SkillLv[sk.id] = (self.SkillLv[sk.id] or 0) + 1
					self:UpdateSkillInfo(sk)
				end
			end
		end
		self._T.breakQueue = queue
		if #msgs > 0 then self:SetEnhanceMsg(table.concat(msgs, " · ")) end
		self:RecalcStats()
		log("[VRF] auto grow " .. table.concat(msgs, ",") .. " breaks=" .. tostring(#queue) .. " pending=" .. tostring(self.PendingPicks))
		if not grew then self.PendingPicks = 0 end
		self:ContinueGrowth()
	end

	@ExecSpace("ServerOnly")
	method void ContinueGrowth()
		-- 자동 성장 다음 단계: 돌파 대기열이 있으면 돌파 선택 화면, 남은 레벨업이 있으면 다시 자동 성장, 다 끝나면 전투.
		local queue = self._T.breakQueue or {}
		while #queue > 0 do
			local id = table.remove(queue, 1)
			local sk = self._T.skillById[id]
			self._T.breakQueue = queue
			if sk ~= nil and #self:RemainingBreaks(sk) > 0 then
				self._T.growBreak = true
				self:RollBreakChoices(sk)
				return
			end
			-- 돌파가 더 없으면 레벨만 올린다
			if sk ~= nil then
				self.SkillLv[id] = (self.SkillLv[id] or 0) + 1
				self:UpdateSkillInfo(sk)
			end
		end
		self._T.breakQueue = queue
		self._T.growBreak = false
		if self.PendingPicks > 0 then
			self:AutoGrowRound()
		else
			self:AfterRewards()
		end
	end

	@ExecSpace("ServerOnly")
	method table RemainingBreaks(table sk)
		-- 아직 고르지 않은 돌파 옵션 목록.
		-- 4-F: 칸 기준 — 그 스킬이 든 칸에 이미 붙은 번호는 빼고, 히어로식 최대 3개도 칸에 붙은 수로 센다
		local list = {}
		local count = self:BreakCountFor(sk.id)
		-- 히어로 돌파: 스킬당 최대 3개, 조건(소환검·자상·검술 연계)을 갖춘 옵션만
		if sk.pool == "HeroStar" and count >= 3 then return list end
		for _, b in ipairs(sk.breaks) do
			if not self:BreakTakenFor(sk.id, b.id) and (sk.pool ~= "HeroStar" or (self:CombatForSkill(sk.id) ~= nil and self:CombatForSkill(sk.id):BreakAllowed(b.id))) then table.insert(list, b) end
		end
		return list
	end

	@ExecSpace("ServerOnly")
	method string RollCardOption(table sk)
		-- Lv.0 → 습득, 다음 레벨이 3의 배수면 돌파, 그 외에는 별 옵션 풀에서 가중치 랜덤 1개.
		local lv = self.SkillLv[sk.id] or 0
		if lv == 0 then return "learn" end
		if (lv + 1) % 3 == 0 and #self:RemainingBreaks(sk) > 0 then return "break" end
		local opts = self._T.starOpts[sk.pool] or {}
		-- 히어로 버프 스킬(인레이지·발할라·에픽 어드벤쳐)은 별 강화가 위력 강화(버프 효과 증가)만
		if sk.pool == "HeroStar" and sk.proc ~= nil and sk.proc.type == "HeroBuff" then
			local only = {}
			for _, o in ipairs(opts) do
				if o.effect == "StarPower" then table.insert(only, o) end
			end
			opts = only
		end
		local sum = 0
		for _, o in ipairs(opts) do sum = sum + o.weight end
		local r = _UtilLogic:RandomDouble() * sum
		for _, o in ipairs(opts) do
			r = r - o.weight
			if r <= 0 then return o.id end
		end
		if #opts > 0 then return opts[#opts].id end
		return "learn"
	end

	@ExecSpace("ServerOnly")
	method void RollBreakChoices(table sk)
		-- 돌파 옵션 화면: 남은 옵션 중 무작위 최대 3개.
		local pool = self:RemainingBreaks(sk)
		for slot = 1, 3 do
			local key = tostring(slot)
			local id = ""
			if #pool > 0 then id = table.remove(pool, _UtilLogic:RandomIntegerRange(1, #pool)).id end
			self.ChoiceIds[key] = id
			self.ChoiceOpts[key] = "option"
		end
		self.BreakSkill = sk.id
		self.ChoiceSeq = self.ChoiceSeq + 1
		self.RunState = "BREAK"
		log("[VRF] break choices " .. sk.id .. " " .. tostring(self.ChoiceIds["1"]) .. " " .. tostring(self.ChoiceIds["2"]) .. " " .. tostring(self.ChoiceIds["3"]))
	end

	@ExecSpace("ServerOnly")
	method void RollPartyBreaks()
		-- 파티 돌파 카드 3장: 구성원(직업)마다 장착 스킬의 남은 돌파 중 무작위 1장.
		-- 고를 돌파가 없는 구성원 칸은 다른 구성원의 돌파로 채운다. 아무것도 없으면 넘어간다.
		if self.PendingPicks <= 0 then
			self:AfterRewards()
			return
		end
		local pools = {}
		for _, h in ipairs(self:Heroes()) do
			local list = {}
			for _, sk in ipairs(self._T.jobSkills[h.JobId] or {}) do
				if h:Equipped(sk.id) then
					for _, b in ipairs(self:RemainingBreaks(sk)) do table.insert(list, b) end
				end
			end
			table.insert(pools, list)
		end
		local used = {}
		local cards = {}
		local function take(list)
			local cands = {}
			for _, b in ipairs(list) do
				if not used[b.id] then table.insert(cands, b) end
			end
			if #cands == 0 then return nil end
			local b = cands[_UtilLogic:RandomIntegerRange(1, #cands)]
			used[b.id] = true
			return b
		end
		for i = 1, 3 do cards[i] = take(pools[i] or {}) end
		-- 펫 P-C: 쁘띠 초롱(돌파 선택지 +v) — 4번째 이후 칸은 아무 구성원 돌파로 채운다 (화면은 지금 3장까지만 표시: TarotUI 카드 추가 필요)
		local cardN = 3 + math.max(0, math.min(1, math.floor(self:PetEffect("BreakChoice") + 0.5)))
		-- 빈 칸은 다른 구성원 돌파로 채움
		local all = {}
		for _, list in ipairs(pools) do
			for _, b in ipairs(list) do table.insert(all, b) end
		end
		local count = 0
		for i = 1, cardN do
			if cards[i] == nil then cards[i] = take(all) end
			if cards[i] ~= nil then count = count + 1 end
		end
		if count == 0 then
			self.PendingPicks = 0
			self._T.partyBreak = false
			log("[VRF] party break none left")
			self:AfterRewards()
			return
		end
		for i = 1, 4 do
			local key = tostring(i)
			self.ChoiceIds[key] = (i <= cardN and cards[i] ~= nil) and cards[i].id or ""
			self.ChoiceOpts[key] = "option"
		end
		self.BreakSkill = ""
		self._T.partyBreak = true
		self.ChoiceSeq = self.ChoiceSeq + 1
		self.RunState = "BREAK"
		log("[VRF] party break choices " .. tostring(self.ChoiceIds["1"]) .. " " .. tostring(self.ChoiceIds["2"]) .. " " .. tostring(self.ChoiceIds["3"]) .. " " .. tostring(self.ChoiceIds["4"]) .. " n=" .. tostring(cardN))
	end

	@ExecSpace("ServerOnly")
	method void ApplySkillOption(table sk, string effect, number value)
		-- 옵션 적용: 스킬 전용 효과는 그 스킬에, 나머지는 판 전체 능력치에 더한다.
		if self._T.localFx[effect] then
			if self._T.skillMods[sk.id] == nil then self._T.skillMods[sk.id] = {} end
			local m = self._T.skillMods[sk.id]
			m[effect] = (m[effect] or 0) + value
		else
			self._T.runBonus[effect] = (self._T.runBonus[effect] or 0) + value
		end
	end

	@ExecSpace("ServerOnly")
	method void UpdateSkillInfo(table sk)
		-- 스킬 목록에 보여 줄 옵션 요약: 별 옵션 이름 ×횟수 + 고른 돌파 이름.
		local parts = {}
		for optId, n in pairs(self._T.starCount[sk.id] or {}) do
			local o = self._T.starById[optId]
			if o ~= nil then table.insert(parts, o.name .. " ×" .. tostring(n)) end
		end
		local names = {}
		for _, b in ipairs(sk.breaks) do
			if self:BreakTakenFor(sk.id, b.id) then table.insert(names, b.name) end
		end
		local text = table.concat(parts, ", ")
		if #names > 0 then
			if text ~= "" then text = text .. "\n" end
			text = text .. "돌파: " .. table.concat(names, ", ")
		end
		self.SkillInfo[sk.id] = text
	end

	@ExecSpace("ServerOnly")
	method void FinishSkillPick(table sk, string msg)
		-- 선택 1회 마무리: 레벨 +1, 능력치 갱신, 남은 선택이 있으면 다시 카드.
		self.SkillLv[sk.id] = (self.SkillLv[sk.id] or 0) + 1
		self:UpdateSkillInfo(sk)
		self:SetEnhanceMsg(msg)
		self:RecalcStats()
		log("[VRF] skill pick " .. sk.id .. " lv=" .. tostring(self.SkillLv[sk.id]) .. " " .. msg)
		self.PendingPicks = math.max(0, self.PendingPicks - 1)
		if self.PendingPicks > 0 then
			self:RollChoices()
		else
			self:AfterRewards()
		end
	end

	@ExecSpace("ServerOnly")
	method boolean HasSkillToLearn()
		-- 최고 레벨이 아닌 직업 스킬이 남아 있는지 (없으면 레벨업 카드를 쌓지 않음).
		for _, sk in ipairs(self:JobSkills()) do
			if (self.SkillLv[sk.id] or 0) < sk.max then return true end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method boolean HasBreakLeft()
		-- 구성원 장착 스킬 중 아직 고를 돌파가 남은 스킬이 하나라도 있는지 (4단계: HasSkillToLearn 대체).
		for _, sk in ipairs(self:JobSkills()) do
			if #self:RemainingBreaks(sk) > 0 then return true end
		end
		return false
	end

	@ExecSpace("Server")
	method void RequestPickJob(integer slot)
		-- 판 시작 직업 선택 (1~3): 직업 무기로 갈아입고, 첫 스킬 카드(각인 '선행 학습'이면 더 많이)부터 시작.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		if self.RunState ~= "JOBSELECT" then return end
		local job = self._T.jobById[self.ChoiceIds[tostring(slot)] or ""]
		if job == nil or not (job.playable or self:IsSkillJob(job.id)) then return end
		self:PickJob(job.id)
	end

	@ExecSpace("ServerOnly")
	method void PickJob(string jobId)
		-- 직업 확정: 직업 무기로 갈아입고, 첫 스킬 카드부터 시작. 스킬 직업은 메인·동료 전투 컴포넌트가 장착 스킬로 판을 시작한다.
		local job = self._T.jobById[jobId]
		if job == nil then return end
		self.JobId = job.id
		if self:IsSkillJob(job.id) then
			local extra = self:ExtraStatusHero()
			if extra ~= nil then
				extra:ClearState()
				extra._T.mgr = self
				extra._T.statusOwner = nil
			end
			-- 히어로: 장착 스킬 5종은 레벨업 카드 후보일 뿐 입장 직후에는 아무 스킬도 없다 (BeginRun이 SkillLv를 0으로 정함).
			-- 시작 기본 카드 1장은 빼고 레벨업 때 배운다 (각인 '선행 학습'으로 오른 시작 레벨만큼의 카드는 유지).
			for _, h in ipairs(self:Heroes()) do h:BeginRun(self) end
			self:LinkStatusOwner()
			-- 3인 파티: 돌파는 전투 스테이지가 끝날 때마다 1번 (설계 문서 2-10)
			-- 4단계: 각인 '선행 학습'(StartLevel) = 판 시작 돌파 선택 +v회
			-- 펫 P-C: 초용(판 시작 돌파 +v회)
			self.PendingPicks = math.max(0, math.floor(self:Bonus("StartLevel") + self:PetEffect("StartBreak") + 0.5))
			-- 보스 개편 B5: 보스전은 판 안 성장 없음 (판 시작 돌파도 없음)
			if self.RunMode == "boss" then
				self.PendingPicks = 0
				-- 보스 개편(메인 담당 결정): 보스전은 판 안 성장이 없으므로 칸 스킬을 최대 레벨로 시작 (돌파는 없음)
				self:BossMaxSkills()
			end
			log("[VRF] start breaks n=" .. tostring(self.PendingPicks))
		else
			for _, sk in ipairs(self:JobSkills()) do self.SkillLv[sk.id] = 0 end
		end
		self:RecalcStats()
		self:ApplyCostume()
		self:FullHealParty()
		-- 별 미션 제한 시간은 직업을 고른 순간부터 잰다
		self._T.runStartAt = _UtilLogic.ElapsedSeconds
		log("[VRF] job picked " .. job.id .. " pending=" .. tostring(self.PendingPicks))
		if self.PendingPicks > 0 then
			self:RollChoices()
		else
			self:AfterRewards()
		end
	end

	@ExecSpace("Server")
	method void RequestPick(integer slot)
		-- 카드 선택: 신규 습득 / 별 옵션 적용 / 돌파 카드면 옵션 화면으로, 돌파 옵션이면 적용.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		local key = tostring(slot)
		local id = self.ChoiceIds[key] or ""
		if id == "" then return end
		if self.RunState == "BREAK" then
			local b = self._T.breakById[id]
			if b == nil then return end
			if self._T.bookBreak then
				self:PickBookBreak(b)
				return
			end
			-- 파티 돌파: 카드마다 스킬이 다르다 (돌파 옵션의 스킬)
			local sk = self._T.skillById[self.BreakSkill]
			if self._T.partyBreak then sk = self._T.skillById[b.skill] end
			if sk == nil or b.skill ~= sk.id then return end
			-- 4-F: 칸 키 + 번호로 저장
			if self:BreakTakenFor(sk.id, b.id) then return end
			self:MarkBreakTaken(sk.id, b.id)
			self:ApplySkillOption(sk, b.effect, b.value)
			local prev = self.SkillBreaks[sk.id] or ""
			if prev ~= "" then prev = prev .. "," end
			self.SkillBreaks[sk.id] = prev .. b.id
			if self._T.partyBreak then
				self._T.partyBreak = false
				self:UpdateSkillInfo(sk)
				self:SetEnhanceMsg(sk.name .. " 돌파! [" .. b.name .. "]")
				self:RecalcStats()
				self.PendingPicks = math.max(0, self.PendingPicks - 1)
				log("[VRF] party break " .. sk.id .. " " .. b.id .. " left=" .. tostring(self.PendingPicks))
				if self.PendingPicks > 0 then self:RollPartyBreaks() else self:AfterRewards() end
				return
			end
			if self._T.growBreak then
				self.SkillLv[sk.id] = (self.SkillLv[sk.id] or 0) + 1
				self:UpdateSkillInfo(sk)
				self:SetEnhanceMsg(sk.name .. " 돌파! [" .. b.name .. "]")
				self:RecalcStats()
				log("[VRF] grow break " .. sk.id .. " lv=" .. tostring(self.SkillLv[sk.id]) .. " " .. b.id)
				self:ContinueGrowth()
				return
			end
			self:FinishSkillPick(sk, sk.name .. " 돌파! [" .. b.name .. "]")
			return
		end
		if self.RunState ~= "CHOICE" then return end
		local sk = self._T.skillById[id]
		if sk == nil then return end
		-- 2인 편성: 동료 직업(비숍 등) 스킬도 이번 판 카드 후보에 있으면 고를 수 있다
		local inPool = sk.job == self.JobId or sk.job == (self._T.jobById[self.JobId] or {}).family
		if not inPool then
			for _, c in ipairs(self:JobSkills()) do
				if c.id == sk.id then inPool = true break end
			end
		end
		if not inPool then return end
		if (self.SkillLv[sk.id] or 0) >= sk.max then return end
		local mode = self.ChoiceOpts[key] or ""
		if mode == "break" then
			self:RollBreakChoices(sk)
		elseif mode == "learn" then
			self:FinishSkillPick(sk, "스킬 [" .. sk.name .. "] 습득!")
		else
			local o = self._T.starById[mode]
			if o == nil then return end
			self:ApplySkillOption(sk, o.effect, o.value)
			if self._T.starCount[sk.id] == nil then self._T.starCount[sk.id] = {} end
			self._T.starCount[sk.id][o.id] = (self._T.starCount[sk.id][o.id] or 0) + 1
			self:FinishSkillPick(sk, sk.name .. " 강화! " .. o.name)
		end
	end

	@ExecSpace("Server")
	method void RequestReroll()
		-- 각인 '재추첨': 판마다 정해진 횟수만큼 지금 3장을 다시 뽑는다.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		if (self.RunState ~= "CHOICE" and self.RunState ~= "BREAK") or self.Rerolls <= 0 then return end
		if self._T.bookBreak then return end
		self.Rerolls = self.Rerolls - 1
		log("[VRF] reroll left=" .. tostring(self.Rerolls))
		if self.RunState == "BREAK" and self._T.partyBreak then
			self:RollPartyBreaks()
		elseif self.RunState == "BREAK" then
			self:RollBreakChoices(self._T.skillById[self.BreakSkill])
		else
			self:RollChoices()
		end
	end

	@ExecSpace("ServerOnly")
	method Component GetEngrave()
		-- 플레이어 각인 컴포넌트 (PlayerEngrave).
		local player = self._T.player
		if not isvalid(player) then return nil end
		return player:GetComponent("script.PlayerEngrave")
	end

	@ExecSpace("ServerOnly")
	method Component GetGear()
		-- 플레이어 장비 컴포넌트 (PlayerGear, 편성 칸 장비·주문서 보유).
		local player = self._T.player
		if not isvalid(player) then return nil end
		return player:GetComponent("script.PlayerGear")
	end

	@ExecSpace("ServerOnly")
	method Component GetTalent()
		-- 플레이어 새 각인 컴포넌트 (PlayerTalent, 탭·루트형 각인).
		local player = self._T.player
		if not isvalid(player) then return nil end
		return player:GetComponent("script.PlayerTalent")
	end

	@ExecSpace("ServerOnly")
	method number TalentValue(string key)
		-- 이번 판 각인 효과 수치 (판 시작 시점 고정값, 없으면 0).
		return (self._T.talent or {})[key] or 0
	end

	@ExecSpace("ServerOnly")
	method void TryTalentBurn(Entity target)
		-- 각인 상태이상 루트: 화상이 없는 맨 앞 몬스터에게 확률로 공용 화상 (1초마다 공격력 TalentBurnPct+각인%, TalentBurnTime+각인초).
		local chance = self:Bonus("StatusChance")
		if chance <= 0 or self._T.burn ~= nil or not isvalid(target) then return end
		if _UtilLogic:RandomDouble() * 100 >= chance then return end
		self:ApplyBurn({ pct = self.TalentBurnPct + self:Bonus("BurnPct"), time = self.TalentBurnTime + self:Bonus("StatusTime"), fx = self.TalentBurnFxRUID,
			burst = self:Bonus("BurnBurst"), vuln = self:Bonus("BurnVuln"), heal = 0 }, target)
		log("[VRF] talent burn chance=" .. tostring(chance))
	end

	@ExecSpace("ServerOnly")
	method void TalentHitShield(Entity actor)
		-- 각인 핵심 '수호막': 맞고 살아 있으면 캐릭터마다 TalentShieldCooldown초에 1회 최대 체력 v% 보호막.
		local pct = self:Bonus("HitShield")
		if pct <= 0 or not isvalid(actor) then return end
		local ready = self._T.talentShieldReady or {}
		self._T.talentShieldReady = ready
		local now = _UtilLogic.ElapsedSeconds
		if now < (ready[actor] or 0) then return end
		ready[actor] = now + self.TalentShieldCooldown
		local amount = math.floor(self:ActorMaxHp(actor) * pct / 100 + 0.5)
		self:AddShield(actor, amount)
		log("[VRF] talent hit shield +" .. tostring(amount))
	end

	-- ───────────────────────── 펫 P-C (판 안 효과·따라오기) ─────────────────────────

	@ExecSpace("ServerOnly")
	method void LoadPetRun()
		-- 판 시작: PlayerPet.PetRunData()를 이번 판 값으로 고정한다 (보유 공격력% 합, 장착 펫 특수 효과 합, 장착 펫 클립). 없으면 빈 값.
		self._T.petRun = { atkPct = 0, eff = {}, pets = {} }
		self._T.petReviveUsed = false
		self._T.petLogged = {}
		local player = self._T.player
		local pet = isvalid(player) and player:GetComponent("script.PlayerPet") or nil
		if pet == nil or not pet.PetLoaded then
			log_warning("[VRF] pet run data missing")
			return
		end
		local d = pet:PetRunData()
		if d == nil then return end
		self._T.petRun = { atkPct = tonumber(d.atkPct) or 0, eff = d.eff or {}, pets = d.pets or {} }
		local es = {}
		for k, v in pairs(self._T.petRun.eff) do table.insert(es, k .. ":" .. tostring(v)) end
		local ids = {}
		for _, p in ipairs(self._T.petRun.pets) do table.insert(ids, tostring(p.id)) end
		log("[VRF] pet run atkPct=" .. tostring(self._T.petRun.atkPct) .. " eff=" .. table.concat(es, ",") .. " pets=" .. table.concat(ids, ","))
	end

	@ExecSpace("ServerOnly")
	method number PetEffect(string key)
		-- 장착 펫 특수 효과 합계 (효과 키는 PetTable EffectKey). 처음 쓰일 때 로그 1회.
		local pr = self._T.petRun
		if pr == nil then return 0 end
		local v = tonumber((pr.eff or {})[key]) or 0
		if v ~= 0 then
			if self._T.petLogged == nil then self._T.petLogged = {} end
			if not self._T.petLogged[key] then
				self._T.petLogged[key] = true
				log("[VRF] pet hook " .. key .. " v=" .. tostring(v))
			end
		end
		return v
	end

	@ExecSpace("ServerOnly")
	method number PetActorBonus(string key)
		-- AccessoryBonus 경로에 더할 펫 값 (구성원 전원 공통): 보유 공격력% + 장착 펫 특수 효과 중 장신구·잠재와 이름이 같은 효과.
		if key == "AtkPct" then
			local pr = self._T.petRun
			return pr ~= nil and (tonumber(pr.atkPct) or 0) or 0
		end
		if key == "HpPct" or key == "DefPct" or key == "Crit" or key == "CritDmg" or key == "DmgReduce" or key == "SkillDmg" or key == "EliteDmg" or key == "CdReduce" or key == "Speed" or key == "LifestealPct" then
			return self:PetEffect(key)
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method integer PetStoneExtra()
		-- 마족 메투스(StoneGainPct): 스킬석을 얻을 때 v% 확률로 1개 더.
		local pct = self:PetEffect("StoneGainPct")
		if pct > 0 and _UtilLogic:RandomDouble() * 100 < pct then
			log("[VRF] pet stone extra pct=" .. tostring(pct))
			return 1
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method boolean TryPetRevive()
		-- 쁘띠 데스(ReviveHpPct): 판마다 1회, 파티가 전멸하는 대신 모두 체력 v%로 일어난다.
		local pct = self:PetEffect("ReviveHpPct")
		if pct <= 0 or self._T.petReviveUsed then return false end
		self._T.petReviveUsed = true
		if not self.PlayerDown then
			self.PlayerHp = math.max(1, math.floor(self.PlayerMaxHp * pct / 100 + 0.5))
		end
		self:ReviveDownedPct(pct)
		local player = self._T.player
		if isvalid(player) then
			_EffectService:PlayEffectAttached(self.UndyingFxRUID, player, Vector3(0, 0.25, 0), 0, Vector3(0.9, 0.9, 1), false)
		end
		log("[VRF] pet revive pct=" .. tostring(pct) .. " hp=" .. tostring(self.PlayerHp))
		return true
	end

	@ExecSpace("ServerOnly")
	method void ClearPets()
		-- 따라오는 펫 엔티티 제거 (판 시작 다시 만들기·로비·맵 떠남·종료).
		for _, p in ipairs(self._T.petEnts or {}) do
			if isvalid(p.ent) then p.ent:Destroy() end
		end
		self._T.petEnts = {}
	end

	@ExecSpace("ServerOnly")
	method void SpawnPets()
		-- 장착 펫을 파티 맨 뒤에 세운다. 시각 전용: 포탈 모델(몸체 없음, Sprite+Transform)을 재사용하고 이름표는 비운다. 몬스터 공격 대상·충돌 아님.
		self:ClearPets()
		local pr = self._T.petRun
		if pr == nil or #(pr.pets or {}) == 0 then return end
		local player = self._T.player
		if not isvalid(player) then return end
		local anchor = self:PetAnchor()
		local ax = isvalid(anchor) and anchor.TransformComponent.WorldPosition.x or self.PlayerPos.x
		local py = player.TransformComponent.WorldPosition.y
		local list = {}
		for k, p in ipairs(pr.pets) do
			local x = ax - self.PetFirstGap - self.PetGap * (k - 1)
			local ent = _SpawnService:SpawnByModelId(self.PortalModelId, "Pet" .. tostring(k), Vector3(x, py, 0), self.Entity)
			if isvalid(ent) then
				local pc = ent:GetComponent("script.TowerPortal")
				if pc ~= nil then pc:Setup(0, "pet", "", p.stand or "") end
				ent.TransformComponent.Scale = Vector3(self.PetScale, self.PetScale, 1)
				local sr = ent.SpriteRendererComponent
				if isvalid(sr) then sr.FlipX = true end
				table.insert(list, { ent = ent, stand = p.stand or "", move = p.move or "", moving = false, id = p.id })
			else
				log_warning("[VRF] pet spawn failed " .. tostring(p.id))
			end
		end
		self._T.petEnts = list
		log("[VRF] pet follow spawned n=" .. tostring(#list))
	end

	@ExecSpace("ServerOnly")
	method Entity PetAnchor()
		-- 펫 줄의 기준: 파티 맨 뒤 구성원 (3번 → 2번 → 1번).
		for i = 2, 1, -1 do
			local m = self:Mate(i)
			if isvalid(m) then return m end
		end
		return self._T.player
	end

	@ExecSpace("ServerOnly")
	method void TickPets(number delta)
		-- 펫 따라가기: 맨 뒤 구성원 위치에서 일정 간격 뒤를 부드럽게 따라간다. 걷는 중엔 move 클립·진행 방향, 서 있으면 stand 클립·오른쪽(전투 방향).
		local pets = self._T.petEnts
		if pets == nil or #pets == 0 then return end
		local player = self._T.player
		local anchor = self:PetAnchor()
		if not isvalid(player) or not isvalid(anchor) then return end
		local ax = anchor.TransformComponent.WorldPosition.x
		local py = player.TransformComponent.WorldPosition.y
		for k, p in ipairs(pets) do
			if isvalid(p.ent) then
				local tx = ax - self.PetFirstGap - self.PetGap * (k - 1)
				local wp = p.ent.TransformComponent.WorldPosition
				local dx = tx - wp.x
				local nx = wp.x
				local moving = p.moving
				-- 멈춰 있다가 조금 벌어지면 걷기 시작, 걷는 중엔 거의 닿을 때까지 걷는다 (클립 깜빡임 방지)
				if moving then
					if math.abs(dx) < 0.02 then moving = false end
				elseif math.abs(dx) > 0.08 then
					moving = true
				end
				if math.abs(dx) > 4 then
					-- 스테이지 전환 등으로 파티가 멀리 옮겨지면 바로 붙인다
					nx = tx
					moving = false
				elseif moving then
					local spd = self.PetWalkSpeed
					if math.abs(dx) > 0.5 then spd = spd * 1.6 end
					local step = math.min(math.abs(dx), spd * delta)
					if dx > 0 then nx = wp.x + step else nx = wp.x - step end
				end
				if math.abs(nx - wp.x) > 0.0001 or math.abs(wp.y - py) > 0.01 then
					p.ent.TransformComponent.WorldPosition = Vector3(nx, py, wp.z)
				end
				local sr = p.ent.SpriteRendererComponent
				if isvalid(sr) then
					if moving ~= p.moving then
						local ruid = moving and p.move or p.stand
						if ruid ~= "" and sr.SpriteRUID ~= ruid then sr.SpriteRUID = ruid end
					end
					-- 메이플 펫 그림은 왼쪽을 본다: 오른쪽으로 갈 때·서 있을 때 뒤집는다
					local flip = true
					if moving and dx < 0 then flip = false end
					if sr.FlipX ~= flip then sr.FlipX = flip end
				end
				p.moving = moving
			end
		end
	end

	@ExecSpace("ServerOnly")
	method integer PlayerHitDamage()
		-- 이번 타격 피해: 공격력(최소~최대) × 몬스터 방어 감소 × 각인 추가 피해(체력 30% 이하 적 / 엘리트).
		-- 직업 스킬 '화염 마력': 몬스터 방어력 일부 무시
		-- 전투 능력치 개편: 메인 기본 공격 타입에 맞는 몬스터 방어 (구성원별 칸 보너스는 넣지 않던 기존 계산 유지)
		local dmg = self:RollPlayerAtk() * self:DefFactor(self:HitProfile(self._T.player, "").baseAtk, nil)
		local mul = 1
		-- 직업 스킬 '투혼': 내 체력 50% 이하일 때 주는 피해 증가
		if self.PlayerHp < self.PlayerMaxHp * 0.5 then mul = mul + self:Bonus("LowHpAtk") / 100 end
		if self.MonsterHp <= self.MonsterMaxHp * self.LowHpDmgRatio then mul = mul + self:Bonus("LowHpDmg") / 100 end
		if self.MonsterElite then mul = mul + self:Bonus("EliteDmg") / 100 end
		-- 공용 패시브 돌파 '충만한 힘': 체력이 가득할 때 공격력 증가
		if self.PlayerHp >= self.PlayerMaxHp then mul = mul + self:Bonus("FullHpAtk") / 100 end
		-- 이 층 심볼: 주는 피해 증가
		mul = mul + (self._T.symDmg or 0) / 100
		return math.max(1, math.floor(dmg * mul + 0.5))
	end

	@ExecSpace("ServerOnly")
	method integer BasicHitDamage(Component hero)
		-- 기본 공격 피해: 타격 피해 × 은총 '기본 공격 피해' × (몬스터마다 첫 타격이면) 은총 '첫 타격 피해'.
		local mul = 1 + self:Bonus("BasicDmg") / 100
		if not self._T.firstHitDone then
			self._T.firstHitDone = true
			mul = mul * (1 + self:Bonus("FirstHitDmg") / 100)
		end
		-- 히어로: 콤보당 직접 공격 피해·에픽 어드벤쳐 모든 피해
		if self:IsHeroRun() and hero ~= nil then mul = mul * hero:DirectMul() end
		return math.max(1, math.floor(self:ActorHitDamage(hero ~= nil and hero.Entity or self._T.player) * mul + 0.5))
		end


	@ExecSpace("ServerOnly")
	method table RollJobProcs(Component hero)
		-- 이번 공격에 시전할 스킬을 정한다: 쿨타임이 끝난 쿨타임형 1개 + 확률에 걸린 발동형.
		-- 실제 적용은 기본 타격과 같은 순간(TowerPlayer가 대기 타격을 적용할 때 ApplyJobProcs).
		if self:IsHeroRun() then
			if hero == nil then return {} end
			return hero:RollCasts(self)
		end
		local list = {}
		for _, sk in ipairs(self:JobSkills()) do
			if sk.trigger == "Cooldown" and sk.proc ~= nil and (self.SkillLv[sk.id] or 0) > 0 and (self._T.cd[sk.id] or 0) <= 0 then
				local m = self._T.skillMods[sk.id] or {}
				self._T.cd[sk.id] = math.max(1, (sk.cooldown - (m.CooldownSec or 0)) * (1 - (m.CooldownPct or 0) / 100))
				table.insert(list, self:MakeCast(sk))
				break
			end
		end
		local follow = {}
		for _, sk in ipairs(self:JobSkills()) do
			-- 공용 패시브 중 확률 발동 스킬(파이널 어택)도 함께 판정
			if sk.trigger ~= "Cooldown" and sk.proc ~= nil and (self.SkillLv[sk.id] or 0) > 0 then
				local m = self._T.skillMods[sk.id] or {}
				-- 은총 '공격 시 발동 확률'은 확률에 합연산
				if _UtilLogic:RandomDouble() * 100 < sk.proc.chance + (m.Chance or 0) + self:Bonus("ProcChance") then
					table.insert(list, self:MakeCast(sk))
				elseif (m.Follow or 0) > 0 then
					table.insert(follow, sk)
				end
			end
		end
		-- 돌파 '따라 베기': 다른 스킬이 발동하면 반드시 함께 발동
		if #list > 0 then
			for _, sk in ipairs(follow) do table.insert(list, self:MakeCast(sk)) end
		end
		return list
	end

	@ExecSpace("ServerOnly")
	method table MakeCast(table sk)
		-- 스킬 1회 결과를 미리 계산한다 (계수·타수·크리티컬에 별·돌파 옵션 반영).
		local p = sk.proc
		local m = self._T.skillMods[sk.id] or {}
		local r = { id = sk.id, name = sk.name, m = m, dmg = 0, hits = p.hits + (m.Hits or 0), freeze = 0, heal = 0, meso = 0, crit = false, fx = p.fx, fxScale = p.fxScale, actionFrames = p.actionFrames or "", actionTime = p.actionTime or 0.8, casterFx = p.casterFx or "" }
		if p.type == "Buff" then
			r.buffSkill = sk
			return r
		end
		local pct = p.pct + (m.Pct or 0)
		local atk = self:RollPlayerAtk()
		self._T.castDefIgnore = m.SkillDefIgnore or 0
		if p.type == "Strike" or p.type == "MesoStrike" or p.type == "Freeze" or p.type == "Double" or p.type == "Burn" then
			r.dmg = math.floor(self:PlayerHitDamage() * pct / 100 + 0.5)
		elseif p.type == "CritStrike" then
			r.dmg = math.floor(self:PlayerHitDamage() * pct / 100 * self.CritDmg / 100 + 0.5)
			r.crit = true
		elseif p.type == "Pierce" then
			r.dmg = math.floor(atk * pct / 100 + 0.5)
		elseif p.type == "Dice" then
			r.dmg = math.floor(atk * (0.5 + _UtilLogic:RandomDouble() * 2.5) + 0.5)
		elseif p.type == "Heal" then
			r.heal = math.max(1, math.floor(self.PlayerMaxHp * pct / 100 + 0.5))
		end
		self._T.castDefIgnore = 0
		local mul = 1
		if self.MonsterHp <= self.MonsterMaxHp * self.LowHpDmgRatio then mul = mul + (m.SkillLowHp or 0) / 100 end
		if self.MonsterElite then mul = mul + (m.SkillElite or 0) / 100 end
		if not r.crit and r.dmg > 0 and ((m.AlwaysCrit or 0) > 0 or ((m.StunCrit or 0) > 0 and self:IsStunned()) or _UtilLogic:RandomDouble() * 100 < (m.CritChance or 0)) then
			mul = mul * self.CritDmg / 100 * (1 + (m.SkillCritDmg or 0) / 100)
			r.crit = true
		end
		r.dmg = math.floor(r.dmg * mul * (1 + self:Bonus("SkillDmg") / 100) + 0.5)
		if p.type == "Freeze" then r.freeze = self.JobFreezeSec + (m.StunSec or 0) end
		if p.type == "Burn" then
			r.burn = { pct = (p.dotPct + (m.DotPct or 0)) * (1 + self:Bonus("SkillDmg") / 100), time = p.dotTime + (m.DotTime or 0), fx = p.mobFx, burst = m.BurnBurst or 0, vuln = m.BurnVuln or 0, heal = m.BurnHeal or 0 }
		end
		if p.type == "MesoStrike" then r.meso = math.max(1, math.floor(self:KillMeso() * self.JobMesoStrikeRatio + 0.5)) end
		if r.dmg > 0 then r.dmg = math.max(1, r.dmg) end
		return r
	end

	@ExecSpace("ServerOnly")
	method boolean IsStunned()
		-- 지금 몬스터가 기절 중인지.
		return _UtilLogic.ElapsedSeconds < (self._T.stunUntil or 0)
	end

	@ExecSpace("ServerOnly")
	method void AddBuff(string tag, string key, number value, number duration, number burst)
		-- 일정 시간 능력치 버프 (같은 tag는 새로 고침). burst > 0이면 끝날 때 공격력 burst% 추가 피해.
		for i = #self._T.buffs, 1, -1 do
			if self._T.buffs[i].tag == tag then table.remove(self._T.buffs, i) end
		end
		table.insert(self._T.buffs, { tag = tag, key = key, value = value, t = duration, burst = burst })
		self:RecalcStats()
	end

	@ExecSpace("ServerOnly")
	method void HealPlayer(number amount)
		-- 회복 (돌파 '생명력'·'회복 강화' 반영) + 회복 숫자 표시.
		local heal = math.floor(amount * (1 + self:Bonus("HealRecv") / 100) + 0.5)
		if heal <= 0 or self.PlayerHp >= self.PlayerMaxHp then return end
		self.PlayerHp = math.min(self.PlayerMaxHp, self.PlayerHp + heal)
		local pc = self:GetPlayerAttack()
		if pc ~= nil then pc:ShowHeal(heal) end
	end

	@ExecSpace("ServerOnly")
	method void ReduceCooldowns(number sec)
		-- 모든 쿨타임 스킬의 남은 쿨타임 감소.
		for id, t in pairs(self._T.cd) do self._T.cd[id] = math.max(0, t - sec) end
	end

	@ExecSpace("ServerOnly")
	method void OnPlayerCrit()
		-- 크리티컬 적중 시 공용 패시브 '찬스 어택' 돌파 효과.
		local speed = self:Bonus("CritSpeed")
		if speed > 0 then self:AddBuff("critSpeed", "Speed", speed, 3, 0) end
		local heal = self:Bonus("CritHeal")
		if heal > 0 then self:HealPlayer(self.PlayerMaxHp * heal / 100) end
		local cd = self:Bonus("CritCd")
		if cd > 0 then self:ReduceCooldowns(cd) end
		if _UtilLogic:RandomDouble() * 100 < self:Bonus("CritExtra") then self._T.extraHitTimer = self.DoubleHitDelay end
	end

	@ExecSpace("ServerOnly")
	method void TickSkills(number delta)
		-- 전투 중 매 프레임: 쿨타임·버프 시간, 화상, 기절 종료 피해, 셀프 리커버리 회복.
		self:TickBurn(delta)
		if self.RunState ~= "FIGHT" then
			if self:IsHeroRun() then
				for _, h in ipairs(self:Heroes()) do h:PauseClock(delta) end
			end
			return
		end
		if self:IsHeroRun() then
			for _, h in ipairs(self:Heroes()) do h:Tick(self, delta) end
			local extra = self:ExtraStatusHero()
			if extra ~= nil then extra:TickStatusOnly(self, delta) end
		end
		for id, t in pairs(self._T.cd) do self._T.cd[id] = math.max(0, t - delta) end
		local changed = false
		for i = #self._T.buffs, 1, -1 do
			local b = self._T.buffs[i]
			b.t = b.t - delta
			if b.t <= 0 then
				table.remove(self._T.buffs, i)
				changed = true
				if b.burst > 0 then self:ApplyMonsterDamage(math.floor(self.PlayerAtk * b.burst / 100 + 0.5)) end
			end
		end
		if changed then self:RecalcStats() end
		if (self._T.stunBurst or 0) > 0 and not self:IsStunned() then
			local burst = self._T.stunBurst
			self._T.stunBurst = 0
			self:ApplyMonsterDamage(math.floor(self.PlayerAtk * burst / 100 + 0.5))
			log("[VRF] stun end burst " .. tostring(burst))
		end
		local regen = self:Bonus("SelfRegen")
		if regen > 0 then
			self._T.regenTimer = (self._T.regenTimer or 5) - delta
			if self._T.regenTimer <= 0 then
				self._T.regenTimer = math.max(1, 5 - self:Bonus("RegenSec"))
				if self.PlayerHp < self.PlayerMaxHp then
					local pct = regen
					if self:Bonus("RegenLow") > 0 and self.PlayerHp <= self.PlayerMaxHp * 0.3 then pct = pct * 2 end
					self:HealPlayer(self.PlayerMaxHp * pct / 100)
					local atk = self:Bonus("RegenAtk")
					if atk > 0 then self:AddBuff("regenAtk", "AtkPct", atk, 3, 0) end
					local cd = self:Bonus("RegenCd")
					if cd > 0 then self:ReduceCooldowns(cd) end
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyJobProcs(table procs, Entity target, Entity attacker)
		-- 발동한 직업 스킬 적용: 스킬 이펙트(몬스터 위, 회복은 캐릭터 위) + 추가 피해 숫자·회복·빙결(몬스터 공격 지연)·메소.
		if procs == nil or #procs == 0 then return end
		local hero = self:HeroOf(attacker)
		if hero == nil then hero = self:MainHero() end
		-- 히어로: 같은 공격의 기본 타격으로 몬스터가 먼저 쓰러져도 스킬은 적용한다 (버프 등은 그대로, 타격은 다음 몬스터로 넘어감)
		if self.RunState ~= "FIGHT" then
			if self:IsHeroRun() then
				for _, r in ipairs(procs) do
					if r.hero and hero ~= nil then hero:ApplyCast(self, r, target) end
				end
			end
			return
		end
		local pc = self:GetPlayerAttack()
		for _, r in ipairs(procs) do
			-- 전투 개편: 연타(타이머) 타격도 공격 타입·속성을 알 수 있게 타격 주인을 기억한다
			if r.atkActor == nil then r.atkActor = attacker end
			self._T.dmgCtx = self:DmgCtxOf(r)
			if r.hero then
				if hero ~= nil then hero:ApplyCast(self, r, target) end
				self._T.dmgCtx = nil
				continue
			end
			self:ApplyCastEffects(r, target)
			-- 연타 스킬은 0.12초 간격으로 한 대씩 (첫 타는 기본 타격과 같은 순간)
			self:ApplyProcHit(r, target, 1)
			for h = 2, r.hits do
				local hit = h
				_TimerService:SetTimerOnce(function() self:ApplyProcHit(r, target, hit) end, (h - 1) * self.ProcHitInterval)
			end
			if r.heal > 0 then self:HealPlayer(r.heal) end
			-- 기절: 몬스터 다음 공격까지 최소 freeze초 (중첩되지 않음)
			if r.freeze > 0 and self.RunState == "FIGHT" then
				local sec = r.freeze
				if self.MonsterElite then sec = sec + (r.m.EliteStun or 0) end
				self.MonsterAttackTimer = math.max(self.MonsterAttackTimer, sec)
				self._T.stunUntil = _UtilLogic.ElapsedSeconds + sec
				self._T.stunVuln = r.m.StunVuln or 0
				self._T.stunBurst = r.m.EndBurst or 0
			end
			-- 돌파 '잔상'류: 확률로 한 번 더 발동
			if not r.repeated and (r.m.Repeat or 0) > 0 and _UtilLogic:RandomDouble() * 100 < r.m.Repeat then
				local again = {}
				for k, v in pairs(r) do again[k] = v end
				again.repeated = true
				_TimerService:SetTimerOnce(function() self:ApplyJobProcs({ again }, target, attacker) end, r.hits * self.ProcHitInterval + 0.15)
			end
			if r.meso > 0 then
				self.Meso = self.Meso + r.meso
				self.RunMeso = self.RunMeso + r.meso
				self.MesoProcSeq = self.MesoProcSeq + 1
			end
			log("[VRF] job proc " .. r.name .. " dmg=" .. tostring(r.dmg) .. "x" .. tostring(r.hits) .. " heal=" .. tostring(r.heal) .. " freeze=" .. tostring(r.freeze) .. " meso=" .. tostring(r.meso))
		end
		self._T.dmgCtx = nil
	end

	@ExecSpace("ServerOnly")
	method void ApplyBurn(table b, Entity target)
		-- 몬스터에게 화상: 1초마다 공격력 비례 피해. 다시 걸면 시간을 새로 고친다.
		self:ClearBurn()
		local serial = 0
		if b.fx ~= "" and isvalid(target) then serial = _EffectService:PlayEffectAttached(b.fx, target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), true) end
		self._T.burn = { t = b.time, tick = 1, pct = b.pct, burst = b.burst, vuln = b.vuln, heal = b.heal, serial = serial }
		log("[VRF] burn on pct=" .. tostring(b.pct) .. " time=" .. tostring(b.time))
	end

	@ExecSpace("ServerOnly")
	method void ClearBurn()
		-- 화상 상태와 몬스터에 붙은 불꽃 이펙트 제거.
		local b = self._T.burn
		self._T.burn = nil
		if b ~= nil and b.serial ~= 0 then _EffectService:RemoveEffect(b.serial) end
	end

	@ExecSpace("ServerOnly")
	method void TickBurn(number delta)
		-- 화상 진행: 1초마다 피해, 끝나면 '연소 폭발'.
		local b = self._T.burn
		if b == nil then return end
		b.t = b.t - delta
		b.tick = b.tick - delta
		if b.tick <= 0 then
			b.tick = b.tick + 1
			local dmg = math.max(1, math.floor(self.PlayerAtk * b.pct / 100 + 0.5))
			local pc = self:GetPlayerAttack()
			-- 전투 개편: 화상은 불 속성 지속 피해 (불 약점·반감 적용, 방어 없음)
			-- 보스 개편: 속성·지속 여부는 타격 주인(hitSrc)에 싣고, 이 블록이 끝나면 반드시 이전 값으로 되돌린다
			-- (dmgCtx가 남아 다음 기본 공격이 불 속성·지속 피해를 이어받던 문제).
			local prevSrc = self:SetHitSrc(nil, "", true)
			self._T.hitSrc.elemId = "Fire"
			self._T.dmgCtx = { dot = true, elem = true, elemId = "Fire" }
			dmg = self:FinalDouble(dmg)
			if pc ~= nil and isvalid(self._T.monster) then pc:ShowProcDamage(self._T.monster, dmg, false) end
			log("[VRF] burn tick dmg=" .. tostring(dmg))
			self:ApplyRolledDamage(dmg)
			self._T.dmgCtx = nil
			self:ClearHitSrc(prevSrc)
			if b.heal > 0 then self:HealPlayer(self.PlayerMaxHp * b.heal / 100) end
			if self.RunState ~= "FIGHT" then return end
		end
		if b.t <= 0 then
			local burst = b.burst
			self:ClearBurn()
			if burst > 0 then self:ApplyMonsterDamage(math.floor(self.PlayerAtk * burst / 100 + 0.5)) end
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyCastEffects(table r, Entity target)
		-- 시전 순간 효과: 버프 스킬, 발동 회복, 시전 후 버프, 몬스터 약화, 쿨타임 감소.
		local m = r.m
		if r.buffSkill ~= nil then
			local sk = r.buffSkill
			local dur = sk.buffTime + (m.BuffTime or 0)
			local power = 1 + (m.Pct or 0) / 100
			for _, e in ipairs(sk.effects) do self:AddBuff(sk.id .. e.type, e.type, e.base * power, dur, 0) end
			local extra = { { "BuffAtk", "AtkPct" }, { "BuffCritDmg", "CritDmg" }, { "BuffSpeed", "Speed" }, { "BuffReduce", "DmgReduce" }, { "BuffDrain", "LifestealPct" }, { "BuffCrit", "Crit" } }
			for _, x in ipairs(extra) do
				if (m[x[1]] or 0) > 0 then self:AddBuff(sk.id .. x[1], x[2], m[x[1]], dur, 0) end
			end
			if (m.BuffBurst or 0) > 0 then self:AddBuff(sk.id .. "Burst", "", 0, dur, m.BuffBurst) end
		end
		if r.burn ~= nil then self:ApplyBurn(r.burn, target) end
		if (m.HealCast or 0) > 0 then self:HealPlayer(self.PlayerMaxHp * m.HealCast / 100) end
		if (m.PostSpeed or 0) > 0 then self:AddBuff(r.id .. "PostSpeed", "Speed", m.PostSpeed, 4, 0) end
		if (m.PostSpeedShort or 0) > 0 then self:AddBuff(r.id .. "PostSpeedShort", "Speed", m.PostSpeedShort, 2, 0) end
		if (m.PostAtk or 0) > 0 then self:AddBuff(r.id .. "PostAtk", "AtkPct", m.PostAtk, 5, 0) end
		if (m.Vuln or 0) > 0 then
			self._T.vulnUntil = _UtilLogic.ElapsedSeconds + 5
			self._T.vulnPct = m.Vuln
		end
		if (m.MonDelay or 0) > 0 then self.MonsterAttackTimer = self.MonsterAttackTimer * (1 + m.MonDelay / 100) end
		if (m.CdOnCast or 0) > 0 then self:ReduceCooldowns(m.CdOnCast) end
	end

	@ExecSpace("ServerOnly")
	method string PickHitFx(string list, integer h)
		-- "ruid|ruid" 목록에서 h번째 타격에 쓸 피격 이펙트를 고른다.
		local fx = {}
		for ruid in string.gmatch(list, "[^|]+") do table.insert(fx, ruid) end
		if #fx == 0 then return list end
		return fx[(h - 1) % #fx + 1]
	end

	@ExecSpace("ServerOnly")
	method void ApplyProcHit(table r, Entity target, integer h)
		-- 발동 스킬 한 대: 스킬 이펙트(회복만 있는 스킬은 캐릭터 위) + 추가 피해 숫자. 그사이 몬스터가 쓰러졌으면 건너뛴다.
		local onPlayer = r.heal > 0 and r.dmg <= 0
		if not onPlayer then
			if self.RunState ~= "FIGHT" or not isvalid(target) or target ~= self._T.monster then return end
		end
		local who = target
		if onPlayer then who = self._T.player end
		if r.fx ~= nil and r.fx ~= "" and isvalid(who) then
			local wp = who.TransformComponent.WorldPosition
			-- 연타 이펙트는 조금씩 다른 자리에 (좌우·위아래로 번갈아)
			local ox = ((h - 1) % 3 - 1) * 0.12
			local oy = (math.floor((h - 1) / 3) % 2) * 0.12
			if h == 1 then ox = 0 end
			-- 피격 이펙트는 여러 장이면 타수마다 번갈아, 메이플 그림은 왼쪽 기준이라 오른쪽 공격에 맞게 뒤집는다
			_EffectService:PlayEffect(self:PickHitFx(r.fx, h), who, Vector3(wp.x + ox, wp.y + 0.45 + oy, wp.z), 0, Vector3(r.fxScale, r.fxScale, 1), false, { FlipX = true })
		end
		if r.dmg > 0 then
			local pc = self:GetPlayerAttack()
			local prevSrc = self:SetHitSrc(r.atkActor, r.id or (r.sk ~= nil and r.sk.id or ""), false)
			local hitDmg = self:FinalDouble(r.dmg)
			self:ClearHitSrc(prevSrc)
			if pc ~= nil then pc:ShowProcDamage(target, hitDmg, r.crit) end
			self:ApplyRolledDamage(hitDmg)
			if r.crit then self:OnPlayerCrit() end
			local m = r.m
			if (m.SkillDrain or 0) > 0 then self:HealPlayer(hitDmg * m.SkillDrain / 100) end
			-- 이 스킬로 처치했을 때
			if self.MonsterHp <= 0 then
				if (m.ResetOnKill or 0) > 0 then self._T.cd[r.id] = 0 end
				if (m.KillHealSkill or 0) > 0 then self:HealPlayer(self.PlayerMaxHp * m.KillHealSkill / 100) end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method boolean RollSkill(string skillType)
		-- 확률 발동형 패시브 판정 (수치 = 발동 확률 %, 직업 효과 포함).
		local chance = self:Bonus(skillType)
		return chance > 0 and _UtilLogic:RandomDouble() * 100 < chance
	end

	@ExecSpace("ServerOnly")
	method void SignalFx(string target, boolean ok)
		-- 클라이언트 강화 성공/실패 이펙트 신호.
		self.FxTarget = target
		self.FxOk = ok
		self.FxSeq = self.FxSeq + 1
	end

	@ExecSpace("ServerOnly")
	method Component GetPlayerAttack()
		-- 플레이어 공격 컴포넌트 (TowerPlayer).
		local player = self._T.player
		if not isvalid(player) then return nil end
		return player:GetComponent("script.TowerPlayer")
	end

	@ExecSpace("ServerOnly")
	method void ShowPlayerText(string text)
		-- 패시브 발동 문구를 캐릭터 머리 위에 띄우는 신호 (클라이언트 BattleHUD가 표시).
		self.ProcText = text
		self.ProcSeq = self.ProcSeq + 1
	end

	@ExecSpace("ServerOnly")
	method number RollPlayerAtk()
		-- 이번 공격의 공격력: 최소 ~ 최대 사이 무작위 (숙련도가 높을수록 최소가 최대에 가까움).
		return self.PlayerAtkMin + _UtilLogic:RandomDouble() * (self.PlayerAtk - self.PlayerAtkMin)
	end

	@ExecSpace("ServerOnly")
	method integer KillMeso()
		-- 현재 층의 기본 처치 메소.
		return math.floor(self.BaseMesoReward * (self.MesoGrowth ^ (self:FloorInStage() - 1)) + 0.5)
	end

	@ExecSpace("ServerOnly")
	method number EquipStat(string slot)
		-- 장비 능력치 (1칸 = 메인 기준). 구성원별 값은 EquipStatFor.
		return self:EquipStatFor(slot, 1)
	end

	@ExecSpace("ServerOnly")
	method integer ActorSlotNo(Entity actor)
		-- 5-C: 구성원의 편성 칸 번호 = 장비 번호 (메인 1, 동료 MateIndex + 1, 그 밖 1).
		if not isvalid(actor) or actor == self._T.player then return 1 end
		local mi = self:MateIndex(actor)
		if mi > 0 then return mi + 1 end
		return 1
	end

	@ExecSpace("ServerOnly")
	method number PotBonus(Entity actor, string key)
		-- 5-F: 구성원 자기 편성 칸의 잠재능력 합계 (판 시작 때 고정한 gearRun.slots[칸].pot). 없으면 0.
		local s = ((self._T.gearRun or {}).slots or {})[self:ActorSlotNo(actor)]
		if s == nil or s.pot == nil then return 0 end
		return tonumber(s.pot[key]) or 0
	end

	@ExecSpace("ServerOnly")
	method number SlotSkillPotPct(Entity actor, string slotKey)
		-- 5-F: 망토 공용 스킬 옵션. 칸 키(Main/Sub/Tech/Hyper/Ult)의 피해 % (패시브·칸 밖·기본 공격은 0).
		if slotKey == nil or slotKey == "" or slotKey == "Passive" then return 0 end
		local v = self:PotBonus(actor, slotKey .. "Dmg")
		-- 펫 P-C: 유니콘 티엘(주력기 피해)·주니어 산초(궁극기 피해)는 같은 칸 피해 %에 더한다
		if slotKey == "Main" then v = v + self:PetEffect("MainDmg") elseif slotKey == "Ult" then v = v + self:PetEffect("UltDmg") end
		if v ~= 0 then
			local gr = self._T.gearRun
			if gr ~= nil then
				if gr.potLogged == nil then gr.potLogged = {} end
				local lk = tostring(self:ActorSlotNo(actor)) .. ":" .. slotKey
				if not gr.potLogged[lk] then
					gr.potLogged[lk] = true
					log("[VRF] pot hook " .. slotKey .. "Dmg slot=" .. tostring(self:ActorSlotNo(actor)) .. " v=" .. tostring(v))
				end
			end
		end
		return v
	end

	@ExecSpace("ServerOnly")
	method number UltGainMul(Entity actor)
		-- 5-F: 궁극기 게이지 충전 배율 = 1 + 자기 칸 UltGainPct / 100. 처음 적용 시 로그 1회.
		local v = self:PotBonus(actor, "UltGainPct")
		if v ~= 0 then
			local gr = self._T.gearRun
			if gr ~= nil then
				if gr.potLogged == nil then gr.potLogged = {} end
				local lk = tostring(self:ActorSlotNo(actor)) .. ":UltGain"
				if not gr.potLogged[lk] then
					gr.potLogged[lk] = true
					log("[VRF] pot hook UltGainPct slot=" .. tostring(self:ActorSlotNo(actor)) .. " v=" .. tostring(v))
				end
			end
		end
		-- 펫 P-C: 고슴도치(충전량 +%)는 같은 합에, 쁘띠 포니(충전 속도 ×v배)는 마지막에 곱한다
		v = v + self:PetEffect("UltGainPct")
		-- 각인 가속 루트: 궁극기 충전량 +%
		v = v + self:TalentValue("UltGainPct")
		local mul = math.max(0, 1 + v / 100)
		local pony = self:PetEffect("UltGainMul")
		if pony > 1 then mul = mul * pony end
		return mul
	end

	@ExecSpace("ServerOnly")
	method integer GearSlotLv(string slot, integer no)
		-- 판 시작 때 고정한 그 칸의 부위 주문서 단계.
		local s = ((self._T.gearRun or {}).slots or {})[no]
		if s == nil or s.lv == nil then return 0 end
		return s.lv[slot] or 0
	end

	@ExecSpace("ServerOnly")
	method number EquipMul(string slot, integer no)
		-- 장비 수치 배율 = (1 + 판 강화 × 0.1) × (1 + 그 칸 주문서 단계 × 0.1).
		return (1 + self.EnhanceStatStep * (self.EquipEnh[slot] or 0)) * (1 + self.SlotStatStep * self:GearSlotLv(slot, no))
	end

	@ExecSpace("ServerOnly")
	method number EquipStatFor(string slot, integer no)
		-- 장비 능력치 = 단계 기본값 × 배율(판 강화, no칸 주문서 단계). 잠긴 부위는 0.
		if self.EquipUnlocked[slot] ~= 1 then return 0 end
		local row = (self._T.equip[slot] or {})[self.EquipTier[slot] or 1]
		if row == nil then return 0 end
		return row.value * self:EquipMul(slot, no)
	end

	@ExecSpace("ServerOnly")
	method number EquipStat2For(string slot, integer no)
		-- 장비 두 번째 능력치 (장갑 치명타 데미지 = 예전 신발 값). 배율은 EquipStatFor와 같다.
		if self.EquipUnlocked[slot] ~= 1 then return 0 end
		local row = (self._T.equip[slot] or {})[self.EquipTier[slot] or 1]
		if row == nil then return 0 end
		return (row.value2 or 0) * self:EquipMul(slot, no)
	end

	@ExecSpace("ServerOnly")
	method number SlotMileDelta(Entity actor, string effect)
		-- 5-C: 구성원 능력치 단계 보너스는 자기 칸 값. Bonus()에는 1칸 값이 들어 있으므로 (자기 칸 − 1칸) 차이만 돌려준다.
		local no = self:ActorSlotNo(actor)
		if no == 1 then return 0 end
		local slots = (self._T.gearRun or {}).slots or {}
		local own = ((slots[no] or {}).bonus or {})[effect] or 0
		local first = ((slots[1] or {}).bonus or {})[effect] or 0
		return own - first
	end

	@ExecSpace("ServerOnly")
	method integer CalcEquipCost(string slot)
		-- 강화 비용 = 단계 기본 비용 × 부위 배율, 10강에서 업그레이드는 × 3
		local enh = self.EquipEnh[slot] or 0
		local row = self._T.equip[slot][self.EquipTier[slot] or 1]
		if row == nil then return 0 end
		local cost = row.cost * (1 + self.EnhanceCostStep * enh) * (self._T.costMul[slot] or 1)
		if enh >= self.MaxEnhance then cost = cost * self.UpgradeCostMul end
		local slotInfo = (self._T.slotInfo or {})[slot]
		local costDown = self:Bonus("EquipCostDown")
		if slotInfo ~= nil then costDown = costDown + slotInfo.costDown end
		cost = cost * math.max(0.1, 1 - costDown / 100)
		return math.floor(cost + 0.5)
	end

	@ExecSpace("ServerOnly")
	method table EquipRow(string slot, integer tier)
		-- 장비 단계 정보. 직업 전용 줄이 있으면 이름·외형만 그 직업 것으로 (수치·비용은 공용 줄).
		-- 직업 전용 외형(ItemRUID)이 비어 있으면 공용 외형을 쓴다 (own = false).
		local row = self._T.equip[slot][tier]
		if row == nil then return nil end
		local jobRows = self._T.jobEquip[self.JobId]
		local jr = nil
		if jobRows ~= nil and jobRows[slot] ~= nil then jr = jobRows[slot][tier] end
		if jr == nil then return { name = row.name, ruid = row.ruid, value = row.value, cost = row.cost, own = false } end
		local own = jr.ruid ~= ""
		local ruid = row.ruid
		if own then ruid = jr.ruid end
		return { name = jr.name, ruid = ruid, value = row.value, cost = row.cost, own = own }
	end

	@ExecSpace("ServerOnly")
	method void ApplyCostume()
		-- 현재 장비 단계의 아바타 아이템을 캐릭터에 입힌다. 무기는 직업 무기 종류(한손/두손)에 맞는 칸에 입히고 다른 칸은 비운다.
		-- 2단계: 캐릭터 로스터가 있으면 차수 외형(CharOutfitTable)만 쓴다. 아래 장비 외형은 로스터가 없을 때의 예비.
		local player = self._T.player
		local roster = isvalid(player) and player:GetComponent("script.PlayerRoster") or nil
		if roster ~= nil and roster.RosterLoaded then
			roster:ApplyOutfitForJob(player, self._T.mainJob or "Hero")
			self:CopyCostumeToCompanion()
			return
		end
		if not isvalid(player) or not isvalid(player.CostumeManagerComponent) then return end
		local cm = player.CostumeManagerComponent
		local cats = { Weapon = MapleAvatarItemCategory.OneHandedWeapon, Cap = MapleAvatarItemCategory.Cap, Coat = MapleAvatarItemCategory.Coat, Glove = MapleAvatarItemCategory.Glove, Cape = MapleAvatarItemCategory.Cape }
		for _, slot in ipairs(self._T.slots) do
			local row = self:EquipRow(slot, self.EquipTier[slot] or 1)
			if self.EquipUnlocked[slot] == 1 and row ~= nil and row.ruid ~= "" then
				if slot == "Weapon" then
					local job = self._T.jobById[self.JobId]
					local twoHanded = row.own and job ~= nil and job.weaponCat == "TwoHanded"
					-- 스킬 동작이 든 무기에 맞는 프레임을 쓰도록 무기 계열 전달 (직업 무기가 아니면 공용 한손검)
					local attacker = player:GetComponent("script.TowerPlayer")
					if attacker ~= nil then
						attacker.WeaponFamily = "O"
						if row.own and job ~= nil then attacker.WeaponFamily = job.weaponFamily end
					end
					if twoHanded then
						cm:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, "")
						cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, row.ruid)
					else
						cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "")
						cm:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, row.ruid)
					end
				else
					cm:SetEquip(cats[slot], row.ruid)
				end
			end
		end
		-- 메인이 히어로가 아닌 스킬 직업이면 그 직업 무기를 든다
		local w = self:ListValue(self.JobWeapons, self._T.mainJob or "")
		if w ~= "" and self.JobId == self._T.mainJob then
			local ruid, fam = string.match(w, "^([^:]+):(.*)$")
			if ruid ~= nil then
				local attacker = player:GetComponent("script.TowerPlayer")
				if attacker ~= nil then attacker.WeaponFamily = fam end
				if fam == "T" then
					cm:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, "")
					cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, ruid)
				else
					cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "")
					cm:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, ruid)
				end
			end
		end
		self:CopyCostumeToCompanion()
	end

	@ExecSpace("ServerOnly")
	method void CopyCostumeToCompanion()
		-- 구성원 2명: 로스터가 있으면 각자 직업·차수 외형, 없으면 예전 방식(메인 옷 복사).
		local player = self._T.player
		if not isvalid(player) then return end
		local roster = player:GetComponent("script.PlayerRoster")
		for i = 1, 2 do
			local comp = self:Mate(i)
			if isvalid(comp) then
				local mateJob = (self._T.mateJobs or {})[i] or ""
				if roster ~= nil and roster.RosterLoaded and mateJob ~= "" then roster:ApplyOutfitForJob(comp, mateJob)
				else self:CopyCostumeTo(comp) end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void CopyCostumeTo(Entity comp)
		-- 히어로 구성원: 구성원 1의 옷·무기를 입는다 (구성원 1이 히어로가 아니면 모델 옷 그대로).
		local player = self._T.player
		if not isvalid(player) or not isvalid(comp) or self._T.mainJob ~= "Hero" then return end
		local src = player.CostumeManagerComponent
		local dst = comp.CostumeManagerComponent
		if not isvalid(src) or not isvalid(dst) then return end
		-- 다른 직업 동료(비숍 등)는 자기 모델의 옷을 입는다
		if comp:GetComponent("script.HeroCombat") == nil then return end
		-- 서버에서 GetEquip은 비어 있으므로 Custom*Equip 값을 그대로 옮긴다
		dst.CustomBodyEquip = src.CustomBodyEquip
		dst.CustomHairEquip = src.CustomHairEquip
		dst.CustomFaceEquip = src.CustomFaceEquip
		dst.CustomCapEquip = src.CustomCapEquip
		dst.CustomCapeEquip = src.CustomCapeEquip
		dst.CustomCoatEquip = src.CustomCoatEquip
		dst.CustomLongcoatEquip = src.CustomLongcoatEquip
		dst.CustomPantsEquip = src.CustomPantsEquip
		dst.CustomGloveEquip = src.CustomGloveEquip
		dst.CustomShoesEquip = src.CustomShoesEquip
		dst.CustomOneHandedWeaponEquip = src.CustomOneHandedWeaponEquip
		dst.CustomTwoHandedWeaponEquip = src.CustomTwoHandedWeaponEquip
		dst.CustomSubWeaponEquip = src.CustomSubWeaponEquip
		local a = player:GetComponent("script.TowerPlayer")
		local b = comp:GetComponent("script.TowerPlayer")
		if a ~= nil and b ~= nil then b.WeaponFamily = a.WeaponFamily end
	end

	@ExecSpace("ServerOnly")
	method void UpdateUnlocks(boolean announce)
		-- 최고 기록(또는 이번 판 도달 층)이 조건 층에 닿은 부위를 해금한다. 해금은 최고 기록 기준이라 영구.
		local reach = math.max(self.BestFloor, self.Floor)
		local changed = false
		for _, slot in ipairs(self._T.slots) do
			local need = self._T.unlockFloor[slot] or 0
			if self.EquipUnlocked[slot] ~= 1 and reach >= need then
				self.EquipUnlocked[slot] = 1
				changed = true
				if announce then self:SetEnhanceMsg(self:SlotKoName(slot) .. " 부위가 해금되었습니다!") end
			elseif self.EquipUnlocked[slot] == nil then
				self.EquipUnlocked[slot] = 0
			end
		end
		if changed and announce then
			self:RecalcStats()
			self:ApplyCostume()
		end
	end

	@ExecSpace("ServerOnly")
	method string SlotKoName(string slot)
		-- 부위 한글 이름.
		local names = { Weapon = "무기", Cap = "투구", Coat = "갑옷", Glove = "장갑", Cape = "망토" }
		return names[slot] or slot
	end

	@ExecSpace("ServerOnly")
	method Entity FindPlayer()
		-- 이 맵에 있는 첫 번째 플레이어를 찾는다 (솔로 게임).
		local mapComp = self.Entity.MapComponent
		if not isvalid(mapComp) then return nil end
		local users = _UserService:GetUsersByMapComponent(mapComp)
		if users == nil then return nil end
		for _, user in ipairs(users) do
			if isvalid(user) then return user end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method void RevivePlayer(Entity player)
		-- 죽은 자세가 다음 판까지 남지 않게: 엔진 사망 상태 해제, 상태를 대기로, 클라이언트 아바타 자세 초기화.
		if not isvalid(player) then return end
		local pc = player.PlayerComponent
		if isvalid(pc) then
			if pc:IsDead() then pc:ProcessRevive() end
			pc.Hp = pc.MaxHp
		end
		self:SetLeadWalking(player, false)
		local sc = player.StateComponent
		if isvalid(sc) and sc.CurrentStateName ~= "IDLE" then sc:ChangeState("IDLE") end
		local tp = player:GetComponent("script.TowerPlayer")
		if tp ~= nil then tp:ResetPose() end
	end

	@ExecSpace("ServerOnly")
	method void SetLeadWalking(Entity player, boolean on)
		-- 맨 앞 구성원(플레이어) 자동 걷기 동작 켜기/끄기. 위치는 클라이언트가 매 프레임 직접 옮기므로(입력 없음)
		-- 조작 컴포넌트가 정지로 판단해 서기 상태로 되돌린다 → AlwaysMovingState(동기화)로 걷는 동안 걷기 동작을 유지한다.
		if not isvalid(player) then return end
		local controller = player.PlayerControllerComponent
		if isvalid(controller) and controller.AlwaysMovingState ~= on then controller.AlwaysMovingState = on end
		log("[VRF] lead walking=" .. tostring(on))
	end

	@ExecSpace("ServerOnly")
	method void SetupPlayer(Entity player)
		-- 플레이어를 좌측에 고정하고 조작(이동/점프)을 막는다. 최고 층 기록을 불러온다.
		self._T.player = player
		local movement = player.MovementComponent
		if isvalid(movement) then
			movement.InputSpeed = 0
			movement.JumpForce = 0
		end
		local controller = player.PlayerControllerComponent
		if isvalid(controller) then
			controller.LookDirectionX = 1
		end
		local playerHit = player:GetComponent("script.PlayerHit")
		if playerHit ~= nil then
			playerHit.ImmuneCooldown = 0
		end
		self:RevivePlayer(player)
		player.PlayerComponent:SetWorldPosition(self.PlayerPos)
		self:LoadBestFloor(player)
		self:SpawnCompanion()
		log("[VRF] player setup user=" .. tostring(player.PlayerComponent.UserId) .. " best=" .. tostring(self.BestFloor))
	end

	@ExecSpace("ServerOnly")
	method void LoadBestFloor(Entity player)
		-- 입장 시 1회만 DataStorage에서 최고 층을 읽는다.
		local ds = _DataStorageService:GetUserDataStorage(player.PlayerComponent.ProfileCode)
		local errorCode, raw = ds:GetAndWait(self.StorageKey)
		local best = 0
		if errorCode == 0 and raw ~= nil and raw ~= "" then
			local t = _HttpService:JSONDecode(raw)
			if t ~= nil and t["best"] ~= nil then best = math.floor(t["best"]) end
		elseif errorCode ~= 0 and errorCode ~= 1000002 then
			log_warning("[VRF] best floor load failed code=" .. tostring(errorCode))
		end
		self.BestFloor = best
		self.SavedBestFloor = best
	end

	@ExecSpace("ServerOnly")
	method void SaveBestFloor()
		-- 패배 시 최고 층이 갱신됐을 때만 저장한다 (값이 같으면 저장하지 않음).
		local player = self._T.player
		if not isvalid(player) or self.BestFloor <= self.SavedBestFloor then return end
		local ds = _DataStorageService:GetUserDataStorage(player.PlayerComponent.ProfileCode)
		local value = _HttpService:JSONEncode({ best = self.BestFloor })
		local target = self.BestFloor
		ds:SetAsync(self.StorageKey, value, function(errorCode, key)
			if errorCode == 0 then
				self.SavedBestFloor = target
				log("[VRF] best floor saved=" .. tostring(target))
			else
				log_warning("[VRF] best floor save failed code=" .. tostring(errorCode))
			end
		end)
	end

	@ExecSpace("ServerOnly")
	method void RecalcStats()
		-- 능력치 재계산. 4단계: 구성원별 기본값 = 캐릭터 스탯(PlayerRoster CharRunData) × 계정 % + 장비(공용 부위) 고정값. 최대 HP 증가분만큼 현재 HP도 올린다.
		local oldMax = self.PlayerMaxHp
        local account = self._T.accountBonus or {}
		-- 직업 스킬 + 각인 등 (Bonus). 5-C: 무기·투구·갑옷은 구성원마다 자기 편성 칸 주문서 단계로
		local weaponMul = 1 + self:Bonus("WeaponPct") / 100
		local weapon = self:EquipStatFor("Weapon", 1) * weaponMul
		local armorMul = 1 + self:Bonus("ArmorPct") / 100
		self._T.actorBase = {}
		local player = self._T.player
		local mainBase = nil
		for idx, actor in ipairs(self:Actors()) do
			local job = ""
			if actor == player then job = self._T.mainJob or "" else
				local mi = self:MateIndex(actor)
				if mi > 0 then job = (self._T.mateJobs or {})[mi] or "" end
			end
			local d = self:RunDataFor(job)
			if d == nil then
				if not (self._T.statWarned or {})[job] then
					if self._T.statWarned == nil then self._T.statWarned = {} end
					self._T.statWarned[job] = true
					log_warning("[VRF] run stat missing job=" .. job .. ", using RunConfig base")
				end
				d = { atk = self.BasePlayerAtk, hp = self.BasePlayerMaxHp, def = 0 }
			end
			local no = self:ActorSlotNo(actor)
			local ab = {
				atk = d.atk * (1 + (account.AccountAtk or 0) / 100) + self:EquipStatFor("Weapon", no) * weaponMul,
				hp = d.hp * (1 + (account.AccountHp or 0) / 100) + self:EquipStatFor("Cap", no) * armorMul,
				def = d.def * (1 + (account.AccountDef or 0) / 100) + self:EquipStatFor("Coat", no) * armorMul,
				slotNo = no,
			}
			self._T.actorBase[actor] = ab
			if actor == player then mainBase = ab end
		end
		if mainBase == nil then
			mainBase = { atk = self.BasePlayerAtk * (1 + (account.AccountAtk or 0) / 100) + weapon, hp = self.BasePlayerMaxHp * (1 + (account.AccountHp or 0) / 100) + self:EquipStat("Cap") * armorMul, def = self:EquipStat("Coat") * armorMul }
		end
		local hp = mainBase.hp
		self._T.goddessHpBase = hp
		self.PlayerMaxHp = math.max(1, math.floor(hp * math.max(0.01, 1 + (self:Bonus("HpPct") + self:GoddessBonus(self._T.player, "HpPct")) / 100) + 0.5))
		-- 메인 값: 여신 효과 등 기존 코드 호환 (판 패널 표시도 메인 값)
		self._T.goddessAtkBase = mainBase.atk
		self.PlayerAtk = self:ActorAtk(self._T.player)
		self.Mastery = math.min(100, self.BaseMastery + self:Bonus("Mastery"))
		self.PlayerAtkMin = math.max(1, math.floor(self.PlayerAtk * (0.2 + 0.8 * self.Mastery / 100) + 0.5))
		self._T.goddessDefBase = mainBase.def
		self.PlayerDef = math.floor(self:ActorDefense(self._T.player) + 0.5)
		self.CritRate = self:ActorCrit(self._T.player)
		-- 공격 간격 = 1 / (무기 기본 공격 속도 × (1 + 공격 속도 보너스%))
		self.WeaponSpeed = self.WeaponBaseSpeed + self.WeaponSpeedPerTier * ((self.EquipTier["Weapon"] or 1) - 1)
		self.PlayerAttackInterval = self:ActorInterval(self._T.player)
		-- 5-C: 신발 치명타 데미지 → 장갑 두 번째 능력치 (메인 = 1칸). 명중은 파티 공용이라 1칸 망토
		self.CritDmg = self.BaseCritDmg + self:EquipStat2For("Glove", 1) + self:Bonus("CritDmg")
		self.Accuracy = self:EquipStatFor("Cape", 1) + self:Bonus("Acc")
		self.EnhanceBonus = self:Bonus("EnhRate")
		if oldMax > 0 and self.PlayerMaxHp > oldMax and not self.PlayerDown then
			self.PlayerHp = math.min(self.PlayerMaxHp, self.PlayerHp + (self.PlayerMaxHp - oldMax))
		end
		-- 동료: 자기 캐릭터 체력 기준 (최대 체력 증가분만큼 현재 체력도)
		self._T.mateMaxCalc = {}
		for i = 1, 2 do
			local oldComp = self:MateMax(i)
			local comp = self:Mate(i)
			local mhp = hp
			local mb = isvalid(comp) and self._T.actorBase[comp] or nil
			if mb ~= nil then mhp = mb.hp end
			local maxHp = math.max(1, math.floor(mhp * math.max(0.01, 1 + (self:Bonus("HpPct") + self:GoddessBonus(comp, "HpPct")) / 100) + 0.5))
			self._T.mateMaxCalc[i] = maxHp
			self:SetMateMax(i, maxHp)
			if oldComp > 0 and maxHp > oldComp and not self:MateDown(i) then
				self:SetMateHp(i, math.min(maxHp, self:MateHp(i) + (maxHp - oldComp)))
			end
			self:SetMateHp(i, math.min(self:MateHp(i), maxHp))
		end
		self.PlayerHp = self.PlayerDown and 0 or math.min(self.PlayerHp, self.PlayerMaxHp)
		for _, slot in ipairs(self._T.slots) do self.EquipCost[slot] = self:CalcEquipCost(slot) end
	end


	@ExecSpace("ServerOnly")
	method void StartRun()
		-- 판 시작: 1층 1스테이지, 판 안 성장치(레벨·경험치·메소·강화) 전부 초기화.
        local accountPlayer = self:GetEngrave()
        if accountPlayer == nil or not accountPlayer.AccountLoaded then return end
		-- 보스 개편 B5: 이번 판이 보스전인지 정한다 (로비 예약 / 다시 도전 / 디버그)
		self:SetupRunMode()
		-- 4단계: 편성은 판 시작 때 로스터에서 한 번 정한다 (보정 → 편성 → 전투 컴포넌트 정리 순서)
		self:LoadRunParty()
		self:LoadFormation()
        self._T.accountBonus = accountPlayer:AccountBonuses()
        self._T.accountRunCounter = (self._T.accountRunCounter or 0) + 1
        self._T.accountRunId = tostring(DateTime.UtcNow.Elapsed) .. ":" .. tostring(self._T.accountRunCounter)
        self._T.accountSettled = false
        self._T.accountSettlement = nil
        self._T.completedStages = 0
        -- 4-B 보완: 판 끝 처리 재진입 방지 플래그 초기화
        self._T.stageEnding = false
        self._T.stageCleared = false
        self._T.defeated = false
        self.ResultAccountExp = 0
        self.ResultAccountSaved = true
        self.ResultAccountBeforeLevel = accountPlayer.AccountLevel
        self.ResultAccountAfterLevel = accountPlayer.AccountLevel
		-- 각인 효과는 판 시작 시점 값으로 고정 (각인은 로비에서만 바뀜). 옛 각인(PlayerEngrave.BuildValues) 대신 새 각인(PlayerTalent)
		self._T.talent = {}
		self._T.talentCores = {}
		self._T.talentShieldReady = {}
		local talentComp = self:GetTalent()
		if talentComp ~= nil then
			local td = talentComp:TalentRunData()
			self._T.talent = td.values or {}
			self._T.talentCores = td.cores or {}
		end
		local engrave = self:GetEngrave()
		-- 유물 (심볼 대체): 판 시작 시점 레벨로 고정
		self._T.symbolPerm = {}
		self._T.relic = {}
		if engrave ~= nil then self._T.relic = engrave:RelicValues() end
		-- 미네르바의 은총: 지금 프리셋 옵션 합계
		self._T.grace = {}
		if engrave ~= nil then self._T.grace = engrave:GraceValues() end
		-- 5-C: 편성 칸 장비(PlayerGear) 주문서 단계를 판 시작 시점으로 고정. 정비소 효과·단계 보너스(Bonus)는 1칸 기준,
		-- 구성원 능력치(장비 배율·고유 단계 보너스)는 ActorSlotNo로 자기 칸 값 (EquipStatFor, SlotMileDelta)
		self._T.gearRun = { slots = {}, party = { slots = {}, bonus = {} } }
		self._T.slotInfo = {}
		self._T.slotBonus = {}
		local gear = self:GetGear()
		if gear ~= nil and gear.GearLoaded then
			self._T.gearRun = gear:GearRunData()
			self._T.slotInfo = self._T.gearRun.party.slots or {}
			self._T.slotBonus = self._T.gearRun.party.bonus or {}
			local logs = {}
			for no, s in ipairs(self._T.gearRun.slots) do
				local lvs = {}
				for _, slot in ipairs(self._T.slots) do table.insert(lvs, string.sub(slot, 1, 2) .. tostring((s.lv or {})[slot] or 0)) end
				local bs = {}
				for k, v in pairs(s.bonus or {}) do table.insert(bs, k .. ":" .. tostring(v)) end
				-- 5-F: 잠재능력 합계
				local ps = {}
				for k, v in pairs(s.pot or {}) do table.insert(ps, k .. ":" .. tostring(v)) end
				table.insert(logs, "s" .. tostring(no) .. " lv=" .. table.concat(lvs, ",") .. " bonus=" .. table.concat(bs, ",") .. " pot=" .. table.concat(ps, ","))
			end
			log("[VRF] gear run " .. table.concat(logs, " | "))
		else
			log_warning("[VRF] gear run data missing")
		end
		-- 펫 P-C: 보유 공격력%·장착 펫 효과·클립을 판 시작 시점으로 고정 (디버그 판 포함)
		self:LoadPetRun()
		for _, slot in ipairs(self._T.slots) do
			local info = self._T.slotInfo[slot]
			if info ~= nil then
				self.SlotLevels[slot] = info.lv
				self.SlotEnhRate[slot] = info.enhRate
			else
				self.SlotLevels[slot] = 0
				self.SlotEnhRate[slot] = 0
			end
		end
		self.EntryHold = false
		self.RunFeathers = 0
		self.RunKeys = 0
		self.RunScrolls = 0
		self.RunCubes = 0
		self.RunFreeCubes = 0
		self.RunBooks = 0
		self.RunGoldMeso = 0
		self.RunDiamonds = 0
		-- 4단계: 판 안 레벨 없음. Level = 메인 캐릭터 레벨(표시용, 판 중 고정)
		local mainData = self:RunDataFor(self._T.mainJob or "")
		local startLevel = (mainData ~= nil and mainData.level ~= nil) and math.max(1, math.floor(mainData.level)) or 1
		-- 로비에서 고른 스테이지 (열린 스테이지까지만)
		local stageNo = 1
		local maxFloor = #self._T.floors
		local maxStage = math.max(1, math.floor(maxFloor / self.FloorsPerStage))
		if engrave ~= nil then
			local unlocked = math.min(maxStage, math.floor(engrave.ClearedFloor / self.FloorsPerStage) + 1)
			stageNo = math.max(1, math.min(unlocked, engrave.SelectedStage))
		end
		-- 테스트: DebugStartFloor로 정한 층 (열린 층 제한 없음, 한 번 쓰고 지움)
		-- 4-D 보완(B3): 디버그로 시작한 판은 최고 층·첫 클리어(각인 진행·다이아)·별 기록을 저장하지 않는다
		-- 보스 개편 B5: 보스전은 해금 층(그 층 보스 수치·배경)을 기준으로 한다
		local bossDebug = false
		if self.RunMode == "boss" and self._T.bossRow ~= nil then
			bossDebug = self._T.bossRun ~= nil and self._T.bossRun.debug == true
			self._T.debugFloor = self._T.bossRow.unlockFloor
		end
		self._T.debugRun = self._T.debugFloor ~= nil
		if self.RunMode == "boss" then self._T.debugRun = bossDebug end
		self.ResultDebugRun = self._T.debugRun
		if self._T.debugFloor ~= nil then
			stageNo = math.max(1, math.min(maxStage, math.floor((self._T.debugFloor - 1) / self.FloorsPerStage) + 1))
			self._T.debugFloor = nil
		end
		self.StageNo = stageNo
		self.StageStartFloor = (stageNo - 1) * self.FloorsPerStage + 1
		self.StageEndFloor = stageNo * self.FloorsPerStage
		-- 결과 화면 '기존/새로 달성' 판정용: 판 시작 시점의 이 층 별 (판 중 기록·중복 정산과 무관하게 고정)
		self._T.startStars = (engrave ~= nil) and engrave:GetStars(self.StageEndFloor) or 0
		self.IsStageClear = false
		self.StageRewardBooks = 0
		self.StageRewardFeathers = 0
		self.Floor = self.StageStartFloor
		self.Stage = 1
		self._T.waveLeft = 0
		-- 갈림길 상태 초기화: 첫 스테이지는 일반 전투
		self.StageKind = "normal"
		self._T.waveNo = 1
		self._T.routePending = false
		self._T.lastNonCombat = false
		self._T.dealUsed = false
		self._T.walk = nil
		-- 보스 개편 B5: 보스전은 해금 층 마지막(보스) 스테이지 마지막 웨이브 하나만
		if self.RunMode == "boss" then
			self.Stage = self.StagesPerFloor
			self.StageKind = "boss"
			self._T.waveNo = self.WavesPerStage
		end
		self:ClearPortals()
		self:ClearNpcs()
		self._T.acc = { {}, {}, {} }
		self._T.accUndying = {}
		self:SyncAccessories()
		self.Level = startLevel
		self.Exp = 0
		self.ExpToNext = 1
		self.Meso = math.floor(self:Bonus("StartMeso"))
		self.RunMeso = 0
		self.IsNewBest = false
		self.EnhanceMsg = ""
		for _, slot in ipairs(self._T.slots) do
			self.EquipTier[slot] = 1
			self.EquipEnh[slot] = 0
			local slotInfo = self._T.slotInfo[slot]
			if slotInfo ~= nil then self.EquipEnh[slot] = math.min(self.MaxEnhance, math.floor(slotInfo.startEnh)) end
		end
		self:UpdateUnlocks(false)
		self._T.undyingUsed = false
		self._T.lastStandUsed = false
		self._T.deal = {}
		self:ResetGoddessEffects()
		self._T.curses = {}
		self.CurseText = ""
		self._T.extraHitTimer = 0
		-- 직업·직업 스킬 초기화 (직업은 판 시작 화면에서 고름)
		self:ResetSkillAlias()
		self.JobId = ""
		for id, _ in pairs(self._T.skillById) do
			self.SkillLv[id] = 0
			self.SkillBreaks[id] = ""
			self.SkillInfo[id] = ""
		end
		self.BreakSkill = ""
		-- 메인 엔티티는 전투 컴포넌트 3개를 모두 가진다: 셋 다 정리해 메인 직업이 아닌 것은 Active=false로 둔다
		local mainEnt = self._T.player
		if isvalid(mainEnt) then
			for _, cn in ipairs({ "script.HeroCombat", "script.BishopCombat", "script.JobCombat" }) do
				local c = mainEnt:GetComponent(cn)
				if c ~= nil then c:ClearState() end
			end
		end
		for _, h in ipairs(self:Heroes()) do h:ClearState() end
		self.PlayerDown = false
		self._T.mateShield = {}
		self._T.breakQueue = {}
		self._T.growBreak = false
		self._T.runSkillsJob = nil
		self._T.skillMods = {}
		self._T.runBonus = {}
		-- 4-F: 돌파는 칸 키("직업.칸") + 번호로 저장 (BeginRun의 RegisterSlots가 칸 키를 채운다)
		self._T.breakTaken = {}
		self._T.slotKeyOf = {}
		self._T.starCount = {}
		self._T.buffs = {}
		self._T.cd = {}
		self:ClearBurn()
		self._T.shield = 0
		self._T.regenTimer = 5
		self._T.stunUntil = 0
		self._T.stunBurst = 0
		self._T.stunVuln = 0
		self._T.vulnUntil = 0
		-- 4단계: 시작 카드 없음 (각인 '선행 학습'은 PickJob에서 판 시작 돌파 선택으로)
		self.PendingPicks = 0
		self.Rerolls = math.floor(self:Bonus("Reroll"))
		self.PlayerMaxHp = 0
		self:RecalcStats()
		self:ApplyCostume()
		self.PlayerHp = self.PlayerMaxHp
		self:DestroyMonster()
		local player = self._T.player
		if isvalid(player) then
			self:RevivePlayer(player)
			player.PlayerComponent:SetWorldPosition(self.PlayerPos)
		end
		self:SpawnCompanion()
		-- 펫 P-C: 장착 펫을 파티 맨 뒤에 세운다
		self:SpawnPets()
		-- 동료가 생긴 뒤 구성원별 캐릭터 스탯으로 다시 계산
		self:RecalcStats()
		self:FullHealParty()
		self._T.needEntry = true
		self.SkillStone = math.floor(self:Bonus("StartStone") + 0.5)
		self.StoneCost = self.StoneCostStart
		log("[VRF] run start stage=" .. tostring(self.StageNo) .. " floor=" .. tostring(self.Floor) .. " lv=" .. tostring(self.Level) .. " meso=" .. tostring(self.Meso) .. " rerolls=" .. tostring(self.Rerolls) .. " atk=" .. tostring(self.PlayerAtk) .. " hp=" .. tostring(self.PlayerHp) .. " stars=" .. tostring(self._T.startStars))
		-- 직업 선택 카드를 보여주고, 고르면(RequestPickJob) 스킬 카드 → 전투 시작
		self:RollJobChoices()
	end

	@ExecSpace("ServerOnly")
	method void ApplyFloorLook()
		-- 지금 층의 원작 맵 배경 템플릿으로 배경을 바꾸고, 바닥 타일셋은 동기화 값으로 넘긴다 (같으면 그대로).
		local floors = self._T.floors
		if #floors == 0 then return end
		local f = floors[math.min(self.Floor, #floors)]
		if self._T.defaultBg == nil then
			local bgEnt = self.Entity:GetChildByName("Background")
			self._T.defaultBg = (isvalid(bgEnt) and isvalid(bgEnt.BackgroundComponent)) and bgEnt.BackgroundComponent.TemplateRUID or ""
		end
		local bg = f.bg
		-- 보스 개편 B2: 층 보스 스테이지(보스전 포함) 동안 필드보스 원본 맵 배경. 타일셋은 BossTileSetRUID가 있을 때만 바꾸고 없으면 층 것 유지
		local bossStage = self.StageKind == "boss" and (f.bossBg or "") ~= ""
		if bossStage then bg = f.bossBg end
		if self.RunMode == "boss" and self._T.bossRow ~= nil and (self._T.bossRow.bg or "") ~= "" then
			bg = self._T.bossRow.bg
			bossStage = true
		end
		if bg == nil or bg == "" then bg = self._T.defaultBg end
		local bgEnt = self.Entity:GetChildByName("Background")
		if isvalid(bgEnt) and isvalid(bgEnt.BackgroundComponent) and bg ~= "" and bgEnt.BackgroundComponent.TemplateRUID ~= bg then
			bgEnt.BackgroundComponent:ChangeBackgroundByTemplateRUID(bg)
			log("[VRF] floor look bg " .. tostring(self.Floor) .. " -> " .. bg)
		end
		local ts = f.ts or ""
		if bossStage and self.StageKind == "boss" and (f.bossTs or "") ~= "" then ts = f.bossTs end
		if self.RunMode == "boss" and self._T.bossRow ~= nil and (self._T.bossRow.ts or "") ~= "" then ts = self._T.bossRow.ts end
		if self.FloorTileSet ~= ts then
			self.FloorTileSet = ts
			log("[VRF] floor look tileset " .. tostring(self.Floor) .. " -> " .. ts)
		end
	end

	@ExecSpace("ServerOnly")
	method integer FloorInStage()
		-- 스테이지 안에서 몇 번째 층인지 (1~5).
		return math.max(1, self.Floor - self.StageStartFloor + 1)
	end

	@ExecSpace("ServerOnly")
	method number StageMonsterLevel()
		-- 몬스터 능력치 레벨: 1~5층 중 같은 순번 층의 몬스터 레벨 + (스테이지-1) × StageLevelStep. (그림은 실제 층 몬스터)
		local fi = self:FloorInStage()
		local base = fi
		local floors = self._T.floors
		if #floors >= fi then
			local info = self._T.monsterById[floors[fi].monsterId]
			if info ~= nil then base = info.level end
		end
		return base + (self.StageNo - 1) * self.StageLevelStep
	end

	@ExecSpace("ServerOnly")
	method void StageClear()
		-- 스테이지 마지막 층 클리어: 임시 보상(스킬북·깃털) 지급·저장 후 결과 팝업(스테이지 클리어).
		-- 같은 판에서 두 번 정산하지 않는다 (이미 결과 화면이면 무시)
		if self.RunState == "RESULT" and self.IsStageClear then return end
		-- 4-B 보완: 정산 저장 대기 중 재진입해도 한 번만 (플래그를 SettleAccount보다 먼저 세움, StartRun에서 해제)
		if self._T.stageCleared then return end
		self._T.stageCleared = true
		self:SettleAccount(true)
		self:DestroyMonster()
		for _, h in ipairs(self:Heroes()) do h:ClearState() end
		-- 스킬북은 판 보상에서 제거(메소 재화 개편): 깃털만 지급. 저장된 스킬북 값은 PlayerEngrave에 그대로 남는다.
		local books = 0
		local feathers = math.floor(self.StageFeatherBase + self.StageNo * self.StageFeatherPerStage)
		local eng = self:GetEngrave()
		-- 4-G 보완: 디버그 판은 판 보상(깃털 등)을 계정에 더하지 않는다 (표시용 판 합계만)
		if eng ~= nil and not self._T.debugRun then
			if feathers > 0 then eng:AddFeathers(feathers) end
		end
		self.RunFeathers = self.RunFeathers + feathers
		self.StageRewardBooks = books
		self.StageRewardFeathers = feathers
		self.IsStageClear = true
		-- 별 미션 판정: 1 클리어, 2 제한 시간 안, 4 남은 체력 기준 이상 → 누적 저장, 결과 화면 값
		local elapsed = _UtilLogic.ElapsedSeconds - (self._T.runStartAt or _UtilLogic.ElapsedSeconds)
		local hpRatio = self.PlayerMaxHp > 0 and self.PlayerHp / self.PlayerMaxHp or 0
		local bits = 1
		if elapsed <= self.StarTimeLimit then bits = bits | 2 end
		if hpRatio >= self.StarHpRatio then bits = bits | 4 end
		self.ResultFloor = self.StageEndFloor
		self.ResultTime = elapsed
		self.ResultHpPct = math.floor(hpRatio * 100 + 0.5)
		self.ResultStarsPrev = self._T.startStars or (eng ~= nil and eng:GetStars(self.StageEndFloor) or 0)
		if eng ~= nil and not self._T.debugRun then eng:RecordStars(self.StageEndFloor, bits) end
		self.ResultStarsNow = self.ResultStarsPrev | bits
		log("[VRF] star result floor=" .. tostring(self.StageEndFloor) .. " time=" .. string.format("%.1f", elapsed) .. " hp=" .. tostring(self.ResultHpPct) .. " bits=" .. tostring(bits) .. " prev=" .. tostring(self.ResultStarsPrev) .. " debugRun=" .. tostring(self._T.debugRun == true))
		-- 4-D 보완(B3): 디버그 판은 최고 층·별을 저장하지 않는다
		if not self._T.debugRun then
			if self.StageEndFloor > self.BestFloor then
				self.BestFloor = self.StageEndFloor
				self.IsNewBest = true
			end
			self:SaveBestFloor()
		else
			log("[VRF] debug run clear: best floor/stars not saved")
		end
		if eng ~= nil and not self._T.debugRun then
			eng:FlushGrace()
			eng:FlushRelics()
			eng:FlushSkills()
		end
		-- 5-B: 주문서 보유는 PlayerGear가 저장한다 (옛 PlayerEngrave.FlushSlots 호출 끊음)
		local gear = self:GetGear()
		if gear ~= nil and not self._T.debugRun then gear:Flush() end
		self.RunState = "RESULT"
		log("[VRF] stage clear " .. tostring(self.StageNo) .. " floors " .. tostring(self.StageStartFloor) .. "-" .. tostring(self.StageEndFloor) .. " books+" .. tostring(books) .. " feathers+" .. tostring(feathers))
	end

	@ExecSpace("ServerOnly")
	method void SpawnMonster()
		-- 현재 층·스테이지 능력치로 몬스터를 우측에 스폰한다.
		-- 층 몬스터 = FloorTable의 MonsterId (테이블 끝을 넘으면 마지막 층 유지)
		-- 스테이지 배율: 1스테이지 1배 → 마지막 스테이지 2.5배, 마지막 스테이지는 접두사 강화 + 1.5배 크기
		local list = self._T.monsters
		if list == nil or #list == 0 then
			log_error("[VRF] no monster data")
			self.RunState = "WAIT"
			return
		end
		local floorName = ""
		local info = nil
		local floors = self._T.floors
		if #floors > 0 then
			local f = floors[math.min(self.Floor, #floors)]
			floorName = f.name
			info = self._T.monsterById[f.monsterId]
		end
		if info == nil then info = list[math.min(self.Floor, #list)] end
		self:ApplyFloorLook()
		-- 새 스테이지면 웨이브 시작 (몬스터 수·대기열 초기화)
		if (self._T.waveLeft or 0) <= 0 then self:BeginWave() end
		-- 웨이브 맨 앞 몬스터: 대기열에 서 있던 몬스터를 앞으로 불러오고(그 몬스터 종류 그대로), 없으면 층 몬스터 중 무작위
		local monster = nil
		local queue = self._T.queue or {}
		if #queue > 0 then
			-- 다음 맨 앞 = 가장 가까운 칸(사거리가 짧은) 몬스터, 같은 칸이면 먼저 온 몬스터
			local pick = 1
			local best = 99
			for qi, q in ipairs(queue) do
				local qc = isvalid(q) and q:GetComponent("script.TowerMonster") or nil
				if qc ~= nil and self:MonRange(qc) < best then
					best = self:MonRange(qc)
					pick = qi
				end
			end
			monster = table.remove(queue, pick)
		end
		if isvalid(monster) and self._T.infoOf ~= nil and self._T.infoOf[monster] ~= nil then
			info = self._T.infoOf[monster]
		else
			info = self:PickWaveInfo(info, (self._T.waveSpawned or 0) + 1)
		end
		local kindName = ""
		if self.StageKind == "elite" then kindName = " (정예)" elseif self.StageKind == "boss" then kindName = " (보스)" end
		self.FloorTitle = tostring(self.Floor) .. "층 " .. floorName .. "  스테이지 " .. tostring(self.Stage) .. "/" .. tostring(self.StagesPerFloor) .. kindName
		if self.RunMode == "boss" and self._T.bossRow ~= nil then self.FloorTitle = self._T.bossRow.name .. "  " .. tostring(self.BossRunStep) .. "단계" end

		local mul = self._T.typeMul[info.type] or { hp = 1, atk = 1, evade = 0 }
		local statLv = self:StageMonsterLevel()
		local stageMul = 1
		if self.StagesPerFloor > 1 then
			stageMul = 1 + (self.LastStageStatMul - 1) * (self.Stage - 1) / (self.StagesPerFloor - 1)
		end
		local atk = (self.MonsterAtkBase + self.MonsterAtkPerLevel * statLv) * mul.atk * stageMul
		local evade = mul.evade
		local def = 0
		local defMAdd = 0
		local crit = 0
		local interval = self.MonsterAttackInterval
		local prefix = ""
		-- 정예·보스 = 정예/보스 스테이지 웨이브의 마지막 1마리 (보스는 마지막 웨이브만)
		local willBoss = false
		if isvalid(monster) then
			self.MonsterElite = self._T.eliteOf ~= nil and self._T.eliteOf[monster] == true
			willBoss = self._T.bossOf ~= nil and self._T.bossOf[monster] == true
		else
			local last = ((self._T.waveSpawned or 0) + 1) >= (self._T.waveSize or 1)
			self.MonsterElite = self:IsEliteStage() and last
			if self.StageKind == "boss" then
				willBoss = last and (self._T.waveNo or 1) >= self.WavesPerStage
				self.MonsterElite = willBoss
			end
		end
		self.MonsterBoss = willBoss
		self:UpdateFloorSymbol()
		self._T.firstHitDone = false
		-- 새 몬스터: 기절·약화·화상 상태 초기화
		self:ClearBurn()
		self._T.stunUntil = 0
		self._T.stunBurst = 0
		self._T.vulnUntil = 0
		-- 등급 기본 배율 (공격·방어·체력). 방어는 접두사 '단단한'이 붙으면 그 값에 배율을 곱한다
		local rankAtk, rankDef = 1, 1
		if willBoss then
			rankAtk, rankDef = self.BossAtkMul, self.BossDefMul
		elseif self.MonsterElite then
			rankAtk, rankDef = self.EliteAtkMul, self.EliteDefMul
		end
		atk = atk * rankAtk
		if self.MonsterElite and not willBoss and #self._T.prefixes > 0 then
			-- 접두사 1개 (대기열에서 정해 둔 것, 없으면 지금 뽑음): 강력한 / 단단한 / 치명적인 / 재빠른 / 날렵한
			local p = isvalid(monster) and self._T.prefixOf ~= nil and self._T.prefixOf[monster] or nil
			if p == nil then p = self._T.prefixes[_UtilLogic:RandomIntegerRange(1, #self._T.prefixes)] end
			self._T.pendingPrefix = p
			prefix = p.name .. " "
			if p.stat == "Atk" then atk = atk * p.value
			elseif p.stat == "Def" then def = p.value
			elseif p.stat == "DefM" then defMAdd = p.value
			elseif p.stat == "Crit" then crit = p.value
			elseif p.stat == "Speed" then interval = interval / p.value
			elseif p.stat == "Evade" then evade = evade + p.value
			end
		end
		-- 전투 능력치 개편: 물리 방어 = (몬스터·타입 기본 + '단단한') × 등급, 마법 방어 = (기본 + '마력 결계') × 등급
		local defM = ((info.defM or mul.defM or 0) + defMAdd) * rankDef
		def = ((info.defP or mul.defP or 0) + def) * rankDef
		self._T.monsterEvade = evade
		self._T.monsterDef = def
		self._T.monsterDefP = def
		self._T.monsterDefM = defM
		self._T.monInfo = info
		self._T.monsterCrit = crit
		self._T.monsterInterval = interval
		local rankHp = 1
		if willBoss then rankHp = self.BossHpMul elseif self.MonsterElite then rankHp = self.EliteHpMul end
		self.MonsterMaxHp = math.max(1, math.floor((self.MonsterHpBase + self.MonsterHpPerLevel * statLv) * mul.hp * stageMul * rankHp + 0.5))
		self.MonsterHp = self.MonsterMaxHp
		self.MonsterAtk = math.max(1, math.floor(atk + 0.5))
		-- 몬스터 레벨은 표시하지 않는다 (캐릭터 레벨과 기준이 달라 혼동됨)
		self.MonsterLabel = prefix .. info.name
		if willBoss then self.MonsterLabel = "보스 " .. info.name end

		-- 대기열에 없으면 화면 오른쪽에서 새로 걸어 들어온다 (나온 묶음을 다 잡았으면 다음 묶음을 바로 내보냄)
		if not isvalid(monster) then
			if (self._T.waveSpawned or 0) >= (self._T.released or 0) then self:ReleaseWaveGroup() end
			monster = self:SpawnWaveMonster(info, self.MonsterPos.x + self.SpawnOffsetX)
			local nc = isvalid(monster) and monster:GetComponent("script.TowerMonster") or nil
			if nc ~= nil then nc.IsRanged = info.ranged == true end
		end
		if monster == nil then
			log_error("[VRF] SpawnByModelId returned nil id=" .. self.MonsterModelId)
			self.RunState = "WAIT"
			return
		end
		self._T.monster = monster
		self.MonsterName = monster.Name
		local mc = monster:GetComponent("script.TowerMonster")
		local walkTime = 0
		if mc ~= nil then
			mc.IsQueued = false
			-- 대기열에서 범위 스킬에 맞아 깎인 체력은 그대로 이어받는다
			if mc.MaxHp > 0 and mc.Hp > 0 then self.MonsterHp = math.min(self.MonsterMaxHp, mc.Hp) end
			-- 맨 앞 몬스터 체력은 매니저 값(MonsterHp)으로 그리므로 몬스터 자기 체력바는 끈다
			mc.MaxHp = 0
			local sprite = monster.SpriteRendererComponent
			if isvalid(sprite) then sprite.OrderInLayer = 2 end
			local slotX = self:CellX(self:MonRange(mc))
			local dist = math.abs(monster.TransformComponent.Position.x - slotX)
			walkTime = dist / math.max(0.1, self.MonsterWalkSpeed * mc.SpeedMul)
			mc:WalkTo(slotX, self.MonsterWalkSpeed * mc.SpeedMul)
		end
		-- 대기열 없이 바로 나온 정예·보스도 같은 표시 (정예 이름표, 보스 1.5배)
		if willBoss then
			monster.TransformComponent.Scale = Vector3(self.BossScale, self.BossScale, 1)
			if self._T.bossOf == nil then self._T.bossOf = {} end
			self._T.bossOf[monster] = true
			-- 보스 개편 B3·B5: 보스전 수치·속성 덮어쓰기 + 기믹 시작 (필드보스는 예고 강타만)
			self:OnBossFront(monster, info)
		elseif self.MonsterElite and self._T.pendingPrefix ~= nil then
			if self._T.prefixOf == nil then self._T.prefixOf = {} end
			if self._T.prefixOf[monster] == nil then
				self._T.prefixOf[monster] = self._T.pendingPrefix
				self:AttachEliteTag(monster, self._T.pendingPrefix.name .. " " .. info.name)
			end
		end
		self._T.pendingPrefix = nil
		-- 남은 웨이브 몬스터로 대기열을 채우고 한 칸씩 앞으로
		self._T.waveInfo = info
		self:FillQueue(info)
		if self:IsHeroRun() then
			for _, h in ipairs(self:Heroes()) do h:OnMonsterSpawn(self, monster, info.stand) end
			local extra = self:ExtraStatusHero()
			if extra ~= nil then extra:OnMonsterSpawn(self, monster, info.stand) end
		end
		-- 우리 편 공격은 사거리·쿨타임으로 판단 (ActorTryAttack). 몬스터는 걸어 들어오는 동안 공격하지 않는다
		self.MonsterAttackTimer = interval + walkTime
		self.RunState = "FIGHT"
		log("[VRF] " .. self.FloorTitle .. " wave left=" .. tostring(self._T.waveLeft) .. " queue=" .. tostring(#(self._T.queue or {})) .. " monster " .. self.MonsterLabel .. " lv=" .. tostring(info.level) .. " statLv=" .. string.format("%.1f", statLv) .. " (" .. info.type .. ") elite=" .. tostring(self.MonsterElite) .. " hp=" .. tostring(self.MonsterMaxHp) .. " atk=" .. tostring(self.MonsterAtk) .. " def=" .. tostring(def) .. " defM=" .. tostring(defM) .. " elem=" .. self:ElemTableText(info.elem) .. " crit=" .. tostring(crit) .. " interval=" .. tostring(interval) .. " evade=" .. tostring(evade))
	end

	@ExecSpace("ServerOnly")
	method integer StagesPerSection()
		-- 구간 하나의 스테이지 수 (15스테이지 ÷ 3구간 = 5).
		return math.max(1, math.floor(self.StagesPerFloor / math.max(1, self.SectionsPerFloor)))
	end

	@ExecSpace("ServerOnly")
	method integer SectionNo()
		-- 지금 스테이지가 몇 번째 구간인지 (1~3).
		return math.min(self.SectionsPerFloor, math.floor((self.Stage - 1) / self:StagesPerSection()) + 1)
	end

	@ExecSpace("ServerOnly")
	method boolean IsEliteStage()
		-- 정예·보스 전투 스테이지: 웨이브마다 마지막 1마리가 강화 몬스터.
		return self.StageKind == "elite" or self.StageKind == "boss"
	end

	@ExecSpace("ServerOnly")
	method void BeginWave()
		-- 스테이지 시작: 웨이브 몬스터 수 = 기본 + 구간당 증가 (강화 스테이지는 1마리). 경험치 막대는 웨이브 진행도로 쓴다.
		for _, q in ipairs(self._T.queue or {}) do
			if isvalid(q) then q:Destroy() end
		end
		self._T.queue = {}
		self._T.infoOf = {}
		self._T.eliteOf = {}
		-- 웨이브 몬스터 수 = 기본 + 구간당 증가. 강화 웨이브도 같은 수이며 마지막 1마리가 엘리트
		local size = math.max(1, math.floor(self.WaveSizeBase + self.WaveSizePerSection * (self:SectionNo() - 1) + 0.5))
		-- 보스 개편 B5: 보스전은 보스 1마리 (소환물은 웨이브 수에 넣지 않음)
		if self.RunMode == "boss" then size = 1 end
		self._T.waveSize = size
		self._T.waveLeft = size
		self._T.waveSpawned = 0
		-- 4-B 보완: 새 스테이지·웨이브가 시작되면 스테이지 끝 블록을 다시 열어 준다
		self._T.stageEnding = false
		-- 묶음 나누기: WaveGroups 합이 웨이브 수와 다르면 마지막 묶음에서 맞춘다
		local groups = {}
		local sum = 0
		for g in string.gmatch(self.WaveGroups or "", "[^|]+") do
			local c = math.max(1, math.floor(tonumber(g) or 0))
			if sum + c > size then c = size - sum end
			if c > 0 then table.insert(groups, c) sum = sum + c end
		end
		if sum < size then
			if #groups == 0 then table.insert(groups, size - sum) else groups[#groups] = groups[#groups] + size - sum end
		end
		self._T.groups = groups
		self._T.groupIdx = 1
		self._T.released = groups[1] or size
		self._T.nextGroupAt = _UtilLogic.ElapsedSeconds + self.WaveGroupInterval
		if self.StageLevelUp then
			self.Exp = 0
			self.ExpToNext = size
		end
		log("[VRF] wave begin floor=" .. tostring(self.Floor) .. " stage=" .. tostring(self.Stage) .. " section=" .. tostring(self:SectionNo()) .. " size=" .. tostring(size) .. " elite=" .. tostring(self:IsEliteStage()))
	end

	@ExecSpace("ServerOnly")
	method Entity SpawnWaveMonster(table info, number x)
		-- 웨이브 몬스터 1마리를 x 위치에 만든다 (외형만 입힘, 전투 대상 여부는 IsQueued로 구분).
		self.SpawnSeq = self.SpawnSeq + 1
		local name = "TowerMonster_" .. tostring(self.SpawnSeq)
		local monster = _SpawnService:SpawnByModelId(self.MonsterModelId, name, Vector3(x, self.MonsterPos.y, self.MonsterPos.z), self.Entity)
		if monster == nil then return nil end
		self._T.waveSpawned = (self._T.waveSpawned or 0) + 1
		if self._T.infoOf == nil then self._T.infoOf = {} end
		self._T.infoOf[monster] = info
		-- 웨이브의 마지막(웨이브 크기번째) 몬스터: 정예 스테이지 = 정예(이름표), 보스 스테이지 마지막 웨이브 = 보스(1.5배)
		if self:IsEliteStage() and self._T.waveSpawned >= (self._T.waveSize or 1) then
			if self._T.eliteOf == nil then self._T.eliteOf = {} end
			if self._T.bossOf == nil then self._T.bossOf = {} end
			self._T.eliteOf[monster] = true
			if self.StageKind == "boss" then
				if (self._T.waveNo or 1) >= self.WavesPerStage then
					self._T.bossOf[monster] = true
					monster.TransformComponent.Scale = Vector3(self.BossScale, self.BossScale, 1)
				else
					-- 보스 스테이지의 앞 웨이브 마지막 몬스터는 일반
					self._T.eliteOf[monster] = nil
				end
			else
				self:AssignElitePrefix(monster, info)
			end
		end
		local mc = monster:GetComponent("script.TowerMonster")
		if mc ~= nil then
			mc.MoveRUID = info.move or ""
			mc.AttackRange = info.range or 1
			mc:ApplyLook(info.stand, info.attack, info.hit, info.die, info.hitSound, info.dieSound)
			mc.SpeedMul = 1 + (_UtilLogic:RandomDouble() * 2 - 1) * self.WalkSpeedRand / 100
			mc.SlotJitter = (_UtilLogic:RandomDouble() * 2 - 1) * self.SlotJitter
		end
		return monster
	end

	@ExecSpace("ServerOnly")
	method void FillQueue(table info)
		-- 남은 웨이브 몬스터를 화면에 채운다 (맨 앞 제외 최대 QueueShowMax마리). 오른쪽에서 몰려와 각자 자리로.
		local queue = self._T.queue or {}
		self._T.queue = queue
		local limit = math.min(self._T.waveSize or 0, self._T.released or (self._T.waveSize or 0))
		while #queue < self.QueueShowMax and (self._T.waveSpawned or 0) < limit do
			local idx = (self._T.waveSpawned or 0) + 1
			-- 화면 밖에서, 가장 뒤에 오는 몬스터보다 조금씩 더 뒤에서 출발 (한꺼번에 오지 않게)
			local x = self.MonsterPos.x + self.SpawnOffsetX
			local tail = x - self.SpawnSpacing
			local all = { self._T.monster }
			for _, q in ipairs(queue) do table.insert(all, q) end
			for _, q in ipairs(all) do
				if isvalid(q) and q.TransformComponent ~= nil then tail = math.max(tail, q.TransformComponent.Position.x) end
			end
			x = math.max(x, tail + self.SpawnSpacing + _UtilLogic:RandomDouble() * self.SpawnSpacingRand)
			local mi = self:PickWaveInfo(info, idx)
			local m = self:SpawnWaveMonster(mi, x)
			if m == nil then break end
			local mc = m:GetComponent("script.TowerMonster")
			if mc ~= nil then
				mc.IsQueued = true
				local qhp = self:MonsterBaseHp(mi) * self:RankHpMul(m)
				mc.MaxHp = qhp
				mc.Hp = qhp
				mc.IsRanged = self:IsRangedSlot(mi, idx)
				mc.AtkTimer = -1
			end
			local sprite = m.SpriteRendererComponent
			if isvalid(sprite) then sprite.OrderInLayer = 1 end
			table.insert(queue, m)
		end
		self:LayoutWave()
	end

	@ExecSpace("ServerOnly")
	method void ReleaseWaveGroup()
		-- 다음 묶음의 몬스터를 출전 가능하게 한다 (다음 묶음 시간도 다시 잰다).
		local groups = self._T.groups or {}
		if (self._T.groupIdx or 1) >= #groups then return end
		self._T.groupIdx = (self._T.groupIdx or 1) + 1
		self._T.released = (self._T.released or 0) + groups[self._T.groupIdx]
		self._T.nextGroupAt = _UtilLogic.ElapsedSeconds + self.WaveGroupInterval
		log("[VRF] wave group " .. tostring(self._T.groupIdx) .. "/" .. tostring(#groups) .. " released=" .. tostring(self._T.released))
	end

	@ExecSpace("ServerOnly")
	method table PickFloorInfo(table fallback)
		-- 지금 층의 몬스터 목록(FloorTable MonsterIds) 중 하나를 무작위로 고른다. 데이터가 없으면 fallback.
		local floors = self._T.floors
		if floors == nil or #floors == 0 then return fallback end
		local f = floors[math.min(self.Floor, #floors)]
		local pool = f.pool or {}
		if #pool == 0 then return fallback end
		local id = pool[_UtilLogic:RandomIntegerRange(1, #pool)]
		return self._T.monsterById[id] or fallback
	end

	@ExecSpace("ServerOnly")
	method table PickWaveInfo(table fallback, integer idx)
		-- 보스 개편 B2: 웨이브 idx번째 몬스터. 보스 스테이지 마지막 웨이브 마지막 1마리 = 층 FieldBossId (보스전 = BossTable MonsterId), 나머지는 층 몬스터 무작위.
		local lastOfBoss = self.StageKind == "boss" and (self._T.waveNo or 1) >= self.WavesPerStage and idx >= (self._T.waveSize or 1)
		if lastOfBoss then
			local id = ""
			if self.RunMode == "boss" and self._T.bossRow ~= nil then
				id = self._T.bossRow.monsterId
			else
				local floors = self._T.floors or {}
				local f = floors[math.min(self.Floor, #floors)]
				if f ~= nil then id = f.fieldBoss or "" end
			end
			local bi = id ~= "" and self._T.monsterById[id] or nil
			if bi ~= nil then
				self._T.fieldBossId = id
				log("[VRF] field boss id=" .. id .. " name=" .. tostring(bi.name) .. " floor=" .. tostring(self.Floor) .. " mode=" .. self.RunMode)
				return bi
			end
			if id ~= "" then log_warning("[VRF] field boss id not in MonsterTable id=" .. id) end
		end
		return self:PickFloorInfo(fallback)
	end

	@ExecSpace("ServerOnly")
	method boolean IsRangedSlot(table info, integer idx)
		-- 웨이브 idx번째 몬스터가 원거리인지: 몬스터 데이터가 원거리면 항상, 아니면 웨이브 뒤쪽 RangedRatio 비율 (첫 마리는 근거리).
		if info.ranged then return true end
		local size = self._T.waveSize or 1
		if size < 2 or idx <= 1 then return false end
		local count = math.floor(size * self.RangedRatio + 0.5)
		return idx > size - count
	end

	@ExecSpace("ServerOnly")
	method void LayoutWave()
		-- 자리 배치: 몬스터마다 자기 사거리 칸(1·2·3)에 선다. 같은 칸은 MeleeGap 간격으로 조금씩 떨어져 서도 판정은 같은 칸.
		-- 대기열 순서는 가까운 칸부터 (다음 맨 앞 후보 순).
		local cells = { {}, {}, {} }
		local qcells = { {}, {}, {} }
		local front = self._T.monster
		local fc = isvalid(front) and front:GetComponent("script.TowerMonster") or nil
		if fc ~= nil and not fc.IsDead then table.insert(cells[self:MonRange(fc)], front) end
		for _, q in ipairs(self._T.queue or {}) do
			local qc = isvalid(q) and q:GetComponent("script.TowerMonster") or nil
			if qc ~= nil and not qc.IsDead then
				local r = self:MonRange(qc)
				table.insert(cells[r], q)
				table.insert(qcells[r], q)
			end
		end
		local queue = {}
		for r = 1, 3 do
			for _, q in ipairs(qcells[r]) do table.insert(queue, q) end
		end
		self._T.queue = queue
		for r = 1, 3 do
			for k, e in ipairs(cells[r]) do
				local c = e:GetComponent("script.TowerMonster")
				local x = self:CellX(r) + self.MeleeGap * (k - 1)
				if k > 1 then x = x + c.SlotJitter end
				-- 닿지 않아 1칸으로 당겨진 맨 앞 몬스터는 그 자리에 둔다
				if e == front and c.MoveTargetX < x - 0.01 and self:CellAt(c.MoveTargetX) < r then x = c.MoveTargetX end
				if math.abs(c.MoveTargetX - x) > 0.01 or (not c.Moving and math.abs(e.TransformComponent.Position.x - x) > 0.01) then c:WalkTo(x, self.MonsterWalkSpeed * c.SpeedMul) end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void TickQueueAttacks(number delta)
		-- 맨 앞이 아닌 몬스터: 자리에 도착하면 첫 공격은 간격의 50~120% 뒤(엇갈리게), 그다음은 공격 간격마다.
		local list = {}
		for _, q in ipairs(self._T.queue or {}) do table.insert(list, q) end
		local interval = (self._T.monsterInterval or self.MonsterAttackInterval) * (1 + self:Bonus("MonSlow") / 100)
		for _, q in ipairs(list) do
			if self.RunState ~= "FIGHT" then return end
			local mc = isvalid(q) and q:GetComponent("script.TowerMonster") or nil
			if mc ~= nil and not mc.IsDead and mc.IsQueued and not mc.Moving and _UtilLogic.ElapsedSeconds >= mc.StunUntil then
				if mc.AtkTimer < 0 then
					mc.AtkTimer = interval * (0.5 + _UtilLogic:RandomDouble() * 0.7)
				else
					mc.AtkTimer = mc.AtkTimer - delta / mc:SlowMul()
					if mc.AtkTimer <= 0 then
						mc.AtkTimer = interval
						self:DoMonsterAttack(q, false)
					end
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void DoMonsterAttack(Entity m, boolean front)
		-- 몬스터 공격 1회: 암흑(빗나감)·각인 회피·피격 무효 판정 후 방어력·피해 감소를 적용해 플레이어를 때린다.
		if not isvalid(m) or not isvalid(self._T.player) then return end
		local mc = m:GetComponent("script.TowerMonster")
		if mc == nil or mc.IsDead then return end
		-- 2인 편성: 쓰러지지 않은 캐릭터 중 위협이 높은 쪽을 노린다
		local range = self:MonRange(mc)
		local player = self:PickTarget(range)
		if not isvalid(player) then return end
		local toComp = self:IsCompanion(player)
		local missUid = self._T.player.PlayerComponent.UserId
		-- 히어로 디버프 '암흑' 등: 몬스터가 공격 동작을 하지만 빗나간다 (MISS)
		local blind = 0
		if self:IsHeroRun() then
			for _, h in ipairs(self:Heroes()) do
				local v = 0
				if front then v = h:MissChance() else v = h:QueuedMissChance(m) end
				if v > blind then blind = v end
			end
		end
		-- 전투 개편: 디버프 빗나감 상한 75%, 회피 상한 50%, 둘을 합친 빗나감도 75%를 넘지 않게
		local cmc = self:CM()
		blind = math.min(cmc.missTotalCap, blind)
		local evadeChance = math.min(cmc.evadeCap, self:Bonus("Evade") + self:SlotMileDelta(player, "Evade"))
		if blind > 0 and blind < 100 then evadeChance = math.min(evadeChance, math.max(0, (cmc.missTotalCap - blind) / (1 - blind / 100))) end
		if blind > 0 and _UtilLogic:RandomDouble() * 100 < blind then
			mc:SetClip(mc.AttackRUID, mc.AttackAnimTime)
			local pc = self:GetPlayerAttack()
			if pc ~= nil then pc:ShowMiss(player, missUid) end
			log("[VRF] monster miss by debuff chance=" .. tostring(blind))
		-- 각인 '회피': 확률로 몬스터 공격을 피한다
		elseif _UtilLogic:RandomDouble() * 100 < evadeChance then
			local pc = self:GetPlayerAttack()
			if pc ~= nil then pc:ShowMiss(player, missUid) end
			-- 돌파 '반격 자세': 공격한 몬스터에게 반격
			local counter = self:Bonus("EvadeCounter")
			if counter > 0 then
				local dmg = math.floor(self.PlayerAtk * counter / 100 + 0.5)
				if front then self:ApplyMonsterDamage(dmg) else self:ApplySplashDamage(m, dmg, false, 0) end
			end
		elseif _UtilLogic:RandomDouble() * 100 < self:Bonus("HitNullify") then
			-- 돌파 '피격 무효'
			local pc = self:GetPlayerAttack()
			if pc ~= nil then pc:ShowMiss(player, missUid) end
		else
			-- 방어력: 받는 피해 = 공격력 × (1 - 방어 / (방어 + 상수)), 치명타(치명적인)는 TowerMonster가 판정
			-- 각인 '철벽': 체력 50% 이하일 때 방어력 증가
			local def = self:ActorDefense(player)
			if self:ActorHp(player) < self:ActorMaxHp(player) * self.BulwarkHpRatio then def = def * (1 + self:Bonus("Bulwark") / 100) end
			-- 전투 개편: 몬스터 마법 공격은 방어력의 일부(MagicDefRatio 50%)만 적용
			local minfo = self:InfoOfTarget(m)
			if minfo ~= nil and minfo.atkType == "M" then def = def * cmc.magicDef end
			local reduce = def / (def + self.DefConstant)
			-- 직업 스킬 '철벽 자세': 받는 피해 감소
			local reduceSum = self:Bonus("DmgReduce") + self:SlotMileDelta(player, "DmgReduce")
			if self:ActorHp(player) >= self:ActorMaxHp(player) * 0.5 then reduceSum = reduceSum + self:Bonus("HighHpReduce") end
			if self:ActorHp(player) <= self:ActorMaxHp(player) * 0.3 then reduceSum = reduceSum + self:Bonus("LowHpReduce") end
			if front and self.MonsterElite then reduceSum = reduceSum + self:Bonus("EliteReduce") + self:SlotMileDelta(player, "EliteReduce") end
			-- 직업 공용 전투(바이퍼 에너지·트랜스폼 등): 그 캐릭터만 받는 피해 감소 (합계 60% 상한)
			local jc = player:GetComponent("script.JobCombat")
			if jc ~= nil and jc.Active and self:HeroOf(player) == jc then reduceSum = math.min(math.max(reduceSum, 60), reduceSum + jc:SelfReduce()) end
			local cut = math.max(0, 1 - reduceSum / 100)
			-- 악마의 거래 대가: 받는 피해 증가
			cut = cut * (1 + (self:Bonus("DmgTaken") + self:GoddessBonus(player, "DmgTaken")) / 100)
			-- 이 층 심볼: 받는 피해 감소
			cut = cut * math.max(0, 1 - (self._T.symCut or 0) / 100)
			local crit = 0
			if front then crit = self._T.monsterCrit or 0 end
			local dmg = math.max(1, math.floor(self.MonsterAtk * mc:AtkMul() * (1 - reduce) * cut + 0.5))
			if toComp then
				-- 동료는 엔진 피격 판정 대신 공격 동작 뒤 직접 피해 (치명타는 여기서 판정)
				mc:SetClip(mc.AttackRUID, mc.AttackAnimTime)
				if crit > 0 and _UtilLogic:RandomDouble() * 100 < crit then dmg = math.floor(dmg * self.MonsterCritDmg / 100 + 0.5) end
				local d = dmg
				local victim = player
				_TimerService:SetTimerOnce(function() self:ApplyMateDamage(victim, d) end, self.CompanionHitDelay)
			else
				mc:DoAttack(player, dmg, crit, self.MonsterCritDmg)
			end
		end
	end


	@ExecSpace("ServerOnly")
	method table SplashTargets(integer n)
		-- 범위 스킬 추가 대상: 맨 앞 뒤로 줄 선 몬스터 중 가까운 순서로 n마리 (자리 근처까지 걸어온 몬스터만).
		local list = {}
		if n <= 0 then return list end
		local reach = self.MonsterPos.x + self.SplashReach
		local cands = {}
		for _, q in ipairs(self._T.queue or {}) do
			if isvalid(q) and q.TransformComponent ~= nil then
				local mc = q:GetComponent("script.TowerMonster")
				if mc ~= nil and not mc.IsDead and q.TransformComponent.Position.x <= reach then table.insert(cands, q) end
			end
		end
		table.sort(cands, function(a, b) return a.TransformComponent.Position.x < b.TransformComponent.Position.x end)
		for k = 1, math.min(n, #cands) do table.insert(list, cands[k]) end
		return list
	end

	@ExecSpace("ServerOnly")
	method number RelicDamageBonus(Entity m)
		-- 유물 피해 증가 합(%): 2·3칸/1칸 몬스터, 상태 이상 적, 지금 피해의 종류(단일·광역·지속·속성, _T.dmgCtx).
		local total = 0
		if isvalid(m) then
			if self:CellAt(m.TransformComponent.WorldPosition.x) >= 2 then total = total + self:Bonus("FarDmg") else total = total + self:Bonus("NearDmg") end
			local mc = m:GetComponent("script.TowerMonster")
			local status = (m == self._T.monster and (self:IsStunned() or self._T.burn ~= nil or _UtilLogic.ElapsedSeconds < (self._T.vulnUntil or 0)))
				or (mc ~= nil and (_UtilLogic.ElapsedSeconds < mc.SlowUntil or _UtilLogic.ElapsedSeconds < mc.StunUntil or _UtilLogic.ElapsedSeconds < mc.AtkDownUntil))
			if status then total = total + self:Bonus("StatusDmg") end
		end
		local ctx = self._T.dmgCtx
		if ctx ~= nil then
			if ctx.aoe then total = total + self:Bonus("AoeDmg") elseif ctx.single then total = total + self:Bonus("SingleDmg") end
			if ctx.dot then total = total + self:Bonus("DotDmg") end
			if ctx.elem then total = total + self:Bonus("ElemDmg") end
		end
		return total
	end

	@ExecSpace("ServerOnly")
	method table DmgCtxOf(table r)
		-- 스킬 시전 결과의 피해 종류: 대상 2 이상 = 광역, 아니면 단일. 스킬 표 Element가 있으면 속성.
		local targets = r.targets
		if targets == nil and r.sk ~= nil and r.sk.proc ~= nil then targets = r.sk.proc.targets end
		local aoe = (targets or 1) > 1
		local id = r.sk ~= nil and r.sk.id or r.id
		local base = id ~= nil and self._T.skillById[id] or nil
		local elem = base ~= nil and (base.element or "") ~= "" and base.element ~= "출혈"
		-- elem(참/거짓)은 유물 '속성 피해' 대상 여부(기존 의미 유지), elemId는 전투 개편 속성 Id
		local elemId = "None"
		if base ~= nil and (base.elemId or "") ~= "" then elemId = base.elemId end
		return { aoe = aoe, single = not aoe, elem = elem, elemId = elemId, dot = false }
	end

	@ExecSpace("ServerOnly")
	method void ApplySplashDamage(Entity e, integer dmg, boolean crit, number yOff)
		-- 대기열 몬스터가 범위 스킬에 맞음: 자기 체력 감소·피격 모션·숫자, 0이 되면 처치.
		if not isvalid(e) then return end
		local mc = e:GetComponent("script.TowerMonster")
		if mc == nil or mc.IsDead then return end
		-- 그사이 맨 앞으로 나온 몬스터면 매니저 체력으로 피해
		if not mc.IsQueued then
			if e == self._T.monster and self.RunState == "FIGHT" then
				local pc0 = self:GetPlayerAttack()
				self._T.cmTarget = e
				local d0 = self:FinalDouble(dmg)
				self._T.cmTarget = nil
				if pc0 ~= nil then pc0:ShowProcDamageAt(e, d0, crit, yOff) end
				self:ApplyRolledDamage(d0)
			end
			return
		end
		-- 유물: 대기열 몬스터가 맞는 범위 피해는 광역 (칸·상태 이상 보너스 포함)
		local relicPct = self:RelicDamageBonus(e)
		local ctx = self._T.dmgCtx
		if ctx == nil or not ctx.aoe then relicPct = relicPct + self:Bonus("AoeDmg") end
		if relicPct ~= 0 then dmg = math.max(1, math.floor(dmg * (1 + relicPct / 100) + 0.5)) end
		-- 각인 핵심 '섬멸': 숫자를 띄우기 전에 판정 (전투 개편: 이 대기열 몬스터의 속성 상성으로 CombatMul)
		self._T.cmTarget = e
		dmg = self:FinalDouble(dmg)
		self._T.cmTarget = nil
		if self._T.probe ~= nil then self._T.probe.dealt = self._T.probe.dealt + math.max(0, math.min(mc.Hp, dmg)) end
		mc.Hp = mc.Hp - dmg
		local pc = self:GetPlayerAttack()
		if pc ~= nil then pc:ShowProcDamageAt(e, dmg, crit, yOff) end
		if mc.Hp > 0 then
			mc:PlaySfx(mc.HitSoundRUID)
			if mc.AnimTimer <= 0 then mc:SetClip(mc.HitRUID, mc.HitAnimTime) end
			return
		end
		self:KillQueued(e)
	end

	@ExecSpace("ServerOnly")
	method void KillQueued(Entity e)
		-- 대기열 몬스터 처치: 대기열에서 빼고 사망 연출·보상, 웨이브 남은 수 감소, 빈자리는 새 몬스터로 채운다.
		local queue = self._T.queue or {}
		for i = #queue, 1, -1 do
			if queue[i] == e then table.remove(queue, i) end
		end
		-- 보스 개편 B6: 보스 소환물은 웨이브 수·보상과 무관 (사망 연출만)
		if self._T.summonOf ~= nil and self._T.summonOf[e] then
			self._T.summonOf[e] = nil
			local smc = e:GetComponent("script.TowerMonster")
			local sdie = 0
			if smc ~= nil then sdie = smc:PlayDie() end
			local scorpse = e
			_TimerService:SetTimerOnce(function()
				if isvalid(scorpse) then scorpse:Destroy() end
			end, math.max(0.1, sdie))
			self:LayoutWave()
			log("[VRF] boss summon killed alive=" .. tostring(self:BossSummonAlive()))
			return
		end
		local mc = e:GetComponent("script.TowerMonster")
		local dieDur = 0
		if mc ~= nil then dieDur = mc:PlayDie() end
		local corpse = e
		_TimerService:SetTimerOnce(function()
			if isvalid(corpse) then corpse:Destroy() end
		end, math.max(0.1, dieDur))
		self._T.waveLeft = math.max(0, (self._T.waveLeft or 1) - 1)
		local elite = self.MonsterElite
		local qElite = self._T.eliteOf ~= nil and self._T.eliteOf[e] == true
		self.MonsterElite = qElite
		self:DropSkillStone(self._T.bossOf ~= nil and self._T.bossOf[e] == true, qElite)
		self:GiveKillReward()
		self:DropFeathers(qElite)
		self:DropScrolls(qElite)
		if qElite and not (self._T.bossOf ~= nil and self._T.bossOf[e] == true) then self:DropCubes("elite") end
		self.MonsterElite = elite
		if self._T.waveInfo ~= nil then self:FillQueue(self._T.waveInfo) end
		log("[VRF] splash kill wave left=" .. tostring(self._T.waveLeft) .. " queue=" .. tostring(#queue))
	end

	@ExecSpace("ServerOnly")
	method void DoLevelUp(integer levels, integer extraPicks)
		-- 4단계부터 호출 없음 (6단계 삭제)
		-- 레벨업: 레벨·능력치 상승, 체력 최대 회복, 레벨마다 스킬 카드 1장 (+각인 확률로 1장, +강화 몬스터 추가 카드).
		if levels <= 0 then return end
		for _ = 1, levels do
			self.Level = self.Level + 1
			if self:HasBreakLeft() then
				self.PendingPicks = self.PendingPicks + 1
				if _UtilLogic:RandomDouble() * 100 < self:Bonus("ExtraPick") then self.PendingPicks = self.PendingPicks + 1 end
			end
		end
		if extraPicks > 0 and self:HasBreakLeft() then self.PendingPicks = self.PendingPicks + extraPicks end
		self:RecalcStats()
		self:FullHealParty()
		local player = self._T.player
		if isvalid(player) then
			_EffectService:PlayEffectAttached(self.LevelUpEffectRUID, player, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false)
			if self.LevelUpSoundRUID ~= "" and isvalid(player.PlayerComponent) then
				_SoundService:PlaySound(self.LevelUpSoundRUID, self.LevelUpSoundVolume, player.PlayerComponent.UserId)
			end
		end
		log("[VRF] level up -> Lv" .. tostring(self.Level) .. " picks=" .. tostring(self.PendingPicks) .. " atk=" .. tostring(self.PlayerAtk) .. " maxHp=" .. tostring(self.PlayerMaxHp))
	end

	@ExecSpace("ServerOnly")
	method void DestroyMonster()
		-- 현재 몬스터 엔티티를 제거한다.
		local monster = self._T.monster
		if isvalid(monster) then monster:Destroy() end
		self._T.monster = nil
		for _, q in ipairs(self._T.queue or {}) do
			if isvalid(q) then q:Destroy() end
		end
		self._T.queue = {}
		self.MonsterName = ""
		self.MonsterLabel = ""
		self.MonsterElite = false
	end

	@ExecSpace("ServerOnly")
	method void GiveKillReward()
		-- 처치 보상: 메소 (강화 몬스터는 3배). 경험치는 없다 (레벨업은 스테이지 통과 때).
		local rewardMul = 1
		if self.MonsterElite then rewardMul = self.EliteRewardMul end
		local mesoRate = self.MesoMinRate + _UtilLogic:RandomDouble() * (self.MesoMaxRate - self.MesoMinRate)
		-- 이 층 심볼: 메소·경험치 증가
		local symGain = 1 + (self._T.symGain or 0) / 100
		local meso = math.max(1, math.floor(self:KillMeso() * rewardMul * mesoRate * (1 + self:Bonus("MesoPct") / 100) * symGain + 0.5))
		-- 각인 핵심 '대박': 확률로 처치 메소 3배
		local jackpot = self:Bonus("MesoJackpot")
		if jackpot > 0 and _UtilLogic:RandomDouble() * 100 < jackpot then
			meso = meso * 3
			log("[VRF] talent meso jackpot meso=" .. tostring(meso))
		end
		self.Meso = self.Meso + meso
		self.RunMeso = self.RunMeso + meso
		-- 클라이언트 메소 드롭 연출 신호 (KillSeq 변화 감지)
		self.LastKillMeso = meso
		self.KillSeq = self.KillSeq + 1
		-- 하단 바 = 웨이브 진행 (처치마다 1칸, BeginWave가 ExpToNext를 웨이브 크기로 맞춤)
		if self.StageLevelUp then self.Exp = math.min(self.ExpToNext, self.Exp + 1) end
		-- 경험치 없음: 레벨업은 스테이지를 통과할 때만 (DoLevelUp)
		-- 각인 '재생': 처치 시 최대 체력의 일부 회복
		local killHeal = math.floor(self.PlayerMaxHp * self:Bonus("KillHeal") / 100 + 0.5)
		if killHeal > 0 and self.PlayerHp < self.PlayerMaxHp then
			self.PlayerHp = math.min(self.PlayerMaxHp, self.PlayerHp + killHeal)
			local pc = self:GetPlayerAttack()
			if pc ~= nil then pc:ShowHeal(killHeal) end
		end
		log("[VRF] reward meso+" .. tostring(meso) .. " total meso=" .. tostring(self.Meso) .. " picks=" .. tostring(self.PendingPicks))
	end

	-- ===== 전투 능력치 개편 (Docs/Combat/Stat-Redesign-Spec.md): 물리/마법 · 속성 약점/반감/무효 · 명중 =====

	method string ElemIdOf(string s)
		-- 속성 표기(Id 또는 한글)를 속성 Id로 바꾼다. 빈칸·무·출혈 = None (출혈은 속성이 아니라 지속 피해).
		if s == nil or s == "" then return "None" end
		local map = { None = "None", Fire = "Fire", Ice = "Ice", Lightning = "Lightning", Poison = "Poison", Holy = "Holy", Dark = "Dark",
			["무"] = "None", ["무속성"] = "None", ["출혈"] = "None", ["불"] = "Fire", ["얼음"] = "Ice", ["번개"] = "Lightning", ["전기"] = "Lightning",
			["독"] = "Poison", ["성"] = "Holy", ["신성"] = "Holy", ["어둠"] = "Dark", ["암흑"] = "Dark" }
		return map[s] or "None"
	end

	method string DmgTypeOf(string s)
		-- 공격 타입 표기를 "P"(물리)/"M"(마법)으로. 빈칸이나 모르는 값은 "" (= 상위 기본값을 따른다).
		if s == "M" or s == "m" or s == "마법" or s == "Magic" then return "M" end
		if s == "P" or s == "p" or s == "물리" or s == "Physical" then return "P" end
		return ""
	end

	method table ParseElemTable(string s)
		-- 몬스터 속성 상성 "Fire:W|Ice:R|Poison:N" → { Fire = "W", Ice = "R", Poison = "N" } (W 약점, R 반감, N 무효).
		local t = {}
		if s == nil or s == "" then return t end
		for part in string.gmatch(s, "[^|]+") do
			local e, lv = string.match(part, "^%s*([^:]+):([WRN])%s*$")
			if e ~= nil then t[self:ElemIdOf(e)] = lv end
		end
		return t
	end

	method string ElemTableText(table t)
		-- 로그용: 속성 상성 표를 "Fire:W|Ice:R" 글자로.
		if t == nil then return "" end
		local parts = {}
		for _, id in ipairs({ "Fire", "Ice", "Lightning", "Poison", "Holy", "Dark" }) do
			if t[id] ~= nil then table.insert(parts, id .. ":" .. t[id]) end
		end
		return table.concat(parts, "|")
	end

	@ExecSpace("ServerOnly")
	method void LoadCombatJobs()
		-- 직업 기본 공격 타입·기본 속성 (CharJobTable.AtkType / Element). 표에 없으면 비숍 = 마법·성, 나머지 = 물리·무속성.
		self._T.jobCombat = { Hero = { atk = "P", elem = "None" }, Bishop = { atk = "M", elem = "Holy" }, NightLord = { atk = "P", elem = "None" },
			Bowmaster = { atk = "P", elem = "None" }, Viper = { atk = "P", elem = "None" } }
		local ds = _DataService:GetTable("CharJobTable")
		if ds ~= nil then
			for i = 1, ds:GetRowCount() do
				local id = ds:GetCell(i, "JobId")
				if id ~= nil and id ~= "" then
					local cur = self._T.jobCombat[id] or { atk = "P", elem = "None" }
					local a = self:DmgTypeOf(ds:GetCell(i, "AtkType") or "")
					local e = ds:GetCell(i, "Element") or ""
					if a ~= "" then cur.atk = a end
					if e ~= "" then cur.elem = self:ElemIdOf(e) end
					self._T.jobCombat[id] = cur
				end
			end
		end
		log("[VRF] combat jobs Bishop=" .. self._T.jobCombat.Bishop.atk .. "/" .. self._T.jobCombat.Bishop.elem .. " Hero=" .. self._T.jobCombat.Hero.atk .. "/" .. self._T.jobCombat.Hero.elem)
	end

	@ExecSpace("ServerOnly")
	method table CM()
		-- 전투 개편 설정값 (RunConfig가 없으면 기본값).
		if self._T.cm == nil then
			self._T.cm = { weak = 1.5, resist = 0.5, immune = 0.1, magicDef = 0.5, missCap = 60, evadeCap = 50, missTotalCap = 75, magicNeverMiss = true }
		end
		return self._T.cm
	end

	@ExecSpace("ServerOnly")
	method string ActorJobId(Entity actor)
		-- 구성원의 지금 직업 Id (편성 직업 전투 컴포넌트 기준). 모르면 "".
		local h = self:HeroOf(actor)
		if h == nil then return "" end
		return h.JobId or ""
	end

	@ExecSpace("ServerOnly")
	method table HitProfile(Entity actor, string skillId)
		-- 타격 하나의 공격 타입·속성: 스킬 표 값(DmgType·Element)이 있으면 그것, 없으면 직업 기본값.
		-- baseAtk = 구성원 기본 공격 타입 (ActorHitDamage가 방어를 깎을 때 쓴 타입).
		local job = isvalid(actor) and self:ActorJobId(actor) or ""
		return self:HitProfileFor(job, skillId)
	end

	@ExecSpace("ServerOnly")
	method table HitProfileFor(string job, string skillId)
		-- 직업 Id 기준 타격 공격 타입·속성 (HitProfile 본체, 테스트에서도 직접 부른다).
		local jd = (self._T.jobCombat or {})[job] or { atk = "P", elem = "None" }
		local atk, elem = jd.atk, jd.elem
		local sk = (skillId ~= nil and skillId ~= "" and self._T.skillById ~= nil) and self._T.skillById[skillId] or nil
		if sk ~= nil then
			if (sk.dmgType or "") ~= "" then atk = sk.dmgType end
			if (sk.elemId or "") ~= "" then elem = sk.elemId end
		end
		return { atk = atk, elem = elem, baseAtk = jd.atk, job = job }
	end

	@ExecSpace("ServerOnly")
	method number DefFactor(string atkType, Entity actor)
		-- 몬스터 방어에 의한 피해 비율 = 1 - 방어/(방어+상수). 마법이면 마법 방어, 아니면 물리 방어. 방어 무시(DefIgnore)는 둘 다 적용.
		local def = self._T.monsterDefP or self._T.monsterDef or 0
		if atkType == "M" then def = self._T.monsterDefM or 0 end
		local ignore = self:Bonus("DefIgnore") + (self._T.castDefIgnore or 0)
		if isvalid(actor) then ignore = ignore + self:SlotMileDelta(actor, "DefIgnore") end
		def = def * math.max(0, 1 - ignore / 100)
		return 1 - def / (def + self.DefConstant)
	end

	@ExecSpace("ServerOnly")
	method table SetHitSrc(Entity actor, string skillId, boolean isDot)
		-- 이제부터 FinalDouble로 들어오는 타격의 주인(구성원)·스킬. 같은 호출 흐름 안에서만 쓰고 ClearHitSrc(이전 값)로 되돌린다.
		local prev = self._T.hitSrc
		self._T.hitSrc = { actor = actor, skill = skillId or "", dot = isDot == true }
		return prev
	end

	@ExecSpace("ServerOnly")
	method table EnsureHitSrc(Entity actor)
		-- 같은 구성원의 타격 정보가 이미 있으면 그대로(스킬 유지), 없으면 기본 공격으로 정한다. 이전 값을 돌려준다.
		local prev = self._T.hitSrc
		if prev == nil or prev.actor ~= actor then self._T.hitSrc = { actor = actor, skill = "", dot = false } end
		return prev
	end

	@ExecSpace("ServerOnly")
	method table SwapDmgCtx(table ctx)
		-- 피해 종류(dmgCtx)를 바꾸고 이전 값을 돌려준다 (기본 공격처럼 다른 타격의 종류를 물려받으면 안 되는 경로용).
		local prev = self._T.dmgCtx
		self._T.dmgCtx = ctx
		return prev
	end

	@ExecSpace("ServerOnly")
	method void ClearHitSrc(table prev)
		-- 타격 주인 정보를 SetHitSrc 이전 값으로 되돌린다 (다른 구성원 타격에 섞이지 않게, 겹쳐 불러도 안전).
		self._T.hitSrc = prev
	end

	@ExecSpace("ServerOnly")
	method table InfoOfTarget(Entity target)
		-- 몬스터 정보 행(속성 상성 등): 맨 앞 몬스터 = 지금 정보, 대기열 몬스터 = 그 몬스터 정보.
		if isvalid(target) and target ~= self._T.monster and self._T.infoOf ~= nil and self._T.infoOf[target] ~= nil then return self._T.infoOf[target] end
		return self._T.monInfo
	end

	@ExecSpace("ServerOnly")
	method number CombatMul(Entity target)
		-- 새 배율 하나: 속성(약점 ×1.5 · 반감 ×0.5 · 무효 ×0.1) × 약점 추가 피해(WeakDmg) × 스킬 공격 타입 방어 보정.
		-- 타격 주인을 모르면(가시·폭발 등) 무속성·보정 없음 = 1.
		local cm = self:CM()
		local src = self._T.hitSrc
		local ctx = self._T.dmgCtx
		local elem, atk, base = "None", "", ""
		-- 지속 여부·속성은 타격 주인(hitSrc)만 본다. dmgCtx(유물 피해 종류)는 다른 타격에 남아 있을 수 있어 배율에 쓰지 않는다.
		local isDot = src ~= nil and src.dot == true
		if src ~= nil and (src.job ~= nil or isvalid(src.actor)) then
			local p = nil
			if src.job ~= nil then p = self:HitProfileFor(src.job, src.skill) else p = self:HitProfile(src.actor, src.skill) end
			elem, atk, base = p.elem, p.atk, p.baseAtk
		end
		-- 지속 피해가 정한 속성 (예: 화상 = Fire)
		if src ~= nil and (src.elemId or "") ~= "" then elem = src.elemId end
		local mul = 1
		local res = ""
		local info = self:InfoOfTarget(target)
		if elem ~= "None" and info ~= nil and info.elem ~= nil then
			res = info.elem[elem] or ""
			if res == "R" and self:Bonus("ElemPierce") > 0 and _UtilLogic:RandomDouble() * 100 < self:Bonus("ElemPierce") then res = "" end
			if res == "W" then mul = cm.weak * (1 + self:Bonus("WeakDmg") / 100)
			elseif res == "R" then mul = cm.resist
			elseif res == "N" then mul = cm.immune
			end
		end
		-- 기본 피해는 구성원 기본 타입 방어로 이미 깎였다: 이 타격 타입이 다르면 비율만 바꾼다 (지속 피해는 방어 없음)
		if not isDot and atk ~= "" and base ~= "" and atk ~= base and (target == nil or target == self._T.monster) then
			local actor = src ~= nil and src.actor or nil
			mul = mul * self:DefFactor(atk, actor) / math.max(0.01, self:DefFactor(base, actor))
		end
		-- 보스 개편 B3·B6: 보스가 받는 피해 배율 하나 (그로기 +50% · 졸개 생존 중 -60%), 맨 앞 보스에게만
		if self.MonsterBoss and (target == nil or target == self._T.monster) then
			local mech = self:GetMech()
			if mech ~= nil and mech:Active() then mul = mul * mech:DamageMul() end
		end
		self._T.lastHit = { res = res, elem = elem, atk = atk }
		if res ~= "" then
			self._T.elemLogN = (self._T.elemLogN or 0) + 1
			if self._T.elemLogN <= 12 then log("[VRF] elem hit elem=" .. elem .. " res=" .. res .. " mul=" .. string.format("%.2f", mul) .. " atk=" .. atk) end
			self:ShowElemMark(target, res, elem)
		end
		return mul
	end

	@ExecSpace("ServerOnly")
	method void ShowElemMark(Entity target, string res, string elem)
		-- 약점·반감·무효 표시: 숫자 옆 속성색(약점) / 회색(반감·무효) 빛 (같은 몬스터는 0.3초에 한 번).
		if not isvalid(target) then target = self._T.monster end
		if not isvalid(target) or not isvalid(self._T.player) then return end
		local now = _UtilLogic.ElapsedSeconds
		if self._T.markAt == nil then self._T.markAt = {} end
		if (self._T.markAt[target] or -1) > now - 0.3 then return end
		self._T.markAt[target] = now
		local pc = self:GetPlayerAttack()
		if pc ~= nil then pc:ShowElemMark(target, res, elem, self._T.player.PlayerComponent.UserId) end
	end

	@ExecSpace("ServerOnly")
	method number DebugCombatMul(string elemTable, string jobId, string skillId)
		-- 테스트용: 가짜 몬스터 속성표("Fire:W|Holy:R")와 직업·스킬로 CombatMul을 계산해 돌려준다 (원래 정보는 되돌림).
		local savedInfo = self._T.monInfo
		local savedSrc = self._T.hitSrc
		self._T.monInfo = { elem = self:ParseElemTable(elemTable) }
		self._T.hitSrc = { actor = nil, skill = skillId or "", dot = false, job = jobId }
		local m = self:CombatMul(nil)
		self._T.monInfo = savedInfo
		self._T.hitSrc = savedSrc
		log("[VRF] debug combatmul elem=" .. elemTable .. " job=" .. jobId .. " skill=" .. tostring(skillId) .. " mul=" .. string.format("%.2f", m))
		return m
	end

	@ExecSpace("ServerOnly")
	method number ActorAcc(Entity actor)
		-- 명중 = 자기 편성 칸 망토 명중 + 명중 효과 합계 (구성원별).
		return self:EquipStatFor("Cape", self:ActorSlotNo(actor)) + self:Bonus("Acc")
	end

	@ExecSpace("ServerOnly")
	method number ActorMissRate(Entity actor)
		-- 우리 기본 공격 빗나감 %: 마법 = 0 (빗나가지 않음), 물리 = clamp(몬스터 회피 - 자기 명중, 0, 상한 60).
		local cm = self:CM()
		local p = self:HitProfile(actor, "")
		if p.atk == "M" and cm.magicNeverMiss then return 0 end
		return math.max(0, math.min(cm.missCap, (self._T.monsterEvade or 0) - self:ActorAcc(actor)))
	end

	@ExecSpace("ServerOnly")
	method integer FinalDouble(integer damage)
		-- 각인 핵심 '섬멸': 확률로 최종 피해 2배. 피해 숫자를 띄우기 전에 불러 뜨는 숫자도 2배가 되게 한다.
		-- 전투 개편: 숫자를 띄우기 직전 관문이므로 속성·공격 타입 배율(CombatMul)도 여기서 한 번 곱한다.
		if damage > 0 then
			local cmul = self:CombatMul(self._T.cmTarget or self._T.monster)
			if cmul ~= 1 then damage = math.max(1, math.floor(damage * cmul + 0.5)) end
		end
		local chance = self:Bonus("FinalDouble")
		if damage > 0 and chance > 0 and _UtilLogic:RandomDouble() * 100 < chance then
			log("[VRF] talent final double dmg=" .. tostring(damage * 2))
			return damage * 2
		end
		return damage
	end

	@ExecSpace("ServerOnly")
	method void ApplyRolledDamage(integer damage)
		-- 이미 FinalDouble로 '섬멸'을 판정한 피해(숫자를 먼저 띄운 피해)를 다시 판정하지 않고 적용한다.
		self._T.preRolled = true
		self:ApplyMonsterDamage(damage)
		self._T.preRolled = nil
	end

	@ExecSpace("ServerOnly")
	method void ApplyMonsterDamage(integer damage)
		-- 플레이어 공격이 몬스터에 맞았을 때 HP를 깎고 처치를 판정한다.
		-- 숫자 없이 들어오는 피해(가시·폭발 등)만 여기서 '섬멸'을 판정한다 (숫자를 띄우는 피해는 FinalDouble → ApplyRolledDamage).
		local preRolled = self._T.preRolled == true
		self._T.preRolled = nil
		if self.RunState ~= "FIGHT" then return end
		-- 몬스터 약화·기절 중 받는 피해 증가
		local takenMul = 1
		if _UtilLogic.ElapsedSeconds < (self._T.vulnUntil or 0) then takenMul = takenMul + (self._T.vulnPct or 0) / 100 end
		if self:IsStunned() then takenMul = takenMul + (self:Bonus("StunDmg") + (self._T.stunVuln or 0)) / 100 end
		if self._T.burn ~= nil then takenMul = takenMul + self._T.burn.vuln / 100 end
		takenMul = takenMul + self:RelicDamageBonus(self._T.monster) / 100
		damage = math.floor(damage * takenMul + 0.5)
		-- 각인 핵심 '섬멸': 숫자를 띄우지 않은 피해만 여기서 판정
		if not preRolled then damage = self:FinalDouble(damage) end
		-- 각인 상태이상 루트: 지속 피해가 아닌 적중이면 확률로 화상
		local dctx = self._T.dmgCtx
		local srcDot = self._T.hitSrc ~= nil and self._T.hitSrc.dot == true
		if (dctx == nil or not dctx.dot) and not srcDot then self:TryTalentBurn(self._T.monster) end
		-- 처형: HP 20% 이하 몬스터는 확률로 즉시 처치
		if self.MonsterHp - damage > 0 and self.MonsterHp <= self.MonsterMaxHp * self.ExecuteHpRatio and self:RollSkill("Execute") then
			damage = math.ceil(self.MonsterHp)
			local monster = self._T.monster
			if isvalid(monster) then
				local wp = monster.TransformComponent.WorldPosition
				_EffectService:PlayEffect(self.ExecuteFxRUID, monster, Vector3(wp.x, wp.y + 0.4, wp.z), 0, Vector3(0.35, 0.35, 1), false)
			end
			log("[VRF] proc execute")
		end
		-- 보스 개편 B6: 보호막 게이지가 먼저 받는다 (게이지가 있는 동안 체력 피해 0)
		local bossMech = nil
		local hitElem = self._T.lastHit ~= nil and self._T.lastHit.elem or "None"
		if self.MonsterBoss then
			bossMech = self:GetMech()
			if bossMech ~= nil and not bossMech:Active() then bossMech = nil end
		end
		if bossMech ~= nil then damage = bossMech:Absorb(damage, hitElem) end
		local dealt = math.min(self.MonsterHp, damage)
		if self._T.probe ~= nil then self._T.probe.dealt = self._T.probe.dealt + dealt end
		self.MonsterHp = math.max(0, self.MonsterHp - damage)
		if bossMech ~= nil and dealt > 0 then bossMech:OnDamaged(math.floor(dealt), hitElem) end
		-- 각인 '흡혈': 준 피해의 일정 %를 항상 회복
		local drain = dealt * self:Bonus("LifestealPct") / 100
		if drain > 0 then self.PlayerHp = math.min(self.PlayerMaxHp, self.PlayerHp + drain * (1 + self:Bonus("HealRecv") / 100)) end
		-- 장신구 '헬라의 펜던트' 등: 착용자가 준 피해 비율만큼 회복 (타격자 구분 없이 파티 피해 기준)
		if dealt > 0 then self:AccessoryLifesteal(dealt) end
		-- 흡혈: 확률로 준 피해만큼 회복
		if dealt > 0 and self.PlayerHp < self.PlayerMaxHp and self:RollSkill("Lifesteal") then
			local heal = math.floor(dealt + 0.5)
			self.PlayerHp = math.min(self.PlayerMaxHp, self.PlayerHp + heal)
			local pc = self:GetPlayerAttack()
			if pc ~= nil then pc:ShowHeal(heal) end
			log("[VRF] proc lifesteal heal=" .. tostring(heal))
		end
		if self.MonsterHp > 0 then return end

		-- 게임 템포: 처치 후 잠깐(NextSpawnDelay) 뒤 다음 몬스터 (쓰러진 몬스터는 사망 애니메이션 1회 뒤 따로 제거)
		self.RunState = "CLEAR"
		self.StateTimer = self.NextSpawnDelay
		local monster = self._T.monster
		if isvalid(monster) then
			local dieDur = 0
			local mc = monster:GetComponent("script.TowerMonster")
			if mc ~= nil then dieDur = mc:PlayDie() end
			self._T.monster = nil
			local corpse = monster
			_TimerService:SetTimerOnce(function()
				if isvalid(corpse) then corpse:Destroy() end
			end, math.max(0.1, dieDur))
		end
		local bossKilled = self.MonsterElite
		self._T.waveLeft = math.max(0, (self._T.waveLeft or 1) - 1)
		-- 보스 개편: 보스를 잡으면 기믹·소환물 정리, 필드보스 첫 처치 기록(보스 탭 해금, 디버그 판 제외)
		if self.MonsterBoss then
			local mech = self:GetMech()
			if mech ~= nil then mech:End() end
			self:BossClearSummons()
			if self.RunMode ~= "boss" then
				local pb = self:GetBoss()
				if pb ~= nil and not self._T.debugRun then pb:MarkFieldKill(self.Floor) end
				log("[VRF] field boss killed floor=" .. tostring(self.Floor) .. " id=" .. tostring(self._T.fieldBossId) .. " debugRun=" .. tostring(self._T.debugRun == true))
			end
		end
		if self.RunMode == "boss" then
			-- 보스전은 처치 보상(깃털·주문서·열쇠)이 없다: 보상은 BossModeClear 정산 한 번
			self.KillSeq = self.KillSeq + 1
			log("[VRF] boss mode boss killed " .. self.FloorTitle)
			return
		end
		self:DropSkillStone(self.MonsterBoss, self.MonsterElite)
		self:GiveKillReward()
		self:DropFeathers(bossKilled)
		self:DropScrolls(bossKilled)
		if bossKilled and not self.MonsterBoss then self:DropCubes("elite") end
		if bossKilled then
			-- 층 클리어(보스 처치): 탑의 열쇠 확률 지급 (심볼은 유물로 대체되어 폐지)
			if self.MonsterBoss then self:RollFloorKey() end
			local bossHeal = self:Bonus("BossHeal")
			if bossHeal > 0 then self:HealPlayer(self.PlayerMaxHp * bossHeal / 100) end
		end
		log("[VRF] " .. self.FloorTitle .. " cleared")
	end

	@ExecSpace("ServerOnly")
	method void ApplyPlayerDamage(integer damage)
		-- 몬스터 공격이 플레이어에 맞았을 때 HP를 깎고 패배를 판정한다.
		if self._T.debugGod then return end
		if self.RunState ~= "FIGHT" or self.PlayerDown then return end
		-- 콤보 데스폴트 무적
		local mainHero = self:MainHero()
		if self:TryBlock(self._T.player) then return end
		if self:IsHeroRun() and mainHero ~= nil and mainHero:IsInvuln() then
			log("[VRF] hero invuln blocked " .. tostring(damage))
			return
		end
		-- 돌파 '보호막': 남은 보호막이 먼저 피해를 받는다
		local shield = self._T.shield or 0
		if shield > 0 then
			local absorbed = math.min(shield, damage)
			self._T.shield = shield - absorbed
			damage = damage - absorbed
		end
		if self._T.probe ~= nil then self._T.probe.taken = self._T.probe.taken + math.min(self.PlayerHp, damage) end
		self.PlayerHp = math.max(0, self.PlayerHp - damage)
		if self.PlayerHp > 0 then
			-- 돌파 '피격 회복'
			local hitHeal = self:Bonus("HitHeal")
			if hitHeal > 0 and _UtilLogic:RandomDouble() < 0.1 then self:HealPlayer(self.PlayerMaxHp * hitHeal / 100) end
			-- 각인 '가시': 받은 피해의 일부를 몬스터에게 반사
			local reflect = math.floor(damage * self:Bonus("Thorns") / 100 + 0.5)
			if reflect > 0 then self:ApplyMonsterDamage(reflect) end
			-- 각인 핵심 '수호막'
			if damage > 0 then self:TalentHitShield(self._T.player) end
			return
		end
		-- 불사: 층마다 1회 쓰러지는 대신 HP 일부로 부활
		-- 장신구 '영혼의 펜던트': 판마다 1번 쓰러지는 대신 체력 일부로 버팀
		local accRevive = self:AccessoryBonus(self._T.player, "Undying")
		if accRevive > 0 and not (self._T.accUndying or {})[1] then
			self._T.accUndying[1] = true
			self.PlayerHp = math.max(1, math.floor(self.PlayerMaxHp * accRevive / 100))
			log("[VRF] accessory undying player hp=" .. tostring(self.PlayerHp))
			return
		end
		-- 불사: 패시브 스킬 + 직업 스킬(불멸의 맹세·대주교의 가호)
		local revive = self:Bonus("Undying")
		if revive > 0 and not self._T.undyingUsed then
			self._T.undyingUsed = true
			self.PlayerHp = math.max(1, math.floor(self.PlayerMaxHp * revive / 100))
			local player = self._T.player
			if isvalid(player) then
				_EffectService:PlayEffectAttached(self.UndyingFxRUID, player, Vector3(0, 0.25, 0), 0, Vector3(0.9, 0.9, 1), false)
			end
			log("[VRF] proc undying hp=" .. tostring(self.PlayerHp))
			return
		end
		-- 각인 '최후의 저항': 판마다 1회 쓰러지는 대신 체력 일부로 버팀
		local lastStand = self:Bonus("LastStand")
		if lastStand > 0 and not self._T.lastStandUsed then
			self._T.lastStandUsed = true
			self.PlayerHp = math.max(1, math.floor(self.PlayerMaxHp * lastStand / 100))
			local player = self._T.player
			if isvalid(player) then
				_EffectService:PlayEffectAttached(self.LastStandFxRUID, player, Vector3(0, 0.5, 0), 0, Vector3(1.3, 1.3, 1), false)
			end
			log("[VRF] proc last stand hp=" .. tostring(self.PlayerHp))
			return
		end
		-- 비숍 헤븐즈 도어: 한 번 쓰러짐 무시
		if self:UseDeathWard(self._T.player) then
			self.PlayerHp = 1
			return
		end
		-- 2인 편성: 동료가 살아 있으면 메인만 쓰러지고 전투는 계속된다 (웨이브를 끝내면 일어남)
		if self:AnyMateUp() then
			self.PlayerDown = true
			self.PlayerHp = 0
			local player = self._T.player
			if isvalid(player) and isvalid(player.StateComponent) then player.StateComponent:ChangeState("DEAD") end
			log("[VRF] party member 1 down, others fight on")
			return
		end
		-- 펫 P-C: 쁘띠 데스 — 판마다 1회 전멸 대신 부활
		if self:TryPetRevive() then return end

		self:Defeat()
	end

	@ExecSpace("ServerOnly")
	method void Defeat()
		-- 패배 확정: 사망 모션 → 결과 팝업, 최고 층·깃털 저장 (부활 판정은 호출하기 전에 끝남).
		-- 이미 결과가 정해진 판에 늦게 온 패배가 결과 값을 덮지 않게
		if self.RunState == "RESULT" or self.RunState == "DEFEAT" then return end
		-- 4-B 보완: 정산 저장 대기 중 다른 피격이 Defeat를 또 불러도 한 번만 (StartRun에서 해제)
		if self._T.defeated then return end
		self._T.defeated = true
		-- 보스 개편: 보스 기믹·소환물 정리 (보스전 실패는 도전권 차감 없음)
		local mech = self:GetMech()
		if mech ~= nil then mech:End() end
		self:BossClearSummons()
		if self.RunMode == "boss" then
			self.BossResult = ""
			log("[VRF] boss mode defeat boss=" .. self.BossRunId .. " step=" .. tostring(self.BossRunStep) .. " (no ticket used)")
		end
		self:SettleAccount(false)
		self.RunState = "DEFEAT"
		for _, h in ipairs(self:Heroes()) do h:ClearState() end
		self.StateTimer = self.DeathDelay
		self.PlayerHp = 0
		local player = self._T.player
		if isvalid(player) and isvalid(player.StateComponent) then
			player.StateComponent:ChangeState("DEAD")
		end
		-- 4-D 보완(B3): 디버그로 시작한 판(DebugStartFloor)의 패배는 최고 층을 저장하지 않는다
		if not self._T.debugRun then
			if self.Floor > self.BestFloor then
				self.BestFloor = self.Floor
				self.IsNewBest = true
			end
			self:SaveBestFloor()
		else
			log("[VRF] debug run defeat: best floor not saved floor=" .. tostring(self.Floor) .. " best=" .. tostring(self.BestFloor))
		end
		-- 결과 화면: 실패한 판은 새 별 없음 (기존 별만 표시)
		local eng = self:GetEngrave()
		self.ResultFloor = self.Floor
		self.ResultTime = _UtilLogic.ElapsedSeconds - (self._T.runStartAt or _UtilLogic.ElapsedSeconds)
		self.ResultHpPct = 0
		if self._T.startStars ~= nil and self.Floor == self.StageEndFloor then
			self.ResultStarsPrev = self._T.startStars
		else
			self.ResultStarsPrev = eng ~= nil and eng:GetStars(self.Floor) or 0
		end
		self.ResultStarsNow = self.ResultStarsPrev
		if eng ~= nil and not self._T.debugRun then
			eng:FlushGrace()
			eng:FlushRelics()
			eng:FlushSkills()
		end
		-- 5-B: 주문서 보유는 PlayerGear가 저장한다 (옛 PlayerEngrave.FlushSlots 호출 끊음)
		local gear = self:GetGear()
		if gear ~= nil and not self._T.debugRun then gear:Flush() end
		log("[VRF] defeat at floor " .. tostring(self.Floor) .. " best=" .. tostring(self.BestFloor) .. " runMeso=" .. tostring(self.RunMeso))
	end

	@ExecSpace("Server")
	method void RequestGiveUp()
		-- [중단하기] 확인: 불사·최후의 저항 등 부활 효과 없이 바로 패배 처리 → 결과 팝업.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		local s = self.RunState
		if s ~= "FIGHT" and s ~= "CLEAR" and s ~= "CHOICE" and s ~= "BREAK" and s ~= "DEAL" then return end
		log("[VRF] give up at floor " .. tostring(self.Floor) .. " stage=" .. tostring(self.Stage))
		self:Defeat()
	end

	@ExecSpace("ServerOnly")
	method void LoadScrollDrop()
		-- 주문서 단계 비율표 (층 오름차순).
		self._T.scrollDrop = {}
		local ds = _DataService:GetTable("ScrollDropTable")
		if ds == nil then return end
		for i = 1, ds:GetRowCount() do
			table.insert(self._T.scrollDrop, { floor = tonumber(ds:GetCell(i, "Floor")) or 1, rates = { tonumber(ds:GetCell(i, "Tier1")) or 0, tonumber(ds:GetCell(i, "Tier2")) or 0, tonumber(ds:GetCell(i, "Tier3")) or 0 } })
		end
	end

	@ExecSpace("ServerOnly")
	method table ScrollRates()
		-- 지금 층·스테이지의 주문서 단계 비율 {1단계, 2단계, 3단계}: 층 구간 사이는 직선 보간, 스테이지마다 1단계 비율을 2·3단계로 옮긴다.
		local list = self._T.scrollDrop
		local rates = { 100, 0, 0 }
		for i, row in ipairs(list) do
			local nextRow = list[i + 1]
			if nextRow == nil or self.Floor < nextRow.floor then
				local k = 0
				if nextRow ~= nil then k = math.max(0, (self.Floor - row.floor) / (nextRow.floor - row.floor)) end
				for t = 1, 3 do
					rates[t] = row.rates[t]
					if nextRow ~= nil then rates[t] = row.rates[t] + (nextRow.rates[t] - row.rates[t]) * k end
				end
				break
			end
		end
		local shift = math.min(rates[1], self.ScrollStageShift * (self.Stage - 1))
		rates[1] = rates[1] - shift
		rates[2] = rates[2] + shift / 2
		rates[3] = rates[3] + shift / 2
		return rates
	end

	@ExecSpace("ServerOnly")
	method void DropCubes(string why)
		-- 5-D 큐브 드랍(수치는 GearConfig): boss = 레드 BossCubeRed + 무료 BossCubeFree, elite = EliteCubeRedChance% 레드 1, stage = StageFreeChance% 무료 1. 저장은 판 끝 gear:Flush. 디버그 판은 지급 안 함.
		local gear = self:GetGear()
		if gear == nil then return end
		local red = 0
		local free = 0
		if why == "boss" then
			red = math.floor(gear:Cfg("BossCubeRed", 2))
			free = math.floor(gear:Cfg("BossCubeFree", 3))
		elseif why == "elite" then
			if _UtilLogic:RandomDouble() * 100 < gear:Cfg("EliteCubeRedChance", 25) then red = 1 end
		elseif why == "stage" then
			if _UtilLogic:RandomDouble() * 100 < gear:Cfg("StageFreeChance", 50) then free = 1 end
		end
		if red <= 0 and free <= 0 then return end
		if not self._T.debugRun then
			gear:AddCubes("R", red)
			gear:AddCubes("F", free)
		end
		self.RunCubes = self.RunCubes + red
		self.RunFreeCubes = self.RunFreeCubes + free
		log("[VRF] cube drop " .. why .. " red+" .. tostring(red) .. " free+" .. tostring(free) .. " floor=" .. tostring(self.Floor) .. " run=" .. tostring(self.RunCubes) .. "/" .. tostring(self.RunFreeCubes) .. " debugRun=" .. tostring(self._T.debugRun == true))
	end

	@ExecSpace("ServerOnly")
	method void GiveGoldMeso(boolean isBoss)
		-- 금색 메소(아웃게임 계정 재화) 지급: (GoldMesoStageBase + 층 × GoldMesoPerFloor) × (보스 GoldMesoBossMul / 정예 GoldMesoEliteMul / 일반 1).
		-- 계정 보유는 PlayerGear에 더하고(저장은 판 끝 gear:Flush), 판 합계 RunGoldMeso는 결과 팝업 표시용. 디버그 판은 계정에 더하지 않는다.
		local mul = 1
		if isBoss then
			mul = self.GoldMesoBossMul
		elseif self.StageKind == "elite" then
			mul = self.GoldMesoEliteMul
		end
		-- 각인 재화 루트: 스테이지 클리어 금색 메소 +%
		local n = math.floor((self.GoldMesoStageBase + self.Floor * self.GoldMesoPerFloor) * mul * (1 + self:Bonus("GoldMesoPct") / 100) + 0.5)
		if n <= 0 then return end
		local gear = self:GetGear()
		if gear ~= nil and not self._T.debugRun then gear:AddGoldMeso(n) end
		self.RunGoldMeso = self.RunGoldMeso + n
		log("[VRF] gold meso +" .. tostring(n) .. " floor=" .. tostring(self.Floor) .. " kind=" .. tostring(self.StageKind) .. " boss=" .. tostring(isBoss) .. " run=" .. tostring(self.RunGoldMeso) .. " debugRun=" .. tostring(self._T.debugRun == true))
	end

	@ExecSpace("ServerOnly")
	method void DropScrolls(boolean boss)
		-- 슬롯 강화 주문서: 보스는 ScrollBossMin~Max장 확정, 일반 몬스터는 층·스테이지가 오를수록 조금씩 높아지는 확률로 1장. 부위는 무작위.
		local n = 0
		if boss then
			n = _UtilLogic:RandomIntegerRange(self.ScrollBossMin, self.ScrollBossMax)
		else
			local chance = self.ScrollChance + self.ScrollChancePerFloor * (self.Floor - 1) + self.ScrollChancePerStage * (self.Stage - 1)
			if _UtilLogic:RandomDouble() * 100 < chance then n = 1 end
		end
		if n <= 0 then return end
		-- 메소 재화 개편: 주문서는 부위 무관 공용 등급(하급·중급·상급)으로 PlayerGear에 넣는다 (등급 비율은 ScrollDropTable)
		local gear = self:GetGear()
		if gear == nil then return end
		local rates = self:ScrollRates()
		for i = 1, n do
			local slot = "Any"
			local tier = 3
			local r = _UtilLogic:RandomDouble() * 100
			if r < rates[1] then
				tier = 1
			elseif r < rates[1] + rates[2] then
				tier = 2
			end
			if not self._T.debugRun then gear:AddScrolls(slot, tier, 1) end
			self.RunScrolls = self.RunScrolls + 1
			log("[VRF] scroll drop " .. slot .. " tier=" .. tostring(tier) .. " floor=" .. tostring(self.Floor) .. " stage=" .. tostring(self.Stage) .. " run=" .. tostring(self.RunScrolls))
		end
	end

	@ExecSpace("ServerOnly")
	method void DropFeathers(boolean boss)
		-- 여신의 깃털: 보스는 2~4개 확정, 일반 몬스터는 확률로 1개. 판이 끝날 때 저장.
		local n = 0
		if boss then
			n = _UtilLogic:RandomIntegerRange(self.BossFeatherMin, self.BossFeatherMax)
		elseif _UtilLogic:RandomDouble() * 100 < self.FeatherChance then
			n = 1
		end
		if n <= 0 then return end
		local eng = self:GetEngrave()
		if eng == nil then return end
		if not self._T.debugRun then eng:AddFeathers(n) end
		self.RunFeathers = self.RunFeathers + n
		log("[VRF] feather +" .. tostring(n) .. " run=" .. tostring(self.RunFeathers))
	end

	@ExecSpace("ServerOnly")
	method void DropSkillBooks()
		-- (사용 안 함) 스킬북: 층 보스 처치 시 확정 지급. 메소 재화 개편으로 호출을 끊었다.
		local n = math.floor(self.SkillBookBossBase + self.Floor * self.SkillBookBossPerFloor)
		local eng = self:GetEngrave()
		if n <= 0 or eng == nil then return end
		if not self._T.debugRun then eng:AddSkillBooks(n) end
		self.RunBooks = self.RunBooks + n
		log("[VRF] skill book +" .. tostring(n) .. " run=" .. tostring(self.RunBooks))
	end

	@ExecSpace("ServerOnly")
	method void UpdateFloorSymbol()
		-- 심볼 폐지 (유물로 대체, 2026-11-21): 층 심볼 효과는 항상 0.
		self.FloorSymbolTier = 0
		self._T.symDmg = 0
		self._T.symCut = 0
		self._T.symGain = 0
	end

	@ExecSpace("ServerOnly")
	method void RollFloorKey()
		-- 층 클리어 보상: KeyDropChance% 확률로 탑의 열쇠 1개 (계정에 바로 더하고 판이 끝날 때 저장).
		if _UtilLogic:RandomDouble() * 100 >= self.KeyDropChance then
			log("[VRF] floor key miss floor=" .. tostring(self.Floor))
			return
		end
		local engrave = self:GetEngrave()
		if engrave ~= nil and not self._T.debugRun then engrave:AddTowerKeys(1) end
		self.RunKeys = self.RunKeys + 1
		self:SetEnhanceMsg("탑의 열쇠 +1")
		log("[VRF] floor key +1 floor=" .. tostring(self.Floor) .. " run=" .. tostring(self.RunKeys))
	end

	@ExecSpace("ServerOnly")
	method void RollFloorSymbol()
		-- 층 보스 처치: 그 층 심볼 획득 판정. 얻으면 배너 신호, 3단계면 영구 능력치 즉시 반영.
		local engrave = self:GetEngrave()
		if engrave == nil or self._T.debugRun then return end
		local tier = engrave:RollSymbol(self.Floor)
		if tier <= 0 then return end
		self.SymbolGetFloor = self.Floor
		self.SymbolGetTier = tier
		self.SymbolGetSeq = self.SymbolGetSeq + 1
		if tier >= 3 then
			self._T.symbolPerm = engrave:SymbolPermValues()
			self:RecalcStats()
		end
		self:UpdateFloorSymbol()
		log("[VRF] floor symbol " .. tostring(self.Floor) .. " -> tier " .. tostring(tier))
	end

	@ExecSpace("ServerOnly")
	method void LoadDealTable()
		-- 거래 테이블: 종류별 목록 + Id 색인.
		self._T.deals = { Angel = {}, Devil = {}, Merchant = {} }
		self._T.dealById = {}
		local ds = _DataService:GetTable(self.DealTableName)
		if ds == nil then
			log_error("[VRF] DealTable not found")
			return
		end
		for i = 1, ds:GetRowCount() do
			local d = {
				id = ds:GetCell(i, "Id"), kind = ds:GetCell(i, "Type"), name = ds:GetCell(i, "Name"),
				effects = {}, stages = tonumber(ds:GetCell(i, "Stages")) or 0, costMul = tonumber(ds:GetCell(i, "CostMul")) or 0,
			}
			for k = 1, 2 do
				local eff = ds:GetCell(i, "Eff" .. tostring(k))
				if eff ~= nil and eff ~= "" then table.insert(d.effects, { type = eff, value = tonumber(ds:GetCell(i, "Val" .. tostring(k))) or 0 }) end
			end
			if self._T.deals[d.kind] ~= nil then table.insert(self._T.deals[d.kind], d) end
			self._T.dealById[d.id] = d
		end
	end

	@ExecSpace("ServerOnly")
	method void RollDeals()
		-- 보스 보상: 제안과 대상을 함께 추첨하고 선택할 때까지 그대로 유지한다.
		local offers = {}
		local living = {}
		for _, actor in ipairs(self:Actors()) do
			if not self:IsDown(actor) then table.insert(living, self:GoddessActorIndex(actor)) end
		end
		for _, kind in ipairs({ "Angel", "Devil" }) do
			local list = self._T.deals[kind] or {}
			self.DealIds[kind] = ""
			if #list > 0 then
				local d = list[_UtilLogic:RandomIntegerRange(1, #list)]
				local shared = false
				for _, e in ipairs(d.effects) do
					if e.type == "MesoPct" or e.type == "MesoGain" or e.type == "SkillPick" then shared = true end
				end
				local target = 0
				if not shared and #living > 0 and _UtilLogic:RandomDouble() < self.GoddessSingleChance then target = living[_UtilLogic:RandomIntegerRange(1, #living)] end
				offers[kind] = self:BuildGoddessOffer(d, target)
				self.DealIds[kind] = d.id
			end
		end
		self._T.goddessOffers = offers
		self.GoddessOffersJson = _HttpService:JSONEncode(offers)
		self.GoddessOfferSeq = self.GoddessOfferSeq + 1
		self.DealIds["Merchant"] = ""
		self.DealCost = 0
		self.RunState = "DEAL"
		log("[VRF] goddess offers seq=" .. tostring(self.GoddessOfferSeq) .. " " .. self.GoddessOffersJson)
	end

	@ExecSpace("Server")
	method void RequestDeal(string kind)
		-- 거래 선택 ("" = 아무것도 고르지 않기). 천사·악마만 받는다.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		if self.RunState ~= "DEAL" then return end
		if kind ~= "" then
			local d = self._T.dealById[self.DealIds[kind] or ""]
			if d == nil or (kind ~= "Angel" and kind ~= "Devil") then return end
			self:ApplyDeal(d)
			self:PlayDealFx(kind)
			-- 이펙트가 다음 선택창에 가려지지 않게 잠깐 보여 준 뒤 진행 (그동안 거래창은 닫힘)
			self.RunState = "DEALFX"
			_TimerService:SetTimerOnce(function()
				if self.RunState == "DEALFX" then
					self.RunState = "DEAL"
					self:ContinueAfterReward()
				end
			end, self.DealFxWait)
			return
		else
			log("[VRF] deal skipped")
		end
		self:ContinueAfterReward()
	end

	@ExecSpace("ServerOnly")
	method void PlayDealFx(string kind)
		-- 거래를 고른 뒤 천사/악마 이펙트를 한 번, 구성원 무리의 가운데(발 높이)에 보여준다.
		local ruid = self.AngelDealFxRUID
		if kind == "Devil" then ruid = self.DevilDealFxRUID end
		if ruid == "" then return end
		local sx, n, y, z, inst = 0, 0, 0, 0, nil
		for _, e in ipairs(self:Actors()) do
			if isvalid(e) then
				local wp = e.TransformComponent.WorldPosition
				sx = sx + wp.x
				y = wp.y
				z = wp.z
				n = n + 1
				if inst == nil then inst = e end
			end
		end
		if n == 0 then return end
		self:ShowDealFx(ruid, inst, Vector3(sx / n, y, z))
		log("[VRF] deal fx " .. kind .. " x=" .. string.format("%.2f", sx / n))
	end

	@ExecSpace("Multicast")
	method void ShowDealFx(string ruid, Entity inst, Vector3 pos)
		-- 거래 이펙트는 클라이언트에서 재생해야 화면에 나온다 (서버 재생은 보이지 않음: 메이커 실측).
		_EffectService:PlayEffect(ruid, inst, pos, 0, Vector3(1, 1, 1), false, { FlipX = true })
	end

	@ExecSpace("ServerOnly")
	method void ApplyDeal(table d)
		-- 클라이언트가 보낸 대상·수치 대신 제안을 제시할 때 고정한 서버 값을 적용한다.
		local offer = (self._T.goddessOffers or {})[d.kind]
		if offer == nil or offer.id ~= d.id then return end
		local targets = {}
		for _, actor in ipairs(self:Actors()) do
			if offer.target == 0 or self:GoddessActorIndex(actor) == offer.target then table.insert(targets, actor) end
		end
		local active = self._T.goddessEffects or {}
		for _, e in ipairs(offer.effects) do
			if e.type == "Heal" or e.type == "HpCost" then
				for _, actor in ipairs(targets) do
					if not self:IsDown(actor) then
						if e.type == "Heal" then self:HealActor(actor, self:ActorMaxHp(actor) * e.value / 100)
						else
							local hp = math.max(1, self:ActorHp(actor) - math.floor(self:ActorHp(actor) * e.value / 100 + 0.5))
							local i = self:MateIndex(actor)
							if i > 0 then self:SetMateHp(i, hp) else self.PlayerHp = hp end
						end
					end
				end
			elseif e.type == "SkillPick" then
				if self:HasBreakLeft() then self.PendingPicks = self.PendingPicks + e.value end
			elseif e.type == "MesoGain" then
				self.Meso = self.Meso + e.value
				self.RunMeso = self.RunMeso + e.value
				self.MesoProcSeq = self.MesoProcSeq + 1
			else
				table.insert(active, { name = offer.name, type = e.type, value = e.value, bad = e.bad, target = offer.target, targetLabel = offer.targetLabel, left = e.left })
			end
		end
		self._T.goddessEffects = active
		self._T.goddessOffers = {}
		self:RecalcStats()
		self:SyncGoddessEffects()
		log("[VRF] goddess applied id=" .. d.id .. " target=" .. offer.targetLabel .. " active=" .. tostring(#active))
	end

	@ExecSpace("ServerOnly")
	method void TickCurses()
		-- 적용 후 완료한 웨이브부터 1회 차감. 이번 판 효과(left=0)는 유지한다.
		local active = {}
		local changed = false
		for _, e in ipairs(self._T.goddessEffects or {}) do
			local keep = true
			if e.left > 0 then e.left = e.left - 1 changed = true keep = e.left > 0 end
			if keep then table.insert(active, e) else log("[VRF] goddess expired " .. e.name .. " target=" .. e.targetLabel) end
		end
		self._T.goddessEffects = active
		if changed then self:RecalcStats() self:SyncGoddessEffects() end
	end

	@ExecSpace("ServerOnly")
	method void UpdateCurseText()
		self:SyncGoddessEffects()
	end

	@ExecSpace("ServerOnly")
	method number MonsterBaseHp(table info)
		-- 지금 층·스테이지의 일반 몬스터 체력 (등급 배율 전).
		local mul = self._T.typeMul[info.type] or { hp = 1 }
		local stageMul = 1
		if self.StagesPerFloor > 1 then stageMul = 1 + (self.LastStageStatMul - 1) * (self.Stage - 1) / (self.StagesPerFloor - 1) end
		return math.max(1, math.floor((self.MonsterHpBase + self.MonsterHpPerLevel * self:StageMonsterLevel()) * mul.hp * stageMul + 0.5))
	end

	@ExecSpace("ServerOnly")
	method number RankHpMul(Entity m)
		-- 몬스터 등급 체력 배율 (보스 20배 / 정예 5배 / 일반 1배).
		if self._T.bossOf ~= nil and self._T.bossOf[m] then return self.BossHpMul end
		if self._T.eliteOf ~= nil and self._T.eliteOf[m] then return self.EliteHpMul end
		return 1
	end

	@ExecSpace("ServerOnly")
	method void AssignElitePrefix(Entity monster, table info)
		-- 대기열 정예: 접두사를 미리 정하고 이름표를 붙인다 (맨 앞에 오면 그 접두사로 능력치).
		if #self._T.prefixes == 0 then return end
		-- 맨 앞으로 바로 나오는 정예는 능력치 계산 때 뽑아 둔 접두사를 그대로 쓴다 (이름표와 능력치 일치)
		local p = self._T.pendingPrefix
		if p == nil then p = self._T.prefixes[_UtilLogic:RandomIntegerRange(1, #self._T.prefixes)] end
		if self._T.prefixOf == nil then self._T.prefixOf = {} end
		self._T.prefixOf[monster] = p
		self:AttachEliteTag(monster, p.name .. " " .. info.name)
	end

	@ExecSpace("ServerOnly")
	method void AttachEliteTag(Entity monster, string label)
		-- 정예 이름표 (몬스터에 붙어 따라다니는 붉은 이름).
		if not isvalid(monster) then return end
		local tag = monster.NameTagComponent
		if not isvalid(tag) then tag = monster:AddComponent("NameTagComponent") end
		if not isvalid(tag) then return end
		tag.Name = label
		tag.FontColor = self.EliteTagColor
		tag.Bold = true
		tag.FontSize = 1.1
	end

	@ExecSpace("ServerOnly")
	method void GiveStageReward()
		-- 전투 스테이지 완료 보상: 일반 = 메소 + 재화 조금, 정예 = 메소 + 재화 많이. 보스는 층 클리어 정산(StageClear)이 맡는다.
		local spec = self.StageRewardNormal
		if self.StageKind == "elite" then spec = self.StageRewardElite end
		local got = {}
		local function range(key)
			for k, a, b in string.gmatch(spec, "(%a+):(%d+)%-?(%d*)") do
				if k == key then
					local lo = tonumber(a) or 0
					local hi = tonumber(b) or lo
					if hi < lo then hi = lo end
					return _UtilLogic:RandomIntegerRange(lo, hi)
				end
			end
			return 0
		end
		local mesoMul = range("meso")
		if mesoMul > 0 then
			local gain = math.floor(self:KillMeso() * mesoMul * (1 + self:Bonus("MesoPct") / 100) + 0.5)
			self.Meso = self.Meso + gain
			self.RunMeso = self.RunMeso + gain
			self.MesoProcSeq = self.MesoProcSeq + 1
			table.insert(got, "메소 +" .. tostring(gain))
		end
		local eng = self:GetEngrave()
		local feather = range("feather")
		if feather > 0 and eng ~= nil then
			if not self._T.debugRun then eng:AddFeathers(feather) end
			self.RunFeathers = self.RunFeathers + feather
			table.insert(got, "깃털 +" .. tostring(feather))
		end
		local scroll = range("scroll")
		for _ = 1, scroll do self:DropScrolls(true) end
		if scroll > 0 then table.insert(got, "주문서") end
		if #got > 0 then self:SetEnhanceMsg("스테이지 보상: " .. table.concat(got, " · ")) end
		log("[VRF] stage reward " .. self.StageKind .. " " .. table.concat(got, ","))
	end

	@ExecSpace("ServerOnly")
	method void OpenMystery()
		-- 물음표 스테이지: 사건 하나를 무작위로 (초안 3종: 보물 상자 / 도박꾼 / 저주받은 제단).
		local list = { "chest", "gamble", "altar" }
		local id = list[_UtilLogic:RandomIntegerRange(1, #list)]
		local text = ""
		if id == "chest" then
			text = "보물 상자\n낡은 상자가 놓여 있다.\n열면 메소나 여신의 깃털이 들어 있다."
		elseif id == "gamble" then
			local bet = math.floor(self.Meso / 2)
			self._T.mysteryBet = bet
			text = "도박꾼\n\"가진 메소의 절반을 걸어 보시겠소?\"\n" .. tostring(bet) .. " 메소를 걸고, 50% 확률로 두 배를 받는다."
		else
			text = "저주받은 제단\n최대 체력 -10%를 대가로\n돌파를 1번 고른다."
		end
		self.MysteryId = id
		self.MysteryText = text
		self.MysterySeq = self.MysterySeq + 1
		self.RunState = "MYSTERY"
		log("[VRF] mystery open " .. id)
	end

	@ExecSpace("Server")
	method void RequestMystery(boolean accept)
		-- 물음표 선택: 받기 / 지나치기. 결과를 알린 뒤 전투 포탈로 (제단은 돌파를 고른 뒤).
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		if self.RunState ~= "MYSTERY" then return end
		local id = self.MysteryId
		self.MysteryId = ""
		if not accept then
			self:SetEnhanceMsg("그냥 지나쳤다")
			self:OfferRoute()
			return
		end
		-- 각인 핵심 '행운아': 도박 성공 75%, 보물 상자는 메소와 깃털 모두
		local lucky = self:Bonus("MysteryLuck") > 0
		if id == "chest" then
			local giveMeso = lucky or _UtilLogic:RandomDouble() < 0.5
			local gain = 0
			local n = 0
			if giveMeso then
				-- 각인 탐험 루트 '보물 사냥': 보물 상자 메소 +%
				gain = math.floor(self:KillMeso() * 10 * (1 + self:Bonus("MysteryGain") / 100) + 0.5)
				self.Meso = self.Meso + gain
				self.RunMeso = self.RunMeso + gain
				self.MesoProcSeq = self.MesoProcSeq + 1
			end
			if lucky or not giveMeso then
				n = _UtilLogic:RandomIntegerRange(2, 4)
				local eng = self:GetEngrave()
				if eng ~= nil and not self._T.debugRun then eng:AddFeathers(n) end
				self.RunFeathers = self.RunFeathers + n
			end
			if gain > 0 and n > 0 then
				self:SetEnhanceMsg("보물 상자: 메소 +" .. tostring(gain) .. ", 여신의 깃털 +" .. tostring(n))
			elseif gain > 0 then
				self:SetEnhanceMsg("보물 상자: 메소 +" .. tostring(gain))
			else
				self:SetEnhanceMsg("보물 상자: 여신의 깃털 +" .. tostring(n))
			end
		elseif id == "gamble" then
			local bet = math.min(self._T.mysteryBet or 0, self.Meso)
			local winRate = 0.5
			if lucky then winRate = 0.75 end
			if _UtilLogic:RandomDouble() < winRate then
				self.Meso = self.Meso + bet
				self.RunMeso = self.RunMeso + bet
				self:SetEnhanceMsg("도박 성공! 메소 +" .. tostring(bet))
			else
				self.Meso = self.Meso - bet
				self:SetEnhanceMsg("도박 실패... 메소 -" .. tostring(bet))
			end
		elseif id == "altar" then
			self._T.runBonus = self._T.runBonus or {}
			self._T.runBonus["HpPct"] = (self._T.runBonus["HpPct"] or 0) - 10
			self:RecalcStats()
			self.PlayerHp = math.min(self.PlayerHp, self.PlayerMaxHp)
			for i = 1, 2 do self:SetMateHp(i, math.min(self:MateHp(i), self:MateMax(i))) end
			self:SetEnhanceMsg("제단의 대가: 최대 체력 -10%")
			if self:IsHeroRun() then
				self.PendingPicks = 1
				self:RollPartyBreaks()
				return
			end
		end
		log("[VRF] mystery result " .. id)
		self:OfferRoute()
	end

	@ExecSpace("ServerOnly")
	method void LoadAccessoryTables()
		-- 장신구 12종 / 공통 등급 / 부가 옵션 표를 한 번만 읽는다.
		if self._T.accDefs ~= nil then return end
		local defs, bySlot, grades, subs = {}, { Ring = {}, Pendant = {}, Earring = {} }, {}, {}
		local t = _DataService:GetTable("AccessoryTable")
		if t ~= nil then
			for i = 1, t:GetRowCount() do
				local d = { id = t:GetCell(i, "Id"), slot = t:GetCell(i, "Slot"), name = t:GetCell(i, "Name"), effect = t:GetCell(i, "Effect"),
					value = tonumber(t:GetCell(i, "Value")) or 0, party = t:GetCell(i, "Party") == "1" }
				defs[d.id] = d
				if bySlot[d.slot] ~= nil then table.insert(bySlot[d.slot], d) end
			end
		end
		local g = _DataService:GetTable("GradeTable")
		if g ~= nil then
			for i = 1, g:GetRowCount() do
				if g:GetCell(i, "UseAccessory") == "1" then
					table.insert(grades, { grade = tonumber(g:GetCell(i, "Grade")) or 1, chance = tonumber(g:GetCell(i, "Chance")) or 0,
						min = tonumber(g:GetCell(i, "MulMin")) or 1, max = tonumber(g:GetCell(i, "MulMax")) or 1,
						subs = tonumber(g:GetCell(i, "SubLines")) or 0, price = tonumber(g:GetCell(i, "PriceMul")) or 5 })
				end
			end
		end
		local s = _DataService:GetTable("AccessorySubTable")
		if s ~= nil then
			for i = 1, s:GetRowCount() do table.insert(subs, { effect = s:GetCell(i, "Effect"), value = tonumber(s:GetCell(i, "Value")) or 0 }) end
		end
		self._T.accDefs = defs
		self._T.accBySlot = bySlot
		self._T.accGrades = grades
		self._T.accSubs = subs
	end

	@ExecSpace("ServerOnly")
	method table RollAccessory(string slot)
		-- 진열 장신구 1개: 종류 안에서 무작위 + 등급 확률 + 등급별 배율·부가 옵션.
		local list = self._T.accBySlot[slot] or {}
		if #list == 0 then return nil end
		local d = list[_UtilLogic:RandomIntegerRange(1, #list)]
		-- 유물 '진열대 에픽 이상': 가장 낮은 등급 확률을 덜어 위 등급들에 비율대로 나눠 준다
		local chances = {}
		local sum = 0
		for i, g in ipairs(self._T.accGrades) do
			chances[i] = g.chance
			sum = sum + g.chance
		end
		local shift = math.min(chances[1] or 0, self:Bonus("ShopEpic") * sum / 100)
		if shift > 0 and #chances > 1 then
			local upper = sum - chances[1]
			chances[1] = chances[1] - shift
			for i = 2, #chances do chances[i] = chances[i] + shift * (upper > 0 and self._T.accGrades[i].chance / upper or 1 / (#chances - 1)) end
		end
		local r = _UtilLogic:RandomDouble() * sum
		local gr = self._T.accGrades[1]
		for i, g in ipairs(self._T.accGrades) do
			r = r - chances[i]
			if r <= 0 then gr = g break end
		end
		local mul = gr.min
		if gr.max > gr.min then
			local steps = math.floor((gr.max - gr.min) * 10 + 0.5)
			mul = gr.min + _UtilLogic:RandomIntegerRange(0, steps) / 10
		end
		local subs = {}
		local pool = {}
		for _, o in ipairs(self._T.accSubs) do
			if o.effect ~= d.effect then table.insert(pool, o) end
		end
		for _ = 1, gr.subs do
			if #pool == 0 then break end
			local o = table.remove(pool, _UtilLogic:RandomIntegerRange(1, #pool))
			table.insert(subs, { o.effect, o.value })
		end
		return { id = d.id, slot = slot, grade = gr.grade, mul = mul, subs = subs, price = math.max(1, math.floor(self:KillMeso() * gr.price * math.max(0, 1 - (self:PetEffect("ShopDiscount") + self:Bonus("ShopDiscount")) / 100) + 0.5)) }
	end

	@ExecSpace("ServerOnly")
	method number AccessoryValue(table item, string effect)
		-- 장신구 1개가 주는 효과 값: 기본 옵션(× 등급 배율) + 부가 옵션.
		local d = self._T.accDefs[item.id]
		local v = 0
		if d ~= nil and d.effect == effect then v = v + math.floor(d.value * item.mul * 10 + 0.5) / 10 end
		for _, s in ipairs(item.subs or {}) do
			if s[1] == effect then v = v + s[2] end
		end
		return v
	end

	@ExecSpace("ServerOnly")
	method number AccessoryBonus(Entity actor, string effect)
		-- 구성원 장신구 효과 합계. 처치 메소처럼 파티 효과는 누가 끼든 모두에게. 받는 피해(DmgTaken)는 피해 감소를 음수로 돌려준다.
		-- 5-F: 편성 칸 잠재능력(자기 칸 합계)도 같은 효과 이름으로 이 경로에서 더한다 (파티 효과·대상 없음은 제외).
		local key = effect
		local sign = 1
		if effect == "DmgTaken" then key = "DmgReduce" sign = -1 end
		local pot = 0
		if key ~= "MesoPct" and isvalid(actor) then pot = self:PotBonus(actor, key) end
		-- 펫 P-C: 보유 공격력%와 장착 펫 효과(체력·방어·치명타·받는 피해·스킬 피해·정예·쿨감·공속·흡혈)는 구성원 전원에게 같은 경로로 더한다
		if key ~= "MesoPct" and isvalid(actor) then pot = pot + self:PetActorBonus(key) end
		-- 각인 가속 루트: 쿨타임 감소는 전투 컴포넌트가 이 경로(CdReduce)로만 읽으므로 여기서 더한다 (구성원 전원)
		if key == "CdReduce" and isvalid(actor) then pot = pot + self:TalentValue("CdReduce") end
		local acc = self._T.acc
		if acc == nil or self._T.accDefs == nil then return pot * sign end
		local total = 0
		if key == "MesoPct" or not isvalid(actor) then
			if key ~= "MesoPct" then return 0 end
			for m = 1, 3 do
				for _, item in pairs(acc[m] or {}) do total = total + self:AccessoryValue(item, key) end
			end
			return total
		end
		local index = self:GoddessActorIndex(actor)
		for _, item in pairs(acc[index] or {}) do total = total + self:AccessoryValue(item, key) end
		return (total + pot) * sign
	end

	@ExecSpace("ServerOnly")
	method number ActorCritDmg(Entity actor)
		-- 구성원 크리티컬 데미지 (장신구 반영). 5-C: 장갑 치명타 데미지는 자기 칸 값 (CritDmg에는 1칸 값이 들어 있음)
		local no = self:ActorSlotNo(actor)
		local glove = 0
		if no ~= 1 then glove = self:EquipStat2For("Glove", no) - self:EquipStat2For("Glove", 1) end
		return self.CritDmg + glove + self:AccessoryBonus(actor, "CritDmg")
	end

	@ExecSpace("ServerOnly")
	method void AccessoryLifesteal(number dealt)
		-- 흡혈 장신구 착용자 회복.
		for _, e in ipairs(self:Actors()) do
			local pct = self:AccessoryBonus(e, "LifestealPct")
			if pct > 0 and not self:IsDown(e) then self:HealActor(e, dealt * pct / 100) end
		end
	end

	@ExecSpace("ServerOnly")
	method string EncodeAccessory(table item)
		-- 장신구 1개를 문자열로: 종류,Id,등급,배율,가격,부가(효과:값;효과:값).
		-- (빈 표는 JSON 변환이 안 되므로 직접 만든 형식을 쓴다: 메이커 실측)
		local subs = {}
		for _, sub in ipairs(item.subs or {}) do table.insert(subs, sub[1] .. ":" .. tostring(sub[2])) end
		return item.slot .. "," .. item.id .. "," .. tostring(item.grade) .. "," .. tostring(item.mul) .. "," .. tostring(item.price or 0) .. "," .. table.concat(subs, ";")
	end

	@ExecSpace("ServerOnly")
	method void SyncAccessories()
		-- 장착 상태를 클라이언트로: "구성원번호=장신구" 를 / 로 이어 붙인다.
		local parts = {}
		for m = 1, 3 do
			for _, item in pairs((self._T.acc or {})[m] or {}) do table.insert(parts, tostring(m) .. "=" .. self:EncodeAccessory(item)) end
		end
		self.AccessoryJson = table.concat(parts, "/")
		self:RecalcStats()
	end

	@ExecSpace("ServerOnly")
	method void SyncShop()
		-- 진열대·다시 뽑기 비용을 클라이언트로: "다시뽑기비용|칸번호=팔림(0/1)=장신구/..." 형식.
		local parts = {}
		for i, item in ipairs(self._T.shopItems or {}) do
			local sold = "0"
			if item.sold then sold = "1" end
			table.insert(parts, tostring(i) .. "=" .. sold .. "=" .. self:EncodeAccessory(item))
		end
		self.ShopJson = tostring(self._T.shopReroll or 0) .. "|" .. table.concat(parts, "/")
		self.ShopSeq = self.ShopSeq + 1
	end

	@ExecSpace("ServerOnly")
	method void RollShopStock()
		-- 진열대: 반지·펜던트·귀고리 1칸씩.
		local items = {}
		for _, slot in ipairs({ "Ring", "Pendant", "Earring" }) do
			local it = self:RollAccessory(slot)
			if it ~= nil then table.insert(items, it) end
		end
		self._T.shopItems = items
	end

	@ExecSpace("ServerOnly")
	method void OpenWorkshop()
		-- 정비소 입장: 진열대를 새로 채우고 다시 뽑기 비용을 처음 값으로.
		self:LoadAccessoryTables()
		self:RollShopStock()
		self._T.shopReroll = math.max(1, math.floor(self:KillMeso() * self.ShopRerollMul + 0.5))
		self:SyncShop()
		self:SyncAccessories()
		self.RunState = "SHOP"
		log("[VRF] workshop open items=" .. tostring(#(self._T.shopItems or {})) .. " reroll=" .. tostring(self._T.shopReroll))
	end

	@ExecSpace("ServerOnly")
	method boolean ShopRequester(string uid)
		-- 정비소 요청 공통 검사: 조작 플레이어 + 정비소 상태 (uid = 요청한 클라이언트).
		local player = self._T.player
		return isvalid(player) and player.PlayerComponent.UserId == uid and self.RunState == "SHOP"
	end

	@ExecSpace("ServerOnly")
	method void SellAccessory(integer who, string slot)
		-- 끼워 둔 장신구 판매 (산 값의 절반 환급).
		local item = ((self._T.acc or {})[who] or {})[slot]
		if item == nil then return end
		local back = math.floor((item.price or 0) * self.ShopSellRate + 0.5)
		self.Meso = self.Meso + back
		self._T.acc[who][slot] = nil
		log("[VRF] accessory sold who=" .. tostring(who) .. " " .. item.id .. " +" .. tostring(back))
	end

	@ExecSpace("Server")
	method void RequestShopBuy(integer index, integer who)
		-- 진열 장신구 구매 → 그 구성원의 같은 종류 칸에 바로 장착 (끼워 둔 것은 판매).
		if not self:ShopRequester(senderUserId) then return end
		local item = (self._T.shopItems or {})[index]
		if item == nil or item.sold or who < 1 or who > 3 then return end
		if self.Meso < item.price then return end
		self.Meso = self.Meso - item.price
		self:SellAccessory(who, item.slot)
		local own = { id = item.id, slot = item.slot, grade = item.grade, mul = item.mul, subs = item.subs, price = item.price }
		self._T.acc[who][item.slot] = own
		item.sold = true
		self:SyncShop()
		self:SyncAccessories()
		log("[VRF] accessory buy " .. item.id .. " grade=" .. tostring(item.grade) .. " -> who " .. tostring(who))
	end

	@ExecSpace("Server")
	method void RequestShopReroll()
		-- 유료 다시 뽑기: 비용은 누를 때마다 오른다.
		if not self:ShopRequester(senderUserId) then return end
		local cost = self._T.shopReroll or 0
		if self.Meso < cost then return end
		self.Meso = self.Meso - cost
		self._T.shopReroll = math.floor(cost * self.ShopRerollGrowth + 0.5)
		self:RollShopStock()
		self:SyncShop()
		log("[VRF] workshop reroll paid=" .. tostring(cost) .. " next=" .. tostring(self._T.shopReroll))
	end

	@ExecSpace("Server")
	method void RequestAccUnequip(integer who, string slot)
		-- 장신구 빼기 = 바로 판매.
		if not self:ShopRequester(senderUserId) then return end
		self:SellAccessory(who, slot)
		self:SyncAccessories()
	end

	@ExecSpace("Server")
	method void RequestAccMove(integer fromMember, integer toMember, string slot)
		-- 구성원끼리 같은 종류 장신구 바꿔 끼기.
		if not self:ShopRequester(senderUserId) then return end
		if fromMember < 1 or fromMember > 3 or toMember < 1 or toMember > 3 or fromMember == toMember then return end
		local a = self._T.acc[fromMember][slot]
		self._T.acc[fromMember][slot] = self._T.acc[toMember][slot]
		self._T.acc[toMember][slot] = a
		self:SyncAccessories()
	end

	@ExecSpace("Server")
	method void RequestShopLeave()
		-- 정비소 나가기 → 마법의 서로 걸어간다 (그다음 포탈).
		if not self:ShopRequester(senderUserId) then return end
		self:BeginPartyWalk(self.BookX - self.NpcStandGap, "book")
	end

	@ExecSpace("ServerOnly")
	method void ContinueAfterReward()
		-- 보상(거래) 처리 후: 쌓인 스킬 카드 선택이 있으면 카드, 없으면 다음 진행.
		if self.PendingPicks > 0 then
			self:RollChoices()
		else
			self:AfterRewards()
		end
	end

	@ExecSpace("ServerOnly")
	method void AfterRewards()
		-- 카드·거래가 끝난 뒤: 스테이지가 끝난 상태면 갈림길 포탈, 아니면(판 시작 등) 다음 몬스터.
		if self._T.routePending then
			self:OfferRoute()
		elseif self._T.needEntry then
			self:BeginStageEntry()
		else
			self:SpawnMonster()
		end
	end

	@ExecSpace("ServerOnly")
	method string MapValue(string list, string key)
		-- "키:값,키:값" 목록에서 값 찾기.
		for entry in string.gmatch(list, "[^,]+") do
			local k, v = string.match(entry, "^([^:]+):(.*)$")
			if k == key then return v end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void ClearPortals()
		-- 맵에 놓인 포탈을 모두 지운다.
		for _, p in ipairs(self._T.portals or {}) do
			if isvalid(p.ent) then p.ent:Destroy() end
		end
		self._T.portals = {}
	end

	@ExecSpace("ServerOnly")
	method void ClearNpcs()
		-- 상점 스테이지 오브젝트(상인·마법의 서)를 지운다 (다음 스테이지로 넘어갈 때).
		for _, n in ipairs(self._T.npcs or {}) do
			if isvalid(n) then n:Destroy() end
		end
		self._T.npcs = {}
	end

	@ExecSpace("ServerOnly")
	method void OfferRoute()
		-- 갈림길 포탈 배치 (설계 문서 4장):
		-- 비전투 다음은 전투만 / 정비소는 전투 3·6·9번 뒤 확정 / 특별 포탈은 각각 확률 / 남은 자리는 일반(보스 직전엔 보스)
		self:ClearPortals()
		local done = self.Stage
		local bossNext = done >= self.StagesPerFloor - 1
		local roll = function(pct) return _UtilLogic:RandomDouble() * 100 < pct end
		local kinds = {}
		if self._T.lastNonCombat then
			if not bossNext and roll(self.EliteChance) then table.insert(kinds, "elite") end
		else
			local fixed = {}
			for v in string.gmatch(self.ShopAfterStages, "[^,]+") do
				if tonumber(v) == done then table.insert(fixed, "shop") end
			end
			local rolled = {}
			if not bossNext and roll(self.EliteChance) then table.insert(rolled, "elite") end
			-- 각인 탐험 루트: 물음표 등장 확률 +%p
			if roll(self.MysteryChance + self:Bonus("MysteryUp")) then table.insert(rolled, "mystery") end
			if not self._T.dealUsed and roll(self.DealChance) then table.insert(rolled, "deal") end
			-- 보스 직전엔 보스 자리를 남기도록 비전투 최대 2개
			local cap = 3 - #fixed
			if bossNext then cap = math.max(0, 2 - #fixed) end
			while #rolled > cap do table.remove(rolled, _UtilLogic:RandomIntegerRange(1, #rolled)) end
			for _, k in ipairs(fixed) do table.insert(kinds, k) end
			for _, k in ipairs(rolled) do table.insert(kinds, k) end
		end
		if bossNext then
			table.insert(kinds, "boss")
		elseif #kinds < 3 then
			table.insert(kinds, "normal")
		end
		local xs = {}
		-- 상점 스테이지처럼 파티가 앞으로 걸어 나와 있으면, 포탈을 맨 앞 구성원보다 오른쪽 구간에 고르게 다시 놓는다 (포탈로는 오른쪽으로만 걸어감)
		local lead = self._T.player
		local minX = -99
		if isvalid(lead) then minX = lead.TransformComponent.WorldPosition.x + 0.7 end
		for v in string.gmatch(self.PortalXs, "[^,]+") do table.insert(xs, tonumber(v) or 0) end
		local portals = {}
		local firstX = xs[1] or 1.6
		local lastX = xs[#xs] or (1.6 * #kinds)
		local respread = minX > firstX
		-- 다시 놓을 때는 오른쪽 끝을 조금 더 써서 포탈끼리 겹치지 않게
		if respread then lastX = lastX + 0.2 end
		local lo = math.min(math.max(firstX, minX), lastX)
		for idx, kind in ipairs(kinds) do
			local x = xs[idx] or (1.6 * idx)
			if respread then
				x = lo
				if #kinds > 1 then x = lo + (lastX - lo) * (idx - 1) / (#kinds - 1) end
			end
			local ent = _SpawnService:SpawnByModelId(self.PortalModelId, "Portal" .. tostring(idx), Vector3(x, self.MonsterPos.y, 0), self.Entity)
			if isvalid(ent) then
				local pc = ent:GetComponent("script.TowerPortal")
				if pc ~= nil then pc:Setup(idx, kind, self:MapValue(self.PortalLabels, kind), self:MapValue(self.PortalRUIDs, kind)) end
				table.insert(portals, { ent = ent, kind = kind, x = x })
			end
		end
		self._T.portals = portals
		self.RunState = "ROUTE"
		log("[VRF] route offer done=" .. tostring(done) .. " lastNonCombat=" .. tostring(self._T.lastNonCombat) .. " portals=" .. table.concat(kinds, ","))
	end

	@ExecSpace("Server")
	method void RequestPortal(integer index)
		-- 포탈 선택: 구성원들이 고른 포탈로 걸어간다 (다른 포탈은 그대로 두고 다음 스테이지에서 함께 지운다).
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		if self.RunState ~= "ROUTE" then return end
		local chosen = (self._T.portals or {})[index]
		if chosen == nil then return end
		self._T.routeChoice = chosen.kind
		self._T.walk = { x = chosen.x, t = 0 }
		self.RunState = "WALK"
		local movement = player.MovementComponent
		if isvalid(movement) then movement.InputSpeed = self.WalkInputSpeed end
		self:SetLeadWalking(player, true)
		local pc = player:GetComponent("script.TowerPlayer")
		if pc ~= nil then pc:ClientWalkTo(chosen.x, self.PortalWalkSpeed, player.PlayerComponent.UserId) end
		for i = 1, 2 do
			local comp = self:Mate(i)
			if isvalid(comp) then
				if self:MateDown(i) then
					comp:SetVisible(false)
				else
					local tp = comp:GetComponent("script.TowerPlayer")
					if tp ~= nil then tp:SetWalkPose(true) end
				end
			end
		end
		log("[VRF] portal chosen " .. chosen.kind .. " x=" .. tostring(chosen.x))
	end

	@ExecSpace("ServerOnly")
	method void BeginStageEntry()
		-- 전투 스테이지 시작: 구성원을 자리보다 EntryDist 왼쪽에 세우고 자리로 걸어 들어오게 한다. 모두 도착하면 몬스터 등장.
		self._T.needEntry = false
		local player = self._T.player
		if not isvalid(player) then
			self:SpawnMonster()
			return
		end
		self:PlacePartyAtEntry()
		self:BeginPartyWalk(self.PlayerPos.x, "fight")
	end

	@ExecSpace("ServerOnly")
	method void PlacePartyAtEntry()
		-- 구성원을 자리보다 EntryDist 왼쪽(입장 출발점)에 세운다.
		local player = self._T.player
		if not isvalid(player) then return end
		player.PlayerComponent:SetWorldPosition(self.PlayerPos + Vector3(-self.EntryDist, 0, 0))
		self.EntryLeadStartX = self.PlayerPos.x - self.EntryDist
		for i = 1, 2 do
			local comp = self:Mate(i)
			if isvalid(comp) and not self:MateDown(i) then
				local wp = comp.TransformComponent.WorldPosition
				comp.TransformComponent.WorldPosition = Vector3(self.PlayerPos.x - self.CompanionGap * i - self.EntryDist, wp.y, wp.z)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void BeginPartyWalk(number leadX, string nextKey)
		-- 파티 자동 이동: 맨 앞 구성원이 leadX, 2·3번은 그 뒤 CompanionGap 간격까지 걸어간다. 도착하면 nextKey 진행 (TickEnter).
		local player = self._T.player
		if not isvalid(player) then
			self:AfterPartyWalk(nextKey)
			return
		end
		self.RunState = "ENTER"
		-- 화면이 검은 동안(입장·스테이지 이동 직후)에는 출발점에 세워 두고, 페이드인이 시작되면(RequestEntryGo) 걷는다
		local hold = self._T.holdEntry == true
		self._T.enter = { t = 0, lead = leadX, next = nextKey, hold = hold }
		self.EntryHold = hold
		if hold then
			log("[VRF] party walk hold lead=" .. string.format("%.2f", leadX) .. " next=" .. nextKey)
			return
		end
		self:StartPartyWalkMotion(0.2)
	end

	@ExecSpace("ServerOnly")
	method void StartPartyWalkMotion(number leadDelay)
		-- 파티 자동 이동 실제 출발: 맨 앞 구성원은 조작 클라이언트가 걷기, 2·3번은 걷기 자세 (위치는 TickEnter가 앞사람을 따라 옮김).
		local e = self._T.enter
		local player = self._T.player
		if e == nil or not isvalid(player) then return end
		e.hold = false
		e.t = 0
		self.EntryHold = false
		local leadX = e.lead
		local pc = player:GetComponent("script.TowerPlayer")
		local uid = player.PlayerComponent.UserId
		local spd = self.EntryWalkSpeed
		-- 맨 앞 구성원 걷기 동작: 조작 컴포넌트가 제자리 이동을 '정지'로 보고 서기로 되돌리지 않게 걷는 동안 항상 걷기 상태
		self:SetLeadWalking(player, true)
		-- 순간 이동이 클라이언트에 반영된 뒤 걷기 시작
		if pc ~= nil then _TimerService:SetTimerOnce(function() if self.RunState == "ENTER" then pc:ClientWalkTo(leadX, spd, uid) end end, leadDelay) end
		for i = 1, 2 do
			local comp = self:Mate(i)
			if isvalid(comp) and not self:MateDown(i) then
				local tp = comp:GetComponent("script.TowerPlayer")
				if tp ~= nil then tp:SetWalkPose(true) end
			end
		end
		log("[VRF] party walk start lead=" .. string.format("%.2f", leadX) .. " next=" .. e.next)
	end

	@ExecSpace("Server")
	method void RequestEntryGo()
		-- 클라이언트 페이드인 시작 신호: 출발점에서 기다리던 파티를 걷게 한다.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		local e = self._T.enter
		if self.RunState ~= "ENTER" or e == nil or not e.hold then return end
		self:StartPartyWalkMotion(0.05)
	end

	@ExecSpace("ServerOnly")
	method number FollowX(number curX, number targetX, number speed, number delta)
		-- 따라가기 이동: 목표 x까지 앞으로만 움직인다 (뒤로 물러나지 않음). 뒤처졌으면 조금 빨리 따라붙는다.
		if targetX <= curX + 0.001 then return curX end
		local gap = targetX - curX
		local spd = speed
		if gap > 0.15 then spd = speed * 1.5 end
		return math.min(targetX, curX + spd * delta)
	end

	@ExecSpace("ServerOnly")
	method void TickEnter(number delta)
		-- 파티 이동: 2·3번은 서버가 옮기고, 모두 도착하면(또는 5초) 자리를 맞추고 다음 진행.
		local e = self._T.enter
		if e == nil then return end
		e.t = e.t + delta
		if e.hold then
			-- 페이드인 신호를 기다리는 중 (신호가 끊겨도 멈춰 있지 않게 6초 뒤 스스로 출발)
			if e.t >= 6 then
				log_warning("[VRF] party walk hold timeout -> go")
				self:StartPartyWalkMotion(0.05)
			end
			return
		end
		local done = e.t >= 0.3
		local player = self._T.player
		local leadNow = e.lead
		if isvalid(player) then leadNow = player.TransformComponent.WorldPosition.x end
		for i = 1, 2 do
			local comp = self:Mate(i)
			if isvalid(comp) and not self:MateDown(i) then
				local slot = e.lead - self.CompanionGap * i
				local wp = comp.TransformComponent.WorldPosition
				-- 구성원 2·3번은 몸체가 없어 발판에 내려앉지 않으므로 구성원 1의 발 높이에 맞춘다
				if isvalid(player) then wp = Vector3(wp.x, player.TransformComponent.WorldPosition.y, wp.z) end
				if wp.x < slot - 0.01 then
					-- 앞사람(맨 앞 구성원의 지금 위치)에서 CompanionGap 간격을 유지하며 따라간다 (먼저 출발해 겹치지 않게)
					local target = math.min(slot, leadNow - self.CompanionGap * i)
					local nx = self:FollowX(wp.x, target, self.EntryWalkSpeed, delta)
					comp.TransformComponent.WorldPosition = Vector3(nx, wp.y, wp.z)
					if nx < slot - 0.01 then
						done = false
					else
						local tp = comp:GetComponent("script.TowerPlayer")
						if tp ~= nil then tp:SetWalkPose(false) end
					end
				end
			end
		end
		if isvalid(player) and player.TransformComponent.WorldPosition.x < e.lead - 0.05 then done = false end
		if not done and e.t < 5 then return end
		self._T.enter = nil
		self:SetLeadWalking(player, false)
		-- 맨 앞 구성원은 지금 발 높이 그대로 x만 맞춘다 (기준 높이로 옮기면 공중에 떴다 떨어져 2·3번이 떠 보임)
		if isvalid(player) then
			local pp = player.TransformComponent.WorldPosition
			if math.abs(pp.x - e.lead) > 0.05 then player.PlayerComponent:SetWorldPosition(Vector3(e.lead, pp.y, pp.z)) end
		end
		for i = 1, 2 do
			local comp = self:Mate(i)
			if isvalid(comp) and not self:MateDown(i) then
				local wp = comp.TransformComponent.WorldPosition
				local y = wp.y
				if isvalid(player) then y = player.TransformComponent.WorldPosition.y end
				comp.TransformComponent.WorldPosition = Vector3(e.lead - self.CompanionGap * i, y, wp.z)
				local tp = comp:GetComponent("script.TowerPlayer")
				if tp ~= nil then tp:SetWalkPose(false) end
			end
		end
		log("[VRF] party walk done t=" .. string.format("%.2f", e.t) .. " next=" .. e.next)
		self:AfterPartyWalk(e.next)
	end

	@ExecSpace("ServerOnly")
	method void AfterPartyWalk(string nextKey)
		-- 자동 이동이 끝난 뒤: 전투 시작 / 정비소 열기 / 마법의 서 열기.
		if nextKey == "shop" then
			self:OpenWorkshop()
		elseif nextKey == "book" then
			self:OpenBook()
		else
			self:SpawnMonster()
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnShopNpcs()
		-- 상점 스테이지 오브젝트: 장신구 상인과 마법의 서 (포탈 모델 재사용, 터치는 반응 없음).
		self._T.npcs = {}
		local list = { { x = self.MerchantX, ruid = self.MerchantRUID, label = "장신구 상인", scale = 1, y = 1.25 }, { x = self.BookX, ruid = self.BookRUID, label = "마법의 서", scale = self.BookScale, y = 2.25 } }
		for k, d in ipairs(list) do
			local ent = _SpawnService:SpawnByModelId(self.PortalModelId, "ShopNpc" .. tostring(k), Vector3(d.x, self.MonsterPos.y, 0), self.Entity)
			if isvalid(ent) then
				local pc = ent:GetComponent("script.TowerPortal")
				if pc ~= nil then
					pc:Setup(0, "npc", d.label, d.ruid)
					pc.LabelY = d.y
				end
				ent.TransformComponent.Scale = Vector3(d.scale, d.scale, 1)
				table.insert(self._T.npcs, ent)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void DropSkillStone(boolean boss, boolean elite)
		-- 처치 시 스킬석: 일반 3% / 정예 15% / 보스 100%.
		local chance = self.StoneDropNormal + self:Bonus("StoneDrop")
		if boss then chance = self.StoneDropBoss elseif elite then chance = self.StoneDropElite end
		if _UtilLogic:RandomDouble() * 100 < chance then
			-- 펫 P-C: 마족 메투스 확률로 1개 더
			self.SkillStone = self.SkillStone + 1 + self:PetStoneExtra()
			self:SetEnhanceMsg("스킬석 +1")
			log("[VRF] skill stone drop boss=" .. tostring(boss) .. " elite=" .. tostring(elite) .. " total=" .. tostring(self.SkillStone))
		end
	end

	@ExecSpace("ServerOnly")
	method void OpenBook()
		-- 마법의 서 화면: 구성원별 장착 스킬과 얻은/남은 돌파 수를 알려 주고 BOOK 상태로.
		local parts = {}
		for _, h in ipairs(self:Heroes()) do
			local skills = {}
			-- 4-E/4-F: 칸 순서(주력·보조·기술·하이퍼·궁극기) 다음 패시브 숨은 스킬 순서 (4-G 보완: 화면 줄 7개 = 칸 5 + 숨은 2)
			local ordered = {}
			for _, id in ipairs(h._T.equip or {}) do
				local s = self._T.skillById[id]
				if s ~= nil then table.insert(ordered, s) end
			end
			for _, sk in ipairs(ordered) do
				if h:Equipped(sk.id) then
					-- 4-F: 얻은 수는 그 스킬이 든 칸에 붙은 돌파 수
					local taken = self:BreakCountFor(sk.id)
					local rem = #self:RemainingBreaks(sk)
					-- 히어로 돌파는 스킬당 최대 3개
					if sk.pool == "HeroStar" then rem = math.min(rem, math.max(0, 3 - taken)) end
					table.insert(skills, sk.id .. ":" .. tostring(taken) .. ":" .. tostring(rem))
				end
			end
			table.insert(parts, h.JobId .. "=" .. table.concat(skills, ","))
		end
		self.BookInfo = table.concat(parts, "/")
		self.BookSeq = self.BookSeq + 1
		self.RunState = "BOOK"
		log("[VRF] book open stone=" .. tostring(self.SkillStone) .. " cost=" .. tostring(self.StoneCost) .. " info=" .. self.BookInfo)
	end

	@ExecSpace("Server")
	method void RequestBookUse(string skillId)
		-- 마법의 서 사용: 스킬석을 내고 그 스킬의 남은 돌파 중 무작위 2개를 카드로 보여 준다.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		if self.RunState ~= "BOOK" or self.SkillStone < self.StoneCost then return end
		local sk = self._T.skillById[skillId]
		if sk == nil then return end
		local owner = self:CombatForSkill(sk.id)
		if owner == nil or not owner:Equipped(sk.id) then return end
		local rest = self:RemainingBreaks(sk)
		if #rest == 0 then return end
		self.SkillStone = self.SkillStone - self.StoneCost
		-- 각인 돌파 루트 '학자': 확률로 낸 스킬석 반환 / 핵심 '깨달음': 비용이 오르지 않음
		if _UtilLogic:RandomDouble() * 100 < self:Bonus("BookRefund") then
			self.SkillStone = self.SkillStone + self.StoneCost
			log("[VRF] talent book refund stone=" .. tostring(self.SkillStone))
		end
		if self:Bonus("BookNoStep") <= 0 then self.StoneCost = self.StoneCost + self.StoneCostStep end
		local picks = {}
		local cardN = 2
		if _UtilLogic:RandomDouble() * 100 < self:Bonus("Book3") then cardN = 3 end
		for k = 1, math.min(cardN, #rest) do
			local idx = _UtilLogic:RandomIntegerRange(1, #rest)
			table.insert(picks, table.remove(rest, idx))
		end
		for i = 1, 3 do
			local key = tostring(i)
			self.ChoiceIds[key] = picks[i] ~= nil and picks[i].id or ""
			self.ChoiceOpts[key] = "option"
		end
		self.BreakSkill = sk.id
		self._T.partyBreak = false
		self._T.bookBreak = true
		self.ChoiceSeq = self.ChoiceSeq + 1
		self.RunState = "BREAK"
		log("[VRF] book use " .. sk.id .. " cards=" .. tostring(#picks) .. " stone=" .. tostring(self.SkillStone) .. " nextCost=" .. tostring(self.StoneCost))
	end

	@ExecSpace("ServerOnly")
	method void PickBookBreak(table b)
		-- 마법의 서 돌파 선택 적용 후 마법의 서 화면으로 돌아간다.
		local sk = self._T.skillById[b.skill]
		if sk == nil or b.skill ~= self.BreakSkill then return end
		-- 4-F: 칸 키 + 번호로 저장
		if self:BreakTakenFor(sk.id, b.id) then return end
		self:MarkBreakTaken(sk.id, b.id)
		self:ApplySkillOption(sk, b.effect, b.value)
		local prev = self.SkillBreaks[sk.id] or ""
		if prev ~= "" then prev = prev .. "," end
		self.SkillBreaks[sk.id] = prev .. b.id
		self._T.bookBreak = false
		self.BreakSkill = ""
		self:UpdateSkillInfo(sk)
		self:SetEnhanceMsg(sk.name .. " 돌파! [" .. b.name .. "]")
		self:RecalcStats()
		log("[VRF] book break " .. sk.id .. " " .. b.id)
		self:OpenBook()
	end

	@ExecSpace("Server")
	method void RequestBookClose()
		-- 마법의 서 닫기 → 다음 스테이지 포탈.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		if self.RunState ~= "BOOK" then return end
		self:ClearNpcs()
		self:OfferRoute()
	end

	@ExecSpace("ServerOnly")
	method void TickWalk(number delta)
		-- 걷기 연출: 포탈에 닿은 구성원부터 사라지고, 모두 사라지면 페이드아웃.
		local w = self._T.walk
		if w == nil then return end
		w.t = w.t + delta
		local allHidden = true
		local lead = self._T.player
		local leadVisible = isvalid(lead) and lead.Visible
		for i = 1, 2 do
			local comp = self:Mate(i)
			if isvalid(comp) and comp.Visible then
				local wp = comp.TransformComponent.WorldPosition
				local nx = math.min(w.x, wp.x + self.PortalWalkSpeed * delta)
				-- 맨 앞 구성원이 걷는 동안은 그 지금 위치에서 CompanionGap 간격을 유지하며 따라간다 (사라진 뒤엔 그대로 포탈까지)
				if leadVisible then
					nx = self:FollowX(wp.x, math.min(w.x, lead.TransformComponent.WorldPosition.x - self.CompanionGap * i), self.PortalWalkSpeed, delta)
				end
				comp.TransformComponent.WorldPosition = Vector3(nx, wp.y, wp.z)
				if nx >= w.x - 0.05 then
					comp:SetVisible(false)
					local tp = comp:GetComponent("script.TowerPlayer")
					if tp ~= nil then tp:SetWalkPose(false) end
				else
					allHidden = false
				end
			end
		end
		local player = self._T.player
		if isvalid(player) and player.Visible then
			if player.TransformComponent.WorldPosition.x >= w.x - 0.2 then
				player:SetVisible(false)
				self:SetLeadWalking(player, false)
			else
				allHidden = false
			end
		end
		if allHidden or w.t > 7 then
			log("[VRF] walk end lead=" .. string.format("%.2f", isvalid(player) and player.TransformComponent.WorldPosition.x or 0))
			self._T.walk = nil
			self.RunState = "FADE"
			self.StateTimer = 6
			if isvalid(player) then self:ClientStageFade(player.PlayerComponent.UserId) end
			log("[VRF] walk done t=" .. string.format("%.1f", w.t) .. " -> fade")
		end
	end

	@ExecSpace("Client")
	method void ClientStageFade()
		-- 화면을 어둡게 한 뒤 서버에 다음 스테이지 준비를 요청한다.
		_ScreenFadeLogic:FadeOut(function() self:RequestStageLoad() end)
	end

	@ExecSpace("Client")
	method void ClientStageFadeIn()
		-- 다음 스테이지 준비 완료: 구성원이 발판에 내려앉은 것을 확인한 뒤 화면을 다시 밝힌다 (ScreenFadeLogic HOLD).
		_ScreenFadeLogic:HoldForScene()
	end

	@ExecSpace("Server")
	method void RequestStageLoad()
		-- 페이드아웃이 끝났다는 클라이언트 신호.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		if self.RunState == "FADE" then self:LoadChosenStage() end
	end

	@ExecSpace("ServerOnly")
	method void LoadChosenStage()
		-- 고른 스테이지 준비: 포탈 정리, 구성원 제자리·다시 보이기, 스테이지 종류별 시작, 페이드인.
		local choice = self._T.routeChoice or "normal"
		self:ClearPortals()
		self:ClearNpcs()
		local player = self._T.player
		if isvalid(player) then
			player:SetVisible(true)
			self:SetLeadWalking(player, false)
			local movement = player.MovementComponent
			if isvalid(movement) then movement.InputSpeed = 0 end
			player.PlayerComponent:SetWorldPosition(self.PlayerPos)
		end
		for i = 1, 2 do
			local comp = self:Mate(i)
			if isvalid(comp) then
				comp:SetVisible(true)
				comp.TransformComponent.Position = self.PlayerPos + Vector3(-self.CompanionGap * i, 0, 0)
				local tp = comp:GetComponent("script.TowerPlayer")
				if tp ~= nil then tp:SetWalkPose(false) end
			end
		end
		self._T.routePending = false
		-- 화면이 검은 동안 준비: 입장 걷기는 출발점에서 멈춰 두고 페이드인 때 출발 (RequestEntryGo)
		self._T.holdEntry = true
		if choice == "normal" or choice == "elite" or choice == "boss" then
			self.Stage = math.min(self.StagesPerFloor, self.Stage + 1)
			if choice == "boss" then self.Stage = self.StagesPerFloor end
			self.StageKind = choice
			self._T.lastNonCombat = false
			self._T.waveNo = 1
			self._T.waveLeft = 0
			self:BeginStageEntry()
		elseif choice == "deal" then
			self._T.lastNonCombat = true
			self._T.dealUsed = true
			self._T.routePending = true
			self:RollDeals()
		elseif choice == "shop" then
			self._T.lastNonCombat = true
			self._T.routePending = true
			self:SpawnShopNpcs()
			-- 왼쪽에서 걸어 들어와 장신구 상인 앞에 선다
			self:PlacePartyAtEntry()
			self:BeginPartyWalk(self.MerchantX - self.NpcStandGap, "shop")
		elseif choice == "mystery" then
			self._T.lastNonCombat = true
			self._T.routePending = true
			self:OpenMystery()
		else
			-- 그 밖의 종류: 안내 후 바로 다음 포탈
			self._T.lastNonCombat = true
			self._T.routePending = true
			self.RunState = "NONCOMBAT"
			self:SetEnhanceMsg(self:MapValue(self.PortalLabels, choice) .. " 스테이지는 준비 중입니다")
			_TimerService:SetTimerOnce(function()
				if self.RunState == "NONCOMBAT" then self:OfferRoute() end
			end, 1.5)
		end
		self._T.holdEntry = false
		if isvalid(player) then self:ClientStageFadeIn(player.PlayerComponent.UserId) end
		log("[VRF] stage load " .. choice .. " stage=" .. tostring(self.Stage) .. " kind=" .. self.StageKind)
	end

	@ExecSpace("ServerOnly")
	method void SetEnhanceMsg(string msg)
		-- 강화 결과 메시지 (클라이언트가 EnhanceSeq 변화를 보고 표시).
		self.EnhanceMsg = msg
		self.EnhanceSeq = self.EnhanceSeq + 1
		log("[VRF] enhance: " .. msg)
	end

	@ExecSpace("Server")
	method void RequestEnhance(string slot)
		-- 장비 강화 요청: 0~9강은 확률 강화(90%에서 5%씩 감소), 10강은 다음 장비로 업그레이드.
		-- 판 안 장비 강화는 없앴다 (설계 문서 2-8: 판 안 메소는 정비소 장신구에만 쓴다). 장비 탭도 숨김.
		if self.InRunEnhanceDisabled then return end
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		if self.RunState ~= "FIGHT" and self.RunState ~= "CLEAR" then return end
		local list = self._T.equip[slot]
		if list == nil then return end
		if self.EquipUnlocked[slot] ~= 1 then
			self:SetEnhanceMsg(self:SlotKoName(slot) .. " 부위는 아직 잠겨 있습니다")
			return
		end
		local tier = self.EquipTier[slot] or 1
		local enh = self.EquipEnh[slot] or 0
		local row = self:EquipRow(slot, tier)
		local cost = self.EquipCost[slot] or 0
		if enh >= self.MaxEnhance and list[tier + 1] == nil then
			self:SetEnhanceMsg(row.name .. " : 최고 등급입니다")
			return
		end
		if self.Meso < cost then
			self:SetEnhanceMsg("메소가 부족합니다 (" .. tostring(cost) .. " 필요)")
			return
		end
		self.Meso = self.Meso - cost
		if enh >= self.MaxEnhance then
			self.EquipTier[slot] = tier + 1
			self.EquipEnh[slot] = 0
			self:ApplyCostume()
			self:SetEnhanceMsg(self:EquipRow(slot, tier + 1).name .. " (으)로 업그레이드!")
			self:SignalFx(slot, true)
		else
			local rate = math.max(0, self.EnhanceBaseRate - self.EnhanceRateStep * enh) + self.EnhanceBonus + (self.SlotEnhRate[slot] or 0)
			if _UtilLogic:RandomDouble() * 100 < rate then
				-- 슬롯 25단계 보너스: 확률로 한 번에 +2강
				local gain = 1
				local slotInfo = (self._T.slotInfo or {})[slot]
				if slotInfo ~= nil and _UtilLogic:RandomDouble() * 100 < slotInfo.doubleEnh then gain = 2 end
				local newEnh = math.min(self.MaxEnhance, enh + gain)
				self.EquipEnh[slot] = newEnh
				self:SetEnhanceMsg(row.name .. " +" .. tostring(newEnh) .. " 강화 성공!")
				self:SignalFx(slot, true)
			else
				self:SetEnhanceMsg(row.name .. " 강화 실패 (+" .. tostring(enh) .. " 유지)")
				self:SignalFx(slot, false)
			end
		end
		self:RecalcStats()
	end

	@ExecSpace("Server")
	method void RequestStart()
		-- 클라이언트 페이드 인 시작 신호: 대기 중이면 전투 시작.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		if self.RunState ~= "READY" then return end
		log("[VRF] start requested by fade-in")
		-- 화면이 아직 검은 동안 판을 준비한다: 입장 걷기는 출발점에서 멈춰 두고 페이드인 때 출발 (RequestEntryGo)
		self._T.holdEntry = true
		self:StartRun()
		self._T.holdEntry = false
	end

	@ExecSpace("Server")
	method void RequestRetry()
		-- 결과 팝업 재도전도 입장 에너지 3개를 소모한다. 저장 중에는 중복 재도전을 막는다.
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		if self.RunState ~= "RESULT" or not self.ResultAccountSaved then return end
		if self._T.retryEntering then return end
		-- 보스 개편: 보스전 다시 도전은 에너지 대신 도전권 검사(차감은 클리어 때)
		if self.RunMode == "boss" and self._T.bossRun ~= nil then
			local pb = self:GetBoss()
			local br = self._T.bossRun
			local check = pb ~= nil and pb:CheckEntry(br.id, br.step) or "notready"
			if self._T.debugRun then check = "ok" end
			if check ~= "ok" then
				log("[VRF] boss retry refused " .. check)
				return
			end
			self._T.retryBoss = { id = br.id, step = br.step, debug = self._T.debugRun == true }
			log("[VRF] boss retry requested " .. br.id .. ":" .. tostring(br.step))
			self:StartRun()
			return
		end
		local eng = player:GetComponent("script.PlayerEngrave")
		if eng == nil then return end
		self._T.retryEntering = true
		local paid = eng:ConsumeEntryEnergy()
		self._T.retryEntering = false
		if not paid or player.CurrentMap ~= self.Entity or self.RunState ~= "RESULT" then return end
		log("[VRF] retry requested")
		self:StartRun()
	end

	@ExecSpace("Server")
	method void RequestLobby()
		-- 결과 팝업 '로비로': 판을 정리하고 플레이어를 로비 맵으로 보낸다.
		if self._T.retryEntering or not self.ResultAccountSaved then return end
		local player = self._T.player
		if not isvalid(player) or player.PlayerComponent.UserId ~= senderUserId then return end
		self:DestroyMonster()
		self:DestroyCompanion()
		local mech = self:GetMech()
		if mech ~= nil then mech:End() end
		self:BossClearSummons()
		self.RunState = "WAIT"
		self._T.player = nil
		self.PlayerDown = false
		self:RevivePlayer(player)
		_TeleportService:TeleportToMapPosition(player, self.LobbyPos, self.LobbyMapName)
		log("[VRF] lobby requested -> teleport")
	end

	@ExecSpace("ServerOnly")
	method number ActorAttack(Entity actor, Entity monster, boolean main)
		-- 전투 캐릭터 1명의 기본 공격 1회: 명중 판정 → 자기 히어로 스킬 선택 → 공격 동작. 메인만 연속 베기·메소 사냥꾼 발동.
		-- 돌려주는 값: 스킬 동작이 길면 다음 공격까지 기다릴 시간(초), 아니면 0.
		local pc = actor:GetComponent("script.TowerPlayer")
		if pc == nil then return 0 end
		local hero = self:HeroOf(actor)
		-- 명중 판정 (전투 개편): 마법은 빗나가지 않음, 물리 = 몬스터 회피 - 자기 칸 명중 (상한 60%)
		local missRate = self:ActorMissRate(actor)
		if missRate > 0 and _UtilLogic:RandomDouble() * 100 < missRate then
			self._T.missLogN = (self._T.missLogN or 0) + 1
			if self._T.missLogN <= 8 then log("[VRF] miss actor=" .. actor.Name .. " job=" .. self:ActorJobId(actor) .. " rate=" .. string.format("%.1f", missRate) .. " acc=" .. string.format("%.1f", self:ActorAcc(actor))) end
			pc:DoMiss(monster)
			return 0
		end
		-- 돌파 '선제 급소'(첫 타격 크리티컬)·'거인 급소'(강화 몬스터 크리티컬 데미지)
		local critRate = self:ActorCrit(actor)
		if not self._T.firstHitDone and self:Bonus("FirstCrit") > 0 then critRate = 100 end
		local critDmg = self:ActorCritDmg(actor)
		if self.MonsterElite then critDmg = critDmg + self:Bonus("EliteCritDmg") end
		pc:DoAttack(monster, self:BasicHitDamage(hero), critRate, critDmg, self:RollJobProcs(hero))
		local wait = 0
		-- 히어로 스킬 동작이 기본 공격 간격보다 길면 다음 공격이 동작을 끊지 않게 기다린다
		if self:IsHeroRun() and hero ~= nil then wait = hero:LastActionTime() + 0.05 end
		if not main then return wait end
		-- 연속 베기: 확률로 잠시 뒤 한 번 더 공격
		if self:RollSkill("DoubleHit") then
			self._T.extraHitTimer = self.DoubleHitDelay
			log("[VRF] proc double hit")
		end
		-- 메소 사냥꾼: 확률로 처치 메소의 일부 획득 (동전 연출)
		if self:RollSkill("MesoProc") then
			local gain = math.max(1, math.floor(self:KillMeso() * self.MesoProcRatio + 0.5))
			self.Meso = self.Meso + gain
			self.RunMeso = self.RunMeso + gain
			self.MesoProcSeq = self.MesoProcSeq + 1
			log("[VRF] proc meso +" .. tostring(gain))
		end
		return wait
	end


	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
        if not self.ResultAccountSaved and self._T.accountSettlement ~= nil then
            self._T.accountRetry = (self._T.accountRetry or 0) - delta
            if self._T.accountRetry <= 0 then self:RetryAccountSettlement() end
        end
		-- 판 상태 머신: WAIT → FIGHT ⇄ CLEAR, FIGHT → DEFEAT → RESULT(팝업 대기)
		local player = self._T.player
		if isvalid(player) and player.CurrentMap ~= self.Entity then
			self:DestroyMonster()
			self:DestroyCompanion()
			self.RunState = "WAIT"
			self.EntryHold = false
			self._T.enter = nil
			self:SetLeadWalking(player, false)
			self._T.player = nil
			player = nil
		end
		if not isvalid(player) then
			local found = self:FindPlayer()
			if found ~= nil then
				self:SetupPlayer(found)
				-- 클라이언트 페이드 인이 시작될 때 전투를 시작한다 (RequestStart). 응답이 없으면 시간 초과로 시작.
				self.RunState = "READY"
				self.StateTimer = self.ReadyTimeout
			end
			return
		end

		-- 펫 P-C: 장착 펫이 파티 맨 뒤를 따라간다 (전투 중엔 뒤에 서 있음)
		self:TickPets(delta)

		-- 전투 밖(입장·상점·갈림길 등): 구성원 2·3번 발 높이를 구성원 1에 맞춘다 (몸체가 없어 스스로 내려앉지 못함)
		if self.RunState ~= "FIGHT" and not self.PlayerDown then
			local py = player.TransformComponent.WorldPosition.y
			for i = 1, 2 do
				local comp = self:Mate(i)
				if isvalid(comp) then
					local cp = comp.TransformComponent.WorldPosition
					if math.abs(cp.y - py) > 0.01 then comp.TransformComponent.WorldPosition = Vector3(cp.x, py, cp.z) end
				end
			end
		end

		if self.RunState == "FIGHT" then
			local monster = self._T.monster
			-- 안전장치: 싸우는 중인데 맨 앞 몬스터가 없거나 이미 죽어 있으면 멈추지 않고 다음으로 넘어간다
			local fc = isvalid(monster) and monster:GetComponent("script.TowerMonster") or nil
			if not isvalid(monster) or (fc ~= nil and fc.IsDead) then
				self._T.stuckTime = (self._T.stuckTime or 0) + delta
				if self._T.stuckTime >= 1 then
					self._T.stuckTime = 0
					log_warning("[VRF] fight without front monster -> recover left=" .. tostring(self._T.waveLeft))
					self._T.monster = nil
					self.RunState = "CLEAR"
					self.StateTimer = 0
				end
				return
			end
			self._T.stuckTime = 0

			self:TickSkills(delta)
			self:CleanupStrays(delta)
			-- 보스 개편 B3·B6: 맨 앞이 보스면 예고·기믹·제한 시간
			if self.MonsterBoss and self.RunState == "FIGHT" then
				local mech = self:GetMech()
				if mech ~= nil then mech:Tick(delta) end
			end
			if self.RunState ~= "FIGHT" or not isvalid(self._T.monster) then return end
			self:TickUltTime(delta, self._T.monster:GetComponent("script.TowerMonster"))

			-- 메인(플레이어) 기본 공격: 쓰러져 있으면 쉰다
			self:PullIfUnreachable(monster)
			-- 쿨타임은 몬스터가 걸어오는 동안에도 돈다. 닿으면 끝난 즉시 공격 (ActorTryAttack)
			self.PlayerAttackTimer = math.max(0, self.PlayerAttackTimer - delta)
			if not self.PlayerDown then
				self.PlayerAttackTimer = self:ActorTryAttack(player, monster, self.PlayerAttackTimer, true)
			end

			-- 동료 기본 공격 (자기 히어로 전투 컴포넌트로 스킬을 고른다)
			local timers = self._T.mateAtk or {}
			for i = 1, 2 do
				local comp = self:Mate(i)
				-- 구성원 2·3번은 몸체(물리)가 없어 발판에 내려앉지 않으므로 구성원 1의 발 높이에 맞춰 세운다
				if isvalid(comp) and not self.PlayerDown then
					local pp = player.TransformComponent.WorldPosition
					local cp = comp.TransformComponent.WorldPosition
					if math.abs(cp.y - pp.y) > 0.01 then comp.TransformComponent.WorldPosition = Vector3(self.PlayerPos.x - self.CompanionGap * i, pp.y, cp.z) end
				end
				if isvalid(comp) and not self:MateDown(i) and self.RunState == "FIGHT" then
					timers[i] = math.max(0, (timers[i] or 0) - delta)
					timers[i] = self:ActorTryAttack(comp, monster, timers[i], false)
				end
			end
			self._T.mateAtk = timers

			-- 연속 베기 추가 타격 (메인)
			if (self._T.extraHitTimer or 0) > 0 then
				self._T.extraHitTimer = self._T.extraHitTimer - delta
				if self._T.extraHitTimer <= 0 and not self.PlayerDown then
					local pc = player:GetComponent("script.TowerPlayer")
					if pc ~= nil then
						pc:DoAttack(monster, self:BasicHitDamage(self:MainHero()), self.CritRate, self.CritDmg, {})
					end
				end
			end

			local frontSlow = 1
			local fmc = isvalid(self._T.monster) and self._T.monster:GetComponent("script.TowerMonster") or nil
			if fmc ~= nil then frontSlow = fmc:SlowMul() end
			self.MonsterAttackTimer = self.MonsterAttackTimer - delta / frontSlow
			if self.MonsterAttackTimer <= 0 and self.RunState == "FIGHT" then
				-- 직업 스킬 '서리 갑옷': 몬스터 공격 간격 증가
				self.MonsterAttackTimer = (self._T.monsterInterval or self.MonsterAttackInterval) * (1 + self:Bonus("MonSlow") / 100)
				self:DoMonsterAttack(monster, true)
			end
			-- 맨 앞이 아닌 몬스터도 자기 자리(사거리)에 도착하면 각자 공격
			if self.RunState == "FIGHT" then self:TickQueueAttacks(delta) end
			-- 다음 묶음 출전 시간
			if self.RunState == "FIGHT" and (self._T.groupIdx or 1) < #(self._T.groups or {}) and _UtilLogic.ElapsedSeconds >= (self._T.nextGroupAt or 0) then
				self:ReleaseWaveGroup()
				if self._T.waveInfo ~= nil then self:FillQueue(self._T.waveInfo) end
			end
		elseif self.RunState == "CLEAR" then
			self.StateTimer = self.StateTimer - delta
			if self.StateTimer <= 0 then
				-- 보스 개편 B5: 보스전은 보스 처치 = 클리어 (다음 웨이브·층·포탈 없음)
				if self.RunMode == "boss" then
					self:BossModeClear()
					return
				end
				-- 웨이브가 남았으면 다음 몬스터 (대기열이 한 칸씩 앞으로)
				if (self._T.waveLeft or 0) > 0 then
					self:SpawnMonster()
					return
				end
				-- 스테이지 안 다음 웨이브
				if (self._T.waveNo or 1) < self.WavesPerStage then
					self._T.waveNo = (self._T.waveNo or 1) + 1
					self:SpawnMonster()
					return
				end
				-- 4-B 보완: 스테이지 끝 블록 재진입 방지. 층 클리어 정산(SettleAccount → 저장 대기) 중
				-- 다음 프레임 OnUpdate가 이 블록을 다시 돌면 보상·회복이 두 번 들어간다. BeginWave·StartRun에서 해제
				if self._T.stageEnding then return end
				self._T.stageEnding = true
				self._T.completedStages = (self._T.completedStages or 0) + 1
				-- 스테이지를 끝내면 쓰러진 구성원이 일어난다
				self:ReviveDowned()
				-- 4단계: 레벨업 전체 회복 대신 전투 스테이지 클리어 회복 (RunConfig StageClearHealPct)
				if self.StageClearHealPct > 0 then
					-- 펫 P-C: 세레나(클리어 회복량 +v%)
					local healPct = self.StageClearHealPct * (1 + self:PetEffect("ClearHealPct") / 100)
					for _, a in ipairs(self:Actors()) do
						if not self:IsDown(a) then self:HealActor(a, self:ActorMaxHp(a) * healPct / 100) end
					end
					log("[VRF] stage clear heal pct=" .. tostring(healPct) .. " hp=" .. tostring(self.PlayerHp) .. "/" .. tostring(self.PlayerMaxHp))
				end
				self:DestroyMonster()
				self:TickCurses()
				local isBoss = self.StageKind == "boss" or self.Stage >= self.StagesPerFloor
				-- 펫 P-C: 마족 메투스 확률로 1개 더
				self.SkillStone = self.SkillStone + 1 + self:PetStoneExtra()
				log("[VRF] skill stone stage clear total=" .. tostring(self.SkillStone))
				-- 유물 '스테이지 클리어 회복': 살아 있는 구성원 최대 체력의 일부
				local clearHeal = self:Bonus("ClearHeal")
				if clearHeal > 0 then
					for _, a in ipairs(self:Actors()) do
						if not self:IsDown(a) then self:HealActor(a, self:ActorMaxHp(a) * clearHeal / 100) end
					end
				end
				if not isBoss then self:GiveStageReward() end
				-- 5-D 큐브: 전투 스테이지 클리어 = 무료 큐브 확률 1개, 보스 스테이지(층 보스 처치) = 레드·무료 확정
				if isBoss then self:DropCubes("boss") else self:DropCubes("stage") end
				-- 금색 메소: 전투 스테이지 클리어마다 층 비례, 정예·보스 스테이지는 배율 (디버그 판은 지급 안 함, 저장은 판 끝 Flush)
				self:GiveGoldMeso(isBoss)
				-- 3인 파티: 전투 스테이지가 끝날 때마다 돌파 1번 (4단계: 레벨업 없음)
				if self:IsHeroRun() and not isBoss then
					self.PendingPicks = 1
					-- 각인·은총 '추가 카드 확률'(ExtraPick): 4단계부터 돌파 선택 +1 확률
					if _UtilLogic:RandomDouble() * 100 < self:Bonus("ExtraPick") and self:HasBreakLeft() then self.PendingPicks = 2 end
					log("[VRF] stage clear picks=" .. tostring(self.PendingPicks))
				end
				if isBoss then
					-- 보스 처치 = 층 클리어
					self.Stage = 1
					self.Floor = self.Floor + 1
					self._T.undyingUsed = false
					self:UpdateUnlocks(true)
					local engrave = self:GetEngrave()
					-- 4-D 보완(B3): 디버그 판은 첫 클리어 기록(각인 진행)·다이아를 남기지 않는다
					if self._T.debugRun then
						engrave = nil
						log("[VRF] debug run boss clear: cleared floor/diamonds not saved")
					end
					if engrave ~= nil and engrave:ReportCleared(self.Floor - 1) then
						self:SetEnhanceMsg("각인 포인트 +1! (총 " .. tostring(self.Floor - 1) .. ")")
					end
					-- 층 첫 클리어 다이아 (3단계): 같은 층은 한 번만 지급되므로 몇 번 불러도 안전
					local roster = isvalid(self._T.player) and self._T.player:GetComponent("script.PlayerRoster") or nil
					if roster ~= nil and engrave ~= nil then
						local dia = roster:GrantFirstClearDiamonds(engrave.ClearedFloor)
						if dia > 0 then self.RunDiamonds = self.RunDiamonds + dia end
					end
					self.Floor = math.min(self.Floor - 1, self.StageEndFloor)
					self.Stage = self.StagesPerFloor
					self:StageClear()
					return
				end
				-- 레벨업 카드(돌파) 선택을 마치면 갈림길 포탈
				self._T.routePending = true
				self:ContinueAfterReward()
			end
		elseif self.RunState == "WALK" then
			self:TickWalk(delta)
		elseif self.RunState == "FADE" then
			-- 클라이언트 페이드 응답이 없으면 시간 초과로 다음 스테이지
			self.StateTimer = self.StateTimer - delta
			if self.StateTimer <= 0 then self:LoadChosenStage() end
		elseif self.RunState == "ENTER" then
			self:TickEnter(delta)
		elseif self.RunState == "READY" then
			self.StateTimer = self.StateTimer - delta
			if self.StateTimer <= 0 then
				log("[VRF] ready timeout -> start")
				self._T.holdEntry = true
				self:StartRun()
				self._T.holdEntry = false
			end
		elseif self.RunState == "DEFEAT" then
			self.StateTimer = self.StateTimer - delta
			if self.StateTimer <= 0 then
				self.RunState = "RESULT"
				log("[VRF] result popup state")
			end
		end
	end


    @ExecSpace("ServerOnly")
    method void SettleAccount(boolean clear)
        -- 판 종료 경로가 중복되어도 같은 판 정산은 한 번만 만든다.
        if self._T.accountSettled or self._T.accountSettlement ~= nil or self._T.accountRunId == nil then return end
        local eng = self:GetEngrave()
        if eng == nil then return end
        -- 4-G 보완: 디버그 판은 계정 경험치를 정산·저장하지 않는다 (결과 화면은 "테스트 판: 저장 안 됨")
        -- 보스 개편: 보스전은 계정 경험치를 주지 않는다 (보상은 PlayerBoss 정산)
        if self._T.debugRun or self.RunMode == "boss" then
            self.ResultAccountBeforeLevel = eng.AccountLevel
            self.ResultAccountAfterLevel = eng.AccountLevel
            self.ResultAccountBeforeExp = eng.AccountExp
            self.ResultAccountBeforeNeed = eng.AccountNeed
            self.ResultAccountExp = 0
            self.ResultAccountSaved = true
            self._T.accountSettled = true
            log("[VRF] debug run: account exp/rewards not saved clear=" .. tostring(clear))
            return
        end
        local completed = self._T.completedStages or 0
        -- 마지막 웨이브를 모두 처치한 CLEAR 중 중단은 그 스테이지까지 인정한다.
        if not clear and self.RunState == "CLEAR" and (self._T.waveLeft or 1) <= 0 then completed = completed + 1 end
        local exp = _AccountRules:RunExp(self.StageStartFloor, clear, completed, self.StagesPerFloor * self.FloorsPerStage)
        self.ResultAccountBeforeLevel = eng.AccountLevel
        self.ResultAccountBeforeExp = eng.AccountExp
        self.ResultAccountBeforeNeed = eng.AccountNeed
        self.ResultAccountExp = exp
        self.ResultAccountSaved = false
        self._T.accountSettlement = {id=self._T.accountRunId,exp=exp}
        self:RetryAccountSettlement()
    end

    @ExecSpace("ServerOnly")
    method void RetryAccountSettlement()
        -- 저장 오류는 10초 간격 재시도. 정산 완료 전 재도전·로비 이동을 막는다.
        self._T.accountRetry = 10
        local eng = self:GetEngrave()
        local data = self._T.accountSettlement
        if eng == nil or data == nil then return end
        if eng:AwardAccount(data.id, data.exp) then
            self.ResultAccountSaved = true
            self.ResultAccountAfterLevel = eng.AccountLevel
            self._T.accountSettled = true
            self._T.accountSettlement = nil
            log("[VRF] account settlement exp=" .. tostring(data.exp) .. " level=" .. tostring(eng.AccountLevel))
        end
    end

	@ExecSpace("ServerOnly")
	method integer GoddessActorIndex(Entity actor)
		if not isvalid(actor) or actor == self._T.player then return 1 end
		return self:MateIndex(actor) + 1
	end

	@ExecSpace("ServerOnly")
	method string GoddessActorLabel(integer index)
		if index == 0 then return "파티 전체" end
		local actor = self._T.player
		if index > 1 then actor = self:Mate(index - 1) end
		local h = isvalid(actor) and self:HeroOf(actor) or nil
		local job = h ~= nil and h.JobId or self.JobId
		local j = (self._T.jobById or {})[job]
		return (j ~= nil and j.name or "캐릭터") .. " · " .. tostring(index) .. "번"
	end

	@ExecSpace("ServerOnly")
	method number GoddessBonus(Entity actor, string effect)
		local index = isvalid(actor) and self:GoddessActorIndex(actor) or 0
		local total = 0
		for _, e in ipairs(self._T.goddessEffects or {}) do
			if e.type == effect and (e.target == 0 or e.target == index) then total = total + e.value end
		end
		-- 장신구 효과도 같은 경로로 합산 (낀 구성원만, 메소는 파티 전체)
		return total + self:AccessoryBonus(actor, effect)
	end

	@ExecSpace("ServerOnly")
	method number ActorAtk(Entity actor)
		-- 구성원별 공격력 (4단계: 구성원 자기 캐릭터 스탯 기준값)
		local base = ((self._T.actorBase or {})[actor] or {}).atk or self._T.goddessAtkBase
		if base == nil then return self.PlayerAtk end
		local pct = self:Bonus("AtkPct") + self:Bonus("WeaponEnhAtk") * (self.EquipEnh["Weapon"] or 0) + self:GoddessBonus(actor, "AtkPct")
		return math.max(1, math.floor(base * math.max(0.01, 1 + pct / 100) + self:ActorMaxHp(actor) * self:Bonus("HpToAtk") / 100 + 0.5))
	end

	@ExecSpace("ServerOnly")
	method number ActorDefense(Entity actor)
		-- 구성원별 방어력 (4단계: 구성원 자기 캐릭터 스탯 기준값)
		local base = ((self._T.actorBase or {})[actor] or {}).def or self._T.goddessDefBase
		if base == nil then return self.PlayerDef end
		return math.max(0, base * math.max(0, 1 + (self:Bonus("DefPct") + self:GoddessBonus(actor, "DefPct")) / 100))
	end

	@ExecSpace("ServerOnly")
	method number ActorCrit(Entity actor)
		-- 5-C: 장갑 치명타 확률·단계 보너스는 구성원 자기 편성 칸 값
		return math.max(0, math.min(100, self:EquipStatFor("Glove", self:ActorSlotNo(actor)) + self:Bonus("Crit") + self:SlotMileDelta(actor, "Crit") + self:GoddessBonus(actor, "Crit")))
	end

	@ExecSpace("ServerOnly")
	method integer ActorRange(Entity actor)
		-- 이 캐릭터의 공격 사거리 칸 수 (직업별 JobRanges, 1~3).
		local hero = self:HeroOf(actor)
		local job = hero ~= nil and hero.JobId or ""
		local lv = 1
		for entry in string.gmatch(self.JobRanges, "[^,]+") do
			local k, v = string.match(entry, "([^:]+):(%d+)")
			if k == job then lv = math.floor(tonumber(v) or 1) end
		end
		return math.max(1, math.min(3, lv))
	end

	@ExecSpace("ServerOnly")
	method number CellX(integer cell)
		-- 몬스터 칸의 기준 위치 (1칸 = 맨 앞 자리).
		return self.MonsterPos.x + self.CellWidth * (math.max(1, cell) - 1)
	end

	@ExecSpace("ServerOnly")
	method integer CellAt(number x)
		-- 위치 x가 몬스터 몇 칸인지 (칸 기준 위치 ±반 칸). 3칸보다 멀면 4 (아무도 닿지 않음).
		local c = math.ceil((x - (self.MonsterPos.x + self.CellWidth * 0.5)) / self.CellWidth) + 1
		return math.max(1, math.min(4, c))
	end

	@ExecSpace("ServerOnly")
	method integer MonRange(Component mc)
		-- 몬스터 사거리 칸 (데이터 AttackRange, 웨이브 원거리 자리는 최소 2칸). 이 칸에 도착해 멈춘다.
		if mc == nil then return 1 end
		local r = mc.AttackRange
		if mc.IsRanged then r = math.max(r, 2) end
		return math.max(1, math.min(3, r))
	end

	@ExecSpace("ServerOnly")
	method boolean CanReach(Entity actor, Entity monster)
		-- 공격 가능: 몬스터가 지금 서 있는(지나가는) 칸이 내 사거리 칸 수 이하.
		if not isvalid(actor) or not isvalid(monster) then return false end
		return self:CellAt(monster.TransformComponent.WorldPosition.x) <= self:ActorRange(actor)
	end

	@ExecSpace("ServerOnly")
	method void PullIfUnreachable(Entity monster)
		-- 맨 앞 몬스터가 자기 칸에 도착했는데 살아 있는 우리 편 누구의 사거리에도 닿지 않으면 1칸으로 다가오게 한다 (전투가 멈추지 않게).
		local mc = isvalid(monster) and monster:GetComponent("script.TowerMonster") or nil
		if mc == nil or mc.IsDead or mc.Moving or mc.KnockBack then return end
		-- 보스 개편 B6: 날아오른 보스는 당겨 오지 않는다 (근접 1칸 직업이 못 치는 것이 기믹)
		local mech = self:GetMech()
		if mech ~= nil and mech.Flying then return end
		local cell = self:CellAt(monster.TransformComponent.WorldPosition.x)
		if cell <= 1 then return end
		for _, a in ipairs(self:Actors()) do
			if not self:IsDown(a) and self:ActorRange(a) >= cell then return end
		end
		mc:WalkTo(self:CellX(1), self.MonsterWalkSpeed * mc.SpeedMul)
		log("[VRF] front monster unreachable at cell " .. tostring(cell) .. " -> walk to cell 1")
	end

	@ExecSpace("ServerOnly")
	method boolean ActorBusy(Entity actor)
		-- 공격·스킬 동작 중인지.
		local busy = self._T.busy or {}
		return (busy[actor] or 0) > _UtilLogic.ElapsedSeconds
	end

	@ExecSpace("ServerOnly")
	method void SetBusy(Entity actor, number sec)
		-- 동작 시간 기록 (그동안 다른 공격·스킬을 시작하지 않는다).
		if self._T.busy == nil then self._T.busy = {} end
		self._T.busy[actor] = _UtilLogic.ElapsedSeconds + sec
	end

	@ExecSpace("ServerOnly")
	method number ActorTryAttack(Entity actor, Entity monster, number timer, boolean main)
		-- 캐릭터 1명의 공격 차례: 쿨타임이 끝났고 닿으면 기본 공격, 아니면 마나·쿨타임이 되는 스킬을 따로 시전.
		-- 돌려주는 값: 남은 기본 공격 쿨타임.
		if self:ActorBusy(actor) then return timer end
		-- 4-D 보완(C안): 사거리에 닿지 않아도 가득 찬 궁극기·쿨타임형(자기 버프·하이퍼)은 시전한다. 칸 전투 규칙(사거리·당기기)은 그대로.
		if not self:CanReach(actor, monster) then
			self:TryFreeCasts(actor, monster)
			return timer
		end
		if timer <= 0 then
			local wait = self:ActorAttack(actor, monster, main)
			self:SetBusy(actor, math.max(self.BasicMotionTime, wait))
			return math.max(self:ActorInterval(actor), wait)
		end
		if not self:IsHeroRun() then return timer end
		local hero = self:HeroOf(actor)
		if hero == nil then return timer end
		local list = hero:RollSkillCasts(self)
		if #list == 0 then return timer end
		local pc = actor:GetComponent("script.TowerPlayer")
		if pc == nil then return timer end
		pc:DoCast(monster, list)
		self:SetBusy(actor, math.max(self.SkillCastGap, hero:LastActionTime() + 0.05))
		self._T.castLog = (self._T.castLog or 0) + 1
		if self._T.castLog <= 12 then log("[VRF] skill cast " .. actor.Name .. " n=" .. tostring(#list) .. " basicCd=" .. string.format("%.2f", timer)) end
		return timer
	end

	@ExecSpace("ServerOnly")
	method void TickUltTime(number delta, Component fc)
		-- 4-D 보완: 전투 시간 충전. 4-G 보완: 전투 상태(맨 앞 몬스터가 살아 있는 동안, 걸어오는 중 포함) 전체 시간에 살아 있는 구성원마다 초당 UltGaugePerSec.
		-- 동기화 값이 매 프레임 바뀌지 않게 0.25초씩 모아서 더한다.
		if self.UltGaugePerSec <= 0 then return end
		if fc == nil or fc.IsDead then return end
		self._T.ultTimeAcc = (self._T.ultTimeAcc or 0) + delta
		if self._T.ultTimeAcc < 0.25 then return end
		local add = self._T.ultTimeAcc * self.UltGaugePerSec
		self._T.ultTimeAcc = 0
		for _, a in ipairs(self:Actors()) do
			if not self:IsDown(a) then
				local h = self:HeroOf(a)
				if h ~= nil then h:AddUlt(add) end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void TryFreeCasts(Entity actor, Entity monster)
		-- 4-D 보완(C안): 닿지 않는 구성원의 사거리 무관 시전 (궁극기 게이지 가득 → 궁극기, 아니면 쿨타임형 스킬 1개).
		-- 대상이 필요한 궁극기·하이퍼는 앞쪽 살아 있는 몬스터(맨 앞, 없으면 대기열의 아무 몬스터)를 대상으로 쓴다.
		if not self:IsHeroRun() then return end
		local hero = self:HeroOf(actor)
		if hero == nil then return end
		local target = monster
		local tm = isvalid(target) and target:GetComponent("script.TowerMonster") or nil
		if tm == nil or tm.IsDead then
			target = nil
			for _, e in ipairs(self._T.queue or {}) do
				local qm = isvalid(e) and e:GetComponent("script.TowerMonster") or nil
				if qm ~= nil and not qm.IsDead then
					target = e
					break
				end
			end
		end
		if not isvalid(target) then return end
		local list = hero:RollFreeCasts(self)
		if #list == 0 then return end
		local pc = actor:GetComponent("script.TowerPlayer")
		if pc == nil then return end
		pc:DoCast(target, list)
		self:SetBusy(actor, math.max(self.SkillCastGap, hero:LastActionTime() + 0.05))
		local ids = {}
		for _, r in ipairs(list) do table.insert(ids, tostring(r.id)) end
		log("[VRF] free cast " .. actor.Name .. " job=" .. tostring(hero.JobId) .. " ids=" .. table.concat(ids, ","))
	end

	@ExecSpace("ServerOnly")
	method number ActorInterval(Entity actor)
		-- 기본 공격 간격 (보스 개편: 해일 실패 후 잠깐 느려짐)
		local slow = 1
		local mech = self:GetMech()
		if mech ~= nil then slow = mech:ActorIntervalMul() end
		return slow * self.AttackCooldown / math.max(0.1, self.WeaponSpeed * (1 + (self:Bonus("Speed") + self:GoddessBonus(actor, "Speed")) / 100))
	end

	@ExecSpace("ServerOnly")
	method integer ActorHitDamage(Entity actor)
		-- 이번 타격 피해: 공격력(최소~최대) × 몬스터 방어 감소 × 각인 추가 피해(체력 30% 이하 적 / 엘리트).
		-- 직업 스킬 '화염 마력': 몬스터 방어력 일부 무시
		-- 전투 능력치 개편: 구성원 기본 공격 타입(물리/마법)에 맞는 몬스터 방어로 감소 (스킬 타입이 다르면 CombatMul이 비율 보정)
		local defCut = self:DefFactor(self:HitProfile(actor, "").baseAtk, actor)
		local atk = self:ActorAtk(actor)
		local minAtk = math.max(1, math.floor(atk * (0.2 + 0.8 * self.Mastery / 100) + 0.5))
		local dmg = (minAtk + _UtilLogic:RandomDouble() * (atk - minAtk)) * defCut
		local mul = 1
		-- 직업 스킬 '투혼': 내 체력 50% 이하일 때 주는 피해 증가
		if self:ActorHp(actor) < self:ActorMaxHp(actor) * 0.5 then mul = mul + self:Bonus("LowHpAtk") / 100 end
		if self.MonsterHp <= self.MonsterMaxHp * self.LowHpDmgRatio then mul = mul + self:Bonus("LowHpDmg") / 100 end
		if self.MonsterElite then mul = mul + (self:Bonus("EliteDmg") + self:SlotMileDelta(actor, "EliteDmg") + self:AccessoryBonus(actor, "EliteDmg")) / 100 end
		-- 펫 P-C: 반반(보스 피해) — 스킬 피해도 이 값을 기준으로 하므로 보스에게 주는 모든 타격에 적용
		if self.MonsterBoss then mul = mul + self:PetEffect("BossDmg") / 100 end
		-- 공용 패시브 돌파 '충만한 힘': 체력이 가득할 때 공격력 증가
		if self:ActorHp(actor) >= self:ActorMaxHp(actor) then mul = mul + self:Bonus("FullHpAtk") / 100 end
		-- 이 층 심볼: 주는 피해 증가
		mul = mul + (self._T.symDmg or 0) / 100
		return math.max(1, math.floor(dmg * mul + 0.5))
	end


	@ExecSpace("ServerOnly")
	method string GoddessName(string id)
		local names = { A_Heal = "회복의 축복", A_Atk = "용기의 축복", A_Def = "수호의 축복", A_Hp = "생명의 축복", A_Crit = "통찰의 축복", A_Meso = "풍요의 축복", A_Stone = "깨달음의 축복",
			D_Heal = "재생의 계약", D_Atk = "금단의 힘", D_Hp = "불멸의 육체", D_Crit = "금단의 눈", D_Speed = "광기의 계약", D_Meso = "탐욕의 계약", D_Stone = "지식의 계약" }
		return names[id] or "여신의 제안"
	end

	@ExecSpace("ServerOnly")
	method boolean GoddessIsBad(string effect, number value)
		return effect == "HpCost" or (effect == "DmgTaken" and value > 0) or (effect ~= "DmgTaken" and value < 0)
	end

	@ExecSpace("ServerOnly")
	method string GoddessEffectText(string effect, number value)
		local names = { AtkPct = "공격력", DefPct = "방어력", HpPct = "최대 체력", Crit = "크리티컬 확률", Speed = "공격 속도", MesoPct = "메소 획득", DmgTaken = "받는 피해" }
		local numberText = string.format("%g", math.abs(value))
		if effect == "Heal" then return "최대 체력의 " .. numberText .. "% 회복" end
		if effect == "HpCost" then return "현재 체력 " .. numberText .. "% 소모" end
		-- 4-B 보완: 판 안 스킬 카드 대신 돌파 선택 (거래표 A/D/M_Stone 문구와 같은 뜻)
		if effect == "SkillPick" then return "돌파 선택 +" .. numberText .. "회" end
		if effect == "MesoGain" then return "메소 +" .. numberText end
		return (names[effect] or effect) .. (value >= 0 and " +" or " -") .. numberText .. (effect == "Crit" and "%p" or "%")
	end

	@ExecSpace("ServerOnly")
	method table BuildGoddessOffer(table deal, integer target)
		local offer = { id = deal.id, kind = deal.kind, name = self:GoddessName(deal.id), target = target, targetLabel = self:GoddessActorLabel(target), scope = target == 0 and "전체 적용" or "무작위 1명", effects = {} }
		for _, e in ipairs(deal.effects) do
			local value = e.value
			local bad = self:GoddessIsBad(e.type, value)
			if target > 0 and not bad then value = value * self.GoddessSingleScale end
			-- 각인 탐험 루트 '축복': 여신 제안의 이로운 효과 +%
			if not bad then value = value * (1 + self:Bonus("GoddessUp") / 100) end
			local instant = e.type == "Heal" or e.type == "HpCost" or e.type == "SkillPick" or e.type == "MesoGain"
			if e.type == "MesoGain" then value = math.floor(self:KillMeso() * value + 0.5) end
			if e.type == "SkillPick" then value = math.floor(value) end
			local stages = e.type == "DmgTaken" and deal.stages or 0
			table.insert(offer.effects, { type = e.type, value = value, bad = bad, instant = instant, left = stages, text = self:GoddessEffectText(e.type, value), duration = instant and "즉시 적용" or stages > 0 and ("다음 " .. tostring(stages) .. "웨이브") or "이번 판 동안" })
		end
		return offer
	end

	@ExecSpace("ServerOnly")
	method void SyncGoddessEffects()
		local list = {}
		local curses = {}
		for _, e in ipairs(self._T.goddessEffects or {}) do
			table.insert(list, { name = e.name, text = self:GoddessEffectText(e.type, e.value), bad = e.bad, targetLabel = e.targetLabel, left = e.left, duration = e.left > 0 and ("남은 " .. tostring(e.left) .. "웨이브") or "이번 판 동안" })
			if e.bad then table.insert(curses, self:GoddessEffectText(e.type, e.value) .. " · " .. e.targetLabel .. (e.left > 0 and (" · " .. tostring(e.left) .. "웨이브") or "")) end
		end
		self.CurseText = table.concat(curses, " / ")
		self.GoddessEffectsJson = #list == 0 and "[]" or _HttpService:JSONEncode(list)
		self.GoddessEffectsSeq = self.GoddessEffectsSeq + 1
	end

	@ExecSpace("ServerOnly")
	method void ResetGoddessEffects()
		self._T.goddessEffects = {}
		self._T.goddessOffers = {}
		self.GoddessOffersJson = "{}"
		self:SyncGoddessEffects()
	end


	-- ───────────────────────── 4단계 테스트 함수 (server_main에서 호출) ─────────────────────────

	-- ===== 보스 개편 (Docs/Boss/Boss-Stage-Spec.md): 필드보스·보스전 =====

	@ExecSpace("ServerOnly")
	method void LoadBossTables()
		-- BossTable(보스전 5종)·BossStepTable(단계 배율)·BossConfig(제한 시간 등)를 읽는다.
		self._T.bossRows = {}
		self._T.bossSteps = {}
		self._T.bossCfg = {}
		local bt = _DataService:GetTable("BossTable")
		if bt ~= nil then
			for i = 1, bt:GetRowCount() do
				local id = bt:GetCell(i, "BossId") or ""
				if id ~= "" then
					self._T.bossRows[id] = { id = id, name = bt:GetCell(i, "Name") or id, monsterId = bt:GetCell(i, "MonsterId") or "",
						unlockFloor = math.max(1, math.floor(tonumber(bt:GetCell(i, "UnlockFloor")) or 1)),
						bg = bt:GetCell(i, "BgRUID") or "", ts = bt:GetCell(i, "TileSetRUID") or "", elem = bt:GetCell(i, "Elem") or "",
						defP = tonumber(bt:GetCell(i, "DefP") or "") or 0, defM = tonumber(bt:GetCell(i, "DefM") or "") or 0, evade = tonumber(bt:GetCell(i, "Evade") or "") or 0,
						mech1 = bt:GetCell(i, "Mech1") or "", mech2 = bt:GetCell(i, "Mech2") or "", scale = tonumber(bt:GetCell(i, "Scale") or "") or self.BossScale }
				end
			end
		end
		local st = _DataService:GetTable("BossStepTable")
		if st ~= nil then
			for i = 1, st:GetRowCount() do
				local n = math.floor(tonumber(st:GetCell(i, "Step")) or i)
				self._T.bossSteps[n] = { hp = tonumber(st:GetCell(i, "HpMul")) or 1, atk = tonumber(st:GetCell(i, "AtkMul")) or 1 }
			end
		end
		local cf = _DataService:GetTable("BossConfig")
		if cf ~= nil then
			for i = 1, cf:GetRowCount() do
				local k = cf:GetCell(i, "Key")
				local v = tonumber(cf:GetCell(i, "Value"))
				if k ~= nil and v ~= nil then self._T.bossCfg[k] = v end
			end
		end
		local n = 0
		for _, _ in pairs(self._T.bossRows) do n = n + 1 end
		log("[VRF] boss tables rows=" .. tostring(n) .. " timeLimit=" .. tostring(self._T.bossCfg["TimeLimit"]))
	end

	@ExecSpace("ServerOnly")
	method Component GetMech()
		-- 같은 맵 엔티티의 보스 기믹 컴포넌트 (없으면 nil).
		return self.Entity:GetComponent("script.BossMechanics")
	end

	@ExecSpace("ServerOnly")
	method Component GetBoss()
		-- 플레이어의 보스전 계정 데이터 (PlayerBoss).
		local p = self._T.player
		if not isvalid(p) then p = self:FindPlayer() end
		if not isvalid(p) then return nil end
		return p:GetComponent("script.PlayerBoss")
	end

	@ExecSpace("ServerOnly")
	method Entity FrontMonster()
		-- 지금 맨 앞 몬스터.
		return self._T.monster
	end

	@ExecSpace("ServerOnly")
	method void BossMaxSkills()
		-- 보스전 시작: 구성원마다 장착 스킬을 최대 레벨까지 자동 성장 (별 옵션은 기존 자동 성장과 같은 무작위, 돌파 레벨은 돌파 없이 레벨만).
		local total = 0
		for _, h in ipairs(self:Heroes()) do
			for _, sk in ipairs(self._T.jobSkills[h.JobId] or {}) do
				if h:Equipped(sk.id) then
					local guard = 0
					while (self.SkillLv[sk.id] or 0) < sk.max and guard < 50 do
						guard = guard + 1
						local mode = self:RollCardOption(sk)
						if mode ~= "break" and mode ~= "learn" then
							local o = self._T.starById[mode]
							if o ~= nil then
								self:ApplySkillOption(sk, o.effect, o.value)
								if self._T.starCount[sk.id] == nil then self._T.starCount[sk.id] = {} end
								self._T.starCount[sk.id][o.id] = (self._T.starCount[sk.id][o.id] or 0) + 1
							end
						end
						self.SkillLv[sk.id] = (self.SkillLv[sk.id] or 0) + 1
						total = total + 1
					end
					self:UpdateSkillInfo(sk)
				end
			end
		end
		self:RecalcStats()
		log("[VRF] boss max skills levels+" .. tostring(total))
	end

	@ExecSpace("ServerOnly")
	method void SetupRunMode()
		-- 이번 판 종류: 다시 도전 > 디버그 > 로비 예약(PlayerBoss.PendingBoss "B1:1") 순서로 보스전을 찾고, 없으면 일반 판.
		self.RunMode = "normal"
		self.BossRunId = ""
		self.BossRunStep = 0
		self.BossResult = ""
		self._T.bossRow = nil
		self._T.bossRun = nil
		local spec = nil
		if self._T.retryBoss ~= nil then
			spec = self._T.retryBoss
			self._T.retryBoss = nil
		elseif self._T.debugBoss ~= nil then
			spec = self._T.debugBoss
			self._T.debugBoss = nil
		else
			local pb = self:GetBoss()
			if pb ~= nil then
				local p = pb:TakePending()
				local id, st = string.match(p or "", "^([^:]+):(%d+)$")
				if id ~= nil then spec = { id = id, step = math.floor(tonumber(st)), debug = false } end
			end
		end
		if spec == nil then return end
		local row = (self._T.bossRows or {})[spec.id]
		if row == nil then
			log_warning("[VRF] boss run unknown id=" .. tostring(spec.id))
			return
		end
		self.RunMode = "boss"
		self.BossRunId = spec.id
		self.BossRunStep = math.max(1, spec.step)
		self._T.bossRow = row
		self._T.bossRun = { id = spec.id, step = self.BossRunStep, debug = spec.debug == true }
		log("[VRF] boss run setup id=" .. spec.id .. " step=" .. tostring(self.BossRunStep) .. " floor=" .. tostring(row.unlockFloor) .. " debug=" .. tostring(spec.debug == true))
	end

	@ExecSpace("ServerOnly")
	method string WeakText(table elem)
		-- 속성 상성 표 → 약점 속성 Id "Holy|Fire" (최대 2개, 정해진 순서).
		local out = {}
		if elem == nil then return "" end
		for _, k in ipairs({ "Fire", "Ice", "Lightning", "Poison", "Holy", "Dark" }) do
			if elem[k] == "W" and #out < 2 then table.insert(out, k) end
		end
		return table.concat(out, "|")
	end

	@ExecSpace("ServerOnly")
	method void OnBossFront(Entity monster, table info)
		-- 보스가 맨 앞에 섰을 때: 보스전이면 단계 배율·BossTable 방어·회피·속성·크기로 덮어쓰고 기믹 시작, 필드보스면 예고 강타만.
		local mech = self:GetMech()
		if self.RunMode == "boss" and self._T.bossRow ~= nil then
			local row = self._T.bossRow
			local st = (self._T.bossSteps or {})[self.BossRunStep] or { hp = 1, atk = 1 }
			self.MonsterMaxHp = math.max(1, math.floor(self.MonsterMaxHp * st.hp + 0.5))
			self.MonsterHp = self.MonsterMaxHp
			self.MonsterAtk = math.max(1, math.floor(self.MonsterAtk * st.atk + 0.5))
			self._T.monsterDefP = row.defP * self.BossDefMul
			self._T.monsterDef = self._T.monsterDefP
			self._T.monsterDefM = row.defM * self.BossDefMul
			self._T.monsterEvade = row.evade
			local ni = {}
			for k, v in pairs(info) do ni[k] = v end
			ni.elem = self:ParseElemTable(row.elem)
			self._T.monInfo = ni
			if self._T.infoOf == nil then self._T.infoOf = {} end
			self._T.infoOf[monster] = ni
			monster.TransformComponent.Scale = Vector3(row.scale, row.scale, 1)
			self.MonsterLabel = row.name
			if mech ~= nil then mech:Begin(true, row.mech1, row.mech2, self:WeakText(ni.elem), (self._T.bossCfg or {})["TimeLimit"] or 180) end
			log("[VRF] boss mode spawn " .. row.id .. " step=" .. tostring(self.BossRunStep) .. " hp=" .. tostring(self.MonsterMaxHp) .. " atk=" .. tostring(self.MonsterAtk) .. " defP=" .. tostring(self._T.monsterDefP) .. " defM=" .. tostring(self._T.monsterDefM) .. " evade=" .. tostring(row.evade) .. " elem=" .. row.elem)
			return
		end
		if mech ~= nil then mech:Begin(false, "", "", self:WeakText(info.elem), 0) end
	end

	@ExecSpace("ServerOnly")
	method void BossHitActor(Entity a, integer dmg)
		-- 보스 기믹 피해를 구성원 한 명에게 (숫자 표시 + 보호막·쓰러짐 판정은 기존 경로).
		if not isvalid(a) or dmg <= 0 then return end
		if a == self._T.player then
			local tp = a:GetComponent("script.TowerPlayer")
			if tp ~= nil then tp:ShowProcDamage(a, dmg, false, tp:Uid()) end
			self:ApplyPlayerDamage(dmg)
		else
			self:ApplyMateDamage(a, dmg)
		end
	end

	@ExecSpace("ServerOnly")
	method integer BossSummon(integer n)
		-- 머쉬맘 소환: 소환물(주황버섯)을 몬스터 2·3칸에 세운다 (살아 있는 소환물 포함 n마리까지). 소환물은 공격하지 않고 보스를 보호한다.
		local info = self._T.monsterById[self.BossSummonMonsterId]
		if info == nil then return 0 end
		if self._T.summonOf == nil then self._T.summonOf = {} end
		local alive = 0
		for e, _ in pairs(self._T.summonOf) do
			if isvalid(e) then alive = alive + 1 end
		end
		local spawned = 0
		local queue = self._T.queue or {}
		self._T.queue = queue
		for k = 1, n do
			if alive >= n then break end
			self.SpawnSeq = self.SpawnSeq + 1
			local x = self.MonsterPos.x + self.SpawnOffsetX + k * 0.3
			local m = _SpawnService:SpawnByModelId(self.MonsterModelId, "TowerSummon_" .. tostring(self.SpawnSeq), Vector3(x, self.MonsterPos.y, self.MonsterPos.z), self.Entity)
			if m ~= nil then
				if self._T.infoOf == nil then self._T.infoOf = {} end
				self._T.infoOf[m] = info
				self._T.summonOf[m] = true
				local mc = m:GetComponent("script.TowerMonster")
				if mc ~= nil then
					mc.MoveRUID = info.move or ""
					mc.AttackRange = math.min(3, 1 + alive + 1)
					mc:ApplyLook(info.stand, info.attack, info.hit, info.die, info.hitSound, info.dieSound)
					mc.SpeedMul = 1
					mc.SlotJitter = 0
					mc.IsQueued = true
					mc.IsRanged = false
					local hp = self:MonsterBaseHp(info) * 3
					mc.MaxHp = hp
					mc.Hp = hp
					mc.AtkTimer = 1000000
				end
				local sprite = m.SpriteRendererComponent
				if isvalid(sprite) then sprite.OrderInLayer = 1 end
				table.insert(queue, m)
				alive = alive + 1
				spawned = spawned + 1
			end
		end
		if spawned > 0 then self:LayoutWave() end
		return spawned
	end

	@ExecSpace("ServerOnly")
	method boolean BossSummonAlive()
		-- 살아 있는 보스 소환물이 있는지.
		for e, _ in pairs(self._T.summonOf or {}) do
			if isvalid(e) then
				local mc = e:GetComponent("script.TowerMonster")
				if mc ~= nil and not mc.IsDead then return true end
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method void BossClearSummons()
		-- 보스 소환물을 모두 없앤다 (보스 처치·판 끝).
		local list = {}
		for e, _ in pairs(self._T.summonOf or {}) do table.insert(list, e) end
		self._T.summonOf = {}
		if #list == 0 then return end
		local queue = self._T.queue or {}
		for _, e in ipairs(list) do
			for i = #queue, 1, -1 do
				if queue[i] == e then table.remove(queue, i) end
			end
			if isvalid(e) then e:Destroy() end
		end
		log("[VRF] boss summons cleared n=" .. tostring(#list))
	end

	@ExecSpace("ServerOnly")
	method integer BossFrontRange(integer r)
		-- 맨 앞 보스가 설 칸을 바꾼다 (날아오르기). 이전 칸을 돌려준다.
		local m = self._T.monster
		local mc = isvalid(m) and m:GetComponent("script.TowerMonster") or nil
		if mc == nil then return 1 end
		local prev = mc.AttackRange
		mc.AttackRange = math.max(1, math.min(3, r))
		self:LayoutWave()
		return prev
	end

	@ExecSpace("ServerOnly")
	method void BossHoldAttack(number sec)
		-- 그로기: 보스 다음 공격을 최소 sec초 뒤로 미룬다.
		self.MonsterAttackTimer = math.max(self.MonsterAttackTimer, sec)
	end

	@ExecSpace("ServerOnly")
	method void BossMulInterval(number m)
		-- 분노: 보스 공격 간격 배율.
		self._T.monsterInterval = (self._T.monsterInterval or self.MonsterAttackInterval) * m
	end

	@ExecSpace("ServerOnly")
	method void BossTimeout()
		-- 보스전 제한 시간 초과 = 실패.
		log("[VRF] boss mode timeout")
		self:Defeat()
	end

	@ExecSpace("ServerOnly")
	method void BossModeClear()
		-- 보스전 클리어: 기믹·소환물 정리 → PlayerBoss 정산(도전권 1장·최고 단계·첫 처치 다이아·보상) → 결과 팝업.
		if self._T.stageEnding then return end
		self._T.stageEnding = true
		local mech = self:GetMech()
		if mech ~= nil then mech:End() end
		self:BossClearSummons()
		self:DestroyMonster()
		for _, h in ipairs(self:Heroes()) do h:ClearState() end
		local br = self._T.bossRun or { id = self.BossRunId, step = self.BossRunStep, debug = false }
		local goldBase = (self.GoldMesoStageBase + self.Floor * self.GoldMesoPerFloor) * self.GoldMesoBossMul
		local pb = self:GetBoss()
		local res = ""
		if pb ~= nil then res = pb:Settle(br.id, br.step, goldBase, self._T.debugRun == true) end
		self.BossResult = res
		local v = {}
		for x in string.gmatch(res, "[^:]+") do table.insert(v, x) end
		local function n(i) return math.floor(tonumber(v[i] or "0") or 0) end
		self.RunGoldMeso = n(3)
		self.RunCubes = n(7)
		self.RunScrolls = n(8) + n(9) + n(10)
		self.RunDiamonds = n(11)
		self:SettleAccount(true)
		local elapsed = _UtilLogic.ElapsedSeconds - (self._T.runStartAt or _UtilLogic.ElapsedSeconds)
		local hpRatio = self.PlayerMaxHp > 0 and self.PlayerHp / self.PlayerMaxHp or 0
		self.ResultFloor = self.Floor
		self.ResultTime = elapsed
		self.ResultHpPct = math.floor(hpRatio * 100 + 0.5)
		self.ResultStarsPrev = 0
		self.ResultStarsNow = 0
		self.IsStageClear = true
		self._T.stageCleared = true
		self.RunState = "RESULT"
		if res == "" then log_warning("[VRF] boss mode clear but settle failed boss=" .. tostring(br.id)) end
		log("[VRF] boss mode clear boss=" .. tostring(br.id) .. " step=" .. tostring(br.step) .. " time=" .. string.format("%.1f", elapsed) .. " result=" .. res .. " debugRun=" .. tostring(self._T.debugRun == true))
	end

	@ExecSpace("ServerOnly")
	method void DebugStartBoss(string bossId, integer step)
		-- 테스트: 해금·도전권 검사 없이 보스전을 시작한다 (디버그 판: 차감·저장·지급 없음). 탑 맵 READY 이후, 다음 틱 타이머 안에서 실행.
		_TimerService:SetTimerOnce(function()
			self._T.debugBoss = { id = bossId, step = math.max(1, step), debug = true }
			log("[VRF] debug start boss=" .. bossId .. " step=" .. tostring(step))
			self:StartRun()
		end, 0)
	end

	@ExecSpace("ServerOnly")
	method void DebugStartFloor(integer floor)
		-- 테스트: 열린 층 제한 없이 그 층으로 판을 다시 시작한다 (탑 맵, READY 이후).
		-- 4-B 보완: 메이커 스크립트에서 바로 부르면 여러 프레임에 걸쳐 판 상태를 덮어쓰므로 다음 틱 타이머 안에서 한 번에 실행
		_TimerService:SetTimerOnce(function()
			self._T.debugFloor = math.max(1, floor)
			log("[VRF] debug start floor=" .. tostring(floor))
			self:StartRun()
		end, 0)
	end

	@ExecSpace("ServerOnly")
	method void DebugClearWave()
		-- 테스트: 지금 웨이브를 바로 끝낸다 (대기열 처치, 남은 묶음 비움, 맨 앞 몬스터 처치). 다음 틱 타이머 안에서 실행.
		_TimerService:SetTimerOnce(function() self:DebugClearWaveNow() end, 0)
	end

	@ExecSpace("ServerOnly")
	method void DebugClearWaveNow()
		-- DebugClearWave 본체 (타이머 안에서 한 프레임에 끝낸다).
		if self.RunState ~= "FIGHT" then
			log("[VRF] debug clear wave skipped state=" .. self.RunState)
			return
		end
		-- 먼저 남은 출전·묶음을 모두 '나온 것'으로 막아 KillQueued의 빈자리 채우기가 새 몬스터를 만들지 않게 한다
		self._T.groups = { self._T.waveSize or 0 }
		self._T.groupIdx = 1
		self._T.released = self._T.waveSize or 0
		self._T.waveSpawned = self._T.waveSize or 0
		local q = {}
		for _, e in ipairs(self._T.queue or {}) do table.insert(q, e) end
		for _, e in ipairs(q) do
			if isvalid(e) then self:KillQueued(e) end
		end
		self._T.waveLeft = 0
		log("[VRF] debug clear wave floor=" .. tostring(self.Floor) .. " stage=" .. tostring(self.Stage) .. " wave=" .. tostring(self._T.waveNo))
		self:ApplyMonsterDamage(math.floor(self.MonsterHp + 1))
	end

	@ExecSpace("ServerOnly")
	method void DebugFinishFloor()
		-- 테스트: 보스 스테이지 마지막 웨이브로 바꾼 뒤 웨이브를 끝내 층 클리어·결과 화면까지 진행. 다음 틱 타이머 안에서 실행.
		_TimerService:SetTimerOnce(function()
			if self.RunState ~= "FIGHT" then
				log("[VRF] debug finish floor skipped state=" .. self.RunState)
				return
			end
			self.Stage = self.StagesPerFloor
			self.StageKind = "boss"
			self._T.waveNo = self.WavesPerStage
			log("[VRF] debug finish floor=" .. tostring(self.Floor))
			self:DebugClearWaveNow()
		end, 0)
	end

	@ExecSpace("ServerOnly")
	method void DebugGod(boolean on)
		-- 테스트: 구성원 무적.
		_TimerService:SetTimerOnce(function()
			self._T.debugGod = on
			log("[VRF] debug god=" .. tostring(on))
		end, 0)
	end

	@ExecSpace("ServerOnly")
	method void DebugSetBonus(string effType, number v)
		-- 테스트: 효과 합계에 값을 더한다 (0이면 끔).
		_TimerService:SetTimerOnce(function()
			if self._T.debugBonus == nil then self._T.debugBonus = {} end
			self._T.debugBonus[effType] = v
			log("[VRF] debug bonus " .. effType .. "=" .. tostring(v))
		end, 0)
	end

	@ExecSpace("ServerOnly")
	method void DebugDumpParty()
		-- 테스트: 구성원별 직업·차수·레벨·능력치·장착을 로그로. 다음 틱 타이머 안에서 실행.
		_TimerService:SetTimerOnce(function() self:DebugDumpPartyNow() end, 0)
	end

	@ExecSpace("ServerOnly")
	method void DebugDumpPartyNow()
		-- DebugDumpParty 본체.
		for k, e in ipairs(self:Actors()) do
			local h = self:HeroOf(e)
			local job = h ~= nil and h.JobId or "?"
			local d = self:RunDataFor(job) or {}
			local equip = h ~= nil and table.concat(h._T.equip or {}, ",") or ""
			local hidden = {}
			if h ~= nil then
				for id, v in pairs(h._T.hidden or {}) do if v then table.insert(hidden, id) end end
			end
			local passiveLv = 0
			if h ~= nil then
				if job == "Hero" then passiveLv = h.ComboLv elseif job == "Bishop" then passiveLv = h.HolyLv else passiveLv = h.PassiveLv end
			end
			-- 4-E: 패시브 차수 강화 키
			local extra = {}
			if h ~= nil then
				for kx, v in pairs(h._T.pExtra or {}) do if v then table.insert(extra, kx) end end
			end
			table.insert(hidden, "|extra=" .. table.concat(extra, "+"))
			local base = (self._T.actorBase or {})[e] or {}
			log("[VRF] party k=" .. tostring(k) .. " job=" .. job .. " tier=" .. tostring(d.tier) .. " lv=" .. tostring(d.level) .. " label=" .. tostring(d.tierName)
				.. " atk=" .. string.format("%.1f", self:ActorAtk(e)) .. " baseAtk=" .. string.format("%.1f", base.atk or 0) .. " maxHp=" .. tostring(self:ActorMaxHp(e)) .. " def=" .. string.format("%.1f", self:ActorDefense(e))
				.. " gearSlot=" .. tostring(self:ActorSlotNo(e)) .. " weaponLv=" .. tostring(self:GearSlotLv("Weapon", self:ActorSlotNo(e))) .. " weaponAtk=" .. string.format("%.1f", self:EquipStatFor("Weapon", self:ActorSlotNo(e)))
				.. " crit=" .. string.format("%.1f", self:ActorCrit(e)) .. " critDmg=" .. string.format("%.1f", self:ActorCritDmg(e))
				.. " charAtk=" .. tostring(d.atk) .. " charHp=" .. tostring(d.hp) .. " charDef=" .. tostring(d.def)
				.. " equip=" .. equip .. " hidden=" .. table.concat(hidden, ",") .. " passiveLv=" .. tostring(passiveLv) .. " active=" .. tostring(h ~= nil and h.Active)
				.. " runLv=" .. tostring(h ~= nil and h.RunLevel or 0) .. " runLabel=" .. tostring(h ~= nil and h.RunLabel or "") .. " ult=" .. tostring(h ~= nil and (h._T.ultId or "") or "") .. " gauge=" .. tostring(h ~= nil and h.UltGauge or 0) .. "/" .. tostring(h ~= nil and h.UltMax or 0))
		end
		log("[VRF] party main Level=" .. tostring(self.Level) .. " PlayerAtk=" .. tostring(self.PlayerAtk) .. " PlayerMaxHp=" .. tostring(self.PlayerMaxHp) .. " CompanionMaxHp=" .. tostring(self.CompanionMaxHp) .. " Companion2MaxHp=" .. tostring(self.Companion2MaxHp))
	end

	@ExecSpace("ServerOnly")
	method void DebugFillUlt()
		-- 테스트(4-D): 구성원 전원 궁극기 게이지를 가득 채운다 (궁극기 칸이 없으면 변화 없음). 다음 틱 타이머 안에서 실행.
		_TimerService:SetTimerOnce(function()
			local parts = {}
			for _, h in ipairs(self:Heroes()) do
				if h._T.ultId ~= nil then h.UltGauge = h.UltMax end
				table.insert(parts, h.JobId .. ":" .. tostring(h._T.ultId or "-") .. ":" .. tostring(h.UltGauge))
			end
			log("[VRF] debug fill ult " .. table.concat(parts, ","))
		end, 0)
	end

	@ExecSpace("ServerOnly")
	method void DebugSwapSlot(string job, string slot, string skillId)
		-- 테스트(4-F): 그 직업 구성원의 칸 스킬을 skillId로 바꾼다 (판 중 진화 흉내). 칸에 붙은 돌파는 새 스킬에 이어진다. 다음 틱 타이머 안에서 실행.
		_TimerService:SetTimerOnce(function()
			for _, h in ipairs(self:Heroes()) do
				if h.JobId == job then
					local old = h:SwapSlot(self, slot, skillId)
					if old == "" or old == skillId then
						log_warning("[VRF] debug swap failed " .. job .. "." .. slot .. " old=" .. old .. " new=" .. skillId)
						return
					end
					-- 스킬 개편: 새 스킬 Id는 동작 기준 Id로 장착된다 (돌파 키·표시는 동작 Id 기준)
					local baseId = (h._T.baseOf or {})[skillId] or ""
					if baseId ~= "" then skillId = baseId end
					self:RegisterSkillAlias(job, h._T.dataOf or {})
					if self._T.slotKeyOf ~= nil then self._T.slotKeyOf[old] = nil end
					self:RegisterSlots(job, h._T.slotOf)
					-- 표시용 Sync: 새 스킬 Id 기준으로 칸에 붙은 돌파 목록을 다시 적는다 (새 스킬에 없는 번호는 기록만 남음)
					local sk = self._T.skillById[skillId]
					local ids = {}
					local t = (self._T.breakTaken or {})[self:BreakKey(skillId)] or {}
					for n, v in pairs(t) do
						local bid = skillId .. "_B" .. tostring(n)
						if v and self._T.breakById[bid] ~= nil then table.insert(ids, bid) end
					end
					table.sort(ids)
					self.SkillBreaks[skillId] = table.concat(ids, ",")
					if sk ~= nil then self:UpdateSkillInfo(sk) end
					log("[VRF] debug swap " .. job .. "." .. slot .. " " .. old .. "->" .. skillId .. " key=" .. self:BreakKey(skillId) .. " breaks=" .. table.concat(ids, ","))
					return
				end
			end
			log_warning("[VRF] debug swap no member job=" .. job)
		end, 0)
	end

	@ExecSpace("ServerOnly")
	method void DebugDumpBreaks()
		-- 테스트(4-F): 칸 키별로 붙은 돌파 번호를 로그로. 다음 틱 타이머 안에서 실행.
		_TimerService:SetTimerOnce(function()
			local parts = {}
			for key, t in pairs(self._T.breakTaken or {}) do
				local ns = {}
				for n, v in pairs(t) do if v then table.insert(ns, tostring(n)) end end
				table.sort(ns)
				table.insert(parts, key .. "=" .. table.concat(ns, "+"))
			end
			table.sort(parts)
			local maps = {}
			for id, key in pairs(self._T.slotKeyOf or {}) do table.insert(maps, id .. ">" .. key) end
			table.sort(maps)
			log("[VRF] debug breaks dump " .. table.concat(parts, " ") .. " | slots " .. table.concat(maps, " "))
		end, 0)
	end

	@ExecSpace("ServerOnly")
	method void DebugDpsProbe(number sec)
		-- 테스트: sec초 동안 준 피해·받은 피해를 재서 로그 (normalHp = 지금 층 일반 몬스터 기본 체력).
		self._T.probe = { t0 = _UtilLogic.ElapsedSeconds, dealt = 0, taken = 0, floor = self.Floor, stage = self.Stage }
		log("[VRF] probe start floor=" .. tostring(self.Floor) .. " stage=" .. tostring(self.Stage) .. " sec=" .. tostring(sec))
		_TimerService:SetTimerOnce(function()
			local pr = self._T.probe
			if pr == nil then return end
			local el = math.max(0.001, _UtilLogic.ElapsedSeconds - pr.t0)
			local info = self._T.waveInfo
			if info == nil then
				local floors = self._T.floors or {}
				local fi = self:FloorInStage()
				if #floors >= fi then info = self._T.monsterById[floors[fi].monsterId] end
			end
			local normalHp = info ~= nil and self:MonsterBaseHp(info) or 0
			local dps = pr.dealt / el
			log("[VRF] probe floor=" .. tostring(pr.floor) .. " stage=" .. tostring(pr.stage) .. " sec=" .. string.format("%.1f", el) .. " dealt=" .. tostring(math.floor(pr.dealt)) .. " dps=" .. string.format("%.2f", dps)
				.. " taken=" .. tostring(math.floor(pr.taken)) .. " normalHp=" .. tostring(normalHp) .. " R=" .. string.format("%.4f", normalHp > 0 and dps / normalHp or 0))
			self._T.probe = nil
		end, sec)
	end

end
