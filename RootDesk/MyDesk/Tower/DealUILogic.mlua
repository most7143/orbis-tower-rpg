@Logic
script DealUILogic extends Logic
	property Entity rootEntity = "b72a8e16-4880-4e0f-b051-1d7e1637f10d"
	property ButtonComponent angelBtn = "3dc34c16-9a1f-4d08-8076-cf802ca6e980"
	property ButtonComponent devilBtn = "0e5f05a3-51db-4f7c-b30a-cc770a9b0ca8"
	property ButtonComponent skipBtn = "03d78429-b949-481c-8ebd-8de2fce41e64"
	property string ColPath = "/ui/DealUI/Deal/Col_"
	property string DealTableName = "DealTable"
	@HideFromInspector
	property table clickHandlers = {}

	@ExecSpace("ClientOnly")
	method Entity E(string path)
		return _EntityService:GetEntityByPath("/ui/DealUI/" .. path)
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.clickHandlers = {}
		self:Bind(self.angelBtn, function() self:OnPick("Angel") end)
		self:Bind(self.devilBtn, function() self:OnPick("Devil") end)
		self:Bind(self.skipBtn, function() self:OnPick("") end)
		self._T.shown = nil
		self:Show(false)
		log("[VRF] goddess UI ready two offers target-benefit-cost")
	end

	@ExecSpace("ClientOnly")
	method void Bind(ButtonComponent button, any fn)
		if not isvalid(button) then return end
		local h = button.Entity:ConnectEvent(ButtonClickEvent, function()
			if not button.Enable or self._T.awaiting then return end
			_UISoundLogic:PlayClick()
			fn()
		end)
		table.insert(self.clickHandlers, { entity = button.Entity, eventHandler = h })
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		for _, rec in ipairs(self.clickHandlers) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
		end
		self.clickHandlers = {}
	end

	@ExecSpace("ClientOnly")
	method Component GetManager()
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) then return nil end
		return player.CurrentMap:GetComponent("script.TowerRunManager")
	end

	@ExecSpace("ClientOnly")
	method void Show(boolean on)
		if self._T.shown == on then return end
		self._T.shown = on
		if isvalid(self.rootEntity) then self.rootEntity:SetEnable(on) end
		local dim = self:E("ScreenDim")
		if isvalid(dim) then dim:SetEnable(on) end
		if not on then self._T.seq = nil self._T.awaiting = false end
	end

	@ExecSpace("ClientOnly")
	method void OnPick(string kind)
		local mgr = self:GetManager()
		if mgr == nil or mgr.RunState ~= "DEAL" or self._T.awaiting then return end
		self._T.awaiting = true
		for _, b in ipairs({ self.angelBtn, self.devilBtn, self.skipBtn }) do
			if isvalid(b) then _UIButtonLogic:SetDisabled(b.Entity, true) end
		end
		mgr:RequestDeal(kind)
		log("[VRF] goddess UI picked " .. kind)
	end

	@ExecSpace("ClientOnly")
	method void SetText(string path, string text)
		local e = self:E(path)
		if isvalid(e) then e.TextGUIRendererComponent.Text = text end
	end

	@ExecSpace("ClientOnly")
	method void Fill(Component mgr)
		local ok, offers = pcall(function() return _HttpService:JSONDecode(mgr.GoddessOffersJson) end)
		if not ok or type(offers) ~= "table" then return end
		for _, kind in ipairs({ "Angel", "Devil" }) do
			local offer = offers[kind]
			local p = "Deal/Col_" .. kind
			local good = ""
			local bad = ""
			local goodTime = ""
			local badTime = ""
			if offer ~= nil then
				self:SetText(p .. "/Name", offer.name)
				self:SetText(p .. "/Target", offer.scope .. " · " .. offer.targetLabel)
				for _, effect in ipairs(offer.effects or {}) do
					if effect.bad then bad = string.gsub(effect.text, "최대 체력의 ", "최대 체력 ") badTime = effect.duration
					else good = string.gsub(effect.text, "최대 체력의 ", "최대 체력 ") goodTime = effect.duration end
				end
			else
				self:SetText(p .. "/Name", "제안을 준비하고 있습니다")
				self:SetText(p .. "/Target", "")
			end
			self:SetText(p .. "/Good/Value", good)
			self:SetText(p .. "/Good/Duration", goodTime)
			self:SetText(p .. "/Bad/Value", bad)
			self:SetText(p .. "/Bad/Duration", badTime)
			local button = kind == "Angel" and self.angelBtn or self.devilBtn
			if isvalid(button) then _UIButtonLogic:SetDisabled(button.Entity, offer == nil or self._T.awaiting == true) end
		end
		if isvalid(self.skipBtn) then _UIButtonLogic:SetDisabled(self.skipBtn.Entity, self._T.awaiting == true) end
		self._T.seq = mgr.GoddessOfferSeq
		self._T.snapshot = mgr.GoddessOffersJson
		log("[VRF] goddess UI filled seq=" .. tostring(mgr.GoddessOfferSeq))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		local mgr = self:GetManager()
		local on = mgr ~= nil and mgr.RunState == "DEAL"
		self:Show(on)
		if on and (self._T.seq ~= mgr.GoddessOfferSeq or self._T.snapshot ~= mgr.GoddessOffersJson) then self:Fill(mgr) end
	end
end
