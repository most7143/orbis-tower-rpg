@Logic
script BattleHUDLogic extends Logic

	-- BattleHUD.ui 바인딩 (UIBuilder injectBindings로 주입)
	property UITransformComponent playerHpRoot = "fd12a1b9-016e-4ff0-9ba3-dfe82d0851eb"
	property UITransformComponent playerHpFill = "27e4458d-785b-46c2-9bbb-be2fdb7b5ea2"
	property UITransformComponent monsterHpRoot = "62bebb04-9576-4c10-9446-f8b02cbfd443"
	property UITransformComponent monsterHpFill = "cca7f8e8-b9c2-4b79-a621-f46abb013cb5"
	property TextGUIRendererComponent floorText = "fb49aba7-6fc7-45e2-8865-e10959855b81"

	property TextGUIRendererComponent monsterNameText = "cbf70e54-1861-49ce-9b5c-05e5b41fd380"
	property UITransformComponent monsterTagRoot = "75bbd1c5-758b-478f-8b36-5a117425e0d2"
	property number NameTagHeight = -0.42
	property Color EliteNameColor = Color(1, 0.3, 0.3, 1)
	-- 메소 드롭 연출: MesoDrop 아래 동전 스프라이트 풀을 월드 좌표로 시뮬레이션해 UI에 그린다
	-- 패시브 발동 문구 (처형! / 불사!) — 캐릭터 머리 위로 떠오르며 사라짐
	property TextGUIRendererComponent procText = "469320fb-1d36-4519-ae26-735aa299e477"
	property number ProcTextTime = 1.0
	property Entity mesoRoot = "b1217d7d-2eca-4e3f-bee0-9c3edecba4a0"
	property number MesoGravity = -14
	property number MesoBounce = 0.35
	property number MesoRestTime = 0.45
	property number MesoFlyTime = 0.35

	property string BattleCameraName = "BattleCamera"
	-- 심볼 획득 배너 (SymbolGetSeq 변화 시 SymbolBannerTime초 표시)
	property Entity symbolBanner = "dc905fd0-a537-4061-bd04-0a3405f95e0b"
	property SpriteGUIRendererComponent symbolIcon = "02b1d05d-1cfa-458c-a9b4-4aa22250a84e"
	property TextGUIRendererComponent symbolTitle = "c2d56c73-1116-48f0-b103-132d67dcb556"
	property TextGUIRendererComponent symbolSub = "924204c8-86cd-44de-a85d-301d634a9d30"
	property number SymbolBannerTime = 3.0
	property number BarWidth = 62
	-- 몬스터 체력바 크기 배율 (캐릭터 체력은 하단 바로 옮겨 머리 위 바는 숨김)
	property number MonsterBarScale = 1
	-- 맨 앞이 아닌 웨이브 몬스터 체력바 크기 (맨 앞 대비)
	property number QueueBarScale = 0.75
	-- 새 HUD: 몬스터 체력바는 머리 위(시각적 꼭대기 + MonsterBarGap px), 이름표는 발밑(- NameTagGap px)
	property number MonsterBarGap = 32
	property number NameTagGap = 32
	property boolean ShowPlayerOverheadBar = false
	property number PlayerBarHeight = -0.22
	property number MonsterBarHeight = -0.22
	-- 가로 화면 전투 카메라: 확대 비율과 카메라 중심(지면이 화면 가운데보다 조금 아래에 오도록)
	property number PcZoomRatio = 150
	property number MobileZoomRatio = 130
	property Vector3 BattleCamPos = Vector3(0, 1.0, 0)

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 판이 시작되기 전까지 HP 바를 숨긴다.
		self._T.viewMap = ""
		self._T.keysRemoved = false
		if isvalid(self.playerHpRoot) then self.playerHpRoot.Entity:SetEnable(false) end
		if isvalid(self.monsterHpRoot) then self.monsterHpRoot.Entity:SetEnable(false) end
		self._T.coins = {}
		self._T.lastKillSeq = nil
		if isvalid(self.mesoRoot) then
			for _, child in ipairs(self.mesoRoot.Children:ToTable()) do
				child:SetEnable(false)
				table.insert(self._T.coins, { entity = child, active = false })
			end
		end
		self:ConnectSlotTips()
		self:ConnectBossHud()
		log("[VRF] BattleHUDLogic begin (client) coins=" .. tostring(#self._T.coins))
	end

	@ExecSpace("ClientOnly")
	method void ConnectSlotTips()
		-- 구성원 패널 스킬 칸(P1~P3 / S1~S8)을 누르면 스킬 상세 툴팁. 전투는 계속 진행된다.
		self._T.slotTipHandlers = {}
		for k = 1, 3 do
			for i = 1, 8 do
				local e = _EntityService:GetEntityByPath("/ui/BattleHUD/Members/P" .. tostring(k) .. "/S" .. tostring(i))
				if isvalid(e) then
					local ck = k
					local ci = i
					local h = e:ConnectEvent(ButtonClickEvent, function() self:ShowSlotTip(ck, ci) end)
					table.insert(self._T.slotTipHandlers, { entity = e, fn = h })
					_TooltipLogic:Register(e, function() self:ShowSlotTip(ck, ci) end)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 스킬 칸 툴팁 연결 해제.
		for _, rec in ipairs(self._T.slotTipHandlers or {}) do
			if isvalid(rec.entity) then
				rec.entity:DisconnectEvent(ButtonClickEvent, rec.fn)
				_TooltipLogic:Unregister(rec.entity)
			end
		end
		self._T.slotTipHandlers = {}
		for _, rec in ipairs(self._T.bossHandlers or {}) do
			if isvalid(rec.entity) then
				rec.entity:DisconnectEvent(rec.evt, rec.fn)
				_TooltipLogic:Unregister(rec.entity)
			end
		end
		self._T.bossHandlers = {}
	end

	-- ===== 보스 개편 B3: 보스 HUD (보호막·그로기·예고 띠·제한 시간·약점 점·방어 버튼) =====

	@ExecSpace("ClientOnly")
	method void ConnectBossHud()
		-- 방어 버튼 클릭(비활성이면 입력 차단) + 약점·졸개 오라 아이콘 툴팁.
		self._T.bossHandlers = {}
		local btn = _EntityService:GetEntityByPath("/ui/BattleHUD/GuardBtn")
		if isvalid(btn) then
			local h = btn:ConnectEvent(ButtonClickEvent, function()
				if not btn.EnabledInHierarchy or not btn.ButtonComponent.Enable then return end
				local mech = self:BossMech()
				if mech == nil then return end
				_UISoundLogic:PlayClick()
				mech:RequestGuard()
				log("[VRF] guard button clicked")
			end)
			table.insert(self._T.bossHandlers, { entity = btn, evt = ButtonClickEvent, fn = h })
			_TooltipLogic:Register(btn, function() _TooltipLogic:ShowText(btn, "방어", "예고(빨간 띠)가 떠 있을 때 누르면 그 공격의 피해가 크게 줄어듭니다. 쓰고 나면 잠시 기다려야 합니다.") end)
		end
		for i = 0, 1 do
			local idx = i
			local e = _EntityService:GetEntityByPath("/ui/BattleHUD/BossBar/Weak" .. tostring(i))
			if isvalid(e) then
				local show = function()
					local id = (self._T.weakIds or {})[idx + 1] or ""
					_TooltipLogic:ShowText(e, "약점", self:ElemName(id) .. " 속성 공격에 약합니다.")
				end
				local h = e:ConnectEvent(UITouchDownEvent, show)
				table.insert(self._T.bossHandlers, { entity = e, evt = UITouchDownEvent, fn = h })
				_TooltipLogic:Register(e, show)
			end
		end
		-- 보스 바를 누르면 보호막 설명 (보호막이 있을 때만)
		local bar = _EntityService:GetEntityByPath("/ui/BattleHUD/BossBar")
		if isvalid(bar) then
			local showBar = function()
				local mech = self:BossMech()
				if mech == nil or mech.ShieldRatio < 0 then _TooltipLogic:Hide() return end
				_TooltipLogic:ShowText(bar, "보호막", "흰 게이지가 남아 있는 동안 체력이 줄지 않습니다. 약점 속성으로 빨리 깎이고, 깨면 잠시 무력해집니다.")
			end
			local h = bar:ConnectEvent(UITouchDownEvent, showBar)
			table.insert(self._T.bossHandlers, { entity = bar, evt = UITouchDownEvent, fn = h })
			_TooltipLogic:Register(bar, showBar)
		end
		local aura = _EntityService:GetEntityByPath("/ui/BattleHUD/BossBar/Aura")
		if isvalid(aura) then
			local show = function() _TooltipLogic:ShowText(aura, "보호", "졸개가 살아 있는 동안 보스가 받는 피해가 줄어듭니다.") end
			local h = aura:ConnectEvent(UITouchDownEvent, show)
			table.insert(self._T.bossHandlers, { entity = aura, evt = UITouchDownEvent, fn = h })
			_TooltipLogic:Register(aura, show)
		end
	end

	@ExecSpace("ClientOnly")
	method Component BossMech()
		-- 지금 맵의 보스 기믹 컴포넌트 (탑 맵이 아니면 nil).
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) then return nil end
		return player.CurrentMap:GetComponent("script.BossMechanics")
	end

	@ExecSpace("ClientOnly")
	method string ElemName(string id)
		-- 속성 Id → 표시 이름 (ElementTable).
		if self._T.elemInfo == nil then
			self._T.elemInfo = {}
			local t = _DataService:GetTable("ElementTable")
			if t ~= nil then
				for i = 1, t:GetRowCount() do
					local hex = t:GetCell(i, "Color") or "FFFFFF"
					local r = (tonumber(string.sub(hex, 1, 2), 16) or 255) / 255
					local g = (tonumber(string.sub(hex, 3, 4), 16) or 255) / 255
					local b = (tonumber(string.sub(hex, 5, 6), 16) or 255) / 255
					self._T.elemInfo[t:GetCell(i, "Id")] = { name = t:GetCell(i, "Name") or "", color = Color(r, g, b, 1) }
				end
			end
		end
		local e = self._T.elemInfo[id]
		return e ~= nil and e.name or id
	end

	@ExecSpace("ClientOnly")
	method void SetOn(string path, boolean on)
		-- HUD 엔티티 켜기/끄기 (바뀔 때만).
		local e = _EntityService:GetEntityByPath(path)
		if isvalid(e) and e.Enable ~= on then e:SetEnable(on) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateBossHud(Component mgr, Component mech)
		-- 보스 기믹 HUD: 보스가 맨 앞이고 전투 중일 때만. 보호막·시간은 보스전 전용, 방어 버튼은 필드보스·보스전 공통.
		local on = mgr ~= nil and mech ~= nil and mech.BossOn and mgr.MonsterBoss and (mgr.RunState == "FIGHT" or mgr.RunState == "CLEAR")
		local base = "/ui/BattleHUD/"
		self:SetOn(base .. "GuardBtn", on)
		if not on then
			self:SetOn(base .. "BossWarn", false)
			return
		end
		-- 보호막 (흰 게이지)
		local shield = _EntityService:GetEntityByPath(base .. "BossBar/Shield")
		if isvalid(shield) then
			local show = mech.ShieldRatio >= 0
			if shield.Enable ~= show then shield:SetEnable(show) end
			if show then shield.UITransformComponent.RectSize = Vector2(math.max(1, 880 * mech.ShieldRatio), 12) end
		end
		self:SetOn(base .. "BossBar/Groggy", mech.Groggy)
		self:SetOn(base .. "BossBar/Aura", mech.SummonAura)
		-- 제한 시간 (보스전): 보스전은 체력 숫자 대신 시간
		local timer = _EntityService:GetEntityByPath(base .. "BossBar/Timer")
		if isvalid(timer) then
			local show = mech.BossMode and mech.TimeLeft >= 0
			if timer.Enable ~= show then timer:SetEnable(show) end
			if show then
				local t = mech.TimeLeft
				local txt = string.format("%d:%02d", math.floor(t / 60), t % 60)
				if timer.TextGUIRendererComponent.Text ~= txt then timer.TextGUIRendererComponent.Text = txt end
				timer.TextGUIRendererComponent.FontColor = t <= 30 and Color(1, 0.4, 0.35, 1) or Color(1, 1, 1, 1)
			end
		end
		self:SetOn(base .. "BossBar/HpText", not mech.BossMode)
		-- 약점 점 (속성색)
		if self._T.weakRaw ~= mech.WeakElems then
			self._T.weakRaw = mech.WeakElems
			local ids = {}
			for id in string.gmatch(mech.WeakElems or "", "[^|]+") do table.insert(ids, id) end
			self._T.weakIds = ids
			self:ElemName("")
			for i = 0, 1 do
				local e = _EntityService:GetEntityByPath(base .. "BossBar/Weak" .. tostring(i))
				if isvalid(e) then
					local id = ids[i + 1]
					e:SetEnable(id ~= nil)
					if id ~= nil and self._T.elemInfo[id] ~= nil then e.SpriteGUIRendererComponent.Color = self._T.elemInfo[id].color end
				end
			end
		end
		-- 예고 띠: 줄어드는 빨간 띠, 저지 게이지(파랑)
		local warnOn = mech.WarnRatio > 0
		self:SetOn(base .. "BossWarn", warnOn)
		if warnOn then
			local fill = _EntityService:GetEntityByPath(base .. "BossWarn/Fill")
			if isvalid(fill) then fill.UITransformComponent.RectSize = Vector2(math.max(1, 580 * mech.WarnRatio), 14) end
			local gauge = _EntityService:GetEntityByPath(base .. "BossWarn/Gauge")
			if isvalid(gauge) then
				local gs = mech.GaugeRatio >= 0
				if gauge.Enable ~= gs then gauge:SetEnable(gs) end
				if gs then gauge.UITransformComponent.RectSize = Vector2(math.max(1, 580 * mech.GaugeRatio), 8) end
			end
		end
		-- 방어 버튼: 쿨타임 원형 채움, 예고 중(아직 안 씀) 테두리 빛남, 쿨타임 중 비활성(입력 차단)
		local btn = _EntityService:GetEntityByPath(base .. "GuardBtn")
		if isvalid(btn) then
			local ready = mech.GuardCd <= 0
			if btn.ButtonComponent.Enable ~= ready then btn.ButtonComponent.Enable = ready end
			local cd = _EntityService:GetEntityByPath(base .. "GuardBtn/Cd")
			if isvalid(cd) then cd.SpriteGUIRendererComponent.FillAmount = ready and 0 or math.min(1, mech.GuardCd / math.max(1, mech.GuardCdMax)) end
			self:SetOn(base .. "GuardBtn/Glow", warnOn and ready and not mech.GuardArmed)
			local icon = _EntityService:GetEntityByPath(base .. "GuardBtn/Icon")
			if isvalid(icon) then icon.SpriteGUIRendererComponent.Color = ready and Color(1, 1, 1, 1) or Color(0.6, 0.6, 0.6, 1) end
		end
	end

	@ExecSpace("ClientOnly")
	method void LoadSkillTipData()
		-- 스킬 툴팁용 표: 이름·아이콘·설명(자리표시자 치환)·쿨타임, 칸 종류, 돌파 이름·설명.
		if self._T.tipSkills ~= nil then return end
		self._T.tipSkills = {}
		self._T.tipSlotKind = {}
		self._T.tipBreaks = {}
		local js = _DataService:GetTable("JobSkillTable")
		if js ~= nil then
			for i = 1, js:GetRowCount() do
				local function num(col) return tonumber(js:GetCell(i, col)) or 0 end
				local text = js:GetCell(i, "Desc") or ""
				local vals = { c = num("Chance"), p = num("Pct"), h = num("ProcHits"), cd = num("Cooldown"), bt = num("BuffTime"), v1 = num("V1"), v2 = num("V2"), dp = num("DotPct"), dt = num("DotTime") }
				for key, v in pairs(vals) do text = (string.gsub(text, "{" .. key .. "}", tostring(math.floor(v)))) end
				local id = js:GetCell(i, "SkillId")
				if id ~= nil and self._T.tipSkills[id] == nil then
					self._T.tipSkills[id] = { name = js:GetCell(i, "Name") or id, icon = js:GetCell(i, "IconRUID") or "", desc = text, cd = num("Cooldown") }
				end
			end
		end
		local hs = _DataService:GetTable("HeroSkillTable")
		if hs ~= nil then
			for i = 1, hs:GetRowCount() do
				local id = hs:GetCell(i, "SkillId")
				if id ~= nil and self._T.tipSkills[id] == nil then
					self._T.tipSkills[id] = { name = hs:GetCell(i, "Name") or id, icon = hs:GetCell(i, "IconRUID") or "", desc = hs:GetCell(i, "Desc") or "", cd = tonumber(hs:GetCell(i, "Cooldown")) or 0 }
				end
			end
		end
		local kinds = { Main = "주력기", Sub = "보조기", Tech = "기술", Hyper = "하이퍼", V1 = "5차", V2 = "5차", V3 = "5차", Ult = "궁극기" }
		local ss = _DataService:GetTable("CharSkillSlotTable")
		if ss ~= nil then
			for i = 1, ss:GetRowCount() do
				local id = ss:GetCell(i, "SkillId")
				local key = ss:GetCell(i, "SlotKey") or ""
				if id ~= nil and self._T.tipSlotKind[id] == nil and kinds[key] ~= nil then self._T.tipSlotKind[id] = kinds[key] end
			end
		end
		local bt = _DataService:GetTable("SkillBreakTable")
		if bt ~= nil then
			for i = 1, bt:GetRowCount() do
				local oid = bt:GetCell(i, "OptionId")
				if oid ~= nil then self._T.tipBreaks[oid] = { name = bt:GetCell(i, "Name") or oid, desc = bt:GetCell(i, "Desc") or "" } end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowSlotTip(integer k, integer i)
		-- 구성원 k번 i번째 스킬 칸 툴팁. 빈 칸이면 열려 있던 툴팁만 닫는다.
		local e = _EntityService:GetEntityByPath("/ui/BattleHUD/Members/P" .. tostring(k) .. "/S" .. tostring(i))
		local slots = (self._T.slotTips or {})[k]
		local info = slots ~= nil and slots[i] or nil
		if not isvalid(e) or info == nil then
			_TooltipLogic:Hide()
			return
		end
		self:LoadSkillTipData()
		local sk = self._T.tipSkills[info.id] or { name = info.id, icon = "", desc = "", cd = 0 }
		local data = { icon = (self._T.mateIcons or {})[info.id] or sk.icon, name = sk.name, kind = self._T.tipSlotKind[info.id] or "", desc = sk.desc, breaks = {} }
		if info.ult then
			if data.kind == "" then data.kind = "궁극기" end
			local pct = 100
			if info.max > 0 then pct = math.floor((info.max - info.left) / info.max * 100 + 0.0001) end
			data.cooldownText = "충전 " .. tostring(pct) .. "%"
		else
			data.cooldown = info.max > 0 and info.max or sk.cd
		end
		-- 이번 판에 붙은 돌파 (서버가 동기화한 스킬별 돌파 Id 목록)
		local player = _UserService.LocalPlayer
		local mgr = (isvalid(player) and isvalid(player.CurrentMap)) and player.CurrentMap:GetComponent("script.TowerRunManager") or nil
		if mgr ~= nil and mgr.SkillBreaks ~= nil then
			-- 스킬 개편: 칸에는 새 스킬 Id가 보이고 돌파는 동작 기준 Id로 저장된다 (SkillAlias "동작=새 스킬")
			local behId = info.id
			for entry in string.gmatch(mgr.SkillAlias or "", "[^,]+") do
				local p = string.find(entry, "=", 1, true)
				if p ~= nil and string.sub(entry, p + 1) == info.id then behId = string.sub(entry, 1, p - 1) end
			end
			local raw = mgr.SkillBreaks[behId] or ""
			for oid in string.gmatch(raw, "[^,]+") do
				local b = self._T.tipBreaks[oid]
				if b ~= nil then
					local line = "<b>" .. b.name .. "</b>"
					if b.desc ~= "" then line = line .. " — " .. b.desc end
					table.insert(data.breaks, line)
				else
					table.insert(data.breaks, oid)
				end
			end
		end
		_TooltipLogic:ShowSkill(e, data)
	end

	@ExecSpace("ClientOnly")
	method void SpawnMesoDrop(Vector2 origin, number groundY, integer count)
		-- 몬스터 위치에서 동전을 위로 튀겨 낸다 (좌우로 퍼지며 떨어진 뒤 한 번 튕김).
		local spawned = 0
		for _, coin in ipairs(self._T.coins) do
			if spawned >= count then break end
			if not coin.active then
				spawned = spawned + 1
				coin.active = true
				coin.phase = "fall"
				coin.delay = (spawned - 1) * 0.04
				coin.x = origin.x
				coin.y = origin.y
				coin.vx = (_UtilLogic:RandomDouble() - 0.5) * 2.4
				coin.vy = 3.2 + _UtilLogic:RandomDouble() * 1.4
				coin.groundY = groundY + _UtilLogic:RandomDouble() * 0.06
				coin.bounced = false
				coin.t = 0
			end
		end
		log("[VRF] meso drop coins=" .. tostring(spawned))
	end

	@ExecSpace("ClientOnly")
	method void UpdateMesoDrop(number delta, Entity player)
		-- 동전 물리(낙하→튕김→잠시 멈춤→플레이어에게 날아가며 사라짐)를 월드 좌표로 계산해 UI에 그린다.
		local target = Vector2(-1.2, 0.6)
		if isvalid(player) then
			local wp = player.TransformComponent.WorldPosition
			target = Vector2(wp.x, wp.y + 0.4)
		end
		for _, coin in ipairs(self._T.coins) do
			if coin.active then
				local alpha = 1
				if coin.delay > 0 then
					coin.delay = coin.delay - delta
				elseif coin.phase == "fall" then
					coin.vy = coin.vy + self.MesoGravity * delta
					coin.x = coin.x + coin.vx * delta
					coin.y = coin.y + coin.vy * delta
					-- 땅에 닿는 즉시 플레이어에게 흡수
					if coin.y <= coin.groundY and coin.vy < 0 then
						coin.y = coin.groundY
						coin.phase = "fly"
						coin.t = 0
						coin.sx = coin.x
						coin.sy = coin.y
					end
				elseif coin.phase == "rest" then
					coin.t = coin.t + delta
					if coin.t >= self.MesoRestTime then
						coin.phase = "fly"
						coin.t = 0
						coin.sx = coin.x
						coin.sy = coin.y
					end
				elseif coin.phase == "fly" then
					coin.t = coin.t + delta
					local k = math.min(1, coin.t / self.MesoFlyTime)
					local e = k * k
					coin.x = coin.sx + (target.x - coin.sx) * e
					coin.y = coin.sy + (target.y - coin.sy) * e
					alpha = 1 - k * 0.8
					if k >= 1 then
						coin.active = false
					end
				end
				local e = coin.entity
				if coin.active and coin.delay <= 0 then
					if not e.Enable then e:SetEnable(true) end
					local screenPos = _UILogic:WorldToScreenPosition(Vector2(coin.x, coin.y))
					e.UITransformComponent.anchoredPosition = self:ToUI(screenPos)
					e.SpriteGUIRendererComponent.Color = Color(1, 1, 1, alpha)
				elseif e.Enable and not coin.active then
					e:SetEnable(false)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateProcText(Component mgr, Entity player, number delta)
		-- 패시브 발동 문구: ProcSeq가 바뀌면 캐릭터 머리 위에서 떠오르며 사라진다.
		if not isvalid(self.procText) then return end
		if self._T.lastProcSeq == nil then
			self._T.lastProcSeq = mgr.ProcSeq
		elseif mgr.ProcSeq ~= self._T.lastProcSeq then
			self._T.lastProcSeq = mgr.ProcSeq
			self.procText.Text = mgr.ProcText
			self._T.procTimer = self.ProcTextTime
			log("[VRF] proc text " .. mgr.ProcText)
		end
		local t = self._T.procTimer or 0
		local show = t > 0
		if self.procText.Entity.Enable ~= show then self.procText.Entity:SetEnable(show) end
		if not show then return end
		self._T.procTimer = t - delta
		local k = 1 - t / self.ProcTextTime
		local wp = player.TransformComponent.WorldPosition
		local screenPos = _UILogic:WorldToScreenPosition(Vector2(wp.x, wp.y + 1.0 + 0.4 * k))
		self.procText.Entity.UITransformComponent.anchoredPosition = self:ToUI(screenPos)
		local c = self.procText.FontColor
		self.procText.FontColor = Color(c.r, c.g, c.b, math.min(1, t / 0.3))
	end

	@ExecSpace("ClientOnly")
	method void ClearMesoDrop()
		-- 탑 밖으로 나가면 남은 동전을 숨긴다.
		for _, coin in ipairs(self._T.coins) do
			coin.active = false
			if coin.entity.Enable then coin.entity:SetEnable(false) end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetupView(Entity player, Entity map)
		-- 고정 전투 카메라로 전환하고, 플레이어 입력(이동/점프/공격 키)을 막는다.
		-- 카메라 전환은 블렌드 없이 즉시(Cut), 플레이어 카메라는 따라가기 지연 없음
		_CameraService.TransitionBlendType = CameraBlendType.Cut
		_CameraService.TransitionBlendTime = 0
		if isvalid(player.CameraComponent) then player.CameraComponent.Damping = Vector2(0, 0) end
		local camEntity = map:GetChildByName(self.BattleCameraName)
		local avatar = player.AvatarRendererComponent
		if not isvalid(camEntity) or not isvalid(camEntity.CameraComponent) then
			-- 전투 카메라가 없는 맵(로비)은 플레이어 카메라로 복귀, 캐릭터는 숨김
			if isvalid(player.CameraComponent) then _CameraService:SwitchCameraTo(player.CameraComponent) end
			if isvalid(avatar) then avatar:SetAlpha(0) end
			self._T.viewMap = map.Name
			log("[VRF] player camera restored map=" .. map.Name)
			return
		end
		local cam = camEntity.CameraComponent
		camEntity.TransformComponent.Position = self.BattleCamPos
		if _ApplicationService:IsMobilePlatform() then
			cam.ZoomRatio = self.MobileZoomRatio
		else
			cam.ZoomRatio = self.PcZoomRatio
		end
		_CameraService:SwitchCameraTo(cam)
		if isvalid(avatar) then avatar:SetAlpha(1) end

		local controller = player.PlayerControllerComponent
		if isvalid(controller) and not self._T.keysRemoved then
			self._T.keysRemoved = true
			local keys = { KeyboardKey.LeftArrow, KeyboardKey.RightArrow, KeyboardKey.UpArrow, KeyboardKey.DownArrow,
				KeyboardKey.LeftAlt, KeyboardKey.LeftControl, KeyboardKey.Space }
			for _, key in ipairs(keys) do
				controller:RemoveActionKey(key)
			end
		end
		self._T.viewMap = map.Name
		log("[VRF] battle camera switched mobile=" .. tostring(_ApplicationService:IsMobilePlatform()))
	end

	@ExecSpace("ClientOnly")
	method void UpdateSymbolBanner(Component mgr, number delta)
		-- 층 보스에게서 심볼을 얻으면 단계 아이콘·문구 배너를 잠깐 보여준다 (처음 들어왔을 때의 값은 무시).
		if not isvalid(self.symbolBanner) then return end
		if self._T.symTiers == nil then
			self._T.symTiers = {}
			local ts = _DataService:GetTable("SymbolTierTable")
			if ts ~= nil then
				for i = 1, ts:GetRowCount() do
					self._T.symTiers[tonumber(ts:GetCell(i, "Tier")) or i] = { icon = ts:GetCell(i, "IconRUID"), dmg = ts:GetCell(i, "DmgPct"), cut = ts:GetCell(i, "DmgCut"), gain = ts:GetCell(i, "GainPct"), prefix = ts:GetCell(i, "NamePrefix") or "" }
				end
			end
			-- 층별 몬스터 이름 (심볼 이름용)
			local monName = {}
			local ms = _DataService:GetTable("MonsterTable")
			if ms ~= nil then
				for i = 1, ms:GetRowCount() do monName[ms:GetCell(i, "id")] = ms:GetCell(i, "Name") end
			end
			self._T.floorMonster = {}
			local fs = _DataService:GetTable("FloorTable")
			if fs ~= nil then
				for i = 1, fs:GetRowCount() do self._T.floorMonster[tonumber(fs:GetCell(i, "Floor")) or i] = monName[fs:GetCell(i, "MonsterId")] or "" end
			end
		end
		if self._T.lastSymbolSeq == nil then
			self._T.lastSymbolSeq = mgr.SymbolGetSeq
		elseif mgr.SymbolGetSeq ~= self._T.lastSymbolSeq then
			self._T.lastSymbolSeq = mgr.SymbolGetSeq
			local tier = mgr.SymbolGetTier
			local t = self._T.symTiers[tier]
			if t ~= nil and isvalid(self.symbolIcon) then self.symbolIcon.ImageRUID = DataRef(t.icon) end
			if isvalid(self.symbolTitle) then
				local mon = self._T.floorMonster[mgr.SymbolGetFloor] or ""
				local prefix = t ~= nil and t.prefix or ""
				self.symbolTitle.Text = prefix .. " " .. mon .. "의 심볼 획득!"
			end
			if isvalid(self.symbolSub) and t ~= nil then
				local sub = tostring(mgr.SymbolGetFloor) .. "층 · " .. tostring(tier) .. "단계 · 이 층: 주는 피해 +" .. t.dmg .. "% · 받는 피해 -" .. t.cut .. "% · 메소·경험치 +" .. t.gain .. "%"
				if tier >= 3 then sub = "모든 층 영구 능력치 획득! · " .. sub end
				self.symbolSub.Text = sub
			end
			-- 보스 처치 직후엔 거래·카드 화면이 먼저 뜨므로, 전투로 돌아왔을 때 보여준다
			self._T.symbolPending = true
		end
		if self._T.symbolPending and (mgr.RunState == "FIGHT" or mgr.RunState == "CLEAR") then
			self._T.symbolPending = false
			self._T.symbolTimer = self.SymbolBannerTime
			self.symbolBanner:SetEnable(true)
			log("[VRF] symbol banner floor=" .. tostring(mgr.SymbolGetFloor) .. " tier=" .. tostring(mgr.SymbolGetTier))
		end
		if (self._T.symbolTimer or 0) > 0 then
			self._T.symbolTimer = self._T.symbolTimer - delta
			if self._T.symbolTimer <= 0 then self.symbolBanner:SetEnable(false) end
		elseif self.symbolBanner.Enable then
			self.symbolBanner:SetEnable(false)
		end
	end

	@ExecSpace("ClientOnly")
	method Vector2 ToUI(Vector2 screenPos)
		-- 화면 좌표 → UI 좌표. 화면 비율이 16:9가 아니면 ScreenToUIPosition 결과가 실제 UI 배율과 달라 보정한다
		-- (UI는 화면 높이 1080 기준으로 맞춰짐: 보정 배율 = 540 / ScreenToUIPosition이 알려주는 화면 위쪽 y)
		local h = _UILogic.ScreenHeight
		local top = _UILogic:ScreenToUIPosition(Vector2(_UILogic.ScreenWidth / 2, h)).y
		local k = 1
		if top > 1 then k = 540 / top end
		local p = _UILogic:ScreenToUIPosition(screenPos)
		return Vector2(p.x * k, p.y * k)
	end

	@ExecSpace("ClientOnly")
	method void PlaceBar(UITransformComponent root, UITransformComponent fill, Entity target, number height, number hp, number maxHp)
		-- 대상 머리 위에 HP 바를 놓고 비율만큼 채운다.
		if not isvalid(root) or not isvalid(fill) then return end
		if not isvalid(target) or maxHp <= 0 then
			root.Entity:SetEnable(false)
			return
		end
		root.Entity:SetEnable(true)
		local wp = target.TransformComponent.WorldPosition
		local screenPos = _UILogic:WorldToScreenPosition(Vector2(wp.x, wp.y + height))
		root.anchoredPosition = self:ToUI(screenPos)
		local ratio = math.max(0, math.min(1, hp / maxHp))
		fill.RectSize = Vector2(self.BarWidth * ratio, fill.RectSize.y)
	end

	@ExecSpace("ClientOnly")
	method number MonsterTop(Entity target)
		-- 몬스터 발밑에서 머리 꼭대기까지 높이(월드 단위): 등장할 때 대기 그림 첫 프레임으로 한 번 잰다 (크기 배율 반영).
		if self._T.monTopId ~= target.Id then
			self._T.monTopId = target.Id
			local top = 0.8
			-- 그림을 불러오는 동안(대기 중) 다음 프레임이 읽어도 되게 기본값 먼저
			self._T.monTop = top
			local ruid = isvalid(target.SpriteRendererComponent) and target.SpriteRendererComponent.SpriteRUID or ""
			if ruid ~= "" then
				local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
				if clip ~= nil then
					local frames = clip.Frames:ToTable()
					if #frames > 0 and frames[1].FrameSprite ~= nil then
						local sp = frames[1].FrameSprite
						local h = sp.Height / 100
						local above = h - sp.PivotPixel.y / 100
						if above <= 0.05 or above > h then above = h * (1 - sp.Pivot.y) end
						if above > 0.05 then top = above end
					end
				end
			end
			self._T.monTop = top
		end
		return self._T.monTop * math.abs(target.TransformComponent.Scale.y)
	end

	@ExecSpace("ClientOnly")
	method void UpdateQueueBars(Entity map, Entity front)
		-- 맨 앞이 아닌 웨이브 몬스터마다 작은 체력바 (맨 앞 체력바를 복제해 재사용). 체력은 몬스터의 동기화 값.
		if self._T.qbars == nil then self._T.qbars = {} end
		local mons = {}
		if isvalid(map) then
			local comps = map:GetChildComponentsByTypeName("script.TowerMonster", false)
			for _, tm in ipairs(comps or {}) do
				if isvalid(tm) and tm.Entity ~= front and tm.IsQueued and not tm.IsDead and tm.MaxHp > 0 then table.insert(mons, tm) end
			end
		end
		local src = isvalid(self.monsterHpRoot) and self.monsterHpRoot.Entity or nil
		if src == nil then return end
		local fillName = isvalid(self.monsterHpFill) and self.monsterHpFill.Entity.Name or ""
		while #self._T.qbars < #mons do
			local b = _SpawnService:SpawnByEntity(src, "QueueHpBar" .. tostring(#self._T.qbars + 1), Vector3(0, 0, 0), src.Parent, true)
			if b == nil then break end
			table.insert(self._T.qbars, b)
		end
		local top = self._T.monTop or 0.8
		for i, b in ipairs(self._T.qbars) do
			local tm = mons[i]
			if not isvalid(b) then continue end
			if tm == nil then
				if b.Enable then b:SetEnable(false) end
				continue
			end
			if not b.Enable then b:SetEnable(true) end
			local e = tm.Entity
			local wp = e.TransformComponent.WorldPosition
			local p = self:ToUI(_UILogic:WorldToScreenPosition(Vector2(wp.x, wp.y + top * math.abs(e.TransformComponent.Scale.y))))
			local ut = b.UITransformComponent
			ut.anchoredPosition = Vector2(p.x, p.y + self.MonsterBarGap * 0.8)
			local sc = self.MonsterBarScale * self.QueueBarScale
			if ut.UIScale.x ~= sc then ut.UIScale = Vector3(sc, sc, 1) end
			local fill = b:GetChildByName(fillName, true)
			if isvalid(fill) and isvalid(fill.SpriteGUIRendererComponent) then
				fill.SpriteGUIRendererComponent.FillAmount = math.max(0, math.min(1, tm.Hp / tm.MaxHp))
			end
		end
	end

	method void PlaceMonsterBar(Entity target, number hp, number maxHp)
		-- 몬스터 머리 위 체력바: 프레임 112×24 + 채움(Filled) FillAmount.
		local root = self.monsterHpRoot
		local fill = self.monsterHpFill
		if not isvalid(root) or not isvalid(fill) then return end
		if not isvalid(target) or maxHp <= 0 then
			if root.Entity.Enable then root.Entity:SetEnable(false) end
			return
		end
		if not root.Entity.Enable then root.Entity:SetEnable(true) end
		local wp = target.TransformComponent.WorldPosition
		local p = self:ToUI(_UILogic:WorldToScreenPosition(Vector2(wp.x, wp.y + self:MonsterTop(target))))
		root.anchoredPosition = Vector2(p.x, p.y + self.MonsterBarGap)
		local ratio = math.max(0, math.min(1, hp / maxHp))
		fill.Entity.SpriteGUIRendererComponent.FillAmount = ratio
	end

	method void PlaceNameTag(Entity target, string label, boolean elite)
		-- 몬스터 발밑(HP 바 아래)에 "Lv.N 이름" 네임태그를 표시한다. 접두사 강화 몬스터는 붉은 글씨.
		if not isvalid(self.monsterNameText) or not isvalid(self.monsterTagRoot) then return end
		local show = isvalid(target) and label ~= ""
		if self.monsterTagRoot.Entity.Enable ~= show then self.monsterTagRoot.Entity:SetEnable(show) end
		if not show then return end
		local wp = target.TransformComponent.WorldPosition
		local p = self:ToUI(_UILogic:WorldToScreenPosition(Vector2(wp.x, wp.y)))
		self.monsterTagRoot.anchoredPosition = Vector2(p.x, p.y - self.NameTagGap)
		if self.monsterNameText.Text ~= label then
			self.monsterNameText.Text = label
			-- 긴 이름은 배경 폭을 늘린다 (기본 160×40, 글자 영역은 좌우 10px 여백)
			local w = 20
			for _, code in utf8.codes(label) do
				if code > 127 then w = w + 26 else w = w + 15 end
			end
			w = math.max(160, w)
			self.monsterTagRoot.RectSize = Vector2(w, 40)
			self.monsterNameText.Entity.UITransformComponent.RectSize = Vector2(w - 20, 36)
			if elite then
				self.monsterNameText.FontColor = self.EliteNameColor
			else
				self.monsterNameText.FontColor = Color(1, 1, 1, 1)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateBossBar(Component mgr, Entity monster)
		-- 상단 보스 게이지: 맨 앞 몬스터가 보스이고 전투 중일 때만.
		local root = _EntityService:GetEntityByPath("/ui/BattleHUD/BossBar")
		if not isvalid(root) then return end
		local show = mgr ~= nil and mgr.MonsterBoss and isvalid(monster) and (mgr.RunState == "FIGHT" or mgr.RunState == "CLEAR")
		if root.Enable ~= show then root:SetEnable(show) end
		if not show then return end
		local ratio = 0
		if mgr.MonsterMaxHp > 0 then ratio = math.max(0, math.min(1, mgr.MonsterHp / mgr.MonsterMaxHp)) end
		local fill = _EntityService:GetEntityByPath("/ui/BattleHUD/BossBar/Fill")
		if isvalid(fill) then fill.UITransformComponent.RectSize = Vector2(880 * ratio, 22) end
		local name = _EntityService:GetEntityByPath("/ui/BattleHUD/BossBar/Name")
		if isvalid(name) and name.TextGUIRendererComponent.Text ~= mgr.MonsterLabel then name.TextGUIRendererComponent.Text = mgr.MonsterLabel end
		local hp = _EntityService:GetEntityByPath("/ui/BattleHUD/BossBar/HpText")
		if isvalid(hp) then hp.TextGUIRendererComponent.Text = tostring(math.ceil(mgr.MonsterHp)) .. " / " .. tostring(math.ceil(mgr.MonsterMaxHp)) end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 매 프레임 판 상태(@Sync)를 읽어 HUD를 갱신한다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local map = player.CurrentMap
		if not isvalid(map) then return end
		if self._T.viewMap ~= map.Name then self:SetupView(player, map) end

		local mgr = map:GetComponent("script.TowerRunManager")
		if isvalid(self.floorText) then self.floorText.Entity:SetEnable(mgr ~= nil) end
		-- 층 바닥 타일셋 (원작 맵): 서버 FloorTileSet이 바뀌면 탑 맵 TileMap의 타일셋을 교체 (타일 배치는 그대로)
		-- 층 타일셋이 비어 있으면 탑 맵 원래 타일셋으로 되돌린다 (이전 층 타일셋이 남지 않게)
		if mgr ~= nil then
			local tm = map:GetChildByName("TileMap")
			if isvalid(tm) and isvalid(tm.TileMapComponent) then
				-- 맵에 다시 들어오면 타일셋이 원래대로 돌아오므로 기록도 새로 시작
				if self._T.tsMap ~= map then self._T.tsMap = map self._T.tileSet = nil end
				if self._T.defaultTileSet == nil then self._T.defaultTileSet = tm.TileMapComponent.TileSetRUID.DataId end
				local want = mgr.FloorTileSet or ""
				if want == "" then want = self._T.defaultTileSet end
				if self._T.tileSet ~= want and want ~= "" then
					tm.TileMapComponent.TileSetRUID = DataRef(want)
					self._T.tileSet = want
					log("[VRF] floor tileset -> " .. want)
				end
			end
		end
		if mgr == nil then
			if isvalid(self.playerHpRoot) then self.playerHpRoot.Entity:SetEnable(false) end
			if isvalid(self.monsterHpRoot) then self.monsterHpRoot.Entity:SetEnable(false) end
			if isvalid(self.monsterTagRoot) then self.monsterTagRoot.Entity:SetEnable(false) end
			self:UpdateBossBar(nil, nil)
			self:UpdateBossHud(nil, nil)
			for _, qb in ipairs(self._T.qbars or {}) do
				if isvalid(qb) and qb.Enable then qb:SetEnable(false) end
			end
			self:ClearMesoDrop()
			self._T.lastKillSeq = nil
			self._T.lastMesoProcSeq = nil
			self._T.lastProcSeq = nil
			self._T.procTimer = 0
			if isvalid(self.procText) and self.procText.Entity.Enable then self.procText.Entity:SetEnable(false) end
			self:UpdateHeroRes(nil)
			self:UpdateParty(nil)
			self:UpdateStone(nil)
			return
		end

		if isvalid(self.floorText) and self.floorText.Text ~= mgr.FloorTitle then self.floorText.Text = mgr.FloorTitle end
		self:UpdateSymbolBanner(mgr, delta)
		-- 카드·거래 화면이 떠 있을 때는 층 이름을 숨겨 팝업 제목과 겹치지 않게
		if isvalid(self.floorText) then
			local showFloor = mgr.RunState == "FIGHT" or mgr.RunState == "CLEAR"
			if self.floorText.Entity.Enable ~= showFloor then self.floorText.Entity:SetEnable(showFloor) end
		end
		if self.ShowPlayerOverheadBar then
			self:PlaceBar(self.playerHpRoot, self.playerHpFill, player, self.PlayerBarHeight, mgr.PlayerHp, mgr.PlayerMaxHp)
		elseif isvalid(self.playerHpRoot) and self.playerHpRoot.Entity.Enable then
			self.playerHpRoot.Entity:SetEnable(false)
		end
		if isvalid(self.monsterHpRoot) then
			local sc = self.MonsterBarScale
			if self.monsterHpRoot.UIScale.x ~= sc then self.monsterHpRoot.UIScale = Vector3(sc, sc, 1) end
		end

		local monster = nil
		if mgr.MonsterName ~= "" then monster = map:GetChildByName(mgr.MonsterName) end
		-- 보스는 머리 위 막대·이름표 대신 상단 보스 게이지, 정예는 몬스터에 붙은 붉은 이름표가 있으므로 발밑 이름표를 숨긴다
		local barTarget = monster
		local tagTarget = monster
		if mgr.MonsterBoss then barTarget = nil tagTarget = nil end
		if mgr.MonsterElite then tagTarget = nil end
		self:PlaceMonsterBar(barTarget, mgr.MonsterHp, mgr.MonsterMaxHp)
		self:PlaceNameTag(tagTarget, mgr.MonsterLabel, mgr.MonsterElite)
		self:UpdateBossBar(mgr, monster)
		self:UpdateBossHud(mgr, map:GetComponent("script.BossMechanics"))
		self:UpdateQueueBars(map, monster)

		-- 몬스터 처치(KillSeq 증가) 시 메소 드롭 연출. 강화 몬스터는 동전을 더 많이.
		if self._T.lastKillSeq == nil then
			self._T.lastKillSeq = mgr.KillSeq
		elseif mgr.KillSeq ~= self._T.lastKillSeq then
			self._T.lastKillSeq = mgr.KillSeq
			local origin = Vector2(1.0, 0.36)
			local groundY = -0.04
			if isvalid(monster) then
				local wp = monster.TransformComponent.WorldPosition
				origin = Vector2(wp.x, wp.y + 0.4)
				groundY = wp.y
			end
			local count = 3 + _UtilLogic:RandomIntegerRange(0, 2)
			if mgr.MonsterElite then count = 8 end
			self:SpawnMesoDrop(origin, groundY, count)
		end
		-- 메소 사냥꾼 발동: 동전 2개
		if self._T.lastMesoProcSeq == nil then
			self._T.lastMesoProcSeq = mgr.MesoProcSeq
		elseif mgr.MesoProcSeq ~= self._T.lastMesoProcSeq then
			self._T.lastMesoProcSeq = mgr.MesoProcSeq
			if isvalid(monster) then
				local wp = monster.TransformComponent.WorldPosition
				self:SpawnMesoDrop(Vector2(wp.x, wp.y + 0.4), wp.y, 2)
			end
		end
		self:UpdateMesoDrop(delta, player)
		self:UpdateProcText(mgr, player, delta)
		self:UpdateHeroRes(mgr)
		self:UpdateParty(mgr)
		self:UpdateStone(mgr)
	end

	@ExecSpace("ClientOnly")
	method void UpdateStone(Component mgr)
		-- 하단 HUD 바로 위 왼쪽: 스킬석·메소 (아이콘 + 수량, 반투명 배경). 하단 구성원 HUD와 같이 보이고 숨는다 (사용자 확정: UpdateParty와 같은 조건).
		local root = _EntityService:GetEntityByPath("/ui/BattleHUD/Wallet")
		if not isvalid(root) then return end
		local show = mgr ~= nil and (mgr.RunState == "FIGHT" or mgr.RunState == "CLEAR")
		if root.Enable ~= show then root:SetEnable(show) end
		if not show then return end
		local function setText(path, s2)
			local e = _EntityService:GetEntityByPath("/ui/BattleHUD/Wallet/" .. path)
			if isvalid(e) and e.TextGUIRendererComponent.Text ~= s2 then e.TextGUIRendererComponent.Text = s2 end
		end
		setText("Stone/Text", tostring(mgr.SkillStone))
		setText("Meso/Text", tostring(mgr.Meso))
	end

	@ExecSpace("ClientOnly")
	method void UpdateParty(Component mgr)
		-- 하단 구성원 HUD: 구성원 1·2·3번 패널 (경험치 없음, 레벨은 이름 옆). 전투 중(FIGHT·CLEAR)에만 보인다.
		local root = _EntityService:GetEntityByPath("/ui/BattleHUD/Members")
		if not isvalid(root) then return end
		local show = mgr ~= nil and (mgr.RunState == "FIGHT" or mgr.RunState == "CLEAR")
		if root.Enable ~= show then root:SetEnable(show) end
		if not show then return end
		for k = 1, 3 do self:UpdateMember(mgr, k) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateMember(Component mgr, integer k)
		-- 구성원 k번 패널: 번호·직업, 체력(숫자)·마나 막대, 자원·쓰러짐, 장착 스킬 5칸(배운 스킬만 아이콘·레벨·쿨타임).
		local base = "/ui/BattleHUD/Members/P" .. tostring(k)
		local root = _EntityService:GetEntityByPath(base)
		if not isvalid(root) then return end
		local ent = nil
		local hp = 0
		local maxHp = 0
		local down = false
		if k == 1 then
			ent = _UserService.LocalPlayer
			hp = mgr.PlayerHp
			maxHp = mgr.PlayerMaxHp
			down = mgr.PlayerDown
		elseif k == 2 then
			ent = mgr.Entity:GetChildByName("Companion")
			hp = mgr.CompanionHp
			maxHp = mgr.CompanionMaxHp
			down = mgr.CompanionDown
		else
			ent = mgr.Entity:GetChildByName("Companion2")
			hp = mgr.Companion2Hp
			maxHp = mgr.Companion2MaxHp
			down = mgr.Companion2Down
		end
		local cc = nil
		if isvalid(ent) then
			for _, n in ipairs({ "script.HeroCombat", "script.BishopCombat", "script.JobCombat" }) do
				local c = ent:GetComponent(n)
				if c ~= nil and c.Active then cc = c end
			end
		end
		local on = cc ~= nil and maxHp > 0
		if root.Enable ~= on then root:SetEnable(on) end
		if not on then return end
		local function get(path) return _EntityService:GetEntityByPath(base .. "/" .. path) end
		local function setText(path, txt)
			local e = get(path)
			if isvalid(e) and e.TextGUIRendererComponent.Text ~= txt then e.TextGUIRendererComponent.Text = txt end
		end
		local function setBar(path, ratio, full)
			local e = get(path)
			if not isvalid(e) then return end
			local r = math.max(0, math.min(1, ratio))
			local size = e.UITransformComponent.RectSize
			local w = full * r
			if math.abs(size.x - w) > 0.5 then e.UITransformComponent.RectSize = Vector2(w, size.y) end
		end
		if self._T.mateIcons == nil then
			self._T.mateIcons = {}
			-- 스킬 개편: JobSkillTable(새 이름·아이콘)을 먼저 읽어 우선한다. HeroSkillTable은 JobSkillTable에 없는 옛 Id만 채운다.
			for _, name in ipairs({ "JobSkillTable", "HeroSkillTable" }) do
				local t = _DataService:GetTable(name)
				if t ~= nil then
					for i = 1, t:GetRowCount() do
						local id = t:GetCell(i, "SkillId")
						local icon = t:GetCell(i, "IconRUID") or ""
						if id ~= nil and icon ~= "" and self._T.mateIcons[id] == nil then self._T.mateIcons[id] = icon end
					end
				end
			end
		end
		local names = { Hero = "히어로", Bishop = "비숍", NightLord = "나이트로드", Bowmaster = "보우마스터", Viper = "바이퍼" }
		-- 4-B 보완·4-C: 구성원마다 자기 차수 이름·캐릭터 레벨 (전투 컴포넌트 RunLabel/RunLevel → 매니저 PartyLevels → 메인 레벨 순)
		local label = (cc.RunLabel ~= nil and cc.RunLabel ~= "") and cc.RunLabel or (names[cc.JobId] or cc.JobId)
		local lv = cc.RunLevel or 0
		if lv <= 0 then
			local idx = 0
			for v in string.gmatch(mgr.PartyLevels or "", "[^,]+") do
				idx = idx + 1
				if idx == k then lv = tonumber(v) or 0 end
			end
		end
		if lv <= 0 then lv = mgr.Level end
		setText("Job", tostring(k) .. "  " .. label .. "  Lv." .. tostring(lv))
		setBar("HpFill", hp / math.max(1, maxHp), 176)
		setText("HpText", tostring(math.floor(hp)) .. " / " .. tostring(math.floor(maxHp)))
		setBar("MpFill", cc.Mana / math.max(1, cc.ManaMax or 100), 176)
		local state = ""
		if down then
			state = "<color=#E5484D>쓰러짐</color>"
		elseif cc.JobId == "Hero" then
			state = "콤보 " .. tostring(cc.Combo)
		elseif cc.JobId == "Bishop" then
			state = "성수 " .. tostring(cc.HolyWater) .. "/" .. tostring(cc.HolyMaxNow)
		elseif cc.JobId == "NightLord" then
			state = "표식 " .. tostring(cc.Res) .. "/" .. tostring(cc.ResMax)
		elseif cc.JobId == "Bowmaster" then
			state = "화살 " .. tostring(cc.Res) .. "/" .. tostring(cc.ResMax)
		elseif cc.JobId == "Viper" then
			state = "에너지 " .. tostring(cc.Res)
		end
		setText("State", state)
		local list = {}
		for entry in string.gmatch(cc.SlotInfo or "", "[^|]+") do
			local id, left, max, lvRaw = string.match(entry, "^([^:]+):([^:]+):([^:]+):?([^:]*)$")
			-- 4-D: 넷째 값 "U" = 궁극기 게이지 칸 (left = 최대 − 게이지)
			if id ~= nil then table.insert(list, { id = id, left = tonumber(left) or 0, max = tonumber(max) or 0, lv = tonumber(lvRaw) or 0, ult = lvRaw == "U" }) end
		end
		-- 스킬 칸 툴팁용으로 이번 프레임 칸 정보를 보관
		self._T.slotTips = self._T.slotTips or {}
		self._T.slotTips[k] = list
		-- 스킬 개편: 칸 8개 (주력기·보조기·기술·하이퍼·5차 3칸·궁극기). 칸 크기는 UI에서 읽어 덮개 높이에 쓴다
		for i = 1, 8 do
			local slot = "S" .. tostring(i)
			local info = list[i]
			local icon = get(slot .. "/Icon")
			if isvalid(icon) then
				local has = info ~= nil
				if icon.Enable ~= has then icon:SetEnable(has) end
				if has then
					local ruid = self._T.mateIcons[info.id] or ""
					local spr = icon.SpriteGUIRendererComponent
					if spr.PreserveSprite ~= PreserveSpriteType.None then spr.PreserveSprite = PreserveSpriteType.None end
					if spr.ImageRUID.DataId ~= ruid then spr.ImageRUID = DataRef(ruid) end
				end
			end
			local ratio = 0
			local cdText = ""
			if info ~= nil and info.ult then
				-- 궁극기: 차오를수록 덮개가 줄어든다. 글자는 충전 %, 가득이면 빈 글자
				if info.max > 0 and info.left > 0 then
					ratio = info.left / info.max
					-- 4-D 보완(U1): 소수 오차(58/100×100 = 57.999…)로 1 낮게 보이지 않게 아주 작은 값을 더해 내림
					cdText = tostring(math.floor((info.max - info.left) / info.max * 100 + 0.0001)) .. "%"
				end
			elseif info ~= nil and info.max > 0 and info.left > 0 then
				ratio = info.left / info.max
				cdText = tostring(math.ceil(info.left))
			end
			local cd = get(slot .. "/Cd")
			if isvalid(cd) then
				local box = get(slot)
				local full = isvalid(box) and box.UITransformComponent.RectSize.x or 72
				local h = full * ratio
				local sz = cd.UITransformComponent.RectSize
				if math.abs(sz.y - h) > 0.5 or math.abs(sz.x - full) > 0.5 then cd.UITransformComponent.RectSize = Vector2(full, h) end
			end
			setText(slot .. "/CdText", cdText)
			local lvText = ""
			if info ~= nil and info.lv > 0 then lvText = "Lv." .. tostring(info.lv) end
			setText(slot .. "/Lv", lvText)
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateHeroRes(Component mgr)
		-- 히어로 상태 줄(버프·소환검·자상·인스팅트 대기). 히어로 판 전투 중에만. 콤보·마나는 다른 곳에 표시.
		local root = _EntityService:GetEntityByPath("/ui/BattleHUD/HeroRes")
		if not isvalid(root) then return end
		local lp = _UserService.LocalPlayer
		local hc = (function() if not isvalid(lp) then return nil end for _, n in ipairs({ "script.HeroCombat", "script.BishopCombat", "script.JobCombat" }) do local c = lp:GetComponent(n) if c ~= nil and c.Active then return c end end return nil end)()
		local show = mgr ~= nil and hc ~= nil and hc.Active and (mgr.RunState == "FIGHT" or mgr.RunState == "CLEAR")
		if root.Enable ~= show then root:SetEnable(show) end
		if not show then return end
		local function setText(path, s)
			local e = _EntityService:GetEntityByPath("/ui/BattleHUD/HeroRes/" .. path)
			if isvalid(e) and e.TextGUIRendererComponent.Text ~= s then e.TextGUIRendererComponent.Text = s end
		end
		-- 콤보 칸·마나 막대는 쓰지 않는다 (콤보는 캐릭터 주위 구슬, 마나는 하단 바 MP). 상태 줄(버프·대기시간)만 남김.
		if not self._T.heroResSlim then
			self._T.heroResSlim = true
			for _, path in ipairs({ "Combo", "ComboLabel", "ComboNum", "ManaBg", "ManaLabel", "ManaNum" }) do
				local e = _EntityService:GetEntityByPath("/ui/BattleHUD/HeroRes/" .. path)
				if isvalid(e) then e:SetEnable(false) end
			end
			if isvalid(root.SpriteGUIRendererComponent) then root.SpriteGUIRendererComponent.Color = Color(0, 0, 0, 0) end
		end
		local status = hc.StatusText
		-- 3인 파티: 구성원 2·3번은 전용 패널에 표시. 상태 줄에는 쓰러짐만 알린다.
		local downs = {}
		if mgr.PlayerDown then table.insert(downs, "1번") end
		if mgr.CompanionMaxHp > 0 and mgr.CompanionDown then table.insert(downs, "2번") end
		if mgr.Companion2MaxHp > 0 and mgr.Companion2Down then table.insert(downs, "3번") end
		if #downs > 0 then status = "<color=#FF7070>구성원 " .. table.concat(downs, "·") .. " 쓰러짐 (웨이브를 끝내면 일어남)</color>   " .. status end
		setText("Status", status)
	end

end
