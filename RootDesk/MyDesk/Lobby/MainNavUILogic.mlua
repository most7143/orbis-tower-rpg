@Logic
script MainNavUILogic extends Logic

	-- 로비 공통 하단 탭. 고정 회색 발판 4개와 이동하는 선택 Sprite 1개를 분리한다.
	property string RootPath = "/ui/MainNavUI/Bar"
	property string LobbyMapName = "Lobby"
	property number SlideDuration = 0.36
	property number BottomBleed = 64
	property number SelectorY = 32
	property string PlatformNormal = "3237c8459578444da8e28ac88875e77b"
	property string PlatformHover = "17d114e8afa44912b525d4dd876d5fdc"
	property string PlatformPressed = "404512066de0498aaef6fe3524bcba94"
	property string SelectorNormal = "96d00a4b5e4148c4a81c05a47727567b"
	property string SelectorHover = "e83aed93796640c4ac42e46382040271"
	property string SelectorPressed = "e0eba98c86bc4a29abc68321543dabd5"
	property integer CurrentTab = 1

	@HideFromInspector
	property table connections = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- UI 생성 순서와 관계없이 준비가 끝난 뒤 한 번만 연결한다.
		self.connections = {}
		self._T.ready = false
		self._T.poll = 0
		self._T.shown = false
		self.CurrentTab = 1
		self:Setup()
		log("[VRF] mainnav begin height=92 tabs=4 selector=1")
	end

	@ExecSpace("ClientOnly")
	method boolean Setup()
		-- 발판·선택 표시·입력 레이어를 각각 캐시하고 네 탭 이벤트를 연결한다.
		if self._T.ready then return true end
		local bar = _EntityService:GetEntityByPath(self.RootPath)
		local selector = _EntityService:GetEntityByPath(self.RootPath .. "/Selector")
		if not isvalid(bar) or not isvalid(selector) then return false end
		local tabs = {}
		local titles = { "로비", "캐릭터", "성장", "뽑기" }
		for i = 1, 4 do
			local button = _EntityService:GetEntityByPath(self.RootPath .. "/Controls/Tab" .. tostring(i))
			local plate = _EntityService:GetEntityByPath(self.RootPath .. "/Bases/Plate" .. tostring(i))
			if not isvalid(button) or not isvalid(plate) then return false end
			tabs[i] = { entity = button, plate = plate, content = button:GetChildByName("Content"), title = titles[i], hover = false, pressed = false, disabled = false }
		end
		self._T.bar = bar
		self._T.selector = selector
		self._T.tabs = tabs
		self._T.pages = {
			_EntityService:GetEntityByPath("/ui/CharacterUI/Root"),
			_EntityService:GetEntityByPath("/ui/GrowthUI/Root"),
			_EntityService:GetEntityByPath("/ui/CharGachaUI/Root")
		}
		self._T.modals = {}
		for _, path in ipairs({ "/ui/ConfirmUI/Root", "/ui/OfflineUI/Root", "/ui/LevelUpUI/Root" }) do
			local e = _EntityService:GetEntityByPath(path)
			if isvalid(e) then table.insert(self._T.modals, e) end
		end
		self._T.ready = true
		self._T.layoutKey = ""
		bar:SetEnable(false)
		for i, rec in ipairs(tabs) do
			local index = i
			rec.entity.ButtonComponent.Selectable = false
			rec.entity.ButtonComponent.Transition = TransitionType.None
			self:Bind(rec.entity, ButtonClickEvent, function()
				if not rec.entity.ButtonComponent.Enable or not bar.EnabledInHierarchy then return end
				_UISoundLogic:PlayClick()
				self:SelectTab(index)
			end)
			self:Bind(rec.entity, UITouchEnterEvent, function() if index == self.CurrentTab then return end rec.hover = true self:ApplyState(index) end)
			self:Bind(rec.entity, UITouchExitEvent, function() rec.hover = false rec.pressed = false self:ApplyState(index) end)
			self:Bind(rec.entity, UITouchDownEvent, function() if not rec.entity.ButtonComponent.Enable then return end rec.pressed = true self:ApplyState(index) end)
			self:Bind(rec.entity, UITouchUpEvent, function() rec.pressed = false self:ApplyState(index) end)
		end
		self:ApplyLayout()
		log("[VRF] mainnav ready connected=4")
		return true
	end

	@ExecSpace("ClientOnly")
	method number TabX(integer index)
		-- 좁은 모바일 화면에서도 네 탭 중심이 실제 보이는 폭 안에 있도록 계산한다.
		local width = self._T.safeWidth or 1920
		return -width / 2 + width / 8 + (index - 1) * width / 4
	end

	@ExecSpace("ClientOnly")
	method void ApplyLayout()
		-- 가시 높이 92px은 유지하고 불투명 바탕을 캔버스 아래 64px까지 연장한다.
		local key = tostring(_UILogic.ScreenWidth) .. "x" .. tostring(_UILogic.ScreenHeight)
		if self._T.layoutKey == key then return end
		self._T.layoutKey = key
		local width = math.min(1920, 1080 * _UILogic.ScreenWidth / math.max(1, _UILogic.ScreenHeight))
		self._T.safeWidth = width
		self._T.bar.UITransformComponent.RectSize = Vector2(width, 92 + self.BottomBleed)
		self._T.bar.UITransformComponent.anchoredPosition = Vector2(0, -self.BottomBleed)
		self._T.selector.UITransformComponent.RectSize = Vector2(width / 4, 92)
		for i, rec in ipairs(self._T.tabs) do
			local x = self:TabX(i)
			rec.entity.UITransformComponent.anchoredPosition = Vector2(x, 0)
			rec.entity.UITransformComponent.RectSize = Vector2(width / 4, 92)
			rec.plate.UITransformComponent.anchoredPosition = Vector2(x, self.SelectorY)
			rec.plate.UITransformComponent.RectSize = Vector2(width / 4, 92)
			for _, name in ipairs({ "Label", "Glow" }) do
				local text = rec.content:GetChildByName(name)
				if isvalid(text) then text.UITransformComponent.RectSize = Vector2(width / 4 - 24, 26) end
			end
			if i < 4 then
				local line = _EntityService:GetEntityByPath(self.RootPath .. "/Controls/Separator" .. tostring(i))
				if isvalid(line) then line.UITransformComponent.anchoredPosition = Vector2(-width / 2 + i * width / 4, 0) end
			end
		end
		self:SetSelected(self.CurrentTab, false)
		log("[VRF] mainnav layout width=" .. tostring(width) .. " visibleHeight=92 bleed=" .. tostring(self.BottomBleed))
	end

	@ExecSpace("ClientOnly")
	method void Bind(Entity entity, any eventType, any fn)
		-- 연결 핸들을 보관해 플레이 종료 때 전부 해제한다.
		local h = entity:ConnectEvent(eventType, fn)
		table.insert(self.connections, { entity = entity, evt = eventType, connection = h })
	end

	@ExecSpace("ClientOnly")
	method boolean InLobby()
		-- 실제 로비 맵에서만 표시한다. 전투와 개발 테스트 맵에서는 숨긴다.
		local player = _UserService.LocalPlayer
		return isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap.Name == self.LobbyMapName
	end

	@ExecSpace("ClientOnly")
	method boolean ModalBlocked()
		-- 확인·오프라인 보상·레벨업 모달 중에는 하단을 통한 입력 우회를 막는다.
		for _, e in ipairs(self._T.modals or {}) do
			if isvalid(e) and e.EnabledInHierarchy then return true end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method boolean CanOpen(integer index)
		-- 기존 UnlockTable 규칙을 그대로 사용한다. 미선택과 실제 비활성은 구분한다.
		if index < 1 or index > 4 then return false end
		if index == 3 then return _GrowthUILogic:FirstOpenTab() > 0 end
		if index == 4 then return _UnlockRules:IsOpenLocal("CharGacha") end
		return true
	end

	@ExecSpace("ClientOnly")
	method integer VisibleTab()
		-- 닫기 버튼이나 다른 진입 경로로 열린 실제 화면과 선택 표시를 동기화한다.
		for i, page in ipairs(self._T.pages or {}) do
			if isvalid(page) and page.Enable then return i + 1 end
		end
		return 1
	end

	@ExecSpace("ClientOnly")
	method void ClosePages()
		-- 화면만 닫는다. 강화·뽑기의 서버 지급과 저장 값은 변경하지 않는다.
		_GrowthUILogic:Close()
		_CharacterUILogic:Close()
		_CharGachaUILogic:Close()
	end

	@ExecSpace("ClientOnly")
	method void SelectTab(integer index)
		-- 목적 화면을 한 번만 열고, 선택판은 현재 보간 위치에서 목적지까지 움직인다.
		if not self:Setup() or not self:InLobby() then return end
		if self:ModalBlocked() or not self:CanOpen(index) then
			log("[VRF] mainnav blocked tab=" .. tostring(index))
			return
		end
		if self.CurrentTab == index and self:VisibleTab() == index then return end
		_TooltipLogic:Hide()
		_RegionSelectLogic:Close()
		self:ClosePages()
		if index == 2 then _CharacterUILogic:Open()
		elseif index == 3 then _GrowthUILogic:Open()
		elseif index == 4 then _CharGachaUILogic:Open() end
		local actual = self:VisibleTab()
		self:SetSelected(actual, true)
		log("[VRF] mainnav page=" .. tostring(actual) .. " requested=" .. tostring(index))
	end

	@ExecSpace("ClientOnly")
	method void SetSelected(integer index, boolean animate)
		-- 네 발판은 고정하고 선택 Sprite 하나의 X만 바꾼다. 피벗·Y·크기는 고정이다.
		local selector = self._T.selector
		if not isvalid(selector) then return end
		local target = self:TabX(index)
		local current = selector.UITransformComponent.anchoredPosition.x
		self.CurrentTab = index
		self._T.tabs[index].hover = false
		self._T.tabs[index].pressed = false
		self._T.move = nil
		if animate and math.abs(current - target) > 0.1 then
			self._T.move = { from = current, target = target, elapsed = 0 }
			log("[VRF] mainnav slide from=" .. tostring(current) .. " to=" .. tostring(target))
		else
			selector.UITransformComponent.anchoredPosition = Vector2(target, self.SelectorY)
		end
		for i = 1, 4 do self:ApplyState(i) end
	end

	@ExecSpace("ClientOnly")
	method void RefreshLocks()
		-- 해금·모달 상태가 달라졌을 때만 입력과 표시를 갱신한다.
		local modal = self:ModalBlocked()
		for i, rec in ipairs(self._T.tabs) do
			local locked = not self:CanOpen(i)
			local disabled = locked or modal
			if rec.locked ~= locked or rec.disabled ~= disabled or rec.initialized ~= true then
				rec.locked = locked
				rec.disabled = disabled
				rec.initialized = true
				rec.pressed = false
				self:ApplyState(i)
				log("[VRF] mainnav state tab=" .. tostring(i) .. " locked=" .. tostring(locked) .. " input=" .. tostring(rec.entity.ButtonComponent.Enable))
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyState(integer index)
		-- 일반 4상태와 선택판 상태를 처리한다. 글자·아이콘만 비활성 알파를 적용한다.
		local rec = self._T.tabs[index]
		if rec == nil then return end
		local bg = self.PlatformNormal
		if not rec.disabled then
			if rec.pressed then bg = self.PlatformPressed elseif rec.hover then bg = self.PlatformHover end
		end
		if rec.bg ~= bg then rec.plate.SpriteGUIRendererComponent.ImageRUID = DataRef(bg) rec.bg = bg end
		rec.entity.ButtonComponent.Enable = not rec.disabled and index ~= self.CurrentTab
		local content = rec.content
		if isvalid(content) then
			content.CanvasGroupComponent.GroupAlpha = rec.disabled and 0.35 or 1
			content.UITransformComponent.anchoredPosition = Vector2(0, (rec.pressed and not rec.disabled) and -1 or 0)
			local label = content:GetChildByName("Label")
			local glow = content:GetChildByName("Glow")
			local icon = content:GetChildByName("Icon")
			local title = rec.title
			if rec.locked then title = title .. " · " .. _UnlockRules:LockText(index == 4 and "CharGacha" or "Slot") end
			if isvalid(label) then label.TextGUIRendererComponent.Text = title end
			if isvalid(glow) then
				glow.TextGUIRendererComponent.Text = title
				glow:SetEnable(rec.hover and not rec.disabled and not rec.pressed)
			end
			if isvalid(icon) then icon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, self.CurrentTab == index and 1 or 0.74) end
		end
		if index == self.CurrentTab then
			local selected = self.SelectorNormal
			if not rec.disabled then
				if rec.pressed then selected = self.SelectorPressed elseif rec.hover then selected = self.SelectorHover end
			end
			self._T.selector.SpriteGUIRendererComponent.ImageRUID = DataRef(selected)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 고정 레이어의 표시·화면 동기화와 0.36초 이동을 프레임 시간 기준으로 갱신한다.
		if not self:Setup() then return end
		self:ApplyLayout()
		local shown = self:InLobby()
		if self._T.shown ~= shown then
			self._T.shown = shown
			self._T.bar:SetEnable(shown)
			if not shown then self:SetSelected(1, false) end
			log("[VRF] mainnav visible=" .. tostring(shown))
		end
		if not shown then return end
		self._T.poll = self._T.poll - delta
		if self._T.poll <= 0 then
			self._T.poll = 0.1
			self:RefreshLocks()
			local actual = self:VisibleTab()
			if actual ~= self.CurrentTab then self:SetSelected(actual, true) end
		end
		local move = self._T.move
		if move ~= nil then
			move.elapsed = move.elapsed + delta
			local t = math.min(1, move.elapsed / math.max(0.01, self.SlideDuration))
			local eased = 1 - (1 - t) ^ 3
			self._T.selector.UITransformComponent.anchoredPosition = Vector2(move.from + (move.target - move.from) * eased, self.SelectorY)
			if t >= 1 then
				self._T.move = nil
				log("[VRF] mainnav arrived tab=" .. tostring(self.CurrentTab) .. " x=" .. tostring(move.target))
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 20개 이벤트와 진행 중인 이동 상태를 해제한다.
		for _, rec in ipairs(self.connections) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(rec.evt, rec.connection) end
		end
		self.connections = {}
		self._T.move = nil
		self._T.ready = false
	end
end
