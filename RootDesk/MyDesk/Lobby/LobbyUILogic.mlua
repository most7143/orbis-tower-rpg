@Logic
script LobbyUILogic extends Logic

	-- LobbyUI.ui 바인딩 (UIBuilder injectBindings로 주입)
	property Entity lobbyRoot = "ca754c14-c243-4e89-86e1-a8347b0f7fa8"
	property ButtonComponent btnPlay = "3b66162e-0c74-4b1f-acff-4e28c727a7ee"
	property ButtonComponent btnEngrave = "ff27894c-fbae-495e-8c32-71484ee63a3d"
	property ButtonComponent btnAchieve = "84cac690-1c03-4705-9def-ab603706aab0"
	property ButtonComponent btnSymbol = "f608bfef-817e-4aec-aa4b-2bf00ecc159c"
	property ButtonComponent btnGrace = "282df23c-78cf-427c-b867-b8a18ab5baac"
	-- 테스트용: 스킬 이펙트 테스트 맵 입장
	property ButtonComponent btnSkillTest = "7b5ace19-dcae-41ea-9748-ae12ee4e3205"
	property TextGUIRendererComponent noticeText = "d93951f9-f2bd-464b-a3a1-97ca120a9d6c"

	property string LobbyMapName = "Lobby"
	property number NoticeDuration = 1.5

	@HideFromInspector
	property table clickHandlers = {}
	@HideFromInspector
	property number NoticeTimer = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 로비 버튼 연결. 업적은 아직 준비 중 안내만 띄운다.
		self.clickHandlers = {}
		self:Bind(self.btnPlay, function() self:OnPlay() end)
		self:Bind(self.btnEngrave, function() _EngraveUILogic:Open() end)
		self:Bind(self.btnSymbol, function() _SymbolUILogic:Open() end)
		self:Bind(self.btnGrace, function() _GraceUILogic:Open() end)
		self:Bind(self.btnAchieve, function() self:ShowNotice("업적은 준비 중입니다") end)
		self:Bind(self.btnSkillTest, function() self:OnSkillTest() end)
		if isvalid(self.noticeText) then self.noticeText.Entity:SetEnable(false) end
		log("[VRF] LobbyUILogic begin buttons=" .. tostring(#self.clickHandlers))
	end

	@ExecSpace("ClientOnly")
	method void Bind(ButtonComponent button, any fn)
		-- 버튼 클릭 이벤트 연결 + 해제용 기록.
		if not isvalid(button) then return end
		local h = button.Entity:ConnectEvent(ButtonClickEvent, fn)
		table.insert(self.clickHandlers, { entity = button.Entity, eventHandler = h })
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 버튼 이벤트 해제.
		for _, rec in ipairs(self.clickHandlers) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
		end
		self.clickHandlers = {}
	end

	@ExecSpace("ClientOnly")
	method void OnPlay()
		-- 로비 맵 서버 컴포넌트에 입장 요청.
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) then return end
		local lobby = player.CurrentMap:GetComponent("script.LobbyManager")
		if lobby == nil then return end
		_ScreenFadeLogic:FadeOut(function() lobby:RequestPlay() end)
		log("[VRF] play button clicked")
	end

	@ExecSpace("ClientOnly")
	method void OnSkillTest()
		-- 테스트용: 스킬 이펙트 테스트 맵으로 이동 요청.
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) then return end
		local lobby = player.CurrentMap:GetComponent("script.LobbyManager")
		if lobby == nil then return end
		_ScreenFadeLogic:FadeOut(function() lobby:RequestSkillTest() end)
		log("[VRF] skill test button clicked")
	end

	@ExecSpace("ClientOnly")
	method void ShowNotice(string msg)
		-- 잠깐 안내 문구를 띄운다.
		if not isvalid(self.noticeText) then return end
		self.noticeText.Text = msg
		self.noticeText.Entity:SetEnable(true)
		self.NoticeTimer = self.NoticeDuration
		log("[VRF] notice: " .. msg)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 로비 맵에 있을 때만 로비 UI를 켠다.
		local player = _UserService.LocalPlayer
		local inLobby = isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap.Name == self.LobbyMapName
		if isvalid(self.lobbyRoot) and self.lobbyRoot.Enable ~= inLobby then
			self.lobbyRoot:SetEnable(inLobby)
		end
		if self.NoticeTimer > 0 then
			self.NoticeTimer = self.NoticeTimer - delta
			if self.NoticeTimer <= 0 and isvalid(self.noticeText) then self.noticeText.Entity:SetEnable(false) end
		end
	end

end
