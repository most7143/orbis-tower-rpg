@Logic
script TarotLogic extends Logic

	-- 카드 UI: 판 시작 직업 선택 3장 / 레벨업 스킬 카드 3장 선택. 아이콘 없이 이름만 표시
	-- 직업·직업 스킬 표시 문구도 여기서 만든다 (MainPanelLogic 직업·스킬 탭이 함께 씀)
	property Entity uiRoot = "a16d14bb-337a-4ea2-ae76-e74f6890a0cf"
	property Entity draftRoot = "90336c1b-0f08-4f25-9d35-293c3a5ead55"
	property Entity choiceRoot = "edbad653-a684-4ee9-aac6-948df8541a73"
	property Entity dimEntity = "9628a1f6-3176-4a2e-a321-84658b0b7545"
	property ButtonComponent confirmBtn = "c60050c0-f7aa-477e-a94d-678fa5a08648"
	property ButtonComponent card1 = "4b0221c1-2f92-484d-8f71-f012d5f7c890"
	property ButtonComponent card2 = "1a35acc6-61ea-406d-82d1-3dfcf3a5b3b6"
	property ButtonComponent card3 = "225cd561-92ea-4db7-a3ef-56683b9b7fe0"
	property TextGUIRendererComponent choiceSub = "e6894ec9-85d1-4f42-9f1d-000c89f9926f"
	property TextGUIRendererComponent choiceJob = "75cb595d-a176-4c5d-8029-5a35e51d37f8"
	property TextGUIRendererComponent choiceRemain = "d75074fc-59dc-4c4d-888f-fbe40154dfb7"
	-- 각인 '재추첨' 버튼 (남은 횟수가 있을 때만 표시)
	property ButtonComponent rerollBtn = "d617b190-510d-4dc7-afb0-6a0e94a76366"
	property string TraitTableName = "TraitTable"
	property string GradeTableName = "TraitGradeTable"
	property string ChoiceCardPath = "/ui/TarotUI/Choice/Card"
	property string ChoiceTitlePath = "/ui/TarotUI/Choice/Title"

	@HideFromInspector
	property table clickHandlers = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 테이블을 읽고 버튼을 연결한 뒤 화면을 숨긴다.
		self:LoadTables()
		self.clickHandlers = {}
		self:Bind(self.rerollBtn, function() self:OnReroll() end)
		local cards = { self.card1, self.card2, self.card3 }
		for i, c in ipairs(cards) do
			local slot = i
			self:Bind(c, function() self:OnPick(slot) end)
		end
		-- 처음엔 아무 화면도 기록되지 않은 상태(nil)로 두어야 Show("")가 실제로 전부 숨긴다
		self._T.shown = nil
		self._T.choiceSeq = -1
		self:Show("")
		log("[VRF] TarotLogic begin jobs=" .. tostring(#self._T.jobs) .. " grades=" .. tostring(#self._T.grades))
	end

	@ExecSpace("ClientOnly")
	method void Bind(ButtonComponent button, any fn)
		-- 버튼 클릭 연결 + 해제 기록.
		if not isvalid(button) then return end
		local h = button.Entity:ConnectEvent(ButtonClickEvent, function(e) _UISoundLogic:PlayClick() fn(e) end)
		table.insert(self.clickHandlers, { entity = button.Entity, eventHandler = h })
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 버튼 이벤트 해제.
		for _, rec in ipairs(self.clickHandlers) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
		end
		self.clickHandlers = {}
	end

	@ExecSpace("ClientOnly")
	method void LoadTables()
		-- 직업, 카드 테두리 색(등급 테이블), 직업 스킬 테이블.
		self._T.jobs = {}
		self._T.jobById = {}
		self._T.grades = {}
		local ds = _DataService:GetTable(self.TraitTableName)
		if ds ~= nil then
			for i = 1, ds:GetRowCount() do
				local j = {
					id = ds:GetCell(i, "Id"), name = ds:GetCell(i, "Name"), familyName = ds:GetCell(i, "FamilyName"),
					weapon = ds:GetCell(i, "Weapon") or "", keyword = ds:GetCell(i, "Keyword") or "",
					famColor = Color.FromHexCode(ds:GetCell(i, "FamilyColor")),
				}
				table.insert(self._T.jobs, j)
				self._T.jobById[j.id] = j
			end
		end
		local gs = _DataService:GetTable(self.GradeTableName)
		if gs ~= nil then
			for i = 1, gs:GetRowCount() do
				local g = tonumber(gs:GetCell(i, "Grade")) or i
				self._T.grades[g] = { name = gs:GetCell(i, "Name"), color = Color.FromHexCode(gs:GetCell(i, "ColorHex")) }
			end
		end
		-- 직업 스킬: jobSkills[직업 Id] = 표 순서대로 { id, name, max, icon, desc, vals = { v1 = {base, per}, ... } }
		self._T.jobSkills = {}
		self._T.skillById = {}
		local js = _DataService:GetTable("JobSkillTable")
		if js ~= nil then
			for i = 1, js:GetRowCount() do
				local job = js:GetCell(i, "JobId")
				local function num(col) return tonumber(js:GetCell(i, col)) or 0 end
				local sk = {
					id = js:GetCell(i, "SkillId"), job = job, name = js:GetCell(i, "Name"), max = tonumber(js:GetCell(i, "MaxLv")) or 5,
					icon = js:GetCell(i, "IconRUID") or "", desc = js:GetCell(i, "Desc") or "",
					vals = { v1 = { num("V1"), num("V1Per") }, v2 = { num("V2"), num("V2Per") }, c = { num("Chance"), num("ChancePer") }, p = { num("Pct"), num("PctPer") } },
				}
				if self._T.jobSkills[job] == nil then self._T.jobSkills[job] = {} end
				table.insert(self._T.jobSkills[job], sk)
				self._T.skillById[sk.id] = sk
			end
		end
	end

	@ExecSpace("ClientOnly")
	method Component GetManager()
		-- 현재 맵의 탑 진행 매니저.
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) then return nil end
		return player.CurrentMap:GetComponent("script.TowerRunManager")
	end

	@ExecSpace("ClientOnly")
	method table GetJob(string jobId)
		-- 직업 정보 (없으면 nil).
		return self._T.jobById[jobId]
	end

	@ExecSpace("ClientOnly")
	method table GetJobSkills(string jobId)
		-- 직업의 스킬 목록 (표 순서).
		return self._T.jobSkills[jobId] or {}
	end

	@ExecSpace("ClientOnly")
	method string SkillDesc(table sk, integer lv)
		-- 그 레벨의 스킬 효과 문구: Desc의 {v1}/{v2}/{c}/{p}를 1레벨 값 + 레벨당 증가 × (레벨 - 1)로 채운다.
		local shown = math.max(1, lv)
		local text = sk.desc
		for key, v in pairs(sk.vals) do
			local value = v[1] + v[2] * (shown - 1)
			local vs = tostring(math.floor(value))
			if math.abs(value - math.floor(value)) > 0.001 then vs = string.format("%.1f", value) end
			text = (string.gsub(text, "{" .. key .. "}", vs))
		end
		return text
	end

	@ExecSpace("ClientOnly")
	method string GetJobLabel(Component mgr)
		-- 캐릭터 탭·하단 바용 직업 문구 ("히어로" / "없음").
		if mgr == nil then return "없음" end
		local j = self._T.jobById[mgr.JobId]
		if j == nil then return "없음" end
		return j.name
	end

	@ExecSpace("ClientOnly")
	method void UpdateTraitTab(Component mgr)
		-- 직업 탭: 직업·무기·특징과 배운 스킬 목록 (아래 줄 목록은 쓰지 않음).
		local base = "/ui/MainPanel/Panel/Content/Trait/"
		local function setText(path, s)
			local e = _EntityService:GetEntityByPath(base .. path)
			if isvalid(e) and e.TextGUIRendererComponent.Text ~= s then e.TextGUIRendererComponent.Text = s end
			return e
		end
		if not self._T.traitTabLaidOut then
			self._T.traitTabLaidOut = true
			self:InitTraitTab(base)
		end
		local j = self._T.jobById[mgr.JobId]
		if j == nil then
			setText("Job", "직업  없음")
			setText("Effect", "판을 시작할 때 직업을 고릅니다")
			return
		end
		setText("Job", "직업  " .. j.name .. "  ·  " .. j.weapon)
		local lines = { "특징  " .. j.keyword, "" }
		local learned = 0
		for _, sk in ipairs(self:GetJobSkills(j.id)) do
			local lv = mgr.SkillLv[sk.id] or 0
			if lv > 0 then
				learned = learned + 1
				table.insert(lines, sk.name .. " Lv." .. tostring(lv) .. "/" .. tostring(sk.max) .. "  " .. self:SkillDesc(sk, lv))
			end
		end
		if learned == 0 then table.insert(lines, "아직 배운 스킬이 없습니다 (레벨업마다 스킬 카드 1장 선택)") end
		setText("Effect", table.concat(lines, "\n"))
	end

	@ExecSpace("ClientOnly")
	method void InitTraitTab(string base)
		-- 직업 탭 첫 표시: 직업 줄 목록을 숨기고, 스킬 목록 문구는 칸에 맞춰 글자 크기를 줄인다.
		local eff = _EntityService:GetEntityByPath(base .. "Effect")
		if isvalid(eff) then
			local tc = eff.TextGUIRendererComponent
			tc.MaxSize = tc.FontSize
			tc.MinSize = 11
			tc.BestFit = true
		end
		for i = 1, 7 do
			local row = _EntityService:GetEntityByPath(base .. "Row" .. tostring(i))
			if isvalid(row) then row:SetEnable(false) end
		end
	end

	@ExecSpace("ClientOnly")
	method void RelayoutCard(string path)
		-- 카드 첫 표시: 아이콘을 숨기고 글자를 위로 당긴다. 긴 글자는 칸에 맞춰 크기를 줄이고, 설명 칸은 여러 줄로 넓힌다.
		if self._T.laidOut == nil then self._T.laidOut = {} end
		if self._T.laidOut[path] then return end
		self._T.laidOut[path] = true
		local icon = _EntityService:GetEntityByPath(path .. "/Gold/Face/Icon")
		if isvalid(icon) then icon:SetEnable(false) end
		local shine = _EntityService:GetEntityByPath(path .. "/Gold/Face/ShineMask")
		if isvalid(shine) then shine:SetEnable(false) end
		local ys = { Trait = 80, Grade = 42, Progress = 8, Next = -66 }
		for name, y in pairs(ys) do
			local e = _EntityService:GetEntityByPath(path .. "/Gold/Face/" .. name)
			if isvalid(e) then
				local ap = e.UITransformComponent.anchoredPosition
				e.UITransformComponent.anchoredPosition = Vector2(ap.x, y)
				if name == "Next" then e.UITransformComponent.RectSize = Vector2(e.UITransformComponent.RectSize.x, 110) end
				local tc = e.TextGUIRendererComponent
				if isvalid(tc) then
					tc.MaxSize = tc.FontSize
					tc.MinSize = 10
					tc.BestFit = true
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void Show(string mode)
		-- "CHOICE"(직업 선택·스킬 카드 공용) / "" 에 맞춰 화면을 켜고 끈다. 예전 직업 펼침(Draft) 화면은 쓰지 않음.
		if self._T.shown == mode then return end
		self._T.shown = mode
		if isvalid(self.dimEntity) then self.dimEntity:SetEnable(mode ~= "") end
		if isvalid(self.draftRoot) then self.draftRoot:SetEnable(false) end
		if isvalid(self.choiceRoot) then self.choiceRoot:SetEnable(mode == "CHOICE") end
		log("[VRF] tarot show '" .. mode .. "'")
	end

	@ExecSpace("ClientOnly")
	method void PaintCard(string path, Color c)
		-- 카드 테두리(바깥·안쪽)와 면을 한 색 계열로 칠한다.
		local root = _EntityService:GetEntityByPath(path)
		if isvalid(root) then root.SpriteGUIRendererComponent.Color = c end
		local border = _EntityService:GetEntityByPath(path .. "/Gold")
		if isvalid(border) then border.SpriteGUIRendererComponent.Color = Color(c.r * 0.75, c.g * 0.75, c.b * 0.75, 1) end
		local face = _EntityService:GetEntityByPath(path .. "/Gold/Face")
		if isvalid(face) then face.SpriteGUIRendererComponent.Color = Color(0.05 + c.r * 0.2, 0.05 + c.g * 0.2, 0.07 + c.b * 0.2, 1) end
	end

	@ExecSpace("ClientOnly")
	method void FillCard(string path, string id, Component mgr, boolean jobSelect)
		-- 카드 한 장 채우기. 직업 카드: 이름 / 무기 / 계열 / 특징. 스킬 카드: 이름 / 새로 배우기·강화 / 레벨 / 다음 레벨 효과.
		self:RelayoutCard(path)
		local function txt(sub, s, color)
			local e = _EntityService:GetEntityByPath(path .. "/Gold/Face/" .. sub)
			if isvalid(e) then
				e.TextGUIRendererComponent.Text = s
				if color ~= nil then e.TextGUIRendererComponent.FontColor = color end
			end
		end
		local white = Color(1, 1, 1, 1)
		if jobSelect then
			local j = self._T.jobById[id]
			if j == nil then return end
			local fc = j.famColor
			self:PaintCard(path, fc)
			txt("Trait", j.name, white)
			txt("Grade", j.weapon, Color(0.55 + fc.r * 0.45, 0.55 + fc.g * 0.45, 0.55 + fc.b * 0.45, 1))
			txt("Progress", j.familyName, white)
			txt("Next", j.keyword, white)
			return
		end
		local sk = self._T.skillById[id]
		if sk == nil then return end
		local lv = mgr.SkillLv[sk.id] or 0
		-- 테두리: 새 스킬 = 희귀(파랑), 강화 = 일반(회색), 이번에 최고 레벨 = 에픽(보라)
		local grade = 1
		local label = "강화"
		if lv == 0 then
			grade = 2
			label = "새로 배우기"
		elseif lv + 1 >= sk.max then
			grade = 3
			label = "최고 레벨 달성"
		end
		local g = self._T.grades[grade] or { color = Color(0.6, 0.6, 0.64, 1) }
		self:PaintCard(path, g.color)
		txt("Trait", sk.name, white)
		txt("Grade", label, g.color)
		txt("Progress", "Lv." .. tostring(lv) .. " → " .. tostring(lv + 1) .. " / " .. tostring(sk.max), white)
		txt("Next", self:SkillDesc(sk, lv + 1), white)
	end

	@ExecSpace("ClientOnly")
	method void FillChoice(Component mgr)
		-- 카드 3장 (빈 칸은 숨김) + 제목·안내 문구. 직업 선택과 레벨업 스킬 카드가 같은 화면을 쓴다.
		local jobSelect = mgr.RunState == "JOBSELECT"
		for i = 1, 3 do
			local key = tostring(i)
			local id = mgr.ChoiceIds[key] or ""
			local path = self.ChoiceCardPath .. key
			local root = _EntityService:GetEntityByPath(path)
			if isvalid(root) then root:SetEnable(id ~= "") end
			if id ~= "" then self:FillCard(path, id, mgr, jobSelect) end
		end
		local title = _EntityService:GetEntityByPath(self.ChoiceTitlePath)
		local job = self._T.jobById[mgr.JobId]
		if jobSelect then
			if isvalid(title) then title.TextGUIRendererComponent.Text = "직업을 선택하세요" end
			if isvalid(self.choiceSub) then self.choiceSub.Text = "게임 시작" end
			if isvalid(self.choiceJob) then self.choiceJob.Text = "직업마다 무기와 스킬이 다릅니다" end
		else
			if isvalid(title) then title.TextGUIRendererComponent.Text = "강화할 스킬을 고르세요" end
			if isvalid(self.choiceSub) then self.choiceSub.Text = "Lv." .. tostring(mgr.Level) .. " — 스킬 강화" end
			if isvalid(self.choiceJob) then
				local name = "없음"
				if job ~= nil then name = job.name end
				self.choiceJob.Text = "현재 직업: " .. name
			end
		end
		if isvalid(self.choiceRemain) then
			if not jobSelect and mgr.PendingPicks > 1 then self.choiceRemain.Text = "남은 선택 " .. tostring(mgr.PendingPicks) else self.choiceRemain.Text = "" end
		end
		log("[VRF] tarot choice filled seq=" .. tostring(mgr.ChoiceSeq) .. " jobSelect=" .. tostring(jobSelect))
	end

	@ExecSpace("ClientOnly")
	method void OnPick(integer slot)
		-- 카드 선택 → 서버에 반영 (직업 선택 / 스킬 카드).
		local mgr = self:GetManager()
		if mgr == nil then return end
		if mgr.RunState == "JOBSELECT" then
			mgr:RequestPickJob(slot)
		elseif mgr.RunState == "CHOICE" then
			mgr:RequestPick(slot)
		end
		log("[VRF] tarot pick " .. tostring(slot))
	end

	@ExecSpace("ClientOnly")
	method void OnReroll()
		-- 각인 재추첨: 지금 스킬 카드 3장을 다시 뽑는다.
		local mgr = self:GetManager()
		if mgr ~= nil and mgr.RunState == "CHOICE" and mgr.Rerolls > 0 then mgr:RequestReroll() end
		log("[VRF] tarot reroll clicked")
	end

	@ExecSpace("ClientOnly")
	method void UpdateReroll(Component mgr)
		-- 재추첨 버튼: 스킬 카드에서 남은 횟수가 있을 때만 보이고 횟수를 표시한다.
		if not isvalid(self.rerollBtn) then return end
		local e = self.rerollBtn.Entity
		local show = mgr.RunState == "CHOICE" and mgr.Rerolls > 0
		if e.Enable ~= show then e:SetEnable(show) end
		if show then
			local s = "다시 뽑기 (" .. tostring(mgr.Rerolls) .. ")"
			if e.TextGUIRendererComponent.Text ~= s then e.TextGUIRendererComponent.Text = s end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 판 상태에 맞춰 화면 전환: 직업 선택(JOBSELECT)·스킬 카드(CHOICE)일 때 카드 화면.
		local mgr = self:GetManager()
		if mgr == nil then
			self:Show("")
			return
		end
		local state = mgr.RunState
		if state == "JOBSELECT" or state == "CHOICE" then
			if self._T.shown ~= "CHOICE" or self._T.choiceSeq ~= mgr.ChoiceSeq then
				self._T.choiceSeq = mgr.ChoiceSeq
				self:FillChoice(mgr)
			end
			self:Show("CHOICE")
			self:UpdateReroll(mgr)
		else
			self:Show("")
		end
	end

end
