@Logic
script TooltipLogic extends Logic

	-- 공용 툴팁 (ui/TooltipUI). 항상 1개만, 모든 화면보다 위에 띄운다.
	-- 바탕은 메이플 장비 툴팁 틀(9-슬라이스) 하나 + 구분선. 구분선 위 = 타이틀, 아래 = 본문 (내용 길이에 따라 동적 배치).
	-- 종류: 글자(ShowText) / 아이템 목록(ShowItems) / 스킬 상세(ShowSkill). 닫기는 Hide().
	-- 떠 있는 동안 전체 화면 투명 판이 입력을 흡수한다: 다른 곳을 누르면 닫기만 하고 아래 버튼은 눌리지 않는다.
	-- Register(대상, 함수)로 등록한 대상을 누르면 닫는 대신 그 함수를 불러 툴팁을 바로 바꾼다 (같은 대상이면 닫힘).
	property string RootPath = "/ui/TooltipUI"
	-- 화면 가장자리 여백, 대상과 툴팁 사이 간격
	property number EdgeMargin = 10
	property number TargetGap = 8
	-- 화면 오른쪽 위 시스템 버튼 금지 영역 (1920×1080 기준 x≥740, y≥410 → 오른쪽·위 끝에서 220·130)
	property number BlockRight = 220
	property number BlockTop = 130
	property number TextWidth = 440
	property number ItemCell = 72
	property number ItemGap = 8
	property integer ItemPerRow = 6
	property number SkillWidth = 480
	-- 메이플 장비 툴팁 틀(9-슬라이스) 안쪽 배치: 위 여백 → 타이틀 → 간격 → 구분선 → 간격 → 본문 → 아래 여백
	property number PadTop = 16
	property number PadBottom = 18
	property number TitleGap = 10
	property number LineHeight = 6
	property number BodyGap = 12

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 상태 초기화와 입력 차단 판 연결.
		-- 다른 로직이 먼저 Register했을 수 있으므로 대상 목록은 지우지 않는다
		self._T.kind = self._T.kind or ""
		self._T.targets = self._T.targets or {}
		self:Connect()
		log("[VRF] TooltipLogic begin (client)")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 입력 차단 판 연결 해제.
		local blocker = self:E("Blocker")
		if self._T.blockHandler ~= nil and isvalid(blocker) then blocker:DisconnectEvent(UITouchDownEvent, self._T.blockHandler) end
		self._T.blockHandler = nil
	end

	@ExecSpace("ClientOnly")
	method Entity E(string sub)
		-- 툴팁 화면 아래 엔티티 찾기.
		if sub == "" then return _EntityService:GetEntityByPath(self.RootPath) end
		return _EntityService:GetEntityByPath(self.RootPath .. "/" .. sub)
	end

	@ExecSpace("ClientOnly")
	method boolean Connect()
		-- 입력 차단 판에 누름 이벤트를 한 번만 연결한다 (UI 준비 전이면 다음 호출 때 다시 시도).
		if self._T.blockHandler ~= nil then return true end
		local blocker = self:E("Blocker")
		if not isvalid(blocker) then return false end
		self._T.blockHandler = blocker:ConnectEvent(UITouchDownEvent, function(evt) self:OnBlockerDown(evt) end)
		return true
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 대상이 사라지거나 숨겨지면(화면 닫힘·맵 이동) 툴팁도 닫는다.
		if self._T.kind == nil or self._T.kind == "" then return end
		local t = self._T.target
		if not isvalid(t) or not t.EnabledInHierarchy then self:Hide() end
	end

	@ExecSpace("ClientOnly")
	method void Register(Entity target, any fn)
		-- 툴팁 대상 등록: 툴팁이 떠 있을 때 이 대상을 누르면 fn()을 불러 바로 교체한다.
		if not isvalid(target) or fn == nil then return end
		self._T.targets = self._T.targets or {}
		for _, rec in ipairs(self._T.targets) do
			if rec.entity == target then
				rec.fn = fn
				return
			end
		end
		table.insert(self._T.targets, { entity = target, fn = fn })
	end

	@ExecSpace("ClientOnly")
	method void Unregister(Entity target)
		-- 툴팁 대상 등록 해제.
		local list = self._T.targets or {}
		for i = #list, 1, -1 do
			if list[i].entity == target or not isvalid(list[i].entity) then table.remove(list, i) end
		end
		if self._T.target == target then self:Hide() end
	end

	@ExecSpace("ClientOnly")
	method boolean IsShowing(Entity target)
		-- 지금 이 대상의 툴팁이 떠 있는지 (target이 nil이면 아무 툴팁이나).
		if self._T.kind == nil or self._T.kind == "" then return false end
		if target == nil then return true end
		return self._T.target == target
	end

	@ExecSpace("ClientOnly")
	method void Hide()
		-- 툴팁과 입력 차단 판을 모두 닫는다.
		for _, n in ipairs({ "TextTip", "ItemTip", "SkillTip", "Blocker" }) do
			local e = self:E(n)
			if isvalid(e) and e.Enable then e:SetEnable(false) end
		end
		self._T.kind = ""
		self._T.target = nil
	end

	@ExecSpace("ClientOnly")
	method boolean Begin(Entity target, string kind)
		-- 공통 시작: 같은 대상을 다시 누르면 닫고 false. 아니면 이전 툴팁을 닫고 true.
		self:Connect()
		if (self._T.kind or "") ~= "" and self._T.target == target then
			self:Hide()
			return false
		end
		self:Hide()
		if not isvalid(self:E(kind)) then return false end
		return true
	end

	@ExecSpace("ClientOnly")
	method void Finish(Entity target, string kind, number w, number h)
		-- 공통 마무리: 크기 적용 → 대상 기준 위치 보정 → 입력 차단 판과 함께 표시.
		local panel = self:E(kind)
		panel.UITransformComponent.RectSize = Vector2(w, h)
		local pos = self:Place(target, w, h)
		panel.UITransformComponent.anchoredPosition = pos
		local blocker = self:E("Blocker")
		if isvalid(blocker) then blocker:SetEnable(true) end
		panel:SetEnable(true)
		self._T.kind = kind
		self._T.target = target
		log("[VRF] Tooltip show kind=" .. kind .. " pos=" .. string.format("%.0f,%.0f", pos.x, pos.y) .. " size=" .. string.format("%.0f,%.0f", w, h))
	end

	@ExecSpace("ClientOnly")
	method void Layout(Entity target, string kind, number w, number headerH, number bodyH)
		-- 공통 배치: 타이틀 높이로 구분선 y를, 본문 높이로 전체 높이를 정한 뒤 표시한다.
		local lineY = self.PadTop + headerH + self.TitleGap
		local line = self:E(kind .. "/Line")
		if isvalid(line) then
			line.UITransformComponent.RectSize = Vector2(w, self.LineHeight)
			line.UITransformComponent.anchoredPosition = Vector2(0, -lineY)
		end
		local bodyY = lineY + self.LineHeight + self.BodyGap
		local body = self:E(kind .. "/Body")
		body.UITransformComponent.anchoredPosition = Vector2(0, -bodyY)
		body.UITransformComponent.RectSize = Vector2(w - 8, bodyH)
		self:Finish(target, kind, w, bodyY + bodyH + self.PadBottom)
	end

	@ExecSpace("ClientOnly")
	method number FitText(Entity e, string text, number width, number minH)
		-- 글자 높이를 재서 칸 크기를 맞춘다 (폭 고정, 길면 줄바꿈).
		local tg = e.TextGUIRendererComponent
		tg.Text = text or ""
		local h = math.max(minH, tg:GetPreferredHeight(text or "", width))
		e.UITransformComponent.RectSize = Vector2(width, h)
		return h
	end

	@ExecSpace("ClientOnly")
	method void ShowText(Entity target, string title, string body)
		-- 글자 툴팁: 폭 고정, 타이틀·설명 길이에 맞춰 구분선 위치와 높이를 정한다.
		if not self:Begin(target, "TextTip") then return end
		local w = self.TextWidth
		local titleE = self:E("TextTip/Title")
		local titleH = self:FitText(titleE, title or "", w - 36, 30)
		titleE.UITransformComponent.anchoredPosition = Vector2(18, -self.PadTop)
		local te = self:E("TextTip/Body/Text")
		local th = self:FitText(te, body or "", w - 36, 24)
		te.UITransformComponent.anchoredPosition = Vector2(14, 0)
		self:Layout(target, "TextTip", w, titleH, th)
	end

	@ExecSpace("ClientOnly")
	method void ShowItems(Entity target, string title, table ruids)
		-- 아이템 목록 툴팁: 제목 1줄 + 아이콘 칸 (한 줄 최대 ItemPerRow칸, 최대 12칸).
		if not self:Begin(target, "ItemTip") then return end
		local list = ruids or {}
		local n = math.min(12, #list)
		local cols = math.max(1, math.min(self.ItemPerRow, n))
		local rows = math.max(1, math.ceil(n / self.ItemPerRow))
		local step = self.ItemCell + self.ItemGap
		local innerW = cols * self.ItemCell + (cols - 1) * self.ItemGap + 28
		local titleE = self:E("ItemTip/Title")
		titleE.TextGUIRendererComponent.Text = title or ""
		-- 제목이 길면 폭을 늘린다 (최대 화면 절반, 넘치면 두 줄). 아이콘 칸은 가운데 정렬
		local titleW = titleE.TextGUIRendererComponent:GetPreferredWidth(title or "") + 36
		local w = math.max(innerW + 8, math.min(titleW, 600), 240)
		local titleH = self:FitText(titleE, title or "", w - 36, 30)
		titleE.UITransformComponent.anchoredPosition = Vector2(18, -self.PadTop)
		local offX = (w - 8 - innerW) / 2
		for i = 1, 12 do
			local slot = self:E("ItemTip/Body/Slot" .. tostring(i))
			if isvalid(slot) then
				local on = i <= n
				if slot.Enable ~= on then slot:SetEnable(on) end
				if on then
					local c = (i - 1) % self.ItemPerRow
					local r = math.floor((i - 1) / self.ItemPerRow)
					slot.UITransformComponent.anchoredPosition = Vector2(offX + 14 + c * step, -r * step)
					local icon = slot:GetChildByName("Icon")
					if isvalid(icon) then
						local spr = icon.SpriteGUIRendererComponent
						if spr.PreserveSprite ~= PreserveSpriteType.None then spr.PreserveSprite = PreserveSpriteType.None end
						spr.ImageRUID = DataRef(list[i] or "")
						spr.Color = Color(1, 1, 1, 1)
					end
				end
			end
		end
		local bodyH = rows * self.ItemCell + (rows - 1) * self.ItemGap
		self:Layout(target, "ItemTip", w, titleH, bodyH)
	end

	@ExecSpace("ClientOnly")
	method table ElemHex()
		-- 속성 글자색 (ElementTable.Color 기준, 표가 없으면 기본값). 어둠은 검은 툴팁 바탕에서 읽히게 밝은 남보라 유지.
		if self._T.elemHex ~= nil then return self._T.elemHex end
		local t = { Fire = "#F26B2A", Ice = "#4FB6E8", Lightning = "#22C3A6", Poison = "#B07AE0", Holy = "#F2C230", Dark = "#9C8AD6" }
		local ds = _DataService:GetTable("ElementTable")
		if ds ~= nil then
			for i = 1, ds:GetRowCount() do
				local id = ds:GetCell(i, "Id") or ""
				local c = ds:GetCell(i, "Color") or ""
				if t[id] ~= nil and id ~= "Dark" and c ~= "" then
					if string.sub(c, 1, 1) ~= "#" then c = "#" .. c end
					t[id] = c
				end
			end
		end
		self._T.elemHex = t
		return t
	end

	@ExecSpace("ClientOnly")
	method string CombatTag(string atk, string elem)
		-- 툴팁 한 줄 태그: "마법 · <속성색>성</color>". 무속성은 속성 글자를 생략한다.
		local parts = {}
		if atk == "M" or atk == "마법" then table.insert(parts, "마법") elseif atk == "P" or atk == "물리" then table.insert(parts, "물리") end
		local ids = { Fire = "Fire", Ice = "Ice", Lightning = "Lightning", Poison = "Poison", Holy = "Holy", Dark = "Dark",
			["불"] = "Fire", ["얼음"] = "Ice", ["번개"] = "Lightning", ["전기"] = "Lightning", ["독"] = "Poison", ["성"] = "Holy", ["신성"] = "Holy", ["어둠"] = "Dark", ["암흑"] = "Dark" }
		local names = { Fire = "불", Ice = "얼음", Lightning = "번개", Poison = "독", Holy = "성", Dark = "어둠" }
		local colors = self:ElemHex()
		local id = ids[elem]
		if id ~= nil then table.insert(parts, "<color=" .. colors[id] .. ">" .. names[id] .. "</color>") end
		return table.concat(parts, " · ")
	end

	@ExecSpace("ClientOnly")
	method void ShowSkill(Entity target, table data)
		-- 스킬 상세 툴팁. data = { icon, name, kind(칸 종류), cooldown(초, 0이면 생략), cooldownText(직접 문구), desc, breaks = { "이름: 설명", ... } }
		if not self:Begin(target, "SkillTip") then return end
		local d = data or {}
		local w = self.SkillWidth
		local icon = self:E("SkillTip/IconBg/Icon")
		if isvalid(icon) then
			local spr = icon.SpriteGUIRendererComponent
			if spr.PreserveSprite ~= PreserveSpriteType.None then spr.PreserveSprite = PreserveSpriteType.None end
			spr.ImageRUID = DataRef(d.icon or "")
			spr.Color = Color(1, 1, 1, 1)
		end
		local kindParts = {}
		if (d.kind or "") ~= "" then table.insert(kindParts, d.kind) end
		if (d.cooldownText or "") ~= "" then
			table.insert(kindParts, d.cooldownText)
		elseif (d.cooldown or 0) > 0 then
			local cd = d.cooldown
			local s = (math.abs(cd - math.floor(cd)) < 0.05) and tostring(math.floor(cd)) or string.format("%.1f", cd)
			table.insert(kindParts, "쿨타임 " .. s .. "초")
		end
		-- 전투 개편: 공격 타입(물리/마법)·속성을 속성색 글자로 (d.atk = P/M/물리/마법, d.elem = 속성 Id 또는 한글)
		local tag = self:CombatTag(d.atk or "", d.elem or "")
		if tag ~= "" then table.insert(kindParts, tag) end
		-- 타이틀: 왼쪽 아이콘(72) + 오른쪽 이름·종류 줄. 글자 묶음이 아이콘보다 낮으면 아이콘 가운데에 맞춘다
		local textX = 100
		local textW = w - textX - 16
		local nameE = self:E("SkillTip/Name")
		local kindE = self:E("SkillTip/Kind")
		local nameH = self:FitText(nameE, d.name or "", textW, 32)
		local kindStr = table.concat(kindParts, "  ·  ")
		local kindH = 0
		if kindStr ~= "" then kindH = self:FitText(kindE, kindStr, textW, 26) else kindE.TextGUIRendererComponent.Text = "" end
		local blockH = nameH + (kindH > 0 and (4 + kindH) or 0)
		local headerH = math.max(72, blockH)
		local top = self.PadTop + (headerH - blockH) / 2
		nameE.UITransformComponent.anchoredPosition = Vector2(textX, -top)
		kindE.UITransformComponent.anchoredPosition = Vector2(textX, -(top + nameH + 4))
		local iconBg = self:E("SkillTip/IconBg")
		if isvalid(iconBg) then iconBg.UITransformComponent.anchoredPosition = Vector2(16, -(self.PadTop + (headerH - 72) / 2)) end
		local text = d.desc or ""
		local breaks = d.breaks or {}
		if #breaks > 0 then
			if text ~= "" then text = text .. "\n\n" end
			-- 검은 배경 위에서 읽히도록 밝은 파랑
			text = text .. "<b><color=#8FBFFF>이번 판 돌파</color></b>"
			for _, b in ipairs(breaks) do text = text .. "\n· " .. b end
		end
		local te = self:E("SkillTip/Body/Text")
		local th = self:FitText(te, text, w - 36, 24)
		te.UITransformComponent.anchoredPosition = Vector2(14, 0)
		self:Layout(target, "SkillTip", w, headerH, th)
	end

	@ExecSpace("ClientOnly")
	method table Bounds()
		-- 툴팁 부모(루트) 기준 화면 반폭·반높이. 루트는 화면 전체로 늘어나므로 실제 크기를 쓴다.
		local root = self:E("")
		local size = Vector2(1920, 1080)
		if isvalid(root) then
			local s = root.UITransformComponent.RectSize
			if s.x > 1 and s.y > 1 then size = s end
		end
		return { hw = size.x / 2, hh = size.y / 2 }
	end

	@ExecSpace("ClientOnly")
	method table TargetRect(Entity target)
		-- 대상 UI 요소의 사각형을 화면 가운데 원점 UI 좌표(1920×1080 기준)로 구한다.
		-- GetWorldCorners/ToLocalPoint는 창 크기에 따라 어긋나므로, 부모를 따라 올라가며 앵커·피벗·위치·배율을 직접 합산한다.
		if not isvalid(target) or target.UITransformComponent == nil then return nil end
		local rt = target.UITransformComponent
		local sc = rt.Scale
		local w = rt.RectSize.x * sc.x
		local h = rt.RectSize.y * sc.y
		local cx = 0
		local cy = 0
		local e = target
		local guard = 0
		while isvalid(e) and e.UITransformComponent ~= nil and guard < 32 do
			guard = guard + 1
			local t = e.UITransformComponent
			local parent = e.Parent
			-- UI 그룹(화면 전체)에 닿으면 멈춘다: 그룹 중심 = 화면 중심
			if not isvalid(parent) or parent.UITransformComponent == nil then break end
			local ps = parent.UITransformComponent.RectSize
			local s = t.Scale
			local refX = t.AnchorsMin.x + (t.AnchorsMax.x - t.AnchorsMin.x) * t.Pivot.x
			local refY = t.AnchorsMin.y + (t.AnchorsMax.y - t.AnchorsMin.y) * t.Pivot.y
			local px = (refX - 0.5) * ps.x + t.anchoredPosition.x + (0.5 - t.Pivot.x) * t.RectSize.x * s.x
			local py = (refY - 0.5) * ps.y + t.anchoredPosition.y + (0.5 - t.Pivot.y) * t.RectSize.y * s.y
			-- 지금까지의 좌표(이 요소 기준)를 부모 기준으로: 이 요소 배율을 곱하고 이 요소 중심만큼 이동
			if e ~= target then
				cx = cx * s.x
				cy = cy * s.y
				w = w * s.x
				h = h * s.y
			end
			cx = cx + px
			cy = cy + py
			e = parent
		end
		return { minX = cx - w / 2, minY = cy - h / 2, maxX = cx + w / 2, maxY = cy + h / 2 }
	end

	@ExecSpace("ClientOnly")
	method Vector2 Place(Entity target, number w, number h)
		-- 위치: 대상 위쪽(공간이 모자라면 아래쪽), 가로는 대상 가운데 → 화면 안·금지 영역 밖으로 밀어 넣기.
		local b = self:Bounds()
		local m = self.EdgeMargin
		local r = self:TargetRect(target)
		if r == nil then r = { minX = 0, minY = 0, maxX = 0, maxY = 0 } end
		local cx = (r.minX + r.maxX) / 2
		local cy = r.maxY + self.TargetGap + h / 2
		if cy + h / 2 > b.hh - m then
			local below = r.minY - self.TargetGap - h / 2
			if below - h / 2 >= -b.hh + m then cy = below end
		end
		local function clamp(v, lo, hi)
			if lo > hi then return (lo + hi) / 2 end
			return math.max(lo, math.min(hi, v))
		end
		cx = clamp(cx, -b.hw + m + w / 2, b.hw - m - w / 2)
		cy = clamp(cy, -b.hh + m + h / 2, b.hh - m - h / 2)
		-- 오른쪽 위 금지 영역과 겹치면 왼쪽으로 밀기와 아래로 밀기 중 덜 움직이는 쪽
		local zx = b.hw - self.BlockRight
		local zy = b.hh - self.BlockTop
		if cx + w / 2 > zx and cy + h / 2 > zy then
			local leftX = zx - 4 - w / 2
			local downY = zy - 4 - h / 2
			local okLeft = leftX - w / 2 >= -b.hw + m
			local okDown = downY - h / 2 >= -b.hh + m
			if okLeft and (not okDown or math.abs(cx - leftX) <= math.abs(cy - downY)) then
				cx = leftX
			elseif okDown then
				cy = downY
			end
		end
		return Vector2(cx, cy)
	end

	@ExecSpace("ClientOnly")
	method void OnBlockerDown(UITouchDownEvent evt)
		-- 입력 차단 판 누름: 등록된 다른 대상 위면 그 툴팁으로 교체(같은 대상이면 닫힘), 아니면 닫기만.
		local root = self:E("")
		local hit = nil
		if isvalid(root) and evt ~= nil then
			local p = _UILogic:ScreenToLocalUIPosition(evt.TouchPoint, root.UITransformComponent)
			for _, rec in ipairs(self._T.targets or {}) do
				local e = rec.entity
				if isvalid(e) and e.EnabledInHierarchy then
					local r = self:TargetRect(e)
					if r ~= nil and p.x >= r.minX and p.x <= r.maxX and p.y >= r.minY and p.y <= r.maxY then hit = rec end
				end
			end
		end
		if hit ~= nil and hit.entity ~= self._T.target then
			log("[VRF] Tooltip blocker -> switch target=" .. hit.entity.Name)
			hit.fn()
			return
		end
		log("[VRF] Tooltip blocker -> close")
		self:Hide()
	end

end
