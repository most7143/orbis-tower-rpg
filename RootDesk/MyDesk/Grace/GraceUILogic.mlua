@Logic
script GraceUILogic extends Logic

	-- 미네르바의 은총 화면 (GraceUI.ui): 여신의 깃털로 은총 5줄 돌리기, 줄 클릭 잠금, 프리셋 3개, 옵션 도감.
	-- 데이터는 로컬 플레이어의 PlayerEngrave(GraceLines·Feathers 동기화)에서 읽고, 변경은 서버 요청.
	property Entity dimEntity = "fe18e743-51e8-45dd-bc5e-c2a6039a1e60"
	property Entity panelEntity = "469158c3-349f-4d40-aab1-a8418b6eeab3"
	property ButtonComponent btnClose = "7caf70ca-77d5-4e3a-8097-68cd976b00ee"
	property ButtonComponent btnRoll = "bbbbab34-8c0e-40fb-9d78-84f97bf19300"
	property ButtonComponent btnPreset1 = "b1736963-a4a5-46e4-9a31-d5b68faf3c56"
	property ButtonComponent btnPreset2 = "9d1b107a-d1eb-46f1-8709-576e3fc2d178"
	property ButtonComponent btnPreset3 = "969c43a3-7159-4f9c-98a4-4c5974ab9099"
	property string PanelPath = "/ui/GraceUI/Panel/"
	property string RowPath = "/ui/GraceUI/Panel/Rows/Row_"
	property integer Slots = 5
	property integer MaxLocks = 4
	property integer BaseCost = 10
	property integer LockCost = 10
	property integer BookRows = 22
	property string EmptySlotRUID = "f6c69495ec5e488c85c5ba8dce383045"
	property string EmptyTagRUID = "2be121078e3d41ffbf0ba3c1226cfc17"
	-- 잠글 수 있는 줄 위에 있을 때 쓰는 커서 (애니메이션 클립 LockCursor)
	property string LockCursorRUID = "33b2e7c280394e9f90e98b25851da730"
	-- 어두운 칸 이미지 위 글자색
	property Color RowTextColor = Color(0.14, 0.17, 0.21, 1)
	property Color SubTextColor = Color(0.36, 0.40, 0.46, 1)
	property Color SilverTextColor = Color(0.12, 0.34, 0.52, 1)
	property Color TopStepColor = Color(0.20, 0.48, 0.12, 1)
	property string PipOnHex = "#348524"
	property string PipOffHex = "#655776"
	-- 깃털이 모자랄 때 보유 수 색
	property string LackHex = "#C98B6B"
	-- 새로 뽑힌 줄 반짝임 시간(초)
	property number FlashTime = 0.45

	@HideFromInspector
	property table clickHandlers = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 옵션·등급·단계표를 읽고 버튼을 연결한 뒤 닫힌 상태로 시작한다.
		self._T.opts = {}
		self._T.optList = {}
		local optDs = _DataService:GetTable("GraceOptionTable")
		if optDs ~= nil then
			for i = 1, optDs:GetRowCount() do
				local o = { id = optDs:GetCell(i, "Id"), name = optDs:GetCell(i, "Name"), unit = optDs:GetCell(i, "Unit"), ranges = {} }
				for g = 1, 5 do
					o.ranges[g] = { min = tonumber(optDs:GetCell(i, "G" .. tostring(g) .. "Min")) or 0, max = tonumber(optDs:GetCell(i, "G" .. tostring(g) .. "Max")) or 0 }
				end
				self._T.opts[o.id] = o
				table.insert(self._T.optList, o)
			end
		end
		self._T.grades = {}
		local gs = _DataService:GetTable("GraceGradeTable")
		if gs ~= nil then
			for i = 1, gs:GetRowCount() do
				self._T.grades[tonumber(gs:GetCell(i, "Grade")) or i] = { name = gs:GetCell(i, "Name"), chance = gs:GetCell(i, "Chance"), text = Color.FromHexCode(gs:GetCell(i, "TextHex")), slot = gs:GetCell(i, "SlotRUID"), hover = gs:GetCell(i, "HoverRUID"), tag = gs:GetCell(i, "TagRUID") }
			end
		end
		self._T.steps = {}
		local ss = _DataService:GetTable("GraceStepTable")
		if ss ~= nil then
			for i = 1, ss:GetRowCount() do self._T.steps[tonumber(ss:GetCell(i, "Step")) or i] = { name = ss:GetCell(i, "Name"), chance = ss:GetCell(i, "Chance") } end
		end
		self.clickHandlers = {}
		self._T.touchHandlers = {}
		self._T.hoverSlot = 0
		self:Bind(self.btnClose, function() self:Close() _GrowthUILogic:Close() end)
		self:Bind(self.btnRoll, function() self:OnRoll() end)
		local presets = { self.btnPreset1, self.btnPreset2, self.btnPreset3 }
		for i, b in ipairs(presets) do
			local p = i
			self:Bind(b, function() self:OnPreset(p) end)
		end
		for i = 1, self.Slots do
			local slot = i
			-- 줄 자체가 잠금 버튼: 클릭하면 잠금/해제, 마우스가 올라가면 커서 변경
			local row = _EntityService:GetEntityByPath(self.RowPath .. tostring(i))
			if isvalid(row) then
				self:Bind(row.ButtonComponent, function() self:OnLock(slot) end)
				local enter = row:ConnectEvent(UITouchEnterEvent, function(e) self:SetHover(slot) end)
				local exit = row:ConnectEvent(UITouchExitEvent, function(e) if self._T.hoverSlot == slot then self:SetHover(0) end end)
				table.insert(self._T.touchHandlers, { entity = row, enter = enter, exit = exit })
			end
		end
		self:ApplySkins()
		self:InitBook()
		self._T.flash = {}
		self._T.rowSlot = {}
		self._T.open = true
		self:SetOpen(false)
		log("[VRF] GraceUILogic begin")
	end

	@ExecSpace("ClientOnly")
	method void ApplySkins()
		-- 프리셋(회색 기본 + 파랑 선택)과 은총 받기 버튼 이미지·글자색.
		local presets = { self.btnPreset1, self.btnPreset2, self.btnPreset3 }
		for _, b in ipairs(presets) do
			if isvalid(b) then
				_GrowthUILogic:StyleButton(b.Entity)
			end
		end
		if isvalid(self.btnRoll) then
			_GrowthUILogic:StyleButton(self.btnRoll.Entity)
		end
	end

	@ExecSpace("ClientOnly")
	method Entity Get(string name)
		-- 패널 안 엔티티.
		return _EntityService:GetEntityByPath(self.PanelPath .. name)
	end

	@ExecSpace("ClientOnly")
	method void SetText(string name, string s)
		-- 패널 안 글자 바꾸기.
		local e = self:Get(name)
		if isvalid(e) and e.TextGUIRendererComponent.Text ~= s then e.TextGUIRendererComponent.Text = s end
	end

	@ExecSpace("ClientOnly")
	method void InitBook()
		-- 옵션 도감: 22종 목록 연결, 등급·단계 확률은 표에서 한 번만 채운다.
		for i = 1, self.BookRows do
			local idx = i
			local item = self:Get("Book/List/Item_" .. tostring(i))
			if isvalid(item) then
				local o = self._T.optList[i]
				item:SetEnable(o ~= nil)
				if o ~= nil then
					self:SetText("Book/List/Item_" .. tostring(i) .. "/Label", o.name)
					self:Bind(item.ButtonComponent, function() self:SelectBook(idx) end)
					local enter = item:ConnectEvent(UITouchEnterEvent, function(e) self:SetBookHover(idx) end)
					local exit = item:ConnectEvent(UITouchExitEvent, function(e) if self._T.bookHover == idx then self:SetBookHover(0) end end)
					table.insert(self._T.touchHandlers, { entity = item, enter = enter, exit = exit })
				end
			end
		end
		self:SetText("Book/ListHead", "옵션 종류 · " .. tostring(#self._T.optList) .. "종")
		for g = 1, 5 do
			local info = self._T.grades[g]
			local tag = self:Get("Book/Tag_" .. tostring(g))
			if info ~= nil and isvalid(tag) then
				tag.SpriteGUIRendererComponent.ImageRUID = DataRef(info.tag)
				tag.TextGUIRendererComponent.Text = info.name
				tag.TextGUIRendererComponent.FontColor = info.text
				self:SetText("Book/Chance_" .. tostring(g), tostring(info.chance) .. "%")
			end
		end
		for s = 1, 5 do
			local info = self._T.steps[s]
			if info ~= nil then
				self:SetText("Book/StepName_" .. tostring(s), info.name)
				self:SetText("Book/StepChance_" .. tostring(s), tostring(info.chance) .. "%")
			end
		end
		self._T.bookHover = 0
		self:SelectBook(1)
	end

	@ExecSpace("ClientOnly")
	method void SetBookHover(integer idx)
		-- 도감 목록 호버 글자색.
		self._T.bookHover = idx
		self:RefreshBookList()
	end

	@ExecSpace("ClientOnly")
	method void SelectBook(integer idx)
		-- 도감 종류 선택: 오른쪽에 등급별 최소~최대 표시.
		local o = self._T.optList[idx]
		if o == nil then return end
		self._T.bookSel = idx
		self:RefreshBookList()
		self:SetText("Book/OptName", o.name)
		for g = 1, 5 do
			local r = o.ranges[g]
			self:SetText("Book/Range_" .. tostring(g), self:FormatNum(r.min) .. " ~ " .. self:FormatNum(r.max) .. o.unit)
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshBookList()
		-- 도감 목록의 선택 틀과 글자색.
		for i = 1, #self._T.optList do
			local path = "Book/List/Item_" .. tostring(i)
			local sel = self:Get(path .. "/Sel")
			local label = self:Get(path .. "/Label")
			local on = i == self._T.bookSel
			_UIButtonLogic:SetSelected(self:Get(path), on)
			if isvalid(sel) and sel.Enable ~= on then sel:SetEnable(on) end
			if isvalid(label) then
				local c = self.SubTextColor
				if on then c = self.SilverTextColor elseif i == self._T.bookHover then c = self.RowTextColor end
				label.TextGUIRendererComponent.FontColor = c
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void Bind(ButtonComponent button, any fn)
		-- 버튼 클릭 연결 + 해제 기록.
		if not isvalid(button) then return end
		local h = button.Entity:ConnectEvent(ButtonClickEvent, function(e) if not button.Entity.EnabledInHierarchy or not button.Enable then return end _UISoundLogic:PlayClick() fn(e) end)
		table.insert(self.clickHandlers, { entity = button.Entity, eventHandler = h })
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 버튼 이벤트 해제.
		for _, rec in ipairs(self.clickHandlers) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
		end
		self.clickHandlers = {}
		for _, rec in ipairs(self._T.touchHandlers or {}) do
			if isvalid(rec.entity) then
				rec.entity:DisconnectEvent(UITouchEnterEvent, rec.enter)
				rec.entity:DisconnectEvent(UITouchExitEvent, rec.exit)
			end
		end
		self._T.touchHandlers = {}
		self:ApplyCursor(false)
	end

	@ExecSpace("ClientOnly")
	method void SetHover(integer slot)
		-- 마우스가 올라간 줄 기록 (0이면 없음) 후 커서 갱신.
		self._T.hoverSlot = slot
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void ApplyCursor(boolean lockCursor)
		-- 잠금 커서 켜기/끄기 (바뀔 때만).
		if (self._T.cursorOn == true) == lockCursor then return end
		self._T.cursorOn = lockCursor
		if lockCursor then
			_InputService:SetCursor(self.LockCursorRUID, Vector2.zero)
		else
			_InputService:ResetCursor()
		end
		log("[VRF] grace cursor lock=" .. tostring(lockCursor))
	end

	@ExecSpace("ClientOnly")
	method Component GetEngrave()
		-- 로컬 플레이어의 저장 컴포넌트 (은총 포함).
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return nil end
		return player:GetComponent("script.PlayerEngrave")
	end

	@ExecSpace("ClientOnly")
	method void Open()
		-- 로비 [은총] 버튼.
		local eng = self:GetEngrave()
		if eng == nil or not eng.GraceLoaded then return end
		self._T.graceSeq = eng.GraceSeq
		self:SetOpen(true)
		self:Refresh()
		log("[VRF] grace open feathers=" .. tostring(eng.Feathers) .. " preset=" .. tostring(eng.GracePreset))
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 닫기.
		self:SetOpen(false)
	end

	@ExecSpace("ClientOnly")
	method boolean IsOpen()
		-- 은총 화면이 열려 있는지.
		return self._T.open == true
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		-- 배경·패널 표시 전환.
		if self._T.open == open then return end
		self._T.open = open
		if isvalid(self.dimEntity) then self.dimEntity:SetEnable(open) end
		if isvalid(self.panelEntity) then self.panelEntity:SetEnable(open) end
		if not open then
			self._T.hoverSlot = 0
			self:ApplyCursor(false)
		end
	end

	@ExecSpace("ClientOnly")
	method table ParseLine(string v)
		-- "옵션|등급|단계|잠금" → {id, grade, step, lock} (빈 줄이면 nil).
		if v == nil or v == "" then return nil end
		local parts = {}
		for part in string.gmatch(v, "[^|]+") do table.insert(parts, part) end
		return { id = parts[1] or "", grade = math.floor(tonumber(parts[2]) or 1), step = math.floor(tonumber(parts[3]) or 1), lock = parts[4] == "1" }
	end

	@ExecSpace("ClientOnly")
	method table CurrentLines(Component eng)
		-- 지금 프리셋의 5줄.
		local lines = {}
		for i = 1, self.Slots do
			lines[i] = self:ParseLine(eng.GraceLines[tostring(eng.GracePreset) .. "_" .. tostring(i)] or "")
		end
		return lines
	end

	@ExecSpace("ClientOnly")
	method integer LockCount(table lines)
		-- 잠긴 줄 수.
		local n = 0
		for i = 1, self.Slots do
			if lines[i] ~= nil and lines[i].lock then n = n + 1 end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method string FormatNum(number v)
		-- 정수면 정수, 아니면 소수 한 자리.
		if math.abs(v - math.floor(v)) < 0.001 then return tostring(math.floor(v)) end
		return string.format("%.1f", v)
	end

	@ExecSpace("ClientOnly")
	method void OnRoll()
		-- 은총 받기: 깃털이 모자라면 무시.
		local eng = self:GetEngrave()
		if eng == nil then return end
		local lines = self:CurrentLines(eng)
		local cost = self.BaseCost + self.LockCost * self:LockCount(lines)
		if eng.Feathers < cost then return end
		-- 이번에 새로 뽑힐 줄(잠기지 않은 줄)을 기억해 두었다가 결과가 오면 반짝인다
		self._T.rollRows = {}
		for i = 1, self.Slots do self._T.rollRows[i] = lines[i] == nil or not lines[i].lock end
		eng:RequestGraceRoll()
	end

	@ExecSpace("ClientOnly")
	method void OnLock(integer slot)
		-- 줄 클릭: 잠금/해제.
		local eng = self:GetEngrave()
		if eng ~= nil then eng:RequestGraceLock(slot) end
	end

	@ExecSpace("ClientOnly")
	method void OnPreset(integer preset)
		-- 프리셋 전환.
		local eng = self:GetEngrave()
		if eng ~= nil and eng.GracePreset ~= preset then eng:RequestGracePreset(preset) end
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		-- 프리셋 탭, 5줄(등급 배경·이름·수치·단계·잠금), 잠금 수 표시와 은총 받기 버튼(보유/필요 깃털).
		local eng = self:GetEngrave()
		if eng == nil then return end
		local lines = self:CurrentLines(eng)
		local locks = self:LockCount(lines)
		local cost = self.BaseCost + self.LockCost * locks
		local presets = { self.btnPreset1, self.btnPreset2, self.btnPreset3 }
		for i, b in ipairs(presets) do
			if isvalid(b) then
				_UIButtonLogic:SetSelected(b.Entity, i == eng.GracePreset)
			end
		end
		for i = 1, self.Slots do
			local base = self.RowPath .. tostring(i)
			local row = _EntityService:GetEntityByPath(base)
			local line = lines[i]
			local o = line ~= nil and self._T.opts[line.id] or nil
			local g = line ~= nil and self._T.grades[line.grade] or nil
			local function setText(name, text, color)
				local e = _EntityService:GetEntityByPath(base .. "/" .. name)
				if not isvalid(e) then return end
				e.TextGUIRendererComponent.Text = text
				if color ~= nil then e.TextGUIRendererComponent.FontColor = color end
			end
			if isvalid(row) then
				_UIButtonLogic:SetSelected(row, line ~= nil and line.lock)
				_UIButtonLogic:SetDisabled(row, line == nil)
			end
			local tag = _EntityService:GetEntityByPath(base .. "/Grade")
			if o ~= nil and g ~= nil then
				local r = o.ranges[line.grade]
				local v = r.min + (r.max - r.min) * (line.step - 1) / 4
				v = math.floor(v * 10 + 0.5) / 10
				setText("Grade", g.name, g.text)
				if isvalid(tag) then tag.SpriteGUIRendererComponent.ImageRUID = DataRef(g.tag) end
				setText("Name", o.name, self.RowTextColor)
				setText("Value", "+" .. self:FormatNum(v) .. o.unit, self.RowTextColor)
				local stepInfo = self._T.steps[line.step]
				local stepName = stepInfo ~= nil and stepInfo.name or ""
				local stepColor = self.SubTextColor
				if line.step >= 5 then stepColor = self.TopStepColor end
				setText("Step", stepName, stepColor)
			else
				setText("Grade", "-", self.SubTextColor)
				if isvalid(tag) then tag.SpriteGUIRendererComponent.ImageRUID = DataRef(self.EmptyTagRUID) end
				setText("Name", "비어 있음", self.SubTextColor)
				setText("Value", "", nil)
				setText("Step", "", nil)
			end
			-- 빈 줄은 잠글 수 없다
			local lockIcon = _EntityService:GetEntityByPath(base .. "/LockIcon")
			if isvalid(lockIcon) then lockIcon:SetEnable(line ~= nil and line.lock) end
		end
		local hover = self._T.hoverSlot or 0
		self:ApplyCursor(self._T.open == true and hover > 0 and lines[hover] ~= nil)
		-- 잠금 수: 네모 4칸 (쓴 칸만 밝게)
		local pips = ""
		for i = 1, self.MaxLocks do
			local hex = self.PipOffHex
			if i <= locks then hex = self.PipOnHex end
			pips = pips .. "<color=" .. hex .. ">■</color> "
		end
		self:SetText("LockPips", pips)
		local have = tostring(eng.Feathers)
		if eng.Feathers < cost then have = "<color=" .. self.LackHex .. ">" .. have .. "</color>" end
		self:SetText("Roll/Count", have .. " / " .. tostring(cost))
		if isvalid(self.btnRoll) then _UIButtonLogic:SetDisabled(self.btnRoll.Entity, eng.Feathers < cost) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateFlash(Component eng, number delta)
		-- 돌리기 결과가 오면 새로 뽑힌 줄을 잠깐 반짝인다.
		if eng.GraceSeq ~= self._T.graceSeq then
			self._T.graceSeq = eng.GraceSeq
			for i = 1, self.Slots do
				if self._T.rollRows == nil or self._T.rollRows[i] then self._T.flash[i] = self.FlashTime end
			end
			self:Refresh()
		end
		for i = 1, self.Slots do
			local f = _EntityService:GetEntityByPath(self.RowPath .. tostring(i) .. "/Flash")
			if isvalid(f) then
				local t = self._T.flash[i] or 0
				if t > 0 then
					t = t - delta
					self._T.flash[i] = t
				end
				local a = math.max(0, t / self.FlashTime) * 0.7
				if f.Enable ~= (a > 0) then f:SetEnable(a > 0) end
				if a > 0 then f.SpriteGUIRendererComponent.Color = Color(1, 1, 0.9, a) end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 열려 있는 동안 서버 동기화 값으로 갱신 (로비를 벗어나면 닫음).
		if not self._T.open then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) or player.CurrentMap.Name ~= "Lobby" then
			self:Close()
			return
		end
		local eng = self:GetEngrave()
		if eng == nil then return end
		self:UpdateFlash(eng, delta)
		self._T.refreshT = (self._T.refreshT or 0) + delta
		if self._T.refreshT >= 0.2 then
			self._T.refreshT = 0
			self:Refresh()
		end
	end

end
