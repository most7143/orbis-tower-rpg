@Logic
script SymbolUILogic extends Logic

	-- 심볼 화면 (SymbolUI.ui): 층마다 1~3단계 심볼, 20층씩 페이지. 데이터는 로컬 플레이어의 PlayerEngrave(SymbolLv 동기화)에서 읽는다.
	property Entity dimEntity = "62d72bf8-73e9-4989-a3a9-78f2e9e73535"
	property Entity panelEntity = "5fe924bc-b966-4442-90eb-889e5c03cb65"
	property ButtonComponent btnClose = "04a94533-0fd5-4f34-bcf9-62d7f0c8ad76"
	property string PanelPath = "/ui/SymbolUI/Panel/"
	property string CellPath = "/ui/SymbolUI/Panel/Grid/Cell_"
	property integer PageSize = 20
	property integer PermRows = 6
	property string TierTableName = "SymbolTierTable"
	property string PermTableName = "SymbolPermTable"
	property string FloorTableName = "FloorTable"
	property string MonsterTableName = "MonsterTable"
	property string CardRUID = "b98a964cddde44bc91cc608e648320d4"
	property string CardLockedRUID = "9f3b7d70600c434dbf531456a34f4865"
	property string OutlineRUID = "5ee1af3484dd4876859334a278bfa7db"
	property Color MainTextColor = Color(0.91, 0.91, 0.89, 1)
	property Color SubTextColor = Color(0.59, 0.59, 0.57, 1)
	property Color LockedTextColor = Color(0.45, 0.45, 0.45, 1)
	property Color GoldTextColor = Color(0.847, 0.733, 0.475, 1)

	@HideFromInspector
	property table clickHandlers = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 단계표·영구 능력치표·층 수를 읽고 버튼을 연결한 뒤 닫힌 상태로 시작한다.
		self._T.tiers = {}
		local ts = _DataService:GetTable(self.TierTableName)
		if ts ~= nil then
			for i = 1, ts:GetRowCount() do
				local t = tonumber(ts:GetCell(i, "Tier")) or i
				self._T.tiers[t] = {
					chance = tonumber(ts:GetCell(i, "Chance")) or 0, dmg = tonumber(ts:GetCell(i, "DmgPct")) or 0,
					cut = tonumber(ts:GetCell(i, "DmgCut")) or 0, gain = tonumber(ts:GetCell(i, "GainPct")) or 0, icon = ts:GetCell(i, "IconRUID"),
					prefix = ts:GetCell(i, "NamePrefix") or "",
				}
			end
		end
		self._T.perm = {}
		local ps = _DataService:GetTable(self.PermTableName)
		if ps ~= nil then
			for i = 1, ps:GetRowCount() do
				table.insert(self._T.perm, { type = ps:GetCell(i, "Type"), value = tonumber(ps:GetCell(i, "Value")) or 0, label = ps:GetCell(i, "Label") })
			end
		end
		-- 층별 몬스터 이름 (FloorTable.MonsterId → MonsterTable.Name)
		local monName = {}
		local ms = _DataService:GetTable(self.MonsterTableName)
		if ms ~= nil then
			for i = 1, ms:GetRowCount() do monName[ms:GetCell(i, "id")] = ms:GetCell(i, "Name") end
		end
		self._T.floorMonster = {}
		self._T.floorCount = 1
		local fs = _DataService:GetTable(self.FloorTableName)
		if fs ~= nil then
			self._T.floorCount = math.max(1, fs:GetRowCount())
			for i = 1, fs:GetRowCount() do
				self._T.floorMonster[tonumber(fs:GetCell(i, "Floor")) or i] = monName[fs:GetCell(i, "MonsterId")] or ""
			end
		end
		self.clickHandlers = {}
		self:Bind(self.btnClose, function() self:Close() end)
		self:Bind(self:Get("Prev").ButtonComponent, function() self:Turn(-1) end)
		self:Bind(self:Get("Next").ButtonComponent, function() self:Turn(1) end)
		local skin = { normal = "75f3c6dbf2434bcaa0e4b2d430575e2d", hover = "6ba383acf31a4c5bb105720d50c0ccd4", disabled = "f2cf3f5019aa4da995e72294dacb3e64" }
		_UIButtonLogic:SetSkin(self:Get("Prev"), skin)
		_UIButtonLogic:SetSkin(self:Get("Next"), skin)
		for i = 1, self.PageSize do
			local idx = i
			local cell = _EntityService:GetEntityByPath(self.CellPath .. tostring(i))
			if isvalid(cell) and isvalid(cell.ButtonComponent) then self:Bind(cell.ButtonComponent, function() self:SelectCell(idx) end) end
		end
		self._T.page = 1
		self._T.selected = 1
		self._T.open = true
		self:SetOpen(false)
		log("[VRF] SymbolUILogic begin floors=" .. tostring(self._T.floorCount))
	end

	@ExecSpace("ClientOnly")
	method void Bind(ButtonComponent button, any fn)
		-- 버튼 클릭 연결 + 해제 기록.
		if not isvalid(button) then return end
		local h = button.Entity:ConnectEvent(ButtonClickEvent, function(e) _UISoundLogic:PlayClick() fn(e) end)
		table.insert(self.clickHandlers, { entity = button.Entity, eventHandler = h })
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 버튼 이벤트 해제.
		for _, rec in ipairs(self.clickHandlers) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
		end
		self.clickHandlers = {}
	end

	@ExecSpace("ClientOnly")
	method Entity Get(string name)
		-- 패널 안 엔티티.
		return _EntityService:GetEntityByPath(self.PanelPath .. name)
	end

	@ExecSpace("ClientOnly")
	method void SetText(string name, string s)
		-- 패널 안 글자 바꾸기.
		local e = self:Get(name)
		if isvalid(e) and e.TextGUIRendererComponent.Text ~= s then e.TextGUIRendererComponent.Text = s end
	end

	@ExecSpace("ClientOnly")
	method void SetColor(string name, Color c)
		-- 패널 안 글자색 바꾸기.
		local e = self:Get(name)
		if isvalid(e) then e.TextGUIRendererComponent.FontColor = c end
	end

	@ExecSpace("ClientOnly")
	method Component GetEngrave()
		-- 로컬 플레이어의 저장 컴포넌트 (심볼 포함).
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return nil end
		return player:GetComponent("script.PlayerEngrave")
	end

	@ExecSpace("ClientOnly")
	method void Open()
		-- 성장 화면 심볼 탭: 최고 클리어 층이 있는 페이지로 연다.
		local eng = self:GetEngrave()
		if eng == nil or not eng.SymbolLoaded then return end
		local floor = math.max(1, math.min(self._T.floorCount, eng.ClearedFloor))
		self._T.page = math.floor((floor - 1) / self.PageSize) + 1
		self._T.selected = floor
		self:SetOpen(true)
		self:Refresh()
		log("[VRF] symbol open count=" .. tostring(eng.SymbolCount) .. " page=" .. tostring(self._T.page))
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 닫기.
		self:SetOpen(false)
	end

	@ExecSpace("ClientOnly")
	method boolean IsOpen()
		-- 심볼 화면이 열려 있는지.
		return self._T.open == true
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		-- 배경·패널 표시 전환.
		if self._T.open == open then return end
		self._T.open = open
		if isvalid(self.dimEntity) then self.dimEntity:SetEnable(open) end
		if isvalid(self.panelEntity) then self.panelEntity:SetEnable(open) end
	end

	@ExecSpace("ClientOnly")
	method void Turn(integer dir)
		-- 페이지 넘기기 (20층씩).
		local pages = math.floor((self._T.floorCount - 1) / self.PageSize) + 1
		self._T.page = math.max(1, math.min(pages, self._T.page + dir))
		self._T.selected = (self._T.page - 1) * self.PageSize + 1
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method void SelectCell(integer idx)
		-- 칸 선택: 오른쪽에 그 층 심볼 정보.
		local floor = (self._T.page - 1) * self.PageSize + idx
		if floor > self._T.floorCount then return end
		self._T.selected = floor
		self:Refresh()
	end

	@ExecSpace("ClientOnly")
	method table PermOf(integer floor)
		-- 그 층 3단계 심볼의 영구 능력치 (층 번호 순환).
		local n = #self._T.perm
		if n == 0 then return nil end
		return self._T.perm[((floor - 1) % n) + 1]
	end

	@ExecSpace("ClientOnly")
	method string FormatNum(number v)
		-- 정수면 정수, 아니면 소수 한 자리.
		if math.abs(v - math.floor(v)) < 0.001 then return tostring(math.floor(v)) end
		return string.format("%.1f", v)
	end

	@ExecSpace("ClientOnly")
	method string SymbolName(integer floor, integer tier)
		-- 심볼 이름: "<단계 접두사> <그 층 몬스터>의 심볼" (예: 불완전한 달팽이의 심볼).
		local t = self._T.tiers[math.max(1, tier)]
		local prefix = t ~= nil and t.prefix or ""
		local mon = self._T.floorMonster[floor] or ""
		if mon == "" then mon = tostring(floor) .. "층" end
		return prefix .. " " .. mon .. "의 심볼"
	end

	@ExecSpace("ClientOnly")
	method void Refresh()
		-- 칸(심볼·층·단계)과 오른쪽 정보, 수집 수·영구 효과 합계를 갱신한다.
		local eng = self:GetEngrave()
		if eng == nil then return end
		local base = (self._T.page - 1) * self.PageSize
		local pageCount = 0
		for i = 1, self.PageSize do
			local floor = base + i
			local path = self.CellPath .. tostring(i)
			local cell = _EntityService:GetEntityByPath(path)
			if isvalid(cell) then
				local exists = floor <= self._T.floorCount
				if cell.Enable ~= exists then cell:SetEnable(exists) end
				if exists then
					local tier = eng.SymbolLv[tostring(floor)] or 0
					if tier > 0 then pageCount = pageCount + 1 end
					self:RefreshCell(path, cell, floor, tier)
					if floor == self._T.selected then
						local p = cell.UITransformComponent.anchoredPosition
						self:Get("Grid/Select").UITransformComponent.anchoredPosition = p
					end
				end
			end
		end
		local pages = math.floor((self._T.floorCount - 1) / self.PageSize) + 1
		local lastFloor = math.min(self._T.floorCount, base + self.PageSize)
		self:SetText("Range", tostring(base + 1) .. "-" .. tostring(lastFloor) .. "층")
		self:SetText("PageCount", "획득 " .. tostring(pageCount) .. "개")
		self:SetText("Page", tostring(self._T.page) .. " / " .. tostring(pages) .. " 페이지")
		self:SetText("Count", tostring(eng.SymbolCount) .. " / " .. tostring(self._T.floorCount))
		_UIButtonLogic:SetDisabled(self:Get("Prev"), self._T.page <= 1)
		_UIButtonLogic:SetDisabled(self:Get("Next"), self._T.page >= pages)
		self:RefreshInfo(eng)
		self:RefreshPerm(eng)
	end

	@ExecSpace("ClientOnly")
	method void RefreshCell(string path, Entity cell, integer floor, integer tier)
		-- 획득 칸: 원본 심볼·층·단계 게이지. 미획득 칸: 작은 윤곽과 층.
		local owned = tier > 0
		local bg = self.CardLockedRUID
		if owned then bg = self.CardRUID end
		cell.SpriteGUIRendererComponent.ImageRUID = DataRef(bg)
		local icon = _EntityService:GetEntityByPath(path .. "/Icon")
		if isvalid(icon) then
			local t = self._T.tiers[tier]
			if owned and t ~= nil then
				icon.SpriteGUIRendererComponent.ImageRUID = DataRef(t.icon)
				icon.UITransformComponent.RectSize = Vector2(72, 72)
			else
				icon.SpriteGUIRendererComponent.ImageRUID = DataRef(self.OutlineRUID)
				icon.UITransformComponent.RectSize = Vector2(32, 32)
			end
		end
		local label = _EntityService:GetEntityByPath(path .. "/Label")
		if isvalid(label) then
			label.TextGUIRendererComponent.Text = tostring(floor) .. "층"
			if owned then label.TextGUIRendererComponent.FontColor = self.MainTextColor else label.TextGUIRendererComponent.FontColor = self.LockedTextColor end
		end
		local gauge = _EntityService:GetEntityByPath(path .. "/Gauge")
		if isvalid(gauge) and gauge.Enable ~= owned then gauge:SetEnable(owned) end
		if owned then
			for s = 1, 3 do
				local fill = _EntityService:GetEntityByPath(path .. "/Gauge/Seg" .. tostring(s) .. "/Fill")
				if isvalid(fill) and fill.Enable ~= (s <= tier) then fill:SetEnable(s <= tier) end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshInfo(Component eng)
		-- 선택한 층: 심볼·이름·단계, 지금 받는 효과, 단계별 획득 확률.
		local floor = self._T.selected or 1
		local tier = eng.SymbolLv[tostring(floor)] or 0
		local owned = tier > 0
		self:SetText("InfoName", self:SymbolName(floor, tier))
		local icon = self:Get("InfoIcon")
		if isvalid(icon) then
			local t = self._T.tiers[tier]
			if owned and t ~= nil then
				icon.SpriteGUIRendererComponent.ImageRUID = DataRef(t.icon)
				icon.UITransformComponent.RectSize = Vector2(80, 80)
			else
				icon.SpriteGUIRendererComponent.ImageRUID = DataRef(self.OutlineRUID)
				icon.UITransformComponent.RectSize = Vector2(48, 48)
			end
		end
		if owned then self:SetText("InfoTier", tostring(floor) .. "층 · " .. tostring(tier) .. "단계") else self:SetText("InfoTier", tostring(floor) .. "층 · 미획득") end
		local cur = self._T.tiers[tier]
		if owned and cur ~= nil then
			self:SetText("EffectValue1", "+" .. self:FormatNum(cur.dmg) .. "%")
			self:SetText("EffectValue2", "-" .. self:FormatNum(cur.cut) .. "%")
			self:SetText("EffectValue3", "+" .. self:FormatNum(cur.gain) .. "%")
		else
			for i = 1, 3 do self:SetText("EffectValue" .. tostring(i), "-") end
		end
		for t = 1, 3 do
			local info = self._T.tiers[t]
			local key = tostring(t)
			self:SetText("StepChance" .. key, "획득 " .. self:FormatNum(info ~= nil and info.chance or 0) .. "%")
			local desc = "기본 층 효과"
			if t == 2 then desc = "층 효과 증가" end
			if t == 3 then
				local p = self:PermOf(floor)
				desc = "2단계 유지"
				if p ~= nil then desc = desc .. " + 영구 " .. p.label .. " " .. self:FormatNum(p.value) .. "%" end
			elseif t == tier then
				desc = "현재 효과 적용"
			end
			self:SetText("StepDesc" .. key, desc)
			local c = self.SubTextColor
			if t == tier then c = self.GoldTextColor end
			self:SetColor("StepName" .. key, c)
			self:SetColor("StepChance" .. key, c)
			self:SetColor("StepDesc" .. key, c)
		end
		local badge = self:Get("StepBadge")
		if isvalid(badge) then
			if badge.Enable ~= owned then badge:SetEnable(owned) end
			if owned then
				local pos = badge.UITransformComponent.anchoredPosition
				badge.UITransformComponent.anchoredPosition = Vector2(pos.x, -28 - 38 * (tier - 1))
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshPerm(Component eng)
		-- 표에 있는 영구 효과별로 3단계 심볼 합계를 표시한다.
		local sums = {}
		local count = 0
		for floor = 1, self._T.floorCount do
			if (eng.SymbolLv[tostring(floor)] or 0) >= 3 then
				count = count + 1
				local p = self:PermOf(floor)
				if p ~= nil then sums[p.label] = (sums[p.label] or 0) + p.value end
			end
		end
		self:SetText("PermCount", "3단계 심볼 " .. tostring(count) .. "개")
		for i = 1, self.PermRows do
			local p = self._T.perm[i]
			local key = tostring(i)
			if p ~= nil then
				local v = sums[p.label] or 0
				self:SetText("PermName" .. key, p.label)
				self:SetText("PermValue" .. key, "+" .. self:FormatNum(v) .. "%")
				local c = self.SubTextColor
				if v > 0 then c = self.GoldTextColor end
				self:SetColor("PermName" .. key, c)
				self:SetColor("PermValue" .. key, c)
			else
				self:SetText("PermName" .. key, "")
				self:SetText("PermValue" .. key, "")
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 열려 있는 동안 서버 동기화 값으로 갱신 (로비를 벗어나면 닫음).
		if not self._T.open then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) or player.CurrentMap.Name ~= "Lobby" then
			self:Close()
			return
		end
		self._T.refreshT = (self._T.refreshT or 0) + delta
		if self._T.refreshT >= 0.5 then
			self._T.refreshT = 0
			self:Refresh()
		end
	end

end
